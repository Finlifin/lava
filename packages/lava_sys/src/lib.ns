-- lava_sys: Flat Native Core Bridge for Lava (Principles 2 & 8).
-- Application-agnostic 2D scene commands, platform input events, font metrics,
-- clipboard, non-blocking background jobs/timers, and line-streaming file I/O.
-- Also supports deterministic in-memory mock mode for standalone `nessa run` tests.

use std.bytes.Bytes
use std.fs
use std.process
use std.runtime
use std.time

pub const MOD_CTRL: i64 = 1
pub const MOD_ALT: i64 = 2
pub const MOD_SHIFT: i64 = 4
pub const MOD_SUPER: i64 = 8

pub enum CaretShape {
    pub block,
    pub beam,
    pub underline,
    pub hollow_block,
}
derive Eq, PartialEq for CaretShape

impl Display for CaretShape {
    pub fn to_string(self) -> String {
        self match {
            CaretShape.block => "Block",
            CaretShape.beam => "Beam",
            CaretShape.underline => "Underline",
            CaretShape.hollow_block => "HollowBlock",
        }
    }
}

impl CaretShape {
    pub fn code(self) -> i64 {
        self match {
            CaretShape.block => 0,
            CaretShape.beam => 1,
            CaretShape.underline => 2,
            CaretShape.hollow_block => 3,
        }
    }
}

pub enum PointerHint {
    pub default,
    pub text,
    pub pointer,
    pub resize_horizontal,
    pub resize_vertical,
}
derive Eq, PartialEq for PointerHint

impl Display for PointerHint {
    pub fn to_string(self) -> String {
        self match {
            PointerHint.default => "Default",
            PointerHint.text => "Text",
            PointerHint.pointer => "Pointer",
            PointerHint.resize_horizontal => "ResizeHorizontal",
            PointerHint.resize_vertical => "ResizeVertical",
        }
    }
}

impl PointerHint {
    pub fn code(self) -> i64 {
        self match {
            PointerHint.default => 0,
            PointerHint.text => 1,
            PointerHint.pointer => 2,
            PointerHint.resize_horizontal => 3,
            PointerHint.resize_vertical => 4,
        }
    }
}

private fn clamp_byte(v: i64) -> i64 {
    if v < 0 {
        0
    } else if v > 255 {
        255
    } else {
        v
    }
}

pub fn rgba(r: i64, g: i64, b: i64, a: i64) -> i64 {
    let rc = clamp_byte(r)
    let gc = clamp_byte(g)
    let bc = clamp_byte(b)
    let ac = clamp_byte(a)
    rc * 16777216 + gc * 65536 + bc * 256 + ac
}

pub fn rgb(r: i64, g: i64, b: i64) -> i64 = rgba(r, g, b, 255)

pub struct WindowSpec {
    pub title: String,
    pub width: i64,
    pub height: i64,
    pub bg_rgba: i64,
    pub pointer: PointerHint,
    pub decorated: bool = false,
}

impl WindowSpec {
    pub fn default_spec() -> WindowSpec {
        WindowSpec {
            title: "Lava",
            width: 1280,
            height: 800,
            bg_rgba: rgb(30, 30, 46),
            pointer: PointerHint.default,
            decorated: false,
        }
    }
}

pub enum DrawCmd {
    pub clip_push(x: f64, y: f64, w: f64, h: f64),
    pub clip_pop,
    pub fill_rect(x: f64, y: f64, w: f64, h: f64, color: i64, radius: f64),
    pub stroke_rect(x: f64, y: f64, w: f64, h: f64, color: i64, line_width: f64, radius: f64),
    pub line(x1: f64, y1: f64, x2: f64, y2: f64, color: i64, line_width: f64),
    pub text_run(
        x: f64,
        y: f64,
        text: String,
        font_family: String,
        font_size_pt: f64,
        color: i64,
        bold: bool,
        italic: bool,
        underline: bool
    ),
    pub cursor_caret(x: f64, y: f64, w: f64, h: f64, shape: CaretShape, color: i64),
}
derive PartialEq for DrawCmd

impl DrawCmd {
    pub fn to_wire(self) -> List {
        self match {
            DrawCmd.clip_push(x, y, w, h) => [0, x, y, w, h],
            DrawCmd.clip_pop => [1],
            DrawCmd.fill_rect(x, y, w, h, color, radius) => [2, x, y, w, h, color, radius],
            DrawCmd.stroke_rect(x, y, w, h, color, lw, radius) => [3, x, y, w, h, color, lw, radius],
            DrawCmd.line(x1, y1, x2, y2, color, lw) => [4, x1, y1, x2, y2, color, lw],
            DrawCmd.text_run(x, y, text, fam, sz, color, bold, italic, ul) => {
                [5, x, y, text, fam, sz, color, bold, italic, ul]
            },
            DrawCmd.cursor_caret(x, y, w, h, shape, color) => [6, x, y, w, h, shape.code(), color],
        }
    }
}

pub struct FontMetrics {
    pub cell_width: f64,
    pub cell_height: f64,
    pub ascent: f64,
    pub descent: f64,
}
derive PartialEq for FontMetrics

impl FontMetrics {
    pub fn default_mono() -> FontMetrics {
        FontMetrics {
            cell_width: 8.4,
            cell_height: 19.0,
            ascent: 15.0,
            descent: 4.0,
        }
    }
}

pub struct ScrollViewportSpec {
    pub pane_id: i64,
    pub doc_id: i64,
    pub x: f64,
    pub y: f64,
    pub w: f64,
    pub h: f64,
    pub top_row: i64,
    pub left_col: i64,
    pub cell_w: f64,
    pub cell_h: f64,
}
derive PartialEq for ScrollViewportSpec

impl ScrollViewportSpec {
    pub fn to_wire(self) -> List {
        [
            self.pane_id,
            self.doc_id,
            self.x,
            self.y,
            self.w,
            self.h,
            self.top_row,
            self.left_col,
            self.cell_w,
            self.cell_h,
        ]
    }
}

pub enum RawUiEvent {
    pub key(key: String, modifiers: i64, text: String),
    pub mouse_button(is_press: bool, button: i64, x: f64, y: f64, modifiers: i64, press_count: i64),
    pub mouse_move(x: f64, y: f64, modifiers: i64),
    pub mouse_scroll(dx: f64, dy: f64, x: f64, y: f64, modifiers: i64),
    pub resize(width: i64, height: i64, scale_factor: i64),
    pub focus(focused: bool),
    pub close_requested,
    pub tick(timer_id: i64, now_ms: i64),
    pub async_job_done(job_id: i64, ok: bool, exit_code: i64, stdout: String, stderr: String),
}
derive PartialEq for RawUiEvent

pub fn encode_wire_event(ev: RawUiEvent) -> List {
    ev match {
        RawUiEvent.key(key, modifiers, text) => [0, key, modifiers, text],
        RawUiEvent.mouse_button(is_press, button, x, y, modifiers, press_count) => {
            [1, is_press, button, x, y, modifiers, press_count]
        },
        RawUiEvent.mouse_move(x, y, modifiers) => [2, x, y, modifiers],
        RawUiEvent.mouse_scroll(dx, dy, x, y, modifiers) => [3, dx, dy, x, y, modifiers],
        RawUiEvent.resize(width, height, scale_factor) => [4, width, height, scale_factor],
        RawUiEvent.focus(focused) => [5, focused],
        RawUiEvent.close_requested => [6],
        RawUiEvent.tick(timer_id, now_ms) => [7, timer_id, now_ms],
        RawUiEvent.async_job_done(job_id, ok, exit_code, stdout, stderr) => {
            [8, job_id, ok, exit_code, stdout, stderr]
        },
    }
}

pub fn decode_wire_event(item: Any) -> ?RawUiEvent {
    if not (item matches _: List) {
        return null
    }
    let arr = item.as(List)
    let len = arr.len()
    if len < 1 {
        return null
    }
    let tag = arr.get(0).as(i64)
    when {
        tag == 0 and len >= 4 => {
            RawUiEvent.key(
                arr.get(1).as(String),
                arr.get(2).as(i64),
                arr.get(3).as(String),
            )
        },
        tag == 1 and len >= 7 => {
            RawUiEvent.mouse_button(
                arr.get(1).as(bool),
                arr.get(2).as(i64),
                arr.get(3).as(f64),
                arr.get(4).as(f64),
                arr.get(5).as(i64),
                arr.get(6).as(i64),
            )
        },
        tag == 2 and len >= 4 => {
            RawUiEvent.mouse_move(
                arr.get(1).as(f64),
                arr.get(2).as(f64),
                arr.get(3).as(i64),
            )
        },
        tag == 3 and len >= 6 => {
            RawUiEvent.mouse_scroll(
                arr.get(1).as(f64),
                arr.get(2).as(f64),
                arr.get(3).as(f64),
                arr.get(4).as(f64),
                arr.get(5).as(i64),
            )
        },
        tag == 4 and len >= 4 => {
            RawUiEvent.resize(
                arr.get(1).as(i64),
                arr.get(2).as(i64),
                arr.get(3).as(i64),
            )
        },
        tag == 5 and len >= 2 => RawUiEvent.focus(arr.get(1).as(bool)),
        tag == 6 => RawUiEvent.close_requested,
        tag == 7 and len >= 3 => {
            RawUiEvent.tick(
                arr.get(1).as(i64),
                arr.get(2).as(i64),
            )
        },
        tag == 8 and len >= 6 => {
            RawUiEvent.async_job_done(
                arr.get(1).as(i64),
                arr.get(2).as(bool),
                arr.get(3).as(i64),
                arr.get(4).as(String),
                arr.get(5).as(String),
            )
        },
        else => null,
    }
}

-- Deterministic in-memory mock fallback for standalone `nessa run` unit testing.
private global _mock_enabled: bool = false
private global _mock_events: List = List()
private global _mock_clipboard: String = ""
private global _mock_frame_gen: i64 = 0
private global _mock_last_cmds: List = List()
private global _mock_last_title: String = "Lava"
private global _mock_last_decorated: bool = false
private global _mock_quit_code: ?i64 = null
private global _mock_next_id: i64 = 1
private global _frame_flat_buf: List = List()
private global _frame_wire_buf: Bytes = Bytes.with_capacity(65536)

private fn pack_color_u32(c: i64) -> u32 = (((c % 4294967296) + 4294967296) % 4294967296).as(u32)

pub fn mock_enable(enabled: bool) {
    _mock_enabled = enabled
    let _ = runtime.host_call("sys_set_mock_mode", [enabled]) ! { _ => null }
    if enabled {
        _mock_events = List()
        _mock_clipboard = ""
        _mock_frame_gen = 0
        _mock_last_cmds = List()
        _mock_last_title = "Lava"
        _mock_last_decorated = false
        _mock_quit_code = null
        _mock_next_id = 1
    }
}

pub fn mock_push_event(ev: RawUiEvent) {
    _mock_events.push(ev)
}

pub fn mock_last_frame_cmds() -> List = _mock_last_cmds

pub fn mock_frame_generation() -> i64 = _mock_frame_gen

pub fn mock_last_title() -> String = _mock_last_title

pub fn mock_last_decorated() -> bool = _mock_last_decorated

pub fn mock_quit_requested() -> ?i64 = _mock_quit_code

pub fn host_poll_events() -> List {
    if _mock_enabled {
        let out = _mock_events
        _mock_events = List()
        return out
    }
    let raw! = runtime.host_call("ui_poll_events", []) else {
        return []
    }
    let items = raw.as(List)
    let out = List()
    for item in items {
        let ev? = decode_wire_event(item) else {
            continue
        }
        out.push(ev)
    }
    out
}

pub fn host_wait_events(timeout_ms: i64) -> List {
    if _mock_enabled {
        let out = _mock_events
        _mock_events = List()
        return out
    }
    let raw! = runtime.host_call("ui_wait_events", [timeout_ms]) else {
        return []
    }
    let items = raw.as(List)
    let out = List()
    for item in items {
        let ev? = decode_wire_event(item) else {
            continue
        }
        out.push(ev)
    }
    out
}

pub fn host_commit_frame(spec: WindowSpec, cmds: List) -> i64 {
    if _mock_enabled {
        _mock_frame_gen += 1
        _mock_last_cmds = cmds
        _mock_last_title = spec.title
        _mock_last_decorated = spec.decorated
        return _mock_frame_gen
    }
    let flat = _frame_flat_buf
    flat.clear()
    var last_fam_flat = ""
    for i in 0..cmds.len() {
        let cmd = cmds.get(i.as(usize)).as(DrawCmd)
        cmd match {
            DrawCmd.clip_push(x, y, w, h) => {
                flat.push(0)
                flat.push(x)
                flat.push(y)
                flat.push(w)
                flat.push(h)
            },
            DrawCmd.clip_pop => {
                flat.push(1)
            },
            DrawCmd.fill_rect(x, y, w, h, color, radius) => {
                flat.push(2)
                flat.push(x)
                flat.push(y)
                flat.push(w)
                flat.push(h)
                flat.push(color)
                flat.push(radius)
            },
            DrawCmd.stroke_rect(x, y, w, h, color, lw, radius) => {
                flat.push(3)
                flat.push(x)
                flat.push(y)
                flat.push(w)
                flat.push(h)
                flat.push(color)
                flat.push(lw)
                flat.push(radius)
            },
            DrawCmd.line(x1, y1, x2, y2, color, lw) => {
                flat.push(4)
                flat.push(x1)
                flat.push(y1)
                flat.push(x2)
                flat.push(y2)
                flat.push(color)
                flat.push(lw)
            },
            DrawCmd.text_run(x, y, text, fam, sz, color, bold, italic, ul) => {
                let f_b = if bold { 1 } else { 0 }
                let f_i = if italic { 2 } else { 0 }
                let f_u = if ul { 4 } else { 0 }
                let flags = f_b + f_i + f_u
                if fam == last_fam_flat and fam != "" {
                    flat.push(7)
                    flat.push(x)
                    flat.push(y)
                    flat.push(sz)
                    flat.push(color)
                    flat.push(flags)
                    flat.push(text)
                } else {
                    last_fam_flat = fam
                    flat.push(5)
                    flat.push(x)
                    flat.push(y)
                    flat.push(sz)
                    flat.push(color)
                    flat.push(flags)
                    flat.push(text)
                    flat.push(fam)
                }
            },
            DrawCmd.cursor_caret(x, y, w, h, shape, color) => {
                flat.push(6)
                flat.push(x)
                flat.push(y)
                flat.push(w)
                flat.push(h)
                flat.push(shape.code())
                flat.push(color)
            },
        }
    }
    let flat_res = runtime.host_call(
        "ui_commit_frame_flat",
        [spec.title, spec.width, spec.height, spec.bg_rgba, spec.pointer.code(), flat, spec.decorated],
    )
    flat_res match {
        gen! => return gen.as(i64),
        error _ => (),
    }
    _frame_wire_buf.clear()
    var last_fam = ""
    let buf = _frame_wire_buf
    for i in 0..cmds.len() {
        let cmd = cmds.get(i.as(usize)).as(DrawCmd)
        cmd match {
            DrawCmd.clip_push(x, y, w, h) => {
                buf.push(0)
                buf.write_u64_le(x.to_bits())
                buf.write_u64_le(y.to_bits())
                buf.write_u64_le(w.to_bits())
                buf.write_u64_le(h.to_bits())
            },
            DrawCmd.clip_pop => {
                buf.push(1)
            },
            DrawCmd.fill_rect(x, y, w, h, color, radius) => {
                buf.push(2)
                buf.write_u64_le(x.to_bits())
                buf.write_u64_le(y.to_bits())
                buf.write_u64_le(w.to_bits())
                buf.write_u64_le(h.to_bits())
                buf.write_u32_le(pack_color_u32(color))
                buf.write_u64_le(radius.to_bits())
            },
            DrawCmd.stroke_rect(x, y, w, h, color, lw, radius) => {
                buf.push(3)
                buf.write_u64_le(x.to_bits())
                buf.write_u64_le(y.to_bits())
                buf.write_u64_le(w.to_bits())
                buf.write_u64_le(h.to_bits())
                buf.write_u32_le(pack_color_u32(color))
                buf.write_u64_le(lw.to_bits())
                buf.write_u64_le(radius.to_bits())
            },
            DrawCmd.line(x1, y1, x2, y2, color, lw) => {
                buf.push(4)
                buf.write_u64_le(x1.to_bits())
                buf.write_u64_le(y1.to_bits())
                buf.write_u64_le(x2.to_bits())
                buf.write_u64_le(y2.to_bits())
                buf.write_u32_le(pack_color_u32(color))
                buf.write_u64_le(lw.to_bits())
            },
            DrawCmd.text_run(x, y, text, fam, sz, color, bold, italic, ul) => {
                let f_b = if bold { 1 } else { 0 }
                let f_i = if italic { 2 } else { 0 }
                let f_u = if ul { 4 } else { 0 }
                let flags: u8 = (f_b + f_i + f_u).as(u8)
                if fam == last_fam and fam != "" {
                    buf.push(7)
                    buf.write_u64_le(x.to_bits())
                    buf.write_u64_le(y.to_bits())
                    buf.write_u64_le(sz.to_bits())
                    buf.write_u32_le(pack_color_u32(color))
                    buf.push(flags)
                    buf.write_u32_le(text.len().as(u32))
                    buf.extend_str(text)
                } else {
                    last_fam = fam
                    buf.push(5)
                    buf.write_u64_le(x.to_bits())
                    buf.write_u64_le(y.to_bits())
                    buf.write_u64_le(sz.to_bits())
                    buf.write_u32_le(pack_color_u32(color))
                    buf.push(flags)
                    buf.write_u32_le(text.len().as(u32))
                    buf.extend_str(text)
                    buf.write_u32_le(fam.len().as(u32))
                    buf.extend_str(fam)
                }
            },
            DrawCmd.cursor_caret(x, y, w, h, shape, color) => {
                buf.push(6)
                buf.write_u64_le(x.to_bits())
                buf.write_u64_le(y.to_bits())
                buf.write_u64_le(w.to_bits())
                buf.write_u64_le(h.to_bits())
                buf.push(shape.code().as(u8))
                buf.write_u32_le(pack_color_u32(color))
            },
        }
    }
    let fast_res = runtime.host_call(
        "ui_commit_frame_bytes",
        [spec.title, spec.width, spec.height, spec.bg_rgba, spec.pointer.code(), buf, spec.decorated],
    )
    fast_res match {
        gen! => return gen.as(i64),
        error _ => (),
    }
    let wire = List()
    for cmd in cmds {
        wire.push(cmd.as(DrawCmd).to_wire())
    }
    let gen! = runtime.host_call(
        "ui_commit_frame",
        [spec.title, spec.width, spec.height, spec.bg_rgba, spec.pointer.code(), wire, spec.decorated]
    ) else {
        _mock_frame_gen += 1
        _mock_last_cmds = cmds
        _mock_last_title = spec.title
        _mock_last_decorated = spec.decorated
        return _mock_frame_gen
    }
    gen.as(i64)
}

pub fn host_set_anim_hints(smooth_scroll: bool, cursor_anim: bool, viewports: List) {
    if _mock_enabled {
        return
    }
    let wire = List()
    for vp in viewports {
        if vp matches _: ScrollViewportSpec {
            wire.push(vp.as(ScrollViewportSpec).to_wire())
        } else if vp matches _: List {
            wire.push(vp)
        }
    }
    let _ = runtime.host_call("ui_set_anim_hints", [smooth_scroll, cursor_anim, wire]) ! {
        _ => (),
    }
}

pub fn host_measure_font(family: String, size_pt: f64) -> FontMetrics {
    if _mock_enabled {
        return FontMetrics.default_mono()
    }
    let res! = runtime.host_call("ui_measure_font", [family, size_pt]) else {
        return FontMetrics.default_mono()
    }
    let arr = res.as(List)
    FontMetrics {
        cell_width: arr.get(0).as(f64),
        cell_height: arr.get(1).as(f64),
        ascent: arr.get(2).as(f64),
        descent: arr.get(3).as(f64),
    }
}

pub fn host_clipboard_get() -> String {
    if _mock_enabled {
        return _mock_clipboard
    }
    let res! = runtime.host_call("ui_clipboard_get", []) else {
        return _mock_clipboard
    }
    res.as(String)
}

pub fn host_clipboard_set(text: String) {
    _mock_clipboard = text
    if not _mock_enabled {
        let _ = runtime.host_call("ui_clipboard_set", [text]) ! {
            _ => (),
        }
    }
}

pub fn host_request_quit(exit_code: i64) {
    _mock_quit_code = exit_code
    if not _mock_enabled {
        let _ = runtime.host_call("ui_request_quit", [exit_code]) ! {
            _ => (),
        }
    }
}

pub fn host_spawn_job(cmd: String, cwd: String, stdin_data: String) -> i64 {
    let stdin_opt: ?String = if stdin_data == "" { null } else { stdin_data }
    let cwd_opt: ?String = if cwd == "" { null } else { cwd }
    if _mock_enabled {
        let id = _mock_next_id
        _mock_next_id += 1
        let out! = process.shell(cmd, stdin = stdin_opt, cwd = cwd_opt) else {
            _mock_events.push(RawUiEvent.async_job_done(id, false, -1, "", "shell execution failed"))
            return id
        }
        _mock_events.push(RawUiEvent.async_job_done(id, out.is_success(), out.status, out.stdout, out.stderr))
        return id
    }
    let res! = runtime.host_call("sys_spawn_job", [cmd, cwd, stdin_data]) else {
        let id = _mock_next_id
        _mock_next_id += 1
        let out! = process.shell(cmd, stdin = stdin_opt, cwd = cwd_opt) else {
            _mock_events.push(RawUiEvent.async_job_done(id, false, -1, "", "shell execution failed"))
            return id
        }
        _mock_events.push(RawUiEvent.async_job_done(id, out.is_success(), out.status, out.stdout, out.stderr))
        return id
    }
    res.as(i64)
}

pub fn host_cancel_job(job_id: i64) -> bool {
    if _mock_enabled {
        return true
    }
    let res! = runtime.host_call("sys_cancel_job", [job_id]) else {
        return false
    }
    res.as(bool)
}

pub fn host_schedule_timer(delay_ms: i64) -> i64 {
    if _mock_enabled {
        let id = _mock_next_id
        _mock_next_id += 1
        _mock_events.push(RawUiEvent.tick(id, time.unix_millis()))
        return id
    }
    let res! = runtime.host_call("sys_schedule_timer", [delay_ms]) else {
        let id = _mock_next_id
        _mock_next_id += 1
        _mock_events.push(RawUiEvent.tick(id, time.unix_millis()))
        return id
    }
    res.as(i64)
}

private fn fallback_read_file_lines(path: String) -> !String (List, bool) {
    let raw! = fs.read_to_string(path) else {
        return error ("cannot open file: " ++ path)
    }
    let has_crlf = raw.contains("\r\n")
    if raw == "" {
        return ([""], false)
    }
    let norm = raw.replace("\r\n", "\n").replace("\r", "\n")
    let parts = norm.split("\n")
    if parts.len() > 1 and norm.ends_with("\n") {
        let _ = parts.pop()
    }
    if parts.is_empty() {
        parts.push("")
    }
    (parts, has_crlf)
}

private fn fallback_write_file_lines(path: String, lines: List, trailing_newline: bool) -> !String i64 {
    let body = lines.join("\n") ++ (if trailing_newline { "\n" } else { "" })
    let _! = fs.write_string(path, body) else {
        return error ("cannot open file for write: " ++ path)
    }
    body.len().as(i64)
}

pub fn host_read_file_lines(path: String) -> !String (List, bool) {
    if _mock_enabled {
        return fallback_read_file_lines(path)
    }
    let res! = runtime.host_call("fs_read_lines", [path]) else {
        return fallback_read_file_lines(path)
    }
    let pair = res.as(List)
    (pair.get(0).as(List), pair.get(1).as(bool))
}

pub fn host_write_file_lines(path: String, lines: List, trailing_newline: bool) -> !String i64 {
    if _mock_enabled {
        return fallback_write_file_lines(path, lines, trailing_newline)
    }
    let res! = runtime.host_call("fs_write_lines", [path, lines, trailing_newline]) else {
        return fallback_write_file_lines(path, lines, trailing_newline)
    }
    res.as(i64)
}

pub fn host_is_dir(path: String) -> bool = fs.is_dir(path)

pub fn host_exists(path: String) -> bool = fs.exists(path)
