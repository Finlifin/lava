-- lava_accel: High-Performance Native Accelerator Library for Lava.
-- Bridges `lava-accel` Rust hot-paths via `std.runtime.host_call` when running inside Lava,
-- and provides deterministic Nessa fallbacks (using `std.fs.walk_dir` and `std.process.run`)
-- so standalone `nessa run` plugin test suites run identically without GTK/Host wiring.

use std.collections.{HashMap, Set}
use std.fs
use std.path
use std.process
use std.runtime

pub struct FuzzyHit {
    pub index: i64,
    pub score: i64,
}
derive Eq, PartialEq, Display for FuzzyHit

