pub struct EditorWorld {
    pub buffers: HashMap,
    pub buffer_order: List,
    pub active_buffer_id: BufferId,
    pub scratch_id: BufferId,
    pub messages_id: BufferId,
    pub next_buf_num: i64,
    pub options: EditorOptions,
    pub kill_ring: KillRing,
    pub registers: RegisterBank,
    pub jumps: JumpList,
    pub global_marks: HashMap,
    pub quickfix: List,
    pub quickfix_idx: i64,
    pub quickfix_title: String,
    pub last_search: String,
    pub last_search_forward: bool,
    pub search_highlight_active: bool,
    pub mode_name: String,
    pub caret_shape: CaretShape,
    pub visual: VisualSelection,
    pub minibuffer_view: MinibufferView,
    pub viewport_rows: i64,
    pub viewport_cols: i64,
    pub viewport_top_row: i64,
    pub pending_keys_display: String,
    pub which_key_items: List,
    pub status_message: String,
    pub cwd: String,
    pub quit_requested: bool,
    pub exit_code: i64,
    pub active_jobs: List,
    pub left_sidebar: SidebarPanel,
    pub right_sidebar: SidebarPanel,
    pub floating_windows: List,
    pub notifications: List,
    pub notification_history: List,
    pub next_notification_id: i64,
    pub completion_popup: CompletionPopup,
    pub signature_help: SignatureHelpPopup,
    pub inline_ghost: InlineGhostText,
    pub statusline_left_extra: String,
    pub statusline_right_extra: String,
    pub winbar_text: String,
    pub secondary_cursors: List,
    pub minibuffer_rich_items: List,
    pub minibuffer_mode_badge: String,
    pub minibuffer_hint_bar: String,
    pub minibuffer_history_ghost: String,
    pub transfer_progress: TransferProgressState,
    pub floating_window_spans: HashMap,
    pub floating_window_cursor: HashMap,
    pub in_key_burst: bool,
    pub lsp_tick_dirty: bool,
    pub remote_tick_dirty: bool,
}

impl EditorWorld {
    pub fn new() -> EditorWorld {
        let cwd = env.current_dir() ! { _ => "." }
        let buffers = HashMap.new()
        let order = List()

        let scratch_id = BufferId(1)
        let scratch_lines = [
            "-- Welcome to Lava: Single-VM Nessa Programmable Interactive Environment",
            "-- Evil-Vim modal keys (`hjkl`, `ciw`, `C-v`, `.`, `q`/`@`, `:`) + Emacs Core (`M-x`, `C-x`, `C-h`)",
            "-- Press `M-x` or `:` for commands, `<Space>` for Which-Key, `:Telescope`, `:Neotree`, `:Magit`, `:Lazy`.",
            ""
        ]
        let scratch = Buffer.new(
            scratch_id,
            "*scratch*",
            BufferKind.scratch,
            major_mode = "nessa",
            initial_lines = scratch_lines,
        )
        buffers.insert(scratch_id, scratch)
        order.push(scratch_id)

        let messages_id = BufferId(2)
        let messages = Buffer.new(
            messages_id,
            "*Messages*",
            BufferKind.special,
            major_mode = "messages",
            initial_lines = ["[Lava] Runtime initialized."],
        )
        messages.read_only = true
        buffers.insert(messages_id, messages)
        order.push(messages_id)

        EditorWorld {
            buffers: buffers,
            buffer_order: order,
            active_buffer_id: scratch_id,
            scratch_id: scratch_id,
            messages_id: messages_id,
            next_buf_num: 3,
            options: EditorOptions.defaults(),
            kill_ring: KillRing.new(),
            registers: RegisterBank.new(),
            jumps: JumpList.new(),
            global_marks: HashMap.new(),
            quickfix: List(),
            quickfix_idx: 0,
            quickfix_title: "",
            last_search: "",
            last_search_forward: true,
            search_highlight_active: false,
            mode_name: "NORMAL",
            caret_shape: CaretShape.block,
            visual: VisualSelection.none(),
            minibuffer_view: MinibufferView.inactive(),
            viewport_rows: 36,
            viewport_cols: 120,
            viewport_top_row: 0,
            pending_keys_display: "",
            which_key_items: List(),
            status_message: "Lava ready",
            cwd: cwd,
            quit_requested: false,
            exit_code: 0,
            active_jobs: List(),
            left_sidebar: SidebarPanel.hidden("left"),
            right_sidebar: SidebarPanel.hidden("right"),
            floating_windows: List(),
            notifications: List(),
            notification_history: List(),
            next_notification_id: 1,
            completion_popup: CompletionPopup.inactive(),
            signature_help: SignatureHelpPopup.inactive(),
            inline_ghost: InlineGhostText.inactive(),
            statusline_left_extra: "",
            statusline_right_extra: "",
            winbar_text: "",
            secondary_cursors: List(),
            minibuffer_rich_items: List(),
            minibuffer_mode_badge: "",
            minibuffer_hint_bar: "",
            minibuffer_history_ghost: "",
            transfer_progress: TransferProgressState.idle(),
            floating_window_spans: HashMap.new(),
            floating_window_cursor: HashMap.new(),
            in_key_burst: false,
            lsp_tick_dirty: false,
            remote_tick_dirty: false,
        }
    }

    pub fn effective_ignore_case(self, pattern: String) -> bool {
        if not self.options.ignorecase {
            return false
        }
        if self.options.smartcase {
            let n = pattern.char_len()
            for i in 0..n {
                if pattern.slice(i, i + 1).is_uppercase() {
                    return false
                }
            }
        }
        true
    }

    pub fn active_buffer(self) -> Buffer {
        let b_opt = self.buffers.get(self.active_buffer_id)
        if b_opt != null {
            return b_opt.as(Buffer)
        }
        self.buffers.get(self.scratch_id).as(Buffer)
    }

    pub fn buffer(self, id: BufferId) -> ?Buffer {
        let b? = self.buffers.get(id) else {
            return null
        }
        b.as(Buffer)
    }

    pub fn find_buffer_by_name(self, name: String) -> ?Buffer {
        let n = self.buffer_order.len()
        for i in 0..n {
            let bid = self.buffer_order.get(i.as(usize)).as(BufferId)
            let b = self.buffers.get(bid).as(Buffer)
            if b.name == name {
                return b
            }
        }
        null
    }

    pub fn find_buffer_by_path(self, file_path: String) -> ?Buffer {
        if file_path == "" {
            return null
        }
        let n = self.buffer_order.len()
        for i in 0..n {
            let bid = self.buffer_order.get(i.as(usize)).as(BufferId)
            let b = self.buffers.get(bid).as(Buffer)
            if b.file_path == file_path {
                return b
            }
        }
        null
    }

    pub fn unique_buffer_name(self, base_name: String) -> String {
        if self.find_buffer_by_name(base_name) == null {
            return base_name
        }
        var suffix: i64 = 2
        while true {
            let candidate = base_name ++ "<" ++ suffix.to_string() ++ ">"
            if self.find_buffer_by_name(candidate) == null {
                return candidate
            }
            suffix += 1
        }
        base_name
    }

    pub fn create_buffer(
        self,
        name: String,
        kind: BufferKind,
        .file_path: String = "",
        .major_mode: String = "text",
        .initial_lines: ?List = null,
    ) -> Buffer {
        let id = BufferId(self.next_buf_num)
        self.next_buf_num += 1
        let uniq = self.unique_buffer_name(name)
        let buf = Buffer.new(
            id,
            uniq,
            kind,
            file_path = file_path,
            major_mode = major_mode,
            initial_lines = initial_lines,
        )
        self.buffers.insert(id, buf)
        self.buffer_order.push(id)
        buf
    }

    pub fn create_buffer_from_doc(
        self,
        name: String,
        kind: BufferKind,
        doc_id: i64,
        line_count: i64,
        crlf: bool,
        .file_path: String = "",
        .major_mode: String = "text",
    ) -> Buffer {
        let id = BufferId(self.next_buf_num)
        self.next_buf_num += 1
        let uniq = self.unique_buffer_name(name)
        let buf = Buffer.create_from_doc_id(
            id,
            uniq,
            kind,
            doc_id,
            line_count,
            crlf,
            file_path = file_path,
            major_mode = major_mode,
        )
        self.buffers.insert(id, buf)
        self.buffer_order.push(id)
        buf
    }

    pub fn ensure_special_buffer(
        self,
        name: String,
        major_mode: String,
        lines: List,
        .read_only: bool = true,
        .lifetime: BufferLifetime = BufferLifetime.kill_on_leave,
    ) -> Buffer {
        let existing_opt = self.find_buffer_by_name(name)
        if existing_opt != null {
            let b = existing_opt.as(Buffer)
            b.read_only = false
            b.major_mode = major_mode
            b.set_lines(lines, record_undo = false)
            b.modified = false
            b.read_only = read_only
            b.lifetime = lifetime
            return b
        }
        let b = self.create_buffer(
            name,
            BufferKind.special,
            major_mode = major_mode,
            initial_lines = lines,
        )
        b.modified = false
        b.read_only = read_only
        b.lifetime = lifetime
        b
    }

    pub fn append_message(self, msg: String) {
        if msg == "" {
            return
        }
        self.status_message = msg
        let mb_opt = self.buffers.get(self.messages_id)
        if mb_opt != null {
            let mb = mb_opt.as(Buffer)
            mb.push_line(msg)
            if mb.line_count() > 500 {
                let _ = mb.remove_line_at(0)
            }
            mb.point = Pos.new(mb.line_count() - 1, 0)
        }
    }

    pub fn resolve_path(self, raw_path: String) -> String {
        let trimmed = raw_path.trim()
        if trimmed == "" {
            return self.cwd
        }
        if is_ssh_uri(trimmed) {
            return normalize_ssh_uri(trimmed)
        }
        if is_ssh_uri(self.cwd) and (not path.is_absolute(trimmed)) {
            return join_ssh_uri(self.cwd, trimmed)
        }
        if path.is_absolute(trimmed) {
            return path.normalize(trimmed)
        }
        path.normalize(path.join(self.cwd, trimmed))
    }

    pub fn open_file(self, raw_path: String) -> #[log_event, status_emit] !String Buffer {
        let full_path = self.resolve_path(raw_path)
        let existing_opt = self.find_buffer_by_path(full_path)
        if existing_opt != null {
            let b = existing_opt.as(Buffer)
            let _ = self.switch_to_buffer(b.id)
            let msg = "Switched to " ++ b.name
            self.status_message = msg
            status_emit(msg)#
            return b
        }
        if is_ssh_uri(full_path) {
            let rbase = ssh_uri_basename(full_path)
            let rmode = detect_major_mode(full_path)
            self.transfer_progress = TransferProgressState {
                active: true,
                title: "Fetching " ++ rbase,
                detail: full_path,
                transport: "SSH",
                bytes_done: 0,
                bytes_total: 0,
                lines_loaded: 0,
            }
            let opened_res = remote_open_doc(full_path)
            let opened = opened_res match {
                v! => v,
                error err_msg => {
                    self.transfer_progress = TransferProgressState.idle()
                    return error err_msg
                },
            }
            let tp = remote_transfer_progress()
            self.transfer_progress = TransferProgressState {
                active: false,
                title: tp.title,
                detail: tp.detail,
                transport: opened.transport,
                bytes_done: opened.byte_len,
                bytes_total: opened.byte_len,
                lines_loaded: opened.line_count,
            }
            if opened.exists {
                if opened.is_dir {
                    return error ("path is a remote directory (use :Dirvish or :RemoteBrowse): " ++ full_path)
                }
                let buf = self.create_buffer_from_doc(
                    rbase,
                    BufferKind.file,
                    opened.doc_id,
                    opened.line_count,
                    opened.crlf,
                    file_path = full_path,
                    major_mode = rmode,
                )
                buf.read_only = opened.readonly
                buf.modified = false
                let _ = self.switch_to_buffer(buf.id)
                log_event("info", "ext_document", "Opened remote file " ++ full_path ++ " via " ++ opened.transport)#
                let proto_tag = if opened.transport == "HTTP" { "[HTTP]" } else { "[SSH]" }
                let msg = proto_tag ++ " \"" ++ rbase ++ "\" " ++ buf.line_count().to_string() ++ "L (" ++ full_path ++ ")"
                self.status_message = msg
                status_emit(msg)#
                return buf
            }
            let buf = self.create_buffer(
                rbase,
                BufferKind.file,
                file_path = full_path,
                major_mode = rmode,
                initial_lines = [""],
            )
            buf.modified = false
            let _ = self.switch_to_buffer(buf.id)
            let msg = "[SSH] \"" ++ rbase ++ "\" [New Remote File] (" ++ full_path ++ ")"
            self.status_message = msg
            status_emit(msg)#
            return buf
        }
        let base_opt = path.file_name(full_path)
        let base_name = if base_opt != null { base_opt.as(String) } else { full_path }
        let mode = detect_major_mode(full_path)
        if fs.exists(full_path) {
            if fs.is_dir(full_path) {
                return error ("path is a directory (use dired): " ++ full_path)
            }
            let (doc_id, lcount, crlf) = accel_doc_open_file(full_path)!
            let buf = self.create_buffer_from_doc(
                base_name,
                BufferKind.file,
                doc_id,
                lcount,
                crlf,
                file_path = full_path,
                major_mode = mode,
            )
            buf.modified = false
            let _ = self.switch_to_buffer(buf.id)
            log_event("info", "ext_document", "Opened file " ++ full_path)#
            let msg = "\"" ++ base_name ++ "\" " ++ buf.line_count().to_string() ++ "L"
            self.status_message = msg
            status_emit(msg)#
            return buf
        }
        -- New unsaved file buffer
        let buf = self.create_buffer(
            base_name,
            BufferKind.file,
            file_path = full_path,
            major_mode = mode,
            initial_lines = [""],
        )
        buf.modified = false
        let _ = self.switch_to_buffer(buf.id)
        let msg = "\"" ++ base_name ++ "\" [New File]"
        self.status_message = msg
        status_emit(msg)#
        buf
    }

    pub fn save_buffer(self, id: BufferId, .override_path: String = "") -> #[log_event, status_emit] !String Unit {
        let buf? = self.buffer(id) else {
            return error ("unknown buffer: " ++ id.to_string())
        }
        var target = if override_path != "" {
            self.resolve_path(override_path)
        } else {
            buf.file_path
        }
        if target == "" {
            return error ("buffer has no file name: " ++ buf.name)
        }
        buf.sync_external_lines()
        if is_ssh_uri(target) {
            let total_l = buf.line_count()
            let (written, transport) = remote_save_doc(target, buf.doc_id, buf.crlf)!
            self.transfer_progress = TransferProgressState {
                active: false,
                title: "Uploaded " ++ ssh_uri_basename(target),
                detail: target,
                transport: transport,
                bytes_done: written,
                bytes_total: written,
                lines_loaded: total_l,
            }
            buf.file_path = target
            buf.kind = BufferKind.file
            buf.name = ssh_uri_basename(target)
            buf.major_mode = detect_major_mode(target)
            buf.modified = false
            log_event("info", "ext_document", "Wrote remote " ++ target ++ " via " ++ transport)#
            let proto_tag = if transport == "HTTP" { "[HTTP]" } else { "[SSH]" }
            let msg = proto_tag ++ " \"" ++ buf.name ++ "\" " ++ total_l.to_string() ++ "L, " ++ written.to_string() ++ "B written"
            self.status_message = msg
            status_emit(msg)#
            return ()
        }
        let parent_opt = path.parent(target)
        if parent_opt != null {
            let pdir = parent_opt.as(String)
            if pdir != "" and (not fs.exists(pdir)) {
                let _ = fs.create_dir(pdir, parents = true) ! { _ => () }
            }
        }
        let written = accel_doc_save_file(buf.doc_id, target, buf.crlf)!
        buf.file_path = target
        buf.kind = BufferKind.file
        let base_opt = path.file_name(target)
        if base_opt != null {
            buf.name = base_opt.as(String)
        }
        buf.major_mode = detect_major_mode(target)
        buf.modified = false
        log_event("info", "ext_document", "Wrote " ++ target)#
        let msg = "\"" ++ buf.name ++ "\" " ++ buf.line_count().to_string() ++ "L, " ++ written.to_string() ++ "B written"
        self.status_message = msg
        status_emit(msg)#
        ()
    }

    pub fn switch_to_buffer(self, id: BufferId) -> bool {
        if not self.buffers.contains_key(id) {
            return false
        }
        let prev_id = self.active_buffer_id
        self.active_buffer_id = id
        if prev_id != id and prev_id != self.messages_id and prev_id != self.scratch_id {
            let prev_opt = self.buffer(prev_id)
            if prev_opt != null {
                let pb = prev_opt.as(Buffer)
                if pb.lifetime == BufferLifetime.kill_on_leave and (not pb.modified) {
                    let _ = self.kill_buffer(prev_id) ! { _ => prev_id }
                }
            }
        }
        true
    }

    pub fn cycle_buffer(self, delta: i64) -> BufferId {
        let n = self.buffer_order.len()
        if n == 0 {
            return self.scratch_id
        }
        var cur_idx: i64 = 0
        for i in 0..n {
            if self.buffer_order.get(i.as(usize)).as(BufferId) == self.active_buffer_id {
                cur_idx = i
                break
            }
        }
        var next_idx = (cur_idx + delta) % n
        if next_idx < 0 {
            next_idx += n
        }
        let next_id = self.buffer_order.get(next_idx.as(usize)).as(BufferId)
        let _ = self.switch_to_buffer(next_id)
        self.active_buffer_id
    }

    pub fn kill_buffer(self, id: BufferId, .force: bool = false) -> !String BufferId {
        let buf? = self.buffer(id) else {
            return error ("unknown buffer: " ++ id.to_string())
        }
        if id == self.messages_id {
            return error "cannot kill *Messages* buffer"
        }
        if buf.modified and (not force) and buf.kind == BufferKind.file {
            return error ("buffer " ++ buf.name ++ " has unsaved changes (use force to discard)")
        }
        if self.buffer_order.len() <= 1 or (id == self.scratch_id and self.buffer_order.len() <= 2) {
            buf.set_lines([""], record_undo = false)
            buf.modified = false
            return buf.id
        }
        let _ = self.buffers.remove(id)
        accel_doc_free(buf.doc_id)
        let new_order = List()
        for i in 0..self.buffer_order.len() {
            let bid = self.buffer_order.get(i.as(usize)).as(BufferId)
            if bid != id {
                new_order.push(bid)
            }
        }
        self.buffer_order = new_order
        if self.active_buffer_id == id {
            self.active_buffer_id = self.buffer_order.get((self.buffer_order.len() - 1).as(usize)).as(BufferId)
        }
        self.active_buffer_id
    }

    pub fn unsaved_file_buffers(self) -> List {
        let out = List()
        for i in 0..self.buffer_order.len() {
            let bid = self.buffer_order.get(i.as(usize)).as(BufferId)
            let b = self.buffers.get(bid).as(Buffer)
            if b.modified and b.kind == BufferKind.file {
                out.push(b)
            }
        }
        out
    }

    pub fn buffer_names(self) -> List {
        let out = List()
        for i in 0..self.buffer_order.len() {
            let bid = self.buffer_order.get(i.as(usize)).as(BufferId)
            out.push(self.buffers.get(bid).as(Buffer).name)
        }
        out
    }

    pub fn set_floating_window(self, win: FloatingWindow) {
        for i in 0..self.floating_windows.len() {
            let existing = self.floating_windows.get(i.as(usize)).as(FloatingWindow)
            if existing.id == win.id {
                self.floating_windows.set(i.as(usize), win)
                return
            }
        }
        self.floating_windows.push(win)
    }

    pub fn remove_floating_window(self, id: String) -> bool {
        for i in 0..self.floating_windows.len() {
            let existing = self.floating_windows.get(i.as(usize)).as(FloatingWindow)
            if existing.id == id {
                let _ = self.floating_windows.remove(i.as(usize))
                return true
            }
        }
        false
    }

    pub fn get_floating_window(self, id: String) -> ?FloatingWindow {
        for i in 0..self.floating_windows.len() {
            let existing = self.floating_windows.get(i.as(usize)).as(FloatingWindow)
            if existing.id == id {
                return existing
            }
        }
        null
    }

    pub fn push_notification(
        self,
        level: String,
        title: String,
        message: String,
        .ttl_ticks: i64 = 12,
    ) -> i64 {
        let id = self.next_notification_id
        self.next_notification_id += 1
        let toast = ToastNotification {
            id: id,
            level: level,
            title: title,
            message: message,
            ttl_ticks: ttl_ticks,
        }
        self.notifications.push(toast)
        while self.notifications.len() > 5 {
            let _ = self.notifications.remove(0)
        }
        self.notification_history.push(toast)
        while self.notification_history.len() > 200 {
            let _ = self.notification_history.remove(0)
        }
        id
    }

    pub fn tick_notifications(self) {
        if self.notifications.is_empty() {
            return
        }
        let next = List()
        for i in 0..self.notifications.len() {
            let t = self.notifications.get(i.as(usize)).as(ToastNotification)
            if t.ttl_ticks > 1 {
                next.push(ToastNotification {
                    id: t.id,
                    level: t.level,
                    title: t.title,
                    message: t.message,
                    ttl_ticks: t.ttl_ticks - 1,
                })
            }
        }
        self.notifications = next
    }

    pub fn clear_owner_ui(self, owner: String) {
        if self.left_sidebar.owner == owner {
            self.left_sidebar = SidebarPanel.hidden("left")
        }
        if self.right_sidebar.owner == owner {
            self.right_sidebar = SidebarPanel.hidden("right")
        }
        if self.completion_popup.owner == owner {
            self.completion_popup = CompletionPopup.inactive()
        }
        if self.signature_help.owner == owner {
            self.signature_help = SignatureHelpPopup.inactive()
        }
        if self.inline_ghost.owner == owner {
            self.inline_ghost = InlineGhostText.inactive()
        }
        let next_floats = List()
        for i in 0..self.floating_windows.len() {
            let fw = self.floating_windows.get(i.as(usize)).as(FloatingWindow)
            if fw.owner != owner {
                next_floats.push(fw)
            }
        }
        self.floating_windows = next_floats
        for i in 0..self.buffer_order.len() {
            let bid = self.buffer_order.get(i.as(usize)).as(BufferId)
            let b = self.buffers.get(bid).as(Buffer)
            b.clear_owner_decors(owner)
        }
    }
}

-- ============================================================================
-- 7. Extension Registration & Service Lookup
-- ============================================================================

pub fn require_editor_world(kernel: SystemKernel) -> !String EditorWorld {
    let raw = kernel.require_service(SERVICE_EDITOR_WORLD)!
    raw.as(EditorWorld)
}

pub fn register_document_extension(kernel: SystemKernel) -> !String Unit {
    let ext_id = ext_document_id()
    kernel.register_extension(
        ext_id,
        "lava.org",
        "ext_document",
        "0.1.0",
        "Document buffers, branching undo-tree, Emacs kill-ring, Vim/Emacs register bank, and jump/quickfix services.",
        [],
        |k: SystemKernel| -> !String Unit {
            let world = EditorWorld.new()
            k.publish_service(SERVICE_EDITOR_WORLD, ext_id, world)

            k.register_command(
                "save-buffer",
                ext_id,
                "Save active buffer to disk (prompts for file path if unnamed).",
                |kern: SystemKernel, args: List| -> #InteractiveEffects !String Any {
                    let w = require_editor_world(kern)!
                    let buf = w.active_buffer()
                    let custom_writer = "write-buffer-mode:" ++ buf.major_mode
                    if kern.get_command(custom_writer) != null {
                        let _ = kern.dispatch_command(custom_writer, args)#!
                        return ()
                    }
                    kern.emit_hook("buffer-will-save", buf.id)
                    var override_p = if not args.is_empty() { args.get(0).as(String) } else { "" }
                    if buf.file_path == "" and override_p == "" {
                        let ans? = ask_prompt(PromptRequest {
                            label: "Write file: ",
                            initial: w.cwd ++ "/",
                            kind: PromptKind.file_path,
                            candidates: List(),
                        })# else {
                            status_emit("Quit")#
                            return ()
                        }
                        override_p = ans
                    }
                    w.save_buffer(buf.id, override_path = override_p)#!
                    kern.emit_hook("buffer-saved", buf.id)
                    ()
                },
            )

            k.register_command(
                "undo",
                ext_id,
                "Undo last change along current undo-tree branch.",
                |kern: SystemKernel, _args: List| -> #InteractiveEffects !String Any {
                    let w = require_editor_world(kern)!
                    let buf = w.active_buffer()
                    let p_opt = buf.undo()!
                    if p_opt == null {
                        status_emit("Already at oldest change")#
                    } else {
                        status_emit("Undo (state #" ++ buf.undo_tree.current_id.to_string() ++ ")")#
                    }
                    ()
                },
            )

            k.register_command(
                "redo",
                ext_id,
                "Redo change along active undo-tree branch.",
                |kern: SystemKernel, _args: List| -> #InteractiveEffects !String Any {
                    let w = require_editor_world(kern)!
                    let buf = w.active_buffer()
                    let p_opt = buf.redo()!
                    if p_opt == null {
                        status_emit("Already at newest change")#
                    } else {
                        status_emit("Redo (state #" ++ buf.undo_tree.current_id.to_string() ++ ")")#
                    }
                    ()
                },
            )

            k.register_command(
                "undo-tree-visualize",
                ext_id,
                "Open *undo-tree* buffer visualizing branching undo history of active buffer.",
                |kern: SystemKernel, _args: List| -> #InteractiveEffects !String Any {
                    let w = require_editor_world(kern)!
                    let src = w.active_buffer()
                    let lines = src.undo_tree.render_tree_lines()
                    let ub = w.ensure_special_buffer("*undo-tree*", "text", lines, read_only = true)
                    let _ = w.switch_to_buffer(ub.id)
                    kern.emit_hook("buffer-switched", ub.id)
                    status_emit("Showing *undo-tree* for " ++ src.name)#
                    ()
                },
            )

            k.register_command(
                "narrow-to-region",
                ext_id,
                "Restrict editing in active buffer to rows between mark and point (`C-x n n`).",
                |kern: SystemKernel, _args: List| -> #InteractiveEffects !String Any {
                    let w = require_editor_world(kern)!
                    let buf = w.active_buffer()
                    let m? = buf.mark else {
                        status_emit("No mark set in this buffer")#
                        return ()
                    }
                    buf.narrow_to_region(m.row, buf.point.row)
                    buf.mark_active = false
                    status_emit(
                        "Narrowed to lines " ++ (buf.min_row() + 1).to_string()
                        ++ ".." ++ (buf.max_row() + 1).to_string()
                    )#
                    ()
                },
            )

            k.register_command(
                "widen",
                ext_id,
                "Remove narrowing restriction from active buffer (`C-x n w`).",
                |kern: SystemKernel, _args: List| -> #InteractiveEffects !String Any {
                    let w = require_editor_world(kern)!
                    let buf = w.active_buffer()
                    buf.widen()
                    status_emit("Widened buffer " ++ buf.name)#
                    ()
                },
            )

            k.register_command(
                "next-buffer",
                ext_id,
                "Switch to next buffer in buffer list.",
                |kern: SystemKernel, _args: List| -> #InteractiveEffects !String Any {
                    let w = require_editor_world(kern)!
                    let bid = w.cycle_buffer(1)
                    kern.emit_hook("buffer-switched", bid)
                    status_emit("Buffer: " ++ w.active_buffer().name)#
                    ()
                },
            )

            k.register_command(
                "previous-buffer",
                ext_id,
                "Switch to previous buffer in buffer list.",
                |kern: SystemKernel, _args: List| -> #InteractiveEffects !String Any {
                    let w = require_editor_world(kern)!
                    let bid = w.cycle_buffer(-1)
                    kern.emit_hook("buffer-switched", bid)
                    status_emit("Buffer: " ++ w.active_buffer().name)#
                    ()
                },
            )
            ()
        },
        |_k: SystemKernel| -> !String Unit { () },
    )
}
