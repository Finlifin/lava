fn has_registered_cmd(kernel: SystemKernel, name: String) -> bool {
    let _? = kernel.get_command(name) else {
        return false
    }
    true
}

fn cmd_dirvish_open_shell(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!
    if state.current_dir != "" {
        world.cwd = state.current_dir
    }
    if is_ssh_uri(state.current_dir) and has_registered_cmd(kernel, "remote-shell") {
        collapse_dirvish_splits(world, wm)
        let _ = kernel.dispatch_command("remote-shell", [state.current_dir])#!
        return ()
    }
    if has_registered_cmd(kernel, "terminal-here") {
        collapse_dirvish_splits(world, wm)
        let _ = kernel.dispatch_command("terminal-here", [state.current_dir])#!
        return ()
    }
    if has_registered_cmd(kernel, "toggleterm") {
        let _ = kernel.dispatch_command("toggleterm", [state.current_dir])#!
        return ()
    }
    status_emit("Shell cwd set to " ++ state.current_dir)#
    ()
}

fn cmd_dirvish_refresh(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!
    state.preview_cache.clear()
    state.preview_cache_order = List()
    state.invalidate_remote_caches()
    let cur_opt = entry_at_cursor(state, world.active_buffer())
    let keep_name = if cur_opt != null { cur_opt.as(DirvishEntry).name } else { "" }
    if state.fd_mode and state.fd_root != "" {
        state.fd_all_entries = scan_fd_all_entries(state.fd_root, state.show_hidden)!
    }
    refresh_dirvish_all(kernel, world, wm, state, focus_name = keep_name)#!
    status_emit("Dirvish refreshed: " ++ abbreviate_path(state.current_dir))#
    ()
}

fn fallback_non_dirvish_buffer_id(world: EditorWorld) -> BufferId {
    var i = world.buffer_order.len() - 1
    while i >= 0 {
        let bid = world.buffer_order.get(i.as(usize)).as(BufferId)
        let b = world.buffers.get(bid).as(Buffer)
        if (
            b.name != DIRVISH_BUF_NAME
            and b.name != DIRVISH_PARENT_BUF_NAME
            and b.name != DIRVISH_PREVIEW_BUF_NAME
            and bid != world.messages_id
        ) {
            return bid
        }
        i -= 1
    }
    world.scratch_id
}

fn resolve_quit_buffer_id(world: EditorWorld, state: DirvishState) -> BufferId {
    let orig? = state.origin_buf_id else {
        return fallback_non_dirvish_buffer_id(world)
    }
    let ob? = world.buffer(orig) else {
        return fallback_non_dirvish_buffer_id(world)
    }
    if (
        ob.name != DIRVISH_BUF_NAME
        and ob.name != DIRVISH_PARENT_BUF_NAME
        and ob.name != DIRVISH_PREVIEW_BUF_NAME
    ) {
        return orig
    }
    fallback_non_dirvish_buffer_id(world)
}

fn cmd_dirvish_quit(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!

    remote_async_cancel("dirvish.snapshot")
    remote_async_cancel("dirvish.preview")
    remote_async_cancel("dirvish.fd")
    state.remote_snap_loading = false
    state.remote_preview_loading = false
    state.remote_fd_loading = false

    collapse_dirvish_splits(world, wm)

    let restored_id = resolve_quit_buffer_id(world, state)

    world.active_buffer_id = restored_id
    let ap = wm.active_pane()
    ap.buffer_id = restored_id
    ap.cursor = world.active_buffer().point
    wm.sync_from_world(world)
    ensure_vim_normal(kernel, world)
    status_emit("Restored buffer " ++ world.active_buffer().name)#
    ()
}

fn on_dirvish_timer_tick(kern: SystemKernel, _arg: Any) {
    let st_opt = kern.service(SERVICE_DIRVISH)
    if st_opt == null {
        return
    }
    let state = st_opt.as(DirvishState)
    if (not state.remote_snap_loading) and (not state.remote_preview_loading) and (not state.remote_fd_loading) {
        return
    }
    let w_opt = kern.service("lava.document.world")
    let wm_opt = kern.service("lava.window.manager")
    if w_opt == null or wm_opt == null {
        return
    }
    let world = w_opt.as(EditorWorld)
    let wm = wm_opt.as(WindowManager)
    let dirvish_active = world.active_buffer().name == DIRVISH_BUF_NAME

    var snap_updated = false
    var preview_updated = false

    if state.remote_snap_loading {
        let sp = remote_async_poll("dirvish.snapshot")
        if sp.status == "ready" {
            state.remote_snap_loading = false
            let snap = decode_remote_dir_snap(sp.payload)
            if state.remote_snap_key != "" {
                cache_remote_snap(state, state.remote_snap_key, snap)
            }
            if not state.fd_mode {
                apply_remote_dir_snap(state, snap)
                snap_updated = true
            }
        } else if sp.status == "error" {
            state.remote_snap_loading = false
            snap_updated = true
        }
    }

    if state.remote_fd_loading {
        let fp = remote_async_poll("dirvish.fd")
        if fp.status == "ready" {
            state.remote_fd_loading = false
            if state.fd_mode and is_ssh_uri(state.fd_root) {
                let rf = decode_remote_ranked_files(fp.payload)
                apply_remote_fd_ranked(state, state.fd_root, rf)
                snap_updated = true
            }
        } else if fp.status == "error" {
            state.remote_fd_loading = false
            snap_updated = true
        }
    }

    if state.remote_preview_loading {
        let pp = remote_async_poll("dirvish.preview")
        if pp.status == "ready" {
            state.remote_preview_loading = false
            if state.remote_preview_key != "" {
                let pv = decode_remote_snap_preview(pp.payload)
                let built = build_preview_cache_from_remote_snap(
                    pv,
                    state.remote_preview_uri,
                    state.remote_preview_is_symlink,
                    state.remote_preview_is_exec,
                    state.remote_preview_size,
                )
                cache_dirvish_preview(state, state.remote_preview_key, built)
                preview_updated = true
            }
        } else if pp.status == "error" {
            state.remote_preview_loading = false
            if state.remote_preview_key != "" {
                cache_dirvish_preview(
                    state,
                    state.remote_preview_key,
                    DirvishPreviewCacheEntry {
                        kind: "unreadable",
                        major_mode: "text",
                        lines: ["  [Preview failed: " ++ pp.error_msg ++ "]"],
                        child_is_dir: List(),
                    },
                )
                preview_updated = true
            }
        }
    }

    if not dirvish_active {
        return
    }

    if snap_updated or state.remote_snap_loading or state.remote_fd_loading {
        let focus = if snap_updated { state.remote_snap_focus } else { "" }
        let pref_row = if snap_updated { state.remote_snap_pref_row } else { world.active_buffer().point.row }
        if snap_updated {
            state.remote_snap_focus = ""
            state.remote_snap_pref_row = 0
        }
        let parent_buf = render_parent_buffer(world, state)
        let center_buf = render_center_buffer(world, state, focus, pref_row)
        let preview_buf = render_preview_buffer(world, state, center_buf)
        sync_dirvish_layout(world, wm, state, parent_buf, center_buf, preview_buf)
        world.remote_tick_dirty = true
    } else if preview_updated or state.remote_preview_loading {
        let center_buf = world.active_buffer()
        let _ = render_preview_buffer(world, state, center_buf)
        wm.sync_from_world(world)
        world.remote_tick_dirty = true
    }
}

-- ============================================================================
-- 10. Extension Registration & Full Ranger Keymap Wiring
-- ============================================================================

pub fn register_dirvish_extension(kernel: SystemKernel) -> !String Unit {
    let ext_id = ext_dirvish_id()
    kernel.register_extension(
        ext_id,
        "lava.org",
        "ext_dirvish",
        "0.1.0",
        "Emacs Dirvish 3-pane Miller-columns file manager with live syntax preview and full Ranger keybindings.",
        [ext_document_id(), ext_window_id(), ext_render_id(), ext_vim_id()],
        |k: SystemKernel| -> !String Unit {
            let state = DirvishState.new()
            k.publish_service(SERVICE_DIRVISH, ext_id, state)

            -- Entry & Ex commands
            k.register_command("dirvish", ext_id, "Open Emacs Dirvish 3-pane Miller file manager.", cmd_dirvish)
            k.register_command("dirvish-jump", ext_id, "Open Dirvish in active file's parent directory (`-`).", cmd_dirvish_jump)
            k.register_command("dirvish-fd", ext_id, "Recursive fast file & directory search inside Dirvish (`:DirvishFd [dir] [pattern]`).", cmd_dirvish_fd)
            k.register_command("dirvish-fd-jump", ext_id, "Open parent directory of highlighted dirvish-fd match (`gd`).", cmd_dirvish_fd_jump)
            k.register_command("ranger", ext_id, "Open Dirvish with Ranger keybindings.", cmd_dirvish)
            k.register_command("ex:Dirvish", ext_id, "Open Dirvish (`:Dirvish [dir]`).", cmd_dirvish, interactive = false)
            k.register_command("ex:DirvishFd", ext_id, "Recursive Dirvish fd search (`:DirvishFd [dir] [pattern]`).", cmd_dirvish_fd, interactive = false)
            k.register_command("ex:Ranger", ext_id, "Open Dirvish (`:Ranger [dir]`).", cmd_dirvish, interactive = false)

            -- Navigation commands
            k.register_command("dirvish-next-line", ext_id, "Move down to next Dirvish entry and update preview (`j`).", cmd_dirvish_next_line)
            k.register_command("dirvish-prev-line", ext_id, "Move up to previous Dirvish entry and update preview (`k`).", cmd_dirvish_prev_line)
            k.register_command("dirvish-up-dir", ext_id, "Ascend to parent directory and focus previous child (`h`/`-`).", cmd_dirvish_up_dir)
            k.register_command("dirvish-enter", ext_id, "Enter directory or open file under cursor (`l`/`<Return>`).", cmd_dirvish_enter)
            k.register_command("dirvish-goto-top", ext_id, "Jump to first Dirvish entry (`gg`).", cmd_dirvish_goto_top)
            k.register_command("dirvish-goto-bottom", ext_id, "Jump to last Dirvish entry (`G`).", cmd_dirvish_goto_bottom)
            k.register_command("dirvish-history-back", ext_id, "Navigate back in Dirvish directory history (`H`).", cmd_dirvish_history_back)
            k.register_command("dirvish-history-forward", ext_id, "Navigate forward in Dirvish directory history (`L`).", cmd_dirvish_history_forward)
            k.register_command("dirvish-go-home", ext_id, "Go to `$HOME` in Dirvish (`gh`).", cmd_dirvish_go_home)
            k.register_command("dirvish-go-root", ext_id, "Go to `/` in Dirvish (`gr`).", cmd_dirvish_go_root)
            k.register_command("dirvish-go-project", ext_id, "Go to project `cwd` in Dirvish (`gp`).", cmd_dirvish_go_project)
            k.register_command("dirvish-new-tab", ext_id, "Open new tab in Dirvish at current directory (`gn`).", cmd_dirvish_new_tab)

            -- Marking commands
            k.register_command("dirvish-toggle-mark", ext_id, "Toggle mark on entry under cursor and advance (`<Space>`).", cmd_dirvish_toggle_mark)
            k.register_command("dirvish-invert-marks", ext_id, "Invert marks on all visible entries (`v`).", cmd_dirvish_invert_marks)
            k.register_command("dirvish-unmark-all", ext_id, "Unmark all entries (`uv`/`U`).", cmd_dirvish_unmark_all)

            -- Yank / Cut / Paste / Delete ring commands
            k.register_command("dirvish-yank", ext_id, "Copy marked/current entries into Dirvish file ring (`yy`).", cmd_dirvish_yank)
            k.register_command("dirvish-yank-append", ext_id, "Append marked/current entries to copy ring (`ya`).", cmd_dirvish_yank_append)
            k.register_command("dirvish-cut", ext_id, "Cut marked/current entries into Dirvish file ring (`dd`).", cmd_dirvish_cut)
            k.register_command("dirvish-cut-append", ext_id, "Append marked/current entries to cut ring (`da`).", cmd_dirvish_cut_append)
            k.register_command("dirvish-clear-ring", ext_id, "Clear Dirvish yank/cut ring (`uy`).", cmd_dirvish_clear_ring)
            k.register_command("dirvish-paste", ext_id, "Paste yanked/cut entries with safe auto-disambiguation (`pp`).", cmd_dirvish_paste)
            k.register_command("dirvish-paste-overwrite", ext_id, "Paste yanked/cut entries overwriting existing targets (`po`).", cmd_dirvish_paste_overwrite)
            k.register_command("dirvish-delete", ext_id, "Confirm and recursively delete marked/current entries (`dD`/`D`).", cmd_dirvish_delete)

            -- Rename & Create commands
            k.register_command("dirvish-rename", ext_id, "Rename entry under cursor (`cw`/`R`).", cmd_dirvish_rename)
            k.register_command("dirvish-rename-append", ext_id, "Rename entry starting at end of full name (`A`).", cmd_dirvish_rename_append)
            k.register_command("dirvish-rename-prepend", ext_id, "Prepend prefix to entry name (`I`).", cmd_dirvish_rename_prepend)
            k.register_command("dirvish-rename-stem", ext_id, "Rename file stem preserving extension (`a`).", cmd_dirvish_rename_stem)
            k.register_command("dirvish-create-file", ext_id, "Create new file (`cf`/`%`).", cmd_dirvish_create_file)
            k.register_command("dirvish-mkdir", ext_id, "Create new directory (`mk`/`+`).", cmd_dirvish_mkdir)

            -- View, Sort, Filter, Path Yank, Shell, Refresh & Quit commands
            k.register_command("dirvish-toggle-hidden", ext_id, "Toggle hidden dotfiles (`zh`/`.`).", cmd_dirvish_toggle_hidden)
            k.register_command("dirvish-toggle-preview", ext_id, "Toggle 3-pane Miller columns vs single-pane (`zp`/`<Tab>`).", cmd_dirvish_toggle_preview)
            k.register_command("dirvish-filter", ext_id, "Filter visible entries (`zf`/`/`).", cmd_dirvish_filter)
            k.register_command("dirvish-clear-filter", ext_id, "Clear entry filter (`zi`).", cmd_dirvish_clear_filter)
            k.register_command("dirvish-sort-name", ext_id, "Sort Dirvish entries by name (`on`).", cmd_dirvish_sort_name)
            k.register_command("dirvish-sort-size", ext_id, "Sort Dirvish entries by size (`os`).", cmd_dirvish_sort_size)
            k.register_command("dirvish-sort-ext", ext_id, "Sort Dirvish entries by extension (`oe`).", cmd_dirvish_sort_ext)
            k.register_command("dirvish-sort-reverse", ext_id, "Reverse Dirvish sort direction (`or`).", cmd_dirvish_sort_reverse)
            k.register_command("dirvish-yank-path", ext_id, "Copy full entry path to registers & clipboard (`yp`).", cmd_dirvish_yank_path)
            k.register_command("dirvish-yank-dir", ext_id, "Copy directory path to registers & clipboard (`yd`).", cmd_dirvish_yank_dir)
            k.register_command("dirvish-yank-name", ext_id, "Copy entry filename to registers & clipboard (`yn`).", cmd_dirvish_yank_name)
            k.register_command("dirvish-open-shell", ext_id, "Open shell in current Dirvish directory (`S`).", cmd_dirvish_open_shell)
            k.register_command("dirvish-refresh", ext_id, "Refresh Dirvish directory listing (`gR`/`r`).", cmd_dirvish_refresh)
            k.register_command("dirvish-quit", ext_id, "Quit Dirvish, collapse helper splits & restore buffer (`q`).", cmd_dirvish_quit)

            -- Global & Leader entry bindings
            let norm_km = k.ensure_keymap(KEYMAP_VIM_NORMAL)
            norm_km.bind("-", "dirvish-jump", ext_id, description = "Jump to Dirvish in parent directory")
            norm_km.bind("<Space>fd", "dirvish", ext_id, description = "Open Dirvish file manager")
            norm_km.bind("<Space>fF", "dirvish-fd", ext_id, description = "Dirvish fd recursive find")
            norm_km.bind("<Space>R", "dirvish", ext_id, description = "Open Ranger / Dirvish")

            let leader_km = k.ensure_keymap("vim-leader")
            leader_km.bind("<Space> f d", "dirvish", ext_id, description = "Dirvish file manager")
            leader_km.bind("<Space> f F", "dirvish-fd", ext_id, description = "Dirvish fd recursive find")
            leader_km.bind("<Space> R", "dirvish", ext_id, description = "Ranger / Dirvish")

            k.ensure_keymap("emacs-global").bind("<C-x> d", "dirvish", ext_id, description = "Open Dirvish")
            k.ensure_keymap("emacs-global").bind("<C-x> F", "dirvish-fd", ext_id, description = "Open Dirvish fd")
            k.ensure_keymap("global").bind("<C-x> d", "dirvish", ext_id, description = "Open Dirvish")

            -- Authentic Ranger keymap in `mode:dirvish`
            let km = k.ensure_keymap("mode:dirvish")

            -- 1. Navigation & Recursive fd
            km.bind("F", "dirvish-fd", ext_id, description = "Dirvish fd recursive find")
            km.bind("g f", "dirvish-fd", ext_id, description = "Dirvish fd recursive find")
            km.bind("g d", "dirvish-fd-jump", ext_id, description = "Open parent directory of entry")
            km.bind("j", "dirvish-next-line", ext_id, description = "Next entry")
            km.bind("<Down>", "dirvish-next-line", ext_id, description = "Next entry")
            km.bind("k", "dirvish-prev-line", ext_id, description = "Previous entry")
            km.bind("<Up>", "dirvish-prev-line", ext_id, description = "Previous entry")
            km.bind("h", "dirvish-up-dir", ext_id, description = "Parent directory")
            km.bind("-", "dirvish-up-dir", ext_id, description = "Parent directory")
            km.bind("<Left>", "dirvish-up-dir", ext_id, description = "Parent directory")
            km.bind("l", "dirvish-enter", ext_id, description = "Enter directory / open file")
            km.bind("<Right>", "dirvish-enter", ext_id, description = "Enter directory / open file")
            km.bind("<Return>", "dirvish-enter", ext_id, description = "Enter directory / open file")
            km.bind("g g", "dirvish-goto-top", ext_id, description = "First entry")
            km.bind("G", "dirvish-goto-bottom", ext_id, description = "Last entry")
            km.bind("H", "dirvish-history-back", ext_id, description = "History back")
            km.bind("L", "dirvish-history-forward", ext_id, description = "History forward")
            km.bind("g h", "dirvish-go-home", ext_id, description = "Go to $HOME")
            km.bind("g r", "dirvish-go-root", ext_id, description = "Go to /")
            km.bind("g p", "dirvish-go-project", ext_id, description = "Go to project cwd")
            km.bind("g n", "dirvish-new-tab", ext_id, description = "New tab in Dirvish")

            -- 2. Visual Marking
            km.bind("<Space>", "dirvish-toggle-mark", ext_id, description = "Toggle mark and move down")
            km.bind("m m", "dirvish-toggle-mark", ext_id, description = "Toggle mark and move down")
            km.bind("t", "dirvish-toggle-mark", ext_id, description = "Toggle mark and move down")
            km.bind("v", "dirvish-invert-marks", ext_id, description = "Invert marks in directory")
            km.bind("u v", "dirvish-unmark-all", ext_id, description = "Unmark all entries")
            km.bind("U", "dirvish-unmark-all", ext_id, description = "Unmark all entries")

            -- 3. Yank / Cut / Paste / Delete File Ring
            km.bind("y y", "dirvish-yank", ext_id, description = "Yank entries to copy ring")
            km.bind("y a", "dirvish-yank-append", ext_id, description = "Append entries to copy ring")
            km.bind("d d", "dirvish-cut", ext_id, description = "Cut entries to move ring")
            km.bind("x", "dirvish-cut", ext_id, description = "Cut entries to move ring (Yazi)")
            km.bind("d a", "dirvish-cut-append", ext_id, description = "Append entries to cut ring")
            km.bind("u y", "dirvish-clear-ring", ext_id, description = "Clear yank/cut ring")
            km.bind("p p", "dirvish-paste", ext_id, description = "Paste ring (safe auto-disambiguate)")
            km.bind("p o", "dirvish-paste-overwrite", ext_id, description = "Paste ring (overwrite)")
            km.bind("d D", "dirvish-delete", ext_id, description = "Delete marked/current entries")
            km.bind("D", "dirvish-delete", ext_id, description = "Delete marked/current entries")

            -- 4. Rename & Create
            km.bind("c w", "dirvish-rename", ext_id, description = "Rename entry")
            km.bind("R", "dirvish-rename", ext_id, description = "Rename entry")
            km.bind("A", "dirvish-rename-append", ext_id, description = "Rename (append)")
            km.bind("I", "dirvish-rename-prepend", ext_id, description = "Rename (prepend)")
            km.bind("a", "dirvish-rename-stem", ext_id, description = "Rename stem preserving extension")
            km.bind("c f", "dirvish-create-file", ext_id, description = "Create new file")
            km.bind("%", "dirvish-create-file", ext_id, description = "Create new file")
            km.bind("m k", "dirvish-mkdir", ext_id, description = "Create new directory")
            km.bind("+", "dirvish-mkdir", ext_id, description = "Create new directory")

            -- 5. View, Sort, Filter, Path Yank, Shell, Refresh & Quit
            km.bind("z h", "dirvish-toggle-hidden", ext_id, description = "Toggle hidden dotfiles")
            km.bind(".", "dirvish-toggle-hidden", ext_id, description = "Toggle hidden dotfiles")
            km.bind("z p", "dirvish-toggle-preview", ext_id, description = "Toggle 3-pane Miller preview")
            km.bind("<Tab>", "dirvish-toggle-preview", ext_id, description = "Toggle 3-pane Miller preview")
            km.bind("z f", "dirvish-filter", ext_id, description = "Filter visible entries")
            km.bind("f", "dirvish-filter", ext_id, description = "Filter visible entries (Yazi)")
            km.bind("/", "dirvish-filter", ext_id, description = "Filter visible entries")
            km.bind("z i", "dirvish-clear-filter", ext_id, description = "Clear entry filter")
            km.bind("o n", "dirvish-sort-name", ext_id, description = "Sort by name")
            km.bind("o s", "dirvish-sort-size", ext_id, description = "Sort by size")
            km.bind("o e", "dirvish-sort-ext", ext_id, description = "Sort by extension")
            km.bind("o r", "dirvish-sort-reverse", ext_id, description = "Toggle reverse sort")
            km.bind("y p", "dirvish-yank-path", ext_id, description = "Copy full path")
            km.bind("y d", "dirvish-yank-dir", ext_id, description = "Copy directory path")
            km.bind("y n", "dirvish-yank-name", ext_id, description = "Copy filename")
            km.bind("S", "dirvish-open-shell", ext_id, description = "Open shell in current dir")
            km.bind("g R", "dirvish-refresh", ext_id, description = "Refresh Dirvish")
            km.bind("r", "dirvish-refresh", ext_id, description = "Refresh Dirvish")
            km.bind("q", "dirvish-quit", ext_id, description = "Quit Dirvish and restore buffer")

            k.add_hook("timer-tick", ext_id, on_dirvish_timer_tick)

            ()
        },
        |_k: SystemKernel| -> !String Unit { () },
    )
}
