fn cmd_dirvish_toggle_hidden(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!
    let cur_opt = entry_at_cursor(state, world.active_buffer())
    let keep_name = if cur_opt != null { cur_opt.as(DirvishEntry).name } else { "" }
    state.show_hidden = not state.show_hidden
    if state.fd_mode and state.fd_root != "" {
        state.fd_all_entries = scan_fd_all_entries(state.fd_root, state.show_hidden)!
    }
    refresh_dirvish_all(kernel, world, wm, state, focus_name = keep_name)#!
    status_emit("Dirvish hidden files: " ++ (if state.show_hidden { "ON" } else { "OFF" }))#
    ()
}

fn cmd_dirvish_toggle_preview(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!
    let cur_row = world.active_buffer().point.row
    state.miller_mode = not state.miller_mode
    refresh_dirvish_all(kernel, world, wm, state, preferred_row = cur_row)#!
    status_emit(
        "Dirvish layout: " ++ (if state.miller_mode { "3-pane Miller columns" } else { "single-pane" }),
    )#
    ()
}

fn cmd_dirvish_filter(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!
    if state.fd_mode {
        let ans_opt = ask_prompt(PromptRequest.text(
            "Narrow fd (" ++ abbreviate_path(state.fd_root) ++ "): ",
            state.fd_pattern,
        ))#
        let ans? = ans_opt else {
            return ()
        }
        state.fd_pattern = ans.trim()
        refresh_dirvish_all(kernel, world, wm, state)#!
        status_emit(
            "Dirvish fd filter: '" ++ state.fd_pattern ++ "' ("
            ++ state.entries.len().to_string() ++ " matches)",
        )#
        return ()
    }
    let ans_opt = ask_prompt(PromptRequest.text("Filter entries: ", state.filter_query))#
    let ans? = ans_opt else {
        return ()
    }
    state.filter_query = ans.trim()
    refresh_dirvish_all(kernel, world, wm, state)#!
    if state.filter_query == "" {
        status_emit("Dirvish filter cleared")#
    } else {
        status_emit("Dirvish filter: '" ++ state.filter_query ++ "' (" ++ state.entries.len().to_string() ++ " matches)")#
    }
    ()
}

fn cmd_dirvish_clear_filter(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!
    if state.fd_mode {
        state.fd_pattern = ""
    } else {
        state.filter_query = ""
    }
    refresh_dirvish_all(kernel, world, wm, state)#!
    status_emit("Dirvish filter cleared")#
    ()
}

