-- ext_dirvish: Emacs Dirvish 3-Pane Miller-Columns File Manager with Full Ranger Keybindings
-- (`lava.org/ext_dirvish`).
--
-- Provides:
--   - Service `"lava.dirvish.state"` (`DirvishState`)
--   - 3-Pane Miller-Columns layout (`*dirvish-parent*` 20% | `*dirvish*` 38% | `*dirvish-preview*` 42%)
--     with single-pane toggle (`zp` / `<Tab>`) and automatic helper-split cleanup on file open / quit
--   - Live syntax-highlighted file preview (`8 KiB` / `120` lines cap, binary `\0` detection) and
--     directory child listing preview on every cursor motion
--   - Full Ranger modal keymap (`mode:dirvish`): `j`/`k`/`h`/`l`/`-`/`gg`/`G`/`H`/`L`/`gh`/`gr`/`gp`/`gn`,
--     visual marking (`<Space>`/`mm`/`t`, `v`, `uv`/`U`), yank/cut/paste/overwrite/delete file ring
--     (`yy`/`ya`/`dd`/`da`/`uy`/`pp`/`po`/`dD`/`D`), rename & create (`cw`/`R`/`A`/`I`/`a`/`cf`/`%`/`mk`/`+`),
--     view/sort/filter/yank-path/shell (`zh`/`.`/`zp`/`<Tab>`/`zf`/`/`/`zi`/`on`/`os`/`oe`/`or`/`yp`/`yd`/`yn`/`S`/`gR`/`r`/`q`).

use std.collections.{HashMap, Set}
use std.env
use std.fs
use std.fs.DirEntry
use std.io.{File, SeekFrom}
use std.path
use std.time
use @lava_sys.{rgb, rgba}
use @lava_core.{
    ExtId, InteractiveEffects, PromptKind, PromptRequest, SystemKernel, ask_prompt, clipboard_set,
    log_event, status_emit
}
use @lava_accel.{GitFileEntry, OrderlessHit, accel_git_status, accel_orderless_rank, accel_workspace_files}
use @lava_remote.{
    RemoteDirItem, RemoteDirSnap, RemoteGitFileEntry, RemoteGitStatus, RemoteRankedFile,
    RemoteRankedFiles, RemoteSnapChild, RemoteSnapEntry, RemoteSnapParent, RemoteSnapPreview,
    decode_remote_dir_snap, decode_remote_ranked_files, decode_remote_snap_preview, is_ssh_uri,
    join_ssh_uri, normalize_ssh_uri, parent_ssh_uri, parse_ssh_uri, remote_async_cancel,
    remote_async_poll, remote_async_submit, remote_copy, remote_dir_snapshot, remote_entry_preview,
    remote_git_status, remote_host_available, remote_mkdir, remote_read_lines,
    remote_read_preview_window, remote_readdir, remote_remove, remote_rename, remote_search_files,
    remote_search_files_ranked, remote_shimmer_bar, remote_spinner_frame, remote_stat,
    remote_ui_async_enabled, remote_write_lines, ssh_uri_basename
}
use @ext_document.{
    Buffer, BufferId, BufferKind, EditorWorld, Pos, RegisterValue, detect_major_mode,
    ext_document_id, require_editor_world
}
use @ext_window.{
    LayoutNode, SplitAxis, WinId, WindowManager, WindowPane, ext_window_id, require_window_manager
}
use @ext_render.ext_render_id
use @ext_vim.{
    KEYMAP_VIM_NORMAL, VimMode, VimState, ext_vim_id, require_vim_state, sync_world_from_vim
}

pub const SERVICE_DIRVISH: String = "lava.dirvish.state"

pub const DIRVISH_BUF_NAME: String = "*dirvish*"
pub const DIRVISH_PARENT_BUF_NAME: String = "*dirvish-parent*"
pub const DIRVISH_PREVIEW_BUF_NAME: String = "*dirvish-preview*"
pub const DIRVISH_DECOR_OWNER: String = "ext_dirvish"
pub const DIRVISH_NAME_COL: i64 = 6

pub fn ext_dirvish_id() -> ExtId = ExtId("lava.org/ext_dirvish")

-- ============================================================================
-- 1. Domain Model & Service State
-- ============================================================================

pub struct DirvishEntry {
    pub name: String,
    pub full_path: String,
    pub is_dir: bool,
    pub is_symlink: bool,
    pub is_exec: bool,
    pub size: i64,
    pub modified_unix_secs: i64,
    pub symlink_target: String,
    pub git_badge: String,
    pub perms: String,
}
derive Eq, PartialEq for DirvishEntry

pub struct DirvishPreviewCacheEntry {
    pub kind: String,
    pub major_mode: String,
    pub lines: List,
    pub child_is_dir: List,
}

pub struct RemoteDirCacheEntry {
    pub fetched_ms: i64,
    pub items: List,
}

pub struct RemoteGitCacheEntry {
    pub fetched_ms: i64,
    pub status: RemoteGitStatus,
}

pub struct RemoteSnapCacheEntry {
    pub fetched_ms: i64,
    pub snap: RemoteDirSnap,
}

const REMOTE_DIR_CACHE_TTL_MS: i64 = 5000
const REMOTE_GIT_CACHE_TTL_MS: i64 = 5000
const REMOTE_SNAP_CACHE_TTL_MS: i64 = 5000

pub struct DirvishState {
    pub current_dir: String,
    pub origin_buf_id: ?BufferId,
    pub miller_mode: bool,
    pub show_hidden: bool,
    pub filter_query: String,
    pub sort_by: String,
    pub sort_reverse: bool,
    pub marked_paths: Set,
    pub yank_ring: List,
    pub yank_mode: String,
    pub history: List,
    pub history_idx: i64,
    pub entries: List,
    pub parent_entries: List,
    pub cursor_by_dir: HashMap,
    pub preview_cache: HashMap,
    pub preview_cache_order: List,
    pub remote_dir_cache: HashMap,
    pub remote_dir_cache_order: List,
    pub remote_git_cache: HashMap,
    pub remote_snap_cache: HashMap,
    pub remote_snap_cache_order: List,
    pub remote_snap_loaded_dir: String,
    pub remote_snap_loading: bool,
    pub remote_snap_key: String,
    pub remote_snap_focus: String,
    pub remote_snap_pref_row: i64,
    pub remote_preview_loading: bool,
    pub remote_preview_key: String,
    pub remote_preview_uri: String,
    pub remote_preview_is_symlink: bool,
    pub remote_preview_is_exec: bool,
    pub remote_preview_size: i64,
    pub remote_fd_loading: bool,
    pub remote_fd_total_indexed: i64,
    pub remote_fd_total_matched: i64,
    pub remote_git_branch: String,
    pub fd_mode: bool,
    pub fd_root: String,
    pub fd_pattern: String,
    pub fd_all_entries: List,
}

impl DirvishState {
    pub fn new() -> DirvishState {
        DirvishState {
            current_dir: "",
            origin_buf_id: null,
            miller_mode: true,
            show_hidden: false,
            filter_query: "",
            sort_by: "name",
            sort_reverse: false,
            marked_paths: Set.new(),
            yank_ring: List(),
            yank_mode: "",
            history: List(),
            history_idx: -1,
            entries: List(),
            parent_entries: List(),
            cursor_by_dir: HashMap.new(),
            preview_cache: HashMap.new(),
            preview_cache_order: List(),
            remote_dir_cache: HashMap.new(),
            remote_dir_cache_order: List(),
            remote_git_cache: HashMap.new(),
            remote_snap_cache: HashMap.new(),
            remote_snap_cache_order: List(),
            remote_snap_loaded_dir: "",
            remote_snap_loading: false,
            remote_snap_key: "",
            remote_snap_focus: "",
            remote_snap_pref_row: 0,
            remote_preview_loading: false,
            remote_preview_key: "",
            remote_preview_uri: "",
            remote_preview_is_symlink: false,
            remote_preview_is_exec: false,
            remote_preview_size: 0,
            remote_fd_loading: false,
            remote_fd_total_indexed: 0,
            remote_fd_total_matched: 0,
            remote_git_branch: "",
            fd_mode: false,
            fd_root: "",
            fd_pattern: "",
            fd_all_entries: List(),
        }
    }

    pub fn invalidate_remote_caches(self) {
        self.remote_dir_cache.clear()
        self.remote_dir_cache_order = List()
        self.remote_git_cache.clear()
        self.remote_snap_cache.clear()
        self.remote_snap_cache_order = List()
    }

    pub fn record_history(self, dir_path: String) {
        if dir_path == "" {
            return
        }
        if self.history_idx >= 0 and self.history_idx < self.history.len() {
            let cur = self.history.get(self.history_idx.as(usize)).as(String)
            if cur == dir_path {
                return
            }
        }
        while self.history.len() > self.history_idx + 1 {
            let _ = self.history.pop()
        }
        self.history.push(dir_path)
        if self.history.len() > 100 {
            let _ = self.history.remove(0)
        }
        self.history_idx = self.history.len() - 1
    }
}

pub fn require_dirvish_state(kernel: SystemKernel) -> !String DirvishState {
    let raw = kernel.require_service(SERVICE_DIRVISH)!
    raw.as(DirvishState)
}

-- ============================================================================
-- 2. Path, Formatting, Sorting & Filesystem Inspection Helpers
-- ============================================================================

fn clean_dir_path(raw_dir: String, fallback_cwd: String) -> String {
    let base = if raw_dir.trim() == "" {
        if fallback_cwd.trim() == "" { "." } else { fallback_cwd.trim() }
    } else {
        raw_dir.trim()
    }
    if is_ssh_uri(base) {
        let pt_res = parse_ssh_uri(base)
        pt_res match {
            pt! => {
                if pt.remote_path == "/" {
                    return pt.prefix ++ "/"
                }
                return pt.prefix ++ pt.remote_path
            },
            error _ => {
                return normalize_ssh_uri(base)
            },
        }
    }
    if is_ssh_uri(fallback_cwd.trim()) and not path.is_absolute(base) {
        return clean_dir_path(join_ssh_uri(fallback_cwd.trim(), base), "/")
    }
    let abs_p = if path.is_absolute(base) {
        path.normalize(base)
    } else {
        let cwd_clean = if fallback_cwd.trim() == "" { "." } else { fallback_cwd.trim() }
        path.normalize(path.join(cwd_clean, base))
    }
    if abs_p == "" {
        return path.separator()
    }
    if abs_p.char_len() == 3 and abs_p.slice(1, 2) == ":" and (abs_p.ends_with("/") or abs_p.ends_with("\\")) {
        return abs_p
    }
    if abs_p.char_len() > 1 and (abs_p.ends_with("/") or abs_p.ends_with("\\")) {
        return abs_p.slice(0, abs_p.char_len() - 1)
    }
    abs_p
}

fn is_dir_root_path(dir_path: String) -> bool {
    if dir_path == "/" or dir_path == "\\" or dir_path == "" {
        return true
    }
    if dir_path.char_len() == 2 and dir_path.slice(1, 2) == ":" {
        return true
    }
    if dir_path.char_len() == 3 and dir_path.slice(1, 2) == ":" and (dir_path.ends_with("/") or dir_path.ends_with("\\")) {
        return true
    }
    if is_ssh_uri(dir_path) {
        let pt_res = parse_ssh_uri(dir_path)
        pt_res match {
            pt! => {
                return pt.remote_path == "/"
            },
            error _ => {
                return false
            },
        }
    }
    false
}

fn any_parent_dir(target_path: String) -> String {
    if is_ssh_uri(target_path) {
        return clean_dir_path(parent_ssh_uri(target_path), "/")
    }
    let p_opt = path.parent(target_path)
    if p_opt != null and p_opt.as(String) != "" {
        return clean_dir_path(p_opt.as(String), "/")
    }
    "/"
}

fn any_basename(target_path: String) -> String {
    if is_ssh_uri(target_path) {
        return ssh_uri_basename(target_path)
    }
    let fn_opt = path.file_name(target_path)
    if fn_opt != null {
        return fn_opt.as(String)
    }
    ""
}

fn any_join_path(dir_path: String, child: String) -> String {
    if is_ssh_uri(dir_path) {
        return clean_dir_path(join_ssh_uri(dir_path, child), "/")
    }
    path.normalize(path.join(dir_path, child))
}

fn any_exists(target_path: String) -> bool {
    if is_ssh_uri(target_path) {
        let st_res = remote_stat(target_path)
        st_res match {
            st! => {
                return st.exists
            },
            error _ => {
                return false
            },
        }
    }
    fs.exists(target_path)
}

fn any_is_dir(target_path: String) -> bool {
    if is_ssh_uri(target_path) {
        let st_res = remote_stat(target_path)
        st_res match {
            st! => {
                return st.exists and st.is_dir
            },
            error _ => {
                return false
            },
        }
    }
    fs.is_dir(target_path)
}

fn home_directory() -> String {
    let h = env.get_or("HOME", env.get_or("USERPROFILE", "")).trim()
    if h != "" {
        return clean_dir_path(h, path.separator())
    }
    path.separator()
}

fn abbreviate_path(dir_path: String) -> String {
    if is_ssh_uri(dir_path) {
        return dir_path
    }
    let home = home_directory()
    if home != "/" and home != "\\" and home != "" {
        if dir_path == home {
            return "~"
        }
        if dir_path.starts_with(home ++ "/") or dir_path.starts_with(home ++ "\\") {
            return "~" ++ dir_path.slice(home.char_len(), dir_path.char_len())
        }
    }
    dir_path
}

fn pad_left(s: String, width: i64) -> String {
    let n = s.char_len()
    if n >= width {
        return s.take(width)
    }
    " ".repeat(width - n) ++ s
}

fn pad_right(s: String, width: i64) -> String {
    let n = s.char_len()
    if n >= width {
        return s.take(width)
    }
    s ++ " ".repeat(width - n)
}

fn format_human_size(bytes: i64) -> String {
    if bytes < 0 {
        return "    0B"
    }
    if bytes < 1024 {
        return pad_left(bytes.to_string() ++ "B", 6)
    }
    if bytes < 1024 * 1024 {
        let tenths = (bytes * 10) / 1024
        let whole = tenths / 10
        let frac = tenths % 10
        let txt = if whole >= 100 {
            whole.to_string() ++ "K"
        } else {
            whole.to_string() ++ "." ++ frac.to_string() ++ "K"
        }
        return pad_left(txt, 6)
    }
    if bytes < 1024 * 1024 * 1024 {
        let tenths = (bytes * 10) / (1024 * 1024)
        let whole = tenths / 10
        let frac = tenths % 10
        let txt = if whole >= 100 {
            whole.to_string() ++ "M"
        } else {
            whole.to_string() ++ "." ++ frac.to_string() ++ "M"
        }
        return pad_left(txt, 6)
    }
    let tenths = (bytes * 10) / (1024 * 1024 * 1024)
    let whole = tenths / 10
    let frac = tenths % 10
    pad_left(whole.to_string() ++ "." ++ frac.to_string() ++ "G", 6)
}

fn split_stem_and_ext(filename: String) -> (String, String) {
    if filename == "" or filename == "." or filename == ".." {
        return (filename, "")
    }
    let n = filename.char_len()
    var dot_idx: i64 = -1
    var i = n - 1
    while i > 0 {
        if filename.slice(i, i + 1) == "." {
            dot_idx = i
            break
        }
        i -= 1
    }
    if dot_idx <= 0 {
        return (filename, "")
    }
    (filename.slice(0, dot_idx), filename.slice(dot_idx, n))
}

fn entry_extension_lower(name: String) -> String {
    let (_, ext) = split_stem_and_ext(name)
    if ext.starts_with(".") {
        return ext.slice(1, ext.char_len()).to_lower()
    }
    ext.to_lower()
}

fn read_file_magic_bytes(full_path: String) -> !IoError List {
    let raw = File.with_open(full_path, mode = .read) do |f| {
        f.read_bytes(max_bytes = 4)!
    }!
    raw.as(List)
}

fn looks_executable_file(full_path: String, name: String, size: i64) -> bool {
    let low = name.to_lower()
    if (
        low.ends_with(".sh")
        or low.ends_with(".bash")
        or low.ends_with(".zsh")
        or low.ends_with(".bin")
        or low.ends_with(".out")
        or low.ends_with(".appimage")
    ) {
        return true
    }
    if size < 2 {
        return false
    }
    let hdr = read_file_magic_bytes(full_path) ! { _ => return false }
    if hdr.len() >= 2 {
        let b0 = hdr.get(0).as(i64)
        let b1 = hdr.get(1).as(i64)
        -- `#!` script shebang
        if b0 == 35 and b1 == 33 {
            return true
        }
    }
    if hdr.len() >= 4 {
        let b0 = hdr.get(0).as(i64)
        let b1 = hdr.get(1).as(i64)
        let b2 = hdr.get(2).as(i64)
        let b3 = hdr.get(3).as(i64)
        -- `\x7fELF` binary header
        if b0 == 127 and b1 == 69 and b2 == 76 and b3 == 70 {
            return true
        }
    }
    false
}

fn find_git_repo_root(dir_path: String) -> ?String {
    var cur = dir_path
    var depth: i64 = 0
    while cur != "" and depth < 32 {
        let git_marker = path.join(cur, ".git")
        if fs.exists(git_marker) {
            return cur
        }
        if cur == "/" {
            break
        }
        let p_opt = path.parent(cur)
        if p_opt == null {
            break
        }
        let next_dir = p_opt.as(String)
        if next_dir == "" or next_dir == cur {
            break
        }
        cur = next_dir
        depth += 1
    }
    null
}

fn normalize_git_badge(idx_st: String, wt_st: String) -> String {
    if idx_st == "?" or wt_st == "?" {
        return "?"
    }
    if idx_st == "D" or wt_st == "D" {
        return "D"
    }
    if idx_st == "A" or wt_st == "A" {
        return "A"
    }
    if idx_st == "M" or wt_st == "M" or idx_st == "R" or wt_st == "R" or idx_st == "C" {
        return "M"
    }
    if idx_st.trim() != "" {
        return idx_st.trim().take(1)
    }
    if wt_st.trim() != "" {
        return wt_st.trim().take(1)
    }
    " "
}

fn lookup_cached_remote_git(state: DirvishState, dir_clean: String, now_ms: i64) -> ?RemoteGitStatus {
    let direct_opt = state.remote_git_cache.get(dir_clean)
    if direct_opt != null {
        let ent = direct_opt.as(RemoteGitCacheEntry)
        if now_ms - ent.fetched_ms <= REMOTE_GIT_CACHE_TTL_MS {
            return ent.status
        }
    }
    var probe = dir_clean
    var depth: i64 = 0
    while depth < 12 and not is_dir_root_path(probe) {
        let par = any_parent_dir(probe)
        if par == "" or par == probe {
            break
        }
        probe = par
        let anc_opt = state.remote_git_cache.get(probe)
        if anc_opt != null {
            let ent = anc_opt.as(RemoteGitCacheEntry)
            if now_ms - ent.fetched_ms <= REMOTE_GIT_CACHE_TTL_MS {
                return ent.status
            }
        }
        depth += 1
    }
    null
}

fn collect_dir_git_badges(dir_path: String, .state: ?DirvishState = null) -> HashMap {
    let badges = HashMap.new()
    if is_ssh_uri(dir_path) {
        let dir_clean = clean_dir_path(dir_path, "/")
        let now_ms = time.unix_millis()
        let cached_opt = if state != null {
            lookup_cached_remote_git(state.as(DirvishState), dir_clean, now_ms)
        } else {
            null
        }
        let rsum = if cached_opt != null {
            cached_opt.as(RemoteGitStatus)
        } else {
            let fetched = remote_git_status(dir_path) ! { _ => return badges }
            if state != null {
                let st = state.as(DirvishState)
                if st.remote_git_cache.len() >= 32 {
                    st.remote_git_cache.clear()
                }
                let ce = RemoteGitCacheEntry {
                    fetched_ms: now_ms,
                    status: fetched,
                }
                st.remote_git_cache.insert(dir_clean, ce)
                if fetched.is_repo and fetched.root != "" {
                    st.remote_git_cache.insert(clean_dir_path(fetched.root, "/"), ce)
                }
            }
            fetched
        }
        if not rsum.is_repo {
            return badges
        }
        let repo_root = clean_dir_path(rsum.root, "/")
        var rel_prefix = ""
        if dir_clean == repo_root {
            rel_prefix = ""
        } else if repo_root.ends_with("/") and dir_clean.starts_with(repo_root) {
            rel_prefix = dir_clean.slice(repo_root.char_len(), dir_clean.char_len()) ++ "/"
        } else if dir_clean.starts_with(repo_root ++ "/") {
            rel_prefix = dir_clean.slice(repo_root.char_len() + 1, dir_clean.char_len()) ++ "/"
        } else {
            return badges
        }
        for i in 0..rsum.entries.len() {
            let rge = rsum.entries.get(i.as(usize)).as(RemoteGitFileEntry)
            let rp = rge.rel_path
            if rel_prefix == "" or rp.starts_with(rel_prefix) {
                let sub = if rel_prefix == "" {
                    rp
                } else {
                    rp.slice(rel_prefix.char_len(), rp.char_len())
                }
                if sub != "" {
                    let sp_opt = sub.split_once("/")
                    let child_name = if sp_opt != null {
                        let (head, _) = sp_opt.as((String, String))
                        head
                    } else {
                        sub
                    }
                    if child_name != "" {
                        let badge = normalize_git_badge(rge.index_status, rge.worktree_status)
                        if badge != " " {
                            let existing_opt = badges.get(child_name)
                            if existing_opt == null or existing_opt.as(String) == "?" {
                                badges.insert(child_name, badge)
                            }
                        }
                    }
                }
            }
        }
        return badges
    }
    let repo_opt = find_git_repo_root(dir_path)
    if repo_opt == null {
        return badges
    }
    let summary = accel_git_status(dir_path)
    if not summary.is_repo {
        return badges
    }
    let repo_root = clean_dir_path(
        if summary.root != "" { summary.root } else { repo_opt.as(String) },
        "/",
    )
    let dir_clean = clean_dir_path(dir_path, "/")
    var rel_prefix = ""
    if dir_clean == repo_root {
        rel_prefix = ""
    } else if repo_root == "/" and dir_clean.starts_with("/") {
        rel_prefix = dir_clean.slice(1, dir_clean.char_len()) ++ "/"
    } else if dir_clean.starts_with(repo_root ++ "/") {
        rel_prefix = dir_clean.slice(repo_root.char_len() + 1, dir_clean.char_len()) ++ "/"
    } else {
        return badges
    }

    for i in 0..summary.entries.len() {
        let ge = summary.entries.get(i.as(usize)).as(GitFileEntry)
        let rp = ge.rel_path
        if rel_prefix == "" or rp.starts_with(rel_prefix) {
            let sub = if rel_prefix == "" {
                rp
            } else {
                rp.slice(rel_prefix.char_len(), rp.char_len())
            }
            if sub != "" {
                let sp_opt = sub.split_once("/")
                let child_name = if sp_opt != null {
                    let (head, _) = sp_opt.as((String, String))
                    head
                } else {
                    sub
                }
                if child_name != "" {
                    let badge = normalize_git_badge(ge.index_status, ge.worktree_status)
                    if badge != " " {
                        -- Prefer `M` / `D` / `A` over `?` on directories with mixed changes
                        let existing_opt = badges.get(child_name)
                        if existing_opt == null or existing_opt.as(String) == "?" {
                            badges.insert(child_name, badge)
                        }
                    }
                }
            }
        }
    }
    badges
}

fn compare_entries(a: DirvishEntry, b: DirvishEntry, sort_by: String, sort_reverse: bool) -> bool {
    -- Directories ALWAYS grouped first (like Ranger & Emacs Dirvish)
    if a.is_dir and (not b.is_dir) {
        return false
    }
    if (not a.is_dir) and b.is_dir {
        return true
    }

    let al = a.name.to_lower()
    let bl = b.name.to_lower()

    var raw_greater = false
    if sort_by == "size" and (not a.is_dir) and (not b.is_dir) {
        if a.size != b.size {
            -- Larger or smaller: ascending size puts smaller first, `or` reverses
            raw_greater = a.size > b.size
        } else {
            raw_greater = if al != bl { al > bl } else { a.name > b.name }
        }
    } else if sort_by == "ext" and (not a.is_dir) and (not b.is_dir) {
        let ae = entry_extension_lower(a.name)
        let be = entry_extension_lower(b.name)
        if ae != be {
            raw_greater = ae > be
        } else {
            raw_greater = if al != bl { al > bl } else { a.name > b.name }
        }
    } else {
        raw_greater = if al != bl { al > bl } else { a.name > b.name }
    }

    if sort_reverse {
        return not raw_greater and (a.name != b.name or a.size != b.size)
    }
    raw_greater
}

fn sort_dirvish_entries(entries: List, sort_by: String, sort_reverse: bool) {
    let n = entries.len()
    for i in 1..n {
        let cur = entries.get(i.as(usize)).as(DirvishEntry)
        var j = i - 1
        while j >= 0 {
            let prev = entries.get(j.as(usize)).as(DirvishEntry)
            if compare_entries(prev, cur, sort_by, sort_reverse) {
                entries.set((j + 1).as(usize), prev)
                j -= 1
            } else {
                break
            }
        }
        entries.set((j + 1).as(usize), cur)
    }
}

fn cached_remote_readdir(
    state: ?DirvishState,
    dir_path: String,
    show_hidden: bool,
) -> !String List {
    if state == null {
        return remote_readdir(dir_path, show_hidden = show_hidden)!
    }
    let st = state.as(DirvishState)
    let key = clean_dir_path(dir_path, "/") ++ "\n" ++ show_hidden.to_string()
    let now_ms = time.unix_millis()
    let cached_opt = st.remote_dir_cache.get(key)
    if cached_opt != null {
        let ent = cached_opt.as(RemoteDirCacheEntry)
        if now_ms - ent.fetched_ms <= REMOTE_DIR_CACHE_TTL_MS {
            return ent.items
        }
    }
    let ritems = remote_readdir(dir_path, show_hidden = show_hidden)!
    if not st.remote_dir_cache.contains_key(key) {
        if st.remote_dir_cache_order.len() >= 64 {
            let oldest = st.remote_dir_cache_order.remove(0).as(String)
            let _ = st.remote_dir_cache.remove(oldest)
        }
        st.remote_dir_cache_order.push(key)
    }
    st.remote_dir_cache.insert(key, RemoteDirCacheEntry {
        fetched_ms: now_ms,
        items: ritems,
    })
    ritems
}

fn scan_directory_entries(
    dir_path: String,
    show_hidden: bool,
    filter_query: String,
    sort_by: String,
    sort_reverse: bool,
    include_git: bool,
    .state: ?DirvishState = null,
) -> !String List {
    if is_ssh_uri(dir_path) {
        let ritems = cached_remote_readdir(state, dir_path, show_hidden)!
        let git_badges = if include_git {
            collect_dir_git_badges(dir_path, state = state)
        } else {
            HashMap.new()
        }
        let q_low = filter_query.trim().to_lower()
        let out = List()
        for i in 0..ritems.len() {
            let ri = ritems.get(i.as(usize)).as(RemoteDirItem)
            if ri.name == "." or ri.name == ".." {
                continue
            }
            if (not show_hidden) and ri.name.starts_with(".") {
                continue
            }
            if q_low != "" and (not ri.name.to_lower().contains(q_low)) {
                continue
            }
            let low = ri.name.to_lower()
            let is_exec = (not ri.is_dir) and (
                low.ends_with(".sh")
                or low.ends_with(".bash")
                or low.ends_with(".zsh")
                or low.ends_with(".bin")
                or low.ends_with(".out")
            )
            let perms = if ri.is_dir {
                "drwxr-xr-x"
            } else if is_exec {
                "-rwxr-xr-x"
            } else {
                "-rw-r--r--"
            }
            let badge_opt = git_badges.get(ri.name)
            let git_badge = if badge_opt != null { badge_opt.as(String) } else { " " }
            out.push(DirvishEntry {
                name: ri.name,
                full_path: clean_dir_path(ri.full_uri, dir_path),
                is_dir: ri.is_dir,
                is_symlink: false,
                is_exec: is_exec,
                size: ri.size,
                modified_unix_secs: 0,
                symlink_target: "",
                git_badge: git_badge,
                perms: perms,
            })
        }
        sort_dirvish_entries(out, sort_by, sort_reverse)
        return out
    }
    let raw = (fs.read_dir_entries(dir_path) ! {
        err => error ("Cannot read directory '" ++ dir_path ++ "': " ++ err.to_string())
    })!
    let git_badges = if include_git {
        collect_dir_git_badges(dir_path)
    } else {
        HashMap.new()
    }
    let q_low = filter_query.trim().to_lower()
    let out = List()

    for i in 0..raw.len() {
        let de = raw.get(i.as(usize)).as(DirEntry)
        if de.name == "." or de.name == ".." {
            continue
        }
        if (not show_hidden) and de.name.starts_with(".") {
            continue
        }
        if q_low != "" and (not de.name.to_lower().contains(q_low)) {
            continue
        }
        let full_p = clean_dir_path(path.join(dir_path, de.name), dir_path)
        let is_dir_real = de.is_dir() or (de.is_symlink() and fs.is_dir(full_p))
        let is_exec = if (not is_dir_real) and (not de.is_symlink()) {
            looks_executable_file(full_p, de.name, de.size)
        } else {
            false
        }
        let perms = if de.is_symlink() {
            "lrwxrwxrwx"
        } else if is_dir_real {
            "drwxr-xr-x"
        } else if is_exec {
            "-rwxr-xr-x"
        } else {
            "-rw-r--r--"
        }
        var sym_target = ""
        if de.is_symlink() {
            let canon_opt = fs.canonicalize(full_p) ! { _ => "" }
            sym_target = canon_opt
        }
        let badge_opt = git_badges.get(de.name)
        let git_badge = if badge_opt != null { badge_opt.as(String) } else { " " }

        out.push(DirvishEntry {
            name: de.name,
            full_path: full_p,
            is_dir: is_dir_real,
            is_symlink: de.is_symlink(),
            is_exec: is_exec,
            size: de.size,
            modified_unix_secs: de.modified_unix_secs,
            symlink_target: sym_target,
            git_badge: git_badge,
            perms: perms,
        })
    }

    sort_dirvish_entries(out, sort_by, sort_reverse)
    out
}

-- ============================================================================
-- 3. Buffer Construction, Column Highlighting & Live Preview Rendering
-- ============================================================================

fn ensure_dirvish_buffer(
    world: EditorWorld,
    exact_name: String,
    kind: BufferKind,
    major_mode: String,
    dir_path: String,
) -> Buffer {
    let existing? = world.find_buffer_by_name(exact_name) else {
        let b = world.create_buffer(
            exact_name,
            kind,
            file_path = dir_path,
            major_mode = major_mode,
            initial_lines = [""],
        )
        b.read_only = true
        b.modified = false
        return b
    }
    existing.kind = kind
    existing.major_mode = major_mode
    existing.file_path = dir_path
    existing.read_only = true
    existing.modified = false
    existing
}

fn color_header_bg() -> i64 = rgba(49, 50, 68, 190)
fn color_accent_blue() -> i64 = rgb(137, 180, 250)
fn color_active_parent_bg() -> i64 = rgba(137, 180, 250, 52)
fn color_mark_yellow() -> i64 = rgb(249, 226, 175)
fn color_mark_row_bg() -> i64 = rgba(249, 226, 175, 32)
fn color_exec_green() -> i64 = rgb(166, 227, 161)
fn color_symlink_cyan() -> i64 = rgb(148, 226, 213)
fn color_muted_gray() -> i64 = rgb(127, 132, 156)
fn color_git_untracked() -> i64 = rgb(250, 179, 135)
fn color_git_deleted() -> i64 = rgb(243, 139, 168)
fn color_file_icon() -> i64 = rgb(180, 190, 254)
fn color_file_fg() -> i64 = rgb(205, 214, 244)

fn git_badge_color(badge: String) -> i64 {
    when {
        badge == "M" => color_mark_yellow(),
        badge == "A" => color_exec_green(),
        badge == "?" => color_git_untracked(),
        badge == "D" => color_git_deleted(),
        else => color_muted_gray(),
    }
}

fn render_parent_buffer(world: EditorWorld, state: DirvishState) -> Buffer {
    let parent_buf = ensure_dirvish_buffer(
        world,
        DIRVISH_PARENT_BUF_NAME,
        BufferKind.directory,
        "dirvish-parent",
        "",
    )
    parent_buf.read_only = false
    parent_buf.clear_owner_decors(DIRVISH_DECOR_OWNER)

    if not state.miller_mode {
        parent_buf.major_mode = "dirvish-parent-hidden"
        parent_buf.file_path = ""
        parent_buf.point = Pos.zero()
        parent_buf.modified = false
        parent_buf.read_only = true
        return parent_buf
    }

    if is_dir_root_path(state.current_dir) {
        state.parent_entries = List()
        parent_buf.file_path = ""
        let root_line = "  [root " ++ state.current_dir ++ "]"
        parent_buf.set_lines([root_line], record_undo = false)
        parent_buf.add_inline_decor(
            DIRVISH_DECOR_OWNER,
            0,
            0,
            root_line.char_len(),
            bg_rgba = color_active_parent_bg(),
            fg_rgba = color_accent_blue(),
        )
        parent_buf.point = Pos.new(0, 2)
        parent_buf.modified = false
        parent_buf.read_only = true
        return parent_buf
    }

    let parent_dir = any_parent_dir(state.current_dir)
    parent_buf.file_path = ""

    let cur_base = any_basename(state.current_dir)

    let p_entries = if is_ssh_uri(state.current_dir) {
        if (not state.parent_entries.is_empty()) or state.remote_snap_loading or remote_ui_async_enabled() {
            state.parent_entries
        } else {
            let show_dots = state.show_hidden or cur_base.starts_with(".")
            let scanned = scan_directory_entries(
                parent_dir,
                show_dots,
                "",
                "name",
                false,
                false,
                state = state,
            ) ! { _ => List() }
            state.parent_entries = scanned
            scanned
        }
    } else {
        -- Always include `cur_base` even if it starts with `.` and `show_hidden` is false
        let show_dots = state.show_hidden or cur_base.starts_with(".")
        let scanned = scan_directory_entries(
            parent_dir,
            show_dots,
            "",
            "name",
            false,
            false,
            state = state,
        ) ! { _ => List() }
        state.parent_entries = scanned
        scanned
    }

    let lines = List()
    let p_spin = if is_ssh_uri(state.current_dir) and state.remote_snap_loading and p_entries.is_empty() {
        " " ++ remote_spinner_frame()
    } else {
        ""
    }
    let hdr = " " ++ abbreviate_path(parent_dir) ++ p_spin
    lines.push(hdr)

    var active_row: i64 = 0
    for i in 0..p_entries.len() {
        let pe = p_entries.get(i.as(usize)).as(DirvishEntry)
        let is_cur_dir = pe.name == cur_base
        let icon = if pe.is_dir {
            if is_cur_dir { " " } else if pe.is_symlink { " " } else { " " }
        } else {
            entry_icon(pe) ++ " "
        }
        let suffix = if pe.is_dir { "/" } else { "" }
        let ln = " " ++ icon ++ pe.name ++ suffix
        lines.push(ln)
        if is_cur_dir {
            active_row = i + 1
        }
    }

    parent_buf.set_lines(lines, record_undo = false)
    parent_buf.add_inline_decor(
        DIRVISH_DECOR_OWNER,
        0,
        0,
        hdr.char_len(),
        bg_rgba = color_header_bg(),
        fg_rgba = color_muted_gray(),
    )

    for i in 0..p_entries.len() {
        let row = i + 1
        let pe = p_entries.get(i.as(usize)).as(DirvishEntry)
        let llen = parent_buf.line_char_len(row)
        if row == active_row {
            parent_buf.add_inline_decor(
                DIRVISH_DECOR_OWNER,
                row,
                0,
                llen,
                bg_rgba = color_active_parent_bg(),
                fg_rgba = color_accent_blue(),
            )
        } else if pe.is_dir {
            parent_buf.add_inline_decor(
                DIRVISH_DECOR_OWNER,
                row,
                0,
                llen,
                fg_rgba = color_accent_blue(),
            )
        } else {
            parent_buf.add_inline_decor(
                DIRVISH_DECOR_OWNER,
                row,
                0,
                llen,
                fg_rgba = color_muted_gray(),
            )
        }
    }

    parent_buf.point = Pos.new(active_row, if active_row > 0 { 3 } else { 1 })
    parent_buf.modified = false
    parent_buf.read_only = true
    parent_buf
}

fn entry_icon(ent: DirvishEntry) -> String {
    if ent.is_dir {
        if ent.is_symlink {
            return ""
        }
        return ""
    }
    if ent.is_symlink {
        return ""
    }
    if ent.is_exec {
        return ""
    }
    let low_name = ent.name.to_lower()
    if low_name == ".gitignore" or low_name == ".gitmodules" or low_name == ".gitattributes" {
        return ""
    }
    let ext = entry_extension_lower(ent.name)
    when {
        ext == "rs" => "",
        ext == "ns" or ext == "zig" => "",
        ext == "lua" => "",
        ext == "py" => "",
        ext == "c" or ext == "h" => "",
        ext == "cpp" or ext == "cc" or ext == "cxx" or ext == "hpp" or ext == "hxx" => "",
        ext == "js" or ext == "jsx" or ext == "mjs" or ext == "cjs" => "",
        ext == "ts" or ext == "tsx" => "",
        ext == "go" => "",
        ext == "md" or ext == "markdown" => "",
        ext == "txt" or ext == "org" or ext == "rst" => "",
        ext == "json" or ext == "jsonc" => "",
        ext == "toml" or ext == "yaml" or ext == "yml" or ext == "lock" or ext == "ini" or ext == "conf" => "",
        ext == "html" or ext == "htm" => "",
        ext == "css" or ext == "scss" => "",
        ext == "sh" or ext == "bash" or ext == "zsh" or ext == "fish" => "",
        ext == "zip" or ext == "tar" or ext == "gz" or ext == "xz" or ext == "zst" or ext == "bz2" or ext == "7z" => "",
        ext == "png" or ext == "jpg" or ext == "jpeg" or ext == "gif" or ext == "svg" or ext == "webp" or ext == "ico" => "",
        else => "",
    }
}

fn format_center_header(state: DirvishState) -> String {
    let hidden_tag = if state.show_hidden { "  ·hidden" } else { "" }
    let ring_tag = if not state.yank_ring.is_empty() {
        "  " ++ state.yank_mode ++ ":" ++ state.yank_ring.len().to_string()
    } else {
        ""
    }
    if state.fd_mode {
        let count_tag = if is_ssh_uri(state.fd_root) and state.remote_fd_total_indexed > 0 {
            "[" ++ state.remote_fd_total_matched.to_string() ++ "/" ++ state.remote_fd_total_indexed.to_string() ++ "]"
        } else {
            "[" ++ state.entries.len().to_string() ++ "]"
        }
        let spin_tag = if state.remote_fd_loading {
            "  " ++ remote_spinner_frame() ++ " Searching server..."
        } else {
            ""
        }
        let pat_lbl = if state.fd_pattern != "" { state.fd_pattern } else { "*" }
        return "   fd " ++ abbreviate_path(state.fd_root) ++ "  " ++ count_tag ++ "  fd:" ++ pat_lbl ++ hidden_tag ++ ring_tag ++ spin_tag
    }
    let count_tag = "[" ++ state.entries.len().to_string() ++ "]"
    let sort_arrow = if state.sort_reverse { "↓" } else { "↑" }
    let sort_tag = "sort:" ++ state.sort_by ++ " " ++ sort_arrow
    let filter_tag = if state.filter_query != "" {
        "  filter:" ++ state.filter_query
    } else {
        ""
    }
    let git_tag = if is_ssh_uri(state.current_dir) and state.remote_git_branch != "" {
        "   " ++ state.remote_git_branch
    } else {
        ""
    }
    let spin_tag = if state.remote_snap_loading {
        "  " ++ remote_spinner_frame() ++ " Refreshing..."
    } else {
        ""
    }
    "   " ++ abbreviate_path(state.current_dir) ++ "  " ++ count_tag ++ git_tag ++ "  " ++ sort_tag ++ hidden_tag ++ filter_tag ++ ring_tag ++ spin_tag
}

fn render_center_buffer(
    world: EditorWorld,
    state: DirvishState,
    focus_name: String,
    preferred_row: i64,
) -> Buffer {
    let buf = ensure_dirvish_buffer(
        world,
        DIRVISH_BUF_NAME,
        BufferKind.directory,
        "dirvish",
        state.current_dir,
    )
    buf.read_only = false
    buf.clear_owner_decors(DIRVISH_DECOR_OWNER)

    let lines = List()
    let header = format_center_header(state)
    lines.push(header)

    if state.entries.is_empty() {
        let is_loading = (state.fd_mode and state.remote_fd_loading)
            or ((not state.fd_mode) and state.remote_snap_loading)
        if is_loading {
            let spin_line = "    " ++ remote_spinner_frame() ++ " Fetching render snapshot from lava-server..."
            let bar_line = "    " ++ remote_shimmer_bar(width = 22)
            lines.push(spin_line)
            lines.push(bar_line)
            buf.set_lines(lines, record_undo = false)
            buf.add_inline_decor(
                DIRVISH_DECOR_OWNER,
                0,
                0,
                header.char_len(),
                bg_rgba = color_header_bg(),
                fg_rgba = color_accent_blue(),
            )
            buf.add_inline_decor(
                DIRVISH_DECOR_OWNER,
                1,
                0,
                spin_line.char_len(),
                fg_rgba = color_accent_blue(),
            )
            buf.add_inline_decor(
                DIRVISH_DECOR_OWNER,
                2,
                0,
                bar_line.char_len(),
                fg_rgba = color_muted_gray(),
            )
            buf.point = Pos.new(1, 4)
            buf.modified = false
            buf.read_only = true
            return buf
        }
        let empty_msg = if state.fd_mode and state.fd_pattern != "" {
            "    (no matches for '" ++ state.fd_pattern ++ "')"
        } else if state.filter_query != "" {
            "    (no entries matching filter '" ++ state.filter_query ++ "')"
        } else {
            "    (empty directory)"
        }
        lines.push(empty_msg)
        buf.set_lines(lines, record_undo = false)
        buf.add_inline_decor(
            DIRVISH_DECOR_OWNER,
            0,
            0,
            header.char_len(),
            bg_rgba = color_header_bg(),
            fg_rgba = color_accent_blue(),
        )
        buf.add_inline_decor(
            DIRVISH_DECOR_OWNER,
            1,
            0,
            empty_msg.char_len(),
            fg_rgba = color_muted_gray(),
        )
        buf.point = Pos.new(1, 4)
        buf.modified = false
        buf.read_only = true
        return buf
    }

    var target_row: i64 = -1
    let remembered_opt = state.cursor_by_dir.get(state.current_dir)
    let effective_focus = if focus_name != "" {
        focus_name
    } else if remembered_opt != null and preferred_row < 1 {
        remembered_opt.as(String)
    } else {
        ""
    }

    let name_col_ends = List()
    for i in 0..state.entries.len() {
        let ent = state.entries.get(i.as(usize)).as(DirvishEntry)
        let is_marked = state.marked_paths.contains(ent.full_path)
        var in_ring = false
        for ri in 0..state.yank_ring.len() {
            if state.yank_ring.get(ri.as(usize)).as(String) == ent.full_path {
                in_ring = true
                break
            }
        }
        let mark_col = if is_marked {
            "●"
        } else if in_ring and state.yank_mode == "cut" {
            "-"
        } else if in_ring {
            "+"
        } else {
            " "
        }
        let git_col = if ent.git_badge != "" { ent.git_badge.take(1) } else { " " }
        let size_col = if ent.is_dir {
            "dir"
        } else {
            format_human_size(ent.size).trim()
        }
        let icon_col = entry_icon(ent)
        let suffix = if ent.is_dir { "/" } else { "" }
        let sym_info = if ent.is_symlink and ent.symlink_target != "" {
            " -> " ++ ent.symlink_target
        } else {
            ""
        }
        let raw_name = ent.name ++ suffix ++ sym_info
        let padded_name = pad_right(raw_name, 30)
        let name_end = 6 + padded_name.char_len()
        name_col_ends.push(name_end)
        let line = mark_col ++ " " ++ git_col ++ " " ++ icon_col ++ " " ++ padded_name ++ "  " ++ size_col
        lines.push(line)

        if effective_focus != "" and ent.name == effective_focus {
            target_row = i + 1
        }
    }

    buf.set_lines(lines, record_undo = false)
    buf.add_inline_decor(
        DIRVISH_DECOR_OWNER,
        0,
        0,
        header.char_len(),
        bg_rgba = color_header_bg(),
        fg_rgba = color_accent_blue(),
    )

    for i in 0..state.entries.len() {
        let row = i + 1
        let ent = state.entries.get(i.as(usize)).as(DirvishEntry)
        let llen = buf.line_char_len(row)
        let name_end = name_col_ends.get(i.as(usize)).as(i64)
        let is_marked = state.marked_paths.contains(ent.full_path)
        let row_bg = if is_marked { color_mark_row_bg() } else { 0 }

        if is_marked {
            buf.add_inline_decor(
                DIRVISH_DECOR_OWNER,
                row,
                0,
                2,
                bg_rgba = row_bg,
                fg_rgba = color_mark_yellow(),
            )
        }

        if ent.git_badge != " " and ent.git_badge != "" {
            buf.add_inline_decor(
                DIRVISH_DECOR_OWNER,
                row,
                2,
                4,
                bg_rgba = row_bg,
                fg_rgba = git_badge_color(ent.git_badge),
            )
        } else if is_marked {
            buf.add_inline_decor(DIRVISH_DECOR_OWNER, row, 2, 4, bg_rgba = row_bg)
        }

        -- Icon (`4..6`) + entry name (`6..name_end`) + muted size (`name_end..llen`)
        if ent.is_dir {
            buf.add_inline_decor(
                DIRVISH_DECOR_OWNER,
                row,
                4,
                name_end,
                bg_rgba = row_bg,
                fg_rgba = color_accent_blue(),
            )
        } else if ent.is_symlink {
            buf.add_inline_decor(
                DIRVISH_DECOR_OWNER,
                row,
                4,
                name_end,
                bg_rgba = row_bg,
                fg_rgba = color_symlink_cyan(),
            )
        } else if ent.is_exec {
            buf.add_inline_decor(
                DIRVISH_DECOR_OWNER,
                row,
                4,
                name_end,
                bg_rgba = row_bg,
                fg_rgba = color_exec_green(),
            )
        } else {
            buf.add_inline_decor(
                DIRVISH_DECOR_OWNER,
                row,
                4,
                6,
                bg_rgba = row_bg,
                fg_rgba = color_file_icon(),
            )
            let name_fg = if is_marked { color_mark_yellow() } else { color_file_fg() }
            buf.add_inline_decor(
                DIRVISH_DECOR_OWNER,
                row,
                6,
                name_end,
                bg_rgba = row_bg,
                fg_rgba = name_fg,
            )
        }
        if name_end < llen {
            buf.add_inline_decor(
                DIRVISH_DECOR_OWNER,
                row,
                name_end,
                llen,
                bg_rgba = row_bg,
                fg_rgba = color_muted_gray(),
            )
        }
    }

    let max_entry_row = state.entries.len()
    let final_row = if target_row >= 1 and target_row <= max_entry_row {
        target_row
    } else if preferred_row >= 1 and preferred_row <= max_entry_row {
        preferred_row
    } else if preferred_row > max_entry_row {
        max_entry_row
    } else {
        1
    }
    let selected_ent = state.entries.get((final_row - 1).as(usize)).as(DirvishEntry)
    state.cursor_by_dir.insert(state.current_dir, selected_ent.name)

    buf.point = Pos.new(final_row, DIRVISH_NAME_COL)
    buf.modified = false
    buf.read_only = true
    buf
}

fn entry_at_cursor(state: DirvishState, center_buf: Buffer) -> ?DirvishEntry {
    if state.entries.is_empty() {
        return null
    }
    let idx = center_buf.point.row - 1
    if idx < 0 or idx >= state.entries.len() {
        return null
    }
    state.entries.get(idx.as(usize)).as(DirvishEntry)
}

fn inspect_preview_file_single_open(full_path: String) -> !IoError (String, List) {
    let raw = File.with_open(full_path, mode = .read) do |f| {
        let sample_bytes = f.read_bytes(max_bytes = 8192)!
        var has_null_byte = false
        for i in 0..sample_bytes.len() {
            if sample_bytes.get(i.as(usize)).as(i64) == 0 {
                has_null_byte = true
                break
            }
        }
        if has_null_byte {
            ("binary", List())
        } else {
            let _ = f.seek(SeekFrom.start(0))!
            var utf8_failed = false
            let chunk_opt: ?String = f.read_chars(8192) ! {
                _ => {
                    utf8_failed = true
                    null
                }
            }
            if utf8_failed {
                ("binary", List())
            } else {
                let raw_text = if chunk_opt != null { chunk_opt.as(String) } else { "" }
                let normalized = raw_text.replace("\r\n", "\n").replace("\r", "\n")
                let raw_lines = if normalized == "" {
                    [""]
                } else {
                    normalized.split("\n")
                }
                if raw_lines.len() > 1 and normalized.ends_with("\n") {
                    let _ = raw_lines.pop()
                }
                let capped = List()
                let max_lines = if raw_lines.len() > 120 { 120 } else { raw_lines.len() }
                for i in 0..max_lines {
                    capped.push(raw_lines.get(i.as(usize)).as(String))
                }
                if capped.is_empty() {
                    capped.push("")
                }
                ("text", capped)
            }
        }
    }!
    raw.as((String, List))
}

fn cache_dirvish_preview(state: DirvishState, key: String, entry: DirvishPreviewCacheEntry) {
    if not state.preview_cache.contains_key(key) {
        if state.preview_cache_order.len() >= 64 {
            let oldest = state.preview_cache_order.remove(0).as(String)
            let _ = state.preview_cache.remove(oldest)
        }
        state.preview_cache_order.push(key)
    }
    state.preview_cache.insert(key, entry)
}

fn preview_cache_key_for_entry(ent: DirvishEntry, show_hidden: bool) -> String {
    if ent.is_dir {
        return "dir:" ++ ent.full_path ++ "\n" ++ show_hidden.to_string()
    }
    ent.full_path ++ "\n" ++ ent.modified_unix_secs.to_string() ++ ":" ++ ent.size.to_string()
}

fn build_preview_cache_from_remote_snap(
    pv: RemoteSnapPreview,
    full_uri: String,
    is_symlink: bool,
    is_exec: bool,
    fallback_size: i64,
) -> DirvishPreviewCacheEntry {
    if pv.kind == "dir" {
        let disp_name = if pv.target_name != "" { pv.target_name } else { any_basename(full_uri) }
        let hdr = "   " ++ disp_name ++ "/  (" ++ pv.total_count.to_string() ++ " items)"
        let lines = List()
        lines.push(hdr)
        let dir_flags = List()
        let shown = pv.child_entries.len()
        if pv.total_count == 0 or shown == 0 {
            lines.push("    (empty directory)")
        } else {
            for i in 0..shown {
                let ch = pv.child_entries.get(i.as(usize)).as(RemoteSnapChild)
                dir_flags.push(ch.is_dir)
                if ch.is_dir {
                    let ch_icon = if ch.is_symlink { " " } else { " " }
                    lines.push("  " ++ ch_icon ++ ch.name ++ "/")
                } else {
                    let dname = if ch.name.char_len() > 26 {
                        ch.name.take(23) ++ "..."
                    } else {
                        ch.name
                    }
                    let fake_ent = DirvishEntry {
                        name: ch.name,
                        full_path: "",
                        is_dir: false,
                        is_symlink: ch.is_symlink,
                        is_exec: false,
                        size: ch.size,
                        modified_unix_secs: 0,
                        symlink_target: "",
                        git_badge: " ",
                        perms: "-rw-r--r--",
                    }
                    let cicon = entry_icon(fake_ent)
                    lines.push("  " ++ cicon ++ " " ++ pad_right(dname, 26) ++ "  " ++ format_human_size(ch.size))
                }
            }
            if pv.total_count > shown {
                lines.push("    ... (" ++ (pv.total_count - shown).to_string() ++ " more items)")
            }
        }
        return (DirvishPreviewCacheEntry {
            kind: "dir_snap",
            major_mode: "dirvish-preview",
            lines: lines,
            child_is_dir: dir_flags,
        })
    }
    if pv.kind == "binary" {
        let mode_oct = if is_symlink {
            "120777"
        } else if is_exec {
            "100755"
        } else {
            "100644"
        }
        let sz_val = if pv.total_size > 0 { pv.total_size } else { fallback_size }
        let bin_msg = "[Binary file — " ++ format_human_size(sz_val).trim() ++ ", mode " ++ mode_oct ++ "]"
        return (DirvishPreviewCacheEntry {
            kind: "binary",
            major_mode: "text",
            lines: [bin_msg],
            child_is_dir: List(),
        })
    }
    if pv.kind == "text" {
        let plines = if pv.lines.is_empty() { [""] } else { pv.lines }
        return (DirvishPreviewCacheEntry {
            kind: "text",
            major_mode: detect_major_mode(full_uri),
            lines: plines,
            child_is_dir: List(),
        })
    }
    return (DirvishPreviewCacheEntry {
        kind: "unreadable",
        major_mode: "text",
        lines: ["  [Unable to read remote entry]"],
        child_is_dir: List(),
    })
}

fn apply_cached_dir_preview_to_buf(preview_buf: Buffer, cached: DirvishPreviewCacheEntry) {
    preview_buf.major_mode = "dirvish-preview"
    preview_buf.set_lines(cached.lines, record_undo = false)
    if not cached.lines.is_empty() {
        let hdr = cached.lines.get(0).as(String)
        preview_buf.add_inline_decor(
            DIRVISH_DECOR_OWNER,
            0,
            0,
            hdr.char_len(),
            bg_rgba = color_header_bg(),
            fg_rgba = color_accent_blue(),
        )
    }
    let limit = cached.child_is_dir.len()
    for i in 0..limit {
        let row = i + 1
        if row >= preview_buf.line_count() {
            break
        }
        let is_d = cached.child_is_dir.get(i.as(usize)).as(bool)
        let llen = preview_buf.line_char_len(row)
        if is_d {
            preview_buf.add_inline_decor(
                DIRVISH_DECOR_OWNER,
                row,
                0,
                llen,
                fg_rgba = color_accent_blue(),
            )
        } else if llen >= 8 {
            preview_buf.add_inline_decor(
                DIRVISH_DECOR_OWNER,
                row,
                llen - 6,
                llen,
                fg_rgba = color_muted_gray(),
            )
        }
    }
}

fn render_preview_buffer(world: EditorWorld, state: DirvishState, center_buf: Buffer) -> Buffer {
    let preview_buf = ensure_dirvish_buffer(
        world,
        DIRVISH_PREVIEW_BUF_NAME,
        BufferKind.special,
        "dirvish-preview",
        "",
    )
    preview_buf.read_only = false
    preview_buf.clear_owner_decors(DIRVISH_DECOR_OWNER)

    if not state.miller_mode {
        preview_buf.major_mode = "dirvish-preview-hidden"
        preview_buf.file_path = ""
        preview_buf.point = Pos.zero()
        preview_buf.modified = false
        preview_buf.read_only = true
        return preview_buf
    }

    let ent_opt = entry_at_cursor(state, center_buf)
    if ent_opt == null {
        preview_buf.major_mode = "dirvish-preview"
        preview_buf.file_path = ""
        let is_loading = (state.fd_mode and state.remote_fd_loading)
            or ((not state.fd_mode) and state.remote_snap_loading)
        if is_loading {
            let l0 = "  " ++ remote_spinner_frame() ++ " Waiting for remote snapshot..."
            let l1 = "  " ++ remote_shimmer_bar(width = 20)
            preview_buf.set_lines([l0, l1], record_undo = false)
            preview_buf.add_inline_decor(
                DIRVISH_DECOR_OWNER,
                0,
                0,
                l0.char_len(),
                fg_rgba = color_accent_blue(),
            )
            preview_buf.add_inline_decor(
                DIRVISH_DECOR_OWNER,
                1,
                0,
                l1.char_len(),
                fg_rgba = color_muted_gray(),
            )
        } else {
            let msg = "  [No entry selected]"
            preview_buf.set_lines([msg], record_undo = false)
            preview_buf.add_inline_decor(
                DIRVISH_DECOR_OWNER,
                0,
                0,
                msg.char_len(),
                fg_rgba = color_muted_gray(),
            )
        }
        preview_buf.point = Pos.zero()
        preview_buf.modified = false
        preview_buf.read_only = true
        return preview_buf
    }

    let ent = ent_opt.as(DirvishEntry)
    preview_buf.file_path = ""

    if is_ssh_uri(ent.full_path) {
        let rkey = preview_cache_key_for_entry(ent, state.show_hidden)
        let rcached_opt = state.preview_cache.get(rkey)
        if rcached_opt == null {
            if remote_ui_async_enabled() {
                if state.remote_preview_key != rkey or (not state.remote_preview_loading) {
                    state.remote_preview_key = rkey
                    state.remote_preview_uri = ent.full_path
                    state.remote_preview_is_symlink = ent.is_symlink
                    state.remote_preview_is_exec = ent.is_exec
                    state.remote_preview_size = ent.size
                    state.remote_preview_loading = true
                    let _ = remote_async_submit(
                        "dirvish.preview",
                        "entry_preview",
                        [ent.full_path, ent.is_dir, state.show_hidden, 100, 8192],
                    )
                }
                preview_buf.major_mode = "dirvish-preview"
                let spin_hdr = "  " ++ remote_spinner_frame() ++ " Previewing " ++ ent.name ++ (if ent.is_dir { "/" } else { "" })
                let bar_row = "  " ++ remote_shimmer_bar(width = 22)
                preview_buf.set_lines([spin_hdr, bar_row], record_undo = false)
                preview_buf.add_inline_decor(
                    DIRVISH_DECOR_OWNER,
                    0,
                    0,
                    spin_hdr.char_len(),
                    bg_rgba = color_header_bg(),
                    fg_rgba = color_accent_blue(),
                )
                preview_buf.add_inline_decor(
                    DIRVISH_DECOR_OWNER,
                    1,
                    0,
                    bar_row.char_len(),
                    fg_rgba = color_muted_gray(),
                )
                preview_buf.point = Pos.zero()
                preview_buf.modified = false
                preview_buf.read_only = true
                return preview_buf
            }
            let built = remote_entry_preview(
                ent.full_path,
                ent.is_dir,
                show_hidden = state.show_hidden,
                max_lines = 100,
                max_bytes = 8192,
            ) match {
                pv! => build_preview_cache_from_remote_snap(
                    pv,
                    ent.full_path,
                    ent.is_symlink,
                    ent.is_exec,
                    ent.size,
                ),
                error _ => DirvishPreviewCacheEntry {
                    kind: "unreadable",
                    major_mode: "text",
                    lines: ["  [Unable to read remote entry]"],
                    child_is_dir: List(),
                },
            }
            cache_dirvish_preview(state, rkey, built)
        }
        let resolved_remote = state.preview_cache.get(rkey).as(DirvishPreviewCacheEntry)
        if resolved_remote.kind == "dir_snap" {
            apply_cached_dir_preview_to_buf(preview_buf, resolved_remote)
        } else {
            preview_buf.major_mode = resolved_remote.major_mode
            preview_buf.set_lines(resolved_remote.lines, record_undo = false)
            if resolved_remote.kind == "binary" and (not resolved_remote.lines.is_empty()) {
                let bin_hdr = resolved_remote.lines.get(0).as(String)
                preview_buf.add_inline_decor(
                    DIRVISH_DECOR_OWNER,
                    0,
                    0,
                    bin_hdr.char_len(),
                    fg_rgba = color_mark_yellow(),
                )
            }
        }
        preview_buf.point = Pos.zero()
        preview_buf.modified = false
        preview_buf.read_only = true
        return preview_buf
    }

    if ent.is_dir {
        preview_buf.major_mode = "dirvish-preview"
        let children_maybe: ?List = scan_directory_entries(
            ent.full_path,
            state.show_hidden,
            "",
            "name",
            false,
            false,
            state = state,
        ) ! { _ => null }
        let children? = children_maybe else {
            preview_buf.set_lines(["  [Directory unreadable]"], record_undo = false)
            preview_buf.point = Pos.zero()
            preview_buf.modified = false
            preview_buf.read_only = true
            return preview_buf
        }
        let total = children.len()
        let hdr = "   " ++ ent.name ++ "/  (" ++ total.to_string() ++ " items)"
        let lines = List()
        lines.push(hdr)
        let limit = if total > 80 { 80 } else { total }
        if total == 0 {
            lines.push("    (empty directory)")
        } else {
            for i in 0..limit {
                let ch = children.get(i.as(usize)).as(DirvishEntry)
                if ch.is_dir {
                    let ch_icon = if ch.is_symlink { " " } else { " " }
                    lines.push("  " ++ ch_icon ++ ch.name ++ "/")
                } else {
                    let disp_name = if ch.name.char_len() > 26 {
                        ch.name.take(23) ++ "..."
                    } else {
                        ch.name
                    }
                    let cicon = entry_icon(ch)
                    lines.push("  " ++ cicon ++ " " ++ pad_right(disp_name, 26) ++ "  " ++ format_human_size(ch.size))
                }
            }
            if total > limit {
                lines.push("    ... (" ++ (total - limit).to_string() ++ " more items)")
            }
        }
        preview_buf.set_lines(lines, record_undo = false)
        preview_buf.add_inline_decor(
            DIRVISH_DECOR_OWNER,
            0,
            0,
            hdr.char_len(),
            bg_rgba = color_header_bg(),
            fg_rgba = color_accent_blue(),
        )
        for i in 0..limit {
            let row = i + 1
            let ch = children.get(i.as(usize)).as(DirvishEntry)
            let llen = preview_buf.line_char_len(row)
            if ch.is_dir {
                preview_buf.add_inline_decor(
                    DIRVISH_DECOR_OWNER,
                    row,
                    0,
                    llen,
                    fg_rgba = color_accent_blue(),
                )
            } else if llen >= 8 {
                preview_buf.add_inline_decor(
                    DIRVISH_DECOR_OWNER,
                    row,
                    llen - 6,
                    llen,
                    fg_rgba = color_muted_gray(),
                )
            }
        }
        preview_buf.point = Pos.zero()
        preview_buf.modified = false
        preview_buf.read_only = true
        return preview_buf
    }

    -- Regular local file / symlink preview: inspect up to 8 KiB (`8192` bytes) and `120` lines
    let mode_oct = if ent.is_symlink {
        "120777"
    } else if ent.is_exec {
        "100755"
    } else {
        "100644"
    }

    let meta_opt: ?fs.FileMetadata = fs.metadata(ent.full_path) ! { _ => null }
    let (eff_mtime, eff_size) = if meta_opt != null {
        let m = meta_opt.as(fs.FileMetadata)
        (m.modified_unix_secs, m.size)
    } else {
        (ent.modified_unix_secs, ent.size)
    }
    let cache_key = ent.full_path ++ "\n" ++ eff_mtime.to_string() ++ ":" ++ eff_size.to_string()
    let cached_opt = state.preview_cache.get(cache_key)
    let resolved_preview = if cached_opt != null {
        cached_opt.as(DirvishPreviewCacheEntry)
    } else {
        let built = inspect_preview_file_single_open(ent.full_path) match {
            res! => {
                let (pkind, plines) = res
                if pkind == "binary" {
                    let bin_msg = "[Binary file — " ++ format_human_size(eff_size).trim() ++ ", mode " ++ mode_oct ++ "]"
                    DirvishPreviewCacheEntry {
                        kind: "binary",
                        major_mode: "text",
                        lines: [bin_msg],
                        child_is_dir: List(),
                    }
                } else {
                    DirvishPreviewCacheEntry {
                        kind: "text",
                        major_mode: detect_major_mode(ent.full_path),
                        lines: plines,
                        child_is_dir: List(),
                    }
                }
            },
            error _ => DirvishPreviewCacheEntry {
                kind: "unreadable",
                major_mode: "text",
                lines: ["[Unable to read file]"],
                child_is_dir: List(),
            },
        }
        cache_dirvish_preview(state, cache_key, built)
        built
    }

    preview_buf.major_mode = resolved_preview.major_mode
    preview_buf.set_lines(resolved_preview.lines, record_undo = false)
    if resolved_preview.kind == "binary" and (not resolved_preview.lines.is_empty()) {
        let bin_hdr = resolved_preview.lines.get(0).as(String)
        preview_buf.add_inline_decor(
            DIRVISH_DECOR_OWNER,
            0,
            0,
            bin_hdr.char_len(),
            fg_rgba = color_mark_yellow(),
        )
    }
    preview_buf.point = Pos.zero()
    preview_buf.modified = false
    preview_buf.read_only = true
    preview_buf
}

-- ============================================================================
-- 4. 3-Pane Miller-Columns Window Layout & Clean Collapse
-- ============================================================================

fn collect_tree_leaves(node: LayoutNode, out: List) {
    node match {
        LayoutNode.leaf(wid) => out.push(wid),
        LayoutNode.split(_, _, first, second) => {
            collect_tree_leaves(first, out)
            collect_tree_leaves(second, out)
        },
    }
}

fn tree_contains_leaf(node: LayoutNode, target: WinId) -> bool {
    node match {
        LayoutNode.leaf(wid) => wid == target,
        LayoutNode.split(_, _, first, second) => {
            tree_contains_leaf(first, target) or tree_contains_leaf(second, target)
        },
    }
}

fn leftmost_leaf(node: LayoutNode) -> WinId {
    node match {
        LayoutNode.leaf(wid) => wid,
        LayoutNode.split(_, _, first, _) => leftmost_leaf(first),
    }
}

fn prune_leaf_from_layout(node: LayoutNode, target: WinId) -> ?LayoutNode {
    node match {
        LayoutNode.leaf(wid) => {
            if wid == target {
                null
            } else {
                node
            }
        },
        LayoutNode.split(ax, ratio, first, second) => {
            if tree_contains_leaf(first, target) {
                let next_first = prune_leaf_from_layout(first, target)
                let nf? = next_first else {
                    return second
                }
                return LayoutNode.split(ax, ratio, nf, second)
            }
            if tree_contains_leaf(second, target) {
                let next_second = prune_leaf_from_layout(second, target)
                let ns? = next_second else {
                    return first
                }
                return LayoutNode.split(ax, ratio, first, ns)
            }
            node
        },
    }
}

fn replace_leaf_in_layout(node: LayoutNode, target: WinId, replacement: LayoutNode) -> LayoutNode {
    node match {
        LayoutNode.leaf(wid) => {
            if wid == target {
                replacement
            } else {
                node
            }
        },
        LayoutNode.split(ax, ratio, first, second) => {
            LayoutNode.split(
                ax,
                ratio,
                replace_leaf_in_layout(first, target, replacement),
                replace_leaf_in_layout(second, target, replacement),
            )
        },
    }
}

fn is_helper_buffer_id(world: EditorWorld, bid: BufferId) -> bool {
    let b? = world.buffer(bid) else {
        return false
    }
    b.name == DIRVISH_PARENT_BUF_NAME or b.name == DIRVISH_PREVIEW_BUF_NAME
}

pub fn collapse_dirvish_splits(world: EditorWorld, wm: WindowManager) {
    let tab = wm.active_tab()
    let leaves = List()
    collect_tree_leaves(tab.root, leaves)

    -- First ensure `active_win_id` is NOT one of the helper splits if another pane exists
    for i in 0..leaves.len() {
        let wid = leaves.get(i.as(usize)).as(WinId)
        let p_any? = wm.panes.get(wid) else {
            continue
        }
        let p = p_any.as(WindowPane)
        if not is_helper_buffer_id(world, p.buffer_id) {
            if is_helper_buffer_id(world, wm.active_pane().buffer_id) {
                tab.active_win_id = wid
            }
        }
    }

    for i in 0..leaves.len() {
        let wid = leaves.get(i.as(usize)).as(WinId)
        let p_any? = wm.panes.get(wid) else {
            continue
        }
        let p = p_any.as(WindowPane)
        if is_helper_buffer_id(world, p.buffer_id) {
            let pruned? = prune_leaf_from_layout(tab.root, wid) else {
                continue
            }
            tab.root = pruned
            let _ = wm.panes.remove(wid)
        }
    }

    if not tree_contains_leaf(tab.root, tab.active_win_id) {
        tab.active_win_id = leftmost_leaf(tab.root)
    }
    let ap = wm.active_pane()
    ap.buffer_id = world.active_buffer_id
    ap.cursor = world.active_buffer().point
    wm.sync_from_world(world)
}

fn find_win_id_for_buffer_in_tab(wm: WindowManager, target_buf_id: BufferId) -> ?WinId {
    let leaves = List()
    collect_tree_leaves(wm.active_tab().root, leaves)
    for i in 0..leaves.len() {
        let wid = leaves.get(i.as(usize)).as(WinId)
        let p_any? = wm.panes.get(wid) else {
            continue
        }
        let p = p_any.as(WindowPane)
        if p.buffer_id == target_buf_id {
            return wid
        }
    }
    null
}

fn sync_dirvish_layout(
    world: EditorWorld,
    wm: WindowManager,
    state: DirvishState,
    parent_buf: Buffer,
    center_buf: Buffer,
    preview_buf: Buffer,
) {
    -- Single-window Yazi layout: never split `WindowManager` into 3 separate editor windows.
    -- `ext_render` draws the 3 Yazi columns (parent | current | preview) inside the single `*dirvish*` pane.
    collapse_dirvish_splits(world, wm)
    world.active_buffer_id = center_buf.id
    let ap = wm.active_pane()
    ap.buffer_id = center_buf.id
    ap.cursor = center_buf.point
    if not state.miller_mode {
        parent_buf.major_mode = "dirvish-parent-hidden"
        preview_buf.major_mode = "dirvish-preview-hidden"
    } else {
        parent_buf.major_mode = "dirvish-parent"
        if preview_buf.major_mode == "dirvish-preview-hidden" {
            preview_buf.major_mode = "dirvish-preview"
        }
    }
    wm.sync_from_world(world)
}

fn ensure_vim_normal(kernel: SystemKernel, world: EditorWorld) {
    let vim_maybe: ?VimState = require_vim_state(kernel) ! { _ => null }
    let vim_res? = vim_maybe else {
        return
    }
    vim_res.mode = VimMode.normal
    vim_res.count1 = 0
    vim_res.count2 = 0
    vim_res.active_reg = ""
    vim_res.pending_prefix = ""
    vim_res.leader_strokes = List()
    vim_res.plugin_strokes = List()
    sync_world_from_vim(world, vim_res)
}

fn walk_remote_fd_entries(
    root_uri: String,
    dir_uri: String,
    rel_prefix: String,
    show_hidden: bool,
    limit: i64,
    depth: i64,
    out: List,
) {
    if depth > 12 or out.len() >= limit {
        return
    }
    let items = remote_readdir(dir_uri, show_hidden = show_hidden) ! { _ => List() }
    for i in 0..items.len() {
        if out.len() >= limit {
            return
        }
        let it = items.get(i.as(usize)).as(RemoteDirItem)
        if it.name == "." or it.name == ".." {
            continue
        }
        if (not show_hidden) and it.name.starts_with(".") {
            continue
        }
        if it.is_dir and (it.name == ".git" or it.name == "target" or it.name == "node_modules") {
            continue
        }
        let rel_name = if rel_prefix == "" { it.name } else { rel_prefix ++ "/" ++ it.name }
        let clean_full = clean_dir_path(it.full_uri, root_uri)
        out.push(DirvishEntry {
            name: rel_name,
            full_path: clean_full,
            is_dir: it.is_dir,
            is_symlink: false,
            is_exec: false,
            size: it.size,
            modified_unix_secs: 0,
            symlink_target: "",
            git_badge: " ",
            perms: if it.is_dir { "drwxr-xr-x" } else { "-rw-r--r--" },
        })
        if it.is_dir {
            walk_remote_fd_entries(root_uri, clean_full, rel_name, show_hidden, limit, depth + 1, out)
        }
    }
}

fn make_snap_cache_key(
    dir_path: String,
    show_hidden: bool,
    filter_query: String,
    sort_by: String,
    sort_reverse: bool,
) -> String {
    clean_dir_path(dir_path, "/")
        ++ "\n" ++ show_hidden.to_string()
        ++ "\n" ++ filter_query.trim()
        ++ "\n" ++ sort_by
        ++ "\n" ++ sort_reverse.to_string()
}

fn cache_remote_snap(state: DirvishState, key: String, snap: RemoteDirSnap) {
    if not state.remote_snap_cache.contains_key(key) {
        if state.remote_snap_cache_order.len() >= 48 {
            let oldest = state.remote_snap_cache_order.remove(0).as(String)
            let _ = state.remote_snap_cache.remove(oldest)
        }
        state.remote_snap_cache_order.push(key)
    }
    state.remote_snap_cache.insert(key, RemoteSnapCacheEntry {
        fetched_ms: time.unix_millis(),
        snap: snap,
    })
}

fn apply_remote_dir_snap(state: DirvishState, snap: RemoteDirSnap) {
    let entries = List()
    for i in 0..snap.entries.len() {
        let se = snap.entries.get(i.as(usize)).as(RemoteSnapEntry)
        entries.push(DirvishEntry {
            name: se.name,
            full_path: clean_dir_path(se.full_uri, state.current_dir),
            is_dir: se.is_dir,
            is_symlink: se.is_symlink,
            is_exec: se.is_exec,
            size: se.size,
            modified_unix_secs: se.modified_secs,
            symlink_target: se.symlink_target,
            git_badge: if se.git_badge != "" { se.git_badge } else { " " },
            perms: se.perms,
        })
    }
    let parents = List()
    for i in 0..snap.parent_entries.len() {
        let sp = snap.parent_entries.get(i.as(usize)).as(RemoteSnapParent)
        parents.push(DirvishEntry {
            name: sp.name,
            full_path: clean_dir_path(sp.full_uri, "/"),
            is_dir: sp.is_dir,
            is_symlink: false,
            is_exec: false,
            size: 0,
            modified_unix_secs: 0,
            symlink_target: "",
            git_badge: " ",
            perms: if sp.is_dir { "drwxr-xr-x" } else { "-rw-r--r--" },
        })
    }
    state.entries = entries
    state.parent_entries = parents
    state.remote_git_branch = if snap.git_is_repo { snap.git_branch } else { "" }
    state.remote_snap_loaded_dir = state.current_dir

    if snap.preview.target_uri != "" and snap.preview.kind != "none" {
        let t_clean = clean_dir_path(snap.preview.target_uri, state.current_dir)
        var found_ent: ?DirvishEntry = null
        for i in 0..entries.len() {
            let e = entries.get(i.as(usize)).as(DirvishEntry)
            if e.full_path == t_clean {
                found_ent = e
                break
            }
        }
        if found_ent != null {
            let fe = found_ent.as(DirvishEntry)
            let pkey = preview_cache_key_for_entry(fe, state.show_hidden)
            let built = build_preview_cache_from_remote_snap(
                snap.preview,
                fe.full_path,
                fe.is_symlink,
                fe.is_exec,
                fe.size,
            )
            cache_dirvish_preview(state, pkey, built)
        }
    }
}

fn apply_remote_fd_ranked(state: DirvishState, clean_root: String, rf: RemoteRankedFiles) {
    let out = List()
    for i in 0..rf.items.len() {
        let it = rf.items.get(i.as(usize)).as(RemoteRankedFile)
        let full_u = clean_dir_path(it.full_uri, clean_root)
        let rel = if it.rel_path != "" { it.rel_path } else { any_basename(full_u) }
        out.push(DirvishEntry {
            name: rel,
            full_path: full_u,
            is_dir: it.is_dir,
            is_symlink: false,
            is_exec: false,
            size: 0,
            modified_unix_secs: 0,
            symlink_target: "",
            git_badge: " ",
            perms: if it.is_dir { "drwxr-xr-x" } else { "-rw-r--r--" },
        })
    }
    if state.fd_pattern.trim() == "" {
        sort_dirvish_entries(out, state.sort_by, state.sort_reverse)
    }
    state.remote_fd_total_indexed = rf.total_indexed
    state.remote_fd_total_matched = rf.total_matched
    state.entries = out
}

fn scan_fd_all_entries(root_dir: String, show_hidden: bool) -> !String List {
    let clean_root = clean_dir_path(root_dir, "/")
    if is_ssh_uri(clean_root) {
        -- Remote `dirvish-fd` runs directly on `lava-server` in `refresh_dirvish_all`.
        return List()
    }

    let rel_files = accel_workspace_files(clean_root, max_files = 0, include_hidden = show_hidden)
    let probe_meta = rel_files.len() <= 800
    let seen_dirs = Set.new()
    let out = List()
    let top_entries = fs.read_dir_entries(clean_root) ! { _ => List() }
    for ti in 0..top_entries.len() {
        let tde = top_entries.get(ti.as(usize)).as(DirEntry)
        if tde.name == "." or tde.name == ".." or tde.name == ".git" or tde.name == "target" or tde.name == "node_modules" {
            continue
        }
        if (not show_hidden) and tde.name.starts_with(".") {
            continue
        }
        if tde.is_dir() and not seen_dirs.contains(tde.name) {
            seen_dirs.insert(tde.name)
            out.push(DirvishEntry {
                name: tde.name,
                full_path: path.join(clean_root, tde.name),
                is_dir: true,
                is_symlink: tde.is_symlink(),
                is_exec: false,
                size: 0,
                modified_unix_secs: tde.modified_unix_secs,
                symlink_target: "",
                git_badge: " ",
                perms: "drwxr-xr-x",
            })
        }
    }
    for i in 0..rel_files.len() {
        let rel = rel_files.get(i.as(usize)).as(String)
        if rel == "" {
            continue
        }
        let segs = rel.split("/")
        if segs.len() > 1 {
            var acc = ""
            for si in 0..(segs.len() - 1) {
                let seg = segs.get(si.as(usize)).as(String)
                acc = if acc == "" { seg } else { acc ++ "/" ++ seg }
                if not seen_dirs.contains(acc) {
                    seen_dirs.insert(acc)
                    out.push(DirvishEntry {
                        name: acc,
                        full_path: path.join(clean_root, acc),
                        is_dir: true,
                        is_symlink: false,
                        is_exec: false,
                        size: 0,
                        modified_unix_secs: 0,
                        symlink_target: "",
                        git_badge: " ",
                        perms: "drwxr-xr-x",
                    })
                }
            }
        }
        let full_p = path.join(clean_root, rel)
        let (sz, mt) = if probe_meta {
            let meta_opt: ?fs.FileMetadata = fs.metadata(full_p) ! { _ => null }
            if meta_opt != null {
                let m = meta_opt.as(fs.FileMetadata)
                (m.size, m.modified_unix_secs)
            } else {
                (0, 0)
            }
        } else {
            (0, 0)
        }
        out.push(DirvishEntry {
            name: rel,
            full_path: full_p,
            is_dir: false,
            is_symlink: false,
            is_exec: false,
            size: sz,
            modified_unix_secs: mt,
            symlink_target: "",
            git_badge: " ",
            perms: "-rw-r--r--",
        })
    }
    out
}

fn filter_fd_entries(all_entries: List, pattern: String, sort_by: String, sort_reverse: bool) -> List {
    let q = pattern.trim()
    if q == "" {
        let copied = List()
        let cap = if all_entries.len() > 500 { 500 } else { all_entries.len() }
        for i in 0..cap {
            copied.push(all_entries.get(i.as(usize)))
        }
        sort_dirvish_entries(copied, sort_by, sort_reverse)
        return copied
    }
    let names = List()
    for i in 0..all_entries.len() {
        let ent = all_entries.get(i.as(usize)).as(DirvishEntry)
        names.push(if ent.is_dir { ent.name ++ "/" } else { ent.name })
    }
    let (_, ranked) = accel_orderless_rank(q, names, limit = 500)
    let out = List()
    for i in 0..ranked.len() {
        let hit = ranked.get(i.as(usize)).as(OrderlessHit)
        if hit.index >= 0 and hit.index < all_entries.len() {
            out.push(all_entries.get(hit.index.as(usize)))
        }
    }
    out
}

fn refresh_dirvish_all(
    kernel: SystemKernel,
    world: EditorWorld,
    wm: WindowManager,
    state: DirvishState,
    .focus_name: String = "",
    .preferred_row: i64 = 0,
) -> #[log_event, status_emit] !String Unit {
    if state.fd_mode {
        if is_ssh_uri(state.fd_root) {
            state.remote_snap_loading = false
            remote_async_cancel("dirvish.snapshot")
            if remote_ui_async_enabled() {
                state.remote_fd_loading = true
                let _ = remote_async_submit(
                    "dirvish.fd",
                    "search_files",
                    [state.fd_root, state.fd_pattern, state.show_hidden, true, 300],
                )
            } else {
                state.remote_fd_loading = false
                let rf = remote_search_files_ranked(
                    state.fd_root,
                    state.fd_pattern,
                    include_hidden = state.show_hidden,
                    include_dirs = true,
                    limit = 300,
                )!
                apply_remote_fd_ranked(state, state.fd_root, rf)
            }
        } else {
            state.entries = filter_fd_entries(
                state.fd_all_entries,
                state.fd_pattern,
                state.sort_by,
                state.sort_reverse,
            )
        }
    } else if is_ssh_uri(state.current_dir) {
        state.remote_fd_loading = false
        remote_async_cancel("dirvish.fd")
        let skey = make_snap_cache_key(
            state.current_dir,
            state.show_hidden,
            state.filter_query,
            state.sort_by,
            state.sort_reverse,
        )
        let now_ms = time.unix_millis()
        let sc_opt = state.remote_snap_cache.get(skey)
        var used_fresh_cache = false
        if sc_opt != null {
            let sce = sc_opt.as(RemoteSnapCacheEntry)
            if now_ms - sce.fetched_ms <= REMOTE_SNAP_CACHE_TTL_MS {
                state.remote_snap_loading = false
                apply_remote_dir_snap(state, sce.snap)
                used_fresh_cache = true
            }
        }
        if not used_fresh_cache {
            let remembered_opt = state.cursor_by_dir.get(state.current_dir)
            let eff_focus = if focus_name != "" {
                focus_name
            } else if remembered_opt != null and preferred_row < 1 {
                remembered_opt.as(String)
            } else {
                ""
            }
            if remote_ui_async_enabled() {
                if state.remote_snap_loaded_dir != state.current_dir {
                    state.entries = List()
                    state.parent_entries = List()
                }
                state.remote_snap_loading = true
                state.remote_snap_key = skey
                state.remote_snap_focus = focus_name
                state.remote_snap_pref_row = preferred_row
                let _ = remote_async_submit(
                    "dirvish.snapshot",
                    "dir_snapshot",
                    [
                        state.current_dir,
                        state.show_hidden,
                        state.filter_query,
                        state.sort_by,
                        state.sort_reverse,
                        eff_focus,
                        preferred_row,
                        state.miller_mode,
                        state.miller_mode,
                    ],
                )
            } else {
                state.remote_snap_loading = false
                let snap = remote_dir_snapshot(
                    state.current_dir,
                    show_hidden = state.show_hidden,
                    filter_query = state.filter_query,
                    sort_by = state.sort_by,
                    sort_reverse = state.sort_reverse,
                    focus_name = eff_focus,
                    preferred_row = preferred_row,
                    include_parent = state.miller_mode,
                    include_preview = state.miller_mode,
                )!
                cache_remote_snap(state, skey, snap)
                apply_remote_dir_snap(state, snap)
            }
        }
    } else {
        let entries = scan_directory_entries(
            state.current_dir,
            state.show_hidden,
            state.filter_query,
            state.sort_by,
            state.sort_reverse,
            true,
            state = state,
        )!
        state.entries = entries
    }

    let parent_buf = render_parent_buffer(world, state)
    let center_buf = render_center_buffer(world, state, focus_name, preferred_row)
    let preview_buf = render_preview_buffer(world, state, center_buf)
    sync_dirvish_layout(world, wm, state, parent_buf, center_buf, preview_buf)
    ensure_vim_normal(kernel, world)
    ()
}

fn refresh_preview_for_cursor(world: EditorWorld, wm: WindowManager, state: DirvishState, center_buf: Buffer) {
    let ent_opt = entry_at_cursor(state, center_buf)
    if ent_opt != null {
        state.cursor_by_dir.insert(state.current_dir, ent_opt.as(DirvishEntry).name)
    }
    if state.miller_mode {
        let preview_buf = render_preview_buffer(world, state, center_buf)
        let pvid_opt = find_win_id_for_buffer_in_tab(wm, preview_buf.id)
        if pvid_opt != null {
            let pvp = wm.panes.get(pvid_opt.as(WinId)).as(WindowPane)
            pvp.cursor = Pos.zero()
            pvp.top_row = 0
            pvp.left_col = 0
        }
    }
    wm.sync_from_world(world)
}

fn open_dirvish_at(
    kernel: SystemKernel,
    raw_dir: String,
    focus_name: String,
    record_hist: bool,
) -> #[log_event, status_emit] !String Unit {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!

    let cur_buf = world.active_buffer()
    if (
        cur_buf.name != DIRVISH_BUF_NAME
        and cur_buf.name != DIRVISH_PARENT_BUF_NAME
        and cur_buf.name != DIRVISH_PREVIEW_BUF_NAME
    ) {
        state.origin_buf_id = cur_buf.id
    }

    let effective_raw = if raw_dir.trim() == "" and world.cwd == "/" {
        let h = home_directory()
        if h != "" and fs.is_dir(h) { h } else { world.cwd }
    } else {
        raw_dir
    }
    let target_dir = clean_dir_path(effective_raw, world.cwd)
    if (not is_ssh_uri(target_dir)) and (not any_is_dir(target_dir)) {
        return error ("Dirvish target is not a directory: " ++ target_dir)
    }

    state.fd_mode = false
    state.current_dir = target_dir
    if record_hist {
        state.record_history(target_dir)
    }

    refresh_dirvish_all(kernel, world, wm, state, focus_name = focus_name)#!
    status_emit("Dirvish: " ++ abbreviate_path(target_dir) ++ " (" ++ state.entries.len().to_string() ++ " items)")#
    ()
}

-- ============================================================================
-- 5. Recursive File Operations (Copy, Move, Delete, Disambiguate, Buffer Sync)
-- ============================================================================

fn disambiguate_dest_path(dest_dir: String, orig_name: String) -> String {
    let direct = any_join_path(dest_dir, orig_name)
    if not any_exists(direct) {
        return direct
    }
    let (stem, ext) = split_stem_and_ext(orig_name)
    let first_copy = any_join_path(dest_dir, stem ++ "_copy" ++ ext)
    if not any_exists(first_copy) {
        return first_copy
    }
    var n: i64 = 2
    while true {
        let candidate = any_join_path(dest_dir, stem ++ "_copy" ++ n.to_string() ++ ext)
        if not any_exists(candidate) {
            return candidate
        }
        n += 1
    }
    first_copy
}

fn remove_path_any(target: String) -> !String Unit {
    if is_ssh_uri(target) {
        if not any_exists(target) {
            return ()
        }
        remote_remove(target, recursive = any_is_dir(target))!
        return ()
    }
    if not fs.exists(target) {
        return ()
    }
    let meta_opt: ?fs.FileMetadata = fs.metadata(target) ! { _ => null }
    if meta_opt != null and meta_opt.as(fs.FileMetadata).is_symlink() {
        (fs.remove_file(target) ! {
            err => error ("Failed removing symlink '" ++ target ++ "': " ++ err.to_string())
        })!
        return ()
    }
    if fs.is_dir(target) {
        (fs.remove_dir(target, recursive = true) ! {
            err => error ("Failed removing directory '" ++ target ++ "': " ++ err.to_string())
        })!
    } else {
        (fs.remove_file(target) ! {
            err => error ("Failed removing file '" ++ target ++ "': " ++ err.to_string())
        })!
    }
    ()
}

fn copy_recursive(src: String, dst: String) -> !String Unit {
    if is_ssh_uri(src) and is_ssh_uri(dst) {
        remote_copy(src, dst)!
        return ()
    }
    if is_ssh_uri(src) and (not is_ssh_uri(dst)) {
        let (lines, eol) = remote_read_lines(src)!
        let sep = if eol == "CRLF" { "\r\n" } else { "\n" }
        let p_opt = path.parent(dst)
        if p_opt != null and p_opt.as(String) != "" {
            let _ = fs.create_dir(p_opt.as(String), parents = true) ! { _ => () }
        }
        let _ = (fs.write_string(dst, lines.join(sep)) ! {
            err => error ("Cannot copy remote '" ++ src ++ "' -> '" ++ dst ++ "': " ++ err.to_string())
        })!
        return ()
    }
    if (not is_ssh_uri(src)) and is_ssh_uri(dst) {
        let text = (fs.read_to_string(src) ! {
            err => error ("Cannot read '" ++ src ++ "': " ++ err.to_string())
        })!
        let lines = text.replace("\r\n", "\n").split("\n")
        let _ = remote_write_lines(dst, lines, false)!
        return ()
    }
    if fs.is_dir(src) {
        let clean_src = clean_dir_path(src, "/")
        let clean_dst = clean_dir_path(dst, "/")
        if clean_dst == clean_src or clean_dst.starts_with(clean_src ++ "/") {
            return error ("Cannot copy directory into itself: " ++ src)
        }
        (fs.create_dir(dst, parents = true) ! {
            err => error ("Cannot create directory '" ++ dst ++ "': " ++ err.to_string())
        })!
        let children = (fs.read_dir_entries(src) ! {
            err => error ("Cannot read directory '" ++ src ++ "': " ++ err.to_string())
        })!
        for i in 0..children.len() {
            let ch = children.get(i.as(usize)).as(DirEntry)
            if ch.name == "." or ch.name == ".." {
                continue
            }
            let ch_src = path.join(src, ch.name)
            let ch_dst = path.join(dst, ch.name)
            copy_recursive(ch_src, ch_dst)!
        }
        return ()
    }
    let p_opt = path.parent(dst)
    if p_opt != null and p_opt.as(String) != "" {
        let _ = fs.create_dir(p_opt.as(String), parents = true) ! { _ => () }
    }
    let _ = (fs.copy(src, dst) ! {
        err => error ("Cannot copy '" ++ src ++ "' -> '" ++ dst ++ "': " ++ err.to_string())
    })!
    ()
}

fn move_entry(src: String, dst: String) -> !String Unit {
    if clean_dir_path(src, "/") == clean_dir_path(dst, "/") {
        return ()
    }
    if is_ssh_uri(src) and is_ssh_uri(dst) {
        remote_rename(src, dst)!
        return ()
    }
    if (not is_ssh_uri(src)) and (not is_ssh_uri(dst)) {
        let renamed_ok = fs.rename(src, dst) match {
            _! => true,
            error _ => false,
        }
        if renamed_ok {
            return ()
        }
    }
    copy_recursive(src, dst)!
    remove_path_any(src)!
    ()
}

fn sync_renamed_buffers(world: EditorWorld, old_path: String, new_path: String) {
    let old_clean = clean_dir_path(old_path, world.cwd)
    let new_clean = clean_dir_path(new_path, world.cwd)
    let n = world.buffer_order.len()
    for i in 0..n {
        let bid = world.buffer_order.get(i.as(usize)).as(BufferId)
        let b = world.buffers.get(bid).as(Buffer)
        if b.kind != BufferKind.file {
            continue
        }
        if b.file_path == old_clean {
            b.file_path = new_clean
            let bname = any_basename(new_clean)
            if bname != "" {
                b.name = bname
            }
            b.major_mode = detect_major_mode(new_clean)
        } else if b.file_path.starts_with(old_clean ++ "/") {
            let rel = b.file_path.slice(old_clean.char_len(), b.file_path.char_len())
            b.file_path = new_clean ++ rel
        }
    }
}

fn purge_deleted_buffers(world: EditorWorld, deleted_path: String) {
    let del_clean = clean_dir_path(deleted_path, world.cwd)
    let to_kill = List()
    for i in 0..world.buffer_order.len() {
        let bid = world.buffer_order.get(i.as(usize)).as(BufferId)
        let b = world.buffers.get(bid).as(Buffer)
        if (
            b.kind == BufferKind.file
            and (b.file_path == del_clean or b.file_path.starts_with(del_clean ++ "/"))
        ) {
            to_kill.push(bid)
        }
    }
    for i in 0..to_kill.len() {
        let bid = to_kill.get(i.as(usize)).as(BufferId)
        let _ = world.kill_buffer(bid, force = true) ! { _ => BufferId(0) }
    }
}

fn target_paths_for_action(state: DirvishState, center_buf: Buffer) -> List {
    let out = List()
    -- Collect marked entries in visible order first, then any marked paths in other dirs if needed
    for i in 0..state.entries.len() {
        let ent = state.entries.get(i.as(usize)).as(DirvishEntry)
        if state.marked_paths.contains(ent.full_path) {
            out.push(ent.full_path)
        }
    }
    if not out.is_empty() {
        return out
    }
    let cur_opt = entry_at_cursor(state, center_buf)
    if cur_opt != null {
        out.push(cur_opt.as(DirvishEntry).full_path)
    }
    out
}

-- ============================================================================
-- 6. Entry & Navigation Commands
-- ============================================================================

fn buffer_represents_dir(buf: Buffer) -> bool {
    if buf.kind == BufferKind.directory {
        return true
    }
    if buf.kind == BufferKind.file {
        return false
    }
    if is_ssh_uri(buf.file_path) {
        return buf.file_path.ends_with("/")
    }
    any_is_dir(buf.file_path)
}

fn cmd_dirvish(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_dirvish_state(kernel)!
    let cur_buf = world.active_buffer()
    var target_dir = if world.cwd != "/" and world.cwd != "" {
        world.cwd
    } else {
        let h = home_directory()
        if h != "" and fs.is_dir(h) { h } else { world.cwd }
    }
    if not args.is_empty() {
        let raw_arg = args.get(0).as(String).trim()
        if raw_arg != "" {
            target_dir = world.resolve_path(raw_arg)
        }
    } else if cur_buf.name == DIRVISH_BUF_NAME and cur_buf.file_path != "" {
        target_dir = cur_buf.file_path
    } else if is_ssh_uri(world.cwd) and (not is_ssh_uri(cur_buf.file_path)) {
        target_dir = world.cwd
    } else if cur_buf.file_path != "" {
        if buffer_represents_dir(cur_buf) {
            target_dir = cur_buf.file_path
        } else {
            target_dir = any_parent_dir(cur_buf.file_path)
        }
    } else if state.current_dir != "" and (not is_dir_root_path(state.current_dir)) {
        if is_ssh_uri(state.current_dir) or any_is_dir(state.current_dir) {
            target_dir = state.current_dir
        }
    }
    open_dirvish_at(kernel, target_dir, "", true)#!
}

fn cmd_dirvish_jump(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_dirvish_state(kernel)!
    let cur_buf = world.active_buffer()

    if cur_buf.name == DIRVISH_BUF_NAME {
        return cmd_dirvish_up_dir(kernel, List())#!
    }

    var target_dir = world.cwd
    var focus_name = ""
    if cur_buf.file_path != "" {
        if buffer_represents_dir(cur_buf) {
            let clean_cur = clean_dir_path(cur_buf.file_path, world.cwd)
            if not is_dir_root_path(clean_cur) {
                target_dir = any_parent_dir(clean_cur)
                focus_name = any_basename(clean_cur)
            } else {
                target_dir = clean_cur
            }
        } else {
            target_dir = any_parent_dir(cur_buf.file_path)
            focus_name = any_basename(cur_buf.file_path)
        }
    }
    if focus_name.starts_with(".") {
        state.show_hidden = true
    }
    open_dirvish_at(kernel, target_dir, focus_name, true)#!
}

fn cmd_dirvish_fd(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!
    let cur_buf = world.active_buffer()

    if (
        cur_buf.name != DIRVISH_BUF_NAME
        and cur_buf.name != DIRVISH_PARENT_BUF_NAME
        and cur_buf.name != DIRVISH_PREVIEW_BUF_NAME
    ) {
        state.origin_buf_id = cur_buf.id
    }

    var base_dir = if cur_buf.name == DIRVISH_BUF_NAME and state.current_dir != "" {
        if state.fd_mode and state.fd_root != "" { state.fd_root } else { state.current_dir }
    } else if is_ssh_uri(world.cwd) and (not is_ssh_uri(cur_buf.file_path)) {
        world.cwd
    } else if cur_buf.file_path != "" {
        if buffer_represents_dir(cur_buf) {
            cur_buf.file_path
        } else {
            any_parent_dir(cur_buf.file_path)
        }
    } else if world.cwd != "" {
        world.cwd
    } else {
        home_directory()
    }
    base_dir = clean_dir_path(base_dir, world.cwd)

    var pattern = ""
    var should_prompt = true
    if args.len() >= 2 {
        let raw_d = args.get(0).as(String).trim()
        if raw_d != "" {
            base_dir = clean_dir_path(world.resolve_path(raw_d), world.cwd)
        }
        let rest = List()
        for ai in 1..args.len() {
            rest.push(args.get(ai.as(usize)).as(String))
        }
        pattern = rest.join(" ").trim()
        should_prompt = false
    } else if args.len() == 1 {
        let a0 = args.get(0).as(String).trim()
        if a0 != "" {
            let resolved_a0 = clean_dir_path(world.resolve_path(a0), world.cwd)
            let looks_like_dir_arg = is_ssh_uri(a0)
                or a0.starts_with("/")
                or a0.starts_with("./")
                or a0.starts_with("../")
                or a0 == "~"
            if looks_like_dir_arg and (is_ssh_uri(resolved_a0) or any_is_dir(resolved_a0)) {
                base_dir = resolved_a0
                should_prompt = true
            } else {
                pattern = a0
                should_prompt = false
            }
        }
    }

    if (not is_ssh_uri(base_dir)) and (not any_is_dir(base_dir)) {
        return error ("dirvish-fd root is not a directory: " ++ base_dir)
    }

    if should_prompt {
        let default_pat = if state.fd_mode and state.fd_root == base_dir { state.fd_pattern } else { "" }
        let ans_opt = ask_prompt(PromptRequest.text(
            "Dirvish fd (" ++ abbreviate_path(base_dir) ++ "): ",
            default_pat,
        ))#
        let ans? = ans_opt else {
            return ()
        }
        pattern = ans.trim()
    }

    let all_entries = scan_fd_all_entries(base_dir, state.show_hidden)!
    state.fd_mode = true
    state.fd_root = base_dir
    state.fd_pattern = pattern
    state.fd_all_entries = all_entries
    state.current_dir = base_dir
    if is_ssh_uri(base_dir) and remote_ui_async_enabled() {
        state.entries = List()
    }

    refresh_dirvish_all(kernel, world, wm, state)#!
    let pat_lbl = if pattern != "" { "'" ++ pattern ++ "'" } else { "*" }
    if state.remote_fd_loading {
        status_emit("Dirvish fd: searching lava-server " ++ abbreviate_path(base_dir) ++ " [" ++ pat_lbl ++ "]...")#
    } else {
        status_emit(
            "Dirvish fd: " ++ abbreviate_path(base_dir) ++ " [" ++ pat_lbl ++ "] ("
            ++ state.entries.len().to_string() ++ " match(es))",
        )#
    }
    ()
}

fn cmd_dirvish_fd_jump(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_dirvish_state(kernel)!
    let ent? = entry_at_cursor(state, world.active_buffer()) else {
        status_emit("No entry under cursor")#
        return ()
    }
    let par_dir = any_parent_dir(ent.full_path)
    let leaf_name = any_basename(ent.full_path)
    open_dirvish_at(kernel, par_dir, leaf_name, true)#!
}

fn move_dirvish_cursor(kernel: SystemKernel, delta: i64, absolute_row: i64) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!
    let buf = world.active_buffer()
    if buf.name != DIRVISH_BUF_NAME {
        return ()
    }
    if state.entries.is_empty() {
        buf.point = Pos.new(1, 4)
        wm.sync_from_world(world)
        return ()
    }
    let max_row = state.entries.len()
    var next_row = if absolute_row >= 1 {
        absolute_row
    } else {
        buf.point.row + delta
    }
    if next_row < 1 {
        next_row = 1
    } else if next_row > max_row {
        next_row = max_row
    }
    buf.point = Pos.new(next_row, DIRVISH_NAME_COL)
    refresh_preview_for_cursor(world, wm, state, buf)
    ()
}

fn cmd_dirvish_next_line(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    move_dirvish_cursor(kernel, 1, 0)#!
}

fn cmd_dirvish_prev_line(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    move_dirvish_cursor(kernel, -1, 0)#!
}

fn cmd_dirvish_goto_top(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    move_dirvish_cursor(kernel, 0, 1)#!
}

fn cmd_dirvish_goto_bottom(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let state = require_dirvish_state(kernel)!
    let bottom = if state.entries.is_empty() { 1 } else { state.entries.len() }
    move_dirvish_cursor(kernel, 0, bottom)#!
}

fn cmd_dirvish_up_dir(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let state = require_dirvish_state(kernel)!
    if state.fd_mode and state.fd_root != "" {
        let root_back = state.fd_root
        state.fd_mode = false
        open_dirvish_at(kernel, root_back, "", false)#!
        return ()
    }
    if is_dir_root_path(state.current_dir) {
        status_emit("Already at filesystem root '" ++ state.current_dir ++ "'")#
        return ()
    }
    let child_name = any_basename(state.current_dir)
    let parent_dir = any_parent_dir(state.current_dir)
    if child_name.starts_with(".") {
        state.show_hidden = true
    }
    open_dirvish_at(kernel, parent_dir, child_name, true)#!
}

fn cmd_dirvish_enter(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!
    let center_buf = world.active_buffer()
    let ent? = entry_at_cursor(state, center_buf) else {
        status_emit("No entry under cursor")#
        return ()
    }
    if ent.is_dir {
        open_dirvish_at(kernel, ent.full_path, "", true)#!
        return ()
    }

    -- File under cursor: collapse helper splits cleanly and open file in active pane!
    collapse_dirvish_splits(world, wm)
    let opened = world.open_file(ent.full_path)#!
    state.origin_buf_id = opened.id
    let ap = wm.active_pane()
    ap.buffer_id = opened.id
    ap.cursor = opened.point
    wm.sync_from_world(world)
    ensure_vim_normal(kernel, world)
    kernel.emit_hook("buffer-switched", opened.id)
    ()
}

fn cmd_dirvish_history_back(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let state = require_dirvish_state(kernel)!
    if state.history_idx <= 0 or state.history.is_empty() {
        status_emit("Dirvish: oldest directory in history")#
        return ()
    }
    state.history_idx -= 1
    let target = state.history.get(state.history_idx.as(usize)).as(String)
    open_dirvish_at(kernel, target, "", false)#!
}

fn cmd_dirvish_history_forward(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let state = require_dirvish_state(kernel)!
    if state.history_idx + 1 >= state.history.len() {
        status_emit("Dirvish: newest directory in history")#
        return ()
    }
    state.history_idx += 1
    let target = state.history.get(state.history_idx.as(usize)).as(String)
    open_dirvish_at(kernel, target, "", false)#!
}

fn cmd_dirvish_go_home(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    open_dirvish_at(kernel, home_directory(), "", true)#!
}

fn cmd_dirvish_go_root(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    open_dirvish_at(kernel, "/", "", true)#!
}

fn cmd_dirvish_go_project(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    open_dirvish_at(kernel, world.cwd, "", true)#!
}

fn cmd_dirvish_new_tab(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!
    let dir_target = if state.current_dir != "" { state.current_dir } else { world.cwd }
    wm.tab_new(world.active_buffer_id)
    open_dirvish_at(kernel, dir_target, "", false)#!
    status_emit("Dirvish opened in new tab: " ++ abbreviate_path(dir_target))#
    ()
}

-- ============================================================================
-- 7. Marking, Yank / Cut / Paste / Overwrite / Delete Ring Commands
-- ============================================================================

fn cmd_dirvish_toggle_mark(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!
    let center_buf = world.active_buffer()
    let ent? = entry_at_cursor(state, center_buf) else {
        return ()
    }
    if state.marked_paths.contains(ent.full_path) {
        let _ = state.marked_paths.remove(ent.full_path)
    } else {
        let _ = state.marked_paths.insert(ent.full_path)
    }
    let cur_row = center_buf.point.row
    let next_row = if cur_row + 1 <= state.entries.len() { cur_row + 1 } else { cur_row }
    let parent_buf = render_parent_buffer(world, state)
    let updated_center = render_center_buffer(world, state, "", next_row)
    let preview_buf = render_preview_buffer(world, state, updated_center)
    sync_dirvish_layout(world, wm, state, parent_buf, updated_center, preview_buf)
    status_emit("Marked: " ++ state.marked_paths.len().to_string() ++ " item(s)")#
    ()
}

fn cmd_dirvish_invert_marks(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!
    let cur_row = world.active_buffer().point.row
    for i in 0..state.entries.len() {
        let ent = state.entries.get(i.as(usize)).as(DirvishEntry)
        if state.marked_paths.contains(ent.full_path) {
            let _ = state.marked_paths.remove(ent.full_path)
        } else {
            let _ = state.marked_paths.insert(ent.full_path)
        }
    }
    refresh_dirvish_all(kernel, world, wm, state, preferred_row = cur_row)#!
    status_emit("Inverted marks (" ++ state.marked_paths.len().to_string() ++ " marked)")#
    ()
}

fn cmd_dirvish_unmark_all(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!
    let cur_row = world.active_buffer().point.row
    state.marked_paths.clear()
    refresh_dirvish_all(kernel, world, wm, state, preferred_row = cur_row)#!
    status_emit("Cleared all marks")#
    ()
}

fn populate_ring(
    kernel: SystemKernel,
    mode: String,
    append: bool,
) -> #[log_event, status_emit] !String Unit {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!
    let center_buf = world.active_buffer()
    let cur_row = center_buf.point.row
    let targets = target_paths_for_action(state, center_buf)
    if targets.is_empty() {
        status_emit("Dirvish: no entries to " ++ mode)#
        return ()
    }
    if (not append) or state.yank_mode != mode {
        state.yank_ring = List()
    }
    state.yank_mode = mode
    for i in 0..targets.len() {
        let p = targets.get(i.as(usize)).as(String)
        var exists_in_ring = false
        for j in 0..state.yank_ring.len() {
            if state.yank_ring.get(j.as(usize)).as(String) == p {
                exists_in_ring = true
                break
            }
        }
        if not exists_in_ring {
            state.yank_ring.push(p)
        }
    }
    state.marked_paths.clear()
    refresh_dirvish_all(kernel, world, wm, state, preferred_row = cur_row)#!
    let verb = if mode == "cut" { "Cut" } else { "Yanked" }
    status_emit(verb ++ " " ++ state.yank_ring.len().to_string() ++ " item(s) into file ring")#
    ()
}

fn cmd_dirvish_yank(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    populate_ring(kernel, "copy", false)#!
}

fn cmd_dirvish_yank_append(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    populate_ring(kernel, "copy", true)#!
}

fn cmd_dirvish_cut(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    populate_ring(kernel, "cut", false)#!
}

fn cmd_dirvish_cut_append(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    populate_ring(kernel, "cut", true)#!
}

fn cmd_dirvish_clear_ring(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!
    let cur_row = world.active_buffer().point.row
    state.yank_ring = List()
    state.yank_mode = ""
    refresh_dirvish_all(kernel, world, wm, state, preferred_row = cur_row)#!
    status_emit("Cleared Dirvish yank/cut ring")#
    ()
}

fn execute_paste(kernel: SystemKernel, overwrite: bool) -> #[log_event, status_emit] !String Unit {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!
    if state.yank_ring.is_empty() or state.yank_mode == "" {
        status_emit("Dirvish yank/cut ring is empty")#
        return ()
    }

    let is_cut = state.yank_mode == "cut"
    var processed: i64 = 0
    var last_created_name = ""

    for i in 0..state.yank_ring.len() {
        let src = state.yank_ring.get(i.as(usize)).as(String)
        if not any_exists(src) {
            continue
        }
        let orig_name = any_basename(src)
        if orig_name == "" {
            continue
        }
        let direct_dst = any_join_path(state.current_dir, orig_name)

        if is_cut and clean_dir_path(src, "/") == clean_dir_path(direct_dst, "/") {
            last_created_name = orig_name
            processed += 1
            continue
        }

        var dst = direct_dst
        if overwrite {
            if any_exists(dst) and clean_dir_path(src, "/") != clean_dir_path(dst, "/") {
                remove_path_any(dst)!
            }
        } else if any_exists(dst) {
            dst = disambiguate_dest_path(state.current_dir, orig_name)
        }

        if is_cut {
            move_entry(src, dst)!
            sync_renamed_buffers(world, src, dst)
        } else {
            copy_recursive(src, dst)!
        }

        let dst_name = any_basename(dst)
        if dst_name != "" {
            last_created_name = dst_name
        }
        processed += 1
    }

    if is_cut {
        state.yank_ring = List()
        state.yank_mode = ""
    }
    state.invalidate_remote_caches()

    refresh_dirvish_all(kernel, world, wm, state, focus_name = last_created_name)#!
    let action_lbl = if is_cut { "Moved " } else { "Pasted " }
    status_emit(action_lbl ++ processed.to_string() ++ " item(s)")#
    ()
}

fn cmd_dirvish_paste(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    execute_paste(kernel, false)#!
}

fn cmd_dirvish_paste_overwrite(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    execute_paste(kernel, true)#!
}

fn cmd_dirvish_delete(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!
    let center_buf = world.active_buffer()
    let cur_row = center_buf.point.row
    let targets = target_paths_for_action(state, center_buf)
    if targets.is_empty() {
        status_emit("No entries to delete")#
        return ()
    }

    let req = PromptRequest.with_candidates(
        "Delete " ++ targets.len().to_string() ++ " item(s)? (y/n): ",
        "",
        PromptKind.confirm,
        ["y", "n"],
    )
    let ans_opt = ask_prompt(req)#
    let ans? = ans_opt else {
        status_emit("Delete cancelled")#
        return ()
    }
    let low = ans.trim().to_lower()
    if low != "y" and low != "yes" {
        status_emit("Delete cancelled")#
        return ()
    }

    for i in 0..targets.len() {
        let p = targets.get(i.as(usize)).as(String)
        remove_path_any(p)!
        let _ = state.marked_paths.remove(p)
        purge_deleted_buffers(world, p)
    }
    state.invalidate_remote_caches()

    refresh_dirvish_all(kernel, world, wm, state, preferred_row = cur_row)#!
    status_emit("Deleted " ++ targets.len().to_string() ++ " item(s)")#
    ()
}

-- ============================================================================
-- 8. Rename & Create Commands (`cw`/`R`, `A`, `I`, `a`, `cf`/`%`, `mk`/`+`)
-- ============================================================================

fn apply_entry_rename(
    kernel: SystemKernel,
    ent: DirvishEntry,
    new_rel_name: String,
) -> #[log_event, status_emit] !String Unit {
    let trimmed = new_rel_name.trim()
    if trimmed == "" or trimmed == ent.name {
        status_emit("Rename unchanged")#
        return ()
    }
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!

    let base_for_rename = if state.fd_mode { any_parent_dir(ent.full_path) } else { state.current_dir }
    let dst = if is_ssh_uri(trimmed) {
        clean_dir_path(trimmed, base_for_rename)
    } else if is_ssh_uri(base_for_rename) {
        any_join_path(base_for_rename, trimmed)
    } else if path.is_absolute(trimmed) {
        path.normalize(trimmed)
    } else {
        path.normalize(path.join(base_for_rename, trimmed))
    }
    if any_exists(dst) and clean_dir_path(dst, "/") != clean_dir_path(ent.full_path, "/") {
        return error ("Rename target already exists: " ++ dst)
    }
    if not is_ssh_uri(dst) {
        let p_opt = path.parent(dst)
        if p_opt != null and p_opt.as(String) != "" {
            let _ = fs.create_dir(p_opt.as(String), parents = true) ! { _ => () }
        }
    }
    move_entry(ent.full_path, dst)!
    sync_renamed_buffers(world, ent.full_path, dst)
    if state.marked_paths.contains(ent.full_path) {
        let _ = state.marked_paths.remove(ent.full_path)
        let _ = state.marked_paths.insert(dst)
    }

    let focus = any_basename(dst)
    state.invalidate_remote_caches()
    if state.fd_mode {
        state.fd_all_entries = scan_fd_all_entries(state.fd_root, state.show_hidden)!
    }
    refresh_dirvish_all(kernel, world, wm, state, focus_name = focus)#!
    status_emit("Renamed '" ++ ent.name ++ "' -> '" ++ focus ++ "'")#
    ()
}

fn cmd_dirvish_rename(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_dirvish_state(kernel)!
    let ent? = entry_at_cursor(state, world.active_buffer()) else {
        return ()
    }
    let ans_opt = ask_prompt(PromptRequest.text("Rename " ++ ent.name ++ " to: ", ""))#
    let ans? = ans_opt else {
        return ()
    }
    apply_entry_rename(kernel, ent, ans)#!
}

fn cmd_dirvish_rename_append(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_dirvish_state(kernel)!
    let ent? = entry_at_cursor(state, world.active_buffer()) else {
        return ()
    }
    let ans_opt = ask_prompt(PromptRequest.text("Rename: ", ent.name))#
    let ans? = ans_opt else {
        return ()
    }
    apply_entry_rename(kernel, ent, ans)#!
}

fn cmd_dirvish_rename_prepend(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_dirvish_state(kernel)!
    let ent? = entry_at_cursor(state, world.active_buffer()) else {
        return ()
    }
    let ans_opt = ask_prompt(PromptRequest.text("Prepend to " ++ ent.name ++ ": ", ""))#
    let ans? = ans_opt else {
        return ()
    }
    if ans == "" {
        return ()
    }
    apply_entry_rename(kernel, ent, ans ++ ent.name)#!
}

fn cmd_dirvish_rename_stem(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_dirvish_state(kernel)!
    let ent? = entry_at_cursor(state, world.active_buffer()) else {
        return ()
    }
    let (stem, ext) = split_stem_and_ext(ent.name)
    let label = if ext != "" {
        "Rename stem (" ++ ext ++ "): "
    } else {
        "Rename: "
    }
    let ans_opt = ask_prompt(PromptRequest.text(label, stem))#
    let ans? = ans_opt else {
        return ()
    }
    let trimmed = ans.trim()
    if trimmed == "" {
        return ()
    }
    let final_name = if ext != "" and (not trimmed.ends_with(ext)) {
        trimmed ++ ext
    } else {
        trimmed
    }
    apply_entry_rename(kernel, ent, final_name)#!
}

fn cmd_dirvish_create_file(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!
    let ans_opt = ask_prompt(PromptRequest.text("New file: ", ""))#
    let ans? = ans_opt else {
        return ()
    }
    let rel = ans.trim()
    if rel == "" {
        return ()
    }
    let target = if is_ssh_uri(rel) {
        clean_dir_path(rel, state.current_dir)
    } else if is_ssh_uri(state.current_dir) {
        any_join_path(state.current_dir, rel)
    } else if path.is_absolute(rel) {
        path.normalize(rel)
    } else {
        path.normalize(path.join(state.current_dir, rel))
    }
    if is_ssh_uri(target) {
        let par_u = any_parent_dir(target)
        if par_u != "" and not any_exists(par_u) {
            remote_mkdir(par_u)!
        }
        if not any_exists(target) {
            let _ = remote_write_lines(target, [""], false)!
        }
    } else {
        let p_opt = path.parent(target)
        if p_opt != null and p_opt.as(String) != "" {
            (fs.create_dir(p_opt.as(String), parents = true) ! {
                err => error ("Failed creating parent directories: " ++ err.to_string())
            })!
        }
        if not fs.exists(target) {
            (fs.write_string(target, "") ! {
                err => error ("Failed creating file '" ++ target ++ "': " ++ err.to_string())
            })!
        }
    }

    -- Focus newly created file (or its top-level parent child inside `current_dir`)
    var focus_item = rel
    if rel.contains("/") {
        let (head, _) = rel.split_once("/").as((String, String))
        focus_item = head
    }
    if focus_item.starts_with(".") {
        state.show_hidden = true
    }
    state.invalidate_remote_caches()
    if state.fd_mode {
        state.fd_all_entries = scan_fd_all_entries(state.fd_root, state.show_hidden)!
    }
    refresh_dirvish_all(kernel, world, wm, state, focus_name = focus_item)#!
    status_emit("Created file: " ++ rel)#
    ()
}

fn cmd_dirvish_mkdir(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let wm = require_window_manager(kernel)!
    let state = require_dirvish_state(kernel)!
    let ans_opt = ask_prompt(PromptRequest.text("New directory: ", ""))#
    let ans? = ans_opt else {
        return ()
    }
    let rel = ans.trim()
    if rel == "" {
        return ()
    }
    let clean_rel = if rel.char_len() > 1 and rel.ends_with("/") {
        rel.slice(0, rel.char_len() - 1)
    } else {
        rel
    }
    let target = if is_ssh_uri(clean_rel) {
        clean_dir_path(clean_rel, state.current_dir)
    } else if is_ssh_uri(state.current_dir) {
        any_join_path(state.current_dir, clean_rel)
    } else if path.is_absolute(clean_rel) {
        path.normalize(clean_rel)
    } else {
        path.normalize(path.join(state.current_dir, clean_rel))
    }
    if is_ssh_uri(target) {
        remote_mkdir(target)!
    } else {
        (fs.create_dir(target, parents = true) ! {
            err => error ("Failed creating directory '" ++ target ++ "': " ++ err.to_string())
        })!
    }

    var focus_item = clean_rel
    if clean_rel.contains("/") {
        let (head, _) = clean_rel.split_once("/").as((String, String))
        focus_item = head
    }
    if focus_item.starts_with(".") {
        state.show_hidden = true
    }
    state.invalidate_remote_caches()
    if state.fd_mode {
        state.fd_all_entries = scan_fd_all_entries(state.fd_root, state.show_hidden)!
    }
    refresh_dirvish_all(kernel, world, wm, state, focus_name = focus_item)#!
    status_emit("Created directory: " ++ clean_rel)#
    ()
}

-- ============================================================================
-- 9. View, Sort, Filter, Path Yank, Shell, Refresh & Quit Commands
