            summary_en: "Display relative line distances from cursor row (disabled by default; opt-in via :set rnu).",
            summary_zh: "显示相对光标行的距离行号（默认关闭，可通过 :set rnu 开启）。",
        },
        OptionMeta {
            name: "tabstop",
            short_alias: "ts",
            val_type: "i64",
            set_example: ":set tabstop=4  |  :set ts=2",
            summary_en: "Number of visual display columns occupied by a literal Tab ('\\t') character.",
