-- ext_help: Emacs Info Hypertext Manual Reader (`*Info*`), Global Documentation Apropos (`*Apropos*`),
-- and Emacs `helpful`-Style Deep Runtime & Source Introspection (`*Help*`) for Lava.
-- Publishes service `"lava.help.state"` (`HelpState`) onto `SystemKernel`.

use std.collections.{HashMap, Set}
use std.fs
use std.io.{File, OpenMode}
use std.path

use @lava_core.{
    CommandSpec, ExtId, ExtensionRecord, HookListener, InteractiveEffects, KeyBindingEntry,
    KeyStroke, Keymap, PromptKind, PromptRequest, ServiceEntry, SystemKernel, ask_prompt,
    clipboard_get, clipboard_set, format_chord, log_event, parse_key_sequence, status_emit
}
use @lava_accel.{
    DocNode, DocSearchHit, SymbolDefHit, accel_find_symbol_defs, accel_index_docs,
    accel_search_docs
}
use @ext_document.{
    Buffer, BufferId, BufferKind, EditorOptions, EditorWorld, Pos, detect_major_mode,
    ext_document_id, require_editor_world
}
use @ext_window.{WindowManager, ext_window_id}
use @ext_render.ext_render_id
use @ext_vim.{
    KEYMAP_VIM_INSERT, KEYMAP_VIM_LEADER, KEYMAP_VIM_NORMAL, SERVICE_VIM, VimMode, VimState,
    ext_vim_id, sync_world_from_vim
}
use @ext_emacs.{KEYMAP_EMACS_GLOBAL, ext_emacs_id}

pub const SERVICE_HELP_STATE: String = "lava.help.state"
pub const INFO_BUF_NAME: String = "*Info*"
pub const APROPOS_BUF_NAME: String = "*Apropos*"
pub const HELP_BUF_NAME: String = "*Help*"
pub const INFO_DIR_NODE: String = "(dir)Top"

pub fn ext_help_id() -> ExtId = ExtId("lava.org/ext_help")

-- ============================================================================
-- 1. Core State & Structured Metadata Types
-- ============================================================================

pub struct InfoHistoryItem {
    pub node_id: String,
    pub cursor_row: i64,
}

pub struct AproposHit {
    pub row: i64,
    pub kind: String,
    pub target_id: String,
    pub file_path: String,
    pub file_row: i64,
    pub title: String,
}

pub struct HelpPageSpec {
    pub page_kind: String,
    pub target: String,
    pub source_file: String,
    pub source_row: i64,
    pub cursor_row: i64,
}

pub struct OptionMeta {
    pub name: String,
    pub short_alias: String,
    pub val_type: String,
    pub set_example: String,
    pub summary_en: String,
    pub summary_zh: String,
}

struct HelpLink {
    row: i64,
    start_col: i64,
    end_col: i64,
    kind: String,
    target: String,
}

pub struct HelpState {
    pub extra_doc_roots: List,
    pub override_doc_roots: List,
    pub extra_code_roots: List,
    pub override_code_roots: List,
    pub origin_buf_id: ?BufferId,
    pub current_info_node: String,
    pub info_history: List,
    pub info_history_idx: i64,
    pub info_last_query: String,
    pub info_search_hits: List,
    pub info_search_idx: i64,
    pub apropos_query: String,
    pub apropos_mode_kind: String,
    pub apropos_entries: List,
    pub current_help_page: ?HelpPageSpec,
    pub help_history: List,
    pub help_history_idx: i64,
}

impl HelpState {
    pub fn new() -> HelpState {
        HelpState {
            extra_doc_roots: List(),
            override_doc_roots: List(),
            extra_code_roots: List(),
            override_code_roots: List(),
            origin_buf_id: null,
            current_info_node: "",
            info_history: List(),
            info_history_idx: -1,
            info_last_query: "",
            info_search_hits: List(),
            info_search_idx: 0,
            apropos_query: "",
            apropos_mode_kind: "docs",
            apropos_entries: List(),
            current_help_page: null,
            help_history: List(),
            help_history_idx: -1,
        }
    }
}

pub fn require_help_state(kernel: SystemKernel) -> !String HelpState {
    let raw = kernel.require_service(SERVICE_HELP_STATE)!
    raw.as(HelpState)
}

-- ============================================================================
-- 2. Documentation & Code Roots Discovery
-- ============================================================================

private fn push_unique_existing_path(out: List, raw_path: String, require_dir: bool) {
    let trimmed = raw_path.trim()
    if trimmed == "" or (not fs.exists(trimmed)) {
        return
    }
    if require_dir and (not fs.is_dir(trimmed)) {
        return
    }
    let norm = path.normalize(trimmed)
    if not out.contains(norm) {
        out.push(norm)
    }
}

pub fn resolve_doc_roots(world: EditorWorld, .state: ?HelpState = null) -> List {
    let out = List()
    if state != null {
        let st = state.as(HelpState)
        if not st.override_doc_roots.is_empty() {
            for i in 0..st.override_doc_roots.len() {
                let p = st.override_doc_roots.get(i.as(usize)).as(String)
                push_unique_existing_path(out, p, false)
            }
            return out
        }
    }

    push_unique_existing_path(out, path.join(world.cwd, "docs"), true)
    push_unique_existing_path(out, "/home/fin/apps/lava/docs", true)
    push_unique_existing_path(out, "/home/fin/nessa2/docs", true)

    if state != null {
        let st = state.as(HelpState)
        for i in 0..st.extra_doc_roots.len() {
            let p = st.extra_doc_roots.get(i.as(usize)).as(String)
            push_unique_existing_path(out, p, false)
        }
    }
    out
}

pub fn resolve_code_roots(world: EditorWorld, .state: ?HelpState = null) -> List {
    let out = List()
    if state != null {
        let st = state.as(HelpState)
        if not st.override_code_roots.is_empty() {
            for i in 0..st.override_code_roots.len() {
                let p = st.override_code_roots.get(i.as(usize)).as(String)
                push_unique_existing_path(out, p, false)
            }
            return out
        }
    }

    let candidates = [
        path.join(world.cwd, "packages"),
        path.join(world.cwd, "extensions"),
        path.join(world.cwd, "src"),
        "/home/fin/apps/lava/packages",
        "/home/fin/apps/lava/extensions",
        "/home/fin/nessa2/library/std",
    ]
    for i in 0..candidates.len() {
        push_unique_existing_path(out, candidates.get(i.as(usize)).as(String), true)
    }

    if state != null {
        let st = state.as(HelpState)
        for i in 0..st.extra_code_roots.len() {
            let p = st.extra_code_roots.get(i.as(usize)).as(String)
            push_unique_existing_path(out, p, false)
        }
    }
    out
}

-- ============================================================================
-- 3. Shared Formatting, Buffer/Window Switching & Orderless Scoring Helpers
-- ============================================================================

private fn emit_help_status(world: EditorWorld, msg: String) -> #status_emit Unit {
    world.status_message = msg
    status_emit(msg)#
}

private fn pad_right(s: String, width: i64) -> String {
    let n = s.char_len()
    if n >= width {
        return s
    }
    s ++ " ".repeat(width - n)
}

private fn split_text_lines_clean(text: String) -> List {
    if text == "" {
        return [""]
    }
    let normalized = text.replace("\r\n", "\n").replace("\r", "\n")
    let parts = normalized.split("\n")
    if parts.len() > 1 and normalized.ends_with("\n") {
        let _ = parts.pop()
    }
    if parts.is_empty() {
        parts.push("")
    }
    parts
}

private fn ensure_row_visible(world: EditorWorld, row: i64) {
    let vis_rows = if world.viewport_rows > 2 { world.viewport_rows - 2 } else { 1 }
    if row < world.viewport_top_row {
        world.viewport_top_row = row
    } else if row >= world.viewport_top_row + vis_rows {
        world.viewport_top_row = row - vis_rows + 1
    }
}

private fn ensure_normal_modal_state(kernel: SystemKernel, world: EditorWorld) {
    if not world.options.evil_mode {
        return
    }
    let vim_opt = kernel.service(SERVICE_VIM)
    if vim_opt != null {
        let vs = vim_opt.as(VimState)
        vs.mode = VimMode.normal
        vs.clear_transient()
        sync_world_from_vim(world, vs)
    }
}

private fn sync_window_pane_to_world(kernel: SystemKernel, world: EditorWorld) {
    let wm_opt = kernel.service("lava.window.manager")
    if wm_opt != null {
        let wm = wm_opt.as(WindowManager)
        let ap = wm.active_pane()
        ap.buffer_id = world.active_buffer_id
        ap.cursor = world.active_buffer().point
        wm.sync_from_world(world)
    }
}

private fn is_help_family_buffer(buf: Buffer) -> bool {
    buf.name == INFO_BUF_NAME
        or buf.name == APROPOS_BUF_NAME
        or buf.name == HELP_BUF_NAME
        or buf.major_mode == "info"
        or buf.major_mode == "apropos"
        or buf.major_mode == "help"
}

private fn remember_origin_buffer(world: EditorWorld, state: HelpState) {
    let cur = world.active_buffer()
    if (not is_help_family_buffer(cur)) and cur.id != world.messages_id {
        state.origin_buf_id = cur.id
    }
}

private fn fallback_non_help_buffer_id(world: EditorWorld) -> BufferId {
    var i = world.buffer_order.len() - 1
    while i >= 0 {
        let bid = world.buffer_order.get(i.as(usize)).as(BufferId)
        let b = world.buffers.get(bid).as(Buffer)
        if (not is_help_family_buffer(b)) and bid != world.messages_id {
            return bid
        }
        i -= 1
    }
    world.scratch_id
}

private fn quit_help_family_buffer(
    kernel: SystemKernel,
    world: EditorWorld,
    state: HelpState,
) -> #status_emit Unit {
    var target_id = fallback_non_help_buffer_id(world)
    state.origin_buf_id match {
        orig_id? => {
            let ob_opt = world.buffer(orig_id)
            if ob_opt != null and (not is_help_family_buffer(ob_opt.as(Buffer))) {
                target_id = orig_id
            }
        },
        null => {},
    }
    let _ = world.switch_to_buffer(target_id)
    ensure_normal_modal_state(kernel, world)
    ensure_row_visible(world, world.active_buffer().point.row)
    sync_window_pane_to_world(kernel, world)
    kernel.emit_hook("buffer-switched", target_id)
    emit_help_status(world, "Buffer: " ++ world.active_buffer().name)#
}

private fn activate_special_buffer(
    kernel: SystemKernel,
    world: EditorWorld,
    name: String,
    major_mode: String,
    lines: List,
    cursor_pos: Pos,
) -> Buffer {
    let safe_lines = if lines.is_empty() { [""] } else { lines }
    let b = world.ensure_special_buffer(name, major_mode, safe_lines, read_only = true)
    b.point = b.clamp_pos(cursor_pos, insert_mode = false)
    b.preferred_col = b.point.col
    let _ = world.switch_to_buffer(b.id)
    ensure_normal_modal_state(kernel, world)
    world.viewport_top_row = 0
    ensure_row_visible(world, b.point.row)
    sync_window_pane_to_world(kernel, world)
    kernel.emit_hook("buffer-switched", b.id)
    b
}

private fn open_file_at_row(
    kernel: SystemKernel,
    world: EditorWorld,
    raw_path: String,
    row_zero_based: i64,
) -> #[log_event, status_emit] !String Buffer {
    let full_path = world.resolve_path(raw_path)
    let cur = world.active_buffer()
    world.jumps.record(cur.id, cur.file_path, cur.point)

    var opened_opt = world.find_buffer_by_path(full_path)
    if opened_opt != null {
        let b = opened_opt.as(Buffer)
        world.active_buffer_id = b.id
    } else if fs.exists(full_path) and fs.is_file(full_path) {
        let content! = fs.read_to_string(full_path) else {
            return error ("cannot read file: " ++ full_path)
        }
        let base_opt = path.file_name(full_path)
        let base_name = if base_opt != null { base_opt.as(String) } else { full_path }
        let mode = detect_major_mode(full_path)
        let file_lines = split_text_lines_clean(content)
        let created = world.create_buffer(
            base_name,
            BufferKind.file,
            file_path = full_path,
            major_mode = mode,
            initial_lines = file_lines,
        )
        created.crlf = content.contains("\r\n")
        created.modified = false
        world.active_buffer_id = created.id
        opened_opt = created
    } else {
        let opened = world.open_file(full_path)#!
        opened_opt = opened
    }

    let target_buf = world.active_buffer()
    let clamped_r = if row_zero_based < 0 {
        0
    } else if row_zero_based > target_buf.max_row() {
        target_buf.max_row()
    } else {
        row_zero_based
    }
    let col = target_buf.first_non_blank_col(clamped_r)
    target_buf.point = target_buf.clamp_pos(Pos.new(clamped_r, col), insert_mode = false)
    target_buf.preferred_col = target_buf.point.col
    ensure_normal_modal_state(kernel, world)
    ensure_row_visible(world, target_buf.point.row)
    sync_window_pane_to_world(kernel, world)
    kernel.emit_hook("buffer-switched", target_buf.id)
    emit_help_status(
        world,
        "Opened " ++ target_buf.name ++ ":" ++ (clamped_r + 1).to_string(),
    )#
    target_buf
}

private fn pretty_stroke_notation(st: KeyStroke) -> String {
    if (not st.ctrl) and (not st.alt) and (not st.shift_mod) and (not st.super_mod) {
        if st.key.char_len() == 1 and st.key != "<" and st.key != ">" and st.key != " " {
            return st.key
        }
        if st.key == "<" {
            return "<lt>"
        }
        if st.key == ">" {
            return "<gt>"
        }
        return "<" ++ st.key ++ ">"
    }
    st.notation()
}

private fn pretty_chord_string(raw_chord: String) -> String {
    let seq = parse_key_sequence(raw_chord)
    if seq.is_empty() {
        return raw_chord
    }
    let parts = List()
    for i in 0..seq.len() {
        parts.push(pretty_stroke_notation(seq.get(i.as(usize)).as(KeyStroke)))
    }
    parts.join(" ")
}

private fn collect_bindings_for_command(kernel: SystemKernel, cmd_name: String) -> List {
    let out = List()
    let km_names = kernel.keymaps.keys()
    km_names.sort()
    for i in 0..km_names.len() {
        let kname = km_names.get(i.as(usize)).as(String)
        let km = kernel.keymaps.get(kname).as(Keymap)
        let chords = km.bindings.keys()
        chords.sort()
        for j in 0..chords.len() {
            let ch = chords.get(j.as(usize)).as(String)
            let entry = km.bindings.get(ch).as(KeyBindingEntry)
            if entry.command_name == cmd_name {
                out.push((kname, entry))
            }
        }
    }
    out
}

private fn build_command_chords_map(kernel: SystemKernel) -> HashMap {
    let list_map = HashMap.new()
    let km_names = kernel.keymaps.keys()
    km_names.sort()
    for i in 0..km_names.len() {
        let kname = km_names.get(i.as(usize)).as(String)
        let km = kernel.keymaps.get(kname).as(Keymap)
        let chords = km.bindings.keys()
        chords.sort()
        for j in 0..chords.len() {
            let ch = chords.get(j.as(usize)).as(String)
            let entry = km.bindings.get(ch).as(KeyBindingEntry)
            let existing_opt = list_map.get(entry.command_name)
            if existing_opt == null {
                list_map.insert(entry.command_name, [entry.chord])
            } else {
                let arr = existing_opt.as(List)
                if arr.len() < 4 and (not arr.contains(entry.chord)) {
                    arr.push(entry.chord)
                }
            }
        }
    }
    let out = HashMap.new()
    for cmd_k in list_map.keys() {
        let cname = cmd_k.as(String)
        let arr = list_map.get(cname).as(List)
        out.insert(cname, arr.join(", "))
    }
    out
}

-- Orderless multi-token scorer (`!neg`, `^prefix`, `suffix$`, `=exact`, substring & subsequence)
private fn score_single_token(tok: String, primary_low: String, full_low: String) -> (bool, i64) {
    let tlen = tok.char_len()
    if tlen == 0 {
        return (false, 50)
    }
    if tok.starts_with("!") and tlen > 1 {
        let neg = tok.drop(1).to_lower()
        if primary_low.contains(neg) or full_low.contains(neg) {
            return (true, -1)
        }
        return (true, 100)
    }
    if tok.starts_with("^") and tlen > 1 {
        let anch = tok.drop(1).to_lower()
        if primary_low.starts_with(anch) {
            return (false, 9000 - primary_low.char_len())
        }
        return (false, -1)
    }
    if tok.ends_with("$") and tlen > 1 {
        let anch = tok.slice(0, tlen - 1).to_lower()
        if primary_low.ends_with(anch) {
            return (false, 8200 - primary_low.char_len())
        }
        return (false, -1)
    }
    let q = if tok.starts_with("=") and tlen > 1 { tok.drop(1).to_lower() } else { tok.to_lower() }
    if primary_low == q {
        return (false, 15000)
    }
    if primary_low.starts_with(q) {
        return (false, 11000 - (primary_low.char_len() - q.char_len()))
    }
    let p_idx = primary_low.find(q)
    if p_idx != null {
        return (false, 7500 - p_idx.as(i64) * 8 - primary_low.char_len())
    }
    let f_idx = full_low.find(q)
    if f_idx != null {
        return (false, 4200 - (if f_idx.as(i64) > 200 { 200 } else { f_idx.as(i64) }))
    }
    if not tok.starts_with("=") {
        -- Subsequence match against `primary_low`
        var qi: i64 = 0
        var ci: i64 = 0
        let qlen = q.char_len()
        let plen = primary_low.char_len()
        while qi < qlen and ci < plen {
            if primary_low.slice(ci, ci + 1) == q.slice(qi, qi + 1) {
                qi += 1
            }
            ci += 1
        }
        if qi >= qlen and qlen >= 2 {
            return (false, 1800 - plen)
        }
    }
    (false, -1)
}

pub fn orderless_score(query: String, primary: String, secondary: String) -> i64 {
    let q_trim = query.trim()
    if q_trim == "" {
        return 100
    }
    let p_low = primary.to_lower()
    let full_low = (primary ++ " " ++ secondary).to_lower()
    let raw_toks = q_trim.split_whitespace()
    if raw_toks.is_empty() {
        return 100
    }
    var total: i64 = 0
    var pos_count: i64 = 0
    for i in 0..raw_toks.len() {
        let tk = raw_toks.get(i.as(usize)).as(String)
        let (is_neg, sc) = score_single_token(tk, p_low, full_low)
        if sc < 0 {
            return -1
        }
        if not is_neg {
            total += sc
            pos_count += 1
        }
    }
    if pos_count == 0 {
        return 150
    }
    total
}

-- ============================================================================
-- 4. Source Definition Discovery & Code Snippet Preview
-- ============================================================================

private fn find_command_source(
    world: EditorWorld,
    state: HelpState,
    cmd_name: String,
    owner: ExtId,
) -> ?SymbolDefHit {
    let roots = resolve_code_roots(world, state = state)
    if roots.is_empty() {
        return null
    }
    let hits = accel_find_symbol_defs(roots, cmd_name, limit = 30)
    let owner_raw = owner.raw()
    let owner_short = if owner_raw.contains("/") {
        let pair_opt = owner_raw.rsplit_once("/")
        if pair_opt != null {
            let (_, s) = pair_opt.as((String, String))
            s
        } else {
            owner_raw
        }
    } else {
        owner_raw
    }

    -- 1. Exact `command` registration in owner's directory
    for i in 0..hits.len() {
        let h = hits.get(i.as(usize)).as(SymbolDefHit)
        if h.kind == "command" and h.symbol == cmd_name and h.file_path.contains(owner_short) {
            return h
        }
    }
    -- 2. Exact `command` registration anywhere
    for i in 0..hits.len() {
        let h = hits.get(i.as(usize)).as(SymbolDefHit)
        if h.kind == "command" and h.symbol == cmd_name {
            return h
        }
    }
    -- 3. Handler function `cmd_<snake_name>`
    let snake_cmd = "cmd_" ++ cmd_name.replace("-", "_").replace(":", "_")
    let fn_hits = accel_find_symbol_defs(roots, snake_cmd, limit = 15)
    for i in 0..fn_hits.len() {
        let h = fn_hits.get(i.as(usize)).as(SymbolDefHit)
        if h.symbol == snake_cmd {
            return h
        }
    }
    null
}

private fn extract_ident_head(s: String) -> String {
    let n = s.char_len()
    var i: i64 = 0
    while i < n {
        let ch = s.slice(i, i + 1)
        if ch.is_alphanumeric() or ch == "_" {
            i += 1
        } else {
            break
        }
    }
    s.slice(0, i)
}

private fn collect_preceding_doc_comment(lines: List, row: i64) -> String {
    let rev = List()
    var cur = row - 1
    while cur >= 0 {
        let t = lines.get(cur.as(usize)).as(String).trim()
        if t.starts_with("--") {
            let rest = t.drop(2).trim()
            if (not rest.starts_with("====")) and (not rest.starts_with("----")) {
                rev.push(rest)
            }
        } else {
            break
        }
        cur -= 1
    }
    let out = List()
    var k = rev.len() - 1
    while k >= 0 {
        out.push(rev.get(k.as(usize)))
        k -= 1
    }
    out.join("\n")
}

-- Combines fast `accel_find_symbol_defs` with `--` doc-comment & Orderless symbol scanning!
private fn search_source_symbols_apropos(code_roots: List, query: String, limit: i64) -> List {
    let q_trim = query.trim()
    if q_trim == "" or code_roots.is_empty() {
        return List()
    }
    let seen = Set.new()
    let scored = List()

    -- Pass 1: Fast native/fallback `accel_find_symbol_defs` on full query and individual tokens
    let direct = accel_find_symbol_defs(code_roots, q_trim, limit = limit * 2)
    for i in 0..direct.len() {
        let d = direct.get(i.as(usize)).as(SymbolDefHit)
        if d.kind != "command" {
            let key = d.file_path ++ ":" ++ d.row.to_string() ++ ":" ++ d.symbol
            let sc = orderless_score(q_trim, d.symbol, d.kind ++ " " ++ d.signature ++ " " ++ d.doc_comment)
            let eff_sc = if sc >= 0 { sc + 1000 } else { 3000 - i * 10 }
            seen.insert(key)
            scored.push((eff_sc, d))
        }
    }

    let toks = q_trim.split_whitespace()
    if toks.len() > 1 {
        for ti in 0..toks.len() {
            let tk = toks.get(ti.as(usize)).as(String)
            if tk != "" and (not tk.starts_with("!")) {
                let sub = accel_find_symbol_defs(code_roots, tk, limit = 25)
                for si in 0..sub.len() {
                    let d = sub.get(si.as(usize)).as(SymbolDefHit)
                    if d.kind != "command" {
                        let key = d.file_path ++ ":" ++ d.row.to_string() ++ ":" ++ d.symbol
                        if not seen.contains(key) {
                            let sc = orderless_score(q_trim, d.symbol, d.kind ++ " " ++ d.signature ++ " " ++ d.doc_comment)
                            if sc >= 0 {
                                seen.insert(key)
                                scored.push((sc + 500, d))
                            }
                        }
                    }
                }
            }
        }
    }

    -- Pass 2: Scan `.ns` definitions + `--` doc comments so queries matching doc comments also surface!
    let ns_files = List()
    let seen_files = Set.new()
    for ri in 0..code_roots.len() {
        if ns_files.len() >= 180 {
            break
        }
        let root = code_roots.get(ri.as(usize)).as(String)
        if not fs.exists(root) {
            continue
        }
        if fs.is_file(root) and root.ends_with(".ns") {
            let norm = path.normalize(root)
            if not seen_files.contains(norm) {
                seen_files.insert(norm)
                ns_files.push(norm)
            }
            continue
        }
        let walked! = fs.walk_dir(root, max_depth = 8, include_hidden = false) else {
            continue
        }
        for fi in 0..walked.len() {
            if ns_files.len() >= 180 {
                break
            }
            let rel = walked.get(fi.as(usize)).as(String)
            if rel.ends_with(".ns") and (not rel.contains("target/")) and (not rel.starts_with(".")) {
                let full = path.normalize(path.join(root, rel))
                if not seen_files.contains(full) {
                    seen_files.insert(full)
                    ns_files.push(full)
                }
            }
        }
    }

    let kws = [
        ("fn ", "fn"),
        ("struct ", "struct"),
        ("enum ", "enum"),
        ("trait ", "trait"),
        ("effect ", "effect"),
        ("const ", "const"),
        ("newtype ", "type"),
        ("type ", "type"),
    ]
    let first_pos_tok = if toks.is_empty() {
        q_trim.to_lower()
    } else {
        var ft = ""
        for ti in 0..toks.len() {
            let cand_t = toks.get(ti.as(usize)).as(String)
            if not cand_t.starts_with("!") {
                ft = cand_t.trim_start_matches("^").trim_start_matches("=").trim_end_matches("$").to_lower()
                break
            }
        }
        ft
    }

    for fi in 0..ns_files.len() {
        let fp = ns_files.get(fi.as(usize)).as(String)
        let content! = fs.read_to_string(fp) else {
            continue
        }
        if first_pos_tok != "" and first_pos_tok.char_len() >= 3 and (not content.to_lower().contains(first_pos_tok)) {
            continue
        }
        let lines = content.replace("\r\n", "\n").split("\n")
        for r in 0..lines.len() {
            let trimmed = lines.get(r.as(usize)).as(String).trim()
            if trimmed == "" or trimmed.starts_with("--") {
                continue
            }
            var rest = trimmed
            if rest.starts_with("pub(crate) ") {
                rest = rest.drop(11).trim_start()
            } else if rest.starts_with("pub ") {
                rest = rest.drop(4).trim_start()
            } else if rest.starts_with("private ") {
                rest = rest.drop(8).trim_start()
            }
            if rest.starts_with("async ") {
                rest = rest.drop(6).trim_start()
            }
            for ki in 0..kws.len() {
                let (kw, kind) = kws.get(ki.as(usize)).as((String, String))
                if rest.starts_with(kw) {
                    let sym = extract_ident_head(rest.drop(kw.char_len()))
                    if sym != "" {
                        let key = fp ++ ":" ++ r.to_string() ++ ":" ++ sym
                        if not seen.contains(key) {
                            let doc_c = collect_preceding_doc_comment(lines, r)
                            let sc = orderless_score(q_trim, sym, kind ++ " " ++ trimmed ++ " " ++ doc_c)
                            if sc >= 0 {
                                let pub_bonus: i64 = if trimmed.starts_with("pub ") { 300 } else { 0 }
                                seen.insert(key)
                                scored.push((sc + pub_bonus, SymbolDefHit {
                                    symbol: sym,
                                    kind: kind,
                                    file_path: fp,
                                    row: r,
                                    signature: trimmed.take(120),
                                    doc_comment: doc_c,
                                }))
                            }
                        }
                    }
                    break
                }
            }
        }
    }

    scored.sort_by(|a: Any, b: Any| {
        let (sa, da) = a.as((i64, SymbolDefHit))
        let (sb, db) = b.as((i64, SymbolDefHit))
        if sa != sb {
            sb.cmp(sa)
        } else if da.symbol != db.symbol {
            da.symbol.cmp(db.symbol)
        } else {
            da.file_path.cmp(db.file_path)
        }
    })

    let out = List()
    let cap = if scored.len() > limit { limit } else { scored.len() }
    for j in 0..cap {
        let (_, hit) = scored.get(j.as(usize)).as((i64, SymbolDefHit))
        out.push(hit)
    }
    out
}

private fn read_source_snippet_lines(file_path: String, def_row: i64, max_lines: i64) -> List {
    let out = List()
    if file_path == "" or (not fs.exists(file_path)) {
        return out
    }
    let f! = File.open(file_path, mode = OpenMode.read) else {
        return out
    }
    defer { let _ = f.close() }
    let start_r = if def_row < 0 { 0 } else { def_row }
    let end_r_excl = start_r + max_lines
    var r: i64 = 0
    for line in f.lines() {
        if r >= end_r_excl {
            break
        }
        if r >= start_r {
            let num_str = (r + 1).to_string().pad_start(5, " ")
            let marker = if r == def_row { " > " } else { " | " }
            out.push("  " ++ num_str ++ marker ++ line)
        }
        r += 1
    }
    out
}

