pub fn find_option_meta(raw_name: String) -> ?OptionMeta {
    var q = raw_name.trim()
    if q.starts_with("'") and q.ends_with("'") and q.char_len() > 2 {
        q = q.slice(1, q.char_len() - 1)
    }
    if q.starts_with("option:") {
        q = q.drop(7)
    }
    let q_low = q.to_lower()
    let metas = all_option_metas()
    for i in 0..metas.len() {
        let m = metas.get(i.as(usize)).as(OptionMeta)
        if m.name.to_lower() == q_low or (m.short_alias != "" and m.short_alias.to_lower() == q_low) {
            return m
        }
    }
    null
}

pub fn get_option_value_str(opts: EditorOptions, name: String) -> String {
    when {
        name == "number" => opts.number.to_string(),
        name == "relativenumber" => opts.relativenumber.to_string(),
        name == "tabstop" => opts.tabstop.to_string(),
        name == "shiftwidth" => opts.shiftwidth.to_string(),
        name == "expandtab" => opts.expandtab.to_string(),
        name == "ignorecase" => opts.ignorecase.to_string(),
        name == "smartcase" => opts.smartcase.to_string(),
        name == "wrap" => opts.wrap.to_string(),
        name == "hlsearch" => opts.hlsearch.to_string(),
        name == "incsearch" => opts.incsearch.to_string(),
        name == "scrolloff" => opts.scrolloff.to_string(),
        name == "sidescrolloff" => opts.sidescrolloff.to_string(),
        name == "cursorline" => opts.cursorline.to_string(),
        name == "signcolumn" => opts.signcolumn.to_string(),
        name == "indent_guides" => opts.indent_guides.to_string(),
        name == "match_brackets" => opts.match_brackets.to_string(),
        name == "auto_indent" => opts.auto_indent.to_string(),
        name == "autopairs" => opts.autopairs.to_string(),
        name == "clipboard_unnamedplus" => opts.clipboard_unnamedplus.to_string(),
        name == "mouse_enabled" => opts.mouse_enabled.to_string(),
        name == "zen_mode" => opts.zen_mode.to_string(),
        name == "zen_width" => opts.zen_width.to_string(),
        name == "twilight_mode" => opts.twilight_mode.to_string(),
        name == "format_on_save" => opts.format_on_save.to_string(),
        name == "theme_name" => "\"" ++ opts.theme_name ++ "\"",
        name == "font_family" => "\"" ++ opts.font_family ++ "\"",
        name == "font_size_pt" => opts.font_size_pt.to_string(),
        name == "cursor_blink" => opts.cursor_blink.to_string(),
        name == "evil_mode" => opts.evil_mode.to_string(),
        name == "remember_window_size" => opts.remember_window_size.to_string(),
        name == "shadow_text" => opts.shadow_text.to_string(),
        name == "smooth_scroll" => opts.smooth_scroll.to_string(),
        name == "cursor_anim" => opts.cursor_anim.to_string(),
        name == "treesitter" => opts.treesitter.to_string(),
        else => "",
    }
}

private fn get_raw_option_edit_str(opts: EditorOptions, name: String) -> String {
    when {
        name == "theme_name" => opts.theme_name,
        name == "font_family" => opts.font_family,
        else => get_option_value_str(opts, name),
    }
}

private fn toggle_bool_option(kernel: SystemKernel, world: EditorWorld, name: String) -> ?bool {
    let opts = world.options
    var next_val = false
    when {
        name == "number" => { opts.number = not opts.number; next_val = opts.number },
        name == "relativenumber" => { opts.relativenumber = not opts.relativenumber; next_val = opts.relativenumber },
        name == "expandtab" => { opts.expandtab = not opts.expandtab; next_val = opts.expandtab },
        name == "ignorecase" => { opts.ignorecase = not opts.ignorecase; next_val = opts.ignorecase },
        name == "smartcase" => { opts.smartcase = not opts.smartcase; next_val = opts.smartcase },
        name == "wrap" => { opts.wrap = not opts.wrap; next_val = opts.wrap },
        name == "hlsearch" => {
            opts.hlsearch = not opts.hlsearch
            if not opts.hlsearch {
                world.search_highlight_active = false
            }
            next_val = opts.hlsearch
        },
        name == "incsearch" => { opts.incsearch = not opts.incsearch; next_val = opts.incsearch },
        name == "cursorline" => { opts.cursorline = not opts.cursorline; next_val = opts.cursorline },
        name == "signcolumn" => { opts.signcolumn = not opts.signcolumn; next_val = opts.signcolumn },
        name == "indent_guides" => { opts.indent_guides = not opts.indent_guides; next_val = opts.indent_guides },
        name == "match_brackets" => { opts.match_brackets = not opts.match_brackets; next_val = opts.match_brackets },
        name == "auto_indent" => { opts.auto_indent = not opts.auto_indent; next_val = opts.auto_indent },
        name == "autopairs" => { opts.autopairs = not opts.autopairs; next_val = opts.autopairs },
        name == "clipboard_unnamedplus" => {
            opts.clipboard_unnamedplus = not opts.clipboard_unnamedplus
            world.registers.unnamedplus = opts.clipboard_unnamedplus
            next_val = opts.clipboard_unnamedplus
        },
        name == "mouse_enabled" => { opts.mouse_enabled = not opts.mouse_enabled; next_val = opts.mouse_enabled },
        name == "zen_mode" => { opts.zen_mode = not opts.zen_mode; next_val = opts.zen_mode },
        name == "twilight_mode" => { opts.twilight_mode = not opts.twilight_mode; next_val = opts.twilight_mode },
        name == "format_on_save" => { opts.format_on_save = not opts.format_on_save; next_val = opts.format_on_save },
        name == "cursor_blink" => { opts.cursor_blink = not opts.cursor_blink; next_val = opts.cursor_blink },
        name == "remember_window_size" => { opts.remember_window_size = not opts.remember_window_size; next_val = opts.remember_window_size },
        name == "shadow_text" => { opts.shadow_text = not opts.shadow_text; next_val = opts.shadow_text },
        name == "smooth_scroll" => { opts.smooth_scroll = not opts.smooth_scroll; next_val = opts.smooth_scroll },
        name == "cursor_anim" => { opts.cursor_anim = not opts.cursor_anim; next_val = opts.cursor_anim },
        name == "treesitter" => { opts.treesitter = not opts.treesitter; next_val = opts.treesitter },
        name == "evil_mode" => {
            opts.evil_mode = not opts.evil_mode
            let vim_opt = kernel.service(SERVICE_VIM)
            if vim_opt != null {
                let vs = vim_opt.as(VimState)
                vs.mode = VimMode.normal
                vs.clear_transient()
                sync_world_from_vim(world, vs)
            }
            next_val = opts.evil_mode
        },
        else => return null,
    }
    next_val
}

private fn apply_option_value_str(
    kernel: SystemKernel,
    world: EditorWorld,
    meta: OptionMeta,
    raw_val: String,
) -> !String String {
    let trimmed = raw_val.trim()
    let opts = world.options
    if meta.val_type == "i64" {
        let parsed? = trimmed.try_parse(i64) else {
            return error ("Invalid integer for " ++ meta.name ++ ": " ++ trimmed)
        }
        when {
            meta.name == "tabstop" => {
                if parsed < 1 { return error "tabstop must be >= 1" }
                opts.tabstop = parsed
            },
            meta.name == "shiftwidth" => {
                if parsed < 1 { return error "shiftwidth must be >= 1" }
                opts.shiftwidth = parsed
            },
            meta.name == "scrolloff" => {
                if parsed < 0 { return error "scrolloff must be >= 0" }
                opts.scrolloff = parsed
            },
            meta.name == "sidescrolloff" => {
                if parsed < 0 { return error "sidescrolloff must be >= 0" }
                opts.sidescrolloff = parsed
            },
            meta.name == "zen_width" => {
                if parsed < 20 { return error "zen_width must be >= 20" }
                opts.zen_width = parsed
            },
            else => return error ("Unknown integer option: " ++ meta.name),
        }
        return parsed.to_string()
    }
    if meta.val_type == "f64" {
        let parsed_f? = trimmed.try_parse(f64) else {
            return error ("Invalid float for " ++ meta.name ++ ": " ++ trimmed)
        }
        if meta.name == "font_size_pt" {
            if parsed_f < 6.0 {
                return error "font_size_pt must be >= 6.0"
            }
            opts.font_size_pt = parsed_f
            return parsed_f.to_string()
        }
        return error ("Unknown float option: " ++ meta.name)
    }
    if meta.val_type == "String" {
        if trimmed == "" {
            return error (meta.name ++ " cannot be empty")
        }
        if meta.name == "theme_name" {
            opts.theme_name = trimmed
            kernel.emit_hook("theme-changed", trimmed)
            return trimmed
        }
        if meta.name == "font_family" {
            opts.font_family = trimmed
            return trimmed
        }
    }
    error ("Cannot set option: " ++ meta.name)
}

-- ============================================================================
-- 6. Hyperlink Scanner (`[node_id]`, `[Source: path:line]`, `[text](path.md)`, etc.)
-- ============================================================================

private fn parse_source_target(spec: String) -> (String, i64) {
    let trimmed = spec.trim()
    let pair_opt = trimmed.rsplit_once(":")
    if pair_opt != null {
        let (p, line_s) = pair_opt.as((String, String))
        let num_opt = line_s.trim().try_parse(i64)
        if num_opt != null {
            let line_1 = num_opt.as(i64)
            return (p.trim(), if line_1 > 0 { line_1 - 1 } else { 0 })
        }
    }
    (trimmed, 0)
}

private fn classify_bracket_inner(inner: String, known_nodes: Set, known_manuals: Set) -> ?(String, String) {
    let t = inner.trim()
    if t == "" {
        return null
    }
    if t.starts_with("Source:") {
        return ("source", t.drop(7).trim())
    }
    if t.starts_with("Info:") {
        return ("info", t.drop(5).trim())
    }
    if t.starts_with("Command:") {
        return ("command", t.drop(8).trim())
    }
    if t.starts_with("Variable:") {
        return ("variable", t.drop(9).trim())
    }
    if t.starts_with("Extension:") {
        return ("extension", t.drop(10).trim())
    }
    if t.starts_with("Symbol:") {
        return ("symbol", t.drop(7).trim())
    }
    if t.starts_with("Up:") or t.starts_with("Dir:") or t.starts_with("Next:") or t.starts_with("Prev:") {
        let pair_opt = t.split_once(":")
        if pair_opt != null {
            let (_, dest) = pair_opt.as((String, String))
            let d = dest.trim()
            if d != "" and d != "(none)" {
                return ("info", d)
            }
        }
        return null
    }
    if t == INFO_DIR_NODE {
        return ("info", INFO_DIR_NODE)
    }
    if known_nodes.contains(t) or known_manuals.contains(t) or t.contains("#") {
        -- Ignore decorative UI key-legend hints like `[RET]` or `[TAB]`
        if t.contains("#") or known_nodes.contains(t) or known_manuals.contains(t) {
            return ("info", t)
        }
    }
    null
}

private fn scan_links_on_line(
    line: String,
    row: i64,
    is_info_header_row: bool,
    known_nodes: Set,
    known_manuals: Set,
) -> List {
    let links = List()
    let n = line.char_len()
    if is_info_header_row {
        -- Parse `Next: <id>`, `Prev: <id>`, `Up: <id>` on Info line 0
        let keys = ["Next: ", "Prev: ", "Up: "]
        for ki in 0..keys.len() {
            let pfx = keys.get(ki.as(usize)).as(String)
            let pos_opt = line.find(pfx)
            if pos_opt != null {
                let val_start = pos_opt.as(i64) + pfx.char_len()
                var val_end = val_start
                while val_end < n and line.slice(val_end, val_end + 1) != "," {
                    val_end += 1
                }
                let target = line.slice(val_start, val_end).trim()
                if target != "" and target != "(none)" {
                    links.push(HelpLink {
                        row: row,
                        start_col: val_start,
                        end_col: val_end,
                        kind: "info",
                        target: target,
                    })
                }
            }
        }
        return links
    }

    var i: i64 = 0
    while i < n {
        let ch0 = line.slice(i, i + 1)
        if ch0 == "\\" {
            i += 2
            continue
        }
        -- Skip inline backtick code spans so `` `[example](foo.md)` `` is not treated as a hyperlink
        if ch0 == "`" {
            var ticks: i64 = 0
            while i + ticks < n and line.slice(i + ticks, i + ticks + 1) == "`" {
                ticks += 1
            }
            var close_t: i64 = -1
            var k = i + ticks
            while k < n {
                if line.slice(k, k + 1) == "`" {
                    var ct: i64 = 0
                    while k + ct < n and line.slice(k + ct, k + ct + 1) == "`" {
                        ct += 1
                    }
                    if ct == ticks {
                        close_t = k + ct
                        break
                    }
                    k += ct
                    continue
                }
                k += 1
            }
            if close_t > i {
                i = close_t
                continue
            }
            i += ticks
            continue
        }
        if ch0 == "[" {
            var close_idx: i64 = -1
            var j = i + 1
            var in_code = false
            while j < n {
                let ch = line.slice(j, j + 1)
                if ch == "\\" {
                    j += 2
                    continue
                }
                if ch == "`" {
                    in_code = not in_code
                    j += 1
                    continue
                }
                if not in_code {
                    if ch == "[" {
                        break
                    }
                    if ch == "]" {
                        close_idx = j
                        break
                    }
                }
                j += 1
            }
            if close_idx > i + 1 {
                -- Check Markdown link `[label](url)` (handling balanced parens & optional `"title"`)
                if close_idx + 2 < n and line.slice(close_idx + 1, close_idx + 2) == "(" {
                    var paren_end: i64 = -1
                    var pj = close_idx + 2
                    var pdepth: i64 = 1
                    while pj < n {
                        let pch = line.slice(pj, pj + 1)
                        if pch == "\\" {
                            pj += 2
                            continue
                        }
                        if pch == "(" {
                            pdepth += 1
                        } else if pch == ")" {
                            pdepth -= 1
                            if pdepth == 0 {
                                paren_end = pj
                                break
                            }
                        }
                        pj += 1
                    }
                    if paren_end > close_idx + 2 {
                        let raw_url = line.slice(close_idx + 2, paren_end).trim()
                        var md_url = raw_url
                        let sp_opt = raw_url.find(" ")
                        if sp_opt != null {
                            md_url = raw_url.slice(0, sp_opt.as(i64)).trim()
                        }
                        if md_url != "" and (not md_url.starts_with("http://")) and (not md_url.starts_with("https://")) {
                            links.push(HelpLink {
                                row: row,
                                start_col: i,
                                end_col: paren_end + 1,
                                kind: "md",
                                target: md_url,
                            })
                            i = paren_end + 1
                            continue
                        }
                    }
                }

                let inner = line.slice(i + 1, close_idx)
                let cls_opt = classify_bracket_inner(inner, known_nodes, known_manuals)
                if cls_opt != null {
                    let (lkind, ltarget) = cls_opt.as((String, String))
                    links.push(HelpLink {
                        row: row,
                        start_col: i,
                        end_col: close_idx + 1,
                        kind: lkind,
                        target: ltarget,
                    })
                    i = close_idx + 1
                    continue
                }
            }
        }
        i += 1
    }
    links
}

private fn build_known_doc_sets(nodes: List) -> (Set, Set) {
    let nset = Set.new()
    let mset = Set.new()
    nset.insert(INFO_DIR_NODE)
    for i in 0..nodes.len() {
        let nd = nodes.get(i.as(usize)).as(DocNode)
        nset.insert(nd.node_id)
        mset.insert(nd.manual)
    }
    (nset, mset)
}

private fn is_help_row_in_fence(buf: Buffer, target_row: i64) -> bool {
    var in_fence = false
    var fc = ""
    var flen: i64 = 0
    let limit = if target_row < buf.line_count() { target_row + 1 } else { buf.line_count() }
    for r in 0..limit {
        let t = buf.line_at(r).trim_start()
        if not in_fence {
            if t.starts_with("```") or t.starts_with("~~~") {
                let c = t.slice(0, 1)
                var fl: i64 = 0
                while fl < t.char_len() and t.slice(fl, fl + 1) == c {
                    fl += 1
                }
                if c != "`" or (not t.drop(fl).contains("`")) {
                    in_fence = true
                    fc = c
                    flen = fl
                    if r == target_row {
                        return true
                    }
                }
            }
        } else {
            if r == target_row {
                return true
            }
            var fl: i64 = 0
            while fl < t.char_len() and t.slice(fl, fl + 1) == fc {
                fl += 1
            }
            if fl >= flen and t.drop(fl).trim() == "" {
                in_fence = false
            }
        }
    }
    false
}

private fn collect_all_buffer_links(buf: Buffer, skip_info_row0: bool, nodes: List) -> List {
    let (nset, mset) = build_known_doc_sets(nodes)
    let all = List()
    let start_r: i64 = if skip_info_row0 { 1 } else { 0 }
    var in_fence = false
    var fc = ""
    var flen: i64 = 0
    for r in start_r..buf.line_count() {
        let ln = buf.line_at(r)
        let t = ln.trim_start()
        if not in_fence {
            if t.starts_with("```") or t.starts_with("~~~") {
                let c = t.slice(0, 1)
                var fl: i64 = 0
                while fl < t.char_len() and t.slice(fl, fl + 1) == c {
                    fl += 1
                }
                if c != "`" or (not t.drop(fl).contains("`")) {
                    in_fence = true
                    fc = c
                    flen = fl
                    continue
                }
            }
        } else {
            var fl: i64 = 0
            while fl < t.char_len() and t.slice(fl, fl + 1) == fc {
                fl += 1
            }
            if fl >= flen and t.drop(fl).trim() == "" {
                in_fence = false
            }
            continue
        }
        let row_links = scan_links_on_line(ln, r, false, nset, mset)
        for j in 0..row_links.len() {
            all.push(row_links.get(j.as(usize)))
        }
    }
    all
}

private fn jump_link_in_buffer(
    world: EditorWorld,
    buf: Buffer,
    forward: bool,
    skip_info_row0: bool,
    nodes: List,
) -> #status_emit Unit {
    let links = collect_all_buffer_links(buf, skip_info_row0, nodes)
    if links.is_empty() {
        emit_help_status(world, "No links in buffer")#
        return
    }
    let cur = buf.point
    var chosen_opt: ?HelpLink = null
    if forward {
        for i in 0..links.len() {
            let lk = links.get(i.as(usize)).as(HelpLink)
            if lk.row > cur.row or (lk.row == cur.row and lk.start_col > cur.col) {
                chosen_opt = lk
                break
            }
        }
        if chosen_opt == null {
            chosen_opt = links.get(0).as(HelpLink)
        }
    } else {
        var i = links.len() - 1
        while i >= 0 {
            let lk = links.get(i.as(usize)).as(HelpLink)
            if lk.row < cur.row or (lk.row == cur.row and lk.start_col < cur.col) {
                chosen_opt = lk
                break
            }
            i -= 1
        }
        if chosen_opt == null {
            chosen_opt = links.get((links.len() - 1).as(usize)).as(HelpLink)
        }
    }
    let chosen = chosen_opt.as(HelpLink)
    buf.point = buf.clamp_pos(Pos.new(chosen.row, chosen.start_col), insert_mode = false)
    buf.preferred_col = buf.point.col
    ensure_row_visible(world, buf.point.row)
    emit_help_status(world, "Link -> " ++ chosen.target)#
}

private fn find_link_at_point(buf: Buffer, is_info_buf: bool, nodes: List) -> ?HelpLink {
    let r = buf.point.row
    if (not (is_info_buf and r == 0)) and is_help_row_in_fence(buf, r) {
        return null
    }
    let (nset, mset) = build_known_doc_sets(nodes)
    let row_links = scan_links_on_line(buf.line_at(r), r, is_info_buf and r == 0, nset, mset)
    if row_links.is_empty() {
        return null
    }
    let c = buf.point.col
    for i in 0..row_links.len() {
        let lk = row_links.get(i.as(usize)).as(HelpLink)
        if c >= lk.start_col and c <= lk.end_col {
            return lk
        }
    }
    row_links.get(0).as(HelpLink)
}

-- ============================================================================
-- 7. Emacs Info Hypertext Manual Reader (`*Info*`, `major_mode = "info"`)
-- ============================================================================

private fn find_node_index(nodes: List, node_id: String) -> i64 {
    let low = node_id.to_lower()
    for i in 0..nodes.len() {
        if nodes.get(i.as(usize)).as(DocNode).node_id == node_id {
            return i
        }
    }
    for i in 0..nodes.len() {
        if nodes.get(i.as(usize)).as(DocNode).node_id.to_lower() == low {
            return i
        }
    }
    -1
}

private fn manual_top_node_id(nodes: List, manual_name: String) -> String {
    for i in 0..nodes.len() {
        let nd = nodes.get(i.as(usize)).as(DocNode)
        if nd.manual == manual_name {
            return nd.node_id
        }
    }
    INFO_DIR_NODE
}

private fn compute_info_neighbors(nodes: List, idx: i64) -> (String, String, String) {
    let nd = nodes.get(idx.as(usize)).as(DocNode)
    let next_id = if idx + 1 < nodes.len() {
        nodes.get((idx + 1).as(usize)).as(DocNode).node_id
    } else {
        "(none)"
    }
    let prev_id = if idx > 0 {
        nodes.get((idx - 1).as(usize)).as(DocNode).node_id
    } else {
        INFO_DIR_NODE
    }
    var up_id = INFO_DIR_NODE
    var k = idx - 1
    while k >= 0 {
        let cand = nodes.get(k.as(usize)).as(DocNode)
        if cand.manual != nd.manual {
            break
        }
        if cand.level < nd.level {
            up_id = cand.node_id
            break
        }
        k -= 1
    }
    if up_id == INFO_DIR_NODE {
        let top_id = manual_top_node_id(nodes, nd.manual)
        if top_id != nd.node_id {
            up_id = top_id
        }
    }
    (next_id, prev_id, up_id)
}

private fn collect_node_children(nodes: List, idx: i64) -> List {
    let out = List()
    if idx < 0 or idx >= nodes.len() {
        return out
    }
    let parent = nodes.get(idx.as(usize)).as(DocNode)
    var min_child_lvl: i64 = 99
    var k = idx + 1
    while k < nodes.len() {
        let cand = nodes.get(k.as(usize)).as(DocNode)
        if cand.manual != parent.manual or cand.level <= parent.level {
            break
        }
        if cand.level < min_child_lvl {
            min_child_lvl = cand.level
        }
        k += 1
    }
    if min_child_lvl == 99 {
        return out
    }
    var j = idx + 1
    while j < nodes.len() {
        let cand = nodes.get(j.as(usize)).as(DocNode)
        if cand.manual != parent.manual or cand.level <= parent.level {
            break
        }
        if cand.level == min_child_lvl {
            out.push(cand)
        }
        j += 1
    }
    out
}

private fn collect_manual_roots(nodes: List) -> List {
    let seen = Set.new()
    let out = List()
    for i in 0..nodes.len() {
        let nd = nodes.get(i.as(usize)).as(DocNode)
        if not seen.contains(nd.manual) {
            seen.insert(nd.manual)
            out.push(nd)
        }
    }
    out
}

private fn render_info_dir_lines(nodes: List) -> List {
    let first_next = if nodes.is_empty() {
        "(none)"
    } else {
        nodes.get(0).as(DocNode).node_id
    }
    let lines = List()
    lines.push(
        "File: dir,  Node: Top [(dir)Top],  Next: " ++ first_next ++ ",  Prev: (none),  Up: (none)"
    )
    lines.push("========================================================================")
    lines.push("Lava Hypertext Info Manual Directory  (Emacs Info + Nessa & Lava Manuals)")
    lines.push("")
    lines.push("  Navigation:  RET follow link   TAB / S-TAB next/prev link   q quit Info")
    lines.push("               n / p next/prev   u up   t manual top   d (dir)Top")
    lines.push("               l / r history     g goto node   m menu   i index   s search")
    lines.push("")
    lines.push("* Menu:")
    lines.push("")

    let roots = collect_manual_roots(nodes)
    let lava_roots = List()
    let nessa_roots = List()
    for i in 0..roots.len() {
        let nd = roots.get(i.as(usize)).as(DocNode)
        if nd.manual.starts_with("nessa:") {
            nessa_roots.push(nd)
        } else {
            lava_roots.push(nd)
        }
    }

    lines.push("--- Lava System & Editor Manuals ---")
    if lava_roots.is_empty() {
        lines.push("  (no Lava manuals indexed in current doc_roots)")
    } else {
        for i in 0..lava_roots.len() {
            let nd = lava_roots.get(i.as(usize)).as(DocNode)
            let desc = if nd.summary != "" { " — " ++ nd.summary } else { "" }
            lines.push("* [" ++ nd.node_id ++ "]  " ++ nd.title ++ desc)
        }
    }

    lines.push("")
    lines.push("--- Nessa Language & Standard Library Manuals ---")
    if nessa_roots.is_empty() {
        lines.push("  (no Nessa manuals indexed in current doc_roots)")
    } else {
        for i in 0..nessa_roots.len() {
            let nd = nessa_roots.get(i.as(usize)).as(DocNode)
            let desc = if nd.summary != "" { " — " ++ nd.summary } else { "" }
            lines.push("* [" ++ nd.node_id ++ "]  " ++ nd.title ++ desc)
        }
    }

    lines.push("")
    lines.push("--- Interactive Introspection & Global Search ---")
    lines.push("* [Command: apropos-documentation]  Global Documentation Apropos (C-h d / :AproposDocs)")
    lines.push("* [Command: help-for-help]          Emacs C-h & Evil :help Cheat-Sheet (C-h ? / <F1>)")
    lines
}

private fn render_info_node_lines(nodes: List, idx: i64, focus_file_row: i64) -> (List, i64) {
    let nd = nodes.get(idx.as(usize)).as(DocNode)
    let (next_id, prev_id, up_id) = compute_info_neighbors(nodes, idx)
    let lines = List()
    lines.push(
        "File: " ++ nd.manual
        ++ ",  Node: " ++ nd.title ++ " [" ++ nd.node_id ++ "]"
        ++ ",  Next: " ++ next_id
        ++ ",  Prev: " ++ prev_id
        ++ ",  Up: " ++ up_id
    )
    lines.push("========================================================================")
    if not nd.tags.is_empty() {
        let formatted_tags = List()
        for i in 0..nd.tags.len() {
            formatted_tags.push("*" ++ nd.tags.get(i.as(usize)).as(String) ++ "*")
        }
        lines.push("Tags: " ++ formatted_tags.join("  "))
    }
    lines.push("")

    let body_start_buf_row = lines.len()
    var target_buf_row: i64 = 0
    if fs.exists(nd.file_path) {
        let open_res = File.open(nd.file_path, mode = OpenMode.read)
        open_res match {
            f! => {
                defer { let _ = f.close() }
                let sr = if nd.start_row < 0 { 0 } else { nd.start_row }
                let er = nd.end_row
                var r: i64 = 0
                var last_pushed_r: i64 = -1
                for line in f.lines() {
                    if r > er {
                        break
                    }
                    if r >= sr {
                        lines.push(line)
                        last_pushed_r = r
                    }
                    r += 1
                }
                if last_pushed_r >= sr and focus_file_row >= sr and focus_file_row <= last_pushed_r {
                    target_buf_row = body_start_buf_row + (focus_file_row - sr)
                }
            },
            error _ => {
                lines.push("(Unable to read manual file: " ++ nd.file_path ++ ")")
            },
        }
    }

    let children = collect_node_children(nodes, idx)
    if not children.is_empty() {
        lines.push("")
        lines.push("------------------------------------------------------------------------")
        lines.push("* Menu:")
        lines.push("")
        for ci in 0..children.len() {
            let ch = children.get(ci.as(usize)).as(DocNode)
            let desc = if ch.summary != "" { " — " ++ ch.summary } else { "" }
            lines.push("* [" ++ ch.node_id ++ "]  " ++ ch.title ++ desc)
        }
    }

    lines.push("")
    lines.push("------------------------------------------------------------------------")
    lines.push(
        "[Source: " ++ nd.file_path ++ ":" ++ (nd.start_row + 1).to_string() ++ "]"
        ++ "  |  [Up: " ++ up_id ++ "]  |  [Dir: (dir)Top]"
    )
    (lines, target_buf_row)
}

private fn save_current_info_cursor_in_history(world: EditorWorld, state: HelpState) {
    let cur = world.active_buffer()
    if cur.name == INFO_BUF_NAME and state.info_history_idx >= 0 and state.info_history_idx < state.info_history.len() {
        let prev_item = state.info_history.get(state.info_history_idx.as(usize)).as(InfoHistoryItem)
        state.info_history.set(
            state.info_history_idx.as(usize),
            InfoHistoryItem {
                node_id: prev_item.node_id,
                cursor_row: cur.point.row,
            },
        )
    }
}

pub fn open_info_node(
    kernel: SystemKernel,
    world: EditorWorld,
    node_id: String,
    .push_history: bool = true,
    .focus_file_row: i64 = -1,
    .override_cursor_row: i64 = -1,
) -> #status_emit bool {
    let state_opt = kernel.service(SERVICE_HELP_STATE)
    let state = if state_opt != null {
        state_opt.as(HelpState)
    } else {
        let fresh = HelpState.new()
        kernel.publish_service(SERVICE_HELP_STATE, ext_help_id(), fresh)
        fresh
    }

    remember_origin_buffer(world, state)
    save_current_info_cursor_in_history(world, state)

    let doc_roots = resolve_doc_roots(world, state = state)
    let nodes = accel_index_docs(doc_roots)

    let trimmed = node_id.trim()
    let is_dir = trimmed == "" or trimmed == INFO_DIR_NODE or trimmed.to_lower() == "dir" or trimmed == "(dir)"
    var canonical_id = INFO_DIR_NODE
    var rendered_lines = List()
    var initial_row: i64 = 0

    if is_dir {
        rendered_lines = render_info_dir_lines(nodes)
    } else {
        var idx = find_node_index(nodes, trimmed)
        if idx < 0 {
            -- Try matching manual name directly
            let low = trimmed.to_lower()
            for i in 0..nodes.len() {
                let nd = nodes.get(i.as(usize)).as(DocNode)
                if nd.manual.to_lower() == low or nd.manual.to_lower().ends_with(":" ++ low) or nd.manual.to_lower().ends_with("/" ++ low) {
                    idx = i
                    break
                }
            }
        }
        if idx < 0 {
            emit_help_status(world, "Info node not found: " ++ trimmed)#
            return false
        }
        canonical_id = nodes.get(idx.as(usize)).as(DocNode).node_id
        let (ls, target_r) = render_info_node_lines(nodes, idx, focus_file_row)
        rendered_lines = ls
        initial_row = target_r
    }

    if override_cursor_row >= 0 {
        initial_row = override_cursor_row
    }

    state.current_info_node = canonical_id
    if push_history {
        while state.info_history.len() > state.info_history_idx + 1 {
            let _ = state.info_history.pop()
        }
        state.info_history.push(InfoHistoryItem {
            node_id: canonical_id,
            cursor_row: initial_row,
        })
        state.info_history_idx = state.info_history.len() - 1
    }

    let _ = activate_special_buffer(
        kernel,
        world,
        INFO_BUF_NAME,
        "info",
        rendered_lines,
        Pos.new(initial_row, 0),
    )
    emit_help_status(world, "Info: " ++ canonical_id)#
    true
}

private fn find_tag_row_in_node(nd: DocNode, tag: String) -> i64 {
    if not fs.exists(nd.file_path) {
        return nd.start_row
    }
    let f! = File.open(nd.file_path, mode = OpenMode.read) else {
        return nd.start_row
    }
    defer { let _ = f.close() }
    let sr = if nd.start_row < 0 { 0 } else { nd.start_row }
    let er = nd.end_row
    let star_needle = "*" ++ tag.to_lower() ++ "*"
    var r: i64 = 0
    for line in f.lines() {
        if r > er {
            break
        }
        if r >= sr and line.to_lower().contains(star_needle) {
            return r
        }
        r += 1
    }
    nd.start_row
}

private fn resolve_and_open_info_topic(
    kernel: SystemKernel,
    world: EditorWorld,
    state: HelpState,
    raw_topic: String,
) -> #status_emit bool {
    let topic = raw_topic.trim().trim_matches("*")
    if topic == "" or topic == INFO_DIR_NODE or topic.to_lower() == "dir" or topic == "(dir)" or topic.to_lower() == "top" {
        return open_info_node(kernel, world, INFO_DIR_NODE)#
    }
    let doc_roots = resolve_doc_roots(world, state = state)
    let nodes = accel_index_docs(doc_roots)

    -- 1. Exact node_id
    let exact_idx = find_node_index(nodes, topic)
    if exact_idx >= 0 {
        return open_info_node(kernel, world, nodes.get(exact_idx.as(usize)).as(DocNode).node_id)#
    }

    -- 2. Exact tag match
    let low = topic.to_lower()
    for i in 0..nodes.len() {
        let nd = nodes.get(i.as(usize)).as(DocNode)
        for ti in 0..nd.tags.len() {
            let tg = nd.tags.get(ti.as(usize)).as(String)
            if tg.to_lower() == low {
                let tag_row = find_tag_row_in_node(nd, tg)
                return open_info_node(kernel, world, nd.node_id, focus_file_row = tag_row)#
            }
        }
    }

    -- 3. Manual stem match
    for i in 0..nodes.len() {
        let nd = nodes.get(i.as(usize)).as(DocNode)
        let m_low = nd.manual.to_lower()
        if m_low == low or m_low.ends_with(":" ++ low) or m_low.ends_with("/" ++ low) {
            return open_info_node(kernel, world, nd.node_id)#
        }
    }

    -- 4. Full-text search fallback
    let hits = accel_search_docs(doc_roots, topic, limit = 5)
    if not hits.is_empty() {
        let top = hits.get(0).as(DocSearchHit)
        return open_info_node(kernel, world, top.node_id, focus_file_row = top.row)#
    }

    emit_help_status(world, "No Info manual or section matching: " ++ raw_topic)#
    false
}

-- ============================================================================
-- 8. Emacs Helpful Deep Introspection (`*Help*`, `major_mode = "help"`)
-- ============================================================================

private fn save_current_help_cursor_in_history(world: EditorWorld, state: HelpState) {
    let cur = world.active_buffer()
    if cur.name == HELP_BUF_NAME and state.help_history_idx >= 0 and state.help_history_idx < state.help_history.len() {
        let prev = state.help_history.get(state.help_history_idx.as(usize)).as(HelpPageSpec)
        state.help_history.set(
            state.help_history_idx.as(usize),
            HelpPageSpec {
                page_kind: prev.page_kind,
                target: prev.target,
                source_file: prev.source_file,
                source_row: prev.source_row,
                cursor_row: cur.point.row,
            },
        )
    }
}

private fn render_help_page_lines(
    kernel: SystemKernel,
    world: EditorWorld,
    state: HelpState,
    spec: HelpPageSpec,
) -> (List, HelpPageSpec) {
    if spec.page_kind == "command" {
        return build_describe_command_lines(kernel, world, state, spec.target, spec.cursor_row)
    }
    if spec.page_kind == "variable" {
        return build_describe_variable_lines(world, state, spec.target, spec.cursor_row)
    }
    if spec.page_kind == "symbol" {
        return build_describe_symbol_lines(world, state, spec.target, spec.source_file, spec.source_row, spec.cursor_row)
    }
    if spec.page_kind == "extension" {
        return build_describe_extension_lines(kernel, world, state, spec.target, spec.cursor_row)
    }
    if spec.page_kind == "mode" {
        return build_describe_mode_lines(kernel, world, spec.target, spec.cursor_row)
    }
    (build_help_for_help_lines(world, state), spec)
}

private fn present_help_page(
    kernel: SystemKernel,
    world: EditorWorld,
    state: HelpState,
    spec: HelpPageSpec,
    push_history: bool,
) -> #status_emit Unit {
    remember_origin_buffer(world, state)
    save_current_help_cursor_in_history(world, state)

    let (lines, resolved_spec) = render_help_page_lines(kernel, world, state, spec)
    state.current_help_page = resolved_spec

    if push_history {
        while state.help_history.len() > state.help_history_idx + 1 {
            let _ = state.help_history.pop()
        }
        state.help_history.push(resolved_spec)
        state.help_history_idx = state.help_history.len() - 1
    } else if state.help_history_idx >= 0 and state.help_history_idx < state.help_history.len() {
        state.help_history.set(state.help_history_idx.as(usize), resolved_spec)
    }

    let _ = activate_special_buffer(
        kernel,
        world,
        HELP_BUF_NAME,
        "help",
        lines,
        Pos.new(resolved_spec.cursor_row, 0),
    )
    emit_help_status(world, "Help: " ++ resolved_spec.target)#
}

private fn build_describe_command_lines(
    kernel: SystemKernel,
    world: EditorWorld,
    state: HelpState,
    cmd_name: String,
    cursor_row: i64,
) -> (List, HelpPageSpec) {
    let lines = List()
    let spec_opt = kernel.get_command(cmd_name)
    if spec_opt == null {
        lines.push("Unknown command: " ++ cmd_name)
        return (lines, HelpPageSpec {
            page_kind: "command",
            target: cmd_name,
            source_file: "",
            source_row: -1,
            cursor_row: 0,
        })
    }
    let cspec = spec_opt.as(CommandSpec)
    let kind_label = if cspec.interactive { "an interactive command" } else { "an internal command" }
    lines.push(cspec.name ++ " is " ++ kind_label ++ " defined in `" ++ cspec.owner.raw() ++ "`.")
    lines.push("========================================================================")
    lines.push("")
    lines.push("Command:        " ++ cspec.name)
    lines.push("Owner:          [Extension: " ++ cspec.owner.raw() ++ "]")
    lines.push("Interactive:    " ++ cspec.interactive.to_string())
    if cspec.name.starts_with("ex:") {
        lines.push("Ex Invocation:  :" ++ cspec.name.drop(3))
    } else {
        lines.push("Ex Invocation:  :" ++ cspec.name ++ "   (or `M-x " ++ cspec.name ++ "`)")
    }
    lines.push("")
    lines.push("Documentation:")
    lines.push("  " ++ cspec.summary)

    -- Check if any manual node documents this command via tag or title
    let doc_roots = resolve_doc_roots(world, state = state)
    let doc_hits = accel_search_docs(doc_roots, cspec.name, limit = 3)
    if not doc_hits.is_empty() {
        lines.push("")
        lines.push("Manual References:")
        for di in 0..doc_hits.len() {
            let dh = doc_hits.get(di.as(usize)).as(DocSearchHit)
            lines.push("  * [Info: " ++ dh.node_id ++ "]  " ++ dh.title ++ " (" ++ dh.manual ++ ")")
        }
    }

    lines.push("")
    lines.push("Keybindings Across All Keymaps:")
    let bindings = collect_bindings_for_command(kernel, cspec.name)
    if bindings.is_empty() {
        lines.push("  (unbound — invoke via `M-x " ++ cspec.name ++ "` or `:" ++ cspec.name ++ "`)")
    } else {
        for bi in 0..bindings.len() {
            let (kname, entry) = bindings.get(bi.as(usize)).as((String, KeyBindingEntry))
            let desc_suffix = if entry.description != "" { " — " ++ entry.description } else { "" }
            lines.push(
                "  " ++ pad_right(pretty_chord_string(entry.chord), 22)
                ++ " in [" ++ kname ++ "]" ++ desc_suffix
            )
        }
    }

    var src_file = ""
    var src_row: i64 = -1
    let src_opt = find_command_source(world, state, cspec.name, cspec.owner)
    lines.push("")
    lines.push("Source Definition:")
    if src_opt != null {
        let sh = src_opt.as(SymbolDefHit)
        src_file = sh.file_path
        src_row = sh.row
        lines.push("  [Source: " ++ sh.file_path ++ ":" ++ (sh.row + 1).to_string() ++ "]")
        if sh.doc_comment != "" {
            let dlines = sh.doc_comment.split("\n")
            for di in 0..dlines.len() {
                lines.push("  -- " ++ dlines.get(di.as(usize)).as(String))
            }
        }
        lines.push("  ----------------------------------------------------------------------")
        let snippet = read_source_snippet_lines(sh.file_path, sh.row, 10)
        for si in 0..snippet.len() {
            lines.push(snippet.get(si.as(usize)).as(String))
        }
    } else {
        lines.push("  (runtime-registered command; no static source file found in code_roots)")
    }

    lines.push("")
    lines.push("------------------------------------------------------------------------")
    lines.push("[Keys: RET follow link | s / gd jump to source | i Info | l/r back/fwd | q quit]")

    (lines, HelpPageSpec {
        page_kind: "command",
        target: cspec.name,
        source_file: src_file,
        source_row: src_row,
        cursor_row: cursor_row,
    })
}

private fn build_describe_symbol_lines(
    world: EditorWorld,
    state: HelpState,
    sym_name: String,
    hint_file: String,
    hint_row: i64,
    cursor_row: i64,
) -> (List, HelpPageSpec) {
    let code_roots = resolve_code_roots(world, state = state)
    let hits = accel_find_symbol_defs(code_roots, sym_name, limit = 20)
    var chosen_opt: ?SymbolDefHit = null
    for i in 0..hits.len() {
        let h = hits.get(i.as(usize)).as(SymbolDefHit)
        if hint_file != "" and h.file_path == hint_file and (hint_row < 0 or h.row == hint_row) {
            chosen_opt = h
            break
        }
    }
    if chosen_opt == null {
        for i in 0..hits.len() {
            let h = hits.get(i.as(usize)).as(SymbolDefHit)
            if h.symbol == sym_name {
                chosen_opt = h
                break
            }
        }
    }
    if chosen_opt == null and (not hits.is_empty()) {
        chosen_opt = hits.get(0).as(SymbolDefHit)
    }

    let lines = List()
    if chosen_opt == null {
        lines.push("Symbol not found: " ++ sym_name)
        return (lines, HelpPageSpec {
            page_kind: "symbol",
            target: sym_name,
            source_file: hint_file,
            source_row: hint_row,
            cursor_row: 0,
        })
    }

    let hit = chosen_opt.as(SymbolDefHit)
    lines.push(hit.symbol ++ " is a Nessa `" ++ hit.kind ++ "` definition.")
    lines.push("========================================================================")
    lines.push("")
    lines.push("Symbol:     " ++ hit.symbol)
    lines.push("Kind:       " ++ hit.kind)
    lines.push("Signature:  " ++ hit.signature)
    lines.push("Location:   [Source: " ++ hit.file_path ++ ":" ++ (hit.row + 1).to_string() ++ "]")
    if hit.doc_comment != "" {
        lines.push("")
        lines.push("Documentation:")
        let dlines = hit.doc_comment.split("\n")
        for di in 0..dlines.len() {
            lines.push("  " ++ dlines.get(di.as(usize)).as(String))
        }
    }
    lines.push("")
    lines.push("Source Preview (10 lines):")
    lines.push("  ----------------------------------------------------------------------")
    let snippet = read_source_snippet_lines(hit.file_path, hit.row, 10)
    for si in 0..snippet.len() {
        lines.push(snippet.get(si.as(usize)).as(String))
    }
    lines.push("")
    lines.push("------------------------------------------------------------------------")
    lines.push("[Keys: s / gd jump to source | RET follow link | i Info | l/r back/fwd | q quit]")

    (lines, HelpPageSpec {
        page_kind: "symbol",
        target: hit.symbol,
        source_file: hit.file_path,
        source_row: hit.row,
        cursor_row: cursor_row,
    })
}

private fn build_describe_variable_lines(
    world: EditorWorld,
    state: HelpState,
    opt_name: String,
    cursor_row: i64,
) -> (List, HelpPageSpec) {
    let lines = List()
    let meta_opt = find_option_meta(opt_name)
    if meta_opt == null {
        lines.push("Unknown EditorOptions variable: " ++ opt_name)
        return (lines, HelpPageSpec {
            page_kind: "variable",
            target: opt_name,
            source_file: "",
            source_row: -1,
            cursor_row: 0,
        })
    }
    let meta = meta_opt.as(OptionMeta)
    let defaults = EditorOptions.defaults()
    let cur_val = get_option_value_str(world.options, meta.name)
    let def_val = get_option_value_str(defaults, meta.name)
    let customized = if cur_val != def_val { "yes (customized)" } else { "no (at default)" }

    lines.push(meta.name ++ " is a customizable `EditorOptions` variable (`" ++ meta.val_type ++ "`).")
    lines.push("========================================================================")
    lines.push("")
    lines.push("Variable:       " ++ meta.name ++ (if meta.short_alias != "" { "  (short alias: `" ++ meta.short_alias ++ "`)" } else { "" }))
    lines.push("Type:           " ++ meta.val_type)
    lines.push("Current Value:  " ++ cur_val)
    lines.push("Default Value:  " ++ def_val)
    lines.push("Customized:     " ++ customized)
    lines.push(":set Usage:     " ++ meta.set_example)
    lines.push("")
    lines.push("Interactive Action:")
    lines.push("  [Press 'e' to change/toggle value]")
    lines.push("")
    lines.push("Documentation:")
    lines.push("  " ++ meta.summary_en)
    lines.push("  " ++ meta.summary_zh)

    var src_file = ""
    var src_row: i64 = -1
    let code_roots = resolve_code_roots(world, state = state)
    let def_hits = accel_find_symbol_defs(code_roots, "EditorOptions", limit = 5)
    if not def_hits.is_empty() {
        let dh = def_hits.get(0).as(SymbolDefHit)
        src_file = dh.file_path
        src_row = dh.row
        lines.push("")
        lines.push("Defined In:")
        lines.push("  [Source: " ++ dh.file_path ++ ":" ++ (dh.row + 1).to_string() ++ "]")
    }

    lines.push("")
    lines.push("------------------------------------------------------------------------")
    lines.push("[Keys: e change/toggle value | s jump to EditorOptions | i Info | l/r back/fwd | q quit]")

    (lines, HelpPageSpec {
        page_kind: "variable",
        target: meta.name,
        source_file: src_file,
        source_row: src_row,
        cursor_row: cursor_row,
    })
}

private fn build_describe_extension_lines(
    kernel: SystemKernel,
    world: EditorWorld,
    state: HelpState,
    raw_ext_id: String,
    cursor_row: i64,
) -> (List, HelpPageSpec) {
    let target_eid = ExtId(raw_ext_id.trim())
    let lines = List()
    let rec_any_opt = kernel.extensions.get(target_eid)
    if rec_any_opt == null {
        lines.push("Extension not found: " ++ raw_ext_id)
        return (lines, HelpPageSpec {
            page_kind: "extension",
            target: raw_ext_id,
            source_file: "",
            source_row: -1,
            cursor_row: 0,
        })
    }
    let rec = rec_any_opt.as(ExtensionRecord)
    lines.push("Extension `" ++ rec.id.raw() ++ "` v" ++ rec.version ++ " [" ++ rec.state.to_string() ++ "]")
    lines.push("========================================================================")
    lines.push("")
    lines.push("Extension ID:  " ++ rec.id.raw())
    lines.push("Name:          " ++ rec.name)
    lines.push("Domain:        " ++ rec.domain)
    lines.push("State:         " ++ rec.state.to_string())
    lines.push("Description:   " ++ rec.description)

    let deps = List()
    for i in 0..rec.dependencies.len() {
        let did = rec.dependencies.get(i.as(usize)).as(ExtId).raw()
        deps.push("[Extension: " ++ did ++ "]")
    }
    lines.push("Dependencies:  " ++ (if deps.is_empty() { "(none)" } else { deps.join(", ") }))

    lines.push("")
    lines.push("Published Services:")
    let skeys = kernel.services.keys()
    skeys.sort()
    var svc_count: i64 = 0
    for i in 0..skeys.len() {
        let sk = skeys.get(i.as(usize)).as(String)
        let se = kernel.services.get(sk).as(ServiceEntry)
        if se.owner == rec.id {
            svc_count += 1
            lines.push("  * " ++ se.name)
        }
    }
    if svc_count == 0 {
        lines.push("  (none)")
    }

    lines.push("")
    lines.push("Registered Commands:")
    let cmds = kernel.list_commands(interactive_only = false)
    var cmd_count: i64 = 0
    for i in 0..cmds.len() {
        let cs = cmds.get(i.as(usize)).as(CommandSpec)
        if cs.owner == rec.id {
            cmd_count += 1
            lines.push("  * [Command: " ++ cs.name ++ "]  — " ++ cs.summary)
        }
    }
    if cmd_count == 0 {
        lines.push("  (none)")
    }

    var src_file = ""
    var src_row: i64 = 0
    let code_roots = resolve_code_roots(world, state = state)
    let reg_fn = "register_" ++ rec.name.trim_start_matches("ext_") ++ "_extension"
    let sh_list = accel_find_symbol_defs(code_roots, reg_fn, limit = 5)
    if not sh_list.is_empty() {
        let sh = sh_list.get(0).as(SymbolDefHit)
        src_file = sh.file_path
        src_row = sh.row
        lines.push("")
        lines.push("Entry Point:")
        lines.push("  [Source: " ++ sh.file_path ++ ":" ++ (sh.row + 1).to_string() ++ "]")
    }

    lines.push("")
    lines.push("------------------------------------------------------------------------")
    lines.push("[Keys: RET follow link | s jump to source | i Info | l/r back/fwd | q quit]")

    (lines, HelpPageSpec {
        page_kind: "extension",
        target: rec.id.raw(),
        source_file: src_file,
        source_row: src_row,
        cursor_row: cursor_row,
    })
}

private fn build_describe_mode_lines(
    kernel: SystemKernel,
    world: EditorWorld,
    buf_name: String,
    cursor_row: i64,
) -> (List, HelpPageSpec) {
    let target_buf_opt = world.find_buffer_by_name(buf_name)
    let target_buf = if target_buf_opt != null {
        target_buf_opt.as(Buffer)
    } else {
        world.active_buffer()
    }

    let lines = List()
    lines.push(
        "Buffer & Mode Introspection for `" ++ target_buf.name
        ++ "` (major_mode: `" ++ target_buf.major_mode ++ "`)"
    )
    lines.push("========================================================================")
    lines.push("")
    lines.push("Buffer Name:    " ++ target_buf.name)
    lines.push("Major Mode:     " ++ target_buf.major_mode)
    lines.push(
        "Modal State:    " ++ world.mode_name
        ++ (if world.options.evil_mode { " (Evil-Vim modal)" } else { " (Emacs modeless)" })
    )
    lines.push("File Path:      " ++ (if target_buf.file_path != "" { target_buf.file_path } else { "(special / in-memory buffer)" }))
    lines.push(
        "Encoding/Lines: UTF-8 (" ++ (if target_buf.crlf { "CRLF" } else { "LF" }) ++ "), "
        ++ target_buf.line_count().to_string() ++ " lines"
        ++ (if target_buf.read_only { ", [read-only]" } else { "" })
        ++ (if target_buf.modified { ", [modified]" } else { "" })
    )

    let mode_km_name = "mode:" ++ target_buf.major_mode
    lines.push("")
    lines.push("Mode-Local Keybindings (`" ++ mode_km_name ++ "`):")
    lines.push("------------------------------------------------------------------------")
    let mkm_opt = kernel.keymaps.get(mode_km_name)
    if mkm_opt == null {
        lines.push("  (no mode-local overrides; uses standard modal/global keymaps)")
    } else {
        let mkm = mkm_opt.as(Keymap)
        let chords = mkm.bindings.keys()
        chords.sort()
        if chords.is_empty() {
            lines.push("  (empty mode keymap)")
        } else {
            for i in 0..chords.len() {
                let ch = chords.get(i.as(usize)).as(String)
                let entry = mkm.bindings.get(ch).as(KeyBindingEntry)
                let desc = if entry.description != "" { " — " ++ entry.description } else { "" }
                lines.push(
                    "  " ++ pad_right(pretty_chord_string(entry.chord), 18)
                    ++ " -> [Command: " ++ entry.command_name ++ "]" ++ desc
                )
            }
        }
    }

    lines.push("")
    lines.push("Essential Global & Leader Shortcuts:")
    lines.push("------------------------------------------------------------------------")
    lines.push("  C-h i / <Space> h i   -> [Command: info]                   (Hypertext Info Reader)")
    lines.push("  C-h d / <Space> h d   -> [Command: apropos-documentation]  (Global Doc Search)")
    lines.push("  C-h f / <Space> h f   -> [Command: describe-function]      (Command + Source Help)")
    lines.push("  C-h v / <Space> h v   -> [Command: describe-variable]      (Options + Live Edit)")
    lines.push("  K / C-h .             -> [Command: helpful-at-point]       (Smart Help at Point)")

    let hook_topics = kernel.hooks.keys()
    hook_topics.sort()
    lines.push("")
    lines.push("Active Kernel Hooks (" ++ hook_topics.len().to_string() ++ " topics):")
    lines.push("------------------------------------------------------------------------")
    for i in 0..hook_topics.len() {
        let topic = hook_topics.get(i.as(usize)).as(String)
        let lst = kernel.hooks.get(topic).as(List)
        lines.push("  " ++ pad_right(topic, 26) ++ " (" ++ lst.len().to_string() ++ " listener(s))")
    }

    let exts = kernel.list_extensions()
    lines.push("")
    lines.push("Loaded Extensions (" ++ exts.len().to_string() ++ "):")
    lines.push("------------------------------------------------------------------------")
    for i in 0..exts.len() {
        let rec = exts.get(i.as(usize)).as(ExtensionRecord)
        lines.push("  * [Extension: " ++ rec.id.raw() ++ "] [" ++ rec.state.to_string() ++ "] — " ++ rec.description)
    }

    lines.push("")
    lines.push("------------------------------------------------------------------------")
    lines.push("[Keys: RET follow link | i Info | l/r back/fwd | q quit]")

    (lines, HelpPageSpec {
        page_kind: "mode",
        target: target_buf.name,
        source_file: target_buf.file_path,
        source_row: 0,
        cursor_row: cursor_row,
    })
}

private fn build_help_for_help_lines(world: EditorWorld, state: HelpState) -> List {
    let lines = List()
    lines.push("Lava Self-Documenting Help System  (`C-h ?`, `<F1>`, `<Space> h ?`, `:help`)")
    lines.push("========================================================================")
    lines.push("You have typed `C-h ?` (or `<F1>`). Select any `[...]` link with RET or press a key:")
    lines.push("")
    lines.push("1. Hypertext Info Manuals & Global Documentation Search:")
    lines.push("------------------------------------------------------------------------")
    lines.push("  C-h i  |  <Space> h i  |  :Info          -> [Info: (dir)Top]  Browse Lava & Nessa Manuals")
    lines.push("  C-h d  |  <Space> h d  |  :AproposDocs   -> [Command: apropos-documentation]  Global 5-Domain Doc Search")
    lines.push("  C-h a  |  <Space> h a                    -> [Command: apropos-command]        Search Commands & Keys")
    lines.push("  C-h o  |  <Space> h o  |  :Apropos       -> [Command: apropos]                Unified Symbol/Tag Apropos")
    lines.push("")
    lines.push("2. Emacs `helpful` Deep Live Runtime & Source Introspection:")
    lines.push("------------------------------------------------------------------------")
    lines.push("  C-h .  |  Normal `K`   |  :h <topic>     -> [Command: helpful-at-point]       Context Help Under Cursor")
    lines.push("  C-h f  |  C-h x        |  <Space> h f    -> [Command: describe-function]      Command Docs + Source Code")
    lines.push("  C-h v  |  <Space> h v                    -> [Command: describe-variable]      29 Options + Live Toggle (`e`)")
    lines.push("  C-h m  |  <Space> h m                    -> [Command: describe-mode]          Major Mode & Local Bindings")
    lines.push("  C-h k  |  <Space> h k                    -> [Command: describe-key]           Full Key Chord Inspector")
    lines.push("  C-h c  |  <Space> h c                    -> [Command: describe-key-briefly]   1-Line Key Summary in Echo")
    lines.push("  C-h w  |  <Space> h w                    -> [Command: where-is]               Show All Keys for Command")
    lines.push("  C-h b  |  <Space> h b                    -> [Command: describe-bindings]      Complete Keymap Reference")
    lines.push("  C-h p  |  <Space> h p                    -> [Command: describe-extensions]    Live Kernel Graph & Services")
    lines.push("  C-h e                                    -> [Command: view-echo-area-messages] Open `*Messages*` Log")

    let doc_roots = resolve_doc_roots(world, state = state)
    let nodes = accel_index_docs(doc_roots)
    let roots = collect_manual_roots(nodes)
    if not roots.is_empty() {
        lines.push("")
        lines.push("3. Indexed Manuals Quick-Jump:")
        lines.push("------------------------------------------------------------------------")
        let cap = if roots.len() > 14 { 14 } else { roots.len() }
        for i in 0..cap {
            let nd = roots.get(i.as(usize)).as(DocNode)
            lines.push("  * [Info: " ++ nd.node_id ++ "]  " ++ nd.title ++ " (" ++ nd.manual ++ ")")
        }
    }

    lines.push("")
    lines.push("------------------------------------------------------------------------")
    lines.push("[Keys: RET open link | TAB/S-TAB next/prev link | i Info | l/r back/fwd | q quit]")
    lines
}

-- ============================================================================
-- 9. Unified Link Follower (shared by `*Info*` and `*Help*`)
-- ============================================================================

private fn resolve_md_relative_link(
    kernel: SystemKernel,
    world: EditorWorld,
    state: HelpState,
    raw_target: String,
) -> #[log_event, status_emit] !String bool {
    let doc_roots = resolve_doc_roots(world, state = state)
    let nodes = accel_index_docs(doc_roots)
    var cur_dir = world.cwd
    if state.current_info_node != "" and state.current_info_node != INFO_DIR_NODE {
        let cur_idx = find_node_index(nodes, state.current_info_node)
        if cur_idx >= 0 {
            let cur_fp = nodes.get(cur_idx.as(usize)).as(DocNode).file_path
            let par_opt = path.parent(cur_fp)
            if par_opt != null {
                cur_dir = par_opt.as(String)
            }
        }
    }

    var path_part = raw_target
    var anchor_part = ""
    let hash_opt = raw_target.split_once("#")
    if hash_opt != null {
        let (p, a) = hash_opt.as((String, String))
        path_part = p
        anchor_part = a
    }

    if path_part == "" and anchor_part != "" {
        -- Anchor inside current manual
        let cur_idx = find_node_index(nodes, state.current_info_node)
        if cur_idx >= 0 {
            let cur_manual = nodes.get(cur_idx.as(usize)).as(DocNode).manual
            let cand_id = cur_manual ++ "#" ++ anchor_part
            if find_node_index(nodes, cand_id) >= 0 {
                return open_info_node(kernel, world, cand_id)#
            }
        }
    }

    let resolved_fp = if path.is_absolute(path_part) {
        path.normalize(path_part)
    } else {
        path.normalize(path.join(cur_dir, path_part))
    }

    for i in 0..nodes.len() {
        let nd = nodes.get(i.as(usize)).as(DocNode)
        if path.normalize(nd.file_path) == resolved_fp {
            if anchor_part == "" or nd.node_id.ends_with("#" ++ anchor_part) {
                return open_info_node(kernel, world, nd.node_id)#
            }
        }
    }
    for i in 0..nodes.len() {
        let nd = nodes.get(i.as(usize)).as(DocNode)
        if path.normalize(nd.file_path) == resolved_fp {
            return open_info_node(kernel, world, nd.node_id)#
        }
    }
    if fs.exists(resolved_fp) and fs.is_file(resolved_fp) {
        let _ = open_file_at_row(kernel, world, resolved_fp, 0)#!
        return true
    }
    false
}

private fn follow_help_link(
    kernel: SystemKernel,
    world: EditorWorld,
    state: HelpState,
    link: HelpLink,
) -> #[log_event, status_emit] !String Unit {
    if link.kind == "source" {
        let (fp, row0) = parse_source_target(link.target)
        let _ = open_file_at_row(kernel, world, fp, row0)#!
        return ()
    }
    if link.kind == "info" {
        let _ = resolve_and_open_info_topic(kernel, world, state, link.target)#
        return ()
    }
    if link.kind == "command" {
        present_help_page(
            kernel,
            world,
            state,
            HelpPageSpec {
                page_kind: "command",
                target: link.target,
                source_file: "",
                source_row: -1,
                cursor_row: 0,
            },
            true,
        )#
        return ()
    }
    if link.kind == "variable" {
        present_help_page(
            kernel,
            world,
            state,
            HelpPageSpec {
                page_kind: "variable",
                target: link.target,
                source_file: "",
                source_row: -1,
                cursor_row: 0,
            },
            true,
        )#
        return ()
    }
    if link.kind == "extension" {
        present_help_page(
            kernel,
            world,
            state,
            HelpPageSpec {
                page_kind: "extension",
                target: link.target,
                source_file: "",
                source_row: -1,
                cursor_row: 0,
            },
            true,
        )#
        return ()
    }
    if link.kind == "symbol" {
        present_help_page(
            kernel,
            world,
            state,
            HelpPageSpec {
                page_kind: "symbol",
                target: link.target,
                source_file: "",
                source_row: -1,
                cursor_row: 0,
            },
            true,
        )#
        return ()
    }
    if link.kind == "md" {
        let ok = resolve_md_relative_link(kernel, world, state, link.target)#!
        if not ok {
            emit_help_status(world, "Link target not found: " ++ link.target)#
        }
        return ()
    }
    ()
}

-- ============================================================================
-- 10. Global Documentation Search — Apropos Suite (`*Apropos*`, `major_mode = "apropos"`)
-- ============================================================================

pub fn run_apropos_report(
    kernel: SystemKernel,
    world: EditorWorld,
    state: HelpState,
    query: String,
    mode_kind: String,
) -> #status_emit Unit {
    remember_origin_buffer(world, state)
    let q_trim = query.trim()
    state.apropos_query = q_trim
    state.apropos_mode_kind = mode_kind
    state.apropos_entries = List()

    let include_docs = mode_kind == "docs" or mode_kind == "all"
    let include_cmds = true
    let include_vars = mode_kind == "docs" or mode_kind == "all"
    let include_exts = mode_kind == "docs" or mode_kind == "all"
    let include_syms = mode_kind == "docs" or mode_kind == "all"

    let doc_roots = resolve_doc_roots(world, state = state)
    let code_roots = resolve_code_roots(world, state = state)

    let doc_hits = if include_docs {
        accel_search_docs(doc_roots, q_trim, limit = 40)
    } else {
        List()
    }

    -- Score Commands
    let cmd_scored = List()
    if include_cmds {
        let chords_map = build_command_chords_map(kernel)
        let all_cmds = kernel.list_commands(interactive_only = false)
        for i in 0..all_cmds.len() {
            let cs = all_cmds.get(i.as(usize)).as(CommandSpec)
            let chords_opt = chords_map.get(cs.name)
            let chords = if chords_opt != null { chords_opt.as(String) } else { "" }
            let sc = orderless_score(
                q_trim,
                cs.name,
                cs.owner.raw() ++ " " ++ chords ++ " " ++ cs.summary,
            )
            if sc >= 0 {
                cmd_scored.push((sc, cs, chords))
            }
        }
        cmd_scored.sort_by(|a: Any, b: Any| {
            let (sa, ca, _) = a.as((i64, CommandSpec, String))
            let (sb, cb, _) = b.as((i64, CommandSpec, String))
            if sa != sb { sb.cmp(sa) } else { ca.name.cmp(cb.name) }
        })
    }

    -- Score EditorOptions Variables (all 29)
    let var_scored = List()
    if include_vars {
        let metas = all_option_metas()
        for i in 0..metas.len() {
            let m = metas.get(i.as(usize)).as(OptionMeta)
            let cur_v = get_option_value_str(world.options, m.name)
            let sc = orderless_score(
                q_trim,
                m.name,
                m.short_alias ++ " " ++ m.val_type ++ " " ++ cur_v ++ " " ++ m.summary_en ++ " " ++ m.summary_zh,
            )
            if sc >= 0 {
                var_scored.push((sc, m, cur_v))
            }
        }
        var_scored.sort_by(|a: Any, b: Any| {
            let (sa, ma, _) = a.as((i64, OptionMeta, String))
            let (sb, mb, _) = b.as((i64, OptionMeta, String))
            if sa != sb { sb.cmp(sa) } else { ma.name.cmp(mb.name) }
        })
    }

    -- Score Extensions, Services & Hooks
    let ext_scored = List()
    if include_exts {
        let exts = kernel.list_extensions()
        let skeys = kernel.services.keys()
        skeys.sort()
        let htopics = kernel.hooks.keys()
        htopics.sort()

        for i in 0..exts.len() {
            let rec = exts.get(i.as(usize)).as(ExtensionRecord)
            let owned_svcs = List()
            for si in 0..skeys.len() {
                let sk = skeys.get(si.as(usize)).as(String)
                let se = kernel.services.get(sk).as(ServiceEntry)
                if se.owner == rec.id {
                    owned_svcs.push(se.name)
                }
            }
            let owned_hooks = List()
            for hi in 0..htopics.len() {
                let ht = htopics.get(hi.as(usize)).as(String)
                let lst = kernel.hooks.get(ht).as(List)
                for li in 0..lst.len() {
                    if lst.get(li.as(usize)).as(HookListener).owner == rec.id {
                        if not owned_hooks.contains(ht) {
                            owned_hooks.push(ht)
                        }
                    }
                }
            }
            let meta_blob = rec.name ++ " " ++ rec.description
                ++ " services:" ++ owned_svcs.join(",")
                ++ " hooks:" ++ owned_hooks.join(",")
            let sc = orderless_score(q_trim, rec.id.raw(), meta_blob)
            if sc >= 0 {
                ext_scored.push((sc, rec, owned_svcs, owned_hooks))
            }
        }
        ext_scored.sort_by(|a: Any, b: Any| {
            let (sa, ra, _, _) = a.as((i64, ExtensionRecord, List, List))
            let (sb, rb, _, _) = b.as((i64, ExtensionRecord, List, List))
            if sa != sb { sb.cmp(sa) } else { ra.id.raw().cmp(rb.id.raw()) }
        })
    }

    -- Score Source Symbols (`.ns` definitions + `--` doc comments)
    let sym_hits = if include_syms {
        search_source_symbols_apropos(code_roots, q_trim, 25)
    } else {
        List()
    }

    let total_hits = doc_hits.len() + cmd_scored.len() + var_scored.len() + ext_scored.len() + sym_hits.len()
    let mode_banner = when {
        mode_kind == "command" => "Emacs Command Apropos (`C-h a`)",
        mode_kind == "all" => "Emacs Unified Symbol & Documentation Apropos (`C-h o`)",
        else => "Emacs Global Documentation Apropos (`C-h d`)",
    }

    let lines = List()
    lines.push(mode_banner ++ " — Query: `" ++ q_trim ++ "` (" ++ total_hits.to_string() ++ " matches)")
    lines.push("========================================================================")
    lines.push("  Keys: [RET] open Info/Help   [s] jump to source   [TAB]/[n] next   [S-TAB]/[p] prev   [g] new search   [q] quit")

    let entries = List()
    var first_entry_row: i64 = 0

    -- 1. Manuals & Info Nodes
    if include_docs and (not doc_hits.is_empty()) {
        lines.push("")
        lines.push("1. Manuals & Info Nodes (" ++ doc_hits.len().to_string() ++ "):")
        lines.push("------------------------------------------------------------------------")
        for i in 0..doc_hits.len() {
            let dh = doc_hits.get(i.as(usize)).as(DocSearchHit)
            let hit_row = lines.len()
            if entries.is_empty() {
                first_entry_row = hit_row
            }
            let tag_badge = if dh.matched_tag != "" { "  *" ++ dh.matched_tag ++ "*" } else { "" }
            lines.push("  [DOC] [" ++ dh.node_id ++ "]  " ++ dh.title ++ tag_badge)
            if dh.snippet != "" {
                lines.push("        " ++ dh.snippet)
            }
            entries.push(AproposHit {
                row: hit_row,
                kind: "doc",
                target_id: dh.node_id,
                file_path: dh.file_path,
                file_row: dh.row,
                title: dh.title,
            })
        }
    }

    -- 2. Interactive Commands & Keybindings
    if include_cmds and (not cmd_scored.is_empty()) {
        let cmd_cap = if cmd_scored.len() > 40 { 40 } else { cmd_scored.len() }
        lines.push("")
        lines.push("2. Interactive Commands & Keybindings (" ++ cmd_cap.to_string() ++ "):")
        lines.push("------------------------------------------------------------------------")
        for i in 0..cmd_cap {
            let (_, cs, chords) = cmd_scored.get(i.as(usize)).as((i64, CommandSpec, String))
            let hit_row = lines.len()
            if entries.is_empty() {
                first_entry_row = hit_row
            }
            let key_info = if chords != "" { "  (" ++ chords ++ ")" } else { "  (M-x " ++ cs.name ++ ")" }
            lines.push("  [CMD] " ++ pad_right(cs.name, 28) ++ key_info ++ "  [" ++ cs.owner.raw() ++ "]")
            lines.push("        " ++ cs.summary)
            entries.push(AproposHit {
                row: hit_row,
                kind: "command",
                target_id: cs.name,
                file_path: "",
                file_row: -1,
                title: cs.name,
            })
        }
    }

    -- 3. Editor Variables / Options
    if include_vars and (not var_scored.is_empty()) {
        lines.push("")
        lines.push("3. Editor Variables / Options (" ++ var_scored.len().to_string() ++ "):")
        lines.push("------------------------------------------------------------------------")
        for i in 0..var_scored.len() {
            let (_, m, cur_v) = var_scored.get(i.as(usize)).as((i64, OptionMeta, String))
            let hit_row = lines.len()
            if entries.is_empty() {
                first_entry_row = hit_row
            }
            lines.push("  [VAR] " ++ pad_right(m.name, 24) ++ " : " ++ pad_right(m.val_type, 7) ++ " = " ++ cur_v)
            lines.push("        " ++ m.summary_en ++ " / " ++ m.summary_zh)
            entries.push(AproposHit {
                row: hit_row,
                kind: "variable",
                target_id: m.name,
                file_path: "",
                file_row: -1,
                title: m.name,
            })
        }
    }

    -- 4. Extensions, Services & Hooks
    if include_exts and (not ext_scored.is_empty()) {
        lines.push("")
        lines.push("4. Extensions, Services & Hooks (" ++ ext_scored.len().to_string() ++ "):")
        lines.push("------------------------------------------------------------------------")
        for i in 0..ext_scored.len() {
            let (_, rec, svcs, hks) = ext_scored.get(i.as(usize)).as((i64, ExtensionRecord, List, List))
            let hit_row = lines.len()
            if entries.is_empty() {
                first_entry_row = hit_row
            }
            lines.push("  [EXT] " ++ rec.id.raw() ++ " [" ++ rec.state.to_string() ++ "]")
            var extra_meta = rec.description
            if not svcs.is_empty() {
                extra_meta = extra_meta ++ " | services: " ++ svcs.join(", ")
            }
            if not hks.is_empty() {
                extra_meta = extra_meta ++ " | hooks: " ++ hks.join(", ")
            }
            lines.push("        " ++ extra_meta)
            entries.push(AproposHit {
                row: hit_row,
                kind: "extension",
                target_id: rec.id.raw(),
                file_path: "",
                file_row: -1,
                title: rec.id.raw(),
            })
        }
    }

    -- 5. Nessa & Lava Source Symbols
    if include_syms and (not sym_hits.is_empty()) {
        lines.push("")
        lines.push("5. Nessa & Lava Source Symbols (" ++ sym_hits.len().to_string() ++ "):")
        lines.push("------------------------------------------------------------------------")
        for i in 0..sym_hits.len() {
            let sh = sym_hits.get(i.as(usize)).as(SymbolDefHit)
            let hit_row = lines.len()
            if entries.is_empty() {
                first_entry_row = hit_row
            }
            let base_opt = path.file_name(sh.file_path)
            let short_f = if base_opt != null { base_opt.as(String) } else { sh.file_path }
            lines.push(
                "  [SYM] " ++ pad_right(sh.symbol, 26)
                ++ " (" ++ sh.kind ++ ")  " ++ short_f ++ ":" ++ (sh.row + 1).to_string()
            )
            let detail_txt = if sh.doc_comment != "" {
                sh.doc_comment.split("\n").get(0).as(String)
            } else {
                sh.signature
            }
            lines.push("        " ++ detail_txt)
            entries.push(AproposHit {
                row: hit_row,
                kind: "symbol",
                target_id: sh.symbol,
                file_path: sh.file_path,
                file_row: sh.row,
                title: sh.symbol,
            })
        }
    }

    if entries.is_empty() {
        lines.push("")
        lines.push("  (No matches found across manuals, commands, options, extensions, or symbols.)")
    }

    state.apropos_entries = entries
    let _ = activate_special_buffer(
        kernel,
        world,
        APROPOS_BUF_NAME,
        "apropos",
        lines,
        Pos.new(first_entry_row, 0),
    )
    emit_help_status(
        world,
        "Apropos `" ++ q_trim ++ "`: " ++ entries.len().to_string() ++ " matches",
    )#
}

private fn find_apropos_hit_near_row(state: HelpState, cursor_row: i64) -> ?AproposHit {
    if state.apropos_entries.is_empty() {
        return null
    }
    -- Exact row match or indented description row immediately below headline
    for i in 0..state.apropos_entries.len() {
        let h = state.apropos_entries.get(i.as(usize)).as(AproposHit)
        if h.row == cursor_row or h.row + 1 == cursor_row {
            return h
        }
    }
    -- Nearest preceding entry if below first entry
    var best_opt: ?AproposHit = null
    for i in 0..state.apropos_entries.len() {
        let h = state.apropos_entries.get(i.as(usize)).as(AproposHit)
        if h.row <= cursor_row {
            best_opt = h
        }
    }
    best_opt
}

-- ============================================================================
-- 11. Smart Topic & Point Identifier Resolution (`helpful-at-point`, `:h`, `K`)
-- ============================================================================

private fn is_help_token_char(ch: String) -> bool {
    ch.is_alphanumeric() or ch == "-" or ch == "_" or ch == "." or ch == ":" or ch == "*" or ch == "/"
}

private fn extract_help_token_at_point(buf: Buffer) -> String {
    let line = buf.line_at(buf.point.row)
    let n = line.char_len()
    if n == 0 {
        return ""
    }
    var col = if buf.point.col >= n { n - 1 } else { buf.point.col }
    if col < 0 {
        return ""
    }
    if not is_help_token_char(line.slice(col, col + 1)) {
        return ""
    }
    var start_c = col
    while start_c > 0 and is_help_token_char(line.slice(start_c - 1, start_c)) {
        start_c -= 1
    }
    var end_c = col + 1
    while end_c < n and is_help_token_char(line.slice(end_c, end_c + 1)) {
        end_c += 1
    }
    line.slice(start_c, end_c)
}

private fn resolve_help_topic(
    kernel: SystemKernel,
    world: EditorWorld,
    state: HelpState,
    raw_topic: String,
    prefer_docs_first: bool,
) -> #status_emit Unit {
    let trimmed = raw_topic.trim()
    if trimmed == "" {
        present_help_page(
            kernel,
            world,
            state,
            HelpPageSpec {
                page_kind: "overview",
                target: "help-for-help",
                source_file: "",
                source_row: -1,
                cursor_row: 0,
            },
            true,
        )#
        return
    }

    if trimmed.starts_with("?") and trimmed.char_len() > 1 {
        run_apropos_report(kernel, world, state, trimmed.drop(1).trim(), "docs")#
        return
    }

    let was_star_wrapped = trimmed.starts_with("*") and trimmed.ends_with("*") and trimmed.char_len() >= 3
    let clean = trimmed.trim_matches("*").trim_matches("`").trim_matches("\"").trim_matches("'")
    if clean == "" {
        present_help_page(
            kernel,
            world,
            state,
            HelpPageSpec {
                page_kind: "overview",
                target: "help-for-help",
                source_file: "",
                source_row: -1,
                cursor_row: 0,
            },
            true,
        )#
        return
    }

    let doc_roots = resolve_doc_roots(world, state = state)
    let code_roots = resolve_code_roots(world, state = state)
    let nodes = accel_index_docs(doc_roots)
    let clean_low = clean.to_lower()

    -- Helper checks
    if prefer_docs_first or was_star_wrapped {
        -- 1a. Exact node_id
        let nidx = find_node_index(nodes, clean)
        if nidx >= 0 {
            let _ = open_info_node(kernel, world, nodes.get(nidx.as(usize)).as(DocNode).node_id)#
            return
        }
        -- 1b. Exact `*help-tag*`
        for i in 0..nodes.len() {
            let nd = nodes.get(i.as(usize)).as(DocNode)
            for ti in 0..nd.tags.len() {
                let tg = nd.tags.get(ti.as(usize)).as(String)
                if tg.to_lower() == clean_low {
                    let trow = find_tag_row_in_node(nd, tg)
                    let _ = open_info_node(kernel, world, nd.node_id, focus_file_row = trow)#
                    return
                }
            }
        }
        -- 1c. Exact manual stem
        for i in 0..nodes.len() {
            let nd = nodes.get(i.as(usize)).as(DocNode)
            let ml = nd.manual.to_lower()
            if ml == clean_low or ml.ends_with(":" ++ clean_low) or ml.ends_with("/" ++ clean_low) {
                let _ = open_info_node(kernel, world, nd.node_id)#
                return
            }
        }
    }

    -- 2. Exact registered command
    if kernel.get_command(clean) != null {
        present_help_page(
            kernel,
            world,
            state,
            HelpPageSpec {
                page_kind: "command",
                target: clean,
                source_file: "",
                source_row: -1,
                cursor_row: 0,
            },
            true,
        )#
        return
    }

    -- 3. Exact EditorOptions variable
    let opt_meta = find_option_meta(clean)
    if opt_meta != null {
        present_help_page(
            kernel,
            world,
            state,
            HelpPageSpec {
                page_kind: "variable",
                target: opt_meta.as(OptionMeta).name,
                source_file: "",
                source_row: -1,
                cursor_row: 0,
            },
            true,
        )#
        return
    }

    -- 4. Exact `*help-tag*` or `node_id` (when `prefer_docs_first == false`)
    if not prefer_docs_first {
        let nidx = find_node_index(nodes, clean)
        if nidx >= 0 {
            let _ = open_info_node(kernel, world, nodes.get(nidx.as(usize)).as(DocNode).node_id)#
            return
        }
        for i in 0..nodes.len() {
            let nd = nodes.get(i.as(usize)).as(DocNode)
            for ti in 0..nd.tags.len() {
                let tg = nd.tags.get(ti.as(usize)).as(String)
                if tg.to_lower() == clean_low {
                    let trow = find_tag_row_in_node(nd, tg)
                    let _ = open_info_node(kernel, world, nd.node_id, focus_file_row = trow)#
                    return
                }
            }
        }
    }

    -- 5. Exact Nessa/Lava symbol definition in `code_roots`
    let sym_hits = accel_find_symbol_defs(code_roots, clean, limit = 15)
    for i in 0..sym_hits.len() {
        let sh = sym_hits.get(i.as(usize)).as(SymbolDefHit)
        if sh.symbol == clean and sh.kind != "command" {
            present_help_page(
                kernel,
                world,
                state,
                HelpPageSpec {
                    page_kind: "symbol",
                    target: sh.symbol,
                    source_file: sh.file_path,
                    source_row: sh.row,
                    cursor_row: 0,
                },
                true,
            )#
            return
        }
    }

    -- 6. Full-text manual search via `accel_search_docs`
    let doc_hits = accel_search_docs(doc_roots, clean, limit = 10)
    if not doc_hits.is_empty() {
        let top = doc_hits.get(0).as(DocSearchHit)
        let _ = open_info_node(kernel, world, top.node_id, focus_file_row = top.row)#
        return
    }

    -- 7. Fuzzy symbol fallback
    if not sym_hits.is_empty() {
        let sh = sym_hits.get(0).as(SymbolDefHit)
        present_help_page(
            kernel,
            world,
            state,
            HelpPageSpec {
                page_kind: "symbol",
                target: sh.symbol,
                source_file: sh.file_path,
                source_row: sh.row,
                cursor_row: 0,
            },
            true,
        )#
        return
    }

    emit_help_status(world, "No help topic, command, option, or symbol found for: " ++ clean)#
}

-- ============================================================================
-- 12. Command Implementations
-- ============================================================================

-- 12.1 Info Reader Commands
private fn cmd_info(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    if (not args.is_empty()) and (args.get(0) matches _: String) {
        let arg = args.get(0).as(String).trim()
        if arg != "" {
            let _ = resolve_and_open_info_topic(kernel, world, state, arg)#
            return ()
        }
    }
    let resume_id = if state.current_info_node != "" {
        state.current_info_node
    } else {
        INFO_DIR_NODE
    }
    let _ = open_info_node(kernel, world, resume_id)#
    ()
}

private fn cmd_info_follow_at_point(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let buf = world.active_buffer()
    let nodes = accel_index_docs(resolve_doc_roots(world, state = state))
    let lk_opt = find_link_at_point(buf, true, nodes)
    if lk_opt == null {
        emit_help_status(world, "No Info cross-reference or link on current line")#
        return ()
    }
    follow_help_link(kernel, world, state, lk_opt.as(HelpLink))#!
    ()
}

private fn cmd_info_next_link(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let nodes = accel_index_docs(resolve_doc_roots(world, state = state))
    jump_link_in_buffer(world, world.active_buffer(), true, true, nodes)#
    sync_window_pane_to_world(kernel, world)
    ()
}

private fn cmd_info_prev_link(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let nodes = accel_index_docs(resolve_doc_roots(world, state = state))
    jump_link_in_buffer(world, world.active_buffer(), false, true, nodes)#
    sync_window_pane_to_world(kernel, world)
    ()
}

private fn cmd_info_next_node(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let nodes = accel_index_docs(resolve_doc_roots(world, state = state))
    if state.current_info_node == "" or state.current_info_node == INFO_DIR_NODE {
        if nodes.is_empty() {
            emit_help_status(world, "No next Info node")#
            return ()
        }
        let _ = open_info_node(kernel, world, nodes.get(0).as(DocNode).node_id)#
        return ()
    }
    let idx = find_node_index(nodes, state.current_info_node)
    if idx < 0 or idx + 1 >= nodes.len() {
        emit_help_status(world, "No `Next` node from " ++ state.current_info_node)#
        return ()
    }
    let _ = open_info_node(kernel, world, nodes.get((idx + 1).as(usize)).as(DocNode).node_id)#
    ()
}

private fn cmd_info_prev_node(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let nodes = accel_index_docs(resolve_doc_roots(world, state = state))
    if state.current_info_node == "" or state.current_info_node == INFO_DIR_NODE {
        emit_help_status(world, "Already at Info top directory (dir)Top")#
        return ()
    }
    let idx = find_node_index(nodes, state.current_info_node)
    if idx <= 0 {
        let _ = open_info_node(kernel, world, INFO_DIR_NODE)#
        return ()
    }
    let _ = open_info_node(kernel, world, nodes.get((idx - 1).as(usize)).as(DocNode).node_id)#
    ()
}

private fn cmd_info_up_node(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    if state.current_info_node == "" or state.current_info_node == INFO_DIR_NODE {
        emit_help_status(world, "Already at top-level directory (dir)Top")#
        return ()
    }
    let nodes = accel_index_docs(resolve_doc_roots(world, state = state))
    let idx = find_node_index(nodes, state.current_info_node)
    if idx < 0 {
        let _ = open_info_node(kernel, world, INFO_DIR_NODE)#
        return ()
    }
    let (_, _, up_id) = compute_info_neighbors(nodes, idx)
    let _ = open_info_node(kernel, world, up_id)#
    ()
}

private fn cmd_info_top_node(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    if state.current_info_node == "" or state.current_info_node == INFO_DIR_NODE {
        let _ = open_info_node(kernel, world, INFO_DIR_NODE)#
        return ()
    }
    let nodes = accel_index_docs(resolve_doc_roots(world, state = state))
    let idx = find_node_index(nodes, state.current_info_node)
    if idx < 0 {
        let _ = open_info_node(kernel, world, INFO_DIR_NODE)#
        return ()
    }
    let cur_manual = nodes.get(idx.as(usize)).as(DocNode).manual
    let top_id = manual_top_node_id(nodes, cur_manual)
    let _ = open_info_node(kernel, world, top_id)#
    ()
}

private fn cmd_info_directory(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let _ = open_info_node(kernel, world, INFO_DIR_NODE)#
    ()
}

private fn cmd_info_history_back(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    if state.info_history_idx <= 0 {
        emit_help_status(world, "Beginning of Info history")#
        return ()
    }
    save_current_info_cursor_in_history(world, state)
    state.info_history_idx -= 1
    let item = state.info_history.get(state.info_history_idx.as(usize)).as(InfoHistoryItem)
    let _ = open_info_node(
        kernel,
        world,
        item.node_id,
        push_history = false,
        override_cursor_row = item.cursor_row,
    )#
    ()
}

private fn cmd_info_history_forward(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    if state.info_history_idx + 1 >= state.info_history.len() {
        emit_help_status(world, "End of Info history")#
        return ()
    }
    save_current_info_cursor_in_history(world, state)
    state.info_history_idx += 1
    let item = state.info_history.get(state.info_history_idx.as(usize)).as(InfoHistoryItem)
    let _ = open_info_node(
        kernel,
        world,
        item.node_id,
        push_history = false,
        override_cursor_row = item.cursor_row,
    )#
    ()
}

private fn cmd_info_goto_node(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let nodes = accel_index_docs(resolve_doc_roots(world, state = state))
    let chosen = if (not args.is_empty()) and (args.get(0) matches _: String) {
        args.get(0).as(String)
    } else {
        let cands = List()
        cands.push((INFO_DIR_NODE, "Top-Level Info Manual Directory"))
        for i in 0..nodes.len() {
            let nd = nodes.get(i.as(usize)).as(DocNode)
            cands.push((nd.node_id, nd.title ++ " [" ++ nd.manual ++ "]"))
        }
        let ans? = ask_prompt(PromptRequest.with_candidates(
            "Goto Info node: ",
            "",
            PromptKind.choice,
            cands,
        ))# else {
            emit_help_status(world, "Quit")#
            return ()
        }
        ans
    }
    if chosen.trim() != "" {
        let _ = resolve_and_open_info_topic(kernel, world, state, chosen)#
    }
    ()
}

private fn cmd_info_menu(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let nodes = accel_index_docs(resolve_doc_roots(world, state = state))
    let chosen = if (not args.is_empty()) and (args.get(0) matches _: String) {
        args.get(0).as(String)
    } else {
        let cands = List()
        if state.current_info_node == "" or state.current_info_node == INFO_DIR_NODE {
            let roots = collect_manual_roots(nodes)
            for i in 0..roots.len() {
                let nd = roots.get(i.as(usize)).as(DocNode)
                cands.push((nd.node_id, nd.title ++ " — " ++ nd.summary))
            }
        } else {
            let idx = find_node_index(nodes, state.current_info_node)
            let children = if idx >= 0 { collect_node_children(nodes, idx) } else { List() }
            if not children.is_empty() {
                for i in 0..children.len() {
                    let ch = children.get(i.as(usize)).as(DocNode)
                    cands.push((ch.node_id, ch.title ++ " — " ++ ch.summary))
                }
            } else if idx >= 0 {
                let cur_m = nodes.get(idx.as(usize)).as(DocNode).manual
                for i in 0..nodes.len() {
                    let nd = nodes.get(i.as(usize)).as(DocNode)
                    if nd.manual == cur_m {
                        cands.push((nd.node_id, nd.title ++ " — " ++ nd.summary))
                    }
                }
            }
        }
        let ans? = ask_prompt(PromptRequest.with_candidates(
            "Info menu item: ",
            "",
            PromptKind.choice,
            cands,
        ))# else {
            emit_help_status(world, "Quit")#
            return ()
        }
        ans
    }
    if chosen.trim() != "" {
        let _ = resolve_and_open_info_topic(kernel, world, state, chosen)#
    }
    ()
}

private fn cmd_info_index(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let nodes = accel_index_docs(resolve_doc_roots(world, state = state))
    let chosen = if (not args.is_empty()) and (args.get(0) matches _: String) {
        args.get(0).as(String)
    } else {
        let cands = List()
        let seen = Set.new()
        for i in 0..nodes.len() {
            let nd = nodes.get(i.as(usize)).as(DocNode)
            for ti in 0..nd.tags.len() {
                let tg = nd.tags.get(ti.as(usize)).as(String)
                if not seen.contains(tg) {
                    seen.insert(tg)
                    cands.push((tg, "Tag in " ++ nd.node_id ++ " — " ++ nd.title))
                }
            }
        }
        let metas = all_option_metas()
        for i in 0..metas.len() {
            let m = metas.get(i.as(usize)).as(OptionMeta)
            if not seen.contains(m.name) {
                seen.insert(m.name)
                cands.push((m.name, "Option (" ++ m.val_type ++ ") — " ++ m.summary_en))
            }
        }
        let cmds = kernel.list_commands(interactive_only = true)
        for i in 0..cmds.len() {
            let cs = cmds.get(i.as(usize)).as(CommandSpec)
            if not seen.contains(cs.name) {
                seen.insert(cs.name)
                cands.push((cs.name, "Command [" ++ cs.owner.raw() ++ "] — " ++ cs.summary))
            }
        }
        let ans? = ask_prompt(PromptRequest.with_candidates(
            "Info index lookup: ",
            "",
            PromptKind.choice,
            cands,
        ))# else {
            emit_help_status(world, "Quit")#
            return ()
        }
        ans
    }
    let clean = chosen.trim()
    if clean != "" {
        resolve_help_topic(kernel, world, state, clean, true)#
    }
    ()
}

private fn cmd_info_search(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let query = if (not args.is_empty()) and (args.get(0) matches _: String) {
        args.get(0).as(String)
    } else {
        let ans? = ask_prompt(PromptRequest.text("Info search manuals: ", state.info_last_query))# else {
            emit_help_status(world, "Quit")#
            return ()
        }
        ans
    }
    let q_trim = query.trim()
    if q_trim == "" {
        return ()
    }
    let doc_roots = resolve_doc_roots(world, state = state)
    let hits = accel_search_docs(doc_roots, q_trim, limit = 50)
    state.info_last_query = q_trim
    state.info_search_hits = hits
    state.info_search_idx = 0
    if hits.is_empty() {
        emit_help_status(world, "Info search: no matches for `" ++ q_trim ++ "`")#
        return ()
    }
    let h0 = hits.get(0).as(DocSearchHit)
    let _ = open_info_node(kernel, world, h0.node_id, focus_file_row = h0.row)#
    world.last_search = q_trim
    world.search_highlight_active = world.options.hlsearch
    emit_help_status(
        world,
        "Info search [1/" ++ hits.len().to_string() ++ "]: " ++ h0.node_id
        ++ " (press ] / [ for next/prev, C-h d for full Apropos)",
    )#
    ()
}

private fn step_info_search_hit(kernel: SystemKernel, delta: i64) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let total = state.info_search_hits.len()
    if total == 0 {
        emit_help_status(world, "No active Info search (press `s` to search manuals)")#
        return ()
    }
    var next_idx = (state.info_search_idx + delta) % total
    if next_idx < 0 {
        next_idx += total
    }
    state.info_search_idx = next_idx
    let hit = state.info_search_hits.get(next_idx.as(usize)).as(DocSearchHit)
    let _ = open_info_node(kernel, world, hit.node_id, focus_file_row = hit.row)#
    emit_help_status(
        world,
        "Info search [" ++ (next_idx + 1).to_string() ++ "/" ++ total.to_string() ++ "]: " ++ hit.node_id,
    )#
    ()
}

private fn cmd_info_quit(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    quit_help_family_buffer(kernel, world, state)#
    ()
}

