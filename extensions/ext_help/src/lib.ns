    let state = require_help_state(kernel)!
    quit_help_family_buffer(kernel, world, state)#
    ()
}

-- 12.3 Helpful Deep Introspection Commands (`*Help*`, `major_mode = "help"`)
private fn cmd_describe_function(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let chosen = if (not args.is_empty()) and (args.get(0) matches _: String) {
        args.get(0).as(String)
    } else {
        let ans? = ask_prompt(PromptRequest {
            label: "Describe command: ",
            initial: "",
            kind: PromptKind.command_name,
            candidates: List(),
        })# else {
            emit_help_status(world, "Quit")#
            return ()
        }
        ans
    }
    let clean = chosen.trim()
    if clean == "" {
        return ()
    }
    if kernel.get_command(clean) != null {
        present_help_page(
            kernel,
            world,
            state,
            HelpPageSpec {
                page_kind: "command",
                target: clean,
                source_file: "",
                source_row: -1,
                cursor_row: 0,
            },
            true,
        )#
        return ()
    }
    let code_roots = resolve_code_roots(world, state = state)
    let sym_hits = accel_find_symbol_defs(code_roots, clean, limit = 5)
    if not sym_hits.is_empty() {
        let sh = sym_hits.get(0).as(SymbolDefHit)
        present_help_page(
            kernel,
            world,
            state,
            HelpPageSpec {
                page_kind: "symbol",
                target: sh.symbol,
                source_file: sh.file_path,
                source_row: sh.row,
                cursor_row: 0,
            },
            true,
        )#
        return ()
    }
    emit_help_status(world, "Unknown command: " ++ clean)#
    ()
}

private fn cmd_describe_variable(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let chosen = if (not args.is_empty()) and (args.get(0) matches _: String) {
        args.get(0).as(String)
    } else {
        let metas = all_option_metas()
        let cands = List()
        for i in 0..metas.len() {
            let m = metas.get(i.as(usize)).as(OptionMeta)
            let cur_v = get_option_value_str(world.options, m.name)
            cands.push((m.name, "(" ++ m.val_type ++ " = " ++ cur_v ++ ") " ++ m.summary_en))
        }
        let ans? = ask_prompt(PromptRequest.with_candidates(
            "Describe variable: ",
            "",
            PromptKind.choice,
            cands,
        ))# else {
            emit_help_status(world, "Quit")#
            return ()
        }
        ans
    }
    let clean = chosen.trim()
    if clean == "" {
        return ()
    }
    let meta_opt = find_option_meta(clean)
    if meta_opt == null {
        emit_help_status(world, "Unknown variable: " ++ clean)#
        return ()
    }
    present_help_page(
        kernel,
        world,
        state,
        HelpPageSpec {
            page_kind: "variable",
            target: meta_opt.as(OptionMeta).name,
            source_file: "",
            source_row: -1,
            cursor_row: 0,
        },
        true,
    )#
    ()
}

