private fn cmd_apropos_open_at_point(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let buf = world.active_buffer()
    let hit? = find_apropos_hit_near_row(state, buf.point.row) else {
        emit_help_status(world, "No Apropos entry on current line")#
        return ()
    }
    if hit.kind == "doc" {
        let _ = open_info_node(kernel, world, hit.target_id, focus_file_row = hit.file_row)#
        return ()
    }
    if hit.kind == "command" {
        present_help_page(
            kernel,
            world,
            state,
            HelpPageSpec {
                page_kind: "command",
                target: hit.target_id,
                source_file: "",
                source_row: -1,
                cursor_row: 0,
            },
            true,
        )#
        return ()
    }
    if hit.kind == "variable" {
        present_help_page(
            kernel,
            world,
            state,
            HelpPageSpec {
                page_kind: "variable",
                target: hit.target_id,
                source_file: "",
                source_row: -1,
                cursor_row: 0,
            },
            true,
        )#
        return ()
    }
    if hit.kind == "extension" {
        present_help_page(
            kernel,
            world,
            state,
            HelpPageSpec {
                page_kind: "extension",
                target: hit.target_id,
                source_file: "",
                source_row: -1,
                cursor_row: 0,
            },
            true,
        )#
        return ()
    }
    if hit.kind == "symbol" {
        present_help_page(
            kernel,
            world,
            state,
            HelpPageSpec {
                page_kind: "symbol",
                target: hit.target_id,
                source_file: hit.file_path,
                source_row: hit.file_row,
                cursor_row: 0,
            },
            true,
        )#
        return ()
    }
    ()
}

private fn cmd_apropos_goto_source(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let buf = world.active_buffer()
    let hit? = find_apropos_hit_near_row(state, buf.point.row) else {
        emit_help_status(world, "No Apropos entry on current line")#
        return ()
    }
    if hit.file_path != "" and fs.exists(hit.file_path) {
        let _ = open_file_at_row(kernel, world, hit.file_path, hit.file_row)#!
        return ()
    }
    if hit.kind == "command" {
        let spec_opt = kernel.get_command(hit.target_id)
        if spec_opt != null {
            let cs = spec_opt.as(CommandSpec)
            let src_opt = find_command_source(world, state, cs.name, cs.owner)
            if src_opt != null {
                let sh = src_opt.as(SymbolDefHit)
                let _ = open_file_at_row(kernel, world, sh.file_path, sh.row)#!
                return ()
            }
        }
    }
    if hit.kind == "variable" {
        let defs = accel_find_symbol_defs(resolve_code_roots(world, state = state), "EditorOptions", limit = 5)
        if not defs.is_empty() {
            let sh = defs.get(0).as(SymbolDefHit)
            let _ = open_file_at_row(kernel, world, sh.file_path, sh.row)#!
            return ()
        }
    }
    if hit.kind == "extension" {
        let short_name = if hit.target_id.contains("/") {
            let (_, s) = hit.target_id.rsplit_once("/").as((String, String))
            s
        } else {
            hit.target_id
        }
        let reg_fn = "register_" ++ short_name.trim_start_matches("ext_") ++ "_extension"
        let defs = accel_find_symbol_defs(resolve_code_roots(world, state = state), reg_fn, limit = 5)
        if not defs.is_empty() {
            let sh = defs.get(0).as(SymbolDefHit)
            let _ = open_file_at_row(kernel, world, sh.file_path, sh.row)#!
            return ()
        }
    }
    emit_help_status(world, "No source file location found for " ++ hit.target_id)#
    ()
}

private fn step_apropos_item(kernel: SystemKernel, forward: bool) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let entries = state.apropos_entries
    if entries.is_empty() {
        emit_help_status(world, "No entries in *Apropos*")#
        return ()
    }
    let buf = world.active_buffer()
    let cur_r = buf.point.row
    var chosen_opt: ?AproposHit = null
    if forward {
        for i in 0..entries.len() {
            let h = entries.get(i.as(usize)).as(AproposHit)
            if h.row > cur_r {
                chosen_opt = h
                break
            }
        }
        if chosen_opt == null {
            chosen_opt = entries.get(0).as(AproposHit)
        }
    } else {
        var i = entries.len() - 1
        while i >= 0 {
            let h = entries.get(i.as(usize)).as(AproposHit)
            if h.row < cur_r {
                chosen_opt = h
                break
            }
            i -= 1
        }
        if chosen_opt == null {
            chosen_opt = entries.get((entries.len() - 1).as(usize)).as(AproposHit)
        }
    }
    let chosen = chosen_opt.as(AproposHit)
    buf.point = buf.clamp_pos(Pos.new(chosen.row, 0), insert_mode = false)
    buf.preferred_col = 0
    ensure_row_visible(world, buf.point.row)
    sync_window_pane_to_world(kernel, world)
    emit_help_status(world, "[" ++ chosen.kind ++ "] " ++ chosen.title)#
    ()
}

private fn cmd_apropos_refresh(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let ans? = ask_prompt(
        PromptRequest.text("Apropos search: ", state.apropos_query)
    )# else {
        emit_help_status(world, "Quit")#
        return ()
    }
    if ans.trim() != "" {
        run_apropos_report(kernel, world, state, ans, state.apropos_mode_kind)#
    }
    ()
}

private fn cmd_apropos_quit(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
