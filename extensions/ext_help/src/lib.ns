}

private fn cmd_where_is(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let chosen = if (not args.is_empty()) and (args.get(0) matches _: String) {
        args.get(0).as(String)
    } else {
        let ans? = ask_prompt(PromptRequest {
            label: "Where is command: ",
            initial: "",
            kind: PromptKind.command_name,
            candidates: List(),
        })# else {
            emit_help_status(world, "Quit")#
            return ()
        }
        ans
    }
    let clean = chosen.trim()
    if clean == "" {
        return ()
    }
    if kernel.get_command(clean) == null {
        let msg = "Unknown command: " ++ clean
        world.append_message(msg)
        emit_help_status(world, msg)#
        return ()
    }
    let bindings = collect_bindings_for_command(kernel, clean)
    let msg = if bindings.is_empty() {
        "`" ++ clean ++ "` is not on any key (invoke via `M-x " ++ clean ++ "` or `:" ++ clean ++ "`)"
    } else {
        let parts = List()
        for i in 0..bindings.len() {
            let (kname, entry) = bindings.get(i.as(usize)).as((String, KeyBindingEntry))
            parts.push(pretty_chord_string(entry.chord) ++ " [" ++ kname ++ "]")
        }
        "`" ++ clean ++ "` is on " ++ parts.join(", ") ++ " (Ex: `:" ++ clean ++ "`)"
    }
    world.append_message(msg)
    emit_help_status(world, msg)#
    ()
}

private fn cmd_describe_key_briefly(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let raw_spec = if (not args.is_empty()) and (args.get(0) matches _: String) {
        args.get(0).as(String)
    } else {
        let ans? = ask_prompt(
            PromptRequest.text("Describe key chord briefly (e.g. <C-x> <C-f>, <Space> f f): ", "")
        )# else {
            emit_help_status(world, "Quit")#
            return ()
        }
        ans
    }
    let seq = parse_key_sequence(raw_spec)
    let canon = if seq.is_empty() { raw_spec.trim() } else { format_chord(seq) }
    let disp = pretty_chord_string(canon)
    if canon == "" {
        return ()
    }

    let km_names = kernel.keymaps.keys()
    km_names.sort()
    let matches_list = List()
    var prefix_count: i64 = 0
    let pfx = canon ++ " "
    for i in 0..km_names.len() {
        let kname = km_names.get(i.as(usize)).as(String)
        let km = kernel.keymaps.get(kname).as(Keymap)
        let exact_opt = km.bindings.get(canon)
        if exact_opt != null {
            let e = exact_opt.as(KeyBindingEntry)
            matches_list.push("`" ++ e.command_name ++ "` [" ++ kname ++ "]")
        }
        for k in km.bindings.keys() {
            if k.as(String).starts_with(pfx) {
                prefix_count += 1
            }
        }
    }

    let msg = if not matches_list.is_empty() {
        disp ++ " runs " ++ matches_list.join(", ")
    } else if prefix_count > 0 {
        disp ++ " is a prefix key with " ++ prefix_count.to_string() ++ " sub-bindings"
    } else {
        disp ++ " is undefined"
    }
    world.append_message(msg)
    emit_help_status(world, msg)#
    ()
}

