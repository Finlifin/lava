private fn cmd_helpful_at_point(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    if (not args.is_empty()) and (args.get(0) matches _: String) {
        let arg = args.get(0).as(String).trim()
        if arg != "" {
            resolve_help_topic(kernel, world, state, arg, true)#
            return ()
        }
    }
    let token = extract_help_token_at_point(world.active_buffer())
    if token == "" {
        present_help_page(
            kernel,
            world,
            state,
            HelpPageSpec {
                page_kind: "overview",
                target: "help-for-help",
                source_file: "",
                source_row: -1,
                cursor_row: 0,
            },
            true,
        )#
        return ()
    }
    resolve_help_topic(kernel, world, state, token, false)#
    ()
}

private fn cmd_ex_help(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    if args.is_empty() or (not (args.get(0) matches _: String)) or args.get(0).as(String).trim() == "" {
        let _ = open_info_node(kernel, world, INFO_DIR_NODE)#
        return ()
    }
    let topic = args.get(0).as(String).trim()
    resolve_help_topic(kernel, world, state, topic, true)#
    ()
}

-- 12.4 `*Help*` Buffer Local Commands (`mode:help`)
private fn cmd_help_follow_at_point(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let buf = world.active_buffer()
    let cur_line = buf.line_at(buf.point.row)
    if cur_line.contains("Press 'e' to change/toggle value") {
        let _ = cmd_help_edit_variable(kernel, List())#!
        return ()
    }
    let nodes = accel_index_docs(resolve_doc_roots(world, state = state))
    let lk_opt = find_link_at_point(buf, false, nodes)
    if lk_opt == null {
        emit_help_status(world, "No link on current line")#
        return ()
    }
    follow_help_link(kernel, world, state, lk_opt.as(HelpLink))#!
    ()
}

private fn cmd_help_goto_source(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let buf = world.active_buffer()
    let nodes = accel_index_docs(resolve_doc_roots(world, state = state))
    let lk_opt = find_link_at_point(buf, false, nodes)
    if lk_opt != null and lk_opt.as(HelpLink).kind == "source" {
        let (fp, r0) = parse_source_target(lk_opt.as(HelpLink).target)
        let _ = open_file_at_row(kernel, world, fp, r0)#!
        return ()
    }
    let page? = state.current_help_page else {
        emit_help_status(world, "No source file associated with current *Help* page")#
        return ()
    }
    if page.source_file == "" or (not fs.exists(page.source_file)) {
        emit_help_status(world, "No source file found for " ++ page.target)#
        return ()
    }
    let _ = open_file_at_row(kernel, world, page.source_file, page.source_row)#!
    ()
}

private fn cmd_help_edit_variable(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let page? = state.current_help_page else {
        emit_help_status(world, "Not viewing a customizable variable in *Help*")#
        return ()
    }
    if page.page_kind != "variable" {
        emit_help_status(world, "Current *Help* page is not a variable (use `C-h v` first)")#
        return ()
    }
    let meta? = find_option_meta(page.target) else {
        emit_help_status(world, "Unknown option: " ++ page.target)#
        return ()
    }

    let keep_row = world.active_buffer().point.row
    if meta.val_type == "bool" {
        let toggled_opt = toggle_bool_option(kernel, world, meta.name)
        if toggled_opt != null {
            let new_val = toggled_opt.as(bool)
            present_help_page(
                kernel,
                world,
                state,
                HelpPageSpec {
                    page_kind: "variable",
                    target: meta.name,
                    source_file: page.source_file,
                    source_row: page.source_row,
                    cursor_row: keep_row,
                },
                false,
            )#
            emit_help_status(world, "Toggled " ++ meta.name ++ " = " ++ new_val.to_string())#
        }
        return ()
    }

    let raw_new = if (not args.is_empty()) and (args.get(0) matches _: String) {
        args.get(0).as(String)
    } else {
        let cur_edit = get_raw_option_edit_str(world.options, meta.name)
        let ans? = ask_prompt(
            PromptRequest.text("Set " ++ meta.name ++ " (" ++ meta.val_type ++ "): ", cur_edit)
        )# else {
            emit_help_status(world, "Quit")#
            return ()
        }
        ans
    }

    let applied! = apply_option_value_str(kernel, world, meta, raw_new) else {
        emit_help_status(world, "Invalid value for " ++ meta.name ++ ": " ++ raw_new)#
        return ()
    }
    present_help_page(
        kernel,
        world,
        state,
        HelpPageSpec {
            page_kind: "variable",
            target: meta.name,
            source_file: page.source_file,
            source_row: page.source_row,
            cursor_row: keep_row,
        },
        false,
    )#
    emit_help_status(world, "Set " ++ meta.name ++ " = " ++ applied)#
    ()
}

private fn cmd_help_history_back(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    if state.help_history_idx <= 0 {
        emit_help_status(world, "Beginning of *Help* history")#
        return ()
    }
    save_current_help_cursor_in_history(world, state)
    state.help_history_idx -= 1
    let spec = state.help_history.get(state.help_history_idx.as(usize)).as(HelpPageSpec)
    present_help_page(kernel, world, state, spec, false)#
    ()
}

private fn cmd_help_history_forward(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    if state.help_history_idx + 1 >= state.help_history.len() {
        emit_help_status(world, "End of *Help* history")#
        return ()
    }
    save_current_help_cursor_in_history(world, state)
    state.help_history_idx += 1
    let spec = state.help_history.get(state.help_history_idx.as(usize)).as(HelpPageSpec)
    present_help_page(kernel, world, state, spec, false)#
    ()
}

private fn cmd_help_next_link(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let nodes = accel_index_docs(resolve_doc_roots(world, state = state))
    jump_link_in_buffer(world, world.active_buffer(), true, false, nodes)#
    sync_window_pane_to_world(kernel, world)
    ()
}

private fn cmd_help_prev_link(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    let nodes = accel_index_docs(resolve_doc_roots(world, state = state))
    jump_link_in_buffer(world, world.active_buffer(), false, false, nodes)#
    sync_window_pane_to_world(kernel, world)
    ()
}

private fn cmd_help_quit(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let state = require_help_state(kernel)!
    quit_help_family_buffer(kernel, world, state)#
    ()
}

-- ============================================================================
-- 13. Extension Registration & Keymap Composition
-- ============================================================================

pub fn register_help_extension(kernel: SystemKernel) -> !String Unit {
    let ext_id = ext_help_id()
    kernel.register_extension(
        ext_id,
        "lava.org",
        "ext_help",
        "0.1.0",
        "Emacs Info hypertext manual reader (`*Info*`), global 5-domain documentation Apropos (`*Apropos*`), and `helpful`-style deep introspection (`*Help*`).",
        [ext_document_id(), ext_window_id(), ext_render_id(), ext_vim_id(), ext_emacs_id()],
        |k: SystemKernel| -> !String Unit {
            let state = HelpState.new()
            k.publish_service(SERVICE_HELP_STATE, ext_id, state)

            -- 1. Emacs Info Hypertext Manual Reader commands
            k.register_command("info", ext_id, "Open Emacs `*Info*` hypertext manual reader (`C-h i` / `:Info`).", cmd_info)
            k.register_command("ex:Info", ext_id, "Open `*Info*` manual reader (`:Info [topic]`).", cmd_info, interactive = false)
            k.register_command("info-follow-at-point", ext_id, "Follow `[node_id]`, `[Source: file:line]`, or Markdown link at point in `*Info*` (`RET`).", cmd_info_follow_at_point)
            k.register_command("info-next-link", ext_id, "Move cursor to next cross-reference link in `*Info*` (`TAB`).", cmd_info_next_link)
            k.register_command("info-prev-link", ext_id, "Move cursor to previous cross-reference link in `*Info*` (`S-TAB`).", cmd_info_prev_link)
            k.register_command("info-next-node", ext_id, "Move to `Next` Info node (`n`).", cmd_info_next_node)
            k.register_command("info-prev-node", ext_id, "Move to `Prev` Info node (`p`).", cmd_info_prev_node)
            k.register_command("info-up-node", ext_id, "Move to `Up` parent Info node (`u`).", cmd_info_up_node)
            k.register_command("info-top-node", ext_id, "Move to current manual's `Top` node (`t`).", cmd_info_top_node)
            k.register_command("info-directory", ext_id, "Go to top-level `(dir)Top` Info directory (`d`).", cmd_info_directory)
            k.register_command("info-history-back", ext_id, "Navigate backward in `*Info*` node history (`l`).", cmd_info_history_back)
            k.register_command("info-history-forward", ext_id, "Navigate forward in `*Info*` node history (`r`).", cmd_info_history_forward)
            k.register_command("info-goto-node", ext_id, "Prompt and jump to any Info node (`g`).", cmd_info_goto_node)
            k.register_command("info-menu", ext_id, "Pick child `* Menu:` item in current Info node (`m`).", cmd_info_menu)
            k.register_command("info-index", ext_id, "Look up `*help-tag*`, option, or command in Info index (`i`).", cmd_info_index)
            k.register_command("info-search", ext_id, "Full-text search across all Info manuals (`s`).", cmd_info_search)
            k.register_command("info-search-next", ext_id, "Jump to next Info full-text search hit (`]`).", |kern: SystemKernel, _a: List| -> #InteractiveEffects !String Any { step_info_search_hit(kern, 1)# })
            k.register_command("info-search-prev", ext_id, "Jump to previous Info full-text search hit (`[`).", |kern: SystemKernel, _a: List| -> #InteractiveEffects !String Any { step_info_search_hit(kern, -1)# })
            k.register_command("info-quit", ext_id, "Quit `*Info*` and return to previous editing buffer (`q`).", cmd_info_quit)

            -- 2. Global Documentation Apropos commands (`*Apropos*`)
            k.register_command("apropos-documentation", ext_id, "Global 5-domain documentation search across manuals, commands, options, extensions, and `.ns` symbols (`C-h d`).", cmd_apropos_documentation)
            k.register_command("ex:AproposDocs", ext_id, "Global documentation search (`:AproposDocs <query>`).", cmd_apropos_documentation, interactive = false)
            k.register_command("apropos-command", ext_id, "Search interactive and Ex commands by Orderless tokens across names, keys, and docstrings (`C-h a`).", cmd_apropos_command)
            k.register_command("ex:AproposCommand", ext_id, "Command apropos (`:AproposCommand <query>`).", cmd_apropos_command, interactive = false)
            k.register_command("apropos", ext_id, "Unified symbol, command, option, extension, and tag apropos in `*Apropos*` (`C-h o` / `:Apropos`).", cmd_apropos)
            k.register_command("ex:Apropos", ext_id, "Unified apropos (`:Apropos <query>`).", cmd_apropos, interactive = false)
            k.register_command("apropos-open-at-point", ext_id, "Open `*Info*` or `*Help*` inspector for Apropos entry at point (`RET`).", cmd_apropos_open_at_point)
            k.register_command("apropos-goto-source", ext_id, "Jump directly to `.ns` or `.md` source definition for Apropos entry (`s`).", cmd_apropos_goto_source)
            k.register_command("apropos-next-item", ext_id, "Move to next result entry in `*Apropos*` (`TAB` / `n`).", |kern: SystemKernel, _a: List| -> #InteractiveEffects !String Any { step_apropos_item(kern, true)# })
            k.register_command("apropos-prev-item", ext_id, "Move to previous result entry in `*Apropos*` (`S-TAB` / `p`).", |kern: SystemKernel, _a: List| -> #InteractiveEffects !String Any { step_apropos_item(kern, false)# })
            k.register_command("apropos-refresh", ext_id, "Run a new global Apropos query (`g`).", cmd_apropos_refresh)
            k.register_command("apropos-quit", ext_id, "Quit `*Apropos*` and return to previous buffer (`q`).", cmd_apropos_quit)

            -- 3. Emacs `helpful` Deep Introspection commands (`*Help*`)
            k.register_command("describe-function", ext_id, "Inspect command/function with keybindings, owner, and 10-line `.ns` source preview in `*Help*` (`C-h f`).", cmd_describe_function)
            k.register_command("describe-command", ext_id, "Inspect interactive command with keybindings and `.ns` source preview in `*Help*` (`C-h x`).", cmd_describe_function)
            k.register_command("describe-variable", ext_id, "Inspect any of the 29 `EditorOptions` variables with live `e` toggle/edit in `*Help*` (`C-h v`).", cmd_describe_variable)
            k.register_command("describe-mode", ext_id, "Display active buffer major mode, modal state, mode-local bindings, hooks, and extensions (`C-h m`).", cmd_describe_mode)
            k.register_command("where-is", ext_id, "Show all keybindings and Ex invocation for a command in echo area (`C-h w`).", cmd_where_is)
            k.register_command("describe-key-briefly", ext_id, "Show concise 1-line summary of key chord binding in echo area (`C-h c`).", cmd_describe_key_briefly)
            k.register_command("help-for-help", ext_id, "Open Emacs `C-h` + Evil `:help` + Info + Apropos cheat-sheet in `*Help*` (`C-h ?` / `<F1>`).", cmd_help_for_help)
            k.register_command("helpful-at-point", ext_id, "Smart context help for command, option, `*tag*`, or Nessa symbol at cursor (`C-h .` / Normal `K`).", cmd_helpful_at_point)
            k.register_command("ex:help", ext_id, "Open Info manual or smart help for topic (`:help [topic]`).", cmd_ex_help, interactive = false)
            k.register_command("ex:h", ext_id, "Open Info manual or smart help for topic (`:h [topic]`).", cmd_ex_help, interactive = false)

            k.register_command("help-follow-at-point", ext_id, "Follow link at point in `*Help*` (`RET`).", cmd_help_follow_at_point)
            k.register_command("help-goto-source", ext_id, "Jump directly to `[Source: file:line]` of current `*Help*` page (`s` / `gd`).", cmd_help_goto_source)
            k.register_command("help-edit-variable", ext_id, "Toggle or edit current `EditorOptions` variable live in `*Help*` (`e`).", cmd_help_edit_variable)
            k.register_command("help-history-back", ext_id, "Go back in `*Help*` page history (`l`).", cmd_help_history_back)
            k.register_command("help-history-forward", ext_id, "Go forward in `*Help*` page history (`r`).", cmd_help_history_forward)
            k.register_command("help-next-link", ext_id, "Jump to next link in `*Help*` (`TAB`).", cmd_help_next_link)
            k.register_command("help-prev-link", ext_id, "Jump to previous link in `*Help*` (`S-TAB`).", cmd_help_prev_link)
            k.register_command("help-quit", ext_id, "Quit `*Help*` and return to previous editing buffer (`q`).", cmd_help_quit)

            -- 4. Global Emacs `C-h` + `<F1>` Keybindings
            let em_km = k.ensure_keymap(KEYMAP_EMACS_GLOBAL)
            em_km.bind("<C-h> i", "info", ext_id, description = "Info manual reader")
            em_km.bind("<C-h> d", "apropos-documentation", ext_id, description = "Global documentation search")
            em_km.bind("<C-h> a", "apropos-command", ext_id, description = "Apropos commands")
            em_km.bind("<C-h> o", "apropos", ext_id, description = "Apropos symbols & tags")
            em_km.bind("<C-h> f", "describe-function", ext_id, description = "Describe function/command")
            em_km.bind("<C-h> x", "describe-command", ext_id, description = "Describe command")
            em_km.bind("<C-h> v", "describe-variable", ext_id, description = "Describe variable/option")
            em_km.bind("<C-h> m", "describe-mode", ext_id, description = "Describe buffer mode")
            em_km.bind("<C-h> w", "where-is", ext_id, description = "Where is command bound")
            em_km.bind("<C-h> c", "describe-key-briefly", ext_id, description = "Describe key briefly")
            em_km.bind("<C-h> ?", "help-for-help", ext_id, description = "Help for help cheat-sheet")
            em_km.bind("<C-h> <C-h>", "help-for-help", ext_id, description = "Help for help cheat-sheet")
            em_km.bind("<C-h> .", "helpful-at-point", ext_id, description = "Helpful at point")
            em_km.bind("<F1>", "help-for-help", ext_id, description = "Help for help cheat-sheet")

            -- 5. Evil-Vim Leader (`<Space> h ...`) & Normal `K` / `<F1>` Keybindings
            let leader_km = k.ensure_keymap(KEYMAP_VIM_LEADER)
            leader_km.bind("<Space> h i", "info", ext_id, description = "Info hypertext manuals")
            leader_km.bind("<Space> h d", "apropos-documentation", ext_id, description = "Global doc search (Apropos)")
            leader_km.bind("<Space> h h", "apropos-documentation", ext_id, description = "Global doc search (Apropos)")
            leader_km.bind("<Space> h a", "apropos-command", ext_id, description = "Apropos commands")
            leader_km.bind("<Space> h o", "apropos", ext_id, description = "Apropos symbols & tags")
            leader_km.bind("<Space> h f", "describe-function", ext_id, description = "Describe command/function")
            leader_km.bind("<Space> h x", "describe-command", ext_id, description = "Describe command")
            leader_km.bind("<Space> h v", "describe-variable", ext_id, description = "Describe variable/option")
            leader_km.bind("<Space> h m", "describe-mode", ext_id, description = "Describe mode")
            leader_km.bind("<Space> h w", "where-is", ext_id, description = "Where is command")
            leader_km.bind("<Space> h c", "describe-key-briefly", ext_id, description = "Describe key briefly")
            leader_km.bind("<Space> h k", "describe-key", ext_id, description = "Describe key")
            leader_km.bind("<Space> h b", "describe-bindings", ext_id, description = "Describe all bindings")
            leader_km.bind("<Space> h p", "describe-extensions", ext_id, description = "Describe extensions")
            leader_km.bind("<Space> h ?", "help-for-help", ext_id, description = "Help overview")
            leader_km.bind("<Space> h .", "helpful-at-point", ext_id, description = "Helpful at point")

            let norm_km = k.ensure_keymap(KEYMAP_VIM_NORMAL)
            norm_km.bind("K", "helpful-at-point", ext_id, description = "Helpful documentation at point")
            norm_km.bind("<F1>", "help-for-help", ext_id, description = "Help for help cheat-sheet")

            let ins_km = k.ensure_keymap(KEYMAP_VIM_INSERT)
            ins_km.bind("<F1>", "help-for-help", ext_id, description = "Help for help cheat-sheet")

            -- 6. `mode:info` Keymap
            let info_km = k.ensure_keymap("mode:info")
            info_km.bind("<Return>", "info-follow-at-point", ext_id, description = "Follow Info link at point")
            info_km.bind("<Tab>", "info-next-link", ext_id, description = "Next Info link")
            info_km.bind("<S-Tab>", "info-prev-link", ext_id, description = "Previous Info link")
            info_km.bind("<BackTab>", "info-prev-link", ext_id, description = "Previous Info link")
            info_km.bind("n", "info-next-node", ext_id, description = "Next Info node")
            info_km.bind("p", "info-prev-node", ext_id, description = "Previous Info node")
            info_km.bind("u", "info-up-node", ext_id, description = "Up to parent Info node")
            info_km.bind("^", "info-up-node", ext_id, description = "Up to parent Info node")
            info_km.bind("t", "info-top-node", ext_id, description = "Top node of manual")
            info_km.bind("d", "info-directory", ext_id, description = "Top Info directory (dir)Top")
            info_km.bind("l", "info-history-back", ext_id, description = "Info history back")
            info_km.bind("H", "info-history-back", ext_id, description = "Info history back")
            info_km.bind("<C-o>", "info-history-back", ext_id, description = "Info history back")
            info_km.bind("r", "info-history-forward", ext_id, description = "Info history forward")
            info_km.bind("L", "info-history-forward", ext_id, description = "Info history forward")
            info_km.bind("g", "info-goto-node", ext_id, description = "Goto Info node")
            info_km.bind("m", "info-menu", ext_id, description = "Select Info menu item")
            info_km.bind("i", "info-index", ext_id, description = "Look up in Info index")
            info_km.bind("s", "info-search", ext_id, description = "Search Info manuals")
            info_km.bind("]", "info-search-next", ext_id, description = "Next Info search hit")
            info_km.bind("[", "info-search-prev", ext_id, description = "Previous Info search hit")
            info_km.bind("?", "help-for-help", ext_id, description = "Help cheat-sheet")
            info_km.bind("q", "info-quit", ext_id, description = "Quit Info")

            -- 7. `mode:apropos` Keymap
            let apropos_km = k.ensure_keymap("mode:apropos")
            apropos_km.bind("<Return>", "apropos-open-at-point", ext_id, description = "Open Info/Help for Apropos hit")
            apropos_km.bind("s", "apropos-goto-source", ext_id, description = "Jump to source file:line")
            apropos_km.bind("o", "apropos-goto-source", ext_id, description = "Jump to source file:line")
            apropos_km.bind("g d", "apropos-goto-source", ext_id, description = "Jump to source file:line")
            apropos_km.bind("<Tab>", "apropos-next-item", ext_id, description = "Next Apropos result")
            apropos_km.bind("n", "apropos-next-item", ext_id, description = "Next Apropos result")
            apropos_km.bind("<S-Tab>", "apropos-prev-item", ext_id, description = "Previous Apropos result")
            apropos_km.bind("<BackTab>", "apropos-prev-item", ext_id, description = "Previous Apropos result")
            apropos_km.bind("p", "apropos-prev-item", ext_id, description = "Previous Apropos result")
            apropos_km.bind("g", "apropos-refresh", ext_id, description = "New Apropos search")
            apropos_km.bind("R", "apropos-refresh", ext_id, description = "New Apropos search")
            apropos_km.bind("q", "apropos-quit", ext_id, description = "Quit Apropos")

            -- 8. `mode:help` Keymap
            let help_km = k.ensure_keymap("mode:help")
            help_km.bind("<Return>", "help-follow-at-point", ext_id, description = "Follow link at point")
            help_km.bind("s", "help-goto-source", ext_id, description = "Jump to source definition")
            help_km.bind("g d", "help-goto-source", ext_id, description = "Jump to source definition")
            help_km.bind("g g", "beginning-of-buffer", ext_id, description = "Beginning of *Help* buffer")
            help_km.bind("e", "help-edit-variable", ext_id, description = "Toggle/edit variable value")
            help_km.bind("i", "info", ext_id, description = "Open Info manual reader")
            help_km.bind("l", "help-history-back", ext_id, description = "Help history back")
            help_km.bind("H", "help-history-back", ext_id, description = "Help history back")
            help_km.bind("<C-o>", "help-history-back", ext_id, description = "Help history back")
            help_km.bind("r", "help-history-forward", ext_id, description = "Help history forward")
            help_km.bind("L", "help-history-forward", ext_id, description = "Help history forward")
            help_km.bind("<Tab>", "help-next-link", ext_id, description = "Next link in *Help*")
            help_km.bind("<S-Tab>", "help-prev-link", ext_id, description = "Previous link in *Help*")
            help_km.bind("<BackTab>", "help-prev-link", ext_id, description = "Previous link in *Help*")
            help_km.bind("q", "help-quit", ext_id, description = "Quit *Help*")

            ()
        },
        |_k: SystemKernel| -> !String Unit { () },
    )
}
