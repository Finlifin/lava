-- ext_lsp: Native JSON-RPC 2.0 Language Server Protocol Client & Dual-Backend Code Intelligence.
-- Publishes `SERVICE_LSP` (`"lava.lsp.service"` -> `LspService`), manages live `@lava_lsp`
-- language server sessions, synchronizes buffer edits/diagnostics/statusline, registers `"lsp"`
-- completions on `ext_cmp`, and provides instant `@lava_accel` + multi-language AST/symbol
-- workspace fallback when external language server binaries are not installed.

use std.collections.{HashMap, Set}
use std.env
use std.fs
use std.path
use std.time
use @lava_sys.{host_read_file_lines, host_write_file_lines, rgb}
use @lava_core.{
    ExtId, InteractiveEffects, KeyStroke, Keymap, PromptKind, PromptRequest,
    SystemKernel, ask_prompt, clipboard_get, clipboard_set, log_event, status_emit
}
