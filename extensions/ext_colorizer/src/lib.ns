-- ext_colorizer: Live True-Color Swatches & 6-Level Cyclic Rainbow Delimiters (`lava.org/ext_colorizer`).
-- Inspired by `nvim-colorizer.lua` and `rainbow-delimiters.nvim`.
-- Publishes service `"lava.colorizer.state"` (`ColorizerService`) with independent layers:
--   - `"ext_colorizer"`: `#RRGGBB`, `#RGB`, `#RRGGBBAA`, `0xRRGGBB`, and `rgb(R, G, B)` swatches
--                        with luminance-adaptive black/white foreground contrast.
--   - `"ext_rainbow"`:   6-level cyclic balanced bracket coloring skipping strings & comments,
--                        with bright red underlined error styling on unmatched closing brackets.

use std.collections.{HashMap, Set}
use @lava_sys.rgb
use @lava_core.{
    ExtId, InteractiveEffects, KeyBindingEntry, Keymap, SystemKernel, status_emit
}
use @ext_document.{
    Buffer, BufferId, BufferKind, EditorWorld, InlineSpanDecor, ext_document_id, require_editor_world
}
use @ext_vim.{KEYMAP_VIM_LEADER, ext_vim_id}

pub const SERVICE_COLORIZER: String = "lava.colorizer.state"
pub const OWNER_COLORIZER: String = "ext_colorizer"
pub const OWNER_RAINBOW: String = "ext_rainbow"

pub fn ext_colorizer_id() -> ExtId = ExtId("lava.org/ext_colorizer")

-- ============================================================================
-- 1. Service State & Palette Constants
-- ============================================================================

struct BufferDecorCache {
    win_start: i64,
    win_end: i64,
    line_count: i64,
    color_count: i64,
    rainbow_rows: Map,
    row_entry_stacks: Map,
    row_exit_stacks: Map,
    checkpoints: Map,
    colors_enabled: bool,
    rainbow_enabled: bool,
    major_mode: String,
    edit_version: i64,
}

pub struct ColorizerService {
    pub colors_enabled: bool,
    pub rainbow_enabled: bool,
    pub cache_by_buf: HashMap,
    pub last_scan_buf_id: BufferId,
    pub last_scan_ver: i64,
}

impl ColorizerService {
    pub fn new() -> ColorizerService {
        ColorizerService {
            colors_enabled: true,
            rainbow_enabled: true,
            cache_by_buf: HashMap.new(),
            last_scan_buf_id: BufferId(0),
            last_scan_ver: -1,
        }
    }

    pub fn invalidate_all(self) {
        self.cache_by_buf = HashMap.new()
        self.last_scan_buf_id = BufferId(0)
        self.last_scan_ver = -1
    }

    pub fn invalidate_buffer(self, buf_id: BufferId) {
        let _ = self.cache_by_buf.remove(buf_id)
        if self.last_scan_buf_id == buf_id {
            self.last_scan_buf_id = BufferId(0)
            self.last_scan_ver = -1
        }
    }
}

pub fn require_colorizer_service(kernel: SystemKernel) -> !String ColorizerService {
    let raw = kernel.require_service(SERVICE_COLORIZER)!
    raw.as(ColorizerService)
}

pub fn rainbow_palette_color(depth: i64) -> i64 {
    let level = ((depth % 6) + 6) % 6
    when {
        level == 0 => rgb(243, 139, 168),
        level == 1 => rgb(250, 179, 135),
        level == 2 => rgb(249, 226, 175),
        level == 3 => rgb(166, 227, 161),
        level == 4 => rgb(137, 180, 250),
        else => rgb(203, 166, 247),
    }
}

pub fn rainbow_unmatched_error_color() -> i64 = rgb(255, 68, 102)

pub fn swatch_contrast_fg(r: i64, g: i64, b: i64) -> i64 {
    let luminance = (299 * r + 587 * g + 114 * b) / 1000
    if luminance >= 140 {
        rgb(17, 17, 27)
    } else {
        rgb(245, 245, 255)
    }
}

-- ============================================================================
-- 2. Lexical Helpers & Feature A: True-Color Swatch Scanner
-- ============================================================================

fn is_ident_char(ch: String) -> bool {
    if ch == "" {
        return false
    }
    ch == "_" or ch.is_alphanumeric()
}

fn hex_digit_val(ch: String) -> i64 {
    when {
        ch == "0" => 0,
        ch == "1" => 1,
        ch == "2" => 2,
        ch == "3" => 3,
        ch == "4" => 4,
        ch == "5" => 5,
        ch == "6" => 6,
        ch == "7" => 7,
        ch == "8" => 8,
        ch == "9" => 9,
        ch == "a" or ch == "A" => 10,
        ch == "b" or ch == "B" => 11,
        ch == "c" or ch == "C" => 12,
        ch == "d" or ch == "D" => 13,
        ch == "e" or ch == "E" => 14,
        ch == "f" or ch == "F" => 15,
        else => -1,
    }
}

fn is_all_hex(token: String) -> bool {
    let n = token.char_len()
    if n == 0 {
        return false
    }
    for i in 0..n {
        if hex_digit_val(token.slice(i, i + 1)) < 0 {
            return false
        }
    }
    true
}

fn parse_hex_byte(two_chars: String) -> i64 {
    let hi = hex_digit_val(two_chars.slice(0, 1))
    let lo = hex_digit_val(two_chars.slice(1, 2))
    hi * 16 + lo
}

fn skip_spaces_in_line(line: String, start: i64, llen: i64) -> i64 {
    var i = start
    while i < llen {
        let ch = line.slice(i, i + 1)
        if ch == " " or ch == "\t" {
            i += 1
        } else {
            break
        }
    }
    i
}

fn parse_rgb_component(line: String, start: i64, llen: i64) -> ?(i64, i64) {
    let i0 = skip_spaces_in_line(line, start, llen)
    var i = i0
    var val: i64 = 0
    var digits: i64 = 0
    while i < llen and digits < 4 {
        let ch = line.slice(i, i + 1)
        let d = hex_digit_val(ch)
        if d >= 0 and d <= 9 {
            val = val * 10 + d
            digits += 1
            i += 1
        } else {
            break
        }
    }
    if digits == 0 or digits > 3 or val < 0 or val > 255 {
        return null
    }
    -- Reject trailing identifier characters like `10px` or `100_000`
    if i < llen and is_ident_char(line.slice(i, i + 1)) {
        return null
    }
    let next_i = skip_spaces_in_line(line, i, llen)
    (val, next_i)
}

-- Try to parse `rgb(R, G, B)` at `col`, returning `?(end_col, r, g, b)`.
fn try_parse_rgb_call(line: String, col: i64, llen: i64) -> ?(i64, i64, i64, i64) {
    if col + 9 > llen {
        return null
    }
    let head = line.slice(col, col + 4)
    if head != "rgb(" and head != "RGB(" {
        return null
    }
    let r_res? = parse_rgb_component(line, col + 4, llen) else {
        return null
    }
    let (r, after_r) = r_res
    if after_r >= llen or line.slice(after_r, after_r + 1) != "," {
        return null
    }
    let g_res? = parse_rgb_component(line, after_r + 1, llen) else {
        return null
    }
    let (g, after_g) = g_res
    if after_g >= llen or line.slice(after_g, after_g + 1) != "," {
        return null
    }
    let b_res? = parse_rgb_component(line, after_g + 1, llen) else {
        return null
    }
    let (b, after_b) = b_res
    if after_b >= llen or line.slice(after_b, after_b + 1) != ")" {
        return null
    }
    (after_b + 1, r, g, b)
}

fn is_prose_markup_mode(mode_low: String) -> bool {
    mode_low == "markdown"
        or mode_low == "md"
        or mode_low == "gfm"
        or mode_low == "org"
        or mode_low == "text"
        or mode_low == "plaintext"
}

fn is_all_ascii_digits(s: String) -> bool {
    let n = s.len()
    if n == 0 {
        return false
    }
    var i: i64 = 0
    while i < n {
        let b = s.byte_at(i)
        if b < 48 or b > 57 {
            return false
        }
        i += 1
    }
    true
}

fn md_fence_open_spec(line: String) -> ?(i64, i64, String) {
    let blen = line.len()
    var sp: i64 = 0
    while sp < blen and sp < 12 and (line.byte_at(sp) == 32 or line.byte_at(sp) == 9 or line.byte_at(sp) == 62) {
        sp += 1
    }
    if sp + 3 > blen {
        return null
    }
    let fc = line.byte_at(sp)
    if fc != 96 and fc != 126 {
        return null
    }
    var flen: i64 = 0
    while sp + flen < blen and line.byte_at(sp + flen) == fc {
        flen += 1
    }
    if flen < 3 {
        return null
    }
    let rest = line.drop(sp + flen).trim()
    if fc == 96 and rest.contains("`") {
        return null
    }
    (fc, flen, rest.to_lower())
}

fn md_fence_is_close(line: String, fc: i64, min_len: i64) -> bool {
    let blen = line.len()
    var sp: i64 = 0
    while sp < blen and sp < 12 and (line.byte_at(sp) == 32 or line.byte_at(sp) == 9 or line.byte_at(sp) == 62) {
        sp += 1
    }
    var flen: i64 = 0
    while sp + flen < blen and line.byte_at(sp + flen) == fc {
        flen += 1
    }
    if flen < min_len {
        return false
    }
    var k = sp + flen
    while k < blen {
        let b = line.byte_at(k)
        if b != 32 and b != 9 {
            return false
        }
        k += 1
    }
    true
}

-- Try to parse `#RGB`, `#RRGGBB`, or `#RRGGBBAA` at `col`, returning `?(end_col, r, g, b)`.
fn try_parse_hash_hex(line: String, col: i64, llen: i64) -> ?(i64, i64, i64, i64) {
    if col + 4 > llen or line.slice(col, col + 1) != "#" {
        return null
    }
    if col > 0 and is_ident_char(line.slice(col - 1, col)) {
        return null
    }
    var end_col = col + 1
    while end_col < llen and is_ident_char(line.slice(end_col, end_col + 1)) {
        end_col += 1
    }
    let token = line.slice(col + 1, end_col)
    let tlen = token.char_len()
    if tlen != 3 and tlen != 6 and tlen != 8 {
        return null
    }
    if not is_all_hex(token) {
        return null
    }
    if tlen == 3 {
        let r = hex_digit_val(token.slice(0, 1)) * 17
        let g = hex_digit_val(token.slice(1, 2)) * 17
        let b = hex_digit_val(token.slice(2, 3)) * 17
        return (end_col, r, g, b)
    }
    let r = parse_hex_byte(token.slice(0, 2))
    let g = parse_hex_byte(token.slice(2, 4))
    let b = parse_hex_byte(token.slice(4, 6))
    (end_col, r, g, b)
}

-- Try to parse `0xRRGGBB` / `0XRRGGBB` at `col`, returning `?(end_col, r, g, b)`.
fn try_parse_zero_x_hex(line: String, col: i64, llen: i64) -> ?(i64, i64, i64, i64) {
    if col + 8 > llen {
        return null
    }
    let pfx = line.slice(col, col + 2)
    if pfx != "0x" and pfx != "0X" {
        return null
    }
    if col > 0 and is_ident_char(line.slice(col - 1, col)) {
        return null
    }
    var end_col = col + 2
    while end_col < llen and is_ident_char(line.slice(end_col, end_col + 1)) {
        end_col += 1
    }
    let token = line.slice(col + 2, end_col)
    if token.char_len() != 6 or (not is_all_hex(token)) {
        return null
    }
    let r = parse_hex_byte(token.slice(0, 2))
    let g = parse_hex_byte(token.slice(2, 4))
    let b = parse_hex_byte(token.slice(4, 6))
    (end_col, r, g, b)
}

fn decorate_line_color_swatches(buf: Buffer, row: i64, line: String, prose_mode: bool) -> i64 {
    let llen = line.char_len()
    var added: i64 = 0
    var c: i64 = 0
    while c < llen {
        let ch = line.slice(c, c + 1)
        if ch == "#" {
            let hit_opt = try_parse_hash_hex(line, c, llen)
            if hit_opt != null {
                let (ec, r, g, b) = hit_opt.as((i64, i64, i64, i64))
                let tok = line.slice(c + 1, ec)
                -- In Markdown/Org prose, avoid turning GitHub issue numbers (`#123`) or `#anchor` links into `#RGB` swatches!
                let skip_prose_short = prose_mode
                    and tok.char_len() == 3
                    and (is_all_ascii_digits(tok) or (c > 0 and line.slice(c - 1, c) == "("))
                if not skip_prose_short {
                    buf.add_inline_decor(
                        OWNER_COLORIZER,
                        row,
                        c,
                        ec,
                        bg_rgba = rgb(r, g, b),
                        fg_rgba = swatch_contrast_fg(r, g, b),
                        underline = false,
                    )
                    added += 1
                    c = ec
                    continue
                }
            }
            c += 1
            continue
        }
        if ch == "0" and c + 8 <= llen {
            let hit_opt = try_parse_zero_x_hex(line, c, llen)
            if hit_opt != null {
                let (ec, r, g, b) = hit_opt.as((i64, i64, i64, i64))
                buf.add_inline_decor(
                    OWNER_COLORIZER,
                    row,
                    c,
                    ec,
                    bg_rgba = rgb(r, g, b),
                    fg_rgba = swatch_contrast_fg(r, g, b),
                    underline = false,
                )
                added += 1
                c = ec
                continue
            }
        }
        if (ch == "r" or ch == "R") and (c == 0 or (not is_ident_char(line.slice(c - 1, c)))) {
            let hit_opt = try_parse_rgb_call(line, c, llen)
            if hit_opt != null {
                let (ec, r, g, b) = hit_opt.as((i64, i64, i64, i64))
                buf.add_inline_decor(
                    OWNER_COLORIZER,
                    row,
                    c,
                    ec,
                    bg_rgba = rgb(r, g, b),
                    fg_rgba = swatch_contrast_fg(r, g, b),
                    underline = false,
                )
                added += 1
                c = ec
                continue
            }
        }
        c += 1
    }
    added
}

-- ============================================================================
-- 3. Feature B: 6-Level Cyclic Rainbow Delimiters (`owner = "ext_rainbow"`)
-- ============================================================================

fn matching_open_for_close(close_ch: String) -> String {
    when {
        close_ch == ")" => "(",
        close_ch == "]" => "[",
        close_ch == "}}" => "{{",
        else => "",
    }
}

fn find_closing_single_quote(line: String, open_col: i64, llen: i64) -> i64 {
    var i = open_col + 1
    while i < llen {
        let ch = line.slice(i, i + 1)
        if ch == "\\" {
            i += 2
            continue
        }
        if ch == "'" {
            return i
        }
        i += 1
    }
    -1
}

fn is_hash_comment_start(line: String, col: i64, llen: i64, mode_low: String) -> bool {
    if mode_low == "rust"
        or mode_low == "rs"
        or mode_low == "c"
        or mode_low == "cpp"
        or mode_low == "go"
        or mode_low == "java"
        or mode_low == "javascript"
        or mode_low == "js"
        or mode_low == "typescript"
        or mode_low == "ts"
        or mode_low == "tsx"
        or mode_low == "jsx"
        or mode_low == "lua"
        or mode_low == "css"
        or mode_low == "scss"
        or mode_low == "json"
        or mode_low == "jsonc" {
        return false
    }
    -- Never treat valid `#RGB`, `#RRGGBB`, or `#RRGGBBAA` color literals as comments!
    if try_parse_hash_hex(line, col, llen) != null {
        return false
    }
    if mode_low == "python"
        or mode_low == "py"
        or mode_low == "shell"
        or mode_low == "sh"
        or mode_low == "bash"
        or mode_low == "zsh"
        or mode_low == "fish"
        or mode_low == "toml"
        or mode_low == "yaml"
        or mode_low == "yml"
        or mode_low == "makefile"
        or mode_low == "cmake"
        or mode_low == "dockerfile"
        or mode_low == "ruby"
        or mode_low == "perl"
        or mode_low == "nix"
        or mode_low == "conf" {
        return true
    }
    -- In Nessa (`#[eff]`, `#Eff`, `call()#`), `#` is the algebraic effect operator!
    -- Only treat `# ` / `#\t` (with whitespace before & after) or col-0 `#!` shebang as a comment.
    let at_boundary = col == 0 or line.slice(col - 1, col) == " " or line.slice(col - 1, col) == "\t"
    if not at_boundary {
        return false
    }
    if col + 1 >= llen {
        return col == 0
    }
    let next_ch = line.slice(col + 1, col + 2)
    next_ch == " " or next_ch == "\t" or (col == 0 and next_ch == "!")
}

fn is_double_dash_comment_mode(mode_low: String) -> bool {
    mode_low != "c"
        and mode_low != "cpp"
        and mode_low != "rust"
        and mode_low != "rs"
        and mode_low != "go"
        and mode_low != "javascript"
        and mode_low != "js"
        and mode_low != "typescript"
        and mode_low != "ts"
        and mode_low != "tsx"
        and mode_low != "jsx"
        and mode_low != "java"
        and mode_low != "python"
        and mode_low != "py"
        and mode_low != "sh"
        and mode_low != "shell"
        and mode_low != "bash"
}

fn is_backtick_string_mode(mode_low: String) -> bool {
    mode_low == "go"
        or mode_low == "javascript"
        or mode_low == "js"
        or mode_low == "typescript"
        or mode_low == "ts"
        or mode_low == "tsx"
        or mode_low == "jsx"
        or mode_low == "sh"
        or mode_low == "shell"
        or mode_low == "bash"
        or mode_low == "sql"
        or mode_low == "markdown"
        or mode_low == "md"
        or mode_low == "gfm"
}

-- Recognize Rust raw string opening at `col` (`r"..."`, `r#"..."#`, `br#"..."#`, `cr#"..."#`),
-- returning `?(after_open_col, closing_delim)`.
fn try_match_rust_raw_str(line: String, col: i64, llen: i64) -> ?(i64, String) {
    if col > 0 and is_ident_char(line.slice(col - 1, col)) {
        return null
    }
    let ch0 = line.slice(col, col + 1)
    var p_len: i64 = 0
    if ch0 == "r" {
        p_len = 1
    } else if (ch0 == "b" or ch0 == "c") and col + 1 < llen and line.slice(col + 1, col + 2) == "r" {
        p_len = 2
    } else {
        return null
    }
    var idx = col + p_len
    var hashes = ""
    while idx < llen and line.slice(idx, idx + 1) == "#" {
        hashes = hashes ++ "#"
        idx += 1
    }
    if idx < llen and line.slice(idx, idx + 1) == "\"" {
        return (idx + 1, "\"" ++ hashes)
    }
    null
}

-- Recognize Rust char / byte-char literal `'x'`, `'\n'`, `'\''`, `'\x7f'`, `'\u{10FFFF}'` at `'`,
-- returning end_col (exclusive) or -1 if it is a lifetime (`'a`, `'static`).
fn match_rust_char_end(line: String, quote_col: i64, llen: i64) -> i64 {
    if quote_col + 2 >= llen {
        return -1
    }
    let c1 = line.slice(quote_col + 1, quote_col + 2)
    if c1 == "'" {
        return -1
    }
    if c1 != "\\" {
        if line.slice(quote_col + 2, quote_col + 3) == "'" {
            return quote_col + 3
        }
        return -1
    }
    var i = quote_col + 2
    var limit = quote_col + 14
    if limit > llen {
        limit = llen
    }
    while i < limit {
        let ch = line.slice(i, i + 1)
        if ch == "'" {
            return i + 1
        }
        if ch == " " or ch == "\t" {
            return -1
        }
        i += 1
    }
    -1
}

fn clone_rainbow_stack(src: List) -> List {
    let out = List()
    for i in 0..src.len() {
        out.push(src.get(i.as(usize)))
    }
    out
}

fn rainbow_stacks_equal(a: List, b: List) -> bool {
    if a.len() != b.len() {
        return false
    }
    for i in 0..a.len() {
        let (ca, da) = a.get(i.as(usize)).as((String, i64))
        let (cb, db) = b.get(i.as(usize)).as((String, i64))
        if ca != cb or da != db {
            return false
        }
    }
    true
}

fn scan_single_line_rainbow(
    line: String,
    r: i64,
    eff_mode: String,
    dash_cmt: bool,
    err_col: i64,
    stack: List,
    ml_end_in: String,
    ml_esc_in: bool,
    stack_anchored: bool,
    emit_decors: bool,
    out_decors: List,
) -> (String, bool, bool) {
    var ml_end = ml_end_in
    var ml_esc = ml_esc_in
    if ml_end == "" {
        let lead = line.trim_start()
        if lead.starts_with("//") or (dash_cmt and lead.starts_with("--") and (not lead.starts_with("--[["))) {
            return ("", false, false)
        }
        if (not line.contains("("))
            and (not line.contains(")"))
            and (not line.contains("["))
            and (not line.contains("]"))
            and (not line.contains("{{"))
            and (not line.contains("}}"))
            and (not line.contains("/*"))
            and (not line.contains("--[["))
            and (not line.contains("\""))
            and (not line.contains("'"))
            and (not line.contains("`")) {
            return ("", false, false)
        }
    }
    if ml_end == ""
        and line.is_ascii()
        and (not line.contains("\""))
        and (not line.contains("'"))
        and (not line.contains("`"))
        and (not line.contains("//"))
        and (not line.contains("/*"))
        and (not line.contains("#"))
        and ((not dash_cmt) or (not line.contains("--"))) {
        let blen = line.len()
        var touched_ascii = false
        for idx in 0..blen {
            let b = line.byte_at(idx)
            if b == 40 or b == 91 or b == 123 {
                touched_ascii = true
                let open_str = if b == 40 { "(" } else if b == 91 { "[" } else { "{{" }
                let depth = stack.len()
                stack.push((open_str, depth))
                if emit_decors {
                    out_decors.push((r, idx, idx + 1, rainbow_palette_color(depth), false))
                }
            } else if b == 41 or b == 93 or b == 125 {
                touched_ascii = true
                let want = if b == 41 { "(" } else if b == 93 { "[" } else { "{{" }
                if stack.is_empty() {
                    if emit_decors {
                        if stack_anchored {
                            out_decors.push((r, idx, idx + 1, err_col, true))
                        } else {
                            out_decors.push((r, idx, idx + 1, rainbow_palette_color(0), false))
                        }
                    }
                } else {
                    let top_idx = (stack.len() - 1).as(usize)
                    let (open_ch, open_depth) = stack.get(top_idx).as((String, i64))
                    if open_ch == want {
                        let _ = stack.pop()
                        if emit_decors {
                            out_decors.push((r, idx, idx + 1, rainbow_palette_color(open_depth), false))
                        }
                    } else {
                        if emit_decors {
                            out_decors.push((r, idx, idx + 1, err_col, true))
                        }
                        if stack.len() >= 2 {
                            let (below_ch, _) = stack.get((stack.len() - 2).as(usize)).as((String, i64))
                            if below_ch == want {
                                let _ = stack.pop()
                                let _ = stack.pop()
                            } else if open_ch != "{{" and want != "{{" {
                                let _ = stack.pop()
                            }
                        } else if open_ch != "{{" and want != "{{" {
                            let _ = stack.pop()
                        }
                    }
                }
            }
        }
        return ("", false, touched_ascii)
    }

    let llen = line.char_len()
    let is_rust = eff_mode == "rust" or eff_mode == "rs"
    let backtick_ok = is_backtick_string_mode(eff_mode)
    var touched = false
    var c: i64 = 0
    while c < llen {
        if ml_end != "" {
            touched = true
            if ml_esc and line.slice(c, c + 1) == "\\" {
                c += 2
                continue
            }
            let elen = ml_end.char_len()
            if c + elen <= llen and line.slice(c, c + elen) == ml_end {
                ml_end = ""
                ml_esc = false
                c += elen
            } else {
                c += 1
            }
            continue
        }

        if dash_cmt and c + 4 <= llen and line.slice(c, c + 4) == "--[[" {
            touched = true
            ml_end = "]]"
            ml_esc = false
            c += 4
            continue
        }
        if c + 2 <= llen and line.slice(c, c + 2) == "/*" {
            touched = true
            ml_end = "*/"
            ml_esc = false
            c += 2
            continue
        }

        if dash_cmt and c + 2 <= llen and line.slice(c, c + 2) == "--" {
            break
        }
        if c + 2 <= llen and line.slice(c, c + 2) == "//" {
            break
        }

        let ch = line.slice(c, c + 1)
        if ch == "#" and is_hash_comment_start(line, c, llen, eff_mode) {
            break
        }

        if is_rust {
            if (ch == "r" or ch == "b" or ch == "c") {
                let raw_opt = try_match_rust_raw_str(line, c, llen)
                if raw_opt != null {
                    let (after_c, close_d) = raw_opt.as((i64, String))
                    touched = true
                    ml_end = close_d
                    ml_esc = false
                    c = after_c
                    continue
                }
                if ch == "b" and c + 1 < llen and line.slice(c + 1, c + 2) == "'" and (c == 0 or (not is_ident_char(line.slice(c - 1, c)))) {
                    let bch_end = match_rust_char_end(line, c + 1, llen)
                    if bch_end > c {
                        c = bch_end
                        continue
                    }
                }
            }
        }

        if c + 3 <= llen {
            let tri = line.slice(c, c + 3)
            if tri == "\"\"\"" or (tri == "'''" and (not is_rust)) {
                touched = true
                ml_end = tri
                ml_esc = true
                c += 3
                continue
            }
        }

        if backtick_ok and ch == "`" {
            touched = true
            ml_end = "`"
            ml_esc = eff_mode != "go" and eff_mode != "sql"
            c += 1
            continue
        }

        if ch == "\"" {
            c += 1
            let lb = "{{"
            let rb = "}}"
            let nessa_interp = eff_mode == "nessa" or eff_mode == ""
            var interp_depth: i64 = 0
            var closed_q = false
            var ended_with_bs = false
            while c < llen {
                let sch = line.slice(c, c + 1)
                if sch == "\\" {
                    if c + 1 >= llen {
                        ended_with_bs = true
                        c += 1
                        break
                    }
                    c += 2
                    continue
                }
                if nessa_interp {
                    if interp_depth == 0 {
                        if c + 2 <= llen and (line.slice(c, c + 2) == lb ++ lb or line.slice(c, c + 2) == rb ++ rb) {
                            c += 2
                            continue
                        }
                        if sch == lb {
                            interp_depth = 1
                            c += 1
                            continue
                        }
                    } else {
                        if sch == "\"" {
                            c += 1
                            while c < llen {
                                let nch = line.slice(c, c + 1)
                                if nch == "\\" {
                                    c += 2
                                    continue
                                }
                                c += 1
                                if nch == "\"" {
                                    break
                                }
                            }
                            continue
                        }
                        if sch == lb {
                            interp_depth += 1
                            c += 1
                            continue
                        }
                        if sch == rb {
                            interp_depth -= 1
                            c += 1
                            continue
                        }
                    }
                }
                if interp_depth == 0 and sch == "\"" {
                    closed_q = true
                    c += 1
                    break
                }
                c += 1
            }
            if (not closed_q) and (ended_with_bs or is_rust) {
                touched = true
                ml_end = "\""
                ml_esc = true
            }
            continue
        }

        if ch == "'" {
            if is_rust {
                let ch_end = match_rust_char_end(line, c, llen)
                if ch_end > c {
                    c = ch_end
                    continue
                }
            } else if c == 0 or (not line.slice(c - 1, c).is_alphanumeric()) {
                let close_q = find_closing_single_quote(line, c, llen)
                if close_q > c {
                    c = close_q + 1
                    continue
                }
            }
        }

        if ch == "(" or ch == "[" or ch == "{{" {
            touched = true
            let depth = stack.len()
            stack.push((ch, depth))
            if emit_decors {
                out_decors.push((r, c, c + 1, rainbow_palette_color(depth), false))
            }
        } else if ch == ")" or ch == "]" or ch == "}}" {
            touched = true
            let want = matching_open_for_close(ch)
            if stack.is_empty() {
                if emit_decors {
                    if stack_anchored {
                        out_decors.push((r, c, c + 1, err_col, true))
                    } else {
                        out_decors.push((r, c, c + 1, rainbow_palette_color(0), false))
                    }
                }
            } else {
                let top_idx = (stack.len() - 1).as(usize)
                let (open_ch, open_depth) = stack.get(top_idx).as((String, i64))
                if open_ch == want {
                    let _ = stack.pop()
                    if emit_decors {
                        out_decors.push((r, c, c + 1, rainbow_palette_color(open_depth), false))
                    }
                } else {
                    if emit_decors {
                        out_decors.push((r, c, c + 1, err_col, true))
                    }
                    if stack.len() >= 2 {
                        let (below_ch, _) = stack.get((stack.len() - 2).as(usize)).as((String, i64))
                        if below_ch == want {
                            let _ = stack.pop()
                            let _ = stack.pop()
                        }
                    }
                }
            }
        }
        c += 1
    }
    (ml_end, ml_esc, touched)
}

const RAINBOW_CHECKPOINT_STRIDE: i64 = 128
const RAINBOW_MAX_FULL_ANCHOR_ROW: i64 = 16384

fn decorate_buffer_rainbow(
    buf: Buffer,
    win_start: i64,
    win_end: i64,
    seed_checkpoints: Map,
) -> (Map, Map, Map, Map) {
    let touched_rows = Map.new()
    let entry_stacks = Map.new()
    let exit_stacks = Map.new()
    let out_checkpoints = Map.new()
    for cp_k in seed_checkpoints.keys() {
        out_checkpoints.set(cp_k, seed_checkpoints.get(cp_k))
    }

    let mode_low = buf.major_mode.to_lower()
    if mode_low == "org" or mode_low == "text" or mode_low == "plaintext" or mode_low == "info" or mode_low == "help" {
        return (touched_rows, entry_stacks, exit_stacks, out_checkpoints)
    }
    let is_md = mode_low == "markdown" or mode_low == "md" or mode_low == "gfm"
    var stack = List()
    var ml_end = ""
    var ml_esc = false
    var stack_anchored = true
    let err_col = rainbow_unmatched_error_color()
    var in_md_fence = false
    var md_fc: i64 = 0
    var md_flen: i64 = 0
    var fence_mode = mode_low

    var scan_from: i64 = 0
    if not is_md {
        var cand_cp = (win_start / RAINBOW_CHECKPOINT_STRIDE) * RAINBOW_CHECKPOINT_STRIDE
        while cand_cp > 0 {
            let cp_key = cand_cp.to_string()
            if out_checkpoints.contains(cp_key) {
                let (cp_stack, cp_ml_end, cp_ml_esc) = out_checkpoints.get(cp_key).as((List, String, bool))
                stack = clone_rainbow_stack(cp_stack)
                ml_end = cp_ml_end
                ml_esc = cp_ml_esc
                scan_from = cand_cp
                stack_anchored = true
                break
            }
            cand_cp -= RAINBOW_CHECKPOINT_STRIDE
        }
        if scan_from == 0 and win_start > RAINBOW_MAX_FULL_ANCHOR_ROW {
            scan_from = win_start - RAINBOW_CHECKPOINT_STRIDE
            stack_anchored = false
        }
    }

    let pending_decors = List()
    let lines = if win_end > scan_from { buf.slice_lines(scan_from, win_end) } else { List() }
    for r in scan_from..win_end {
        if (not is_md) and stack_anchored and r > 0 and (r % RAINBOW_CHECKPOINT_STRIDE == 0) {
            out_checkpoints.set(r.to_string(), (clone_rainbow_stack(stack), ml_end, ml_esc))
        }
        let line = lines.get((r - scan_from).as(usize)).as(String)
        let r_key = r.to_string()
        if is_md {
            if not in_md_fence {
                let f_opt = md_fence_open_spec(line)
                if f_opt != null {
                    let (fc, fl, flang) = f_opt.as((i64, i64, String))
                    in_md_fence = true
                    md_fc = fc
                    md_flen = fl
                    fence_mode = flang
                    while not stack.is_empty() {
                        let _ = stack.pop()
                    }
                    ml_end = ""
                    ml_esc = false
                    touched_rows.set(r_key, true)
                }
                continue
            } else if md_fence_is_close(line, md_fc, md_flen) {
                in_md_fence = false
                fence_mode = mode_low
                while not stack.is_empty() {
                    let _ = stack.pop()
                }
                ml_end = ""
                ml_esc = false
                touched_rows.set(r_key, true)
                continue
            }
        }
        let eff_mode = if is_md { fence_mode } else { mode_low }
        let dash_cmt = is_double_dash_comment_mode(eff_mode)
        let emit_row = r >= win_start
        if emit_row and (not is_md) and ml_end == "" and stack_anchored {
            entry_stacks.set(r_key, clone_rainbow_stack(stack))
        }
        let (next_ml_end, next_ml_esc, row_touched) = scan_single_line_rainbow(
            line,
            r,
            eff_mode,
            dash_cmt,
            err_col,
            stack,
            ml_end,
            ml_esc,
            stack_anchored,
            emit_row,
            pending_decors,
        )
        if row_touched {
            touched_rows.set(r_key, true)
        }
        if emit_row and (not is_md) and ml_end == "" and next_ml_end == "" and stack_anchored {
            exit_stacks.set(r_key, clone_rainbow_stack(stack))
        } else if emit_row and (not is_md) {
            let _ = entry_stacks.remove(r_key)
        }
        ml_end = next_ml_end
        ml_esc = next_ml_esc
    }

    for i in 0..pending_decors.len() {
        let (dr, sc, ec, fg, ul) = pending_decors.get(i.as(usize)).as((i64, i64, i64, i64, bool))
        buf.add_inline_decor(
            OWNER_RAINBOW,
            dr,
            sc,
            ec,
            bg_rgba = 0,
            fg_rgba = fg,
            underline = ul,
        )
    }
    (touched_rows, entry_stacks, exit_stacks, out_checkpoints)
}

-- ============================================================================
-- 4. Buffer Refresh, Caching & Extension Registration (`lava.org/ext_colorizer`)
-- ============================================================================

fn is_colorizable_buffer(buf: Buffer) -> bool {
    buf.kind != BufferKind.special and buf.kind != BufferKind.directory
}

fn line_may_have_color(line: String) -> bool {
    line.contains("#")
        or line.contains("0x")
        or line.contains("0X")
        or line.contains("rgb")
        or line.contains("RGB")
        or line.contains("hsl")
        or line.contains("HSL")
}

fn line_has_rainbow_syntax(line: String) -> bool {
    line.contains("(")
        or line.contains(")")
        or line.contains("[")
        or line.contains("]")
        or line.contains("{{")
        or line.contains("}}")
        or line.contains("/*")
        or line.contains("*/")
        or line.contains("--[[")
        or line.contains("```")
        or line.contains("~~~")
        or line.contains("\"\"\"")
        or line.contains("'''")
        or line.contains("`")
        or line.contains("r#\"")
        or line.contains("br#\"")
}

fn filter_checkpoints_up_to(src: Map, max_row_inclusive: i64) -> Map {
    let out = Map.new()
    for k in src.keys() {
        let k_str = k.as(String)
        let r_opt = k_str.try_parse(i64)
        if r_opt != null and r_opt.as(i64) <= max_row_inclusive {
            out.set(k_str, src.get(k_str))
        }
    }
    out
}

fn compute_scan_window(world: EditorWorld, buf: Buffer) -> (i64, i64) {
    let lcount = buf.line_count()
    if lcount <= 300 {
        return (0, lcount)
    }
    let vrows = if world.viewport_rows > 0 { world.viewport_rows } else { 36 }
    let raw_start = world.viewport_top_row - 24
    let win_start = if raw_start > 0 { raw_start } else { 0 }
    let raw_end = world.viewport_top_row + vrows + 32
    let win_end = if raw_end < lcount { raw_end } else { lcount }
    (win_start, win_end)
}

fn colorizer_viewport_covered(world: EditorWorld, lcount: i64, win_start: i64, win_end: i64) -> bool {
    if lcount <= 300 {
        return win_start == 0 and win_end == lcount
    }
    let top = if world.viewport_top_row > 0 { world.viewport_top_row } else { 0 }
    let vrows = if world.viewport_rows > 0 { world.viewport_rows } else { 36 }
    let vis_end = if top + vrows < lcount { top + vrows } else { lcount }
    let top_ok = win_start == 0 or top >= win_start + 8
    let bot_ok = win_end >= lcount or vis_end <= win_end - 8
    top_ok and bot_ok
}

pub fn refresh_buffer_colorizer(
    world: EditorWorld,
    service: ColorizerService,
    buf: Buffer,
    force: bool,
) {
    if not is_colorizable_buffer(buf) {
        buf.clear_owner_decors(OWNER_COLORIZER)
        buf.clear_owner_decors(OWNER_RAINBOW)
        service.invalidate_buffer(buf.id)
        return
    }

    buf.sync_external_lines()
    let lcount = buf.line_count()
    var skip_color_scan = false
    var skip_rainbow_scan = false
    var prev_color_count: i64 = 0
    var prev_rainbow_rows = Map.new()
    var prev_entry_stacks = Map.new()
    var prev_exit_stacks = Map.new()
    var seed_checkpoints = Map.new()

    if not force {
        let cached_opt = service.cache_by_buf.get(buf.id)
        if cached_opt != null {
            let cached = cached_opt.as(BufferDecorCache)
            let covered = colorizer_viewport_covered(world, lcount, cached.win_start, cached.win_end)
            let same_cfg = cached.colors_enabled == service.colors_enabled
                and cached.rainbow_enabled == service.rainbow_enabled
                and cached.major_mode == buf.major_mode
            if same_cfg {
                if cached.edit_version == buf.edit_version {
                    seed_checkpoints = cached.checkpoints
                } else {
                    seed_checkpoints = filter_checkpoints_up_to(cached.checkpoints, buf.point.row)
                }
            }
            if same_cfg and covered {
                if cached.edit_version == buf.edit_version
                    or (service.last_scan_buf_id == buf.id and service.last_scan_ver == buf.edit_version) {
                    service.last_scan_buf_id = buf.id
                    service.last_scan_ver = buf.edit_version
                    return
                }

                let cur_row = buf.point.row
                let cur_line = buf.line_at(cur_row)
                let ldelta = lcount - cached.line_count
                if cached.color_count == 0 and (ldelta == 0 or ldelta == 1) {
                    let prev_line_ok = if ldelta == 1 and cur_row > 0 {
                        not line_may_have_color(buf.line_at(cur_row - 1))
                    } else {
                        true
                    }
                    if (not line_may_have_color(cur_line)) and prev_line_ok {
                        skip_color_scan = true
                        prev_color_count = 0
                    }
                }
                let cur_row_key = cur_row.to_string()
                let mode_low = buf.major_mode.to_lower()
                let is_pure_slash_cmt = (not is_double_dash_comment_mode(mode_low))
                    and mode_low != "markdown"
                    and mode_low != "md"
                    and mode_low != "gfm"
                    and mode_low != "python"
                    and mode_low != "py"
                    and mode_low != "sh"
                    and mode_low != "shell"
                    and mode_low != "bash"
                    and mode_low != "toml"
                    and mode_low != "yaml"
                    and cur_line.trim_start().starts_with("//")
                    and (not cur_line.contains("/*"))
                    and (not cur_line.contains("*/"))
                if (not service.rainbow_enabled)
                    or (
                        ldelta == 0
                        and (not cached.rainbow_rows.contains(cur_row_key))
                        and (is_pure_slash_cmt or (not line_has_rainbow_syntax(cur_line)))
                    ) {
                    skip_rainbow_scan = true
                    prev_rainbow_rows = cached.rainbow_rows
                    prev_entry_stacks = cached.row_entry_stacks
                    prev_exit_stacks = cached.row_exit_stacks
                } else if ldelta == 0 and cached.row_entry_stacks.contains(cur_row_key) and cached.row_exit_stacks.contains(cur_row_key) {
                    let is_md = mode_low == "markdown" or mode_low == "md" or mode_low == "gfm"
                    if not is_md {
                        let work_stack = clone_rainbow_stack(cached.row_entry_stacks.get(cur_row_key).as(List))
                        let row_decors = List()
                        let (ml_after, _, row_touched) = scan_single_line_rainbow(
                            cur_line,
                            cur_row,
                            mode_low,
                            is_double_dash_comment_mode(mode_low),
                            rainbow_unmatched_error_color(),
                            work_stack,
                            "",
                            false,
                            true,
                            true,
                            row_decors,
                        )
                        let prev_exit = cached.row_exit_stacks.get(cur_row_key).as(List)
                        if ml_after == "" and rainbow_stacks_equal(work_stack, prev_exit) {
                            let had_prev_row = cached.rainbow_rows.contains(cur_row_key)
                            if had_prev_row or (not row_decors.is_empty()) {
                                if had_prev_row {
                                    let kept = List()
                                    for di in 0..buf.inline_decors.len() {
                                        let d = buf.inline_decors.get(di.as(usize)).as(InlineSpanDecor)
                                        if not (d.owner == OWNER_RAINBOW and d.row == cur_row) {
                                            kept.push(d)
                                        }
                                    }
                                    buf.inline_decors = kept
                                    buf.tracked_inline_len = kept.len()
                                    buf.decor_gen += 1
                                }
                                for ri in 0..row_decors.len() {
                                    let (dr, sc, ec, fg, ul) = row_decors.get(ri.as(usize)).as((i64, i64, i64, i64, bool))
                                    buf.add_inline_decor(OWNER_RAINBOW, dr, sc, ec, bg_rgba = 0, fg_rgba = fg, underline = ul)
                                }
                            }
                            if row_touched {
                                cached.rainbow_rows.set(cur_row_key, true)
                            } else if had_prev_row {
                                let _ = cached.rainbow_rows.remove(cur_row_key)
                            }
                            skip_rainbow_scan = true
                            prev_rainbow_rows = cached.rainbow_rows
                            prev_entry_stacks = cached.row_entry_stacks
                            prev_exit_stacks = cached.row_exit_stacks
                            seed_checkpoints = cached.checkpoints
                        }
                    }
                }

                if skip_color_scan and skip_rainbow_scan {
                    service.cache_by_buf.insert(buf.id, BufferDecorCache {
                        win_start: cached.win_start,
                        win_end: if lcount <= 300 { lcount } else { cached.win_end },
                        line_count: lcount,
                        color_count: prev_color_count,
                        rainbow_rows: prev_rainbow_rows,
                        row_entry_stacks: prev_entry_stacks,
                        row_exit_stacks: prev_exit_stacks,
                        checkpoints: seed_checkpoints,
                        colors_enabled: service.colors_enabled,
                        rainbow_enabled: service.rainbow_enabled,
                        major_mode: buf.major_mode,
                        edit_version: buf.edit_version,
                    })
                    service.last_scan_buf_id = buf.id
                    service.last_scan_ver = buf.edit_version
                    return
                }
            }
        }
    }

    let (win_start, win_end) = compute_scan_window(world, buf)
    var color_count = prev_color_count
    if not skip_color_scan {
        buf.clear_owner_decors(OWNER_COLORIZER)
        color_count = 0
        if service.colors_enabled {
            let prose_mode = is_prose_markup_mode(buf.major_mode.to_lower())
            for r in win_start..win_end {
                let line = buf.line_at(r)
                if line_may_have_color(line) {
                    color_count += decorate_line_color_swatches(buf, r, line, prose_mode)
                }
            }
        }
    }

    var rainbow_rows = prev_rainbow_rows
    var entry_stacks = prev_entry_stacks
    var exit_stacks = prev_exit_stacks
    var next_checkpoints = seed_checkpoints
    if not skip_rainbow_scan {
        buf.clear_owner_decors(OWNER_RAINBOW)
        if service.rainbow_enabled {
            let (tr, ents, exts, cps) = decorate_buffer_rainbow(buf, win_start, win_end, seed_checkpoints)
            rainbow_rows = tr
            entry_stacks = ents
            exit_stacks = exts
            next_checkpoints = cps
        } else {
            rainbow_rows = Map.new()
            entry_stacks = Map.new()
            exit_stacks = Map.new()
            next_checkpoints = Map.new()
        }
    }

    service.cache_by_buf.insert(buf.id, BufferDecorCache {
        win_start: win_start,
        win_end: win_end,
        line_count: lcount,
        color_count: color_count,
        rainbow_rows: rainbow_rows,
        row_entry_stacks: entry_stacks,
        row_exit_stacks: exit_stacks,
        checkpoints: next_checkpoints,
        colors_enabled: service.colors_enabled,
        rainbow_enabled: service.rainbow_enabled,
        major_mode: buf.major_mode,
        edit_version: buf.edit_version,
    })
    service.last_scan_buf_id = buf.id
    service.last_scan_ver = buf.edit_version
}

fn resolve_colorizer_hook_buf(world: EditorWorld, payload: Any) -> Buffer {
    if payload matches _: BufferId {
        let b_opt = world.buffer(payload.as(BufferId))
        if b_opt != null {
            return b_opt.as(Buffer)
        }
    }
    world.active_buffer()
}

fn on_colorizer_force_hook(kern: SystemKernel, payload: Any) {
    let w_opt = kern.service("lava.document.world")
    let s_opt = kern.service(SERVICE_COLORIZER)
    if w_opt == null or s_opt == null {
        return
    }
    let world = w_opt.as(EditorWorld)
    let service = s_opt.as(ColorizerService)
    let buf = resolve_colorizer_hook_buf(world, payload)
    refresh_buffer_colorizer(world, service, buf, true)
}

fn on_colorizer_sync_hook(kern: SystemKernel, payload: Any) {
    let w_opt = kern.service("lava.document.world")
    let s_opt = kern.service(SERVICE_COLORIZER)
    if w_opt == null or s_opt == null {
        return
    }
    let world = w_opt.as(EditorWorld)
    let service = s_opt.as(ColorizerService)
    let buf = resolve_colorizer_hook_buf(world, payload)
    refresh_buffer_colorizer(world, service, buf, false)
}

fn on_colorizer_burst_guarded_hook(kern: SystemKernel, payload: Any) {
    let w_opt = kern.service("lava.document.world")
    let s_opt = kern.service(SERVICE_COLORIZER)
    if w_opt == null or s_opt == null {
        return
    }
    let world = w_opt.as(EditorWorld)
    if world.in_key_burst {
        return
    }
    let service = s_opt.as(ColorizerService)
    let buf = resolve_colorizer_hook_buf(world, payload)
    refresh_buffer_colorizer(world, service, buf, false)
}

fn on_colorizer_insert_hook(kern: SystemKernel, payload: Any) {
    let w_opt = kern.service("lava.document.world")
    let s_opt = kern.service(SERVICE_COLORIZER)
    if w_opt == null or s_opt == null {
        return
    }
    let world = w_opt.as(EditorWorld)
    if world.in_key_burst {
        return
    }
    let service = s_opt.as(ColorizerService)
    let buf = resolve_colorizer_hook_buf(world, payload)
    if buf.line_count() > 2000 {
        return
    }
    refresh_buffer_colorizer(world, service, buf, false)
}

fn unbind_owner_from_keymaps(kernel: SystemKernel, owner: ExtId) {
    for km_key in kernel.keymaps.keys() {
        let km_name = km_key.as(String)
        let km = kernel.keymaps.get(km_name).as(Keymap)
        let to_remove = List()
        for chord_key in km.bindings.keys() {
            let chord = chord_key.as(String)
            let entry = km.bindings.get(chord).as(KeyBindingEntry)
            if entry.owner == owner {
                to_remove.push(chord)
            }
        }
        for i in 0..to_remove.len() {
            let _ = km.bindings.remove(to_remove.get(i.as(usize)).as(String))
        }
    }
}

fn migrate_leader_u_prefix(leader_km: Keymap) {
    let prev_opt = leader_km.bindings.get("<Space> u")
    if prev_opt != null {
        let prev = prev_opt.as(KeyBindingEntry)
        if prev.command_name == "undo-tree-visualize" {
            let _ = leader_km.unbind("<Space> u")
            leader_km.bind("<Space> u u", prev.command_name, prev.owner, description = prev.description)
        }
    }
}

pub fn register_colorizer_extension(kernel: SystemKernel) -> !String Unit {
    let ext_id = ext_colorizer_id()
    kernel.register_extension(
        ext_id,
        "lava.org",
        "ext_colorizer",
        "0.1.0",
        "Live true-color hex/rgb swatches with luminance contrast and 6-level cyclic rainbow delimiters.",
        [ext_document_id(), ext_vim_id()],
        |k: SystemKernel| -> !String Unit {
            let service = ColorizerService.new()
            k.publish_service(SERVICE_COLORIZER, ext_id, service)

            let leader_km = k.ensure_keymap(KEYMAP_VIM_LEADER)
            migrate_leader_u_prefix(leader_km)
            leader_km.bind("<Space> u c", "colorizer-toggle", ext_id, description = "Toggle colorizer swatches")
            leader_km.bind("<Space> u r", "rainbow-toggle", ext_id, description = "Toggle rainbow delimiters")

            k.register_command(
                "colorizer-toggle",
                ext_id,
                "Toggle live true-color hex/rgb swatches (`:ColorizerToggle`, `<Space> u c`).",
                |kern: SystemKernel, _args: List| -> #InteractiveEffects !String Any {
                    let world = require_editor_world(kern)!
                    let svc = require_colorizer_service(kern)!
                    svc.colors_enabled = not svc.colors_enabled
                    svc.invalidate_all()
                    if not svc.colors_enabled {
                        world.clear_owner_ui(OWNER_COLORIZER)
                        status_emit("Colorizer swatches: OFF")#
                    } else {
                        for i in 0..world.buffer_order.len() {
                            let bid = world.buffer_order.get(i.as(usize)).as(BufferId)
                            let b = world.buffers.get(bid).as(Buffer)
                            refresh_buffer_colorizer(world, svc, b, true)
                        }
                        status_emit("Colorizer swatches: ON")#
                    }
                    ()
                },
            )

            k.register_command(
                "rainbow-toggle",
                ext_id,
                "Toggle 6-level cyclic rainbow delimiters (`:RainbowToggle`, `<Space> u r`).",
                |kern: SystemKernel, _args: List| -> #InteractiveEffects !String Any {
                    let world = require_editor_world(kern)!
                    let svc = require_colorizer_service(kern)!
                    svc.rainbow_enabled = not svc.rainbow_enabled
                    svc.invalidate_all()
                    if not svc.rainbow_enabled {
                        world.clear_owner_ui(OWNER_RAINBOW)
                        status_emit("Rainbow delimiters: OFF")#
                    } else {
                        for i in 0..world.buffer_order.len() {
                            let bid = world.buffer_order.get(i.as(usize)).as(BufferId)
                            let b = world.buffers.get(bid).as(Buffer)
                            refresh_buffer_colorizer(world, svc, b, true)
                        }
                        status_emit("Rainbow delimiters: ON")#
                    }
                    ()
                },
            )

            k.add_hook("buffer-opened", ext_id, on_colorizer_force_hook)
            k.add_hook("buffer-switched", ext_id, on_colorizer_sync_hook)
            k.add_hook("buffer-modified", ext_id, on_colorizer_burst_guarded_hook)
            k.add_hook("buffer-saved", ext_id, on_colorizer_sync_hook)
            k.add_hook("mode-changed", ext_id, on_colorizer_sync_hook)
            k.add_hook("after-insert-stroke", ext_id, on_colorizer_insert_hook)
            k.add_hook("cursor-moved", ext_id, on_colorizer_burst_guarded_hook)

            let w_opt = k.service("lava.document.world")
            if w_opt != null {
                let w = w_opt.as(EditorWorld)
                for i in 0..w.buffer_order.len() {
                    let bid = w.buffer_order.get(i.as(usize)).as(BufferId)
                    let b = w.buffers.get(bid).as(Buffer)
                    refresh_buffer_colorizer(w, service, b, true)
                }
            }
            ()
        },
        |k: SystemKernel| -> !String Unit {
            let w_opt = k.service("lava.document.world")
            if w_opt != null {
                let w = w_opt.as(EditorWorld)
                w.clear_owner_ui(OWNER_COLORIZER)
                w.clear_owner_ui(OWNER_RAINBOW)
            }
            unbind_owner_from_keymaps(k, ext_id)
            ()
        },
    )
}
