private fn short_ext_badge(owner: ExtId) -> String {
    let raw = owner.raw()
    let slash_opt = raw.split_once("/")
    if slash_opt != null {
        let (_, name) = slash_opt.as((String, String))
        return "[" ++ name ++ "]"
    }
    "[" ++ raw ++ "]"
}

private fn ensure_session_ex_stage1(
    kernel: SystemKernel,
    ctrl: MinibufferController,
) -> (List, List) {
    if ctrl.cached_ex_stage1 != null and ctrl.cached_ex_stage1_names != null {
        return (ctrl.cached_ex_stage1.as(List), ctrl.cached_ex_stage1_names.as(List))
    }
    -- Collect `(verb_name, kind_badge, key_hint, marginalia, tier_bias)` once per prompt session
    let catalog = List()
    let vnames = List()
    let seen = Set.new()

    let builtins = builtin_ex_verbs()
    for i in 0..builtins.len() {
        let (vname, desc) = builtins.get(i.as(usize)).as((String, String))
        if not seen.contains(vname) {
            seen.insert(vname)
            let vbadge = if desc.starts_with("[help]") { "[help]" } else { "[ex]" }
            catalog.push((vname, vbadge, "", desc, 40))
            vnames.push(vname)
        }
    }

    let rev_keys = ensure_session_rev_keys(kernel, ctrl)

    -- Single sorted command scan populates both `ex:<Name>` and interactive command caches!
    let all_specs = collect_kernel_commands(kernel, false)
    let inter_specs = List()
    let inter_names = List()
    for i in 0..all_specs.len() {
        let sp = all_specs.get(i.as(usize)).as(CommandSpec)
        if sp.interactive {
            inter_specs.push(sp)
            inter_names.push(sp.name)
        }
        if sp.name.starts_with("ex:") and sp.name.char_len() > 3 {
            let clean_name = sp.name.drop(3)
            let ext_tag = short_ext_badge(sp.owner)
            let kh_opt = rev_keys.get(clean_name)
            let kh = if kh_opt != null { kh_opt.as(String) } else { "" }
            if not seen.contains(clean_name) {
                seen.insert(clean_name)
                catalog.push((clean_name, "[ex]", kh, ext_tag ++ "  " ++ sp.summary, 35))
                vnames.push(clean_name)
            }
        }
    }
    if ctrl.cached_cmd_specs == null {
        ctrl.cached_cmd_specs = inter_specs
        ctrl.cached_cmd_names = inter_names
    }

    -- Interactive kernel commands as fallback commands with `[cmd]` badge & bound keychord pill
    for i in 0..inter_specs.len() {
        let sp = inter_specs.get(i.as(usize)).as(CommandSpec)
        if not seen.contains(sp.name) {
            seen.insert(sp.name)
            let kh_opt = rev_keys.get(sp.name)
            let kh = if kh_opt != null { kh_opt.as(String) } else { "" }
            catalog.push((sp.name, "[cmd]", kh, sp.summary, 0))
            vnames.push(sp.name)
        }
    }

    ctrl.cached_ex_stage1 = catalog
    ctrl.cached_ex_stage1_names = vnames
    (catalog, vnames)
}

private fn build_ex_stage1_candidates(
    kernel: SystemKernel,
    ctrl: MinibufferController,
    range_pfx: String,
    verb_query: String,
) -> (List, List, i64) {
    let q = verb_query.trim()
    if q == "" and range_pfx == "" and ctrl.cached_ex_empty != null {
        return ctrl.cached_ex_empty.as((List, List, i64))
    }
    let (catalog, vnames) = ensure_session_ex_stage1(kernel, ctrl)
    if q == "" {
        let scored = List()
        let hist = ctrl.history_list(PromptKind.ExCommand)
        let has_hist = not hist.is_empty()
        let scan_limit = if has_hist {
            catalog.len()
        } else if catalog.len() < MINIBUFFER_BATCH_CAP {
            catalog.len()
        } else {
            MINIBUFFER_BATCH_CAP
        }
        for idx in 0..scan_limit {
            let (vname, kbadge, khint, marg, bias) =
                catalog.get(idx.as(usize)).as((String, String, String, String, i64))
            let full_cand = range_pfx ++ vname
            let rec_bonus = if has_hist {
                history_recency_bonus(ctrl, PromptKind.ExCommand, full_cand)
            } else {
                0
            }
            if idx < MINIBUFFER_BATCH_CAP or rec_bonus > 0 {
                scored.push(RichScoredCandidate {
                    score: 100 + bias + rec_bonus,
                    is_dir: false,
                    cand: full_cand,
                    detail: marg,
                    rich: MinibufferRichItem {
                        kind_badge: kbadge,
                        badge_rgba: 0,
                        label: full_cand,
                        key_hint: khint,
                        marginalia: marg,
                        match_indices: List(),
                    },
                })
            }
        }
        sort_rich_scored(scored)
        let res = unpack_rich_scored_with_total(scored, catalog.len())
        if range_pfx == "" {
            ctrl.cached_ex_empty = res
        }
        return res
    }

    let pfx_len = range_pfx.char_len()
    let (total, hits) = accel_orderless_rank(q, vnames, limit = MINIBUFFER_QUERY_CAP)
    let scored = List()
    for hi in 0..hits.len() {
        let h = hits.get(hi.as(usize)).as(OrderlessHit)
        let (vname, kbadge, khint, marg, bias) =
            catalog.get(h.index.as(usize)).as((String, String, String, String, i64))
        let full_cand = range_pfx ++ vname
        let rec_bonus = history_recency_bonus(ctrl, PromptKind.ExCommand, full_cand)
        scored.push(RichScoredCandidate {
            score: h.score + bias + rec_bonus,
            is_dir: false,
            cand: full_cand,
            detail: marg,
            rich: MinibufferRichItem {
                kind_badge: kbadge,
                badge_rgba: 0,
                label: full_cand,
                key_hint: khint,
                marginalia: marg,
                match_indices: shift_indices(h.positions, pfx_len),
            },
        })
    }
    sort_rich_scored(scored)
    unpack_rich_scored_with_total(scored, total)
}

private fn build_theme_arg_candidates(
    ctrl: MinibufferController,
    arg_query: String,
    insert_prefix: String,
) -> (List, List, i64) {
    let orig_t = ctrl.orig_theme_name
    let themes = [
        ("catppuccin-mocha", "Soothing pastel dark mocha palette"),
        ("gruvbox-dark", "Retro warm groove dark palette"),
        ("one-dark", "Balanced Atom One Dark palette"),
        ("solarized-light", "Precision warm daylight palette"),
        ("tokyo-night", "Clean neon Tokyo Night dark palette"),
        ("rose-pine", "Soho vibes muted pine dark palette"),
        ("kanagawa", " Sumi-ink & wave-blue dark palette"),
        ("nord", "Arctic north-bluish dark palette"),
    ]
    let q = arg_query.trim()
    let pfx_len = insert_prefix.char_len()
    if q == "" {
        let pairs = List()
        let rich_list = List()
        for i in 0..themes.len() {
            let (tname, desc) = themes.get(i.as(usize)).as((String, String))
            let cur_tag = if tname == orig_t { "[active]  " } else { "" }
            let marg = cur_tag ++ desc.trim()
            let full_cand = insert_prefix ++ tname
            pairs.push((full_cand, marg))
            rich_list.push(MinibufferRichItem {
                kind_badge: "[thm]",
                badge_rgba: 0,
                label: full_cand,
                key_hint: "",
                marginalia: marg,
                match_indices: List(),
            })
        }
        return (pairs, rich_list, pairs.len())
    }

    let scored = List()
    for i in 0..themes.len() {
        let (tname, desc) = themes.get(i.as(usize)).as((String, String))
        let (sc, mpos) = score_candidate_with_positions(q, tname)
        if sc >= 0 {
            let cur_tag = if tname == orig_t { "[active]  " } else { "" }
            let marg = cur_tag ++ desc.trim()
            let full_cand = insert_prefix ++ tname
            scored.push(RichScoredCandidate {
                score: sc,
                is_dir: false,
                cand: full_cand,
                detail: marg,
                rich: MinibufferRichItem {
                    kind_badge: "[thm]",
                    badge_rgba: 0,
                    label: full_cand,
                    key_hint: "",
                    marginalia: marg,
                    match_indices: shift_indices(mpos, pfx_len),
                },
            })
        }
    }
    sort_rich_scored(scored)
    unpack_rich_scored(scored)
}

private fn build_set_option_candidates(
    world: EditorWorld,
    arg_text: String,
    verb_prefix: String,
) -> (List, List, i64) {
    -- Support multiple space-separated options after `:set ` (e.g. `:set nonu tab`)
    let n = arg_text.char_len()
    var last_sp: i64 = -1
    var i = n - 1
    while i >= 0 {
        if arg_text.slice(i, i + 1) == " " {
            last_sp = i
            break
        }
        i -= 1
    }
    let prior_opts = if last_sp >= 0 { arg_text.slice(0, last_sp + 1) } else { "" }
    let opt_query = if last_sp >= 0 { arg_text.slice(last_sp + 1, n).trim() } else { arg_text.trim() }
    let full_prefix = verb_prefix ++ prior_opts
    let pfx_len = full_prefix.char_len()

    let opts = world.options
    let catalog = [
        ("number", "number=" ++ opts.number.to_string(), "Show absolute line numbers"),
        ("nonu", "number=" ++ opts.number.to_string(), "Hide absolute line numbers"),
        ("relativenumber", "relativenumber=" ++ opts.relativenumber.to_string(), "Show relative line numbers"),
        ("norelativenumber", "relativenumber=" ++ opts.relativenumber.to_string(), "Disable relative line numbers"),
        ("wrap", "wrap=" ++ opts.wrap.to_string(), "Enable soft line wrapping"),
        ("nowrap", "wrap=" ++ opts.wrap.to_string(), "Disable line wrapping"),
        ("tabstop=4", "tabstop=" ++ opts.tabstop.to_string(), "Set tab display width to 4"),
        ("tabstop=2", "tabstop=" ++ opts.tabstop.to_string(), "Set tab display width to 2"),
        ("shiftwidth=4", "shiftwidth=" ++ opts.shiftwidth.to_string(), "Set auto-indent width to 4"),
        ("shiftwidth=2", "shiftwidth=" ++ opts.shiftwidth.to_string(), "Set auto-indent width to 2"),
        ("expandtab", "expandtab=" ++ opts.expandtab.to_string(), "Insert spaces instead of tabs"),
        ("noexpandtab", "expandtab=" ++ opts.expandtab.to_string(), "Insert literal tab characters"),
        ("ignorecase", "ignorecase=" ++ opts.ignorecase.to_string(), "Case-insensitive search"),
        ("noignorecase", "ignorecase=" ++ opts.ignorecase.to_string(), "Case-sensitive search"),
        ("smartcase", "smartcase=" ++ opts.smartcase.to_string(), "Override ignorecase when pattern has uppercase"),
        ("cursorline", "cursorline=" ++ opts.cursorline.to_string(), "Highlight active cursor line"),
        ("hlsearch", "hlsearch=" ++ opts.hlsearch.to_string(), "Highlight all search matches"),
        ("nohlsearch", "hlsearch=" ++ opts.hlsearch.to_string(), "Disable search match highlight"),
        ("incsearch", "incsearch=" ++ opts.incsearch.to_string(), "Live incremental search preview"),
        ("scrolloff=5", "scrolloff=" ++ opts.scrolloff.to_string(), "Keep 5 context lines around cursor"),
        ("theme=" ++ opts.theme_name, "theme=" ++ opts.theme_name, "Active editor color theme"),
    ]

    let scored = List()
    for ci in 0..catalog.len() {
        let (oname, live_val, desc) = catalog.get(ci.as(usize)).as((String, String, String))
        let (sc, mpos) = if opt_query == "" {
            (100 - ci, List())
        } else {
            score_candidate_with_positions(opt_query, oname)
        }
        if sc >= 0 {
            let full_cand = full_prefix ++ oname
            let marg = "[" ++ live_val ++ "]  " ++ desc
            scored.push(RichScoredCandidate {
                score: sc,
                is_dir: false,
                cand: full_cand,
                detail: marg,
                rich: MinibufferRichItem {
                    kind_badge: "[opt]",
                    badge_rgba: 0,
                    label: full_cand,
                    key_hint: "",
                    marginalia: marg,
                    match_indices: shift_indices(mpos, pfx_len),
                },
            })
        }
    }
    sort_rich_scored(scored)
    unpack_rich_scored(scored)
}

private fn build_static_subcmd_candidates(
    entries: List,
    badge: String,
    arg_query: String,
    verb_prefix: String,
) -> (List, List, i64) {
    let q = arg_query.trim()
    let pfx_len = verb_prefix.char_len()
    let scored = List()
    for i in 0..entries.len() {
        let (sub_name, desc) = entries.get(i.as(usize)).as((String, String))
        let (sc, mpos) = if q == "" {
            (100 - i, List())
        } else {
            score_candidate_with_positions(q, sub_name)
        }
        if sc >= 0 {
            let full_cand = verb_prefix ++ sub_name
            scored.push(RichScoredCandidate {
                score: sc,
                is_dir: false,
                cand: full_cand,
                detail: desc,
                rich: MinibufferRichItem {
                    kind_badge: badge,
                    badge_rgba: 0,
                    label: full_cand,
                    key_hint: "",
                    marginalia: desc,
                    match_indices: shift_indices(mpos, pfx_len),
                },
            })
        }
    }
    sort_rich_scored(scored)
    unpack_rich_scored(scored)
}

