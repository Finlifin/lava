-- ext_minibuffer: Continuation-Backed Interactive Minibuffer & Rich Vertico/Orderless/Marginalia/Consult Extension.
-- Publishes service `"lava.minibuffer.controller"` (`MinibufferController`) and drives
-- Emacs Orderless multi-token + multi-tier fuzzy scoring with character match positions,
-- Marginalia rich metadata & reverse keymap chord discovery, multi-stage `:` Ex verb & argument completion,
-- Vertico directory segment navigation, Consult live buffer/theme preview, and incsearch preview.

use std.collections.{HashMap, Set}
use std.env
use std.fs
use std.path
use std.runtime
use @lava_core.{
    CommandSpec, ExtId, KeyBindingEntry, KeyStroke, Keymap, PromptKind, PromptRequest, PromptTurn,
    SystemKernel, clipboard_get, clipboard_set, log_event, status_emit
}
use @lava_accel.{OrderlessHit, accel_doc_search_preview, accel_orderless_rank}
use @lava_remote.{
    RemoteConnectionInfo, RemoteDirItem, SshHostConfigEntry, parse_ssh_uri,
    remote_discover_ssh_hosts, remote_list_connections, remote_readdir
}
use @ext_document.{
    Buffer, BufferId, EditorWorld, MinibufferRichItem, MinibufferView, Pos, RegisterValue,
    SERVICE_EDITOR_WORLD, ext_document_id, require_editor_world
}

pub const SERVICE_MINIBUFFER: String = "lava.minibuffer.controller"
const DEFAULT_HINT_BAR: String = "Tab:complete  C-n/C-p:move  C-d:del/EOF  M-BS:up-dir  Enter:confirm  Esc:cancel"
const MINIBUFFER_BATCH_CAP: i64 = 256
const MINIBUFFER_QUERY_CAP: i64 = 48

pub fn ext_minibuffer_id() -> ExtId = ExtId("lava.org/ext_minibuffer")

-- ============================================================================
-- 1. Emacs Orderless + Multi-Tier Fuzzy Matcher with `match_indices`
-- ============================================================================

private fn make_range_indices(start_idx: i64, end_idx: i64) -> List {
    let out = List()
    if end_idx <= start_idx {
        return out
    }
    for i in start_idx..end_idx {
        out.push(i)
    }
    out
}

private fn shift_indices(indices: List, offset: i64) -> List {
    if offset == 0 {
        return indices
    }
    let out = List()
    for i in 0..indices.len() {
        out.push(indices.get(i.as(usize)).as(i64) + offset)
    }
    out
}

private fn dedup_sorted_indices(raw: List, max_len: i64) -> List {
    if raw.is_empty() {
        return List()
    }
    let valid = List()
    let seen = Set.new()
    for i in 0..raw.len() {
        let idx = raw.get(i.as(usize)).as(i64)
        if idx >= 0 and idx < max_len and (not seen.contains(idx)) {
            seen.insert(idx)
            valid.push(idx)
        }
    }
    valid.sort_by(|a: Any, b: Any| {
        a.as(i64).cmp(b.as(i64))
    })
    valid
}

-- Emacs Orderless + Multi-tier candidate scoring returning `(score, sorted_unique_char_indices)`.
-- Powered by native `lava-accel::orderless_rank_batch` (`O(Q * C)` DP + `!neg` / `^prefix` / `suffix$` / `=literal`).
pub fn score_candidate_with_positions(query: String, candidate: String) -> (i64, List) {
    let (_, hits) = accel_orderless_rank(query, [candidate], limit = 1)
    if hits.is_empty() {
        return (-1, List())
    }
    let h = hits.get(0).as(OrderlessHit)
    (h.score, h.positions)
}

pub fn score_candidate(query: String, candidate: String) -> i64 {
    let (sc, _) = score_candidate_with_positions(query, candidate)
    sc
}

-- ============================================================================
-- 2. Marginalia Helpers & Reverse Keymap Chord Discovery
-- ============================================================================

private fn prettify_chord_token(tok: String) -> String {
    if tok == "<Space>" or tok == "<SPC>" {
        return "SPC"
    }
    if tok == "<Return>" or tok == "<RET>" or tok == "<CR>" {
        return "RET"
    }
    if tok == "<Escape>" or tok == "<ESC>" {
        return "ESC"
    }
    if tok == "<BackSpace>" or tok == "<BS>" {
        return "BS"
    }
    if tok == "<Tab>" or tok == "<TAB>" {
        return "TAB"
    }
    let n = tok.char_len()
    if n >= 3 and tok.starts_with("<") and tok.ends_with(">") {
        let inner = tok.slice(1, n - 1)
        if inner == "lt" {
            return "<"
        }
        if inner == "gt" {
            return ">"
        }
        return inner
    }
    tok
}

private fn prettify_chord(raw_chord: String) -> String {
    let trimmed = raw_chord.trim()
    if trimmed == "" {
        return ""
    }
    let parts = trimmed.split(" ")
    let out = List()
    for i in 0..parts.len() {
        let p = parts.get(i.as(usize)).as(String)
        if p != "" {
            out.push(prettify_chord_token(p))
        }
    }
    out.join(" ")
}

private fn format_keymap_chord(mname: String, raw_chord: String) -> String {
    let pretty = prettify_chord(raw_chord)
    if mname.contains("leader") and pretty != "" and (not pretty.starts_with("SPC")) {
        return "SPC " ++ pretty
    }
    pretty
}

private fn find_cmd_in_keymap(mname: String, km: Keymap, cmd_name: String) -> String {
    let matches_list = List()
    let keys = km.bindings.keys()
    for i in 0..keys.len() {
        let k = keys.get(i.as(usize)).as(String)
        let entry = km.bindings.get(k).as(KeyBindingEntry)
        if entry.command_name == cmd_name {
            matches_list.push(entry.chord)
        }
    }
    if matches_list.is_empty() {
        return ""
    }
    matches_list.sort_by(|a: Any, b: Any| {
        let sa = a.as(String)
        let sb = b.as(String)
        if sa.char_len() != sb.char_len() {
            return sa.char_len().cmp(sb.char_len())
        }
        sa.cmp(sb)
    })
    format_keymap_chord(mname, matches_list.get(0).as(String))
}

private fn ordered_keymap_names(kernel: SystemKernel) -> List {
    let priority_maps = [
        "vim-leader",
        "vim:leader",
        "vim-normal",
        "vim:normal",
        "global",
        "emacs-global",
        "emacs-modeless",
        "vim-insert",
        "vim-visual",
    ]
    let out = List()
    let checked = Set.new()
    for i in 0..priority_maps.len() {
        let mname = priority_maps.get(i.as(usize)).as(String)
        checked.insert(mname)
        if kernel.keymaps.contains_key(mname) {
            out.push(mname)
        }
    }
    let rest_names = kernel.keymaps.keys()
    rest_names.sort()
    for i in 0..rest_names.len() {
        let mname = rest_names.get(i.as(usize)).as(String)
        if not checked.contains(mname) {
            out.push(mname)
        }
    }
    out
}

private fn build_reverse_keybinding_map(kernel: SystemKernel) -> HashMap {
    let best_raw = HashMap.new()
    let map_names = ordered_keymap_names(kernel)
    for mi in 0..map_names.len() {
        let mname = map_names.get(mi.as(usize)).as(String)
        let km = kernel.keymaps.get(mname).as(Keymap)
        if not km.bindings.is_empty() {
            let keys = km.bindings.keys()
            for ki in 0..keys.len() {
                let k = keys.get(ki.as(usize)).as(String)
                let entry = km.bindings.get(k).as(KeyBindingEntry)
                let cname = entry.command_name
                let prev_opt = best_raw.get(cname)
                if prev_opt == null {
                    best_raw.insert(cname, (mi, mname, entry.chord))
                } else {
                    let (prev_mi, _, prev_chord) = prev_opt.as((i64, String, String))
                    if prev_mi == mi and (entry.chord.char_len() < prev_chord.char_len() or
                        (entry.chord.char_len() == prev_chord.char_len() and entry.chord < prev_chord)) {
                        best_raw.insert(cname, (mi, mname, entry.chord))
                    }
                }
            }
        }
    }
    let rev = HashMap.new()
    let cmd_keys = best_raw.keys()
    for ci in 0..cmd_keys.len() {
        let cname = cmd_keys.get(ci.as(usize)).as(String)
        let (_, mname, raw_c) = best_raw.get(cname).as((i64, String, String))
        rev.insert(cname, format_keymap_chord(mname, raw_c))
    }
    rev
}

-- Scan `kernel.keymaps` (`vim-leader`, `vim-normal`, `global`, `emacs-global`, `mode:*`, etc.)
-- and return a concise keychord pill such as `"SPC f f"`, `"C-x C-f"`, `"-"`, `"C-\\"`, `"M-x"`.
pub fn lookup_command_keybinding(kernel: SystemKernel, cmd_name: String) -> String {
    if cmd_name == "" {
        return ""
    }
    let map_names = ordered_keymap_names(kernel)
    for i in 0..map_names.len() {
        let mname = map_names.get(i.as(usize)).as(String)
        let km = kernel.keymaps.get(mname).as(Keymap)
        let hit = find_cmd_in_keymap(mname, km, cmd_name)
        if hit != "" {
            return hit
        }
    }
    ""
}

pub fn format_human_size(bytes: i64, is_dir: bool) -> String {
    if is_dir {
        return "dir"
    }
    let safe_b = if bytes < 0 { 0 } else { bytes }
    if safe_b < 1024 {
        return safe_b.to_string() ++ "B"
    }
    if safe_b < 1048576 {
        let tenths = (safe_b * 10) / 1024
        return (tenths / 10).to_string() ++ "." ++ (tenths % 10).to_string() ++ "K"
    }
    if safe_b < 1073741824 {
        let tenths = (safe_b * 10) / 1048576
        return (tenths / 10).to_string() ++ "." ++ (tenths % 10).to_string() ++ "M"
    }
    let tenths = (safe_b * 10) / 1073741824
    (tenths / 10).to_string() ++ "." ++ (tenths % 10).to_string() ++ "G"
}

private fn format_unix_mode(name: String, is_dir: bool, is_symlink: bool) -> String {
    if is_dir {
        return "drwxr-xr-x"
    }
    if is_symlink {
        return "lrwxrwxrwx"
    }
    let lower = name.to_lower()
    if lower.ends_with(".sh") or lower.ends_with(".bash") or lower.ends_with(".zsh") {
        return "-rwxr-xr-x"
    }
    "-rw-r--r--"
}

private fn file_kind_badge(name: String, is_dir: bool) -> String {
    if is_dir {
        return "[dir]"
    }
    let lower = name.to_lower()
    when {
        lower.ends_with(".ns") => "[ns]",
        lower.ends_with(".rs") => "[rs]",
        lower.ends_with(".md") or lower.ends_with(".markdown") => "[md]",
        lower.ends_with(".toml") => "[toml]",
        lower.ends_with(".json") => "[json]",
        lower.ends_with(".yaml") or lower.ends_with(".yml") => "[yaml]",
        lower.ends_with(".py") => "[py]",
        lower.ends_with(".ts") or lower.ends_with(".tsx") => "[ts]",
        lower.ends_with(".js") or lower.ends_with(".jsx") => "[js]",
        lower.ends_with(".org") => "[org]",
        lower.ends_with(".sh") or lower.ends_with(".bash") or lower.ends_with(".zsh") => "[sh]",
        lower.ends_with(".c") or lower.ends_with(".h") or lower.ends_with(".cpp") => "[c]",
        else => "[file]",
    }
}

private fn mode_badge_for_kind(kind: PromptKind) -> String {
    kind match {
        PromptKind.CommandName => "M-x",
        PromptKind.ExCommand => "EX :",
        PromptKind.FilePath => "FILE",
        PromptKind.BufferName => "BUFFER",
        PromptKind.Choice => "CHOICE",
        PromptKind.SearchForward => "SEARCH",
        PromptKind.SearchBackward => "SEARCH",
        PromptKind.Confirm => "CONFIRM",
        PromptKind.FreeText => "INPUT",
    }
}

private fn hint_bar_for_kind(kind: PromptKind) -> String {
    kind match {
        PromptKind.Confirm => "y/n/!/q:confirm  Esc/C-g:cancel",
        PromptKind.SearchForward => "C-s/C-r:next/prev  M-p/M-n:hist  Enter:accept  Esc:cancel",
        PromptKind.SearchBackward => "C-s/C-r:next/prev  M-p/M-n:hist  Enter:accept  Esc:cancel",
        _ => DEFAULT_HINT_BAR,
    }
}

private fn clear_world_minibuffer(world: EditorWorld) {
    world.minibuffer_view = MinibufferView.inactive()
    world.minibuffer_rich_items = List()
    world.minibuffer_mode_badge = ""
    world.minibuffer_hint_bar = ""
}

-- ============================================================================
-- 3. MinibufferController Service & History State
-- ============================================================================

private fn kind_history_key(kind: PromptKind) -> String {
    kind match {
        PromptKind.FreeText => "free-text",
        PromptKind.CommandName => "command-name",
        PromptKind.FilePath => "file-path",
        PromptKind.BufferName => "buffer-name",
        PromptKind.Choice => "choice",
        PromptKind.Confirm => "confirm",
        PromptKind.SearchForward => "search",
        PromptKind.SearchBackward => "search",
        PromptKind.ExCommand => "ex-command",
    }
}

pub struct MinibufferController {
    pub active: bool,
    pub request: PromptRequest,
    pub input_text: String,
    pub cursor_col: i64,
    pub items: List,
    pub rich_items: List,
    pub selected_idx: i64,
    pub total_matches: i64,
    pub selection_touched: bool,
    pub histories: HashMap,
    pub history_idx: i64,
    pub saved_draft: String,
    pub preview_buf_id: ?BufferId,
    pub preview_orig_point: Pos,
    pub preview_orig_last_search: String,
    pub preview_orig_highlight: bool,
    pub orig_active_buf_id: BufferId,
    pub orig_theme_name: String,
    pub buf_preview_active: bool,
    pub theme_preview_active: bool,
    pub mru_buffers: List,
    pub last_observed_active: ?BufferId,
    pub cached_doc_cwd: String,
    pub cached_doc_nodes: ?List,
    pub cached_help_catalog: ?List,
    pub cached_help_cmd_count: i64,
    pub cached_info_catalog: ?List,
    pub cached_rev_keys: ?HashMap,
    pub cached_cmd_specs: ?List,
    pub cached_cmd_names: ?List,
    pub cached_ex_stage1: ?List,
    pub cached_ex_stage1_names: ?List,
    pub cached_ex_empty: ?(List, List, i64),
    pub cached_cmd_empty: ?(List, List, i64),
    pub cached_path_dir: String,
    pub cached_path_entries: ?List,
}

impl MinibufferController {
    pub fn new() -> MinibufferController {
        MinibufferController {
            active: false,
            request: PromptRequest.text("", ""),
            input_text: "",
            cursor_col: 0,
            items: List(),
            rich_items: List(),
            selected_idx: 0,
            total_matches: 0,
            selection_touched: false,
            histories: HashMap.new(),
            history_idx: -1,
            saved_draft: "",
            preview_buf_id: null,
            preview_orig_point: Pos.zero(),
            preview_orig_last_search: "",
            preview_orig_highlight: false,
            orig_active_buf_id: BufferId(1),
            orig_theme_name: "catppuccin-mocha",
            buf_preview_active: false,
            theme_preview_active: false,
            mru_buffers: List(),
            last_observed_active: null,
            cached_doc_cwd: "",
            cached_doc_nodes: null,
            cached_help_catalog: null,
            cached_help_cmd_count: -1,
            cached_info_catalog: null,
            cached_rev_keys: null,
            cached_cmd_specs: null,
            cached_cmd_names: null,
            cached_ex_stage1: null,
            cached_ex_stage1_names: null,
            cached_ex_empty: null,
            cached_cmd_empty: null,
            cached_path_dir: "",
            cached_path_entries: null,
        }
    }

    pub fn note_buffer_visited(self, id: BufferId) {
        let filtered = List()
        filtered.push(id)
        for i in 0..self.mru_buffers.len() {
            let bid = self.mru_buffers.get(i.as(usize)).as(BufferId)
            if bid != id {
                filtered.push(bid)
            }
        }
        self.mru_buffers = filtered
        self.last_observed_active = id
    }

    pub fn history_list(self, kind: PromptKind) -> List {
        let key = kind_history_key(kind)
        if self.histories.contains_key(key) {
            return self.histories.get(key).as(List)
        }
        let fresh = List()
        self.histories.insert(key, fresh)
        fresh
    }

    pub fn history_for(self, kind: PromptKind) -> List = self.history_list(kind)

    pub fn record_history(self, kind: PromptKind, value: String) {
        if value == "" or kind == PromptKind.Confirm {
            return
        }
        let hist = self.history_list(kind)
        if not hist.is_empty() {
            let last_val = hist.get((hist.len() - 1).as(usize)).as(String)
            if last_val == value {
                return
            }
        }
        hist.push(value)
        if hist.len() > 100 {
            let _ = hist.remove(0)
        }
        if kind == PromptKind.ExCommand {
            self.cached_ex_empty = null
        } else if kind == PromptKind.CommandName {
            self.cached_cmd_empty = null
        }
    }

    pub fn sync_to_world(self, world: EditorWorld) {
        if not self.active {
            clear_world_minibuffer(world)
            return
        }
        world.minibuffer_view = MinibufferView {
            active: true,
            prompt_label: self.request.label,
            input_text: self.input_text,
            cursor_col: self.cursor_col,
            items: self.items,
            selected_idx: self.selected_idx,
            total_matches: self.total_matches,
        }
        world.minibuffer_rich_items = self.rich_items
        world.minibuffer_mode_badge = mode_badge_for_kind(self.request.kind)
        world.minibuffer_hint_bar = hint_bar_for_kind(self.request.kind)
    }
}

-- ============================================================================
-- 4. Candidate Generation (Vertico + Marginalia + Full Multi-Stage `:` Ex)
-- ============================================================================

private struct RichScoredCandidate {
    score: i64,
    is_dir: bool,
    cand: String,
    detail: String,
    rich: MinibufferRichItem,
}

private fn rich_cand_in_order(sa: RichScoredCandidate, sb: RichScoredCandidate) -> bool {
    if sa.is_dir != sb.is_dir {
        return sa.is_dir
    }
    if sa.score != sb.score {
        return sa.score > sb.score
    }
    sa.cand <= sb.cand
}

private fn sort_rich_scored(scored: List) {
    let n = scored.len()
    if n <= 1 {
        return
    }
    var already_sorted = true
    var prev = scored.get(0).as(RichScoredCandidate)
    for i in 1..n {
        let cur = scored.get(i.as(usize)).as(RichScoredCandidate)
        if not rich_cand_in_order(prev, cur) {
            already_sorted = false
            break
        }
        prev = cur
    }
    if already_sorted {
        return
    }
    scored.sort_by(|a: Any, b: Any| {
        let sa = a.as(RichScoredCandidate)
        let sb = b.as(RichScoredCandidate)
        if sa.is_dir and (not sb.is_dir) {
            return Ordering.less
        }
        if (not sa.is_dir) and sb.is_dir {
            return Ordering.greater
        }
        if sa.score != sb.score {
            return sb.score.cmp(sa.score)
        }
        sa.cand.cmp(sb.cand)
    })
}

private fn unpack_rich_scored_with_total(scored: List, total: i64) -> (List, List, i64) {
    let pairs = List()
    let rich_list = List()
    let take_n = if scored.len() > MINIBUFFER_BATCH_CAP { MINIBUFFER_BATCH_CAP } else { scored.len() }
    for i in 0..take_n {
        let it = scored.get(i.as(usize)).as(RichScoredCandidate)
        pairs.push((it.cand, it.detail))
        rich_list.push(it.rich)
    }
    let eff_total = if total >= pairs.len() { total } else { pairs.len() }
    (pairs, rich_list, eff_total)
}

private fn unpack_rich_scored(scored: List) -> (List, List, i64) {
    unpack_rich_scored_with_total(scored, scored.len())
}

private fn ensure_session_rev_keys(kernel: SystemKernel, ctrl: MinibufferController) -> HashMap {
    if ctrl.cached_rev_keys != null {
        return ctrl.cached_rev_keys.as(HashMap)
    }
    let rk = build_reverse_keybinding_map(kernel)
    ctrl.cached_rev_keys = rk
    rk
}

private fn ensure_session_interactive_commands(
    kernel: SystemKernel,
    ctrl: MinibufferController,
) -> (List, List) {
    if ctrl.cached_cmd_specs != null and ctrl.cached_cmd_names != null {
        return (ctrl.cached_cmd_specs.as(List), ctrl.cached_cmd_names.as(List))
    }
    let specs = collect_kernel_commands(kernel, true)
    let names = List()
    for i in 0..specs.len() {
        names.push(specs.get(i.as(usize)).as(CommandSpec).name)
    }
    ctrl.cached_cmd_specs = specs
    ctrl.cached_cmd_names = names
    (specs, names)
}

private struct CachedDirEntry {
    ename: String,
    dir_flag: bool,
    kbadge: String,
    marg: String,
}

private fn ensure_cached_dir_entries(ctrl: MinibufferController, dir_to_read: String) -> List {
    if ctrl.cached_path_dir == dir_to_read and ctrl.cached_path_entries != null {
        return ctrl.cached_path_entries.as(List)
    }
    let dirs = List()
    let files = List()
    let entries_res = fs.read_dir_entries(dir_to_read)
    entries_res match {
        entries! => {
            for i in 0..entries.len() {
                let de = entries.get(i.as(usize)).as(fs.DirEntry)
                let ename = de.name
                let dir_flag = de.is_dir or (de.is_symlink and fs.is_dir(de.path))
                let kbadge = file_kind_badge(ename, dir_flag)
                let size_txt = format_human_size(de.size, dir_flag).pad_start(6, " ")
                let mode_txt = format_unix_mode(ename, dir_flag, de.is_symlink)
                let marg = size_txt ++ "  " ++ mode_txt
                let item = CachedDirEntry {
                    ename: ename,
                    dir_flag: dir_flag,
                    kbadge: kbadge,
                    marg: marg,
                }
                if dir_flag {
                    dirs.push(item)
                } else {
                    files.push(item)
                }
            }
        },
        error _ => (),
    }
    dirs.sort_by(|a: Any, b: Any| {
        a.as(CachedDirEntry).ename.cmp(b.as(CachedDirEntry).ename)
    })
    files.sort_by(|a: Any, b: Any| {
        a.as(CachedDirEntry).ename.cmp(b.as(CachedDirEntry).ename)
    })
    let out = List()
    for i in 0..dirs.len() {
        out.push(dirs.get(i.as(usize)))
    }
    for i in 0..files.len() {
        out.push(files.get(i.as(usize)))
    }
    ctrl.cached_path_dir = dir_to_read
    ctrl.cached_path_entries = out
    out
}

private fn history_recency_bonus(ctrl: MinibufferController, kind: PromptKind, cand: String) -> i64 {
    let hist = ctrl.history_list(kind)
    let n = hist.len()
    if n == 0 {
        return 0
    }
    var idx = n - 1
    while idx >= 0 {
        if hist.get(idx.as(usize)).as(String) == cand {
            return 250 + idx * 4
        }
        idx -= 1
    }
    0
}

pub fn collect_kernel_commands(kernel: SystemKernel, interactive_only: bool) -> List {
    let via_api = kernel.list_commands(interactive_only = interactive_only)
    if not via_api.is_empty() {
        return via_api
    }
    let names = kernel.commands.keys()
    names.sort()
    let out = List()
    for i in 0..names.len() {
        let k = names.get(i.as(usize)).as(String)
        let spec = kernel.commands.get(k).as(CommandSpec)
        if (not interactive_only) or spec.interactive {
            out.push(spec)
        }
    }
    out
}

private fn home_directory(fallback_cwd: String) -> String {
    env.get_or("HOME", fallback_cwd)
}

private fn expand_tilde_path(raw: String, fallback_cwd: String) -> String {
    let home = home_directory(fallback_cwd)
    if raw == "~" {
        return path.normalize(home)
    }
    if raw.starts_with("~/") {
        return path.normalize(path.join(home, raw.drop(2)))
    }
    raw
}

private fn split_file_input(raw_input: String, cwd: String) -> (String, String, String) {
    -- Returns `(raw_dir_prefix, resolved_dir_to_read, base_prefix)` with `~/` expansion!
    let n = raw_input.char_len()
    var last_slash: i64 = -1
    var i = n - 1
    while i >= 0 {
        let ch = raw_input.slice(i, i + 1)
        if ch == "/" or ch == "\\" {
            last_slash = i
            break
        }
        i -= 1
    }
    if last_slash < 0 {
        return ("", cwd, raw_input)
    }
    let raw_dir_prefix = raw_input.slice(0, last_slash + 1)
    let base_prefix = raw_input.slice(last_slash + 1, n)
    let dir_part = if last_slash == 0 {
        "/"
    } else {
        raw_input.slice(0, last_slash)
    }
    let expanded_dir = expand_tilde_path(dir_part, cwd)
    let resolved_dir = if path.is_absolute(expanded_dir) {
        path.normalize(expanded_dir)
    } else {
        path.normalize(path.join(cwd, expanded_dir))
    }
    (raw_dir_prefix, resolved_dir, base_prefix)
}

private fn ensure_cached_remote_dir_entries(
    ctrl: MinibufferController,
    remote_dir_uri: String,
    show_hidden: bool,
) -> List {
    let cache_key = if show_hidden {
        remote_dir_uri ++ "#hidden"
    } else {
        remote_dir_uri
    }
    if ctrl.cached_path_dir == cache_key and ctrl.cached_path_entries != null {
        return ctrl.cached_path_entries.as(List)
    }
    let dirs = List()
    let files = List()
    let entries_res = remote_readdir(remote_dir_uri, show_hidden = show_hidden)
    entries_res match {
        entries! => {
            for i in 0..entries.len() {
                let de = entries.get(i.as(usize)).as(RemoteDirItem)
                let ename = de.name
                let dir_flag = de.is_dir
                let kbadge = file_kind_badge(ename, dir_flag)
                let size_txt = format_human_size(de.size, dir_flag).pad_start(6, " ")
                let mode_txt = format_unix_mode(ename, dir_flag, false)
                let marg = size_txt ++ "  " ++ mode_txt ++ "  [ssh]"
                let item = CachedDirEntry {
                    ename: ename,
                    dir_flag: dir_flag,
                    kbadge: kbadge,
                    marg: marg,
                }
                if dir_flag {
                    dirs.push(item)
                } else {
                    files.push(item)
                }
            }
        },
        error _ => (),
    }
    dirs.sort_by(|a: Any, b: Any| {
        a.as(CachedDirEntry).ename.cmp(b.as(CachedDirEntry).ename)
    })
    files.sort_by(|a: Any, b: Any| {
        a.as(CachedDirEntry).ename.cmp(b.as(CachedDirEntry).ename)
    })
    let out = List()
    for i in 0..dirs.len() {
        out.push(dirs.get(i.as(usize)))
    }
    for i in 0..files.len() {
        out.push(files.get(i.as(usize)))
    }
    ctrl.cached_path_dir = cache_key
    ctrl.cached_path_entries = out
    out
}

private fn is_ssh_host_stage_input(raw_input: String) -> bool {
    let t = raw_input.trim_start()
    if t == "ssh:" or t == "ssh:/" or t == "/ssh" {
        return true
    }
    if t.starts_with("ssh://") {
        return not t.drop(6).contains("/")
    }
    if t.starts_with("/ssh:") {
        return not t.drop(5).contains(":")
    }
    false
}

private fn extract_ssh_host_query(raw_input: String) -> String {
    let t = raw_input.trim_start()
    if t.starts_with("ssh://") {
        return t.drop(6).trim()
    }
    if t.starts_with("/ssh:") {
        return t.drop(5).trim()
    }
    ""
}

private fn build_ssh_host_candidates(
    raw_input: String,
    insert_prefix: String,
    legacy_pair_detail: bool,
) -> (List, List, i64) {
    let auth_q = extract_ssh_host_query(raw_input)
    let conns = remote_list_connections()
    let hosts = remote_discover_ssh_hosts()
    let seen = Set.new()
    -- `(authority, badge, marg, tier_bias)`
    let rows = List()

    for i in 0..conns.len() {
        let c = conns.get(i.as(usize)).as(RemoteConnectionInfo)
        if c.authority != "" and (not seen.contains(c.authority)) {
            seen.insert(c.authority)
            let mode_tag = "[" ++ c.mode ++ "]"
            let sys_tag = if c.os != "" {
                "  " ++ c.hostname ++ " (" ++ c.os ++ "/" ++ c.arch ++ ")"
            } else {
                "  " ++ c.hostname
            }
            rows.push((c.authority, "[CONN]", mode_tag ++ sys_tag, 200 - i))
        }
    }

    for i in 0..hosts.len() {
        let h = hosts.get(i.as(usize)).as(SshHostConfigEntry)
        if h.alias_name == "" {
            continue
        }
        var auth = ""
        if h.user != "" {
            auth = h.user ++ "@"
        }
        auth = auth ++ h.alias_name
        if h.port > 0 and h.port != 22 {
            auth = auth ++ ":" ++ h.port.to_string()
        }
        if (not seen.contains(auth)) and (not seen.contains(h.alias_name)) {
            seen.insert(auth)
            let user_part = if h.user != "" { h.user ++ "@" } else { "" }
            let host_part = if h.hostname != "" { h.hostname } else { h.alias_name }
            let port_part = if h.port > 0 { ":" ++ h.port.to_string() } else { ":22" }
            let jump_part = if h.proxy_jump != "" { "  via " ++ h.proxy_jump } else { "" }
            let marg = user_part ++ host_part ++ port_part ++ jump_part
            rows.push((auth, "[SSH]", marg, 80 - i))
        }
    }

    if rows.is_empty() {
        return (List(), List(), 0)
    }

    let ssh_pfx = insert_prefix ++ "ssh://"
    let ssh_pfx_len = ssh_pfx.char_len()

    if auth_q == "" {
        let pairs = List()
        let rich_list = List()
        for i in 0..rows.len() {
            let (auth, badge, marg, _) = rows.get(i.as(usize)).as((String, String, String, i64))
            let full_cand = ssh_pfx ++ auth ++ "/"
            let pair_det = if legacy_pair_detail { "dir" } else { marg }
            pairs.push((full_cand, pair_det))
            rich_list.push(MinibufferRichItem {
                kind_badge: badge,
                badge_rgba: 0,
                label: full_cand,
                key_hint: "",
                marginalia: marg,
                match_indices: List(),
            })
        }
        return (pairs, rich_list, rows.len())
    }

    let scored = List()
    for i in 0..rows.len() {
        let (auth, badge, marg, bias) = rows.get(i.as(usize)).as((String, String, String, i64))
        let (sc, mpos) = score_candidate_with_positions(auth_q, auth)
        if sc >= 0 {
            let full_cand = ssh_pfx ++ auth ++ "/"
            let pair_det = if legacy_pair_detail { "dir" } else { marg }
            scored.push(RichScoredCandidate {
                score: sc + bias,
                is_dir: true,
                cand: full_cand,
                detail: pair_det,
                rich: MinibufferRichItem {
                    kind_badge: badge,
                    badge_rgba: 0,
                    label: full_cand,
                    key_hint: "",
                    marginalia: marg,
                    match_indices: shift_indices(mpos, ssh_pfx_len),
                },
            })
        }
    }
    sort_rich_scored(scored)
    unpack_rich_scored(scored)
}

private fn split_remote_ssh_input(raw_input: String) -> ?(String, String, String) {
    let t = raw_input.trim_start()
    if t.starts_with("ssh://") {
        let after = t.drop(6)
        let slash_hits = after.find_indices("/")
        if slash_hits.is_empty() {
            return null
        }
        let first_sl = slash_hits.get(0).as(i64)
        let last_sl = slash_hits.get((slash_hits.len() - 1).as(usize)).as(i64)
        let auth_part = after.slice(0, first_sl)
        let dir_subpath = after.slice(first_sl, last_sl + 1)
        let base_prefix = after.slice(last_sl + 1, after.char_len())
        let parsed! = parse_ssh_uri("ssh://" ++ auth_part ++ dir_subpath) else {
            return null
        }
        let remote_dir_uri = if parsed.remote_path.ends_with("/") {
            parsed.prefix ++ parsed.remote_path
        } else {
            parsed.prefix ++ parsed.remote_path ++ "/"
        }
        let raw_dir_prefix = t.slice(0, 6 + last_sl + 1)
        return (raw_dir_prefix, remote_dir_uri, base_prefix)
    }
    if t.starts_with("/ssh:") {
        let after = t.drop(5)
        let sp? = after.split_once(":") else {
            return null
        }
        let (auth_part, tramp_path) = sp
        let slash_hits = tramp_path.find_indices("/")
        let (dir_subpath, base_prefix) = if slash_hits.is_empty() {
            ("/", tramp_path)
        } else {
            let last_sl = slash_hits.get((slash_hits.len() - 1).as(usize)).as(i64)
            (tramp_path.slice(0, last_sl + 1), tramp_path.slice(last_sl + 1, tramp_path.char_len()))
        }
        let parsed! = parse_ssh_uri("/ssh:" ++ auth_part ++ ":" ++ dir_subpath) else {
            return null
        }
        let remote_dir_uri = if parsed.remote_path.ends_with("/") {
            parsed.prefix ++ parsed.remote_path
        } else {
            parsed.prefix ++ parsed.remote_path ++ "/"
        }
        return (remote_dir_uri, remote_dir_uri, base_prefix)
    }
    null
}

private fn vertico_up_directory(s: String) -> String {
    if s == "" or s == "/" or s == "ssh:" or s == "ssh://" or s == "/ssh:" {
        return s
    }
    if s.starts_with("ssh://") {
        let after = s.drop(6)
        let slash_hits = after.find_indices("/")
        if slash_hits.is_empty() {
            return "ssh://"
        }
        let first_sl = slash_hits.get(0).as(i64)
        let auth_root = "ssh://" ++ after.slice(0, first_sl + 1)
        if s == auth_root {
            return "ssh://"
        }
        var trimmed_ssh = s
        if trimmed_ssh.ends_with("/") and trimmed_ssh.char_len() > auth_root.char_len() {
            trimmed_ssh = trimmed_ssh.slice(0, trimmed_ssh.char_len() - 1)
        }
        let n_ssh = trimmed_ssh.char_len()
        var j = n_ssh - 1
        while j >= 6 + first_sl {
            if trimmed_ssh.slice(j, j + 1) == "/" {
                return trimmed_ssh.slice(0, j + 1)
            }
            j -= 1
        }
        return auth_root
    }
    if s.starts_with("/ssh:") {
        let after = s.drop(5)
        let sp_opt = after.split_once(":")
        if sp_opt == null {
            return "/ssh:"
        }
        let (auth_part, rpath) = sp_opt.as((String, String))
        let tramp_root = "/ssh:" ++ auth_part ++ ":/"
        if s == tramp_root or rpath == "" or rpath == "/" {
            return "/ssh:"
        }
        var trimmed_tr = rpath
        if trimmed_tr.char_len() > 1 and trimmed_tr.ends_with("/") {
            trimmed_tr = trimmed_tr.slice(0, trimmed_tr.char_len() - 1)
        }
        let n_tr = trimmed_tr.char_len()
        var j = n_tr - 1
        while j >= 0 {
            if trimmed_tr.slice(j, j + 1) == "/" {
                return "/ssh:" ++ auth_part ++ ":" ++ trimmed_tr.slice(0, j + 1)
            }
            j -= 1
        }
        return tramp_root
    }
    var trimmed = s
    if trimmed.char_len() > 1 and (trimmed.ends_with("/") or trimmed.ends_with("\\")) {
        trimmed = trimmed.slice(0, trimmed.char_len() - 1)
    }
    let n = trimmed.char_len()
    var i = n - 1
    while i >= 0 {
        let ch = trimmed.slice(i, i + 1)
        if ch == "/" or ch == "\\" {
            return trimmed.slice(0, i + 1)
        }
        i -= 1
    }
    ""
}

-- Complete directory/file entries in `cwd` for `path_input`, prepending `insert_prefix`
-- (empty `""` for `PromptKind.FilePath`, or `"<verb> "` for Stage 2 Ex file arguments).
-- Preserves `"dir"` / `"file"` in `items` when `legacy_pair_detail == true` so `test_emacs` stays 100% intact!
private fn build_path_candidates(
    ctrl: MinibufferController,
    path_input: String,
    cwd: String,
    insert_prefix: String,
    legacy_pair_detail: bool,
) -> (List, List, i64) {
    if is_ssh_host_stage_input(path_input) {
        return build_ssh_host_candidates(path_input, insert_prefix, legacy_pair_detail)
    }
    let remote_split_opt = split_remote_ssh_input(path_input)
    let (raw_dir_prefix, dir_to_read, base_prefix) = if remote_split_opt != null {
        remote_split_opt.as((String, String, String))
    } else {
        split_file_input(path_input, cwd)
    }
    let show_hidden = base_prefix.starts_with(".")
    let label_prefix = insert_prefix ++ raw_dir_prefix
    let prefix_offset = label_prefix.char_len()

    let dir_entries = if remote_split_opt != null {
        ensure_cached_remote_dir_entries(ctrl, dir_to_read, show_hidden)
    } else {
        ensure_cached_dir_entries(ctrl, dir_to_read)
    }
    if dir_entries.is_empty() {
        return (List(), List(), 0)
    }

    let vis_entries = List()
    let vis_names = List()
    for i in 0..dir_entries.len() {
        let ce = dir_entries.get(i.as(usize)).as(CachedDirEntry)
        if show_hidden or (not ce.ename.starts_with(".")) {
            vis_entries.push(ce)
            vis_names.push(ce.ename)
        }
    }
    if vis_names.is_empty() {
        return (List(), List(), 0)
    }

    if base_prefix.trim() == "" {
        let pairs = List()
        let rich_list = List()
        let take_n = if vis_entries.len() > MINIBUFFER_BATCH_CAP {
            MINIBUFFER_BATCH_CAP
        } else {
            vis_entries.len()
        }
        for i in 0..take_n {
            let ce = vis_entries.get(i.as(usize)).as(CachedDirEntry)
            let suffix = if ce.dir_flag { "/" } else { "" }
            let full_cand = label_prefix ++ ce.ename ++ suffix
            let pair_det = if legacy_pair_detail {
                if ce.dir_flag { "dir" } else { "file" }
            } else {
                ce.marg.trim()
            }
            pairs.push((full_cand, pair_det))
            rich_list.push(MinibufferRichItem {
                kind_badge: ce.kbadge,
                badge_rgba: 0,
                label: full_cand,
                key_hint: "",
                marginalia: ce.marg,
                match_indices: List(),
            })
        }
        return (pairs, rich_list, vis_entries.len())
    }

    let (total, hits) = accel_orderless_rank(base_prefix, vis_names, limit = MINIBUFFER_BATCH_CAP)
    let scored = List()
    for hi in 0..hits.len() {
        let h = hits.get(hi.as(usize)).as(OrderlessHit)
        let ce = vis_entries.get(h.index.as(usize)).as(CachedDirEntry)
        let suffix = if ce.dir_flag { "/" } else { "" }
        let full_cand = label_prefix ++ ce.ename ++ suffix
        let pair_det = if legacy_pair_detail {
            if ce.dir_flag { "dir" } else { "file" }
        } else {
            ce.marg.trim()
        }
        let eff_sc = if base_prefix.trim() == "" { 100 } else { h.score }
        scored.push(RichScoredCandidate {
            score: eff_sc,
            is_dir: ce.dir_flag,
            cand: full_cand,
            detail: pair_det,
            rich: MinibufferRichItem {
                kind_badge: ce.kbadge,
                badge_rgba: 0,
                label: full_cand,
                key_hint: "",
                marginalia: ce.marg,
                match_indices: shift_indices(h.positions, prefix_offset),
            },
        })
    }

    sort_rich_scored(scored)
    unpack_rich_scored_with_total(scored, total)
}

private fn ordered_buffers_for_completion(world: EditorWorld, ctrl: MinibufferController) -> List {
    let base_active = if ctrl.active { ctrl.orig_active_buf_id } else { world.active_buffer_id }
    let ordered_ids = List()
    let seen = Set.new()
    for i in 0..ctrl.mru_buffers.len() {
        let bid = ctrl.mru_buffers.get(i.as(usize)).as(BufferId)
        if bid != base_active and world.buffers.contains_key(bid) and (not seen.contains(bid)) {
            seen.insert(bid)
            ordered_ids.push(bid)
        }
    }
    var idx = world.buffer_order.len() - 1
    while idx >= 0 {
        let bid = world.buffer_order.get(idx.as(usize)).as(BufferId)
        if bid != base_active and world.buffers.contains_key(bid) and (not seen.contains(bid)) {
            seen.insert(bid)
            ordered_ids.push(bid)
        }
        idx -= 1
    }
    if world.buffers.contains_key(base_active) and (not seen.contains(base_active)) {
        ordered_ids.push(base_active)
    }
    ordered_ids
}

private fn build_buffer_candidates(
    world: EditorWorld,
    ctrl: MinibufferController,
    query: String,
    insert_prefix: String,
) -> (List, List, i64) {
    let q = query.trim()
    let ordered_ids = ordered_buffers_for_completion(world, ctrl)
    let pfx_len = insert_prefix.char_len()
    if q == "" {
        let pairs = List()
        let rich_list = List()
        for i in 0..ordered_ids.len() {
            let bid = ordered_ids.get(i.as(usize)).as(BufferId)
            let b = world.buffers.get(bid).as(Buffer)
            let mod_tag = if b.modified { " [+]" } else { "" }
            let pair_detail = b.major_mode ++ mod_tag
            let path_part = if b.file_path != "" { "  " ++ b.file_path } else { "" }
            let marg = (if b.modified { "[+] " } else { "" })
                ++ b.line_count().to_string() ++ "L  "
                ++ b.major_mode ++ path_part
            let full_cand = insert_prefix ++ b.name
            pairs.push((full_cand, pair_detail))
            rich_list.push(MinibufferRichItem {
                kind_badge: "[buf]",
                badge_rgba: 0,
                label: full_cand,
                key_hint: "",
                marginalia: marg,
                match_indices: List(),
            })
        }
        return (pairs, rich_list, pairs.len())
    }

    let bufs = List()
    let bnames = List()
    for i in 0..ordered_ids.len() {
        let bid = ordered_ids.get(i.as(usize)).as(BufferId)
        let b = world.buffers.get(bid).as(Buffer)
        bufs.push(b)
        bnames.push(b.name)
    }
    let (total, hits) = accel_orderless_rank(q, bnames, limit = MINIBUFFER_BATCH_CAP)
    let scored = List()
    for hi in 0..hits.len() {
        let h = hits.get(hi.as(usize)).as(OrderlessHit)
        let b = bufs.get(h.index.as(usize)).as(Buffer)
        let mod_tag = if b.modified { " [+]" } else { "" }
        let pair_detail = b.major_mode ++ mod_tag
        let path_part = if b.file_path != "" { "  " ++ b.file_path } else { "" }
        let marg = (if b.modified { "[+] " } else { "" })
            ++ b.line_count().to_string() ++ "L  "
            ++ b.major_mode ++ path_part
        let full_cand = insert_prefix ++ b.name
        scored.push(RichScoredCandidate {
            score: h.score,
            is_dir: false,
            cand: full_cand,
            detail: pair_detail,
            rich: MinibufferRichItem {
                kind_badge: "[buf]",
                badge_rgba: 0,
                label: full_cand,
                key_hint: "",
                marginalia: marg,
                match_indices: shift_indices(h.positions, pfx_len),
            },
        })
    }
    sort_rich_scored(scored)
    unpack_rich_scored_with_total(scored, total)
}

-- ============================================================================
-- 5. Multi-Stage `:` Ex Verb & Context-Aware Argument Completion
-- ============================================================================

private fn split_ex_range_prefix(raw: String) -> (String, String) {
    var s = raw
    var leading_colon = ""
    if s.starts_with(":") {
        leading_colon = ":"
        s = s.drop(1)
    }
    if s.starts_with("'<,'>") {
        return (leading_colon ++ "'<,'>", s.drop(5))
    }
    let n = s.char_len()
    var i: i64 = 0
    while i < n {
        let ch = s.slice(i, i + 1)
        if ch.is_ascii_digit() or ch == "," or ch == ";" or ch == "." or ch == "$" {
            i += 1
        } else {
            break
        }
    }
    if i > 0 {
        return (leading_colon ++ s.slice(0, i), s.slice(i, n))
    }
    if s.starts_with("%") and n > 1 and s != "%s" and (not s.starts_with("%s/")) {
        return (leading_colon ++ "%", s.drop(1))
    }
    (leading_colon, s)
}

private fn normalize_ex_verb_base(raw_verb: String) -> String {
    if raw_verb.ends_with("!") and raw_verb.char_len() > 1 {
        return raw_verb.slice(0, raw_verb.char_len() - 1)
    }
    raw_verb
}

private fn is_ex_file_verb(v: String) -> bool {
    v == "e" or v == "edit" or v == "w" or v == "write" or v == "sp" or v == "split"
        or v == "vsp" or v == "vsplit" or v == "tabnew" or v == "cd"
        or v == "Dirvish" or v == "Ranger" or v == "Ex" or v == "Explore"
        or v == "Oil" or v == "saveas" or v == "r" or v == "read"
        or v == "DiffFiles" or v == "RemoteBrowse" or v == "RemoteConnect" or v == "RemoteFiles"
}

private fn is_ex_buffer_verb(v: String) -> bool {
    v == "b" or v == "buffer" or v == "bd" or v == "bdelete" or v == "sbuffer"
}

private fn is_ex_theme_verb(v: String) -> bool {
    v == "colorscheme" or v == "colo" or v == "theme"
}

private fn is_ex_set_verb(v: String) -> bool {
    v == "set" or v == "se"
}

private fn is_ex_telescope_verb(v: String) -> bool {
    v == "Telescope" or v == "telescope"
}

private fn is_ex_help_verb(v: String) -> bool {
    v == "h" or v == "help"
}

private fn is_ex_info_verb(v: String) -> bool {
    v == "Info" or v == "info"
}

private fn is_ex_apropos_verb(v: String) -> bool {
    v == "Apropos" or v == "apropos" or v == "AproposDocs" or v == "apropos-docs" or v == "apropos_docs"
}

private fn is_ex_shell_verb(v: String) -> bool {
    v == "term" or v == "terminal" or v == "vterm"
        or v == "TermSplit" or v == "TermVSplit" or v == "TermExec"
}

private fn ex_verb_expects_arg(raw_verb: String) -> bool {
    let v = normalize_ex_verb_base(raw_verb)
    if v == "w" or v == "write" {
        -- `:w` is commonly executed without arguments; user types `:w ` for Stage 2 path completion.
        return false
    }
    is_ex_file_verb(v) or is_ex_buffer_verb(v) or is_ex_theme_verb(v)
        or is_ex_set_verb(v) or is_ex_telescope_verb(v)
        or is_ex_help_verb(v) or is_ex_info_verb(v) or is_ex_apropos_verb(v)
        or v == "term" or v == "terminal" or v == "vterm"
}

