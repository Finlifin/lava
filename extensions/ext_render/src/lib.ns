-- ext_render: Color Themes, Multi-Language Lexical Syntax Highlighter & 2D Scene Compositor.
-- Publishes service `"lava.render.compositor"` (`RenderCompositor`), 4 built-in palettes,
-- lexical syntax runs, and full `DrawCmd` scene composition for splits, tabs, gutter,
-- visual-block/Emacs-mark selections, search matches, mode-lines, which-key, and minibuffer.

use std.collections.{HashMap, Set}
use std.env
use @lava_sys.{CaretShape, DrawCmd, FontMetrics, PointerHint, WindowSpec, rgb, rgba}
use @lava_core.{
    CommandSpec, ExtId, InteractiveEffects, KeyBindingEntry, PromptKind, PromptRequest,
    SystemKernel, ask_prompt, log_event, status_emit
}
use @lava_accel.{TsSpan, accel_ts_highlight_rows_packed, accel_ts_highlight_snippet}
use @ext_document.{
    ActiveBgJob, Buffer, BufferId, CompletionItem, CompletionPopup, EditorOptions, EditorWorld,
    FloatingWindow, GutterSign, InlineGhostText, InlineSpanDecor, MinibufferRichItem,
    MinibufferView, Pos, SignatureHelpPopup, SidebarPanel, Span, ToastNotification,
    VirtualTextDecor, VisualKind, ext_document_id, require_editor_world
}
use @ext_window.{
    ECHO_BAR_HEIGHT, Rect, TAB_BAR_HEIGHT, TabWorkspace, WinId, WindowManager, WindowPane,
    char_col_to_visual_col as win_char_col_to_visual_col,
    char_display_width as win_char_display_width, codepoint_display_width, compute_gutter_cols,
    compute_gutter_width, expand_tabs_from_col as win_expand_tabs_from_col, ext_window_id,
    heading_fold_level, mode_line_height, require_window_manager, safe_tabstop,
    str_display_width as win_str_display_width, visible_buffer_rows,
    visual_col_to_char_col as win_visual_col_to_char_col
}

pub const SERVICE_RENDERER: String = "lava.render.compositor"

pub fn ext_render_id() -> ExtId = ExtId("lava.org/ext_render")

-- ============================================================================
-- 1. Built-in Rich Color Themes (`ThemePalette`)
-- ============================================================================

pub struct ThemePalette {
    pub name: String,
    pub bg: i64,
    pub bg_alt: i64,
    pub bg_cursor_line: i64,
    pub bg_selection: i64,
    pub bg_search: i64,
    pub bg_status_active: i64,
    pub bg_status_inactive: i64,
    pub bg_tab_bar: i64,
    pub bg_popup: i64,
    pub border: i64,
    pub fg: i64,
    pub fg_muted: i64,
    pub fg_gutter: i64,
    pub fg_gutter_active: i64,
    pub accent: i64,
    pub mode_normal: i64,
    pub mode_insert: i64,
    pub mode_visual: i64,
    pub mode_replace: i64,
    pub mode_command: i64,
    pub syn_keyword: i64,
    pub syn_type: i64,
    pub syn_string: i64,
    pub syn_number: i64,
    pub syn_comment: i64,
    pub syn_fn: i64,
    pub syn_operator: i64,
    pub diag_ok: i64,
    pub diag_warn: i64,
    pub diag_err: i64,
}
derive PartialEq for ThemePalette

