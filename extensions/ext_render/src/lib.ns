pub fn builtin_theme_names() -> List {
    ["catppuccin-mocha", "gruvbox-dark", "one-dark", "solarized-light"]
}

pub fn all_theme_names() -> List {
    [
        "catppuccin-mocha",
        "tokyo-night",
        "rose-pine",
        "kanagawa",
        "nord",
        "gruvbox-dark",
        "one-dark",
        "solarized-light",
    ]
}

pub fn theme_by_name(name: String) -> ThemePalette {
    when {
        name == "tokyo-night" => tokyo_night_theme(),
        name == "rose-pine" => rose_pine_theme(),
        name == "kanagawa" => kanagawa_theme(),
        name == "nord" => nord_theme(),
        name == "gruvbox-dark" => gruvbox_dark_theme(),
        name == "one-dark" => one_dark_theme(),
        name == "solarized-light" => solarized_light_theme(),
        else => catppuccin_mocha_theme(),
    }
}

pub struct RenderCompositor {
    pub themes: HashMap,
    pub theme_order: List,
    pub active_theme_name: String,
}

impl RenderCompositor {
    pub fn new() -> RenderCompositor {
        let themes = HashMap.new()
        let order = builtin_theme_names()
        themes.insert("catppuccin-mocha", catppuccin_mocha_theme())
        themes.insert("tokyo-night", tokyo_night_theme())
        themes.insert("rose-pine", rose_pine_theme())
        themes.insert("kanagawa", kanagawa_theme())
        themes.insert("nord", nord_theme())
        themes.insert("gruvbox-dark", gruvbox_dark_theme())
        themes.insert("one-dark", one_dark_theme())
        themes.insert("solarized-light", solarized_light_theme())
        RenderCompositor {
            themes: themes,
            theme_order: order,
            active_theme_name: "catppuccin-mocha",
        }
    }

    pub fn get_theme(self, name: String) -> ThemePalette {
        let t_opt = self.themes.get(name)
        if t_opt != null {
            return t_opt.as(ThemePalette)
        }
        catppuccin_mocha_theme()
    }

    pub fn set_theme(self, name: String, world: EditorWorld) -> !String ThemePalette {
        if not self.themes.contains_key(name) {
            return error ("unknown theme: " ++ name)
        }
        self.active_theme_name = name
        world.options.theme_name = name
        self.themes.get(name).as(ThemePalette)
    }

    pub fn cycle_theme(self, world: EditorWorld) -> ThemePalette {
        let n = self.theme_order.len()
        var idx: i64 = 0
        for i in 0..n {
            if self.theme_order.get(i.as(usize)).as(String) == world.options.theme_name {
                idx = i
                break
            }
        }
        let next_name = self.theme_order.get(((idx + 1) % n).as(usize)).as(String)
        self.active_theme_name = next_name
        world.options.theme_name = next_name
        self.themes.get(next_name).as(ThemePalette)
    }
}

-- ============================================================================
-- 2. Multi-Language Lexical Syntax Highlighter (`tokenize_line`)
-- ============================================================================

fn char_at_list(cs: List, idx: i64) -> char {
    cs.get(idx.as(usize)).as(char)
}

fn is_ascii_digit_ch(ch: char) -> bool {
    ch.is_ascii_digit()
}

fn is_ascii_hex_ch(ch: char) -> bool {
    ch.is_ascii_hexdigit()
}

fn is_ascii_upper_ch(ch: char) -> bool {
    ch.is_ascii() and ch.is_uppercase()
}

fn is_ident_start_ch(ch: char) -> bool {
    ch.is_ascii_alphabetic() or ch == '_'
}

fn is_ident_continue_ch(ch: char) -> bool {
    ch.is_ascii_alphanumeric() or ch == '_'
}

fn push_run(runs: List, start_col: i64, text: String, color: i64, bold: bool, italic: bool) {
    if text == "" {
        return
    }
    if not runs.is_empty() {
        let last_idx = (runs.len() - 1).as(usize)
        let (p_col, p_text, p_color, p_bold, p_italic) =
            runs.get(last_idx).as((i64, String, i64, bool, bool))
        if p_color == color and p_bold == bold and p_italic == italic and p_col + p_text.char_len() == start_col {
            runs.set(last_idx, (p_col, p_text ++ text, p_color, p_bold, p_italic))
            return
        }
    }
    runs.push((start_col, text, color, bold, italic))
}

fn is_nessa_keyword(w: String) -> bool {
    w == "fn" or w == "pub" or w == "private" or w == "let" or w == "var"
    or w == "struct" or w == "enum" or w == "trait" or w == "impl" or w == "extend"
    or w == "effect" or w == "async" or w == "handles" or w == "catch" or w == "resume"
    or w == "match" or w == "when" or w == "if" or w == "else" or w == "while"
    or w == "for" or w == "in" or w == "return" or w == "error" or w == "use"
    or w == "newtype" or w == "derive" or w == "const" or w == "global"
    or w == "and" or w == "or" or w == "not" or w == "matches" or w == "true"
    or w == "false" or w == "null" or w == "break" or w == "continue" or w == "defer"
    or w == "typealias" or w == "assoc"
}

fn is_nessa_prim_type(w: String) -> bool {
    w == "i64" or w == "i32" or w == "i16" or w == "i8"
    or w == "u64" or w == "u32" or w == "u16" or w == "u8" or w == "usize"
    or w == "f64" or w == "f32" or w == "bool" or w == "char"
    or w == "String" or w == "List" or w == "Unit" or w == "Any"
    or w == "Continuation" or w == "Future"
}

fn is_rust_keyword(w: String) -> bool {
    w == "fn" or w == "pub" or w == "let" or w == "mut" or w == "struct" or w == "enum"
    or w == "trait" or w == "impl" or w == "match" or w == "if" or w == "else"
    or w == "while" or w == "for" or w == "in" or w == "loop" or w == "return"
    or w == "use" or w == "mod" or w == "crate" or w == "self" or w == "Self"
    or w == "super" or w == "where" or w == "type" or w == "const" or w == "static"
    or w == "async" or w == "await" or w == "move" or w == "ref" or w == "unsafe"
    or w == "dyn" or w == "true" or w == "false" or w == "break" or w == "continue" or w == "as"
}

fn is_rust_prim_type(w: String) -> bool {
    w == "i64" or w == "i32" or w == "i16" or w == "i8" or w == "isize"
    or w == "u64" or w == "u32" or w == "u16" or w == "u8" or w == "usize"
    or w == "f64" or w == "f32" or w == "bool" or w == "char" or w == "str"
}

fn is_python_keyword(w: String) -> bool {
    w == "def" or w == "class" or w == "import" or w == "from" or w == "as"
    or w == "if" or w == "elif" or w == "else" or w == "for" or w == "while"
    or w == "in" or w == "return" or w == "yield" or w == "with" or w == "try"
    or w == "except" or w == "finally" or w == "raise" or w == "pass"
    or w == "break" or w == "continue" or w == "lambda" or w == "and"
    or w == "or" or w == "not" or w == "is" or w == "None" or w == "True"
    or w == "False" or w == "async" or w == "await" or w == "global" or w == "nonlocal"
}

fn is_c_keyword(w: String) -> bool {
    w == "if" or w == "else" or w == "for" or w == "while" or w == "do"
    or w == "switch" or w == "case" or w == "default" or w == "return"
    or w == "break" or w == "continue" or w == "struct" or w == "enum"
    or w == "union" or w == "typedef" or w == "const" or w == "static"
    or w == "extern" or w == "sizeof" or w == "volatile" or w == "inline"
    or w == "class" or w == "namespace" or w == "template" or w == "typename"
    or w == "public" or w == "private" or w == "protected" or w == "nullptr"
    or w == "true" or w == "false" or w == "NULL"
}

fn is_c_prim_type(w: String) -> bool {
    w == "void" or w == "int" or w == "long" or w == "short" or w == "char"
    or w == "float" or w == "double" or w == "bool" or w == "unsigned" or w == "signed"
    or w == "size_t" or w == "ssize_t" or w == "int64_t" or w == "uint64_t"
    or w == "int32_t" or w == "uint32_t" or w == "uint8_t" or w == "uintptr_t"
}

fn is_code_operator_ch(ch: char) -> bool {
    ch == '#' or ch == '!' or ch == '?' or ch == '=' or ch == '+' or ch == '-'
    or ch == '*' or ch == '/' or ch == '%' or ch == '<' or ch == '>'
    or ch == '&' or ch == '|' or ch == '^' or ch == '~' or ch == ':'
}

fn scan_quoted_chars(cs: List, n: i64, start: i64, quote: char) -> i64 {
    var j = start + 1
    while j < n {
        let ch = char_at_list(cs, j)
        if ch == '\\' {
            j += 2
            continue
        }
        if ch == quote {
            return j + 1
        }
        j += 1
    }
    n
}

fn scan_number_chars(cs: List, n: i64, start: i64) -> i64 {
    var j = start
    if j + 2 <= n and char_at_list(cs, j) == '0' {
        let p1 = char_at_list(cs, j + 1)
        if p1 == 'x' or p1 == 'X' or p1 == 'b' or p1 == 'B' {
            j += 2
            while j < n {
                let c = char_at_list(cs, j)
                if is_ascii_hex_ch(c) or c == '_' {
                    j += 1
                } else {
                    break
                }
            }
            return j
        }
    }
    while j < n {
        let c = char_at_list(cs, j)
        if is_ascii_digit_ch(c) or c == '_' {
            j += 1
        } else {
            break
        }
    }
    if j + 1 < n and char_at_list(cs, j) == '.' and is_ascii_digit_ch(char_at_list(cs, j + 1)) {
        j += 1
        while j < n {
            let c = char_at_list(cs, j)
            if is_ascii_digit_ch(c) or c == '_' {
                j += 1
            } else {
                break
            }
        }
    }
    j
}

fn is_plain_code_char(c: char) -> bool {
    c != '"' and c != '\'' and c != '@' and c != '#' and c != '/' and c != '-'
    and (not is_ascii_digit_ch(c)) and (not is_ident_start_ch(c)) and (not is_code_operator_ch(c))
}

fn tokenize_code_line(line: String, mode: String, theme: ThemePalette) -> List {
    let runs = List()
    if line == "" {
        return runs
    }

    -- C/C++ preprocessor directive (`#include`, `#define`, ...) — NOT CSS `#id` or JS `#priv`!
    if mode == "c" and line.trim_start().starts_with("#") {
        push_run(runs, 0, line, theme.accent, false, false)
        return runs
    }

    let cs = line.chars()
    let n = cs.len()
    var i: i64 = 0
    var prev_word = ""
    while i < n {
        let ch = char_at_list(cs, i)
        let c1 = if i + 1 < n { char_at_list(cs, i + 1) } else { '\0' }

        -- Line comments
        if (mode == "nessa" or mode == "sql") and ch == '-' and c1 == '-' {
            push_run(runs, i, line.slice(i, n), theme.syn_comment, false, true)
            break
        }
        if (mode == "rust" or mode == "c" or mode == "js") and ch == '/' and c1 == '/' {
            push_run(runs, i, line.slice(i, n), theme.syn_comment, false, true)
            break
        }
        if (mode == "python" or mode == "shell") and ch == '#' {
            push_run(runs, i, line.slice(i, n), theme.syn_comment, false, true)
            break
        }

        -- Inline `/* ... */` block comment within a line
        if (mode == "c" or mode == "rust" or mode == "js" or mode == "css" or mode == "sql") and ch == '/' and c1 == '*' {
            var end_c = i + 2
            while end_c + 1 < n and not (char_at_list(cs, end_c) == '*' and char_at_list(cs, end_c + 1) == '/') {
                end_c += 1
            }
            let stop = if end_c + 1 < n { end_c + 2 } else { n }
            push_run(runs, i, line.slice(i, stop), theme.syn_comment, false, true)
            i = stop
            continue
        }

        -- String / character literals
        if ch == '"' {
            let stop = scan_quoted_chars(cs, n, i, '"')
            push_run(runs, i, line.slice(i, stop), theme.syn_string, false, false)
            i = stop
            continue
        }
        if ch == '\'' and (mode == "python" or mode == "c" or mode == "shell" or (i + 2 < n and char_at_list(cs, i + 2) == '\'')) {
            let stop = scan_quoted_chars(cs, n, i, '\'')
            push_run(runs, i, line.slice(i, stop), theme.syn_string, false, false)
            i = stop
            continue
        }

        -- Nessa `@pkg` import or Python `@decorator`
        if ch == '@' and i + 1 < n and is_ident_start_ch(c1) {
            var j = i + 1
            while j < n and is_ident_continue_ch(char_at_list(cs, j)) {
                j += 1
            }
            push_run(runs, i, line.slice(i, j), theme.accent, false, false)
            i = j
            continue
        }

        -- Numeric literals
        if is_ascii_digit_ch(ch) {
            let stop = scan_number_chars(cs, n, i)
            push_run(runs, i, line.slice(i, stop), theme.syn_number, false, false)
            i = stop
            continue
        }

        -- Identifiers, Keywords, Types, Function Names
        if is_ident_start_ch(ch) {
            var j = i + 1
            while j < n and is_ident_continue_ch(char_at_list(cs, j)) {
                j += 1
            }
            let word = line.slice(i, j)
            let next_ch = if j < n { char_at_list(cs, j) } else { '\0' }

            var is_kw = false
            var is_ty = false
            if mode == "nessa" {
                is_kw = is_nessa_keyword(word)
                is_ty = is_nessa_prim_type(word) or is_ascii_upper_ch(ch)
            } else if mode == "rust" {
                is_kw = is_rust_keyword(word)
                is_ty = is_rust_prim_type(word) or is_ascii_upper_ch(ch)
            } else if mode == "python" {
                is_kw = is_python_keyword(word)
                is_ty = (not is_kw) and is_ascii_upper_ch(ch)
            } else if mode == "c" {
                is_kw = is_c_keyword(word)
                is_ty = is_c_prim_type(word) or is_ascii_upper_ch(ch) or word.ends_with("_t")
            }

            if is_kw {
                push_run(runs, i, word, theme.syn_keyword, true, false)
            } else if is_ty {
                push_run(runs, i, word, theme.syn_type, false, false)
            } else if next_ch == '(' or prev_word == "fn" or prev_word == "def" {
                push_run(runs, i, word, theme.syn_fn, false, false)
            } else if mode == "rust" and next_ch == '!' {
                push_run(runs, i, line.slice(i, j + 1), theme.accent, false, false)
                prev_word = word
                i = j + 1
                continue
            } else {
                push_run(runs, i, word, theme.fg, false, false)
            }
            prev_word = word
            i = j
            continue
        }

        -- Contiguous operator runs (`->`, `=>`, `++`, `#!`, etc.)
        if is_code_operator_ch(ch) {
            var j = i + 1
            while j < n {
                let oc = char_at_list(cs, j)
                let oc_next = if j + 1 < n { char_at_list(cs, j + 1) } else { '\0' }
                let starts_comment = (mode == "nessa" and oc == '-' and oc_next == '-')
                    or ((mode == "rust" or mode == "c") and oc == '/' and (oc_next == '/' or oc_next == '*'))
                    or ((mode == "python" or mode == "shell") and oc == '#')
                if starts_comment {
                    break
                }
                if is_code_operator_ch(oc) {
                    j += 1
                } else {
                    break
                }
            }
            push_run(runs, i, line.slice(i, j), theme.syn_operator, false, false)
            i = j
            continue
        }

        -- Contiguous whitespace / punctuation runs in default foreground color
        var j = i + 1
        while j < n and is_plain_code_char(char_at_list(cs, j)) {
            j += 1
        }
        push_run(runs, i, line.slice(i, j), theme.fg, false, false)
        i = j
    }
    runs
}

fn tokenize_markup_words(
    line: String,
    cs: List,
    start_idx: i64,
    base_color: i64,
    base_bold: bool,
    base_italic: bool,
    theme: ThemePalette,
    runs: List,
) {
    let n = cs.len()
    var i = start_idx
    while i < n {
        let ch = char_at_list(cs, i)
        -- Inline code span `` `...` `` or Org `~...~`
        if ch == '`' or ch == '~' {
            var j = i + 1
            while j < n and char_at_list(cs, j) != ch {
                j += 1
            }
            if j < n and j > i + 1 {
                push_run(runs, i, line.slice(i, j + 1), theme.syn_string, false, false)
                i = j + 1
                continue
            }
        }
        -- Checkbox `[X]` or `[ ]`
        if i + 3 <= n and ch == '[' and char_at_list(cs, i + 2) == ']' {
            let mid = char_at_list(cs, i + 1)
            if mid == 'X' or mid == 'x' {
                push_run(runs, i, line.slice(i, i + 3), theme.diag_ok, true, false)
                i += 3
                continue
            }
            if mid == ' ' or mid == '-' {
                push_run(runs, i, line.slice(i, i + 3), theme.diag_warn, true, false)
                i += 3
                continue
            }
        }
        if is_ident_start_ch(ch) {
            var j = i + 1
            while j < n and is_ident_continue_ch(char_at_list(cs, j)) {
                j += 1
            }
            let word = line.slice(i, j)
            if word == "TODO" or word == "FIXME" or word == "WAIT" {
                push_run(runs, i, word, theme.diag_err, true, false)
            } else if word == "DONE" or word == "OK" {
                push_run(runs, i, word, theme.diag_ok, true, false)
            } else {
                push_run(runs, i, word, base_color, base_bold, base_italic)
            }
            i = j
            continue
        }
        var j = i + 1
        while j < n {
            let nc = char_at_list(cs, j)
            if nc == '`' or nc == '~' or nc == '[' or is_ident_start_ch(nc) {
                break
            }
            j += 1
        }
        push_run(runs, i, line.slice(i, j), base_color, base_bold, base_italic)
        i = j
    }
}

fn tokenize_org_line(line: String, theme: ThemePalette) -> List {
    let runs = List()
    if line == "" {
        return runs
    }
    if line.starts_with("#+") {
        push_run(runs, 0, line, theme.syn_comment, false, true)
        return runs
    }
    let cs = line.chars()
    let n = cs.len()
    var h: i64 = 0
    while h < n and char_at_list(cs, h) == '*' {
        h += 1
    }
    if h > 0 and h < n and char_at_list(cs, h) == ' ' {
        push_run(runs, 0, line.slice(0, h + 1), theme.accent, true, false)
        tokenize_markup_words(line, cs, h + 1, theme.accent, true, false, theme, runs)
        return runs
    }
    if line.trim_start().starts_with(">") {
        push_run(runs, 0, line, theme.syn_comment, false, true)
        return runs
    }
    tokenize_markup_words(line, cs, 0, theme.fg, false, false, theme, runs)
    runs
}

pub fn canonical_fence_mode(info_raw: String) -> String {
    let trimmed = info_raw.trim()
    if trimmed == "" {
        return ""
    }
    let n = trimmed.char_len()
    var s: i64 = 0
    while s < n {
        let ch = trimmed.slice(s, s + 1)
        if ch == "{{" or ch == "." or ch == " " {
            s += 1
        } else {
            break
        }
    }
    var e = s
    while e < n {
        let ch = trimmed.slice(e, e + 1)
        if ch == " " or ch == "\t" or ch == "," or ch == "}}" or ch == "{{" {
            break
        }
        e += 1
    }
    if e <= s {
        return ""
    }
    let lang = trimmed.slice(s, e).to_lower()
    if lang == "text" or lang == "txt" or lang == "plain" or lang == "plaintext" or lang == "ascii" {
        return ""
    }
    when {
        lang == "rust" or lang == "rs" => "rust",
        lang == "nessa" or lang == "ns" => "nessa",
        lang == "lua" => "lua",
        lang == "python" or lang == "py" => "python",
        lang == "ts" or lang == "typescript" => "typescript",
        lang == "tsx" => "tsx",
        lang == "js" or lang == "jsx" or lang == "javascript" or lang == "mjs" => "javascript",
        lang == "css" or lang == "scss" or lang == "less" => "css",
        lang == "html" or lang == "htm" or lang == "xml" or lang == "svg" => "html",
        lang == "c" or lang == "h" => "c",
        lang == "cpp" or lang == "c++" or lang == "cc" or lang == "cxx" or lang == "hpp" => "cpp",
        lang == "java" or lang == "kotlin" or lang == "kt" or lang == "cs" or lang == "csharp" => "java",
        lang == "go" or lang == "golang" => "go",
        lang == "zig" => "zig",
        lang == "sql" => "sql",
        lang == "sh" or lang == "bash" or lang == "zsh" or lang == "shell" or lang == "fish" or lang == "console" or lang == "makefile" or lang == "make" => "shell",
        lang == "json" or lang == "jsonc" => "json",
        lang == "toml" or lang == "ini" or lang == "conf" => "toml",
        lang == "yaml" or lang == "yml" => "yaml",
        lang == "diff" or lang == "patch" => "diff",
        lang == "markdown" or lang == "md" or lang == "gfm" => "markdown",
        lang == "org" => "org",
        else => lang,
    }
}

fn strip_md_quote_and_indent(line: String) -> (String, i64) {
    let blen = line.len()
    var sp: i64 = 0
    while sp < blen and sp < 12 and (line.byte_at(sp) == 32 or line.byte_at(sp) == 9) {
        sp += 1
    }
    var pos = sp
    var saw_q = false
    while pos < blen and line.byte_at(pos) == 62 {
        saw_q = true
        pos += 1
        while pos < blen and (line.byte_at(pos) == 32 or line.byte_at(pos) == 9) {
            pos += 1
        }
    }
    if saw_q {
        return (line.drop(pos), 0)
    }
    (line.drop(sp), sp)
}

fn parse_markdown_fence_open(line: String) -> ?(char, i64, String) {
    let (s, _) = strip_md_quote_and_indent(line)
    let blen = s.len()
    if blen < 3 {
        return null
    }
    let b_fc = s.byte_at(0)
    if b_fc != 96 and b_fc != 126 {
        return null
    }
    var flen: i64 = 0
    while flen < blen and s.byte_at(flen) == b_fc {
        flen += 1
    }
    if flen < 3 {
        return null
    }
    let rest = s.drop(flen)
    if b_fc == 96 and rest.contains("`") {
        return null
    }
    let fc = if b_fc == 96 { '`' } else { '~' }
    (fc, flen, rest.trim())
}

fn is_markdown_fence_close(line: String, fence_char: char, min_len: i64) -> bool {
    let (s, _) = strip_md_quote_and_indent(line)
    let blen = s.len()
    if blen < min_len {
        return false
    }
    let target_b: i64 = if fence_char == '`' { 96 } else { 126 }
    var flen: i64 = 0
    while flen < blen and s.byte_at(flen) == target_b {
        flen += 1
    }
    if flen < min_len {
        return false
    }
    var k = flen
    while k < blen {
        let b = s.byte_at(k)
        if b != 32 and b != 9 {
            return false
        }
        k += 1
    }
    true
}

private struct MdFenceCacheEntry {
    doc_id: i64,
    edit_version: i64,
    total_lines: i64,
    buf_name: String,
    line0: String,
    in_fence: bool,
    in_html_cmt: bool,
    in_frontmatter: bool,
    fence_ch: char,
    fence_min_len: i64,
    fence_mode: String,
    fence_open_row: i64,
    states: List,
}

private global _md_fence_cache: ?HashMap = null

private fn ensure_md_fence_cache() -> HashMap {
    let existing? = _md_fence_cache else {
        let m = HashMap.new()
        _md_fence_cache = m
        return m
    }
    existing
}

private fn has_valid_frontmatter_close(buf: Buffer, total: i64) -> bool {
    if total < 2 or buf.line_at(0).trim_end() != "---" {
        return false
    }
    let max_scan = if total < 64 { total } else { 64 }
    for r in 1..max_scan {
        let t = buf.line_at(r).trim_end()
        if t == "---" or t == "..." {
            return true
        }
    }
    false
}

private fn extend_markdown_fence_entry(entry: MdFenceCacheEntry, buf: Buffer, limit: i64) {
    let start_r = entry.states.len()
    if start_r > limit {
        return
    }
    var in_fence = entry.in_fence
    var in_html_cmt = entry.in_html_cmt
    var in_fm = entry.in_frontmatter
    var fence_ch = entry.fence_ch
    var fence_min_len = entry.fence_min_len
    var fence_mode = entry.fence_mode
    var fence_open_row = entry.fence_open_row

    for r in start_r..(limit + 1) {
        let ln = buf.line_at(r)
        if r == 0 and has_valid_frontmatter_close(buf, entry.total_lines) {
            in_fm = true
            entry.states.push((3, "", 0))
            continue
        }
        if in_fm {
            let t = ln.trim_end()
            if t == "---" or t == "..." {
                in_fm = false
                entry.states.push((3, "", 0))
            } else {
                entry.states.push((4, "yaml", 0))
            }
            continue
        }
        if in_fence {
            if is_markdown_fence_close(ln, fence_ch, fence_min_len) {
                entry.states.push((1, fence_mode, fence_open_row))
                in_fence = false
                fence_mode = ""
                fence_open_row = -1
            } else {
                entry.states.push((2, fence_mode, fence_open_row))
            }
            continue
        }
        if in_html_cmt {
            entry.states.push((5, "", -1))
            if ln.contains("-->") {
                in_html_cmt = false
            }
            continue
        }
        let open_opt = parse_markdown_fence_open(ln)
        if open_opt != null {
            let (fc, flen, info_str) = open_opt.as((char, i64, String))
            in_fence = true
            fence_ch = fc
            fence_min_len = flen
            fence_mode = canonical_fence_mode(info_str)
            fence_open_row = r
            entry.states.push((1, fence_mode, r))
            continue
        }
        let trimmed_s = ln.trim_start()
        if trimmed_s.starts_with("<!--") {
            if not trimmed_s.contains("-->") {
                in_html_cmt = true
            }
            entry.states.push((5, "", -1))
            continue
        }
        entry.states.push((0, "", -1))
    }
    entry.in_fence = in_fence
    entry.in_html_cmt = in_html_cmt
    entry.in_frontmatter = in_fm
    entry.fence_ch = fence_ch
    entry.fence_min_len = fence_min_len
    entry.fence_mode = fence_mode
    entry.fence_open_row = fence_open_row
}

-- Returns per-row `(state_kind: i64, fence_mode: String, open_row: i64)` for `0..=end_row`:
-- `0` = normal markdown, `1` = fence delimiter, `2` = fenced code body,
-- `3` = YAML frontmatter delimiter, `4` = YAML frontmatter body, `5` = HTML block comment.
fn compute_markdown_fence_states(buf: Buffer, end_row: i64) -> List {
    buf.sync_external_lines()
    let total = buf.line_count()
    if total <= 0 or end_row < 0 {
        return List()
    }
    let limit = if end_row >= total { total - 1 } else { end_row }
    let line0 = buf.line_at(0)
    let cache = ensure_md_fence_cache()
    let cached_opt = cache.get(buf.id)
    if cached_opt != null {
        let entry = cached_opt.as(MdFenceCacheEntry)
        if entry.doc_id == buf.doc_id
            and entry.edit_version == buf.edit_version
            and entry.total_lines == total
            and entry.buf_name == buf.name
            and entry.line0 == line0 {
            if entry.states.len() <= limit {
                extend_markdown_fence_entry(entry, buf, limit)
            }
            return entry.states
        }
    }
    if cache.len() > 32 {
        cache.clear()
    }
    let fresh = MdFenceCacheEntry {
        doc_id: buf.doc_id,
        edit_version: buf.edit_version,
        total_lines: total,
        buf_name: buf.name,
        line0: line0,
        in_fence: false,
        in_html_cmt: false,
        in_frontmatter: false,
        fence_ch: '`',
        fence_min_len: 3,
        fence_mode: "",
        fence_open_row: -1,
        states: List(),
    }
    extend_markdown_fence_entry(fresh, buf, limit)
    cache.insert(buf.id, fresh)
    fresh.states
}

fn tokenize_markdown_fence_delim(line: String, theme: ThemePalette) -> List {
    let runs = List()
    let cs = line.chars()
    let n = cs.len()
    if n == 0 {
        return runs
    }
    var sp: i64 = 0
    while sp < n and (char_at_list(cs, sp) == ' ' or char_at_list(cs, sp) == '\t' or char_at_list(cs, sp) == '>') {
        sp += 1
    }
    var f_end = sp
    if f_end < n {
        let fc = char_at_list(cs, f_end)
        while f_end < n and char_at_list(cs, f_end) == fc {
            f_end += 1
        }
    }
    push_run(runs, 0, line.slice(0, f_end), theme.fg_muted, false, false)
    if f_end < n {
        push_run(runs, f_end, line.slice(f_end, n), theme.syn_operator, false, false)
    }
    runs
}

fn is_markdown_hr(cs: List, n: i64) -> bool {
    var sp: i64 = 0
    while sp < n and sp < 4 and char_at_list(cs, sp) == ' ' {
        sp += 1
    }
    if sp >= 4 or sp >= n {
        return false
    }
    let rule_ch = char_at_list(cs, sp)
    if rule_ch != '-' and rule_ch != '*' and rule_ch != '_' {
        return false
    }
    var count: i64 = 0
    for i in sp..n {
        let c = char_at_list(cs, i)
        if c == rule_ch {
            count += 1
        } else if c != ' ' and c != '\t' {
            return false
        }
    }
    count >= 3
}

fn is_markdown_table_sep(cs: List, n: i64) -> bool {
    var i: i64 = 0
    while i < n and (char_at_list(cs, i) == ' ' or char_at_list(cs, i) == '\t') {
        i += 1
    }
    if i >= n {
        return false
    }
    var saw_pipe = false
    var valid_cells: i64 = 0
    if char_at_list(cs, i) == '|' {
        saw_pipe = true
        i += 1
    }
    while i < n {
        while i < n and (char_at_list(cs, i) == ' ' or char_at_list(cs, i) == '\t') {
            i += 1
        }
        if i >= n {
            break
        }
        if char_at_list(cs, i) == '|' {
            return false
        }
        if char_at_list(cs, i) == ':' {
            i += 1
        }
        var dashes: i64 = 0
        while i < n and char_at_list(cs, i) == '-' {
            dashes += 1
            i += 1
        }
        if dashes == 0 {
            return false
        }
        if i < n and char_at_list(cs, i) == ':' {
            i += 1
        }
        while i < n and (char_at_list(cs, i) == ' ' or char_at_list(cs, i) == '\t') {
            i += 1
        }
        valid_cells += 1
        if i < n {
            if char_at_list(cs, i) == '|' {
                saw_pipe = true
                i += 1
            } else {
                return false
            }
        }
    }
    saw_pipe and valid_cells >= 1
}

fn is_probable_markdown_table_line(cs: List, n: i64) -> bool {
    var i: i64 = 0
    while i < n and (char_at_list(cs, i) == ' ' or char_at_list(cs, i) == '\t') {
        i += 1
    }
    if i >= n {
        return false
    }
    if char_at_list(cs, i) == '|' {
        return true
    }
    var pipes: i64 = 0
    var in_bt = false
    var k = i
    while k < n {
        let c = char_at_list(cs, k)
        if c == '\\' {
            k += 2
            continue
        }
        if c == '`' {
            in_bt = not in_bt
            k += 1
            continue
        }
        if (not in_bt) and c == '|' {
            if k + 1 < n and char_at_list(cs, k + 1) == '|' {
                k += 2
                continue
            }
            pipes += 1
        }
        k += 1
    }
    pipes >= 2
}

-- Scan matching closing backtick run of exact length `bt_len`, returning index of closing run or `-1`.
fn scan_md_backtick_close(cs: List, start_after_open: i64, end_idx: i64, bt_len: i64) -> i64 {
    var k = start_after_open
    while k + bt_len <= end_idx {
        if char_at_list(cs, k) == '`' {
            var run_len: i64 = 1
            while k + run_len < end_idx and char_at_list(cs, k + run_len) == '`' {
                run_len += 1
            }
            if run_len == bt_len {
                return k
            }
            k += run_len
            continue
        }
        k += 1
    }
    -1
}

-- Scan `[label](dest)` starting at `open_brk` (`cs[open_brk] == '['`), supporting `` `code` ``,
-- nested `![img](...)`, balanced `(parens)`, and optional `"title"`. Returns `(close_brk, url_start, url_end, close_paren)` or `null`.
fn scan_md_inline_link(cs: List, open_brk: i64, end_idx: i64) -> ?(i64, i64, i64, i64) {
    var k = open_brk + 1
    var brk_depth: i64 = 1
    while k < end_idx {
        let c = char_at_list(cs, k)
        if c == '\\' {
            k += 2
            continue
        }
        if c == '`' {
            var bt: i64 = 1
            while k + bt < end_idx and char_at_list(cs, k + bt) == '`' {
                bt += 1
            }
            let close_bt = scan_md_backtick_close(cs, k + bt, end_idx, bt)
            if close_bt >= 0 {
                k = close_bt + bt
                continue
            }
            k += bt
            continue
        }
        if c == '[' {
            brk_depth += 1
        } else if c == ']' {
            brk_depth -= 1
            if brk_depth == 0 {
                break
            }
        }
        k += 1
    }
    if brk_depth != 0 or k + 1 >= end_idx or char_at_list(cs, k + 1) != '(' {
        return null
    }
    var p = k + 2
    while p < end_idx and (char_at_list(cs, p) == ' ' or char_at_list(cs, p) == '\t') {
        p += 1
    }
    let url_start = p
    var url_end = p
    if p < end_idx and char_at_list(cs, p) == '<' {
        p += 1
        while p < end_idx and char_at_list(cs, p) != '>' {
            if char_at_list(cs, p) == '\\' {
                p += 2
                continue
            }
            p += 1
        }
        if p >= end_idx {
            return null
        }
        p += 1
        url_end = p
    } else {
        var pdepth: i64 = 0
        while p < end_idx {
            let pc = char_at_list(cs, p)
            if pc == '\\' {
                p += 2
                url_end = p
                continue
            }
            if pc == '(' {
                pdepth += 1
                p += 1
                url_end = p
                continue
            }
            if pc == ')' {
                if pdepth == 0 {
                    break
                }
                pdepth -= 1
                p += 1
                url_end = p
                continue
            }
            if (pc == ' ' or pc == '\t') and pdepth == 0 {
                break
            }
            p += 1
            url_end = p
        }
    }
    -- Optional link title `"..."` or `'...'` before closing `)`
    while p < end_idx and (char_at_list(cs, p) == ' ' or char_at_list(cs, p) == '\t') {
        p += 1
    }
    if p < end_idx and (char_at_list(cs, p) == '"' or char_at_list(cs, p) == '\'') {
        let qch = char_at_list(cs, p)
        p += 1
        while p < end_idx and char_at_list(cs, p) != qch {
            if char_at_list(cs, p) == '\\' {
                p += 2
                continue
            }
            p += 1
        }
        if p >= end_idx {
            return null
        }
        p += 1
        while p < end_idx and (char_at_list(cs, p) == ' ' or char_at_list(cs, p) == '\t') {
            p += 1
        }
    }
    if p < end_idx and char_at_list(cs, p) == ')' {
        return (k, url_start, url_end, p)
    }
    null
}

fn is_md_word_char(c: char) -> bool {
    (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_'
}

fn collect_markdown_link_url_decors(line: String, row: i64, theme: ThemePalette, out: List) {
    if (not line.contains("](")) and (not line.contains("<http")) {
        return
    }
    let cs = line.chars()
    let n = cs.len()
    var i: i64 = 0
    while i < n {
        let ch = char_at_list(cs, i)
        if ch == '\\' {
            i += 2
            continue
        }
        if ch == '`' {
            var bt: i64 = 1
            while i + bt < n and char_at_list(cs, i + bt) == '`' {
                bt += 1
            }
            let close_bt = scan_md_backtick_close(cs, i + bt, n, bt)
            if close_bt >= 0 {
                i = close_bt + bt
            } else {
                i += bt
            }
            continue
        }
        if ch == '<' and i + 8 < n {
            let sub = line.slice(i + 1, if i + 10 < n { i + 10 } else { n })
            if sub.starts_with("http://") or sub.starts_with("https://") {
                var e = i + 1
                while e < n and char_at_list(cs, e) != '>' and char_at_list(cs, e) != ' ' {
                    e += 1
                }
                if e < n and char_at_list(cs, e) == '>' {
                    out.push(InlineSpanDecor {
                        owner: "markdown:url",
                        row: row,
                        start_col: i + 1,
                        end_col: e,
                        bg_rgba: 0,
                        fg_rgba: theme.syn_operator,
                        underline: true,
                        replace_label: "",
                    })
                    i = e + 1
                    continue
                }
            }
        }
        if ch == '[' {
            let link_opt = scan_md_inline_link(cs, i, n)
            if link_opt != null {
                let (_, us, ue, cp) = link_opt.as((i64, i64, i64, i64))
                if ue > us {
                    out.push(InlineSpanDecor {
                        owner: "markdown:url",
                        row: row,
                        start_col: us,
                        end_col: ue,
                        bg_rgba: 0,
                        fg_rgba: theme.syn_operator,
                        underline: true,
                        replace_label: "",
                    })
                }
                i = cp + 1
                continue
            }
        }
        i += 1
    }
}

fn tokenize_markdown_inline(
    line: String,
    cs: List,
    start_idx: i64,
    end_idx: i64,
    base_color: i64,
    base_italic: bool,
    is_table: bool,
    theme: ThemePalette,
    runs: List,
) {
    var i = start_idx
    while i < end_idx {
        let ch = char_at_list(cs, i)

        -- 0. Backslash escape (`\*`, `` \` ``, `\[`, `\|`, `\\`, `\$`, etc.)
        if ch == '\\' and i + 1 < end_idx {
            push_run(runs, i, "\\", theme.fg_muted, false, false)
            push_run(runs, i + 1, line.slice(i + 1, i + 2), base_color, false, base_italic)
            i += 2
            continue
        }

        -- 0b. Inline HTML comment `<!-- ... -->`
        if ch == '<' and i + 4 <= end_idx and line.slice(i, i + 4) == "<!--" {
            var hc = i + 4
            var close_hc: i64 = -1
            while hc + 3 <= end_idx {
                if char_at_list(cs, hc) == '-' and char_at_list(cs, hc + 1) == '-' and char_at_list(cs, hc + 2) == '>' {
                    close_hc = hc + 3
                    break
                }
                hc += 1
            }
            let stop_hc = if close_hc > i { close_hc } else { end_idx }
            push_run(runs, i, line.slice(i, stop_hc), theme.syn_comment, false, true)
            i = stop_hc
            continue
        }

        -- 0c. Autolink `<https://...>` / `<http://...>`
        if ch == '<' and i + 8 < end_idx {
            let sub = line.slice(i + 1, if i + 10 < end_idx { i + 10 } else { end_idx })
            if sub.starts_with("http://") or sub.starts_with("https://") {
                var e = i + 1
                while e < end_idx and char_at_list(cs, e) != '>' and char_at_list(cs, e) != ' ' {
                    e += 1
                }
                if e < end_idx and char_at_list(cs, e) == '>' {
                    push_run(runs, i, "<", theme.fg_muted, false, false)
                    push_run(runs, i + 1, line.slice(i + 1, e), theme.syn_operator, false, false)
                    push_run(runs, e, ">", theme.fg_muted, false, false)
                    i = e + 1
                    continue
                }
            }
        }

        -- 1. Inline code span `` `...` `` (including multi-backtick spans)
        if ch == '`' {
            var bt_len: i64 = 1
            while i + bt_len < end_idx and char_at_list(cs, i + bt_len) == '`' {
                bt_len += 1
            }
            let found_close = scan_md_backtick_close(cs, i + bt_len, end_idx, bt_len)
            if found_close >= 0 {
                push_run(runs, i, line.slice(i, found_close + bt_len), theme.syn_string, false, false)
                i = found_close + bt_len
                continue
            }
            push_run(runs, i, line.slice(i, i + bt_len), base_color, false, base_italic)
            i += bt_len
            continue
        }

        -- 1b. Inline LaTeX math `$$...$$` or `$...$`
        if ch == '$' {
            let is_dbl = i + 1 < end_idx and char_at_list(cs, i + 1) == '$'
            let dlen: i64 = if is_dbl { 2 } else { 1 }
            if i + dlen < end_idx {
                let after_m = char_at_list(cs, i + dlen)
                if is_dbl or (after_m != ' ' and after_m != '\t' and after_m != '$') {
                    var mk = i + dlen
                    var close_m: i64 = -1
                    while mk + dlen <= end_idx {
                        let mc = char_at_list(cs, mk)
                        if mc == '\\' {
                            mk += 2
                            continue
                        }
                        if is_table and mc == '|' {
                            break
                        }
                        if mc == '$' {
                            if is_dbl and char_at_list(cs, mk + 1) == '$' {
                                close_m = mk + 2
                                break
                            }
                            if (not is_dbl)
                                and char_at_list(cs, mk - 1) != ' '
                                and (mk + 1 >= end_idx or (not is_ascii_digit_ch(char_at_list(cs, mk + 1)))) {
                                close_m = mk + 1
                                break
                            }
                        }
                        mk += 1
                    }
                    if close_m > i + dlen {
                        push_run(runs, i, line.slice(i, close_m), theme.syn_number, false, true)
                        i = close_m
                        continue
                    }
                }
            }
        }

        -- 2. Markdown link `[text](url)` or image `![alt](url)`
        if ch == '[' or (ch == '!' and i + 1 < end_idx and char_at_list(cs, i + 1) == '[') {
            let open_brk = if ch == '!' { i + 1 } else { i }
            let link_opt = scan_md_inline_link(cs, open_brk, end_idx)
            if link_opt != null {
                let (close_brk, _us, _ue, close_paren) = link_opt.as((i64, i64, i64, i64))
                push_run(runs, i, line.slice(i, open_brk + 1), theme.fg_muted, false, base_italic)
                if close_brk > open_brk + 1 {
                    tokenize_markdown_inline(line, cs, open_brk + 1, close_brk, theme.accent, base_italic, false, theme, runs)
                }
                push_run(runs, close_brk, "](", theme.fg_muted, false, base_italic)
                if close_paren > close_brk + 2 {
                    push_run(runs, close_brk + 2, line.slice(close_brk + 2, close_paren), theme.syn_operator, false, base_italic)
                }
                push_run(runs, close_paren, ")", theme.fg_muted, false, base_italic)
                i = close_paren + 1
                continue
            }
        }

        -- 2b. GFM Strikethrough `~~...~~`
        if ch == '~' and i + 3 < end_idx and char_at_list(cs, i + 1) == '~' and char_at_list(cs, i + 2) != ' ' and char_at_list(cs, i + 2) != '~' {
            var sk = i + 2
            var close_st: i64 = -1
            while sk + 1 < end_idx {
                let sc = char_at_list(cs, sk)
                if sc == '\\' {
                    sk += 2
                    continue
                }
                if is_table and sc == '|' {
                    break
                }
                if sc == '`' {
                    var bt: i64 = 1
                    while sk + bt < end_idx and char_at_list(cs, sk + bt) == '`' {
                        bt += 1
                    }
                    let cb = scan_md_backtick_close(cs, sk + bt, end_idx, bt)
                    sk = if cb >= 0 { cb + bt } else { sk + bt }
                    continue
                }
                if sc == '~' and char_at_list(cs, sk + 1) == '~' and char_at_list(cs, sk - 1) != ' ' {
                    close_st = sk
                    break
                }
                sk += 1
            }
            if close_st > i + 2 {
                push_run(runs, i, line.slice(i, close_st + 2), theme.fg_muted, false, base_italic)
                i = close_st + 2
                continue
            }
        }

        -- 3a. Bold + Italic `***...***` or `___...___`
        if i + 5 < end_idx and (ch == '*' or ch == '_') and char_at_list(cs, i + 1) == ch and char_at_list(cs, i + 2) == ch {
            let prev_ok = ch == '*' or i == 0 or (not is_md_word_char(char_at_list(cs, i - 1)))
            let after_open = char_at_list(cs, i + 3)
            if prev_ok and after_open != ' ' and after_open != ch {
                var k = i + 3
                var close_bi: i64 = -1
                while k + 2 < end_idx {
                    let kc = char_at_list(cs, k)
                    if kc == '\\' {
                        k += 2
                        continue
                    }
                    if is_table and kc == '|' {
                        break
                    }
                    if kc == '`' {
                        var bt: i64 = 1
                        while k + bt < end_idx and char_at_list(cs, k + bt) == '`' {
                            bt += 1
                        }
                        let cb = scan_md_backtick_close(cs, k + bt, end_idx, bt)
                        k = if cb >= 0 { cb + bt } else { k + bt }
                        continue
                    }
                    if kc == ch and char_at_list(cs, k + 1) == ch and char_at_list(cs, k + 2) == ch and char_at_list(cs, k - 1) != ' ' {
                        let next_ok = ch == '*' or k + 3 >= end_idx or (not is_md_word_char(char_at_list(cs, k + 3)))
                        if next_ok {
                            close_bi = k
                            break
                        }
                    }
                    k += 1
                }
                if close_bi > i + 3 {
                    push_run(runs, i, line.slice(i, i + 3), theme.syn_number, false, true)
                    tokenize_markdown_inline(line, cs, i + 3, close_bi, theme.syn_number, true, is_table, theme, runs)
                    push_run(runs, close_bi, line.slice(close_bi, close_bi + 3), theme.syn_number, false, true)
                    i = close_bi + 3
                    continue
                }
            }
        }

        -- 3b. Strong emphasis `**...**` or `__...__` (respecting intraword `__init__` boundaries!)
        if i + 3 < end_idx and (ch == '*' or ch == '_') and char_at_list(cs, i + 1) == ch {
            let prev_ok = ch == '*' or i == 0 or (not is_md_word_char(char_at_list(cs, i - 1)))
            let after_open = char_at_list(cs, i + 2)
            if prev_ok and after_open != ' ' and after_open != ch {
                var k = i + 2
                var close_strong: i64 = -1
                while k + 1 < end_idx {
                    let kc = char_at_list(cs, k)
                    if kc == '\\' {
                        k += 2
                        continue
                    }
                    if is_table and kc == '|' {
                        break
                    }
                    if kc == '`' {
                        var bt: i64 = 1
                        while k + bt < end_idx and char_at_list(cs, k + bt) == '`' {
                            bt += 1
                        }
                        let cb = scan_md_backtick_close(cs, k + bt, end_idx, bt)
                        k = if cb >= 0 { cb + bt } else { k + bt }
                        continue
                    }
                    if kc == ch and char_at_list(cs, k + 1) == ch and char_at_list(cs, k - 1) != ' ' {
                        let next_ok = ch == '*' or k + 2 >= end_idx or (not is_md_word_char(char_at_list(cs, k + 2)))
                        if next_ok {
                            close_strong = k
                            break
                        }
                    }
                    k += 1
                }
                if close_strong > i + 2 {
                    push_run(runs, i, line.slice(i, i + 2), theme.syn_number, false, base_italic)
                    tokenize_markdown_inline(line, cs, i + 2, close_strong, theme.syn_number, base_italic, is_table, theme, runs)
                    push_run(runs, close_strong, line.slice(close_strong, close_strong + 2), theme.syn_number, false, base_italic)
                    i = close_strong + 2
                    continue
                }
            }
        }

        -- 4. Italic emphasis `*...*` or `_..._` (`italic = true`, `bold = false`, intraword-safe for `_`)
        if (ch == '*' or ch == '_') and i + 2 < end_idx and char_at_list(cs, i + 1) != ch and char_at_list(cs, i + 1) != ' ' {
            let prev_ok = ch == '*' or i == 0 or (not is_md_word_char(char_at_list(cs, i - 1)))
            if prev_ok {
                var k = i + 1
                var close_em: i64 = -1
                while k < end_idx {
                    let kc = char_at_list(cs, k)
                    if kc == '\\' {
                        k += 2
                        continue
                    }
                    if is_table and kc == '|' {
                        break
                    }
                    if kc == '`' {
                        var bt: i64 = 1
                        while k + bt < end_idx and char_at_list(cs, k + bt) == '`' {
                            bt += 1
                        }
                        let cb = scan_md_backtick_close(cs, k + bt, end_idx, bt)
                        k = if cb >= 0 { cb + bt } else { k + bt }
                        continue
                    }
                    -- Skip nested `**` or `__` pairs while scanning for single closing `*` or `_`!
                    if kc == ch and k + 1 < end_idx and char_at_list(cs, k + 1) == ch {
                        k += 2
                        continue
                    }
                    if kc == ch and char_at_list(cs, k - 1) != ' ' {
                        let next_ok = ch == '*' or k + 1 >= end_idx or (not is_md_word_char(char_at_list(cs, k + 1)))
                        if next_ok {
                            close_em = k
                            break
                        }
                    }
                    k += 1
                }
                if close_em > i + 1 {
                    push_run(runs, i, line.slice(i, i + 1), theme.syn_type, false, true)
                    tokenize_markdown_inline(line, cs, i + 1, close_em, theme.syn_type, true, is_table, theme, runs)
                    push_run(runs, close_em, line.slice(close_em, close_em + 1), theme.syn_type, false, true)
                    i = close_em + 1
                    continue
                }
            }
        }

        -- 5. Table pipe separator `|`
        if is_table and ch == '|' {
            push_run(runs, i, "|", theme.accent, false, false)
            i += 1
            continue
        }

        -- 6. Plain prose / CJK run up to next potential inline delimiter
        var j = i + 1
        while j < end_idx {
            let nc = char_at_list(cs, j)
            if nc == '\\'
                or nc == '<'
                or nc == '`'
                or nc == '$'
                or nc == '['
                or nc == '!'
                or nc == '~'
                or nc == '*'
                or nc == '_'
                or (is_table and nc == '|') {
                break
            }
            j += 1
        }
        push_run(runs, i, line.slice(i, j), base_color, false, base_italic)
        i = j
    }
}

fn tokenize_markdown_line(line: String, theme: ThemePalette) -> List {
    let runs = List()
    if line == "" {
        return runs
    }
    if parse_markdown_fence_open(line) != null {
        return tokenize_markdown_fence_delim(line, theme)
    }
    let cs = line.chars()
    let n = cs.len()

    -- Reference link definition `[id]: https://...`
    let trimmed_s = line.trim_start()
    if trimmed_s.starts_with("[") and (not trimmed_s.starts_with("[!")) and line.contains("]: ") {
        let sep_opt = line.find("]: ")
        if sep_opt != null {
            let sep_i = sep_opt.as(i64)
            if not line.slice(0, sep_i).contains("]") {
                push_run(runs, 0, line.slice(0, sep_i + 2), theme.accent, false, false)
                push_run(runs, sep_i + 2, line.drop(sep_i + 2), theme.syn_operator, false, false)
                return runs
            }
        }
    }

    -- Table separator row (`| --- | :---: |` — checked BEFORE `is_markdown_hr` so `| - |` works!)
    if is_markdown_table_sep(cs, n) {
        for i in 0..n {
            let c = char_at_list(cs, i)
            let col = if c == '|' {
                theme.accent
            } else if c == ':' {
                theme.syn_keyword
            } else {
                theme.border
            }
            push_run(runs, i, line.slice(i, i + 1), col, false, false)
        }
        return runs
    }

    -- Horizontal rule (`---`, `***`, `___`)
    if is_markdown_hr(cs, n) {
        push_run(runs, 0, line, theme.border, false, false)
        return runs
    }

    -- Count leading spaces
    var sp: i64 = 0
    while sp < n and char_at_list(cs, sp) == ' ' {
        sp += 1
    }

    -- ATX headings `# `..`###### ` (optional 0..3 leading spaces, space or tab or EOL after `#`)
    if sp <= 3 and sp < n and char_at_list(cs, sp) == '#' {
        var hashes: i64 = 0
        while sp + hashes < n and char_at_list(cs, sp + hashes) == '#' {
            hashes += 1
        }
        let next_after_h = if sp + hashes < n { char_at_list(cs, sp + hashes) } else { ' ' }
        if hashes >= 1 and hashes <= 6 and (sp + hashes == n or next_after_h == ' ' or next_after_h == '\t') {
            let h_color = when {
                hashes == 1 => theme.syn_fn,
                hashes == 2 => theme.accent,
                hashes == 3 => theme.syn_type,
                hashes == 4 => theme.syn_keyword,
                hashes == 5 => theme.mode_visual,
                else => theme.fg_muted,
            }
            let prefix_end = if sp + hashes < n { sp + hashes + 1 } else { n }
            push_run(runs, 0, line.slice(0, prefix_end), h_color, false, false)
            if prefix_end < n {
                tokenize_markdown_inline(line, cs, prefix_end, n, h_color, false, false, theme, runs)
            }
            return runs
        }
    }

    -- Blockquote `> ` / `>> ` (supporting `>\t`, GitHub Alerts `[!NOTE]`..`[!CAUTION]`, and quoted headings!)
    if sp <= 3 and sp < n and char_at_list(cs, sp) == '>' {
        var q = sp
        while q < n {
            let qc = char_at_list(cs, q)
            if qc == '>' or qc == ' ' or qc == '\t' {
                q += 1
            } else {
                break
            }
        }
        push_run(runs, 0, line.slice(0, q), theme.syn_comment, false, true)
        if q < n {
            let qrest = line.drop(q)
            if qrest.starts_with("[!") {
                let close_al = qrest.find("]")
                if close_al != null {
                    let al_end = q + close_al.as(i64) + 1
                    let tag_up = line.slice(q, al_end).to_upper()
                    let al_col = when {
                        tag_up == "[!NOTE]" => theme.accent,
                        tag_up == "[!TIP]" => theme.diag_ok,
                        tag_up == "[!IMPORTANT]" => theme.mode_visual,
                        tag_up == "[!WARNING]" => theme.diag_warn,
                        tag_up == "[!CAUTION]" => theme.diag_err,
                        else => theme.accent,
                    }
                    push_run(runs, q, line.slice(q, al_end), al_col, false, false)
                    if al_end < n {
                        tokenize_markdown_inline(line, cs, al_end, n, theme.fg, true, false, theme, runs)
                    }
                    return runs
                }
            }
            if char_at_list(cs, q) == '#' {
                var qh: i64 = 0
                while q + qh < n and char_at_list(cs, q + qh) == '#' {
                    qh += 1
                }
                if qh >= 1 and qh <= 6 and (q + qh == n or char_at_list(cs, q + qh) == ' ') {
                    push_run(runs, q, line.slice(q, n), theme.syn_fn, false, true)
                    return runs
                }
            }
            let tbl_in_q = is_probable_markdown_table_line(cs, n)
            tokenize_markdown_inline(line, cs, q, n, theme.syn_comment, true, tbl_in_q, theme, runs)
        }
        return runs
    }

    -- Unordered (`- `, `* `, `+ `) & Ordered (`1. `, `1) `) list items + task checkboxes
    var ws: i64 = 0
    while ws < n and (char_at_list(cs, ws) == ' ' or char_at_list(cs, ws) == '\t') {
        ws += 1
    }
    if ws < n {
        let mc = char_at_list(cs, ws)
        var marker_end: i64 = -1
        if mc == '-' or mc == '*' or mc == '+' {
            if ws + 1 == n {
                marker_end = ws + 1
            } else if char_at_list(cs, ws + 1) == ' ' or char_at_list(cs, ws + 1) == '\t' {
                marker_end = ws + 2
            }
        } else if is_ascii_digit_ch(mc) {
            var d = ws
            while d < n and is_ascii_digit_ch(char_at_list(cs, d)) {
                d += 1
            }
            if d < n and (char_at_list(cs, d) == '.' or char_at_list(cs, d) == ')') {
                if d + 1 == n {
                    marker_end = d + 1
                } else if char_at_list(cs, d + 1) == ' ' or char_at_list(cs, d + 1) == '\t' {
                    marker_end = d + 2
                }
            }
        }
        if marker_end > ws {
            if ws > 0 {
                push_run(runs, 0, line.slice(0, ws), theme.fg, false, false)
            }
            push_run(runs, ws, line.slice(ws, marker_end), theme.accent, false, false)
            var body_start = marker_end
            while body_start < n and char_at_list(cs, body_start) == ' ' and body_start - marker_end < 3 {
                push_run(runs, body_start, " ", theme.fg, false, false)
                body_start += 1
            }
            if body_start + 3 <= n
                and char_at_list(cs, body_start) == '['
                and char_at_list(cs, body_start + 2) == ']'
                and (body_start + 3 == n or char_at_list(cs, body_start + 3) == ' ' or char_at_list(cs, body_start + 3) == '\t') {
                let cb = char_at_list(cs, body_start + 1)
                if cb == 'x' or cb == 'X' {
                    push_run(runs, body_start, line.slice(body_start, body_start + 3), theme.syn_string, false, false)
                    body_start += 3
                } else if cb == ' ' or cb == '-' {
                    push_run(runs, body_start, line.slice(body_start, body_start + 3), theme.accent, false, false)
                    body_start += 3
                }
            }
            if body_start < n {
                tokenize_markdown_inline(line, cs, body_start, n, theme.fg, false, false, theme, runs)
            }
            return runs
        }
    }

    let is_tbl = is_probable_markdown_table_line(cs, n)
    tokenize_markdown_inline(line, cs, 0, n, theme.fg, false, is_tbl, theme, runs)
    runs
}

fn tokenize_toml_or_json(line: String, mode: String, theme: ThemePalette) -> List {
    let runs = List()
    if line == "" {
        return runs
    }
    let trimmed = line.trim_start()
    if mode == "toml" and trimmed.starts_with("#") {
        push_run(runs, 0, line, theme.syn_comment, false, true)
        return runs
    }
    if mode == "toml" and trimmed.starts_with("[") {
        push_run(runs, 0, line, theme.accent, true, false)
        return runs
    }

    let cs = line.chars()
    let n = cs.len()
    var seen_sep = false
    var i: i64 = 0
    while i < n {
        let ch = char_at_list(cs, i)
        if mode == "toml" and ch == '#' {
            push_run(runs, i, line.slice(i, n), theme.syn_comment, false, true)
            break
        }
        if ch == '"' or (mode == "toml" and ch == '\'') {
            let stop = scan_quoted_chars(cs, n, i, ch)
            let color = if not seen_sep { theme.syn_fn } else { theme.syn_string }
            push_run(runs, i, line.slice(i, stop), color, not seen_sep, false)
            i = stop
            continue
        }
        if (mode == "toml" and ch == '=') or (mode == "json" and ch == ':') {
            seen_sep = true
            push_run(runs, i, line.slice(i, i + 1), theme.syn_operator, false, false)
            i += 1
            continue
        }
        if is_ascii_digit_ch(ch) or (ch == '-' and i + 1 < n and is_ascii_digit_ch(char_at_list(cs, i + 1))) {
            let stop = scan_number_chars(cs, n, i + (if ch == '-' { 1 } else { 0 }))
            push_run(runs, i, line.slice(i, stop), theme.syn_number, false, false)
            i = stop
            continue
        }
        if is_ident_start_ch(ch) {
            var j = i + 1
            while j < n {
                let jc = char_at_list(cs, j)
                if is_ident_continue_ch(jc) or jc == '-' {
                    j += 1
                } else {
                    break
                }
            }
            let word = line.slice(i, j)
            if (not seen_sep) and mode == "toml" {
                push_run(runs, i, word, theme.syn_fn, true, false)
            } else if word == "true" or word == "false" or word == "null" {
                push_run(runs, i, word, theme.syn_keyword, true, false)
            } else {
                push_run(runs, i, word, theme.fg, false, false)
            }
            i = j
            continue
        }
        push_run(runs, i, line.slice(i, i + 1), theme.fg, false, false)
        i += 1
    }
    runs
}

fn tokenize_dired_line(line: String, theme: ThemePalette) -> List {
    let runs = List()
    if line == "" {
        return runs
    }
    let trimmed = line.trim()
    -- Dired header / directory title line
    if trimmed.ends_with(":") or trimmed.starts_with("Dired ") or trimmed.starts_with("total ") {
        push_run(runs, 0, line, theme.fg_muted, true, false)
        return runs
    }

    let cs = line.chars()
    let n = cs.len()
    let c0 = char_at_list(cs, 0)
    let c1 = if n >= 2 { char_at_list(cs, 1) } else { '\0' }
    if c0 == 'D' and (c1 == ' ' or c1 == '\t' or c1 == 'd' or c1 == '-') {
        push_run(runs, 0, line, theme.diag_err, true, false)
        return runs
    }
    if c0 == '*' and (c1 == ' ' or c1 == '\t' or c1 == 'd' or c1 == '-') {
        push_run(runs, 0, line, theme.diag_warn, true, false)
        return runs
    }

    let is_dir = trimmed.starts_with("d") and trimmed.char_len() > 9 and (trimmed.slice(1, 2) == "r" or trimmed.slice(1, 2) == "-")
        or trimmed.contains("<DIR>") or trimmed.contains("[DIR]") or trimmed.ends_with("/")
    if is_dir {
        push_run(runs, 0, line, theme.accent, true, false)
        return runs
    }
    push_run(runs, 0, line, theme.fg, false, false)
    runs
}

fn parse_digits_end_chars(cs: List, n: i64, start: i64) -> i64 {
    var j = start
    while j < n and is_ascii_digit_ch(char_at_list(cs, j)) {
        j += 1
    }
    j
}

fn tokenize_grep_line(line: String, theme: ThemePalette) -> List {
    let runs = List()
    if line == "" {
        return runs
    }
    let cs = line.chars()
    let n = cs.len()
    -- Match `file:line:col:text` or `file:line:text`
    var c1: i64 = -1
    for idx in 0..n {
        if char_at_list(cs, idx) == ':' {
            c1 = idx
            break
        }
    }
    if c1 > 0 and c1 + 1 < n {
        let num1_end = parse_digits_end_chars(cs, n, c1 + 1)
        if num1_end > c1 + 1 and num1_end < n and char_at_list(cs, num1_end) == ':' {
            push_run(runs, 0, line.slice(0, c1), theme.accent, true, false)
            push_run(runs, c1, ":", theme.syn_operator, false, false)
            push_run(runs, c1 + 1, line.slice(c1 + 1, num1_end), theme.syn_number, true, false)
            push_run(runs, num1_end, ":", theme.syn_operator, false, false)

            var msg_start = num1_end + 1
            if msg_start < n {
                let num2_end = parse_digits_end_chars(cs, n, msg_start)
                if num2_end > msg_start and num2_end < n and char_at_list(cs, num2_end) == ':' {
                    push_run(runs, msg_start, line.slice(msg_start, num2_end), theme.syn_number, true, false)
                    push_run(runs, num2_end, ":", theme.syn_operator, false, false)
                    msg_start = num2_end + 1
                }
            }
            if msg_start < n {
                let rest = line.slice(msg_start, n)
                let lower = rest.to_lower()
                if lower.contains("error") {
                    push_run(runs, msg_start, rest, theme.diag_err, true, false)
                } else if lower.contains("warning") {
                    push_run(runs, msg_start, rest, theme.diag_warn, false, false)
                } else {
                    push_run(runs, msg_start, rest, theme.fg, false, false)
                }
            }
            return runs
        }
    }
    push_run(runs, 0, line, theme.fg, false, false)
    runs
}

fn tokenize_diff_line(line: String, theme: ThemePalette) -> List {
    let runs = List()
    if line == "" {
        return runs
    }
    when {
        line.starts_with("+++") or line.starts_with("---") => {
            push_run(runs, 0, line, theme.accent, true, false)
        },
        line.starts_with("@@") => {
            push_run(runs, 0, line, theme.syn_type, true, false)
        },
        line.starts_with("+") => {
            push_run(runs, 0, line, theme.diag_ok, false, false)
        },
        line.starts_with("-") => {
            push_run(runs, 0, line, theme.diag_err, false, false)
        },
        line.starts_with("diff ") or line.starts_with("index ") => {
            push_run(runs, 0, line, theme.fg_muted, true, false)
        },
        else => {
            push_run(runs, 0, line, theme.fg, false, false)
        },
    }
    runs
}

-- Produce contiguous `(start_col: i64, text: String, color: i64, bold: bool, italic: bool)` runs.
pub fn tokenize_line(line: String, major_mode: String, theme: ThemePalette) -> List {
    if line == "" {
        return List()
    }
    let m = major_mode.to_lower()
    when {
        m == "nessa" or m == "ns" or m == "lua" => tokenize_code_line(line, "nessa", theme),
        m == "rust" or m == "rs" or m == "go" or m == "golang" or m == "zig" => tokenize_code_line(line, "rust", theme),
        m == "python" or m == "py" or m == "shell" or m == "sh" or m == "bash" or m == "zsh" or m == "fish" or m == "makefile" or m == "make" => {
            let norm_p = if m == "python" or m == "py" { "python" } else { "shell" }
            tokenize_code_line(line, norm_p, theme)
        },
        m == "c" or m == "cpp" or m == "c++" or m == "cc" or m == "h" or m == "hpp" or m == "java" => {
            tokenize_code_line(line, "c", theme)
        },
        m == "javascript" or m == "js" or m == "jsx" or m == "typescript" or m == "ts" or m == "tsx" => {
            tokenize_code_line(line, "js", theme)
        },
        m == "css" or m == "scss" or m == "less" => tokenize_code_line(line, "css", theme),
        m == "sql" => tokenize_code_line(line, "sql", theme),
        m == "html" or m == "htm" or m == "xml" or m == "svg" => tokenize_code_line(line, "js", theme),
        m == "org" => tokenize_org_line(line, theme),
        m == "markdown" or m == "md" or m == "gfm" or m == "info" or m == "help" => tokenize_markdown_line(line, theme),
        m == "toml" or m == "json" or m == "jsonc" or m == "yaml" or m == "yml" or m == "ini" => {
            let norm_t = if m == "json" or m == "jsonc" { "json" } else { "toml" }
            tokenize_toml_or_json(line, norm_t, theme)
        },
        m == "dired" => tokenize_dired_line(line, theme),
        m == "grep" or m == "compilation" or m == "quickfix" => tokenize_grep_line(line, theme),
        m == "diff" or m == "patch" => tokenize_diff_line(line, theme),
        else => {
            let runs = List()
            push_run(runs, 0, line, theme.fg, false, false)
            runs
        },
    }
}

fn ts_hl_group_style(hl_group: i64, theme: ThemePalette) -> (i64, bool) {
    when {
        hl_group == 1 => (theme.syn_keyword, false),
        hl_group == 2 => (theme.mode_visual, false),
        hl_group == 3 => (theme.syn_fn, false),
        hl_group == 4 => (theme.accent, false),
        hl_group == 5 => (theme.syn_type, false),
        hl_group == 6 => (theme.syn_type, true),
        hl_group == 7 => (theme.syn_string, false),
        hl_group == 8 => (theme.diag_warn, false),
        hl_group == 9 => (theme.syn_number, false),
        hl_group == 10 => (theme.syn_number, false),
        hl_group == 11 => (theme.accent, false),
        hl_group == 12 => (theme.fg, true),
        hl_group == 13 => (theme.syn_type, false),
        hl_group == 14 => (theme.syn_operator, false),
        hl_group == 15 => (theme.syn_comment, true),
        hl_group == 16 => (theme.diag_ok, true),
        hl_group == 17 => (theme.syn_fn, false),
        hl_group == 18 => (theme.syn_string, false),
        else => (theme.fg, false),
    }
}

fn ts_spans_to_runs(raw_line: String, spans: List, theme: ThemePalette) -> List {
    let runs = List()
    let n = raw_line.char_len()
    if n == 0 {
        return runs
    }
    if spans.is_empty() {
        push_run(runs, 0, raw_line, theme.fg, false, false)
        return runs
    }
    var pos: i64 = 0
    for i in 0..spans.len() {
        let raw_sp = spans.get(i.as(usize))
        let (sp_start, sp_end, sp_grp) = if raw_sp matches _: i64 {
            let pk = raw_sp.as(i64)
            let rem = pk % 4294967296
            (pk / 4294967296, rem / 256, rem % 256)
        } else {
            let sp = raw_sp.as(TsSpan)
            (sp.start_col, sp.end_col, sp.hl_group)
        }
        let s0 = if sp_start < pos { pos } else if sp_start > n { n } else { sp_start }
        let e0 = if sp_end > n { n } else { sp_end }
        if s0 > pos {
            push_run(runs, pos, raw_line.slice(pos, s0), theme.fg, false, false)
        }
        if e0 > s0 {
            let (col, is_it) = ts_hl_group_style(sp_grp, theme)
            push_run(runs, s0, raw_line.slice(s0, e0), col, false, is_it)
            pos = e0
        }
    }
    if pos < n {
        push_run(runs, pos, raw_line.slice(pos, n), theme.fg, false, false)
    }
    runs
}

fn split_runs_at_char_col(runs: List, split_col: i64) -> (List, List) {
    let left = List()
    let right = List()
    for i in 0..runs.len() {
        let (sc, txt, col, bld, it) = runs.get(i.as(usize)).as((i64, String, i64, bool, bool))
        let tlen = txt.char_len()
        let ec = sc + tlen
        if ec <= split_col {
            left.push((sc, txt, col, bld, it))
        } else if sc >= split_col {
            right.push((sc - split_col, txt, col, bld, it))
        } else {
            let mid = split_col - sc
            let lpart = txt.slice(0, mid)
            let rpart = txt.slice(mid, tlen)
            if lpart != "" {
                left.push((sc, lpart, col, bld, it))
            }
            if rpart != "" {
                right.push((0, rpart, col, bld, it))
            }
        }
    }
    (left, right)
}

fn ts_lang_for_buffer(buf: Buffer) -> String {
    let m = buf.major_mode.to_lower()
    if m != "" and m != "text" and m != "fundamental" and m != "plaintext" {
        return m
    }
    let name_lc = buf.name.to_lower()
    let dot_hits = name_lc.find_indices(".")
    if not dot_hits.is_empty() {
        let last_dot = dot_hits.get((dot_hits.len() - 1).as(usize)).as(i64)
        return canonical_fence_mode(name_lc.drop(last_dot + 1))
    }
    ""
}

fn is_treesitter_eligible_mode(mode_lc: String) -> bool {
    mode_lc != ""
        and mode_lc != "text"
        and mode_lc != "plaintext"
        and mode_lc != "fundamental"
        and mode_lc != "markdown"
        and mode_lc != "md"
        and mode_lc != "gfm"
        and mode_lc != "org"
        and mode_lc != "info"
        and mode_lc != "help"
        and mode_lc != "apropos"
        and mode_lc != "dired"
        and mode_lc != "dirvish"
        and mode_lc != "dirvish-parent"
        and mode_lc != "dirvish-preview"
        and mode_lc != "grep"
        and mode_lc != "compilation"
        and mode_lc != "quickfix"
        and mode_lc != "terminal"
        and mode_lc != "toggleterm"
}

private global _md_block_ts_cache: ?HashMap = null

private fn get_md_fenced_block_ts_spans(
    buf: Buffer,
    md_states: List,
    open_row: i64,
    fence_mode: String,
) -> List {
    if fence_mode == "" or open_row < 0 {
        return List()
    }
    let cache = if _md_block_ts_cache != null {
        _md_block_ts_cache.as(HashMap)
    } else {
        let m = HashMap.new()
        _md_block_ts_cache = m
        m
    }
    let key = buf.doc_id.to_string() ++ ":" ++ buf.edit_version.to_string() ++ ":" ++ open_row.to_string()
    let hit = cache.get(key)
    if hit != null {
        return hit.as(List)
    }
    if cache.len() > 64 {
        cache.clear()
    }
    let total = buf.line_count()
    let body_lines = List()
    var r = open_row + 1
    while r < total and body_lines.len() < 256 {
        if r < md_states.len() {
            let (sk, _, _) = md_states.get(r.as(usize)).as((i64, String, i64))
            if sk != 2 {
                break
            }
        } else {
            let ln_chk = buf.line_at(r)
            if parse_markdown_fence_open(ln_chk) != null {
                break
            }
        }
        body_lines.push(buf.line_at(r))
        r += 1
    }
    if body_lines.is_empty() or env.os() == "windows" {
        return List()
    }
    let res = accel_ts_highlight_snippet(body_lines.join("\n"), fence_mode)
    cache.insert(key, res)
    res
}

fn nerd_icon_for_buffer(buf: Buffer) -> String {
    let m = buf.major_mode.to_lower()
    let name_lc = buf.name.to_lower()
    when {
        m == "dirvish" or m == "dired" => " ",
        m == "rust" or name_lc.ends_with(".rs") => " ",
        m == "python" or name_lc.ends_with(".py") => " ",
        m == "c" or name_lc.ends_with(".c") or name_lc.ends_with(".h") => " ",
        m == "cpp" or name_lc.ends_with(".cpp") or name_lc.ends_with(".hpp") => " ",
        m == "javascript" or name_lc.ends_with(".js") => " ",
        m == "typescript" or name_lc.ends_with(".ts") or name_lc.ends_with(".tsx") => " ",
        m == "go" or name_lc.ends_with(".go") => " ",
        m == "lua" or name_lc.ends_with(".lua") => " ",
        m == "nessa" or name_lc.ends_with(".ns") => " ",
        m == "markdown" or m == "md" or m == "gfm" or name_lc.ends_with(".md") => " ",
        m == "json" or name_lc.ends_with(".json") => " ",
        m == "toml" or m == "yaml" or name_lc.ends_with(".toml") or name_lc.ends_with(".yaml") or name_lc.ends_with(".yml") => " ",
        m == "html" or name_lc.ends_with(".html") => " ",
        m == "css" or name_lc.ends_with(".css") => " ",
        m == "terminal" or m == "toggleterm" or m == "shell" or name_lc.ends_with(".sh") => " ",
        m == "help" or m == "info" or m == "org" => " ",
        name_lc.contains("git") or m == "magit" or m == "diff" => " ",
        else => " ",
    }
}

-- ============================================================================
-- 3. Scene Compositor Helpers (Display Width, Tab Expansion, Indent Guides)
-- ============================================================================

pub fn char_display_width(ch: String) -> i64 {
    win_char_display_width(ch)
}

pub fn str_display_width(s: String) -> i64 {
    win_str_display_width(s)
}

pub fn expand_tabs_from_col(text: String, start_vcol: i64, tabstop: i64) -> (String, i64) {
    win_expand_tabs_from_col(text, start_vcol, tabstop)
}

pub fn char_col_to_visual_col(line: String, char_col: i64, tabstop: i64) -> i64 {
    win_char_col_to_visual_col(line, char_col, tabstop)
}

pub fn visual_col_to_char_col(line: String, target_vcol: i64, tabstop: i64) -> i64 {
    win_visual_col_to_char_col(line, target_vcol, tabstop)
}

-- Drop `skip_vcols` visual display columns from an already tab-expanded string,
-- returning `(visible_tail, extra_vcol_offset_from_left_col)`.
fn drop_visual_cols(expanded: String, skip_vcols: i64) -> (String, i64) {
    if skip_vcols <= 0 {
        return (expanded, 0)
    }
    if expanded.is_ascii() {
        return (expanded.drop(skip_vcols), 0)
    }
    let n = expanded.char_len()
    var skipped: i64 = 0
    var idx: i64 = 0
    while idx < n {
        let ch = expanded.slice(idx, idx + 1)
        let cw = char_display_width(ch)
        if skipped >= skip_vcols and cw > 0 {
            return (expanded.drop(idx), skipped - skip_vcols)
        }
        skipped += cw
        idx += 1
    }
    ("", 0)
}

fn abs_i64(n: i64) -> i64 = if n < 0 { -n } else { n }

fn pad_left(text: String, width: i64) -> String {
    let len = if text.is_ascii() { text.len() } else { str_display_width(text) }
    if len >= width {
        return text
    }
    " ".repeat(width - len) ++ text
}

fn clip_str(text: String, max_cols: i64) -> String {
    if max_cols <= 0 {
        return ""
    }
    let w = str_display_width(text)
    if w <= max_cols {
        return text
    }
    if max_cols == 1 {
        let first_ch = text.take(1)
        return if str_display_width(first_ch) <= 1 { first_ch } else { "…" }
    }
    if text.is_ascii() {
        return text.take(max_cols - 1) ++ "…"
    }
    let budget = max_cols - 1
    let n = text.char_len()
    var used: i64 = 0
    var keep: i64 = 0
    while keep < n {
        let cw = char_display_width(text.slice(keep, keep + 1))
        if used + cw > budget {
            break
        }
        used += cw
        keep += 1
    }
    text.take(keep) ++ "…"
}

fn should_render_indent_guides(major_mode: String) -> bool {
    let m = major_mode.to_lower()
    return not (
        m == "terminal"
        or m == "toggleterm"
        or m == "dirvish"
        or m == "dirvish-preview"
        or m == "dired"
        or m == "markdown"
        or m == "md"
        or m == "gfm"
        or m == "org"
        or m == "help"
        or m == "info"
        or m == "apropos"
        or m == "lazy"
        or m == "mason"
        or m == "lsp-info"
        or m == "alpha"
    )
}

-- Returns `(is_blank, visual_indent_vcol, starts_closing_delim, ends_opening_delim)`.
fn inspect_line_indent(line: String, tabstop: i64) -> (bool, i64, bool, bool) {
    let ts = if tabstop > 0 { tabstop } else { 4 }
    let blen = line.len()
    var bpos: i64 = 0
    var vcol: i64 = 0
    while bpos < blen {
        let b = line.byte_at(bpos)
        if b == 32 {
            vcol += 1
            bpos += 1
        } else if b == 9 {
            vcol += ts - (vcol % ts)
            bpos += 1
        } else {
            let first_b = b
            let starts_close = first_b == 125 or first_b == 41 or first_b == 93
            let trimmed_end = line.trim_end()
            let tlen = trimmed_end.len()
            let last_b = if tlen > 0 { trimmed_end.byte_at(tlen - 1) } else { 0 }
            let ends_open = last_b == 123 or last_b == 40 or last_b == 91 or last_b == 58
            return (false, vcol, starts_close, ends_open)
        }
    }
    (true, 0, false, false)
}

fn resolve_active_indent_scope(
    lo_anchor: i64,
    count: i64,
    indent_step: i64,
    blank_arr: List,
    close_arr: List,
    eff_arr: List,
    cursor_row: i64,
    is_focused: bool,
) -> (i64, i64, i64) {
    let hi_anchor = lo_anchor + count - 1
    if (not is_focused) or count <= 0 or cursor_row < lo_anchor or cursor_row > hi_anchor {
        return (-1, -1, -1)
    }
    let cur_idx = cursor_row - lo_anchor
    let cur_eff = eff_arr.get(cur_idx.as(usize)).as(i64)
    let cur_close = close_arr.get(cur_idx.as(usize)).as(bool)
    let next_eff = if cur_idx + 1 < count { eff_arr.get((cur_idx + 1).as(usize)).as(i64) } else { 0 }
    let prev_eff = if cur_idx > 0 { eff_arr.get((cur_idx - 1).as(usize)).as(i64) } else { 0 }

    var active_vcol: i64 = -1
    var seed_idx: i64 = cur_idx
    if (not blank_arr.get(cur_idx.as(usize)).as(bool)) and next_eff > cur_eff {
        active_vcol = (cur_eff / indent_step) * indent_step
        seed_idx = cur_idx + 1
    } else if cur_close and prev_eff > cur_eff {
        active_vcol = (cur_eff / indent_step) * indent_step
        seed_idx = cur_idx - 1
    } else if cur_eff > 0 {
        active_vcol = ((cur_eff - 1) / indent_step) * indent_step
        seed_idx = cur_idx
    }

    if active_vcol < 0 {
        return (-1, -1, -1)
    }

    var s_idx = seed_idx
    while s_idx > 0 and eff_arr.get((s_idx - 1).as(usize)).as(i64) > active_vcol {
        s_idx -= 1
    }
    var e_idx = seed_idx
    while e_idx + 1 < count and eff_arr.get((e_idx + 1).as(usize)).as(i64) > active_vcol {
        e_idx += 1
    }
    (active_vcol, lo_anchor + s_idx, lo_anchor + e_idx)
}

-- Precompute `(lo_anchor, blank_arr, raw_arr, close_arr, open_arr, eff_arr)` for `vis_rows`.
fn compute_pane_indent_arrays(
    buf: Buffer,
    vis_rows: List,
    cursor_row: i64,
    tabstop: i64,
    shiftwidth: i64,
) -> (i64, List, List, List, List, List) {
    if vis_rows.is_empty() {
        return (0, List(), List(), List(), List(), List())
    }
    let indent_step = if shiftwidth > 0 { shiftwidth } else { if tabstop > 0 { tabstop } else { 4 } }
    let buf_lo = buf.min_row()
    let buf_hi = buf.max_row()
    let first_vis = vis_rows.get(0).as(i64)
    let last_vis = vis_rows.get((vis_rows.len() - 1).as(usize)).as(i64)

    var lo_anchor = if cursor_row < first_vis { cursor_row } else { first_vis }
    var hi_anchor = if cursor_row > last_vis { cursor_row } else { last_vis }
    if lo_anchor - 64 > buf_lo {
        lo_anchor = lo_anchor - 64
    } else {
        lo_anchor = buf_lo
    }
    if hi_anchor + 64 < buf_hi {
        hi_anchor = hi_anchor + 64
    } else {
        hi_anchor = buf_hi
    }
    while lo_anchor > buf_lo {
        let (blank_above, _, _, _) = inspect_line_indent(buf.line_at(lo_anchor), tabstop)
        if not blank_above {
            break
        }
        lo_anchor -= 1
    }
    while hi_anchor < buf_hi {
        let (blank_below, _, _, _) = inspect_line_indent(buf.line_at(hi_anchor), tabstop)
        if not blank_below {
            break
        }
        hi_anchor += 1
    }

    let count = hi_anchor - lo_anchor + 1
    let anchor_lines = buf.slice_lines(lo_anchor, hi_anchor + 1)
    let blank_arr = List()
    let raw_arr = List()
    let close_arr = List()
    let open_arr = List()
    let prev_nb_arr = List()
    var prev_for_blank: i64 = -1

    for idx in 0..count {
        let ln = if idx < anchor_lines.len() {
            anchor_lines.get(idx.as(usize)).as(String)
        } else {
            buf.line_at(lo_anchor + idx)
        }
        let (is_blank, raw_vcol, starts_close, ends_open) = inspect_line_indent(ln, tabstop)
        blank_arr.push(is_blank)
        raw_arr.push(raw_vcol)
        close_arr.push(starts_close)
        open_arr.push(ends_open)
        prev_nb_arr.push(prev_for_blank)
        if not is_blank {
            prev_for_blank = if ends_open { raw_vcol + indent_step } else { raw_vcol }
        }
    }

    let eff_arr = List()
    eff_arr.resize(count.as(usize), 0)
    var next_for_blank: i64 = -1
    var rev_i = count - 1
    while rev_i >= 0 {
        let u = rev_i.as(usize)
        let is_blank = blank_arr.get(u).as(bool)
        let raw_vcol = raw_arr.get(u).as(i64)
        let starts_close = close_arr.get(u).as(bool)
        if not is_blank {
            eff_arr.set(u, raw_vcol)
            next_for_blank = if starts_close { raw_vcol + indent_step } else { raw_vcol }
        } else {
            let p_nb = prev_nb_arr.get(u).as(i64)
            if p_nb > 0 and next_for_blank > 0 {
                let bridged = if p_nb < next_for_blank { p_nb } else { next_for_blank }
                eff_arr.set(u, bridged)
            } else {
                eff_arr.set(u, 0)
            }
        }
        rev_i -= 1
    }

    (lo_anchor, blank_arr, raw_arr, close_arr, open_arr, eff_arr)
}

private struct IndentGuideCacheEntry {
    pane_id: i64,
    buf_id: i64,
    doc_id: i64,
    edit_version: i64,
    top_row: i64,
    max_rows: i64,
    vis_len: i64,
    cursor_row: i64,
    is_focused: bool,
    tabstop: i64,
    shiftwidth: i64,
    fold_count: i64,
    min_row: i64,
    max_row: i64,
    lo_anchor: i64,
    blank_arr: List,
    raw_arr: List,
    close_arr: List,
    open_arr: List,
    eff_arr: List,
    active_vcol: i64,
    scope_start: i64,
    scope_end: i64,
}

private global _indent_guide_cache: ?HashMap = null

fn get_cached_pane_indent_guides(
    pane_id: i64,
    buf: Buffer,
    vis_rows: List,
    top_row: i64,
    max_rows: i64,
    cursor_row: i64,
    is_focused: bool,
    tabstop: i64,
    shiftwidth: i64,
) -> (i64, List, i64, i64, i64) {
    let cache = if _indent_guide_cache != null {
        _indent_guide_cache.as(HashMap)
    } else {
        let m = HashMap.new()
        _indent_guide_cache = m
        m
    }
    let indent_step = if shiftwidth > 0 { shiftwidth } else { if tabstop > 0 { tabstop } else { 4 } }
    let buf_id_raw = buf.id.raw()
    let vis_len = vis_rows.len()
    let fold_cnt = buf.folded_rows.len()
    let min_r = buf.min_row()
    let max_r = buf.max_row()
    let hit_opt = cache.get(pane_id)
    if hit_opt != null {
        let e = hit_opt.as(IndentGuideCacheEntry)
        if e.buf_id == buf_id_raw
            and e.doc_id == buf.doc_id
            and e.top_row == top_row
            and e.max_rows == max_rows
            and e.vis_len == vis_len
            and e.tabstop == tabstop
            and e.shiftwidth == shiftwidth
            and e.fold_count == fold_cnt
            and e.min_row == min_r
            and e.max_row == max_r {
            let count = e.eff_arr.len()
            let in_bounds = count > 0 and cursor_row >= e.lo_anchor and cursor_row < e.lo_anchor + count
            if e.edit_version == buf.edit_version {
                if e.cursor_row == cursor_row and e.is_focused == is_focused {
                    return (e.lo_anchor, e.eff_arr, e.active_vcol, e.scope_start, e.scope_end)
                }
                if in_bounds {
                    let (av, ss, se) = resolve_active_indent_scope(
                        e.lo_anchor, count, indent_step, e.blank_arr, e.close_arr, e.eff_arr, cursor_row, is_focused,
                    )
                    e.cursor_row = cursor_row
                    e.is_focused = is_focused
                    e.active_vcol = av
                    e.scope_start = ss
                    e.scope_end = se
                    return (e.lo_anchor, e.eff_arr, av, ss, se)
                }
            } else if in_bounds and e.cursor_row == cursor_row {
                let c_u = (cursor_row - e.lo_anchor).as(usize)
                let (ib, rv, sc, eo) = inspect_line_indent(buf.line_at(cursor_row), tabstop)
                if ib == e.blank_arr.get(c_u).as(bool)
                    and rv == e.raw_arr.get(c_u).as(i64)
                    and sc == e.close_arr.get(c_u).as(bool)
                    and eo == e.open_arr.get(c_u).as(bool) {
                    e.edit_version = buf.edit_version
                    if e.is_focused != is_focused {
                        let (av, ss, se) = resolve_active_indent_scope(
                            e.lo_anchor, count, indent_step, e.blank_arr, e.close_arr, e.eff_arr, cursor_row, is_focused,
                        )
                        e.is_focused = is_focused
                        e.active_vcol = av
                        e.scope_start = ss
                        e.scope_end = se
                    }
                    return (e.lo_anchor, e.eff_arr, e.active_vcol, e.scope_start, e.scope_end)
                }
            }
        }
    }
    if cache.len() > 16 {
        cache.clear()
    }
    let (lo_anchor, blank_arr, raw_arr, close_arr, open_arr, eff_arr) =
        compute_pane_indent_arrays(buf, vis_rows, cursor_row, tabstop, shiftwidth)
    let (active_vcol, scope_start, scope_end) = resolve_active_indent_scope(
        lo_anchor, eff_arr.len(), indent_step, blank_arr, close_arr, eff_arr, cursor_row, is_focused,
    )
    cache.insert(
        pane_id,
        IndentGuideCacheEntry {
            pane_id: pane_id,
            buf_id: buf_id_raw,
            doc_id: buf.doc_id,
            edit_version: buf.edit_version,
            top_row: top_row,
            max_rows: max_rows,
            vis_len: vis_len,
            cursor_row: cursor_row,
            is_focused: is_focused,
            tabstop: tabstop,
            shiftwidth: shiftwidth,
            fold_count: fold_cnt,
            min_row: min_r,
            max_row: max_r,
            lo_anchor: lo_anchor,
            blank_arr: blank_arr,
            raw_arr: raw_arr,
            close_arr: close_arr,
            open_arr: open_arr,
            eff_arr: eff_arr,
            active_vcol: active_vcol,
            scope_start: scope_start,
            scope_end: scope_end,
        },
    )
    (lo_anchor, eff_arr, active_vcol, scope_start, scope_end)
}

fn mode_pill_color(mode_name: String, theme: ThemePalette) -> i64 {
    let upper = mode_name.to_upper()
    when {
        upper.starts_with("INSERT") => theme.mode_insert,
        upper.starts_with("VISUAL") or upper.starts_with("V-") => theme.mode_visual,
        upper.starts_with("REPLACE") => theme.mode_replace,
        upper.starts_with("COMMAND") or upper.starts_with("EX") or upper.starts_with("MINIBUF") => theme.mode_command,
        upper.starts_with("EMACS") => theme.accent,
        else => theme.mode_normal,
    }
}

fn extract_which_key_pair(item: Any) -> (String, String) {
    if item matches _: KeyBindingEntry {
        let kb = item.as(KeyBindingEntry)
        let desc = if kb.description != "" { kb.command_name } else { kb.command_name }
        return (kb.chord, desc)
    }
    if item matches _: (String, String) {
        return item.as((String, String))
    }
    if item matches _: List {
        let arr = item.as(List)
        if arr.len() >= 2 {
            return (arr.get(0).to_string(), arr.get(1).to_string())
        }
        if arr.len() == 1 {
            return (arr.get(0).to_string(), "")
        }
    }
    let raw = item.to_string()
    let sp_opt = raw.split_once("->")
    if sp_opt != null {
        let (l, r) = sp_opt.as((String, String))
        return (l.trim(), r.trim())
    }
    (raw, "")
}

fn extract_minibuffer_candidate(item: Any) -> (String, String) {
    if item matches _: (String, String) {
        return item.as((String, String))
    }
    if item matches _: CommandSpec {
        let cs = item.as(CommandSpec)
        return (cs.name, cs.summary)
    }
    if item matches _: KeyBindingEntry {
        let kb = item.as(KeyBindingEntry)
        return (kb.chord, kb.command_name)
    }
    if item matches _: List {
        let arr = item.as(List)
        if arr.len() >= 2 {
            return (arr.get(0).to_string(), arr.get(1).to_string())
        }
        if arr.len() == 1 {
            return (arr.get(0).to_string(), "")
        }
        return ("", "")
    }
    if item matches _: String {
        let s = item.as(String)
        let tab_sp = s.split_once("\t")
        if tab_sp != null {
            return tab_sp.as((String, String))
        }
        let dash_sp = s.split_once("  -- ")
        if dash_sp != null {
            return dash_sp.as((String, String))
        }
        return (s, "")
    }
    (item.to_string(), "")
}

-- ============================================================================
-- 4. Full 2D `DrawCmd` Scene Compositor (`compose_frame`)
-- ============================================================================

fn top_bar_height(world: EditorWorld) -> f64 {
    if world.options.show_tab_bar { TAB_BAR_HEIGHT } else { 0.0 }
}

fn render_top_tab_bar(
    cmds: List,
    world: EditorWorld,
    wm: WindowManager,
    theme: ThemePalette,
    win_w: f64,
) {
    let cell_w = wm.metrics.cell_width
    let font_fam = world.options.font_family
    let font_sz = world.options.font_size_pt

    cmds.push(DrawCmd.clip_push(0.0, 0.0, win_w, TAB_BAR_HEIGHT))
    cmds.push(DrawCmd.fill_rect(0.0, 0.0, win_w, TAB_BAR_HEIGHT, theme.bg_tab_bar, 0.0))

    var cur_x: f64 = 6.0
    let text_y: f64 = 3.0

    if wm.tabs.len() > 1 {
        let tcount = wm.tabs.len()
        for i in 0..tcount {
            let tab = wm.tabs.get(i.as(usize)).as(TabWorkspace)
            let is_active = i == wm.active_tab_idx
            let pane_opt = wm.panes.get(tab.active_win_id)
            var bname = tab.title
            if pane_opt != null {
                let p = pane_opt.as(WindowPane)
                let b_opt = world.buffer(p.buffer_id)
                if b_opt != null {
                    let b = b_opt.as(Buffer)
                    bname = (i + 1).to_string() ++ ": " ++ nerd_icon_for_buffer(b) ++ b.name ++ (if b.modified { " +" } else { "" })
                }
            }
            let tab_w = (str_display_width(bname) + 3).as(f64) * cell_w
            let pill_bg = if is_active { theme.bg } else { theme.bg_alt }
            cmds.push(DrawCmd.fill_rect(cur_x, 2.0, tab_w, TAB_BAR_HEIGHT - 3.0, pill_bg, 4.0))
            if is_active {
                cmds.push(DrawCmd.fill_rect(cur_x, 2.0, tab_w, 2.0, theme.accent, 0.0))
            }
            cmds.push(DrawCmd.text_run(
                cur_x + cell_w * 1.2,
                text_y,
                bname,
                font_fam,
                font_sz,
                if is_active { theme.fg } else { theme.fg_muted },
                false,
                false,
                false,
            ))
            cur_x += tab_w + 4.0
        }
    } else {
        -- Compact buffer tab strip when in single-tab workspace
        let bcount = world.buffer_order.len()
        for i in 0..bcount {
            if cur_x > win_w * 0.72 {
                break
            }
            let bid = world.buffer_order.get(i.as(usize)).as(BufferId)
            let b_opt = world.buffer(bid)
            if b_opt == null {
                continue
            }
            let b = b_opt.as(Buffer)
            let is_active = bid == world.active_buffer_id
            let label = nerd_icon_for_buffer(b) ++ b.name ++ (if b.modified { " [+]" } else { "" })
            let tab_w = (str_display_width(label) + 3).as(f64) * cell_w
            cmds.push(DrawCmd.fill_rect(
                cur_x,
                2.0,
                tab_w,
                TAB_BAR_HEIGHT - 3.0,
                if is_active { theme.bg } else { theme.bg_alt },
                4.0,
            ))
            if is_active {
                cmds.push(DrawCmd.fill_rect(cur_x, 2.0, tab_w, 2.0, theme.accent, 0.0))
            }
            cmds.push(DrawCmd.text_run(
                cur_x + cell_w * 1.2,
                text_y,
                label,
                font_fam,
                font_sz,
                if is_active { theme.fg } else { theme.fg_muted },
                false,
                false,
                false,
            ))
            cur_x += tab_w + 4.0
        }
    }

    -- Right-aligned running background jobs badge + active theme label
    var right_x = win_w - 8.0
    let theme_tag = "[" ++ theme.name ++ "]"
    let theme_w = str_display_width(theme_tag).as(f64) * cell_w
    right_x -= theme_w
    cmds.push(DrawCmd.text_run(right_x, text_y, theme_tag, font_fam, font_sz, theme.fg_muted, false, false, false))

    if not world.active_jobs.is_empty() {
        let jcount = world.active_jobs.len()
        let first_job = world.active_jobs.get(0).as(ActiveBgJob)
        let job_badge = " Jobs:" ++ jcount.to_string() ++ " " ++ clip_str(first_job.title, 18) ++ " "
        let jw = str_display_width(job_badge).as(f64) * cell_w
        right_x -= jw + 8.0
        cmds.push(DrawCmd.fill_rect(right_x, 3.0, jw, TAB_BAR_HEIGHT - 6.0, theme.bg_popup, 4.0))
        cmds.push(DrawCmd.text_run(right_x, text_y, job_badge, font_fam, font_sz, theme.diag_warn, false, false, false))
    }

    -- Optional symbol breadcrumb (`world.winbar_text`) in center-right of header bar
    if world.winbar_text != "" and right_x - cur_x > 160.0 {
        let max_bc = (((right_x - cur_x - 24.0) / cell_w).floor().as(i64))
        if max_bc > 12 {
            let bc = clip_str(world.winbar_text, max_bc)
            cmds.push(DrawCmd.text_run(cur_x + 12.0, text_y, bc, font_fam, font_sz, theme.fg_muted, false, true, false))
        }
    }

    cmds.push(DrawCmd.line(0.0, TAB_BAR_HEIGHT - 1.0, win_w, TAB_BAR_HEIGHT - 1.0, theme.border, 1.0))
    cmds.push(DrawCmd.clip_pop)
}

fn emit_visual_span_rect(
    cmds: List,
    line: String,
    char_start: i64,
    char_end: i64,
    tabstop: i64,
    left_col: i64,
    text_x0: f64,
    row_y: f64,
    max_x: f64,
    cell_w: f64,
    cell_h: f64,
    color: i64,
    radius: f64,
) {
    let vs = char_col_to_visual_col(line, char_start, tabstop) - left_col
    let ve = char_col_to_visual_col(line, char_end, tabstop) - left_col
    if ve <= 0 {
        return
    }
    let clamped_s = if vs < 0 { 0 } else { vs }
    let clamped_e = if ve <= clamped_s { clamped_s + 1 } else { ve }
    let rx = text_x0 + clamped_s.as(f64) * cell_w
    if rx >= max_x {
        return
    }
    let raw_w = (clamped_e - clamped_s).as(f64) * cell_w
    let rw = if rx + raw_w > max_x { max_x - rx } else { raw_w }
    if rw > 0.0 {
        cmds.push(DrawCmd.fill_rect(rx, row_y, rw, cell_h, color, radius))
    }
}

fn render_pane_selection_for_row(
    cmds: List,
    world: EditorWorld,
    buf: Buffer,
    pane: WindowPane,
    is_focused: bool,
    buf_row: i64,
    raw_line: String,
    tabstop: i64,
    text_x0: f64,
    row_y: f64,
    pane_right_x: f64,
    cell_w: f64,
    cell_h: f64,
    theme: ThemePalette,
) {
    if is_focused and world.visual.kind != VisualKind.none {
        let a = world.visual.anchor
        let c = world.visual.cursor
        world.visual.kind match {
            VisualKind.char => {
                let norm = Span.normalized(a, c)
                if buf_row >= norm.start.row and buf_row <= norm.end.row {
                    let sc = if buf_row == norm.start.row { norm.start.col } else { 0 }
                    let ec = if buf_row == norm.end.row {
                        norm.end.col + 1
                    } else {
                        raw_line.char_len() + 1
                    }
                    emit_visual_span_rect(
                        cmds, raw_line, sc, ec, tabstop, pane.left_col,
                        text_x0, row_y, pane_right_x, cell_w, cell_h, theme.bg_selection, 0.0,
                    )
                }
            },
            VisualKind.line => {
                let lo_r = if a.row <= c.row { a.row } else { c.row }
                let hi_r = if a.row <= c.row { c.row } else { a.row }
                if buf_row >= lo_r and buf_row <= hi_r and pane_right_x > text_x0 {
                    cmds.push(DrawCmd.fill_rect(text_x0, row_y, pane_right_x - text_x0, cell_h, theme.bg_selection, 0.0))
                }
            },
            VisualKind.block => {
                let lo_r = if a.row <= c.row { a.row } else { c.row }
                let hi_r = if a.row <= c.row { c.row } else { a.row }
                if buf_row >= lo_r and buf_row <= hi_r {
                    let line_a = buf.line_at(a.row)
                    let line_c = buf.line_at(c.row)
                    let va = char_col_to_visual_col(line_a, a.col, tabstop)
                    let vc = char_col_to_visual_col(line_c, c.col, tabstop)
                    let wa = if a.col >= 0 and a.col < line_a.char_len() {
                        let w = char_display_width(line_a.slice(a.col, a.col + 1))
                        if w > 0 { w } else { 1 }
                    } else {
                        1
                    }
                    let wc = if c.col >= 0 and c.col < line_c.char_len() {
                        let w = char_display_width(line_c.slice(c.col, c.col + 1))
                        if w > 0 { w } else { 1 }
                    } else {
                        1
                    }
                    let lo_vc = if va <= vc { va } else { vc }
                    let hi_vc = if va + wa >= vc + wc { va + wa } else { vc + wc }
                    let ds = lo_vc - pane.left_col
                    let de = hi_vc - pane.left_col
                    if de > 0 {
                        let cs = if ds < 0 { 0 } else { ds }
                        let rx = text_x0 + cs.as(f64) * cell_w
                        if rx < pane_right_x {
                            let raw_w = (de - cs).as(f64) * cell_w
                            let rw = if rx + raw_w > pane_right_x { pane_right_x - rx } else { raw_w }
                            if rw > 0.0 {
                                cmds.push(DrawCmd.fill_rect(rx, row_y, rw, cell_h, theme.bg_selection, 0.0))
                            }
                        }
                    }
                }
            },
            VisualKind.none => (),
        }
        return
    }

    -- Emacs active region (`buf.mark_active` with `buf.mark`..`point`)
    if buf.mark_active and buf.mark != null {
        let m? = buf.mark else {
            return
        }
        let pt = if is_focused { pane.cursor } else { buf.point }
        let norm = Span.normalized(m, pt)
        if norm.start != norm.end and buf_row >= norm.start.row and buf_row <= norm.end.row {
            let sc = if buf_row == norm.start.row { norm.start.col } else { 0 }
            let ec = if buf_row == norm.end.row { norm.end.col } else { raw_line.char_len() + 1 }
            emit_visual_span_rect(
                cmds, raw_line, sc, ec, tabstop, pane.left_col,
                text_x0, row_y, pane_right_x, cell_w, cell_h, theme.bg_selection, 0.0,
            )
        }
    }
}

fn render_pane_mode_line(
    cmds: List,
    kernel: SystemKernel,
    world: EditorWorld,
    buf: Buffer,
    pane: WindowPane,
    is_focused: bool,
    ml_y: f64,
    ml_h: f64,
    cell_w: f64,
    theme: ThemePalette,
) {
    let r = pane.rect
    let font_fam = world.options.font_family
    let font_sz = world.options.font_size_pt
    let status_bg = if is_focused { theme.bg_status_active } else { theme.bg_status_inactive }
    cmds.push(DrawCmd.fill_rect(r.x, ml_y, r.w, ml_h, status_bg, 0.0))
    cmds.push(DrawCmd.line(r.x, ml_y, r.x + r.w, ml_y, theme.border, 1.0))

    let text_y = ml_y + 2.0
    var cur_x = r.x + 6.0

    let mode_label = if is_focused { world.mode_name } else { "WIN" }
    let pill_w = (str_display_width(mode_label) + 2).as(f64) * cell_w
    let pill_bg = if is_focused { mode_pill_color(mode_label, theme) } else { theme.border }
    cmds.push(DrawCmd.fill_rect(cur_x, ml_y + 2.0, pill_w, ml_h - 4.0, pill_bg, 3.0))
    cmds.push(DrawCmd.text_run(
        cur_x + cell_w,
        text_y,
        mode_label,
        font_fam,
        font_sz,
        theme.bg,
        false,
        false,
        false,
    ))
    cur_x += pill_w + 8.0

    -- Buffer file-type icon + name + `[+]` / `[RO]` / `[Narrow Lx-Ly]`
    let bicon = nerd_icon_for_buffer(buf)
    cmds.push(DrawCmd.text_run(
        cur_x,
        text_y,
        bicon,
        font_fam,
        font_sz,
        if is_focused { theme.accent } else { theme.fg_muted },
        false,
        false,
        false,
    ))
    cur_x += str_display_width(bicon).as(f64) * cell_w

    cmds.push(DrawCmd.text_run(
        cur_x,
        text_y,
        buf.name,
        font_fam,
        font_sz,
        if is_focused { theme.fg } else { theme.fg_muted },
        false,
        false,
        false,
    ))
    cur_x += (str_display_width(buf.name) + 1).as(f64) * cell_w

    if buf.modified {
        cmds.push(DrawCmd.text_run(cur_x, text_y, "[+]", font_fam, font_sz, theme.diag_warn, false, false, false))
        cur_x += 4.0 * cell_w
    }
    if buf.read_only {
        cmds.push(DrawCmd.text_run(cur_x, text_y, "[RO]", font_fam, font_sz, theme.diag_err, false, false, false))
        cur_x += 5.0 * cell_w
    }
    if buf.is_narrowed() {
        let ntag = "[Narrow L" ++ (buf.min_row() + 1).to_string() ++ "-L" ++ (buf.max_row() + 1).to_string() ++ "]"
        cmds.push(DrawCmd.text_run(cur_x, text_y, ntag, font_fam, font_sz, theme.accent, false, false, false))
        cur_x += (str_display_width(ntag) + 1).as(f64) * cell_w
    }

    let mode_tag = "(" ++ buf.major_mode ++ ")"
    cmds.push(DrawCmd.text_run(cur_x, text_y, mode_tag, font_fam, font_sz, theme.fg_muted, false, false, false))
    cur_x += (str_display_width(mode_tag) + 1).as(f64) * cell_w

    if is_focused and kernel.macros.is_recording() {
        var rname = "q"
        let reg_val? = kernel.macros.recording_reg else {
            return
        }
        rname = reg_val
        let rec_badge = "[REC @" ++ rname ++ "]"
        cmds.push(DrawCmd.text_run(cur_x, text_y, rec_badge, font_fam, font_sz, theme.diag_err, false, false, false))
        cur_x += (str_display_width(rec_badge) + 1).as(f64) * cell_w
    }

    if not world.active_jobs.is_empty() {
        let jbadge = "[Jobs: " ++ world.active_jobs.len().to_string() ++ "]"
        cmds.push(DrawCmd.text_run(cur_x, text_y, jbadge, font_fam, font_sz, theme.diag_warn, false, false, false))
        cur_x += (str_display_width(jbadge) + 1).as(f64) * cell_w
    }

    if is_focused and world.statusline_left_extra != "" {
        cmds.push(DrawCmd.text_run(
            cur_x,
            text_y,
            world.statusline_left_extra,
            font_fam,
            font_sz,
            theme.syn_type,
            false,
            false,
            false,
        ))
        cur_x += (str_display_width(world.statusline_left_extra) + 1).as(f64) * cell_w
    }

    if is_focused and world.pending_keys_display != "" {
        cmds.push(DrawCmd.text_run(
            cur_x,
            text_y,
            world.pending_keys_display,
            font_fam,
            font_sz,
            theme.accent,
            false,
            false,
            false,
        ))
        cur_x += (str_display_width(world.pending_keys_display) + 1).as(f64) * cell_w
    }

    -- Right-aligned statusline extra + `Ln X, Col Y  XX%`
    let total_lines = if buf.line_count() > 0 { buf.line_count() } else { 1 }
    let pct = ((pane.cursor.row + 1) * 100) / total_lines
    let extra_r = if is_focused and world.statusline_right_extra != "" {
        world.statusline_right_extra ++ "  "
    } else {
        ""
    }
    let rhs = extra_r
        ++ "Ln " ++ (pane.cursor.row + 1).to_string()
        ++ ", Col " ++ (pane.cursor.col + 1).to_string()
        ++ "  " ++ pct.to_string() ++ "%"
    let rhs_x = r.x + r.w - (str_display_width(rhs).as(f64) * cell_w) - 8.0
    if rhs_x > cur_x {
        cmds.push(DrawCmd.text_run(rhs_x, text_y, rhs, font_fam, font_sz, theme.fg_muted, false, false, false))
    }
}

fn index_inline_decors_by_row(decors: List) -> HashMap {
    let by_row = HashMap.new()
    for i in 0..decors.len() {
        let dec = decors.get(i.as(usize)).as(InlineSpanDecor)
        let bucket_opt = by_row.get(dec.row)
        if bucket_opt != null {
            bucket_opt.as(List).push(dec)
        } else {
            let b = List()
            b.push(dec)
            by_row.insert(dec.row, b)
        }
    }
    by_row
}

fn is_all_ascii_spaces(s: String) -> bool {
    let n = s.len()
    for i in 0..n {
        if s.byte_at(i) != 32 {
            return false
        }
    }
    true
}

fn emit_single_text_segment(
    cmds: List,
    seg_text: String,
    cur_vcol: i64,
    tabstop: i64,
    left_col: i64,
    text_x0: f64,
    pane_right_x: f64,
    row_y: f64,
    cell_w: f64,
    font_fam: String,
    font_sz: f64,
    fg: i64,
    italic: bool,
    ul: bool,
) -> i64 {
    let (expanded, next_vcol) = expand_tabs_from_col(seg_text, cur_vcol, tabstop)
    if next_vcol > left_col {
        let (vis_text, extra_off) = if cur_vcol < left_col {
            drop_visual_cols(expanded, left_col - cur_vcol)
        } else {
            (expanded, 0)
        }
        let draw_vcol = if cur_vcol < left_col { extra_off } else { cur_vcol - left_col }
        let draw_x = text_x0 + draw_vcol.as(f64) * cell_w
        if draw_x < pane_right_x and vis_text != "" and (ul or (not is_all_ascii_spaces(vis_text))) {
            cmds.push(DrawCmd.text_run(
                draw_x, row_y, vis_text, font_fam, font_sz, fg, false, italic, ul,
            ))
        }
    }
    next_vcol
}

fn emit_ts_row_spans(
    cmds: List,
    raw_line: String,
    spans: List,
    dim_row: bool,
    tabstop: i64,
    left_col: i64,
    text_x0: f64,
    pane_right_x: f64,
    row_y: f64,
    cell_w: f64,
    font_fam: String,
    font_sz: f64,
    theme: ThemePalette,
) -> i64 {
    let n = raw_line.char_len()
    if n == 0 {
        return 0
    }
    let default_eff_fg = if dim_row { theme.fg_muted } else { theme.fg }
    if spans.is_empty() {
        return emit_single_text_segment(
            cmds, raw_line, 0, tabstop, left_col, text_x0, pane_right_x,
            row_y, cell_w, font_fam, font_sz, default_eff_fg, false, false,
        )
    }
    var cur_vcol: i64 = 0
    var pos: i64 = 0
    var run_start: i64 = 0
    var cur_raw_fg: i64 = theme.fg
    var cur_it = false
    var has_run = false

    for i in 0..spans.len() {
        let pk = spans.get(i.as(usize)).as(i64)
        let sp_start = pk / 4294967296
        let sp_rem = pk % 4294967296
        let sp_end = sp_rem / 256
        let sp_grp = sp_rem % 256
        let s0 = if sp_start < pos { pos } else if sp_start > n { n } else { sp_start }
        let e0 = if sp_end > n { n } else { sp_end }
        if s0 > pos {
            if not has_run {
                run_start = pos
                cur_raw_fg = theme.fg
                cur_it = false
                has_run = true
            } else if cur_raw_fg != theme.fg or cur_it != false {
                cur_vcol = emit_single_text_segment(
                    cmds, raw_line.slice(run_start, pos), cur_vcol, tabstop, left_col,
                    text_x0, pane_right_x, row_y, cell_w, font_fam, font_sz,
                    if dim_row { theme.fg_muted } else { cur_raw_fg }, cur_it, false,
                )
                run_start = pos
                cur_raw_fg = theme.fg
                cur_it = false
            }
            pos = s0
        }
        if e0 > s0 {
            let (tok_col, is_it) = ts_hl_group_style(sp_grp, theme)
            if not has_run {
                run_start = s0
                cur_raw_fg = tok_col
                cur_it = is_it
                has_run = true
            } else if cur_raw_fg != tok_col or cur_it != is_it {
                cur_vcol = emit_single_text_segment(
                    cmds, raw_line.slice(run_start, s0), cur_vcol, tabstop, left_col,
                    text_x0, pane_right_x, row_y, cell_w, font_fam, font_sz,
                    if dim_row { theme.fg_muted } else { cur_raw_fg }, cur_it, false,
                )
                run_start = s0
                cur_raw_fg = tok_col
                cur_it = is_it
            }
            pos = e0
        }
    }
    if pos < n {
        if not has_run {
            run_start = pos
            cur_raw_fg = theme.fg
            cur_it = false
            has_run = true
        } else if cur_raw_fg != theme.fg or cur_it != false {
            cur_vcol = emit_single_text_segment(
                cmds, raw_line.slice(run_start, pos), cur_vcol, tabstop, left_col,
                text_x0, pane_right_x, row_y, cell_w, font_fam, font_sz,
                if dim_row { theme.fg_muted } else { cur_raw_fg }, cur_it, false,
            )
            run_start = pos
            cur_raw_fg = theme.fg
            cur_it = false
        }
    }
    if has_run and run_start < n {
        cur_vcol = emit_single_text_segment(
            cmds, raw_line.slice(run_start, n), cur_vcol, tabstop, left_col,
            text_x0, pane_right_x, row_y, cell_w, font_fam, font_sz,
            if dim_row { theme.fg_muted } else { cur_raw_fg }, cur_it, false,
        )
    }
    cur_vcol
}

fn clamp_col_bound(c: i64, n: i64) -> i64 {
    if c < 0 { 0 } else if c > n { n } else { c }
}

fn emit_ts_row_spans_with_fg_decs(
    cmds: List,
    raw_line: String,
    spans: List,
    fg_decs: List,
    dim_row: bool,
    tabstop: i64,
    left_col: i64,
    text_x0: f64,
    pane_right_x: f64,
    row_y: f64,
    cell_w: f64,
    font_fam: String,
    font_sz: f64,
    theme: ThemePalette,
) -> i64 {
    let n = raw_line.char_len()
    if n == 0 {
        return 0
    }
    let base_default_fg = if dim_row { theme.fg_muted } else { theme.fg }
    var cur_vcol: i64 = 0
    var ts_idx: usize = 0
    let ts_len = spans.len()
    let dec_len = fg_decs.len()
    var has_run = false
    var run_start: i64 = 0
    var cur_fg: i64 = base_default_fg
    var cur_it = false
    var cur_ul = false

    var pos: i64 = 0
    while pos < n {
        var next_pos = n
        var fg = base_default_fg
        var it = false
        var ul = false
        while ts_idx < ts_len {
            let pk = spans.get(ts_idx).as(i64)
            let sp_start = pk / 4294967296
            let sp_rem = pk % 4294967296
            let sp_end = sp_rem / 256
            let s0 = clamp_col_bound(sp_start, n)
            let e0 = clamp_col_bound(sp_end, n)
            if e0 <= pos {
                ts_idx += 1
            } else {
                if s0 <= pos {
                    let (tok_col, is_it) = ts_hl_group_style(sp_rem % 256, theme)
                    fg = if dim_row { theme.fg_muted } else { tok_col }
                    it = is_it
                    if e0 < next_pos {
                        next_pos = e0
                    }
                } else if s0 < next_pos {
                    next_pos = s0
                }
                break
            }
        }
        for di in 0..dec_len {
            let dec = fg_decs.get(di.as(usize)).as(InlineSpanDecor)
            let ds = clamp_col_bound(dec.start_col, n)
            let de = clamp_col_bound(dec.end_col, n)
            if ds <= pos and pos < de {
                fg = if dec.fg_rgba != 0 { dec.fg_rgba } else { theme.accent }
                if dec.underline {
                    ul = true
                }
                if de < next_pos {
                    next_pos = de
                }
            } else if ds > pos and ds < next_pos {
                next_pos = ds
            }
        }
        if not has_run {
            run_start = pos
            cur_fg = fg
            cur_it = it
            cur_ul = ul
            has_run = true
        } else if cur_fg != fg or cur_it != it or cur_ul != ul {
            cur_vcol = emit_single_text_segment(
                cmds, raw_line.slice(run_start, pos), cur_vcol, tabstop, left_col,
                text_x0, pane_right_x, row_y, cell_w, font_fam, font_sz,
                cur_fg, cur_it, cur_ul,
            )
            run_start = pos
            cur_fg = fg
            cur_it = it
            cur_ul = ul
        }
        pos = if next_pos > pos { next_pos } else { pos + 1 }
    }
    if has_run and run_start < n {
        cur_vcol = emit_single_text_segment(
            cmds, raw_line.slice(run_start, n), cur_vcol, tabstop, left_col,
            text_x0, pane_right_x, row_y, cell_w, font_fam, font_sz,
            cur_fg, cur_it, cur_ul,
        )
    }
    cur_vcol
}

private global _ts_row_seg_cfg_key: String = ""
private global _ts_row_seg_cache: ?Map = null
private global _pane_decor_cache_key: String = ""
private global _pane_decor_cache_maps: ?(Map, Map, Map) = null

fn ts_spans_exact_eq(a: List, b: List) -> bool {
    let n = a.len()
    if n != b.len() {
        return false
    }
    if n == 0 {
        return true
    }
    if a.get(0).as(i64) != b.get(0).as(i64) {
        return false
    }
    if n > 1 {
        let last_u = (n - 1).as(usize)
        if a.get(last_u).as(i64) != b.get(last_u).as(i64) {
            return false
        }
    }
    if n > 2 {
        let mid_u = (n / 2).as(usize)
        if a.get(mid_u).as(i64) != b.get(mid_u).as(i64) {
            return false
        }
    }
    true
}

fn fg_decs_exact_eq(a: List, b: List) -> bool {
    let n = a.len()
    if n != b.len() {
        return false
    }
    for i in 0..n {
        let da = a.get(i.as(usize)).as(InlineSpanDecor)
        let db = b.get(i.as(usize)).as(InlineSpanDecor)
        if da.start_col != db.start_col or da.end_col != db.end_col or da.fg_rgba != db.fg_rgba or da.underline != db.underline {
            return false
        }
    }
    true
}

fn emit_cached_ts_row(
    cmds: List,
    cache_opt: ?Map,
    raw_line: String,
    row_ts: List,
    fg_decs: List,
    dim_row: bool,
    tabstop: i64,
    left_col: i64,
    text_x0: f64,
    pane_right_x: f64,
    row_y: f64,
    cell_w: f64,
    font_fam: String,
    font_sz: f64,
    theme: ThemePalette,
) -> i64 {
    let can_cache = cache_opt != null and raw_line.len() <= 256
    let ckey = if not can_cache {
        ""
    } else if fg_decs.is_empty() {
        raw_line
    } else {
        let d0 = fg_decs.get(0).as(InlineSpanDecor)
        let dl = fg_decs.get((fg_decs.len() - 1).as(usize)).as(InlineSpanDecor)
        raw_line ++ "\x1f" ++ fg_decs.len().to_string() ++ ":" ++ d0.start_col.to_string() ++ ":" ++ dl.start_col.to_string()
    }
    if can_cache {
        let cmap = cache_opt.as(Map)
        if cmap.contains(ckey) {
            let (c_ts, c_decs, c_dim, c_vcol, c_runs) =
                cmap.get(ckey).as((List, List, bool, i64, List))
            if c_dim == dim_row and fg_decs_exact_eq(c_decs, fg_decs) and ts_spans_exact_eq(c_ts, row_ts) {
                for ri in 0..c_runs.len() {
                    let (rx, rtxt, rcol, rit, rul) =
                        c_runs.get(ri.as(usize)).as((f64, String, i64, bool, bool))
                    cmds.push(DrawCmd.text_run(rx, row_y, rtxt, font_fam, font_sz, rcol, false, rit, rul))
                }
                return c_vcol
            }
        }
    }
    let start_idx = cmds.len()
    let out_vcol = if fg_decs.is_empty() {
        emit_ts_row_spans(
            cmds, raw_line, row_ts, dim_row, tabstop, left_col,
            text_x0, pane_right_x, row_y, cell_w, font_fam, font_sz, theme,
        )
    } else {
        emit_ts_row_spans_with_fg_decs(
            cmds, raw_line, row_ts, fg_decs, dim_row, tabstop, left_col,
            text_x0, pane_right_x, row_y, cell_w, font_fam, font_sz, theme,
        )
    }
    if can_cache {
        let cmap = cache_opt.as(Map)
        if cmap.len() > 512 {
            _ts_row_seg_cache = Map.new()
        } else {
            let captured = List()
            for ci in start_idx..cmds.len() {
                let dcmd = cmds.get(ci.as(usize)).as(DrawCmd)
                dcmd match {
                    DrawCmd.text_run(rx, _, rtxt, _, _, rcol, _, rit, rul) => {
                        captured.push((rx, rtxt, rcol, rit, rul))
                    },
                    _ => (),
                }
            }
            cmap.set(ckey, (row_ts, fg_decs, dim_row, out_vcol, captured))
        }
    }
    out_vcol
}

fn emit_segmented_row_runs(
    cmds: List,
    raw_line: String,
    runs: List,
    fg_decs: List,
    dim_row: bool,
    tabstop: i64,
    left_col: i64,
    text_x0: f64,
    pane_right_x: f64,
    row_y: f64,
    cell_w: f64,
    font_fam: String,
    font_sz: f64,
    theme: ThemePalette,
) -> i64 {
    let n = raw_line.char_len()
    if n == 0 {
        return 0
    }
    let base_default_fg = if dim_row { theme.fg_muted } else { theme.fg }
    if fg_decs.is_empty() {
        var monotonic = true
        var chk_pos: i64 = 0
        for ri in 0..runs.len() {
            let (s_col, tok_text, _, _, _) =
                runs.get(ri.as(usize)).as((i64, String, i64, bool, bool))
            if s_col < chk_pos {
                monotonic = false
                break
            }
            chk_pos = s_col + tok_text.char_len()
        }
        if monotonic {
            var fast_vcol: i64 = 0
            var pos: i64 = 0
            var run_start: i64 = 0
            var cur_fg = base_default_fg
            var cur_it = false
            var has_run = false
            for ri in 0..runs.len() {
                let (s_col, tok_text, tok_color, _tok_bold, tok_italic) =
                    runs.get(ri.as(usize)).as((i64, String, i64, bool, bool))
                let s0 = if s_col > n { n } else { s_col }
                let e_raw = s_col + tok_text.char_len()
                let e0 = if e_raw > n { n } else { e_raw }
                if s0 > pos {
                    if not has_run {
                        run_start = pos
                        cur_fg = base_default_fg
                        cur_it = false
                        has_run = true
                    } else if cur_fg != base_default_fg or cur_it != false {
                        fast_vcol = emit_single_text_segment(
                            cmds, raw_line.slice(run_start, pos), fast_vcol, tabstop, left_col,
                            text_x0, pane_right_x, row_y, cell_w, font_fam, font_sz,
                            cur_fg, cur_it, false,
                        )
                        run_start = pos
                        cur_fg = base_default_fg
                        cur_it = false
                    }
                    pos = s0
                }
                if e0 > s0 {
                    let eff_fg = if dim_row { theme.fg_muted } else { tok_color }
                    if not has_run {
                        run_start = s0
                        cur_fg = eff_fg
                        cur_it = tok_italic
                        has_run = true
                    } else if cur_fg != eff_fg or cur_it != tok_italic {
                        fast_vcol = emit_single_text_segment(
                            cmds, raw_line.slice(run_start, s0), fast_vcol, tabstop, left_col,
                            text_x0, pane_right_x, row_y, cell_w, font_fam, font_sz,
                            cur_fg, cur_it, false,
                        )
                        run_start = s0
                        cur_fg = eff_fg
                        cur_it = tok_italic
                    }
                    pos = e0
                }
            }
            if pos < n {
                if not has_run {
                    run_start = pos
                    cur_fg = base_default_fg
                    cur_it = false
                    has_run = true
                } else if cur_fg != base_default_fg or cur_it != false {
                    fast_vcol = emit_single_text_segment(
                        cmds, raw_line.slice(run_start, pos), fast_vcol, tabstop, left_col,
                        text_x0, pane_right_x, row_y, cell_w, font_fam, font_sz,
                        cur_fg, cur_it, false,
                    )
                    run_start = pos
                    cur_fg = base_default_fg
                    cur_it = false
                }
            }
            if has_run and run_start < n {
                fast_vcol = emit_single_text_segment(
                    cmds, raw_line.slice(run_start, n), fast_vcol, tabstop, left_col,
                    text_x0, pane_right_x, row_y, cell_w, font_fam, font_sz,
                    cur_fg, cur_it, false,
                )
            }
            return fast_vcol
        }
    }
    let r_len = runs.len()
    let run_ranges = List()
    for ri in 0..r_len {
        let (s_col, tok_text, tok_color, _tok_bold, tok_italic) =
            runs.get(ri.as(usize)).as((i64, String, i64, bool, bool))
        let s0 = clamp_col_bound(s_col, n)
        let e0 = clamp_col_bound(s_col + tok_text.char_len(), n)
        run_ranges.push((s0, e0, if dim_row { theme.fg_muted } else { tok_color }, tok_italic))
    }
    let dec_len = fg_decs.len()

    var cur_vcol: i64 = 0
    var has_run = false
    var run_start: i64 = 0
    var cur_fg = base_default_fg
    var cur_italic = false
    var cur_ul = false

    var pos: i64 = 0
    while pos < n {
        var next_pos = n
        var fg = base_default_fg
        var italic = false
        var ul = false
        for ri in 0..r_len {
            let (s0, e0, eff_fg, tok_it) = run_ranges.get(ri.as(usize)).as((i64, i64, i64, bool))
            if s0 <= pos and pos < e0 {
                fg = eff_fg
                italic = tok_it
                if e0 < next_pos {
                    next_pos = e0
                }
            } else if s0 > pos and s0 < next_pos {
                next_pos = s0
            }
        }
        for di in 0..dec_len {
            let dec = fg_decs.get(di.as(usize)).as(InlineSpanDecor)
            let ds = clamp_col_bound(dec.start_col, n)
            let de = clamp_col_bound(dec.end_col, n)
            if ds <= pos and pos < de {
                fg = if dec.fg_rgba != 0 { dec.fg_rgba } else { theme.accent }
                if dec.underline {
                    ul = true
                }
                if de < next_pos {
                    next_pos = de
                }
            } else if ds > pos and ds < next_pos {
                next_pos = ds
            }
        }
        if not has_run {
            run_start = pos
            cur_fg = fg
            cur_italic = italic
            cur_ul = ul
            has_run = true
        } else if fg != cur_fg or italic != cur_italic or ul != cur_ul {
            cur_vcol = emit_single_text_segment(
                cmds, raw_line.slice(run_start, pos), cur_vcol, tabstop, left_col,
                text_x0, pane_right_x, row_y, cell_w, font_fam, font_sz,
                cur_fg, cur_italic, cur_ul,
            )
            run_start = pos
            cur_fg = fg
            cur_italic = italic
            cur_ul = ul
        }
        pos = if next_pos > pos { next_pos } else { pos + 1 }
    }
    if has_run and run_start < n {
        cur_vcol = emit_single_text_segment(
            cmds, raw_line.slice(run_start, n), cur_vcol, tabstop, left_col,
            text_x0, pane_right_x, row_y, cell_w, font_fam, font_sz,
            cur_fg, cur_italic, cur_ul,
        )
    }
    cur_vcol
}

fn render_yazi_column(
    cmds: List,
    world: EditorWorld,
    col_buf: Buffer,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    top_row: i64,
    active_row: i64,
    highlight_active_row: bool,
    cell_w: f64,
    cell_h: f64,
    tabstop: i64,
    theme: ThemePalette,
) {
    if w <= 4.0 or h <= 4.0 {
        return
    }
    let font_fam = world.options.font_family
    let font_sz = world.options.font_size_pt
    let pad_x: f64 = 6.0
    let text_x0 = x + pad_x
    let right_x = x + w - 4.0

    cmds.push(DrawCmd.clip_push(x, y, w, h))
    cmds.push(DrawCmd.fill_rect(x, y, w, h, theme.bg, 0.0))

    let max_rows = ((h / cell_h).floor().as(i64))
    let total_lines = col_buf.line_count()
    let row_decors_map = if col_buf.inline_decors.is_empty() {
        HashMap.new()
    } else {
        index_inline_decors_by_row(col_buf.inline_decors)
    }
    let col_mode_lc = col_buf.major_mode.to_lower()
    let is_col_md = col_mode_lc == "markdown" or col_mode_lc == "md" or col_mode_lc == "gfm"
    let col_md_states = if is_col_md and total_lines > 0 {
        let end_r = if top_row + max_rows < total_lines { top_row + max_rows } else { total_lines - 1 }
        compute_markdown_fence_states(col_buf, end_r)
    } else {
        List()
    }

    var ri: i64 = 0
    while ri < max_rows {
        let buf_row = top_row + ri
        if buf_row < 0 or buf_row >= total_lines {
            break
        }
        let row_y = y + ri.as(f64) * cell_h
        let (col_fk, col_fmode, _) = if is_col_md and buf_row < col_md_states.len() {
            col_md_states.get(buf_row.as(usize)).as((i64, String, i64))
        } else {
            (0, "", -1)
        }
        if col_fk > 0 and col_fk <= 4 and right_x > text_x0 {
            cmds.push(DrawCmd.fill_rect(text_x0, row_y, right_x - text_x0, cell_h, theme.bg_alt, 0.0))
        }
        if highlight_active_row and buf_row == active_row {
            cmds.push(DrawCmd.fill_rect(x + 2.0, row_y, w - 4.0, cell_h, theme.bg_cursor_line, 3.0))
        }
        let raw_line = col_buf.line_at(buf_row)
        let row_decs_opt = row_decors_map.get(buf_row)
        let row_decs = if row_decs_opt != null { row_decs_opt.as(List) } else { List() }
        let fg_decs = List()
        for di in 0..row_decs.len() {
            let dec = row_decs.get(di.as(usize)).as(InlineSpanDecor)
            if dec.bg_rgba != 0 and dec.replace_label == "" {
                emit_visual_span_rect(
                    cmds, raw_line, dec.start_col, dec.end_col, tabstop, 0,
                    text_x0, row_y, right_x, cell_w, cell_h, dec.bg_rgba, 2.0,
                )
            }
            if dec.replace_label == "" and (dec.fg_rgba != 0 or dec.underline) {
                fg_decs.push(dec)
            }
        }
        let runs = if is_col_md and col_fk == 1 {
            tokenize_markdown_fence_delim(raw_line, theme)
        } else if is_col_md and col_fk == 2 {
            if col_fmode != "" {
                tokenize_line(raw_line, col_fmode, theme)
            } else if raw_line != "" {
                [(0, raw_line, theme.fg, false, false)]
            } else {
                List()
            }
        } else if is_col_md and col_fk == 3 {
            [(0, raw_line, theme.border, false, false)]
        } else if is_col_md and col_fk == 4 {
            tokenize_toml_or_json(raw_line, "toml", theme)
        } else if is_col_md and col_fk == 5 {
            [(0, raw_line, theme.syn_comment, false, true)]
        } else {
            tokenize_line(raw_line, col_buf.major_mode, theme)
        }
        var cur_vcol: i64 = 0
        if fg_decs.is_empty() {
            for rj in 0..runs.len() {
                let (_, tok_text, tok_color, _tok_bold, tok_italic) =
                    runs.get(rj.as(usize)).as((i64, String, i64, bool, bool))
                cur_vcol = emit_single_text_segment(
                    cmds, tok_text, cur_vcol, tabstop, 0,
                    text_x0, right_x, row_y, cell_w, font_fam, font_sz,
                    tok_color, tok_italic, false,
                )
            }
        } else {
            let _ = emit_segmented_row_runs(
                cmds, raw_line, runs, fg_decs, false, tabstop, 0,
                text_x0, right_x, row_y, cell_w, font_fam, font_sz, theme,
            )
        }
        ri += 1
    }

    cmds.push(DrawCmd.clip_pop)
}

fn render_yazi_dirvish_pane(
    cmds: List,
    kernel: SystemKernel,
    world: EditorWorld,
    wm: WindowManager,
    pane: WindowPane,
    buf: Buffer,
    is_focused: bool,
    theme: ThemePalette,
) {
    let r = pane.rect
    let cell_w = wm.metrics.cell_width
    let cell_h = wm.metrics.cell_height
    let ml_h = mode_line_height(wm.metrics)
    let content_h = if r.h - ml_h > cell_h { r.h - ml_h } else { cell_h }
    let tabstop = safe_tabstop(world.options)

    cmds.push(DrawCmd.clip_push(r.x, r.y, r.w, r.h))
    cmds.push(DrawCmd.fill_rect(r.x, r.y, r.w, content_h, theme.bg, 0.0))

    let parent_opt = world.find_buffer_by_name("*dirvish-parent*")
    let preview_opt = world.find_buffer_by_name("*dirvish-preview*")
    let show_three_cols = parent_opt != null
        and preview_opt != null
        and preview_opt.as(Buffer).major_mode != "dirvish-preview-hidden"
        and r.w >= 240.0

    if show_three_cols {
        let parent_buf = parent_opt.as(Buffer)
        let preview_buf = preview_opt.as(Buffer)
        let parent_w = (r.w * 0.16).floor()
        let center_w = (r.w * 0.40).floor()
        let preview_w = r.w - parent_w - center_w

        let parent_rows = ((content_h / cell_h).floor().as(i64))
        let parent_top = if parent_rows > 2 and parent_buf.point.row >= parent_rows {
            parent_buf.point.row - parent_rows + 2
        } else {
            0
        }
        render_yazi_column(
            cmds, world, parent_buf, r.x, r.y, parent_w, content_h,
            parent_top, parent_buf.point.row, false, cell_w, cell_h, tabstop, theme,
        )
        render_yazi_column(
            cmds, world, buf, r.x + parent_w, r.y, center_w, content_h,
            pane.top_row, pane.cursor.row, true, cell_w, cell_h, tabstop, theme,
        )
        render_yazi_column(
            cmds, world, preview_buf, r.x + parent_w + center_w, r.y, preview_w, content_h,
            0, -1, false, cell_w, cell_h, tabstop, theme,
        )
        cmds.push(DrawCmd.line(r.x + parent_w, r.y, r.x + parent_w, r.y + content_h, theme.border, 1.0))
        cmds.push(DrawCmd.line(r.x + parent_w + center_w, r.y, r.x + parent_w + center_w, r.y + content_h, theme.border, 1.0))
    } else {
        render_yazi_column(
            cmds, world, buf, r.x, r.y, r.w, content_h,
            pane.top_row, pane.cursor.row, true, cell_w, cell_h, tabstop, theme,
        )
    }

    render_pane_mode_line(
        cmds, kernel, world, buf, pane, is_focused,
        r.y + r.h - ml_h, ml_h, cell_w, theme,
    )
    cmds.push(DrawCmd.clip_pop)

    if r.x > 1.0 {
        cmds.push(DrawCmd.line(r.x, r.y, r.x, r.y + r.h, theme.border, 1.0))
    }
    if r.y > top_bar_height(world) + 1.0 {
        cmds.push(DrawCmd.line(r.x, r.y, r.x + r.w, r.y, theme.border, 1.0))
    }
}

private global _scope_shadow_doc_id: i64 = -1
private global _scope_shadow_edit_ver: i64 = -1
private global _scope_shadow_line_cnt: i64 = -1
private global _scope_shadow_win_lo: i64 = -1
private global _scope_shadow_win_hi: i64 = -1
private global _scope_shadow_blocks: ?List = null
private global _scope_shadow_map: ?Map = null
private global _ts_vp_doc_id: i64 = -1
private global _ts_vp_edit_ver: i64 = -1
private global _ts_vp_lang: String = ""
private global _ts_vp_first_row: i64 = -1
private global _ts_vp_last_row: i64 = -1
private global _ts_vp_rows: ?List = null

fn index_inline_decors_in_row_range(decors: List, lo_row: i64, hi_row: i64) -> Map {
    let by_row = Map.new()
    for i in 0..decors.len() {
        let dec = decors.get(i.as(usize)).as(InlineSpanDecor)
        if dec.row >= lo_row and dec.row <= hi_row {
            let rk = dec.row.to_string()
            let bucket_opt = by_row.get(rk)
            if bucket_opt != null {
                bucket_opt.as(List).push(dec)
            } else {
                let b = List()
                b.push(dec)
                by_row.set(rk, b)
            }
        }
    }
    by_row
}

fn index_best_signs_in_row_range(signs: List, lo_row: i64, hi_row: i64) -> Map {
    let by_row = Map.new()
    for i in 0..signs.len() {
        let s = signs.get(i.as(usize)).as(GutterSign)
        if s.row >= lo_row and s.row <= hi_row {
            let rk = s.row.to_string()
            let prev_opt = by_row.get(rk)
            if prev_opt != null {
                let prev = prev_opt.as(GutterSign)
                if s.priority >= prev.priority {
                    by_row.set(rk, s)
                }
            } else {
                by_row.set(rk, s)
            }
        }
    }
    by_row
}

fn index_virt_texts_in_row_range(vts: List, lo_row: i64, hi_row: i64) -> Map {
    let by_row = Map.new()
    for i in 0..vts.len() {
        let vt = vts.get(i.as(usize)).as(VirtualTextDecor)
        if vt.row >= lo_row and vt.row <= hi_row and vt.text != "" {
            let rk = vt.row.to_string()
            let bucket_opt = by_row.get(rk)
            if bucket_opt != null {
                bucket_opt.as(List).push(vt)
            } else {
                let b = List()
                b.push(vt)
                by_row.set(rk, b)
            }
        }
    }
    by_row
}

fn color_with_alpha(packed_rgba: i64, alpha_byte: i64) -> i64 {
    let clamped = if alpha_byte < 0 { 0 } else if alpha_byte > 255 { 255 } else { alpha_byte }
    (packed_rgba / 256) * 256 + clamped
}

fn is_brace_scope_mode(mode_lc: String) -> bool {
    mode_lc == "nessa"
        or mode_lc == "rust"
        or mode_lc == "c"
        or mode_lc == "cpp"
        or mode_lc == "go"
        or mode_lc == "javascript"
        or mode_lc == "typescript"
        or mode_lc == "java"
        or mode_lc == "zig"
}

fn short_scope_kind_prefix(raw_kind: String) -> String {
    let low = raw_kind.to_lower()
    when {
        low == "fn" or low == "function" or low == "def" or low == "func" or low == "method" => "fn ",
        low == "struct" => "struct ",
        low == "enum" => "enum ",
        low == "impl" => "impl ",
        low == "trait" or low == "interface" => "trait ",
        low == "class" => "class ",
        else => "",
    }
}

fn get_cached_closing_scope_hints(
    buf: Buffer,
    mode_lc: String,
    first_vis_row: i64,
    last_vis_row: i64,
) -> Map {
    if (not is_brace_scope_mode(mode_lc)) or last_vis_row < first_vis_row or first_vis_row < 0 {
        return Map.new()
    }
    if _scope_shadow_doc_id == buf.doc_id
        and _scope_shadow_edit_ver == buf.edit_version
        and first_vis_row >= _scope_shadow_win_lo
        and last_vis_row <= _scope_shadow_win_hi
        and _scope_shadow_map != null {
        return _scope_shadow_map.as(Map)
    }
    let lcount = buf.line_count()
    let win_lo = if first_vis_row > 32 { first_vis_row - 32 } else { 0 }
    let win_hi = if last_vis_row + 32 < lcount { last_vis_row + 32 } else { lcount - 1 }
    let cur_r = buf.point.row
    let cur_line = buf.line_at(cur_r)
    let prev_line = if cur_r >= 1 { buf.line_at(cur_r - 1) } else { "" }
    let blocks = if _scope_shadow_doc_id == buf.doc_id
        and _scope_shadow_line_cnt == lcount
        and _scope_shadow_blocks != null
        and (not cur_line.contains("{{"))
        and (not cur_line.contains("}}")) {
        _scope_shadow_blocks.as(List)
    } else if _scope_shadow_doc_id == buf.doc_id
        and lcount == _scope_shadow_line_cnt + 1
        and cur_r >= 1
        and _scope_shadow_blocks != null
        and (not cur_line.contains("{{"))
        and (not cur_line.contains("}}"))
        and (not prev_line.contains("{{"))
        and (not prev_line.contains("}}")) {
        let prev_blks = _scope_shadow_blocks.as(List)
        let shifted = List()
        for bi in 0..prev_blks.len() {
            let (bn, bk, bsr, ber) = prev_blks.get(bi.as(usize)).as((String, String, i64, i64))
            let nsr = if bsr >= cur_r { bsr + 1 } else { bsr }
            let ner = if ber >= cur_r - 1 { ber + 1 } else { ber }
            shifted.push((bn, bk, nsr, ner))
        }
        shifted
    } else {
        let raw_blks = buf.scan_symbol_blocks(max_items = 600)
        let multi_only = List()
        for bi in 0..raw_blks.len() {
            let blk = raw_blks.get(bi.as(usize)).as((String, String, i64, i64))
            let (_, _, bsr, ber) = blk
            if ber > bsr {
                multi_only.push(blk)
            }
        }
        multi_only
    }
    let m = Map.new()
    let cmt_pfx = if mode_lc == "nessa" or mode_lc == "lua" { "-- " } else { "// " }
    for i in 0..blocks.len() {
        let (sname, skind, srow, erow) = blocks.get(i.as(usize)).as((String, String, i64, i64))
        if erow >= win_lo and erow <= win_hi and sname != "" and erow - srow >= 6 {
            let erk = erow.to_string()
            if not m.contains(erk) {
                let end_trim = buf.line_at(erow).trim()
                if end_trim == "}}" or end_trim == "}};" or end_trim == "}}," {
                    let kp = short_scope_kind_prefix(skind)
                    if kp != "" {
                        m.set(erk, cmt_pfx ++ kp ++ sname)
                    }
                }
            }
        }
    }
    _scope_shadow_doc_id = buf.doc_id
    _scope_shadow_edit_ver = buf.edit_version
    _scope_shadow_line_cnt = lcount
    _scope_shadow_win_lo = win_lo
    _scope_shadow_win_hi = win_hi
    _scope_shadow_blocks = blocks
    _scope_shadow_map = m
    m
}

fn render_window_pane(
    cmds: List,
    kernel: SystemKernel,
    world: EditorWorld,
    wm: WindowManager,
    pane: WindowPane,
    is_focused: bool,
    theme: ThemePalette,
) {
    let r = pane.rect
    if r.w <= 1.0 or r.h <= 1.0 {
        return
    }
    let buf = if world.buffer(pane.buffer_id) != null {
        world.buffer(pane.buffer_id).as(Buffer)
    } else {
        world.active_buffer()
    }
    if buf.major_mode.to_lower() == "dirvish" {
        render_yazi_dirvish_pane(cmds, kernel, world, wm, pane, buf, is_focused, theme)
        return
    }

    let cell_w = wm.metrics.cell_width
    let cell_h = wm.metrics.cell_height
    let ml_h = mode_line_height(wm.metrics)
    let content_h = if r.h - ml_h > cell_h { r.h - ml_h } else { cell_h }
    let gutter_cols = compute_gutter_cols(buf, world.options)
    let gutter_w = compute_gutter_width(buf, world.options, wm.metrics)
    let text_x0 = r.x + gutter_w
    let pane_right_x = r.x + r.w
    let tabstop = safe_tabstop(world.options)
    let font_fam = world.options.font_family
    let font_sz = world.options.font_size_pt

    cmds.push(DrawCmd.clip_push(r.x, r.y, r.w, r.h))
    cmds.push(DrawCmd.fill_rect(r.x, r.y, r.w, content_h, theme.bg, 0.0))
    cmds.push(DrawCmd.fill_rect(r.x, r.y, gutter_w, content_h, theme.bg_alt, 0.0))

    let max_rows = wm.pane_rows(pane)
    let vis_rows = visible_buffer_rows(buf, pane.top_row, max_rows)
    let row_count = vis_rows.len()
    let mode_lc = buf.major_mode.to_lower()
    let is_markdown_buf = mode_lc == "markdown" or mode_lc == "md" or mode_lc == "gfm"
    let first_vis_row = if row_count > 0 { vis_rows.get(0).as(i64) } else { -1 }
    let last_vis_row = if row_count > 0 {
        vis_rows.get((row_count - 1).as(usize)).as(i64)
    } else {
        -1
    }
    let decor_ckey = buf.id.raw().to_string()
        ++ "|" ++ buf.decor_gen.to_string()
        ++ "|" ++ buf.inline_decors.len().to_string()
        ++ "|" ++ buf.signs.len().to_string()
        ++ "|" ++ buf.virt_texts.len().to_string()
        ++ "|" ++ first_vis_row.to_string()
        ++ "|" ++ last_vis_row.to_string()
    let (row_decors_map, row_signs_map, row_vts_map) = if _pane_decor_cache_key == decor_ckey and _pane_decor_cache_maps != null {
        _pane_decor_cache_maps.as((Map, Map, Map))
    } else {
        let dm = if buf.inline_decors.is_empty() or first_vis_row < 0 {
            Map.new()
        } else {
            index_inline_decors_in_row_range(buf.inline_decors, first_vis_row, last_vis_row)
        }
        let sm = if buf.signs.is_empty() or first_vis_row < 0 {
            Map.new()
        } else {
            index_best_signs_in_row_range(buf.signs, first_vis_row, last_vis_row)
        }
        let vm = if buf.virt_texts.is_empty() or first_vis_row < 0 {
            Map.new()
        } else {
            index_virt_texts_in_row_range(buf.virt_texts, first_vis_row, last_vis_row)
        }
        let triple = (dm, sm, vm)
        _pane_decor_cache_key = decor_ckey
        _pane_decor_cache_maps = triple
        triple
    }

    let md_fence_states = if is_markdown_buf and last_vis_row >= 0 {
        compute_markdown_fence_states(buf, last_vis_row)
    } else {
        List()
    }
    let ts_lang = if world.options.treesitter and is_treesitter_eligible_mode(mode_lc) and buf.doc_id > 0 and row_count > 0 {
        ts_lang_for_buffer(buf)
    } else {
        ""
    }
    let ts_viewport_rows = if ts_lang != "" and first_vis_row >= 0 and last_vis_row >= first_vis_row {
        if _ts_vp_doc_id == buf.doc_id
            and _ts_vp_edit_ver == buf.edit_version
            and _ts_vp_lang == ts_lang
            and _ts_vp_first_row == first_vis_row
            and _ts_vp_last_row == last_vis_row
            and _ts_vp_rows != null {
            _ts_vp_rows.as(List)
        } else {
            buf.sync_external_lines()
            let fetched = accel_ts_highlight_rows_packed(buf.doc_id, ts_lang, first_vis_row, last_vis_row)
            _ts_vp_doc_id = buf.doc_id
            _ts_vp_edit_ver = buf.edit_version
            _ts_vp_lang = ts_lang
            _ts_vp_first_row = first_vis_row
            _ts_vp_last_row = last_vis_row
            _ts_vp_rows = fetched
            fetched
        }
    } else {
        List()
    }

    let show_indent_guides = world.options.indent_guides and should_render_indent_guides(buf.major_mode)
    let indent_step = if world.options.shiftwidth > 0 { world.options.shiftwidth } else { tabstop }
    let (eff_indent_lo, eff_indent_arr, active_guide_vcol, scope_start_row, scope_end_row) = if show_indent_guides and row_count > 0 {
        get_cached_pane_indent_guides(
            pane.id.raw(),
            buf,
            vis_rows,
            pane.top_row,
            max_rows,
            pane.cursor.row,
            is_focused,
            tabstop,
            world.options.shiftwidth,
        )
    } else {
        (0, List(), -1, -1, -1)
    }

    let search_active = world.options.hlsearch and world.search_highlight_active and world.last_search != ""
    let search_ic = if search_active { world.effective_ignore_case(world.last_search) } else { false }
    let match_brk_opt = if is_focused and world.options.match_brackets {
        buf.find_matching_bracket_bounded(pane.cursor, 250)
    } else {
        null
    }
    let scope_hints_map = if world.options.shadow_text {
        get_cached_closing_scope_hints(buf, mode_lc, first_vis_row, last_vis_row)
    } else {
        Map.new()
    }

    let has_any_folds = not buf.folded_rows.is_empty()
    let is_narrowed = buf.is_narrowed()
    let mode_upper = if is_focused { world.mode_name.to_upper() } else { "" }
    let in_insert_mode = is_focused and (mode_upper.contains("INSERT") or mode_upper.contains("REPLACE"))
    let contiguous_vis = row_count > 0 and first_vis_row >= 0 and (last_vis_row - first_vis_row + 1 == row_count)
    let batched_lines = if contiguous_vis {
        buf.slice_lines(first_vis_row, last_vis_row + 1)
    } else {
        List()
    }

    if not ts_viewport_rows.is_empty() {
        let seg_cfg = buf.doc_id.to_string()
            ++ "|" ++ ts_lang
            ++ "|" ++ tabstop.to_string()
            ++ "|" ++ pane.left_col.to_string()
            ++ "|" ++ text_x0.to_string()
            ++ "|" ++ pane_right_x.to_string()
            ++ "|" ++ cell_w.to_string()
            ++ "|" ++ font_fam
            ++ "|" ++ font_sz.to_string()
            ++ "|" ++ theme.bg.to_string()
        if _ts_row_seg_cfg_key != seg_cfg or _ts_row_seg_cache == null {
            _ts_row_seg_cfg_key = seg_cfg
            _ts_row_seg_cache = Map.new()
        }
    }

    for s_idx in 0..row_count {
        let buf_row = vis_rows.get(s_idx.as(usize)).as(i64)
        let buf_row_key = buf_row.to_string()
        let row_y = r.y + s_idx.as(f64) * cell_h
        let raw_line = if contiguous_vis and s_idx < batched_lines.len() {
            batched_lines.get(s_idx.as(usize)).as(String)
        } else {
            buf.line_at(buf_row)
        }
        let is_cursor_row = buf_row == pane.cursor.row
        let (md_fence_kind, md_fence_mode, md_open_row) = if is_markdown_buf and buf_row >= 0 and buf_row < md_fence_states.len() {
            md_fence_states.get(buf_row.as(usize)).as((i64, String, i64))
        } else {
            (0, "", -1)
        }
        let is_folded = has_any_folds and (
            buf.folded_rows.contains(buf_row)
            or (
                buf_row + 1 <= buf.max_row()
                and buf.folded_rows.contains(buf_row + 1)
            )
        )
        let dim_row = world.options.twilight_mode
            and is_focused
            and abs_i64(buf_row - pane.cursor.row) > 8

        -- 0. Subtle full-row background tint for Markdown fenced blocks, frontmatter, and table headers
        let is_md_table_hdr = is_markdown_buf
            and md_fence_kind == 0
            and buf_row + 1 <= buf.max_row()
            and raw_line.contains("|")
            and is_markdown_table_sep(buf.line_at(buf_row + 1).chars(), buf.line_at(buf_row + 1).char_len())
        if ((md_fence_kind >= 1 and md_fence_kind <= 4) or is_md_table_hdr) and pane_right_x > text_x0 {
            cmds.push(DrawCmd.fill_rect(text_x0, row_y, pane_right_x - text_x0, cell_h, theme.bg_alt, 0.0))
        }

        -- 1. Focused cursor line background
        if is_focused and is_cursor_row and world.options.cursorline and pane_right_x > text_x0 {
            cmds.push(DrawCmd.fill_rect(text_x0, row_y, pane_right_x - text_x0, cell_h, theme.bg_cursor_line, 0.0))
        }

        -- 2. Gutter (narrow marker `N`, fold marker `▸`, plugin `GutterSign`, absolute / relative line numbers)
        let row_sign_opt = row_signs_map.get(buf_row_key)
        let (marker_ch, marker_color) = if is_folded {
            ("▸", theme.accent)
        } else if is_narrowed {
            ("N", theme.diag_warn)
        } else if row_sign_opt != null {
            let sg = row_sign_opt.as(GutterSign)
            (sg.text.take(2), if sg.fg_rgba != 0 { sg.fg_rgba } else { theme.accent })
        } else {
            (" ", theme.diag_warn)
        }
        if marker_ch != " " and marker_ch != "" {
            cmds.push(DrawCmd.text_run(r.x + 2.0, row_y, marker_ch, font_fam, font_sz, marker_color, false, false, false))
        }

        if world.options.number or world.options.relativenumber {
            let num_width = if gutter_cols >= 3 { gutter_cols - 3 } else { 1 }
            let num_str = if world.options.number and world.options.relativenumber {
                if is_cursor_row {
                    (buf_row + 1).to_string()
                } else {
                    abs_i64(buf_row - pane.cursor.row).to_string()
                }
            } else if world.options.relativenumber {
                abs_i64(buf_row - pane.cursor.row).to_string()
            } else {
                (buf_row + 1).to_string()
            }
            let aligned_num = pad_left(num_str, num_width)
            cmds.push(DrawCmd.text_run(
                r.x + cell_w,
                row_y,
                aligned_num,
                font_fam,
                font_sz,
                if is_focused and is_cursor_row { theme.fg_gutter_active } else { theme.fg_gutter },
                false,
                false,
                false,
            ))
        }

        -- 2b. Continuous alignment vertical indent guides + active scope highlight (`world.options.indent_guides`)
        if show_indent_guides {
            let eff_idx = buf_row - eff_indent_lo
            let eff_indent = if eff_idx >= 0 and eff_idx < eff_indent_arr.len() {
                eff_indent_arr.get(eff_idx.as(usize)).as(i64)
            } else {
                0
            }
            if eff_indent > 0 and indent_step > 0 {
                var ig_col: i64 = 0
                while ig_col < eff_indent {
                    let g_disp = ig_col - pane.left_col
                    if g_disp >= 0 {
                        let gx = text_x0 + g_disp.as(f64) * cell_w + 1.0
                        if gx < pane_right_x {
                            let is_active_scope = ig_col == active_guide_vcol
                                and buf_row >= scope_start_row
                                and buf_row <= scope_end_row
                            let g_color = if is_active_scope { theme.accent } else { theme.border }
                            cmds.push(DrawCmd.line(gx, row_y, gx, row_y + cell_h, g_color, 1.0))
                        }
                    }
                    ig_col += indent_step
                }
            }
        }

        -- 3. Selection background rectangles BEFORE text
        if is_focused and (world.visual.kind != VisualKind.none or buf.mark_active) {
            render_pane_selection_for_row(
                cmds, world, buf, pane, is_focused, buf_row, raw_line,
                tabstop, text_x0, row_y, pane_right_x, cell_w, cell_h, theme,
            )
        }

        -- 4. Search match highlights + Bracket match + Plugin `InlineSpanDecor` backgrounds BEFORE text
        if search_active {
            let mlist = buf.find_all_in_line(buf_row, world.last_search, search_ic)
            for mi in 0..mlist.len() {
                let (mc_s, mc_e) = mlist.get(mi.as(usize)).as((i64, i64))
                emit_visual_span_rect(
                    cmds, raw_line, mc_s, mc_e, tabstop, pane.left_col,
                    text_x0, row_y, pane_right_x, cell_w, cell_h, theme.bg_search, 2.0,
                )
            }
        }

        if match_brk_opt != null {
            let mb_pos = match_brk_opt.as(Pos)
            if mb_pos.row == buf_row {
                emit_visual_span_rect(
                    cmds, raw_line, mb_pos.col, mb_pos.col + 1, tabstop, pane.left_col,
                    text_x0, row_y, pane_right_x, cell_w, cell_h, theme.bg_selection, 2.0,
                )
            }
        }

        let row_decs_opt = row_decors_map.get(buf_row_key)
        let row_decs = if row_decs_opt != null { row_decs_opt.as(List) } else { List() }
        let fg_decs = List()
        if not row_decs.is_empty() {
            for di in 0..row_decs.len() {
                let dec = row_decs.get(di.as(usize)).as(InlineSpanDecor)
                if dec.bg_rgba != 0 and dec.replace_label == "" {
                    emit_visual_span_rect(
                        cmds, raw_line, dec.start_col, dec.end_col, tabstop, pane.left_col,
                        text_x0, row_y, pane_right_x, cell_w, cell_h, dec.bg_rgba, 2.0,
                    )
                }
                if dec.replace_label == "" and (dec.fg_rgba != 0 or dec.underline) {
                    fg_decs.push(dec)
                }
            }
        }
        if is_markdown_buf and md_fence_kind == 0 {
            collect_markdown_link_url_decors(raw_line, buf_row, theme, fg_decs)
        }

        -- 5. Syntax-highlighted `DrawCmd.text_run` spans (with inline shadow ghost completion split at cursor)
        let ig = world.inline_ghost
        let has_row_ghost = is_focused
            and is_cursor_row
            and world.options.shadow_text
            and (not world.minibuffer_view.active)
            and ig.active
            and ig.row == buf_row
            and ig.col == pane.cursor.col
            and ig.text != ""

        var cur_vcol: i64 = 0
        let has_ts_row = (not is_markdown_buf)
            and (not has_row_ghost)
            and (not ts_viewport_rows.is_empty())
            and buf_row >= first_vis_row
            and (buf_row - first_vis_row) < ts_viewport_rows.len()

        if has_ts_row {
            let row_ts = ts_viewport_rows.get((buf_row - first_vis_row).as(usize)).as(List)
            cur_vcol = emit_cached_ts_row(
                cmds,
                _ts_row_seg_cache,
                raw_line,
                row_ts,
                fg_decs,
                dim_row,
                tabstop,
                pane.left_col,
                text_x0,
                pane_right_x,
                row_y,
                cell_w,
                font_fam,
                font_sz,
                theme,
            )
        } else {
            let full_runs = if is_markdown_buf and md_fence_kind == 1 {
                tokenize_markdown_fence_delim(raw_line, theme)
            } else if is_markdown_buf and md_fence_kind == 2 {
                if md_fence_mode != "" {
                    let block_ts = if world.options.treesitter {
                        get_md_fenced_block_ts_spans(buf, md_fence_states, md_open_row, md_fence_mode)
                    } else {
                        List()
                    }
                    let rel_idx = buf_row - (md_open_row + 1)
                    if (not block_ts.is_empty()) and rel_idx >= 0 and rel_idx < block_ts.len() {
                        ts_spans_to_runs(raw_line, block_ts.get(rel_idx.as(usize)).as(List), theme)
                    } else {
                        tokenize_line(raw_line, md_fence_mode, theme)
                    }
                } else if raw_line != "" {
                    [(0, raw_line, theme.fg, false, false)]
                } else {
                    List()
                }
            } else if is_markdown_buf and md_fence_kind == 3 {
                [(0, raw_line, theme.border, false, false)]
            } else if is_markdown_buf and md_fence_kind == 4 {
                tokenize_toml_or_json(raw_line, "toml", theme)
            } else if is_markdown_buf and md_fence_kind == 5 {
                [(0, raw_line, theme.syn_comment, false, true)]
            } else if (not ts_viewport_rows.is_empty()) and buf_row >= first_vis_row and (buf_row - first_vis_row) < ts_viewport_rows.len() {
                let row_ts = ts_viewport_rows.get((buf_row - first_vis_row).as(usize)).as(List)
                ts_spans_to_runs(raw_line, row_ts, theme)
            } else {
                tokenize_line(raw_line, buf.major_mode, theme)
            }

            if has_row_ghost {
                let split_col = if pane.cursor.col < 0 {
                    0
                } else if pane.cursor.col > raw_line.char_len() {
                    raw_line.char_len()
                } else {
                    pane.cursor.col
                }
                let (left_runs, right_runs) = split_runs_at_char_col(full_runs, split_col)
                for ri in 0..left_runs.len() {
                    let (_, tok_text, tok_color, _tok_bold, tok_italic) =
                        left_runs.get(ri.as(usize)).as((i64, String, i64, bool, bool))
                    cur_vcol = emit_single_text_segment(
                        cmds,
                        tok_text,
                        cur_vcol,
                        tabstop,
                        pane.left_col,
                        text_x0,
                        pane_right_x,
                        row_y,
                        cell_w,
                        font_fam,
                        font_sz,
                        if dim_row { theme.fg_muted } else { tok_color },
                        tok_italic,
                        false,
                    )
                }
                cur_vcol = emit_single_text_segment(
                    cmds,
                    ig.text,
                    cur_vcol,
                    tabstop,
                    pane.left_col,
                    text_x0,
                    pane_right_x,
                    row_y,
                    cell_w,
                    font_fam,
                    font_sz,
                    color_with_alpha(theme.fg_muted, 160),
                    true,
                    false,
                )
                for rri in 0..right_runs.len() {
                    let (_, rtok_text, rtok_color, _rtok_bold, rtok_italic) =
                        right_runs.get(rri.as(usize)).as((i64, String, i64, bool, bool))
                    cur_vcol = emit_single_text_segment(
                        cmds,
                        rtok_text,
                        cur_vcol,
                        tabstop,
                        pane.left_col,
                        text_x0,
                        pane_right_x,
                        row_y,
                        cell_w,
                        font_fam,
                        font_sz,
                        if dim_row { theme.fg_muted } else { rtok_color },
                        rtok_italic,
                        false,
                    )
                }
            } else if fg_decs.is_empty() {
                for ri in 0..full_runs.len() {
                    let (_, tok_text, tok_color, _tok_bold, tok_italic) =
                        full_runs.get(ri.as(usize)).as((i64, String, i64, bool, bool))
                    cur_vcol = emit_single_text_segment(
                        cmds,
                        tok_text,
                        cur_vcol,
                        tabstop,
                        pane.left_col,
                        text_x0,
                        pane_right_x,
                        row_y,
                        cell_w,
                        font_fam,
                        font_sz,
                        if dim_row { theme.fg_muted } else { tok_color },
                        tok_italic,
                        false,
                    )
                }
            } else {
                cur_vcol = emit_segmented_row_runs(
                    cmds,
                    raw_line,
                    full_runs,
                    fg_decs,
                    dim_row,
                    tabstop,
                    pane.left_col,
                    text_x0,
                    pane_right_x,
                    row_y,
                    cell_w,
                    font_fam,
                    font_sz,
                    theme,
                )
            }
        }

        -- 5b. Plugin `InlineSpanDecor` Flash jump badges (`replace_label` with opaque pill background)
        if not row_decs.is_empty() {
            for di in 0..row_decs.len() {
                let dec = row_decs.get(di.as(usize)).as(InlineSpanDecor)
                if dec.replace_label != "" {
                    let dv = char_col_to_visual_col(raw_line, dec.start_col, tabstop) - pane.left_col
                    if dv >= 0 {
                        let dx = text_x0 + dv.as(f64) * cell_w
                        if dx < pane_right_x {
                            let lw = str_display_width(dec.replace_label).as(f64) * cell_w
                            let pill_bg = if dec.bg_rgba != 0 { dec.bg_rgba } else { theme.diag_err }
                            let pill_fg = if dec.fg_rgba != 0 { dec.fg_rgba } else { theme.bg }
                            cmds.push(DrawCmd.fill_rect(dx, row_y, lw, cell_h, pill_bg, 3.0))
                            cmds.push(DrawCmd.text_run(dx, row_y, dec.replace_label, font_fam, font_sz, pill_fg, false, false, false))
                        }
                    }
                }
            }
        }

        -- Folded heading indicator suffix ` [...]`
        if is_folded {
            let fold_vcol = if cur_vcol < pane.left_col { 0 } else { cur_vcol - pane.left_col }
            let fold_x = text_x0 + fold_vcol.as(f64) * cell_w
            if fold_x < pane_right_x {
                cmds.push(DrawCmd.text_run(
                    fold_x, row_y, " [...]", font_fam, font_sz,
                    theme.accent, false, true, false,
                ))
                cur_vcol += 6
            }
        }

        -- 5c. End-of-line `VirtualTextDecor` (git blame, inline diagnostics, hints) + Closing-Scope Shadow Labels
        let row_vts_opt = row_vts_map.get(buf_row_key)
        var rendered_row_vt = false
        if row_vts_opt != null {
            let row_vts = row_vts_opt.as(List)
            var vt_vcol = (if cur_vcol < pane.left_col { 0 } else { cur_vcol - pane.left_col }) + 2
            for vi in 0..row_vts.len() {
                let vt = row_vts.get(vi.as(usize)).as(VirtualTextDecor)
                if in_insert_mode and vt.owner == "ext_lsp" {
                    continue
                }
                let vx = text_x0 + vt_vcol.as(f64) * cell_w
                if vx < pane_right_x - cell_w * 2.0 {
                    let max_vt = (((pane_right_x - vx) / cell_w).floor().as(i64))
                    let vtxt = clip_str(vt.text, max_vt)
                    cmds.push(DrawCmd.text_run(
                        vx, row_y, vtxt, font_fam, font_sz,
                        if vt.fg_rgba != 0 { vt.fg_rgba } else { theme.fg_muted },
                        false, vt.italic, false,
                    ))
                    vt_vcol += str_display_width(vtxt) + 2
                    rendered_row_vt = true
                }
            }
        }
        if (not rendered_row_vt) and (not has_row_ghost) and world.options.shadow_text {
            let scope_lbl_opt = scope_hints_map.get(buf_row_key)
            if scope_lbl_opt != null {
                let scope_lbl = scope_lbl_opt.as(String)
                let sh_vcol = (if cur_vcol < pane.left_col { 0 } else { cur_vcol - pane.left_col }) + 2
                let sh_x = text_x0 + sh_vcol.as(f64) * cell_w
                if sh_x < pane_right_x - cell_w * 4.0 {
                    let max_sh = (((pane_right_x - sh_x) / cell_w).floor().as(i64))
                    let clipped_sh = clip_str(scope_lbl, max_sh)
                    cmds.push(DrawCmd.text_run(
                        sh_x,
                        row_y,
                        clipped_sh,
                        font_fam,
                        font_sz,
                        color_with_alpha(theme.fg_muted, 118),
                        false,
                        true,
                        false,
                    ))
                }
            }
        }

        -- 6. Cursor caret (`world.caret_shape` on focused pane when `!minibuffer_view.active`, `HollowBlock` otherwise) + Multi-Cursors
        if is_cursor_row {
            let caret_vcol = char_col_to_visual_col(raw_line, pane.cursor.col, tabstop) - pane.left_col
            if caret_vcol >= 0 {
                let caret_x = text_x0 + caret_vcol.as(f64) * cell_w
                if caret_x < pane_right_x {
                    let shape = if is_focused and (not world.minibuffer_view.active) {
                        world.caret_shape
                    } else {
                        CaretShape.hollow_block
                    }
                    let c_color = if is_focused and (not world.minibuffer_view.active) {
                        theme.accent
                    } else {
                        theme.fg_muted
                    }
                    let cur_ch_cells = if pane.cursor.col >= 0 and pane.cursor.col < raw_line.char_len() {
                        let cw = char_display_width(raw_line.slice(pane.cursor.col, pane.cursor.col + 1))
                        if cw > 1 { cw } else { 1 }
                    } else {
                        1
                    }
                    let c_w = if shape == CaretShape.beam { 2.0 } else { cur_ch_cells.as(f64) * cell_w }
                    cmds.push(DrawCmd.cursor_caret(caret_x, row_y, c_w, cell_h, shape, c_color))
                }
            }
        }

        if is_focused and (not world.secondary_cursors.is_empty()) {
            for sci in 0..world.secondary_cursors.len() {
                let sp = world.secondary_cursors.get(sci.as(usize)).as(Pos)
                if sp.row == buf_row {
                    let sv = char_col_to_visual_col(raw_line, sp.col, tabstop) - pane.left_col
                    if sv >= 0 {
                        let sx = text_x0 + sv.as(f64) * cell_w
                        if sx < pane_right_x {
                            let s_shape = world.caret_shape
                            let s_cells = if sp.col >= 0 and sp.col < raw_line.char_len() {
                                let cw = char_display_width(raw_line.slice(sp.col, sp.col + 1))
                                if cw > 1 { cw } else { 1 }
                            } else {
                                1
                            }
                            let s_w = if s_shape == CaretShape.beam { 2.0 } else { s_cells.as(f64) * cell_w }
                            cmds.push(DrawCmd.cursor_caret(sx, row_y, s_w, cell_h, s_shape, theme.mode_visual))
                        }
                    }
                }
            }
        }
    }

    -- 7. Per-pane Mode-Line at bottom of pane
    render_pane_mode_line(
        cmds, kernel, world, buf, pane, is_focused,
        r.y + r.h - ml_h, ml_h, cell_w, theme,
    )

    cmds.push(DrawCmd.clip_pop)

    -- 8. Crisp 1px split borders between adjacent panes
    if r.x > 1.0 {
        cmds.push(DrawCmd.line(r.x, r.y, r.x, r.y + r.h, theme.border, 1.0))
    }
    if r.y > top_bar_height(world) + 1.0 {
        cmds.push(DrawCmd.line(r.x, r.y, r.x + r.w, r.y, theme.border, 1.0))
    }
}

fn render_which_key_overlay(
    cmds: List,
    world: EditorWorld,
    wm: WindowManager,
    theme: ThemePalette,
    win_w: f64,
    echo_y: f64,
) {
    if world.which_key_items.is_empty() or world.minibuffer_view.active {
        return
    }
    let cell_w = wm.metrics.cell_width
    let cell_h = wm.metrics.cell_height
    let font_fam = world.options.font_family
    let font_sz = world.options.font_size_pt

    let total = world.which_key_items.len()
    let max_items = if total > 30 { 30 } else { total }
    let cols = if win_w >= 1120.0 and max_items >= 12 {
        4
    } else if win_w >= 880.0 and max_items >= 6 {
        3
    } else if win_w >= 580.0 and max_items >= 3 {
        2
    } else {
        1
    }
    let rows = (max_items + cols - 1) / cols
    let margin: f64 = 12.0
    let box_w = if win_w - margin * 2.0 > 160.0 { win_w - margin * 2.0 } else { win_w }
    let box_h = (rows + 1).as(f64) * cell_h + 14.0
    let box_x = (win_w - box_w) * 0.5
    let top_h = top_bar_height(world)
    let box_y = if echo_y - box_h - 6.0 > top_h {
        echo_y - box_h - 6.0
    } else {
        top_h + 4.0
    }

    cmds.push(DrawCmd.clip_push(box_x, box_y, box_w, box_h))
    cmds.push(DrawCmd.fill_rect(box_x, box_y, box_w, box_h, theme.bg_popup, 6.0))
    cmds.push(DrawCmd.stroke_rect(box_x, box_y, box_w, box_h, theme.border, 1.0, 6.0))

    let pk = world.pending_keys_display
    let hdr_suffix = if pk != "" {
        if pk.ends_with("-") {
            "(" ++ pk ++ ")"
        } else {
            "(" ++ pk ++ "-)"
        }
    } else {
        "(" ++ world.mode_name ++ ")"
    }
    let hdr = " Which-Key " ++ hdr_suffix
    cmds.push(DrawCmd.text_run(box_x + 10.0, box_y + 5.0, hdr, font_fam, font_sz, theme.accent, false, false, false))

    let col_w = (box_w - 20.0) / cols.as(f64)
    let max_cell_chars = ((col_w / cell_w).floor().as(i64)) - 2
    for idx in 0..max_items {
        let r_idx = idx % rows
        let c_idx = idx / rows
        let ix = box_x + 10.0 + c_idx.as(f64) * col_w
        let iy = box_y + 7.0 + (r_idx + 1).as(f64) * cell_h
        let (chord, cmd_name) = extract_which_key_pair(world.which_key_items.get(idx.as(usize)))
        let chord_w = str_display_width(chord)
        cmds.push(DrawCmd.text_run(ix, iy, chord, font_fam, font_sz, theme.syn_keyword, false, false, false))
        let arrow_x = ix + (chord_w + 1).as(f64) * cell_w
        cmds.push(DrawCmd.text_run(arrow_x, iy, "->", font_fam, font_sz, theme.fg_muted, false, false, false))
        let cmd_x = arrow_x + 3.0 * cell_w
        let avail_chars = max_cell_chars - chord_w - 4
        let cmd_fg = if cmd_name.starts_with("+") { theme.accent } else { theme.fg }
        cmds.push(DrawCmd.text_run(
            cmd_x,
            iy,
            clip_str(cmd_name, if avail_chars > 4 { avail_chars } else { 8 }),
            font_fam,
            font_sz,
            cmd_fg,
            false,
            false,
            false,
        ))
    }

    cmds.push(DrawCmd.clip_pop)
}

fn minibuffer_mode_pill_color(badge: String, theme: ThemePalette) -> i64 {
    badge match {
        "EX :" => theme.mode_command,
        "M-x" => theme.syn_keyword,
        "FILE" => theme.accent,
        "BUFFER" => theme.syn_type,
        "CHOICE" => theme.syn_string,
        "SEARCH" => theme.mode_visual,
        "CONFIRM" => theme.diag_warn,
        _ => theme.accent,
    }
}

fn minibuffer_badge_color(kind_badge: String, badge_rgba: i64, theme: ThemePalette) -> i64 {
    kind_badge match {
        "[dir]" => theme.accent,
        "[ex]" => theme.syn_keyword,
        "[cmd]" => theme.syn_fn,
        "[buf]" => theme.syn_type,
        "[opt]" => theme.syn_number,
        "[thm]" => theme.syn_string,
        "[ns]" => theme.syn_fn,
        "[rs]" => theme.syn_fn,
        "[py]" => theme.syn_fn,
        "[ts]" => theme.syn_fn,
        "[js]" => theme.syn_fn,
        "[go]" => theme.syn_fn,
        "[c]" => theme.syn_fn,
        "[md]" => theme.syn_string,
        "[org]" => theme.syn_string,
        "[toml]" => theme.syn_string,
        "[json]" => theme.syn_string,
        "[sh]" => theme.diag_ok,
        "[term]" => theme.diag_ok,
        "[tel]" => theme.mode_visual,
        "[pick]" => theme.mode_visual,
        "[hit]" => theme.diag_warn,
        "[key]" => theme.syn_keyword,
        _ => {
            if badge_rgba != 0 { badge_rgba } else { theme.fg_muted }
        },
    }
}

fn render_minibuffer_label_runs(
    cmds: List,
    label: String,
    match_indices: List,
    start_x: f64,
    y: f64,
    cell_w: f64,
    font_fam: String,
    font_sz: f64,
    theme: ThemePalette,
    _is_sel: bool,
) {
    let n = label.char_len()
    if n == 0 {
        return
    }
    if match_indices.is_empty() {
        cmds.push(DrawCmd.text_run(start_x, y, label, font_fam, font_sz, theme.fg, false, false, false))
        return
    }
    let matched_set = Set.new()
    for mi in 0..match_indices.len() {
        let idx = match_indices.get(mi.as(usize)).as(i64)
        if idx >= 0 and idx < n {
            matched_set.insert(idx)
        }
    }
    if matched_set.is_empty() {
        cmds.push(DrawCmd.text_run(start_x, y, label, font_fam, font_sz, theme.fg, false, false, false))
        return
    }

    var cx = start_x
    var run_start: i64 = 0
    var cur_matched = matched_set.contains(0)
    for ci in 1..n {
        let m = matched_set.contains(ci)
        if m != cur_matched {
            let seg = label.slice(run_start, ci)
            if cur_matched {
                cmds.push(DrawCmd.text_run(cx, y, seg, font_fam, font_sz, theme.accent, false, false, true))
            } else {
                cmds.push(DrawCmd.text_run(cx, y, seg, font_fam, font_sz, theme.fg, false, false, false))
            }
            cx += str_display_width(seg).as(f64) * cell_w
            run_start = ci
            cur_matched = m
        }
    }
    let tail = label.slice(run_start, n)
    if tail != "" {
        if cur_matched {
            cmds.push(DrawCmd.text_run(cx, y, tail, font_fam, font_sz, theme.accent, false, false, true))
        } else {
            cmds.push(DrawCmd.text_run(cx, y, tail, font_fam, font_sz, theme.fg, false, false, false))
        }
    }
}

fn render_echo_or_minibuffer(
    cmds: List,
    world: EditorWorld,
    wm: WindowManager,
    theme: ThemePalette,
    win_w: f64,
    echo_y: f64,
) {
    let cell_w = wm.metrics.cell_width
    let cell_h = wm.metrics.cell_height
    let font_fam = world.options.font_family
    let font_sz = world.options.font_size_pt
    let mb = world.minibuffer_view

    -- Bottom bar background
    cmds.push(DrawCmd.clip_push(0.0, echo_y, win_w, ECHO_BAR_HEIGHT))
    cmds.push(DrawCmd.fill_rect(0.0, echo_y, win_w, ECHO_BAR_HEIGHT, theme.bg_alt, 0.0))
    cmds.push(DrawCmd.line(0.0, echo_y, win_w, echo_y, theme.border, 1.0))

    if mb.active {
        var prompt_x: f64 = 8.0
        let text_y = echo_y + 2.0
        if world.minibuffer_mode_badge != "" {
            let pill_txt = "[" ++ world.minibuffer_mode_badge ++ "]"
            let pill_w = str_display_width(pill_txt).as(f64) * cell_w + 8.0
            let pill_bg = minibuffer_mode_pill_color(world.minibuffer_mode_badge, theme)
            cmds.push(DrawCmd.fill_rect(prompt_x, echo_y + 2.0, pill_w, cell_h, pill_bg, 4.0))
            cmds.push(DrawCmd.text_run(
                prompt_x + 4.0, text_y, pill_txt, font_fam, font_sz,
                theme.bg, false, false, false,
            ))
            prompt_x += pill_w + 8.0
        }
        if mb.prompt_label != "" {
            cmds.push(DrawCmd.text_run(
                prompt_x, text_y, mb.prompt_label, font_fam, font_sz,
                theme.mode_command, false, false, false,
            ))
        }
        let input_x = prompt_x + str_display_width(mb.prompt_label).as(f64) * cell_w
        if mb.input_text != "" {
            cmds.push(DrawCmd.text_run(
                input_x, text_y, mb.input_text, font_fam, font_sz,
                theme.fg, false, false, false,
            ))
        }
        let clamped_col = if mb.cursor_col < 0 {
            0
        } else if mb.cursor_col > mb.input_text.char_len() {
            mb.input_text.char_len()
        } else {
            mb.cursor_col
        }
        if world.minibuffer_history_ghost != "" and clamped_col == mb.input_text.char_len() {
            let ghost_x = input_x + str_display_width(mb.input_text).as(f64) * cell_w
            cmds.push(DrawCmd.text_run(
                ghost_x, text_y, world.minibuffer_history_ghost, font_fam, font_sz,
                theme.fg_muted, false, false, false,
            ))
        }
        let prefix_cols = if clamped_col > 0 {
            str_display_width(mb.input_text.slice(0, clamped_col))
        } else {
            0
        }
        let beam_x = input_x + prefix_cols.as(f64) * cell_w
        cmds.push(DrawCmd.cursor_caret(beam_x, text_y, 2.0, cell_h, CaretShape.beam, theme.accent))
    } else if world.status_message != "" {
        let is_err = world.status_message.starts_with("Error") or world.status_message.starts_with("error:")
        cmds.push(DrawCmd.text_run(
            8.0,
            echo_y + 2.0,
            world.status_message,
            font_fam,
            font_sz,
            if is_err { theme.diag_err } else { theme.fg },
            false,
            false,
            false,
        ))
    }
    cmds.push(DrawCmd.clip_pop)

    -- Vertico + Marginalia completion candidate popup (up to 12 visible items around `mb.selected_idx`)
    if mb.active and not mb.items.is_empty() {
        let total = mb.items.len()
        let sel = if mb.selected_idx < 0 {
            0
        } else if mb.selected_idx >= total {
            total - 1
        } else {
            mb.selected_idx
        }
        let max_vis: i64 = 12
        let vis_count = if total < max_vis { total } else { max_vis }
        var start_idx = sel - (vis_count / 2)
        if start_idx + vis_count > total {
            start_idx = total - vis_count
        }
        if start_idx < 0 {
            start_idx = 0
        }

        let pop_margin: f64 = 8.0
        let pop_w = if win_w - pop_margin * 2.0 > 160.0 { win_w - pop_margin * 2.0 } else { win_w }
        let pop_h = (vis_count + 1).as(f64) * cell_h + 12.0
        let pop_x = pop_margin
        let top_h = top_bar_height(world)
        let pop_y = if echo_y - pop_h - 4.0 > top_h {
            echo_y - pop_h - 4.0
        } else {
            top_h + 2.0
        }

        cmds.push(DrawCmd.clip_push(pop_x, pop_y, pop_w, pop_h))
        cmds.push(DrawCmd.fill_rect(pop_x, pop_y, pop_w, pop_h, theme.bg_popup, 6.0))
        cmds.push(DrawCmd.stroke_rect(pop_x, pop_y, pop_w, pop_h, theme.border, 1.0, 6.0))

        let match_total = if mb.total_matches > 0 { mb.total_matches } else { total }
        let hdr_badge_prefix = if world.minibuffer_mode_badge != "" {
            "[" ++ world.minibuffer_mode_badge ++ "] "
        } else {
            ""
        }
        let pop_hdr = hdr_badge_prefix ++ "Completions (" ++ (sel + 1).to_string() ++ "/" ++ match_total.to_string() ++ ")"
        cmds.push(DrawCmd.text_run(pop_x + 10.0, pop_y + 4.0, pop_hdr, font_fam, font_sz, theme.accent, false, false, false))

        if world.minibuffer_hint_bar != "" {
            let max_hdr_cols = (((pop_w - 24.0) / cell_w).floor().as(i64)) - str_display_width(pop_hdr) - 3
            if max_hdr_cols > 12 {
                let hint_txt = clip_str(world.minibuffer_hint_bar, max_hdr_cols)
                let hint_x = pop_x + pop_w - (str_display_width(hint_txt).as(f64) * cell_w) - 12.0
                cmds.push(DrawCmd.text_run(hint_x, pop_y + 4.0, hint_txt, font_fam, font_sz, theme.fg_muted, false, false, false))
            }
        }
        cmds.push(DrawCmd.line(pop_x + 6.0, pop_y + 5.0 + cell_h, pop_x + pop_w - 6.0, pop_y + 5.0 + cell_h, theme.border, 1.0))

        let sb_pad: f64 = if total > vis_count { 10.0 } else { 0.0 }
        let query_lc = mb.input_text.trim().to_lower()
        let rich_total = world.minibuffer_rich_items.len()

        for row_i in 0..vis_count {
            let item_idx = start_idx + row_i
            let iy = pop_y + 6.0 + (row_i + 1).as(f64) * cell_h
            let is_sel = item_idx == sel
            if is_sel {
                cmds.push(DrawCmd.fill_rect(pop_x + 4.0, iy, pop_w - 8.0 - sb_pad, cell_h, theme.bg_selection, 3.0))
                cmds.push(DrawCmd.fill_rect(pop_x + 4.0, iy, 3.0, cell_h, theme.accent, 0.0))
            }

            if item_idx < rich_total and (world.minibuffer_rich_items.get(item_idx.as(usize)) matches _: MinibufferRichItem) {
                let rich = world.minibuffer_rich_items.get(item_idx.as(usize)).as(MinibufferRichItem)
                let badge_x = pop_x + 10.0
                var label_x = badge_x
                if rich.kind_badge != "" {
                    let bcol = minibuffer_badge_color(rich.kind_badge, rich.badge_rgba, theme)
                    cmds.push(DrawCmd.text_run(badge_x, iy, rich.kind_badge, font_fam, font_sz, bcol, false, false, false))
                    let bw = str_display_width(rich.kind_badge)
                    let badge_cols = if bw > 6 { bw + 1 } else { 7 }
                    label_x = badge_x + badge_cols.as(f64) * cell_w
                } else {
                    label_x = pop_x + 12.0
                }

                let max_label_cols = (((pop_w * 0.48) / cell_w).floor().as(i64))
                let shown_label = clip_str(rich.label, if max_label_cols > 18 { max_label_cols } else { 24 })
                render_minibuffer_label_runs(
                    cmds, shown_label, rich.match_indices, label_x, iy, cell_w,
                    font_fam, font_sz, theme, is_sel,
                )

                var right_limit_x = pop_x + pop_w - 12.0 - sb_pad
                let min_right_x = label_x + (str_display_width(shown_label) + 2).as(f64) * cell_w

                -- Right-aligned Marginalia metadata (`size  perms  summary`)
                if rich.marginalia != "" {
                    let max_marg_chars = (((pop_w * 0.45) / cell_w).floor().as(i64))
                    let clipped_marg = clip_str(rich.marginalia, if max_marg_chars > 12 { max_marg_chars } else { 20 })
                    let marg_x = right_limit_x - (str_display_width(clipped_marg).as(f64) * cell_w)
                    if marg_x > min_right_x {
                        cmds.push(DrawCmd.text_run(
                            marg_x, iy, clipped_marg, font_fam, font_sz,
                            theme.fg_muted, false, true, false,
                        ))
                        right_limit_x = marg_x - 10.0
                    }
                }

                -- Bound keychord pill badge (`SPC f f`, `C-x C-f`, etc.)
                if rich.key_hint != "" {
                    let pill_str = " " ++ clip_str(rich.key_hint, 18) ++ " "
                    let pill_w = str_display_width(pill_str).as(f64) * cell_w
                    let pill_x = right_limit_x - pill_w
                    if pill_x > min_right_x {
                        cmds.push(DrawCmd.fill_rect(pill_x, iy + 1.0, pill_w, cell_h - 2.0, theme.bg_alt, 3.0))
                        cmds.push(DrawCmd.text_run(
                            pill_x, iy, pill_str, font_fam, font_sz,
                            theme.syn_keyword, false, false, false,
                        ))
                    }
                }
            } else {
                let (cand_label, cand_detail) = extract_minibuffer_candidate(mb.items.get(item_idx.as(usize)))
                let label_x = pop_x + 12.0

                -- Highlight matched fuzzy/substring query prefix or characters
                if query_lc != "" and cand_label.to_lower().contains(query_lc) {
                    let hit_indices = cand_label.to_lower().find_indices(query_lc)
                    let h0 = hit_indices.get(0).as(i64)
                    let h1 = h0 + query_lc.char_len()
                    let pre = cand_label.slice(0, h0)
                    let mid = cand_label.slice(h0, h1)
                    let post = cand_label.slice(h1, cand_label.char_len())
                    var cx = label_x
                    if pre != "" {
                        cmds.push(DrawCmd.text_run(cx, iy, pre, font_fam, font_sz, theme.fg, false, false, false))
                        cx += str_display_width(pre).as(f64) * cell_w
                    }
                    cmds.push(DrawCmd.text_run(cx, iy, mid, font_fam, font_sz, theme.accent, false, false, true))
                    cx += str_display_width(mid).as(f64) * cell_w
                    if post != "" {
                        cmds.push(DrawCmd.text_run(cx, iy, post, font_fam, font_sz, theme.fg, false, false, false))
                    }
                } else {
                    cmds.push(DrawCmd.text_run(
                        label_x, iy, cand_label, font_fam, font_sz,
                        theme.fg,
                        false, false, false,
                    ))
                }

                -- Right-aligned detail summary
                if cand_detail != "" {
                    let max_detail_chars = (((pop_w * 0.5) / cell_w).floor().as(i64))
                    let clipped_det = clip_str(cand_detail, if max_detail_chars > 10 { max_detail_chars } else { 20 })
                    let det_x = pop_x + pop_w - (str_display_width(clipped_det).as(f64) * cell_w) - 12.0 - sb_pad
                    let min_det_x = label_x + (str_display_width(cand_label) + 2).as(f64) * cell_w
                    if det_x > min_det_x {
                        cmds.push(DrawCmd.text_run(
                            det_x, iy, clipped_det, font_fam, font_sz,
                            theme.fg_muted, false, true, false,
                        ))
                    }
                }
            }
        }

        -- Right-edge proportional scrollbar track + thumb when `total > vis_count`
        if total > vis_count {
            let track_x = pop_x + pop_w - 7.0
            let track_y = pop_y + 6.0 + cell_h
            let track_h = vis_count.as(f64) * cell_h
            cmds.push(DrawCmd.fill_rect(track_x, track_y, 3.0, track_h, theme.bg_alt, 1.5))
            let raw_thumb_h = track_h * (vis_count.as(f64) / total.as(f64))
            let thumb_h = if raw_thumb_h < 10.0 {
                if track_h < 10.0 { track_h } else { 10.0 }
            } else if raw_thumb_h > track_h {
                track_h
            } else {
                raw_thumb_h
            }
            let max_start = if total - vis_count > 0 { total - vis_count } else { 1 }
            let frac = start_idx.as(f64) / max_start.as(f64)
            let thumb_y = track_y + (track_h - thumb_h) * frac
            cmds.push(DrawCmd.fill_rect(track_x, thumb_y, 3.0, thumb_h, theme.accent, 1.5))
        }

        cmds.push(DrawCmd.clip_pop)
    }
}

fn render_sidebar_panel(
    cmds: List,
    panel: SidebarPanel,
    world: EditorWorld,
    wm: WindowManager,
    theme: ThemePalette,
    x: f64,
    y: f64,
    w: f64,
    h: f64,
    is_left: bool,
) {
    if (not panel.visible) or w <= 4.0 or h <= 4.0 {
        return
    }
    let cell_w = wm.metrics.cell_width
    let cell_h = wm.metrics.cell_height
    let font_fam = world.options.font_family
    let font_sz = world.options.font_size_pt

    cmds.push(DrawCmd.clip_push(x, y, w, h))
    cmds.push(DrawCmd.fill_rect(x, y, w, h, theme.bg_alt, 0.0))

    -- Sidebar header
    let hdr_h = cell_h + 6.0
    cmds.push(DrawCmd.fill_rect(x, y, w, hdr_h, theme.bg_status_inactive, 0.0))
    let max_chars = (((w - 14.0) / cell_w).floor().as(i64))
    let hdr_txt = clip_str(panel.title, max_chars)
    cmds.push(DrawCmd.text_run(x + 8.0, y + 3.0, hdr_txt, font_fam, font_sz, theme.accent, false, false, false))
    cmds.push(DrawCmd.line(x, y + hdr_h - 1.0, x + w, y + hdr_h - 1.0, theme.border, 1.0))

    let max_rows = (((h - hdr_h - 4.0) / cell_h).floor().as(i64))
    let total = panel.lines.len()
    let sel = if panel.selected_row < 0 {
        0
    } else if panel.selected_row >= total {
        total - 1
    } else {
        panel.selected_row
    }
    var start_r: i64 = 0
    if max_rows > 0 and sel >= max_rows {
        start_r = sel - max_rows + 1
    }
    let count = if total - start_r > max_rows { max_rows } else { total - start_r }
    for ri in 0..count {
        let idx = start_r + ri
        let ry = y + hdr_h + 2.0 + ri.as(f64) * cell_h
        let ln = panel.lines.get(idx.as(usize)).as(String)
        let is_sel = idx == sel
        if is_sel {
            cmds.push(DrawCmd.fill_rect(x + 2.0, ry, w - 4.0, cell_h, theme.bg_selection, 3.0))
        }
        let clipped = clip_str(ln, max_chars)
        let is_dir = clipped.ends_with("/")
            or clipped.contains("▾ ")
            or clipped.contains("▸ ")
            or clipped.contains(" ")
            or clipped.contains(" ")
        let fg = if is_sel {
            theme.fg
        } else if is_dir {
            theme.accent
        } else {
            theme.fg_muted
        }
        cmds.push(DrawCmd.text_run(x + 8.0, ry, clipped, font_fam, font_sz, fg, false, false, false))
    }

    let bx = if is_left { x + w - 1.0 } else { x }
    cmds.push(DrawCmd.line(bx, y, bx, y + h, theme.border, 1.0))
    cmds.push(DrawCmd.clip_pop)
}

fn cmp_kind_badge_and_color(kind: String, theme: ThemePalette) -> (String, i64) {
    let low = kind.to_lower()
    when {
        low == "function" or low == "fn" => (" fn", theme.syn_fn),
        low == "method" => (" mth", theme.syn_fn),
        low == "constructor" => (" ctr", theme.syn_fn),
        low == "struct" or low == "class" => (" typ", theme.syn_type),
        low == "enum" or low == "enummember" => (" enm", theme.syn_type),
        low == "interface" or low == "trait" => (" trt", theme.syn_type),
        low == "field" or low == "property" => (" fld", theme.accent),
        low == "constant" => (" cst", theme.syn_number),
        low == "keyword" => (" kw", theme.syn_keyword),
        low == "snippet" => (" snp", theme.diag_ok),
        low == "module" or low == "namespace" or low == "package" => (" mod", theme.accent),
        low == "path" => (" pth", theme.accent),
        low == "variable" or low == "identifier" => (" var", theme.fg_muted),
        else => (" " ++ clip_str(low, 3), theme.syn_type),
    }
}

fn emit_popup_code_line(
    cmds: List,
    line_txt: String,
    mode: String,
    x0: f64,
    y: f64,
    max_cols: i64,
    cell_w: f64,
    font_fam: String,
    font_sz: f64,
    theme: ThemePalette,
) {
    let clipped = clip_str(line_txt, max_cols)
    if clipped == "" {
        return
    }
    let eff_mode = if mode != "" { mode } else { "nessa" }
    let runs = tokenize_line(clipped, eff_mode, theme)
    if runs.is_empty() {
        cmds.push(DrawCmd.text_run(x0, y, clipped, font_fam, font_sz, theme.fg, false, false, false))
        return
    }
    var cur_x = x0
    for ri in 0..runs.len() {
        let (_, tok_text, tok_color, _tok_bold, tok_italic) =
            runs.get(ri.as(usize)).as((i64, String, i64, bool, bool))
        if tok_text != "" {
            cmds.push(DrawCmd.text_run(cur_x, y, tok_text, font_fam, font_sz, tok_color, false, tok_italic, false))
            cur_x += str_display_width(tok_text).as(f64) * cell_w
        }
    }
}

fn render_buffer_completion_popup(
    cmds: List,
    world: EditorWorld,
    wm: WindowManager,
    theme: ThemePalette,
    win_w: f64,
    echo_y: f64,
) {
    let cp = world.completion_popup
    if (not cp.active) or cp.items.is_empty() or world.minibuffer_view.active {
        return
    }
    let pane = wm.active_pane()
    let buf = world.active_buffer()
    let cell_w = wm.metrics.cell_width
    let cell_h = wm.metrics.cell_height
    let font_fam = world.options.font_family
    let font_sz = world.options.font_size_pt
    let tabstop = safe_tabstop(world.options)
    let gutter_w = compute_gutter_width(buf, world.options, wm.metrics)

    let total = cp.items.len()
    let vis_count = if total > 14 { 14 } else { total }
    let sel = if cp.selected_idx < 0 {
        0
    } else if cp.selected_idx >= total {
        total - 1
    } else {
        cp.selected_idx
    }
    var start_i = sel - (vis_count / 2)
    if start_i + vis_count > total {
        start_i = total - vis_count
    }
    if start_i < 0 {
        start_i = 0
    }

    -- Adaptive column sizing so both candidate labels AND full signature/description details fit cleanly!
    var max_lbl_w: i64 = 18
    var max_det_w: i64 = 16
    for ri in 0..vis_count {
        let it = cp.items.get((start_i + ri).as(usize)).as(CompletionItem)
        let lw = str_display_width(it.label)
        if lw > max_lbl_w {
            max_lbl_w = if lw > 38 { 38 } else { lw }
        }
        let dw = str_display_width(it.detail)
        if dw > max_det_w {
            max_det_w = if dw > 46 { 46 } else { dw }
        }
    }
    let has_doc = not cp.doc_lines.is_empty()
    let win_cols = (((win_w - 20.0) / cell_w).floor().as(i64))
    let max_pop_cols = if has_doc and win_cols >= 110 {
        if win_cols - 48 < 78 { win_cols - 48 } else { 78 }
    } else if win_cols > 82 {
        82
    } else if win_cols > 32 {
        win_cols
    } else {
        32
    }
    let desired_cols = 8 + max_lbl_w + 3 + max_det_w + 3
    let pop_cols = if desired_cols < 54 {
        if 54 <= max_pop_cols { 54 } else { max_pop_cols }
    } else if desired_cols > max_pop_cols {
        max_pop_cols
    } else {
        desired_cols
    }

    let raw_line = buf.line_at(pane.cursor.row)
    let vcol = char_col_to_visual_col(raw_line, cp.replace_start_col, tabstop) - pane.left_col
    var pop_x = pane.rect.x + gutter_w + (if vcol > 0 { vcol } else { 0 }).as(f64) * cell_w
    let pop_w = pop_cols.as(f64) * cell_w
    if pop_x + pop_w > win_w - 8.0 {
        pop_x = if win_w - pop_w - 8.0 > 8.0 { win_w - pop_w - 8.0 } else { 8.0 }
    }
    let pop_h = vis_count.as(f64) * cell_h + 8.0
    let screen_row = if pane.cursor.row >= pane.top_row { pane.cursor.row - pane.top_row } else { 0 }
    let top_h = top_bar_height(world)
    let below_y = pane.rect.y + (screen_row + 1).as(f64) * cell_h + 2.0
    let pop_y = if below_y + pop_h <= echo_y - 4.0 {
        below_y
    } else {
        let above_y = pane.rect.y + screen_row.as(f64) * cell_h - pop_h - 2.0
        if above_y > top_h { above_y } else { top_h + 4.0 }
    }

    cmds.push(DrawCmd.clip_push(pop_x, pop_y, pop_w, pop_h))
    cmds.push(DrawCmd.fill_rect(pop_x, pop_y, pop_w, pop_h, theme.bg_popup, 5.0))
    cmds.push(DrawCmd.stroke_rect(pop_x, pop_y, pop_w, pop_h, theme.border, 1.0, 5.0))

    let sb_pad = if total > vis_count { 8.0 } else { 0.0 }
    let pfx_lc = cp.prefix.to_lower()
    let max_lbl_clip = if pop_cols - 18 > 16 {
        if max_lbl_w < pop_cols - 18 { max_lbl_w } else { pop_cols - 18 }
    } else {
        16
    }

    for ri in 0..vis_count {
        let idx = start_i + ri
        let iy = pop_y + 4.0 + ri.as(f64) * cell_h
        let item = cp.items.get(idx.as(usize)).as(CompletionItem)
        let is_sel = idx == sel
        if is_sel {
            cmds.push(DrawCmd.fill_rect(pop_x + 3.0, iy, pop_w - 6.0 - sb_pad, cell_h, theme.bg_selection, 3.0))
        }
        let (kshort, kcol) = cmp_kind_badge_and_color(item.kind, theme)
        let ktag = "[" ++ kshort ++ "]"
        cmds.push(DrawCmd.text_run(pop_x + 8.0, iy, ktag, font_fam, font_sz, kcol, false, false, false))

        let lx = pop_x + 8.0 + 7.0 * cell_w
        let shown_lbl = clip_str(item.label, max_lbl_clip)
        if pfx_lc != "" and shown_lbl.to_lower().contains(pfx_lc) {
            let hits = shown_lbl.to_lower().find_indices(pfx_lc)
            let h0 = hits.get(0).as(i64)
            let h1 = h0 + pfx_lc.char_len()
            let pre = shown_lbl.slice(0, h0)
            let mid = shown_lbl.slice(h0, h1)
            let post = shown_lbl.slice(h1, shown_lbl.char_len())
            var cx = lx
            if pre != "" {
                cmds.push(DrawCmd.text_run(cx, iy, pre, font_fam, font_sz, theme.fg, false, false, false))
                cx += str_display_width(pre).as(f64) * cell_w
            }
            if mid != "" {
                cmds.push(DrawCmd.text_run(cx, iy, mid, font_fam, font_sz, theme.accent, false, false, true))
                cx += str_display_width(mid).as(f64) * cell_w
            }
            if post != "" {
                cmds.push(DrawCmd.text_run(cx, iy, post, font_fam, font_sz, theme.fg, false, false, false))
            }
        } else {
            cmds.push(DrawCmd.text_run(lx, iy, shown_lbl, font_fam, font_sz, theme.fg, false, false, false))
        }

        if item.detail != "" {
            let used_lbl_w = str_display_width(shown_lbl)
            let right_edge_x = pop_x + pop_w - 8.0 - sb_pad
            let min_det_x = lx + (used_lbl_w + 2).as(f64) * cell_w
            let avail_det_cols = (((right_edge_x - min_det_x) / cell_w).floor().as(i64))
            if avail_det_cols >= 6 {
                let det = clip_str(item.detail, avail_det_cols)
                let dx = right_edge_x - (str_display_width(det).as(f64) * cell_w)
                if dx >= min_det_x - 1.0 {
                    cmds.push(DrawCmd.text_run(dx, iy, det, font_fam, font_sz, theme.fg_muted, false, true, false))
                }
            }
        }
    }

    if total > vis_count {
        let track_x = pop_x + pop_w - 6.0
        let track_y = pop_y + 4.0
        let track_h = vis_count.as(f64) * cell_h
        cmds.push(DrawCmd.fill_rect(track_x, track_y, 3.0, track_h, theme.bg_alt, 1.5))
        let raw_th = track_h * (vis_count.as(f64) / total.as(f64))
        let thumb_h = if raw_th < 8.0 {
            if track_h < 8.0 { track_h } else { 8.0 }
        } else if raw_th > track_h {
            track_h
        } else {
            raw_th
        }
        let max_s = if total - vis_count > 0 { total - vis_count } else { 1 }
        let ty = track_y + (track_h - thumb_h) * (start_i.as(f64) / max_s.as(f64))
        cmds.push(DrawCmd.fill_rect(track_x, ty, 3.0, thumb_h, theme.accent, 1.5))
    }
    cmds.push(DrawCmd.clip_pop)

    -- Adjacent Documentation Side Window when navigating candidates (`cp.doc_lines`)
    if has_doc {
        -- Filter out ``` / ~~~ fence marker lines while tracking code-block state for syntax coloring
        let display_rows = List()
        var in_fence = false
        var doc_fc = '`'
        var doc_flen: i64 = 3
        let b_mode_lc = buf.major_mode.to_lower()
        let default_code_lang = if b_mode_lc == "markdown" or b_mode_lc == "md" or b_mode_lc == "gfm" {
            "nessa"
        } else {
            buf.major_mode
        }
        var fence_lang = default_code_lang
        var max_doc_line_w = str_display_width(cp.doc_title) + 2
        for di in 0..cp.doc_lines.len() {
            if display_rows.len() >= 14 {
                break
            }
            let raw_dl = cp.doc_lines.get(di.as(usize)).as(String)
            if not in_fence {
                let f_opt = parse_markdown_fence_open(raw_dl)
                if f_opt != null {
                    let (fc, fl, info_s) = f_opt.as((char, i64, String))
                    doc_fc = fc
                    doc_flen = fl
                    let cm = canonical_fence_mode(info_s)
                    fence_lang = if cm != "" { cm } else { default_code_lang }
                    in_fence = true
                    continue
                }
            } else if is_markdown_fence_close(raw_dl, doc_fc, doc_flen) {
                in_fence = false
                continue
            }
            let dw = str_display_width(raw_dl)
            if dw > max_doc_line_w {
                max_doc_line_w = dw
            }
            display_rows.push((raw_dl, in_fence, fence_lang))
        }
        if not display_rows.is_empty() {
            let desired_doc_cols = if max_doc_line_w + 4 < 38 {
                38
            } else if max_doc_line_w + 4 > 62 {
                62
            } else {
                max_doc_line_w + 4
            }
            let right_space = win_w - (pop_x + pop_w + 6.0) - 8.0
            let left_space = pop_x - 6.0 - 8.0
            var doc_w = desired_doc_cols.as(f64) * cell_w
            var doc_x = pop_x + pop_w + 6.0
            var doc_y = pop_y
            if right_space >= 30.0 * cell_w {
                if doc_w > right_space {
                    doc_w = right_space
                }
                doc_x = pop_x + pop_w + 6.0
            } else if left_space >= 30.0 * cell_w {
                if doc_w > left_space {
                    doc_w = left_space
                }
                doc_x = pop_x - doc_w - 6.0
            } else {
                -- Narrow window fallback: stack cleanly below or above completion popup
                if doc_w > win_w - 16.0 {
                    doc_w = win_w - 16.0
                }
                doc_x = if pop_x + doc_w <= win_w - 8.0 { pop_x } else { 8.0 }
                let doc_h_est = (display_rows.len() + 1).as(f64) * cell_h + 12.0
                if pop_y + pop_h + 4.0 + doc_h_est <= echo_y - 4.0 {
                    doc_y = pop_y + pop_h + 4.0
                } else if pop_y - doc_h_est - 4.0 > top_h {
                    doc_y = pop_y - doc_h_est - 4.0
                } else {
                    return
                }
            }
            let doc_h = (display_rows.len() + 1).as(f64) * cell_h + 12.0
            if doc_y + doc_h > echo_y - 4.0 {
                doc_y = if echo_y - doc_h - 4.0 > top_h { echo_y - doc_h - 4.0 } else { top_h + 4.0 }
            }
            let max_doc_chars = (((doc_w - 16.0) / cell_w).floor().as(i64))
            if max_doc_chars >= 12 {
                cmds.push(DrawCmd.clip_push(doc_x, doc_y, doc_w, doc_h))
                cmds.push(DrawCmd.fill_rect(doc_x, doc_y, doc_w, doc_h, theme.bg_popup, 5.0))
                cmds.push(DrawCmd.stroke_rect(doc_x, doc_y, doc_w, doc_h, theme.border, 1.0, 5.0))
                let hdr_title = clip_str(if cp.doc_title != "" { cp.doc_title } else { "Documentation" }, max_doc_chars)
                cmds.push(DrawCmd.text_run(doc_x + 8.0, doc_y + 4.0, hdr_title, font_fam, font_sz, theme.accent, false, false, false))
                cmds.push(DrawCmd.line(doc_x + 6.0, doc_y + cell_h + 6.0, doc_x + doc_w - 6.0, doc_y + cell_h + 6.0, theme.border, 1.0))

                for dri in 0..display_rows.len() {
                    let dy = doc_y + cell_h + 8.0 + dri.as(f64) * cell_h
                    let (dtxt, is_code, code_lang) = display_rows.get(dri.as(usize)).as((String, bool, String))
                    if is_code {
                        cmds.push(DrawCmd.fill_rect(doc_x + 4.0, dy, doc_w - 8.0, cell_h, theme.bg_alt, 2.0))
                        emit_popup_code_line(cmds, dtxt, code_lang, doc_x + 8.0, dy, max_doc_chars, cell_w, font_fam, font_sz, theme)
                    } else if dtxt.starts_with("────") or dtxt == "---" {
                        cmds.push(DrawCmd.line(doc_x + 8.0, dy + cell_h * 0.5, doc_x + doc_w - 8.0, dy + cell_h * 0.5, theme.border, 1.0))
                    } else if dtxt.starts_with("Defined ") or dtxt.starts_with("Local binding ") {
                        cmds.push(DrawCmd.text_run(doc_x + 8.0, dy, clip_str(dtxt, max_doc_chars), font_fam, font_sz, theme.fg_muted, false, true, false))
                    } else {
                        emit_popup_code_line(cmds, dtxt, "markdown", doc_x + 8.0, dy, max_doc_chars, cell_w, font_fam, font_sz, theme)
                    }
                }
                cmds.push(DrawCmd.clip_pop)
            }
        }
    }
}

fn find_active_param_span_in_sig(sig_label: String, active_param_text: String) -> (i64, i64) {
    if active_param_text == "" or sig_label == "" {
        return (-1, -1)
    }
    let open_hits = sig_label.find_indices("(")
    let search_from = if not open_hits.is_empty() { open_hits.get(0).as(i64) } else { 0 }
    let sub = sig_label.drop(search_from)
    let hits = sub.find_indices(active_param_text)
    if not hits.is_empty() {
        let s = search_from + hits.get(0).as(i64)
        return (s, s + active_param_text.char_len())
    }
    (-1, -1)
}

fn render_signature_help_popup(
    cmds: List,
    world: EditorWorld,
    wm: WindowManager,
    theme: ThemePalette,
    win_w: f64,
    echo_y: f64,
) {
    let sh = world.signature_help
    if (not sh.active) or sh.label == "" or world.minibuffer_view.active {
        return
    }
    let pane = wm.active_pane()
    let buf = world.active_buffer()
    let cell_w = wm.metrics.cell_width
    let cell_h = wm.metrics.cell_height
    let font_fam = world.options.font_family
    let font_sz = world.options.font_size_pt
    let tabstop = safe_tabstop(world.options)
    let gutter_w = compute_gutter_width(buf, world.options, wm.metrics)

    let has_doc = sh.doc_summary.trim() != ""
    let rows_needed = if has_doc { 2 } else { 1 }
    let max_win_cols = (((win_w - 20.0) / cell_w).floor().as(i64))
    let max_sig_cols = if max_win_cols > 88 { 88 } else if max_win_cols > 24 { max_win_cols } else { 24 }
    let lbl_w = str_display_width(sh.label)
    let doc_w_cells = if has_doc { str_display_width(sh.doc_summary) } else { 0 }
    let content_cols = if lbl_w > doc_w_cells { lbl_w } else { doc_w_cells }
    let box_cols = if content_cols + 4 < 34 {
        if 34 <= max_sig_cols { 34 } else { max_sig_cols }
    } else if content_cols + 4 > max_sig_cols {
        max_sig_cols
    } else {
        content_cols + 4
    }
    let box_w = box_cols.as(f64) * cell_w
    let box_h = rows_needed.as(f64) * cell_h + (if has_doc { 12.0 } else { 8.0 })

    let anchor_r = if sh.anchor_pos.row >= pane.top_row { sh.anchor_pos.row } else { pane.cursor.row }
    let anchor_line = buf.line_at(anchor_r)
    let vcol = char_col_to_visual_col(anchor_line, sh.anchor_pos.col, tabstop) - pane.left_col
    var box_x = pane.rect.x + gutter_w + (if vcol > 0 { vcol } else { 0 }).as(f64) * cell_w
    if box_x + box_w > win_w - 8.0 {
        box_x = if win_w - box_w - 8.0 > 8.0 { win_w - box_w - 8.0 } else { 8.0 }
    }

    let screen_row = if pane.cursor.row >= pane.top_row { pane.cursor.row - pane.top_row } else { 0 }
    let top_h = top_bar_height(world)
    let above_y = pane.rect.y + screen_row.as(f64) * cell_h - box_h - 4.0
    let below_y = pane.rect.y + (screen_row + 1).as(f64) * cell_h + 2.0
    let box_y = if above_y >= top_h + 2.0 {
        above_y
    } else if (not world.completion_popup.active) and below_y + box_h <= echo_y - 4.0 {
        below_y
    } else {
        top_h + 2.0
    }

    cmds.push(DrawCmd.clip_push(box_x, box_y, box_w, box_h))
    cmds.push(DrawCmd.fill_rect(box_x, box_y, box_w, box_h, theme.bg_popup, 5.0))
    cmds.push(DrawCmd.stroke_rect(box_x, box_y, box_w, box_h, theme.accent, 1.0, 5.0))

    let inner_cols = box_cols - 3
    let shown_sig = clip_str(sh.label, inner_cols)
    let act_p_txt = if sh.active_param >= 0 and sh.active_param < sh.parameters.len() {
        sh.parameters.get(sh.active_param.as(usize)).as(String)
    } else {
        ""
    }
    let (ps, pe) = find_active_param_span_in_sig(shown_sig, act_p_txt)
    let sy = box_y + 4.0
    let sx0 = box_x + 8.0
    if ps >= 0 and pe > ps and pe <= shown_sig.char_len() {
        let pre_s = shown_sig.slice(0, ps)
        let mid_s = shown_sig.slice(ps, pe)
        let post_s = shown_sig.slice(pe, shown_sig.char_len())
        let pre_w = str_display_width(pre_s).as(f64) * cell_w
        let mid_w = str_display_width(mid_s).as(f64) * cell_w
        cmds.push(DrawCmd.fill_rect(sx0 + pre_w - 2.0, sy, mid_w + 4.0, cell_h, theme.bg_selection, 3.0))
        if pre_s != "" {
            emit_popup_code_line(cmds, pre_s, buf.major_mode, sx0, sy, inner_cols, cell_w, font_fam, font_sz, theme)
        }
        cmds.push(DrawCmd.text_run(sx0 + pre_w, sy, mid_s, font_fam, font_sz, theme.accent, false, false, true))
        if post_s != "" {
            emit_popup_code_line(cmds, post_s, buf.major_mode, sx0 + pre_w + mid_w, sy, inner_cols, cell_w, font_fam, font_sz, theme)
        }
    } else {
        emit_popup_code_line(cmds, shown_sig, buf.major_mode, sx0, sy, inner_cols, cell_w, font_fam, font_sz, theme)
    }

    if has_doc {
        let div_y = box_y + cell_h + 6.0
        cmds.push(DrawCmd.line(box_x + 6.0, div_y, box_x + box_w - 6.0, div_y, theme.border, 1.0))
        cmds.push(DrawCmd.text_run(
            sx0,
            div_y + 2.0,
            clip_str(sh.doc_summary.trim(), inner_cols),
            font_fam,
            font_sz,
            theme.fg_muted,
            false,
            true,
            false,
        ))
    }
    cmds.push(DrawCmd.clip_pop)
}

fn collect_floating_row_decors(raw_spans: Any, target_row: i64) -> List {
    let out = List()
    if not (raw_spans matches _: List) {
        return out
    }
    let lst = raw_spans.as(List)
    if lst.is_empty() {
        return out
    }
    -- Support both flat `List` of `InlineSpanDecor` (filtering `dec.row == target_row`)
    -- and per-row `List` of `List` of `InlineSpanDecor`.
    let first = lst.get(0)
    if first matches _: InlineSpanDecor {
        for i in 0..lst.len() {
            let item = lst.get(i.as(usize))
            if item matches _: InlineSpanDecor {
                let dec = item.as(InlineSpanDecor)
                if dec.row == target_row and dec.end_col > dec.start_col {
                    out.push(dec)
                }
            }
        }
    } else if target_row >= 0 and target_row < lst.len() {
        let row_entry = lst.get(target_row.as(usize))
        if row_entry matches _: List {
            let sub = row_entry.as(List)
            for j in 0..sub.len() {
                let item = sub.get(j.as(usize))
                if item matches _: InlineSpanDecor {
                    let dec = item.as(InlineSpanDecor)
                    if dec.end_col > dec.start_col {
                        out.push(dec)
                    }
                }
            }
        }
    }
    out
}

fn render_floating_row_with_spans(
    cmds: List,
    txt: String,
    row_decors: List,
    base_x: f64,
    y: f64,
    max_chars: i64,
    tabstop: i64,
    cell_w: f64,
    cell_h: f64,
    font_fam: String,
    font_sz: f64,
    theme: ThemePalette,
    _is_sel: bool,
) {
    if row_decors.is_empty() {
        if txt != "" {
            let (exp_txt, _) = expand_tabs_from_col(txt, 0, tabstop)
            cmds.push(DrawCmd.text_run(base_x, y, exp_txt, font_fam, font_sz, theme.fg, false, false, false))
        }
        return
    }

    -- 1. Background `bg_rgba` highlight rectangles using visual display columns
    for di in 0..row_decors.len() {
        let dec = row_decors.get(di.as(usize)).as(InlineSpanDecor)
        if dec.bg_rgba != 0 {
            let s_col = if dec.start_col < 0 { 0 } else { dec.start_col }
            let e_col = if dec.end_col > max_chars { max_chars } else { dec.end_col }
            if e_col > s_col {
                let vs = char_col_to_visual_col(txt, s_col, tabstop)
                let ve = char_col_to_visual_col(txt, e_col, tabstop)
                if ve > vs and vs < max_chars {
                    let ce = if ve > max_chars { max_chars } else { ve }
                    let rx = base_x + vs.as(f64) * cell_w
                    let rw = (ce - vs).as(f64) * cell_w
                    cmds.push(DrawCmd.fill_rect(rx, y, rw, cell_h, dec.bg_rgba, 2.0))
                }
            }
        }
    }

    -- 2. Foreground `fg_rgba` + underline segmented `TextRun`s positioned by visual display columns
    let n = txt.char_len()
    if n == 0 {
        return
    }
    var cur_vcol: i64 = 0
    var run_start: i64 = 0
    var cur_fg: i64 = theme.fg
    var cur_ul: bool = false

    for c in 0..n {
        var fg = theme.fg
        var ul = false
        for di in 0..row_decors.len() {
            let dec = row_decors.get(di.as(usize)).as(InlineSpanDecor)
            if c >= dec.start_col and c < dec.end_col {
                if dec.fg_rgba != 0 {
                    fg = dec.fg_rgba
                }
                if dec.underline {
                    ul = true
                }
            }
        }
        if c == 0 {
            cur_fg = fg
            cur_ul = ul
        } else if fg != cur_fg or ul != cur_ul {
            let seg = txt.slice(run_start, c)
            let (exp_seg, next_vcol) = expand_tabs_from_col(seg, cur_vcol, tabstop)
            let sx = base_x + cur_vcol.as(f64) * cell_w
            cmds.push(DrawCmd.text_run(sx, y, exp_seg, font_fam, font_sz, cur_fg, false, false, cur_ul))
            cur_vcol = next_vcol
            run_start = c
            cur_fg = fg
            cur_ul = ul
        }
    }
    let tail = txt.slice(run_start, n)
    if tail != "" {
        let (exp_tail, _) = expand_tabs_from_col(tail, cur_vcol, tabstop)
        let sx = base_x + cur_vcol.as(f64) * cell_w
        cmds.push(DrawCmd.text_run(sx, y, exp_tail, font_fam, font_sz, cur_fg, false, false, cur_ul))
    }
}

fn floating_cursor_anchor_xy(
    world: EditorWorld,
    wm: WindowManager,
    win_w: f64,
    echo_y: f64,
    box_w: f64,
    box_h: f64,
    cell_w: f64,
    cell_h: f64,
) -> (f64, f64) {
    let pane = wm.active_pane()
    let buf = world.active_buffer()
    let r = pane.rect
    let gw = compute_gutter_width(buf, world.options, wm.metrics)
    let ts = safe_tabstop(world.options)
    let cur_line = buf.line_at(pane.cursor.row)
    let cur_vcol = char_col_to_visual_col(cur_line, pane.cursor.col, ts) - pane.left_col
    let cx = r.x + gw + (if cur_vcol > 0 { cur_vcol } else { 0 }).as(f64) * cell_w
    let vis = visible_buffer_rows(buf, pane.top_row, wm.pane_rows(pane))
    var s_idx: i64 = 0
    for i in 0..vis.len() {
        if vis.get(i.as(usize)).as(i64) == pane.cursor.row {
            s_idx = i
            break
        }
    }
    let cy = r.y + s_idx.as(f64) * cell_h
    var bx = cx.floor()
    if bx + box_w > win_w - 12.0 {
        bx = (win_w - box_w - 12.0).floor()
    }
    if bx < 12.0 {
        bx = 12.0
    }
    let top_h = top_bar_height(world)
    let below_y = (cy + cell_h + 4.0).floor()
    let above_y = (cy - box_h - 4.0).floor()
    let by = if below_y + box_h <= echo_y - 6.0 {
        below_y
    } else if above_y >= top_h + 4.0 {
        above_y
    } else {
        below_y
    }
    (bx, by)
}

fn render_floating_windows(
    cmds: List,
    world: EditorWorld,
    wm: WindowManager,
    theme: ThemePalette,
    win_w: f64,
    win_h: f64,
    echo_y: f64,
) {
    if world.floating_windows.is_empty() {
        return
    }
    let cell_w = wm.metrics.cell_width
    let cell_h = wm.metrics.cell_height
    let font_fam = world.options.font_family
    let font_sz = world.options.font_size_pt
    let tabstop = safe_tabstop(world.options)
    let active_buf = world.active_buffer()

    for fi in 0..world.floating_windows.len() {
        let fw = world.floating_windows.get(fi.as(usize)).as(FloatingWindow)
        let raw_w = (fw.width_cols.as(f64) * cell_w + 20.0).floor()
        let raw_h = ((fw.height_rows + 1).as(f64) * cell_h + 14.0).floor()
        let max_avail_h = echo_y - top_bar_height(world) - 16.0
        let (box_x, box_y, box_w, box_h) = if fw.anchor == "left" or fw.anchor == "right" {
            let top_y = top_bar_height(world) + 12.0
            let avail_h = if echo_y - top_y - 12.0 > cell_h * 6.0 {
                echo_y - top_y - 12.0
            } else {
                cell_h * 6.0
            }
            if win_w >= 900.0 {
                let margin_x = 24.0
                let gap = 12.0
                let total_w = win_w - margin_x * 2.0 - gap
                let left_w = (total_w * 0.46).floor()
                let right_w = total_w - left_w
                let pane_h = (avail_h * 0.88).floor()
                let pane_y = top_y + ((avail_h - pane_h) * 0.45).floor()
                if fw.anchor == "left" {
                    (margin_x, pane_y, left_w, pane_h)
                } else {
                    (margin_x + left_w + gap, pane_y, right_w, pane_h)
                }
            } else {
                let margin_x = 12.0
                let gap = 8.0
                let pane_w = win_w - margin_x * 2.0
                let top_h = ((avail_h - gap) * 0.48).floor()
                let bot_h = avail_h - gap - top_h
                if fw.anchor == "left" {
                    (margin_x, top_y, pane_w, top_h)
                } else {
                    (margin_x, top_y + top_h + gap, pane_w, bot_h)
                }
            }
        } else {
            let bw = if raw_w > win_w - 24.0 { win_w - 24.0 } else if raw_w < 160.0 { 160.0 } else { raw_w }
            let bh = if raw_h > max_avail_h { max_avail_h } else if raw_h < cell_h * 3.0 { cell_h * 3.0 } else { raw_h }
            let (bx, by) = if fw.anchor == "cursor" {
                floating_cursor_anchor_xy(world, wm, win_w, echo_y, bw, bh, cell_w, cell_h)
            } else if fw.anchor == "bottom" {
                (16.0, echo_y - bh - 8.0)
            } else {
                (((win_w - bw) * 0.5).floor(), ((win_h - bh) * 0.45).floor())
            }
            (bx, by, bw, bh)
        }
        let bcol = if fw.border_rgba != 0 { fw.border_rgba } else { theme.accent }

        cmds.push(DrawCmd.clip_push(box_x, box_y, box_w, box_h))
        cmds.push(DrawCmd.fill_rect(box_x, box_y, box_w, box_h, theme.bg_popup, 6.0))
        cmds.push(DrawCmd.stroke_rect(box_x, box_y, box_w, box_h, bcol, 1.5, 6.0))
        cmds.push(DrawCmd.text_run(box_x + 10.0, box_y + 4.0, fw.title, font_fam, font_sz, bcol, false, false, false))
        cmds.push(DrawCmd.line(box_x + 6.0, box_y + cell_h + 6.0, box_x + box_w - 6.0, box_y + cell_h + 6.0, theme.border, 1.0))

        let max_rows = (((box_h - cell_h - 12.0) / cell_h).floor().as(i64))
        let max_chars = (((box_w - 20.0) / cell_w).floor().as(i64))
        let has_spans = world.floating_window_spans.contains_key(fw.id)
        let has_cursor = world.floating_window_cursor.contains_key(fw.id)
        let spans_raw: Any = if has_spans { world.floating_window_spans.get(fw.id) } else { () }
        let is_md_float = (not has_spans)
            and (not has_cursor)
            and (fw.id == "lsp_hover" or fw.owner == "ext_lsp" or fw.id == "treesitter_inspect")

        if is_md_float {
            let md_rows = List()
            var in_f = false
            var f_ch = '`'
            var f_len: i64 = 3
            var f_lang = active_buf.major_mode
            for ri in 0..fw.lines.len() {
                if md_rows.len() >= max_rows {
                    break
                }
                let rln = fw.lines.get(ri.as(usize)).as(String)
                let tr = rln.trim()
                if not in_f {
                    let fo = parse_markdown_fence_open(tr)
                    if fo != null {
                        let (fc, fl, inf) = fo.as((char, i64, String))
                        f_ch = fc
                        f_len = fl
                        let cm = canonical_fence_mode(inf)
                        f_lang = if cm != "" { cm } else { active_buf.major_mode }
                        in_f = true
                        continue
                    }
                } else if is_markdown_fence_close(tr, f_ch, f_len) {
                    in_f = false
                    continue
                }
                md_rows.push((rln, in_f, f_lang))
            }
            for li in 0..md_rows.len() {
                let ly = box_y + cell_h + 9.0 + li.as(f64) * cell_h
                let (raw_r, in_code, clang) = md_rows.get(li.as(usize)).as((String, bool, String))
                let (exp_r, _) = expand_tabs_from_col(raw_r, 0, tabstop)
                if in_code {
                    cmds.push(DrawCmd.fill_rect(box_x + 6.0, ly, box_w - 12.0, cell_h, theme.bg_alt, 2.0))
                    emit_popup_code_line(cmds, exp_r, clang, box_x + 10.0, ly, max_chars, cell_w, font_fam, font_sz, theme)
                } else if exp_r.trim() == "---" or exp_r.trim().starts_with("────") {
                    cmds.push(DrawCmd.line(box_x + 10.0, ly + cell_h * 0.5, box_x + box_w - 10.0, ly + cell_h * 0.5, theme.border, 1.0))
                } else {
                    emit_popup_code_line(cmds, exp_r, "markdown", box_x + 10.0, ly, max_chars, cell_w, font_fam, font_sz, theme)
                }
            }
        } else {
            let total = fw.lines.len()
            let count = if total > max_rows { max_rows } else { total }
            for li in 0..count {
                let ly = box_y + cell_h + 9.0 + li.as(f64) * cell_h
                let is_sel = li == fw.selected_row
                if is_sel and (not has_cursor) {
                    cmds.push(DrawCmd.fill_rect(box_x + 6.0, ly, box_w - 12.0, cell_h, theme.bg_selection, 3.0))
                } else if is_sel and has_cursor {
                    cmds.push(DrawCmd.fill_rect(box_x + 6.0, ly, box_w - 12.0, cell_h, theme.bg_cursor_line, 3.0))
                }
                let raw_row_s = fw.lines.get(li.as(usize)).as(String)
                if has_spans {
                    let txt = clip_str(raw_row_s, max_chars)
                    let row_decors = collect_floating_row_decors(spans_raw, li)
                    render_floating_row_with_spans(
                        cmds, txt, row_decors, box_x + 10.0, ly, max_chars, tabstop,
                        cell_w, cell_h, font_fam, font_sz, theme, is_sel and (not has_cursor),
                    )
                } else {
                    let (exp_txt, _) = expand_tabs_from_col(raw_row_s, 0, tabstop)
                    let clipped_exp = clip_str(exp_txt, max_chars)
                    cmds.push(DrawCmd.text_run(box_x + 10.0, ly, clipped_exp, font_fam, font_sz, theme.fg, false, false, false))
                }
            }
        }

        if has_cursor {
            let cval = world.floating_window_cursor.get(fw.id)
            if cval matches _: Pos {
                let cpos = cval.as(Pos)
                let crow = if cpos.row < 0 {
                    0
                } else if max_rows > 0 and cpos.row >= max_rows {
                    max_rows - 1
                } else {
                    cpos.row
                }
                let crow_txt = if crow >= 0 and crow < fw.lines.len() {
                    fw.lines.get(crow.as(usize)).as(String)
                } else {
                    ""
                }
                let raw_vcol = char_col_to_visual_col(crow_txt, if cpos.col < 0 { 0 } else { cpos.col }, tabstop)
                let cvcol = if max_chars > 0 and raw_vcol > max_chars { max_chars } else { raw_vcol }
                let c_cells = if cpos.col >= 0 and cpos.col < crow_txt.char_len() {
                    let cw = char_display_width(crow_txt.slice(cpos.col, cpos.col + 1))
                    if cw > 1 { cw } else { 1 }
                } else {
                    1
                }
                let cx = box_x + 10.0 + cvcol.as(f64) * cell_w
                let cy = box_y + cell_h + 9.0 + crow.as(f64) * cell_h
                cmds.push(DrawCmd.cursor_caret(cx, cy, c_cells.as(f64) * cell_w, cell_h, CaretShape.block, theme.accent))
            }
        }

        cmds.push(DrawCmd.clip_pop)
    }
}

fn render_toast_notifications(
    cmds: List,
    world: EditorWorld,
    wm: WindowManager,
    theme: ThemePalette,
    win_w: f64,
) {
    if world.notifications.is_empty() {
        return
    }
    let cell_w = wm.metrics.cell_width
    let cell_h = wm.metrics.cell_height
    let font_fam = world.options.font_family
    let font_sz = world.options.font_size_pt

    let card_w = if 44.0 * cell_w < win_w - 20.0 { 44.0 * cell_w } else { win_w - 20.0 }
    let card_h = cell_h * 2.0 + 10.0
    var cur_y = top_bar_height(world) + 8.0
    let x = win_w - card_w - 12.0

    for ni in 0..world.notifications.len() {
        let t = world.notifications.get(ni.as(usize)).as(ToastNotification)
        let bcol = when {
            t.level == "error" => theme.diag_err,
            t.level == "warn" => theme.diag_warn,
            else => theme.accent,
        }
        let max_chars = (((card_w - 20.0) / cell_w).floor().as(i64))
        cmds.push(DrawCmd.clip_push(x, cur_y, card_w, card_h))
        cmds.push(DrawCmd.fill_rect(x, cur_y, card_w, card_h, theme.bg_popup, 5.0))
        cmds.push(DrawCmd.stroke_rect(x, cur_y, card_w, card_h, bcol, 1.2, 5.0))
        cmds.push(DrawCmd.text_run(x + 10.0, cur_y + 3.0, clip_str(t.title, max_chars), font_fam, font_sz, bcol, false, false, false))
        cmds.push(DrawCmd.text_run(x + 10.0, cur_y + 5.0 + cell_h, clip_str(t.message, max_chars), font_fam, font_sz, theme.fg, false, false, false))
        cmds.push(DrawCmd.clip_pop)
        cur_y += card_h + 6.0
    }
}

fn format_transfer_bytes(bytes: i64) -> String {
    if bytes <= 0 {
        return "0 B"
    }
    if bytes < 1024 {
        return bytes.to_string() ++ " B"
    }
    if bytes < 1048576 {
        let kb = bytes / 1024
        return kb.to_string() ++ " KiB"
    }
    let tenths = (bytes * 10) / 1048576
    (tenths / 10).to_string() ++ "." ++ (tenths % 10).to_string() ++ " MiB"
}

fn render_transfer_progress_bar(
    cmds: List,
    world: EditorWorld,
    wm: WindowManager,
    theme: ThemePalette,
    win_w: f64,
    echo_y: f64,
) {
    let tp = world.transfer_progress
    if not tp.active {
        return
    }
    let cell_w = wm.metrics.cell_width
    let cell_h = wm.metrics.cell_height
    let font_fam = world.options.font_family
    let font_sz = world.options.font_size_pt
    let card_w = if win_w * 0.44 < 440.0 { 440.0 } else { win_w * 0.44 }
    let clamped_w = if card_w > win_w - 24.0 { win_w - 24.0 } else { card_w }
    if clamped_w < 120.0 {
        return
    }
    let card_h = cell_h * 2.0 + 18.0
    let x = ((win_w - clamped_w) * 0.5).floor()
    let y = (echo_y - card_h - 12.0).floor()
    if y < 8.0 {
        return
    }
    let transport_lbl = if tp.transport != "" { "[" ++ tp.transport ++ "] " } else { "[SSH] " }
    let pct = if tp.bytes_total > 0 {
        let raw_pct = (tp.bytes_done * 100) / tp.bytes_total
        if raw_pct < 0 { 0 } else if raw_pct > 100 { 100 } else { raw_pct }
    } else {
        100
    }
    let lines_lbl = if tp.lines_loaded > 0 {
        " · " ++ tp.lines_loaded.to_string() ++ " lines"
    } else {
        ""
    }
    let stats_txt = pct.to_string() ++ "% ("
        ++ format_transfer_bytes(tp.bytes_done) ++ " / "
        ++ format_transfer_bytes(tp.bytes_total) ++ ")" ++ lines_lbl
    let max_chars = (((clamped_w - 24.0) / cell_w).floor().as(i64))
    let header_txt = clip_str(transport_lbl ++ tp.title ++ "  " ++ stats_txt, max_chars)

    cmds.push(DrawCmd.clip_push(x, y, clamped_w, card_h))
    cmds.push(DrawCmd.fill_rect(x, y, clamped_w, card_h, theme.bg_popup, 6.0))
    cmds.push(DrawCmd.stroke_rect(x, y, clamped_w, card_h, theme.accent, 1.2, 6.0))
    cmds.push(DrawCmd.text_run(x + 12.0, y + 4.0, header_txt, font_fam, font_sz, theme.fg, false, false, false))

    let bar_x = x + 12.0
    let bar_y = y + cell_h + 10.0
    let bar_w = clamped_w - 24.0
    let bar_h = 6.0
    cmds.push(DrawCmd.fill_rect(bar_x, bar_y, bar_w, bar_h, theme.bg_alt, 3.0))
    let fill_ratio = (pct.as(f64)) / 100.0
    let fill_w = (bar_w * fill_ratio).floor()
    if fill_w > 1.0 {
        cmds.push(DrawCmd.fill_rect(bar_x, bar_y, fill_w, bar_h, theme.accent, 3.0))
    }
    cmds.push(DrawCmd.clip_pop)
}

pub fn compose_frame(
    kernel: SystemKernel,
    world: EditorWorld,
    wm: WindowManager,
) -> (WindowSpec, List) {
    wm.sync_from_world(world)

    let theme = theme_by_name(world.options.theme_name)
    let win_w = if wm.pixel_width > 80 { wm.pixel_width.as(f64) } else { 80.0 }
    let win_h = if wm.pixel_height > 80 { wm.pixel_height.as(f64) } else { 80.0 }
    let echo_y = win_h - ECHO_BAR_HEIGHT
    let top_bar_h = top_bar_height(world)
    let ws_h = if echo_y - top_bar_h > 40.0 { echo_y - top_bar_h } else { 40.0 }
    let abuf = world.active_buffer()
    let win_title = "Lava — " ++ abuf.name ++ (if abuf.modified { " [+]" } else { "" })

    let spec = WindowSpec {
        title: win_title,
        width: wm.pixel_width,
        height: wm.pixel_height,
        bg_rgba: theme.bg,
        pointer: PointerHint.default,
        decorated: world.options.window_decorations,
    }

    let cmds = List()
    cmds.push(DrawCmd.fill_rect(0.0, 0.0, win_w, win_h, theme.bg, 0.0))

    -- 1. Optional Top Tab / Buffer Header Bar (closed by default; vertical `ext_tablist` replaces it)
    if world.options.show_tab_bar {
        render_top_tab_bar(cmds, world, wm, theme, win_w)
    }

    -- 1b. Docked Left & Right Sidebars (`ext_neotree`, `ext_tablist`, `ext_aerial`, etc.)
    if world.left_sidebar.visible {
        let lw = (world.left_sidebar.width_cols.as(f64) * wm.metrics.cell_width + 12.0).floor()
        render_sidebar_panel(cmds, world.left_sidebar, world, wm, theme, 0.0, top_bar_h, lw, ws_h, true)
    }
    if world.right_sidebar.visible {
        let rw = (world.right_sidebar.width_cols.as(f64) * wm.metrics.cell_width + 12.0).floor()
        render_sidebar_panel(cmds, world.right_sidebar, world, wm, theme, win_w - rw, top_bar_h, rw, ws_h, false)
    }

    -- 2. All Visible Split Window Panes
    let vis = wm.visible_panes()
    let focused_id = wm.active_tab().active_win_id
    for i in 0..vis.len() {
        let pane = vis.get(i.as(usize)).as(WindowPane)
        render_window_pane(cmds, kernel, world, wm, pane, pane.id == focused_id, theme)
    }

    -- 2b. Cursor-anchored Signature Help + Completion Popup + Doc Window (`ext_cmp`) + Floating Windows
    render_signature_help_popup(cmds, world, wm, theme, win_w, echo_y)
    render_buffer_completion_popup(cmds, world, wm, theme, win_w, echo_y)
    render_floating_windows(cmds, world, wm, theme, win_w, win_h, echo_y)

    -- 3. Floating Which-Key Overlay (above echo bar when prefix chord active)
    render_which_key_overlay(cmds, world, wm, theme, win_w, echo_y)

    -- 4. Bottom Echo Bar / Interactive Minibuffer + Completion Popup
    render_echo_or_minibuffer(cmds, world, wm, theme, win_w, echo_y)

    -- 5. Top-Right Toast Notifications (`ext_noice`) + Remote Transfer Progress Bar
    render_toast_notifications(cmds, world, wm, theme, win_w)
    render_transfer_progress_bar(cmds, world, wm, theme, win_w, echo_y)

    (spec, cmds)
}

-- ============================================================================
-- 5. Extension Registration & Service Lookup
-- ============================================================================

pub fn require_renderer(kernel: SystemKernel) -> !String RenderCompositor {
    let raw = kernel.require_service(SERVICE_RENDERER)!
    raw.as(RenderCompositor)
}

pub fn register_render_extension(kernel: SystemKernel) -> !String Unit {
    let ext_id = ext_render_id()
    kernel.register_extension(
        ext_id,
        "lava.org",
        "ext_render",
        "0.1.0",
        "Color theme palettes, multi-language lexical syntax highlighter, and 2D DrawCmd scene compositor.",
        [ext_document_id(), ext_window_id()],
        |k: SystemKernel| -> !String Unit {
            let w = require_editor_world(k)!
            let rc = RenderCompositor.new()
            rc.active_theme_name = w.options.theme_name
            k.publish_service(SERVICE_RENDERER, ext_id, rc)

            k.register_command(
                "set-theme",
                ext_id,
                "Switch active color theme (`catppuccin-mocha`, `gruvbox-dark`, `one-dark`, `solarized-light`).",
                |kern: SystemKernel, args: List| -> #InteractiveEffects !String Any {
                    let world = require_editor_world(kern)!
                    let comp = require_renderer(kern)!
                    var target_name = if not args.is_empty() { args.get(0).as(String) } else { "" }
                    if target_name == "" {
                        let ans? = ask_prompt(PromptRequest.with_candidates(
                            "Color theme: ",
                            "",
                            PromptKind.choice,
                            builtin_theme_names(),
                        ))# else {
                            status_emit("Cancelled")#
                            return ()
                        }
                        target_name = ans.trim()
                    }
                    let palette = comp.set_theme(target_name, world)!
                    log_event("info", "ext_render", "Switched theme to " ++ palette.name)#
                    status_emit("Theme: " ++ palette.name)#
                    ()
                },
            )

            k.register_command(
                "cycle-theme",
                ext_id,
                "Cycle through built-in Lava color themes.",
                |kern: SystemKernel, _args: List| -> #InteractiveEffects !String Any {
                    let world = require_editor_world(kern)!
                    let comp = require_renderer(kern)!
                    let palette = comp.cycle_theme(world)
                    log_event("info", "ext_render", "Cycled theme to " ++ palette.name)#
                    status_emit("Theme: " ++ palette.name)#
                    ()
                },
            )

            ()
        },
        |_k: SystemKernel| -> !String Unit { () },
    )
}
