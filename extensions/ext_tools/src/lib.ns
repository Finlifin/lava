-- ext_tools: Emacs Power Tools Extension for Lava (Principles 1, 3, 4, 5, 6).
-- Provides Emacs Dired (`C-x d`, `:Ex`, `-`), `occur`, concurrent multi-shard
-- `project-search` via Nessa `async effect` + `Future(T)` + `.await`, non-blocking
-- OS background `grep` / `async-shell-command` / `compile` + Quickfix (`next-error` /
-- `previous-error`), Org-Outline folding & TODO state cycling, and live `*scratch*`
-- Single-VM expression & kernel introspection evaluator.

use std.collections.{HashMap, Set}
use std.fs
use std.path
use std.process

use @lava_sys.{host_cancel_job, host_spawn_job}
use @lava_core.{
    CommandSpec, ExtId, ExtState, ExtensionRecord, InteractiveEffects, KeyStroke, PromptKind,
    PromptRequest, PromptTurn, ServiceEffects, SystemKernel, ask_prompt, clipboard_get,
    clipboard_set, log_event, status_emit
}
use @ext_document.{
    ActiveBgJob, Buffer, BufferId, BufferKind, EditorWorld, Pos, QuickfixEntry,
    ext_document_id, parse_quickfix_line, require_editor_world
}

pub const SERVICE_TOOLS: String = "lava.tools.manager"
pub const DIRED_HEADER_ROWS: i64 = 2
pub const DIRED_NAME_COL: i64 = 23

pub fn ext_tools_id() -> ExtId = ExtId("lava.org/ext_tools")

-- ============================================================================
-- 1. Concurrent Project Search via Nessa `async effect` + `Future(T)` + `.await`
-- ============================================================================

pub async effect scan_file_shard(files: List, pattern: String, ignore_case: bool) -> List

pub fn scan_shard_sync(files: List, pattern: String, ignore_case: bool) -> List {
    let results = List()
    if pattern == "" {
        return results
    }
    let needle = if ignore_case { pattern.to_lower() } else { pattern }
    let n_files = files.len()
    for i in 0..n_files {
        let full_path = files.get(i.as(usize)).as(String)
        let raw! = fs.read_to_string(full_path) else {
            continue
        }
        if raw.contains("\x00") {
            continue
        }
        var r: i64 = 0
        for line in raw.lines_iter() {
            let hay = if ignore_case { line.to_lower() } else { line }
            let col_opt = hay.find(needle)
            if col_opt != null {
                let col_idx = col_opt.as(i64)
                results.push(QuickfixEntry {
                    file_path: full_path,
                    row: r,
                    col: col_idx,
                    text: line,
                })
            }
            r += 1
        }
    }
    results
}

pub fn parallel_project_scan(
    shards: List,
    pattern: String,
    ignore_case: bool,
) -> #scan_file_shard List {
    let futures = List()
    for i in 0..shards.len() {
        let f: Future(List) = scan_file_shard(
            shards.get(i.as(usize)).as(List),
            pattern,
            ignore_case,
        )#
        futures.push(f)
    }
    let combined = List()
    for i in 0..futures.len() {
        let part = futures.get(i.as(usize)).as(Future(List)).await
        for j in 0..part.len() {
            combined.push(part.get(j.as(usize)))
        }
    }
    combined
}

private fn should_skip_walk_dir(dir_name: String) -> bool {
    dir_name == ".git"
        or dir_name == "target"
        or dir_name == "node_modules"
        or dir_name == "__pycache__"
}

private fn walk_dir_recursive(cur_dir: String, out: List, depth: i64) {
    if depth > 24 or out.len() >= 10000 {
        return
    }
    let entries! = fs.read_dir_entries(cur_dir) else {
        return
    }
    entries.sort_by(|a: Any, b: Any| {
        a.as(fs.DirEntry).name.cmp(b.as(fs.DirEntry).name)
    })
    for entry_any in entries.iter() {
        let entry = entry_any.as(fs.DirEntry)
        let name = entry.name
        if name == "" or name == "." or name == ".." {
            continue
        }
        let full = entry.path
        let is_sym = entry.is_symlink()
        if entry.is_dir() or (is_sym and fs.is_dir(full)) {
            if not should_skip_walk_dir(name) {
                walk_dir_recursive(full, out, depth + 1)
            }
        } else if entry.is_file() or (is_sym and fs.is_file(full)) {
            out.push(full)
        }
    }
}

pub fn collect_workspace_files(root_dir: String) -> List {
    let files = List()
    if root_dir == "" or (not fs.exists(root_dir)) {
        return files
    }
    if fs.is_file(root_dir) {
        files.push(root_dir)
        return files
    }
    walk_dir_recursive(root_dir, files, 0)
    files
}

private fn partition_into_four_shards(files: List) -> List {
    let shards = List()
    let total = files.len()
    let shard_count: i64 = 4
    var start_idx: i64 = 0
    for s in 0..shard_count {
        let remaining_items = total - start_idx
        let remaining_shards = shard_count - s
        let take_n = if remaining_items <= 0 {
            0
        } else {
            (remaining_items + remaining_shards - 1) / remaining_shards
        }
        let bucket = List()
        for k in 0..take_n {
            bucket.push(files.get((start_idx + k).as(usize)))
        }
        start_idx += take_n
        shards.push(bucket)
    }
    shards
}

-- ============================================================================
-- 2. ToolsManager Service & State Models
-- ============================================================================

pub struct DiredEntry {
    pub name: String,
    pub full_path: String,
    pub is_dir: bool,
    pub is_symlink: bool,
    pub size: i64,
    pub mark_flag: String,
    pub line_row: i64,
}

pub struct DiredState {
    pub buf_id: BufferId,
    pub dir_path: String,
    pub entries: List,
}

pub struct BgJobMeta {
    pub job_id: i64,
    pub kind: String,
    pub command: String,
    pub cwd: String,
    pub title: String,
    pub target_buffer: String,
}

pub struct ToolsManager {
    pub dired_states: HashMap,
    pub jobs: HashMap,
    pub qf_row_map: HashMap,
    pub qf_visited_current: bool,
    pub last_compile_cmd: String,
    pub last_shell_cmd: String,
    pub pending_prefix: String,
    pub scratch_env: HashMap,
}

impl ToolsManager {
    pub fn new() -> ToolsManager {
        ToolsManager {
            dired_states: HashMap.new(),
            jobs: HashMap.new(),
            qf_row_map: HashMap.new(),
            qf_visited_current: false,
            last_compile_cmd: "nessa check .",
            last_shell_cmd: "",
            pending_prefix: "",
            scratch_env: HashMap.new(),
        }
    }

    pub fn clear_qf_rows_for_buffer(self, buf_id: BufferId) {
        let prefix = buf_id.raw().to_string() ++ ":"
        let keys = self.qf_row_map.keys()
        let n = keys.len()
        for i in 0..n {
            let k = keys.get(i.as(usize)).as(String)
            if k.starts_with(prefix) {
                let _ = self.qf_row_map.remove(k)
            }
        }
    }

    pub fn bind_qf_row(self, buf_id: BufferId, row: i64, qf_idx: i64) {
        let k = buf_id.raw().to_string() ++ ":" ++ row.to_string()
        self.qf_row_map.insert(k, qf_idx)
    }

    pub fn lookup_qf_row(self, buf_id: BufferId, row: i64) -> ?i64 {
        let k = buf_id.raw().to_string() ++ ":" ++ row.to_string()
        let v? = self.qf_row_map.get(k) else {
            return null
        }
        v.as(i64)
    }
}

pub fn require_tools_manager(kernel: SystemKernel) -> !String ToolsManager {
    let raw = kernel.require_service(SERVICE_TOOLS)!
    raw.as(ToolsManager)
}

pub fn tools_dispatch_command(
    kernel: SystemKernel,
    name: String,
    args: List,
) -> #[log_event, status_emit, clipboard_get, clipboard_set] !String PromptTurn {
    kernel.dispatch_command(name, args)#
}

pub fn tools_submit_prompt_answer(
    kernel: SystemKernel,
    answer: ?String,
) -> #[log_event, status_emit, clipboard_get, clipboard_set] !String PromptTurn {
    kernel.submit_prompt_answer(answer)#
}

-- ============================================================================
-- 3. Emacs Dired (`dired`, marks, file operations, navigation)
-- ============================================================================

pub fn format_human_size(bytes: i64) -> String {
    if bytes < 0 {
        return "0B"
    }
    if bytes < 1024 {
        return bytes.to_string() ++ "B"
    }
    if bytes < 1048576 {
        let tenths = (bytes * 10) / 1024
        return (tenths / 10).to_string() ++ "." ++ (tenths % 10).to_string() ++ "K"
    }
    if bytes < 1073741824 {
        let tenths = (bytes * 10) / 1048576
        return (tenths / 10).to_string() ++ "." ++ (tenths % 10).to_string() ++ "M"
    }
    let tenths = (bytes * 10) / 1073741824
    (tenths / 10).to_string() ++ "." ++ (tenths % 10).to_string() ++ "G"
}

private fn render_dired_entry_line(entry: DiredEntry) -> String {
    let flag = if entry.mark_flag == "" { " " } else { entry.mark_flag.take(1) }
    let perms = if entry.is_dir {
        "drwxr-xr-x"
    } else if entry.is_symlink {
        "lrwxrwxrwx"
    } else {
        "-rw-r--r--"
    }
    let size_text = if entry.name == ".." {
        "<UP>".pad_start(8, " ")
    } else {
        format_human_size(entry.size).pad_start(8, " ")
    }
    let disp_name = if entry.name == ".." {
        ".."
    } else if entry.is_dir {
        entry.name ++ "/"
    } else {
        entry.name
    }
    flag ++ " " ++ perms ++ " " ++ size_text ++ "  " ++ disp_name
}

private fn build_dired_listing(dir_path: String, preserved_marks: HashMap) -> !String (List, List) {
    let dir_iter! = fs.iter_dir(dir_path) else {
        return error ("cannot read directory: " ++ dir_path)
    }
    let parent_opt = path.parent(dir_path)
    let parent_dir = if parent_opt != null { parent_opt.as(String) } else { dir_path }

    let subdirs = List()
    let reg_files = List()
    for de in dir_iter {
        let nm = de.name
        if nm == "" or nm == "." or nm == ".." {
            continue
        }
        let full = path.join(dir_path, nm)
        let is_sym = de.is_symlink()
        let is_d = de.is_dir() or (is_sym and fs.is_dir(full))
        let sz = de.size
        let prev_mark_opt = preserved_marks.get(full)
        let mflag = if prev_mark_opt != null { prev_mark_opt.as(String) } else { " " }
        let item = DiredEntry {
            name: nm,
            full_path: full,
            is_dir: is_d,
            is_symlink: is_sym,
            size: sz,
            mark_flag: mflag,
            line_row: 0,
        }
        if is_d {
            subdirs.push(item)
        } else {
            reg_files.push(item)
        }
    }
    subdirs.sort_by(|a: Any, b: Any| {
        a.as(DiredEntry).name.cmp(b.as(DiredEntry).name)
    })
    reg_files.sort_by(|a: Any, b: Any| {
        a.as(DiredEntry).name.cmp(b.as(DiredEntry).name)
    })

    let entries = List()
    let up_entry = DiredEntry {
        name: "..",
        full_path: parent_dir,
        is_dir: true,
        is_symlink: false,
        size: 0,
        mark_flag: " ",
        line_row: DIRED_HEADER_ROWS,
    }
    entries.push(up_entry)

    var row_cursor = DIRED_HEADER_ROWS + 1
    for i in 0..subdirs.len() {
        let d = subdirs.get(i.as(usize)).as(DiredEntry)
        d.line_row = row_cursor
        row_cursor += 1
        entries.push(d)
    }
    for i in 0..reg_files.len() {
        let f = reg_files.get(i.as(usize)).as(DiredEntry)
        f.line_row = row_cursor
        row_cursor += 1
        entries.push(f)
    }

    let lines = List()
    lines.push("  " ++ dir_path ++ ":")
    lines.push(
        "  total " ++ (subdirs.len() + reg_files.len()).to_string() ++ " items ("
        ++ subdirs.len().to_string() ++ " dirs, " ++ reg_files.len().to_string()
        ++ " files)  [RET:open ^:up m:mark d:del u:unmark U:clear x:exec +:mkdir R:rename C:copy g:refresh q:quit]"
    )
    for i in 0..entries.len() {
        let ent = entries.get(i.as(usize)).as(DiredEntry)
        lines.push(render_dired_entry_line(ent))
    }
    (entries, lines)
}

private fn find_dired_buffer_for_dir(world: EditorWorld, dir_path: String) -> ?Buffer {
    let n = world.buffer_order.len()
    for i in 0..n {
        let bid = world.buffer_order.get(i.as(usize)).as(BufferId)
        let b = world.buffers.get(bid).as(Buffer)
        if b.kind == BufferKind.directory and b.file_path == dir_path {
            return b
        }
    }
    null
}

pub fn refresh_dired_buffer(
    kernel: SystemKernel,
    buf_id: BufferId,
    .preserve_marks: bool = true,
    .focus_name: String = "",
) -> !String Unit {
    let world = require_editor_world(kernel)!
    let mgr = require_tools_manager(kernel)!
    let buf? = world.buffer(buf_id) else {
        return error ("unknown dired buffer: " ++ buf_id.to_string())
    }
    let state_opt = mgr.dired_states.get(buf_id)
    let dir_path = if state_opt != null {
        state_opt.as(DiredState).dir_path
    } else if buf.file_path != "" {
        buf.file_path
    } else {
        world.cwd
    }
    let preserved = HashMap.new()
    if preserve_marks and state_opt != null {
        let old_entries = state_opt.as(DiredState).entries
        for i in 0..old_entries.len() {
            let oe = old_entries.get(i.as(usize)).as(DiredEntry)
            if oe.mark_flag != " " and oe.name != ".." {
                preserved.insert(oe.full_path, oe.mark_flag)
            }
        }
    }
    let prev_row = buf.point.row
    let (entries, lines) = build_dired_listing(dir_path, preserved)!
    let new_state = DiredState {
        buf_id: buf.id,
        dir_path: dir_path,
        entries: entries,
    }
    mgr.dired_states.insert(buf.id, new_state)
    buf.vars.insert("dired_dir", dir_path)

    buf.read_only = false
    buf.major_mode = "dired"
    buf.kind = BufferKind.directory
    buf.file_path = dir_path
    buf.set_lines(lines, record_undo = false)
    buf.modified = false
    buf.read_only = true

    var target_row = prev_row
    if focus_name != "" {
        for i in 0..entries.len() {
            let e = entries.get(i.as(usize)).as(DiredEntry)
            if e.name == focus_name {
                target_row = e.line_row
                break
            }
        }
    }
    let max_r = buf.line_count() - 1
    if target_row < DIRED_HEADER_ROWS {
        target_row = if entries.len() > 1 { DIRED_HEADER_ROWS + 1 } else { DIRED_HEADER_ROWS }
    }
    if target_row > max_r {
        target_row = max_r
    }
    buf.point = buf.clamp_pos(Pos.new(target_row, DIRED_NAME_COL), insert_mode = false)
    buf.preferred_col = buf.point.col
    ()
}

pub fn open_dired(
    kernel: SystemKernel,
    raw_path: String,
    .focus_name: String = "",
) -> #[log_event, status_emit] !String Buffer {
    let world = require_editor_world(kernel)!
    let mgr = require_tools_manager(kernel)!

    var resolved = if raw_path.trim() != "" {
        world.resolve_path(raw_path)
    } else {
        let cur_buf = world.active_buffer()
        if cur_buf.file_path != "" {
            if fs.is_dir(cur_buf.file_path) {
                cur_buf.file_path
            } else {
                let p_opt = path.parent(cur_buf.file_path)
                if p_opt != null { p_opt.as(String) } else { world.cwd }
            }
        } else {
            world.cwd
        }
    }

    var target_focus = focus_name
    if fs.exists(resolved) and fs.is_file(resolved) {
        if target_focus == "" {
            let fn_opt = path.file_name(resolved)
            if fn_opt != null {
                target_focus = fn_opt.as(String)
            }
        }
        let p_opt = path.parent(resolved)
        resolved = if p_opt != null { p_opt.as(String) } else { world.cwd }
    }
    if (not fs.exists(resolved)) or (not fs.is_dir(resolved)) {
        return error ("not a directory: " ++ resolved)
    }

    let existing_opt = find_dired_buffer_for_dir(world, resolved)
    if existing_opt != null {
        let b = existing_opt.as(Buffer)
        refresh_dired_buffer(kernel, b.id, preserve_marks = true, focus_name = target_focus)!
        world.active_buffer_id = b.id
        kernel.emit_hook("buffer-switched", b.id)
        status_emit("Dired: " ++ resolved)#
        return b
    }

    let (entries, lines) = build_dired_listing(resolved, HashMap.new())!
    let base_opt = path.file_name(resolved)
    let dir_label = if base_opt != null { base_opt.as(String) } else { resolved }
    let buf = world.create_buffer(
        "*Dired: " ++ dir_label ++ "*",
        BufferKind.directory,
        file_path = resolved,
        major_mode = "dired",
        initial_lines = lines,
    )
    buf.modified = false
    buf.read_only = true
    buf.vars.insert("dired_dir", resolved)
    mgr.dired_states.insert(buf.id, DiredState {
        buf_id: buf.id,
        dir_path: resolved,
        entries: entries,
    })

    var initial_row = if entries.len() > 1 { DIRED_HEADER_ROWS + 1 } else { DIRED_HEADER_ROWS }
    if target_focus != "" {
        for i in 0..entries.len() {
            let e = entries.get(i.as(usize)).as(DiredEntry)
            if e.name == target_focus {
                initial_row = e.line_row
                break
            }
        }
    }
    buf.point = buf.clamp_pos(Pos.new(initial_row, DIRED_NAME_COL), insert_mode = false)
    buf.preferred_col = buf.point.col

    world.active_buffer_id = buf.id
    kernel.emit_hook("buffer-switched", buf.id)
    log_event("info", "ext_tools", "Opened Dired for " ++ resolved)#
    status_emit("Dired: " ++ resolved ++ " (" ++ (entries.len() - 1).to_string() ++ " items)")#
    buf
}

private fn dired_entry_at_row(state: DiredState, row: i64) -> ?DiredEntry {
    let idx = row - DIRED_HEADER_ROWS
    if idx < 0 or idx >= state.entries.len() {
        return null
    }
    state.entries.get(idx.as(usize)).as(DiredEntry)
}

private fn dired_move_row(buf: Buffer, delta: i64) {
    let max_r = buf.line_count() - 1
    if max_r < DIRED_HEADER_ROWS {
        return
    }
    var next_r = buf.point.row + delta
    if next_r < DIRED_HEADER_ROWS {
        next_r = DIRED_HEADER_ROWS
    }
    if next_r > max_r {
        next_r = max_r
    }
    buf.point = buf.clamp_pos(Pos.new(next_r, DIRED_NAME_COL), insert_mode = false)
    buf.preferred_col = buf.point.col
}

private fn dired_set_row_mark(buf: Buffer, state: DiredState, row: i64, flag: String) -> ?DiredEntry {
    let ent? = dired_entry_at_row(state, row) else {
        return null
    }
    if ent.name == ".." and flag != " " {
        return ent
    }
    ent.mark_flag = flag
    buf.read_only = false
    buf.set_line_at(row, render_dired_entry_line(ent))
    buf.modified = false
    buf.read_only = true
    ent
}

private fn dired_marked_or_current_entries(state: DiredState, row: i64) -> List {
    let marked = List()
    for i in 0..state.entries.len() {
        let e = state.entries.get(i.as(usize)).as(DiredEntry)
        if e.mark_flag == "*" and e.name != ".." {
            marked.push(e)
        }
    }
    if not marked.is_empty() {
        return marked
    }
    let cur_opt = dired_entry_at_row(state, row)
    if cur_opt != null {
        let cur = cur_opt.as(DiredEntry)
        if cur.name != ".." {
            marked.push(cur)
        }
    }
    marked
}

private fn resolve_in_dir(base_dir: String, raw: String) -> String {
    let trimmed = raw.trim()
    if trimmed == "" {
        return base_dir
    }
    if path.is_absolute(trimmed) {
        return path.normalize(trimmed)
    }
    path.normalize(path.join(base_dir, trimmed))
}

-- ============================================================================
-- 4. Occur, Concurrent Project Search, Background Grep/Shell/Compile & Quickfix
-- ============================================================================

private fn shell_quote(arg: String) -> String {
    "'" ++ arg.replace("'", "'\"'\"'") ++ "'"
}

private fn wrap_cmd_in_cwd(cmd: String, cwd: String) -> String {
    if cwd.trim() == "" {
        return cmd
    }
    "cd " ++ shell_quote(cwd) ++ " && (" ++ cmd ++ ")"
}

private fn display_rel_path(full_path: String, root_dir: String) -> String {
    if root_dir != "" {
        let prefix = if root_dir.ends_with("/") { root_dir } else { root_dir ++ "/" }
        if full_path.starts_with(prefix) {
            return full_path.drop(prefix.char_len())
        }
    }
    full_path
}

private fn populate_quickfix_buffer(
    world: EditorWorld,
    mgr: ToolsManager,
    buf_name: String,
    major_mode: String,
    header_lines: List,
    qf_entries: List,
    title: String,
    root_dir: String,
) -> Buffer {
    let lines = List()
    for i in 0..header_lines.len() {
        lines.push(header_lines.get(i.as(usize)).as(String))
    }
    let first_entry_row = lines.len()
    for i in 0..qf_entries.len() {
        let e = qf_entries.get(i.as(usize)).as(QuickfixEntry)
        let label = if e.file_path.starts_with("buffer:") {
            e.file_path.drop(7)
        } else {
            display_rel_path(e.file_path, root_dir)
        }
        lines.push(
            label ++ ":" ++ (e.row + 1).to_string() ++ ":" ++ (e.col + 1).to_string()
            ++ ":" ++ e.text
        )
    }
    let b = world.ensure_special_buffer(buf_name, major_mode, lines, read_only = true)
    mgr.clear_qf_rows_for_buffer(b.id)
    for i in 0..qf_entries.len() {
        mgr.bind_qf_row(b.id, first_entry_row + i, i)
    }
    world.quickfix = qf_entries
    world.quickfix_idx = 0
    world.quickfix_title = title
    mgr.qf_visited_current = false

    if not qf_entries.is_empty() {
        b.point = b.clamp_pos(Pos.new(first_entry_row, 0), insert_mode = false)
    } else {
        b.point = Pos.zero()
    }
    b
}

pub fn run_occur(
    kernel: SystemKernel,
    pattern: String,
) -> #[log_event, status_emit] !String i64 {
    let world = require_editor_world(kernel)!
    let mgr = require_tools_manager(kernel)!
    if pattern == "" {
        status_emit("Occur: empty pattern")#
        return 0
    }
    let src = world.active_buffer()
    let ignore_case = world.effective_ignore_case(pattern)
    world.last_search = pattern

    let target_ref = if src.file_path != "" {
        src.file_path
    } else {
        "buffer:" ++ src.name
    }
    let qf_entries = List()
    for r in src.min_row()..(src.max_row() + 1) {
        let hits = src.find_all_in_line(r, pattern, ignore_case)
        if not hits.is_empty() {
            let (first_col, _) = hits.get(0).as((i64, i64))
            qf_entries.push(QuickfixEntry {
                file_path: target_ref,
                row: r,
                col: first_col,
                text: src.line_at(r),
            })
        }
    }

    let headers = [
        qf_entries.len().to_string() ++ " matches for \"" ++ pattern ++ "\" in buffer: " ++ src.name,
        "------------------------------------------------------------",
    ]
    let occur_buf = populate_quickfix_buffer(
        world,
        mgr,
        "*Occur*",
        "grep",
        headers,
        qf_entries,
        "Occur: " ++ pattern,
        world.cwd,
    )
    let _ = world.switch_to_buffer(occur_buf.id)
    kernel.emit_hook("buffer-switched", occur_buf.id)
    status_emit("Occur found " ++ qf_entries.len().to_string() ++ " match(es) in " ++ src.name)#
    qf_entries.len()
}

pub fn run_project_search(
    kernel: SystemKernel,
    pattern: String,
    .root_dir: String = "",
) -> #[log_event, status_emit] !String i64 {
    let world = require_editor_world(kernel)!
    let mgr = require_tools_manager(kernel)!
    if pattern == "" {
        status_emit("Project search: empty pattern")#
        return 0
    }
    let search_root = if root_dir.trim() != "" {
        world.resolve_path(root_dir)
    } else {
        world.cwd
    }
    let ignore_case = world.effective_ignore_case(pattern)
    world.last_search = pattern

    let all_files = collect_workspace_files(search_root)
    let shards = partition_into_four_shards(all_files)
    let qf_entries = parallel_project_scan(shards, pattern, ignore_case) # {
        async scan_file_shard(files, p, ic_flag) => scan_shard_sync(files, p, ic_flag),
    }

    let headers = [
        "-*- mode: grep; default-directory: \"" ++ search_root ++ "\" -*-",
        "Project search (4 async shards, " ++ all_files.len().to_string()
            ++ " files) for \"" ++ pattern ++ "\": " ++ qf_entries.len().to_string() ++ " match(es)",
        "------------------------------------------------------------",
    ]
    let grep_buf = populate_quickfix_buffer(
        world,
        mgr,
        "*Grep*",
        "grep",
        headers,
        qf_entries,
        "Project Search: " ++ pattern,
        search_root,
    )
    let _ = world.switch_to_buffer(grep_buf.id)
    kernel.emit_hook("buffer-switched", grep_buf.id)
    log_event(
        "info",
        "ext_tools",
        "project-search scanned " ++ all_files.len().to_string() ++ " files across 4 futures",
    )#
    status_emit(
        "Project search: " ++ qf_entries.len().to_string()
        ++ " match(es) across " ++ all_files.len().to_string() ++ " files"
    )#
    qf_entries.len()
}

private fn register_bg_job(
    world: EditorWorld,
    mgr: ToolsManager,
    job_id: i64,
    kind: String,
    cmd: String,
    cwd: String,
    title: String,
    target_buffer: String,
) {
    world.active_jobs.push(ActiveBgJob {
        job_id: job_id,
        title: title,
        target_buffer: target_buffer,
    })
    mgr.jobs.insert(job_id, BgJobMeta {
        job_id: job_id,
        kind: kind,
        command: cmd,
        cwd: cwd,
        title: title,
        target_buffer: target_buffer,
    })
}

private fn remove_active_job_from_world(world: EditorWorld, job_id: i64) -> ?ActiveBgJob {
    var found: ?ActiveBgJob = null
    let remaining = List()
    for i in 0..world.active_jobs.len() {
        let j = world.active_jobs.get(i.as(usize)).as(ActiveBgJob)
        if j.job_id == job_id {
            found = j
        } else {
            remaining.push(j)
        }
    }
    world.active_jobs = remaining
    found
}

pub fn spawn_grep_job(
    kernel: SystemKernel,
    pattern: String,
) -> #[log_event, status_emit] !String i64 {
    let world = require_editor_world(kernel)!
    let mgr = require_tools_manager(kernel)!
    if pattern == "" {
        return error "grep pattern cannot be empty"
    }
    world.last_search = pattern
    let qpat = shell_quote(pattern)
    let ic_flag = if world.effective_ignore_case(pattern) { "-i " } else { "" }
    let raw_cmd =
        "if command -v rg >/dev/null 2>&1; then rg -n --column --no-heading --color=never "
        ++ ic_flag ++ "-- " ++ qpat ++ " .; else grep -rn " ++ ic_flag ++ "-- " ++ qpat ++ " .; fi"
    let full_cmd = wrap_cmd_in_cwd(raw_cmd, world.cwd)

    let init_lines = [
        "-*- mode: grep; default-directory: \"" ++ world.cwd ++ "\" -*-",
        "[Running grep for \"" ++ pattern ++ "\"...]",
    ]
    let gbuf = world.ensure_special_buffer("*Grep*", "grep", init_lines, read_only = true)
    mgr.clear_qf_rows_for_buffer(gbuf.id)

    let job_id = host_spawn_job(full_cmd, world.cwd, "")
    register_bg_job(
        world,
        mgr,
        job_id,
        "grep",
        raw_cmd,
        world.cwd,
        "Grep: " ++ pattern,
        "*Grep*",
    )
    let _ = world.switch_to_buffer(gbuf.id)
    kernel.emit_hook("buffer-switched", gbuf.id)
    log_event("info", "ext_tools", "Spawned async grep job #" ++ job_id.to_string())#
    status_emit("[Running grep (job #" ++ job_id.to_string() ++ ")...]")#
    job_id
}

pub fn run_shell_command_sync(
    kernel: SystemKernel,
    cmd: String,
) -> #[log_event, status_emit] !String String {
    let world = require_editor_world(kernel)!
    let mgr = require_tools_manager(kernel)!
    let trimmed_cmd = cmd.trim()
    if trimmed_cmd == "" {
        return error "shell command cannot be empty"
    }
    mgr.last_shell_cmd = trimmed_cmd
    let full_cmd = wrap_cmd_in_cwd(trimmed_cmd, world.cwd)
    let out! = process.shell(full_cmd) else {
        return error ("failed to execute shell command: " ++ trimmed_cmd)
    }
    var combined = out.stdout
    if out.stderr != "" {
        if combined != "" and (not combined.ends_with("\n")) {
            combined = combined ++ "\n"
        }
        combined = combined ++ out.stderr
    }
    let clean = combined.replace("\r\n", "\n").trim_end_matches("\n")
    let out_lines = if clean == "" {
        ["(Shell command finished with exit code " ++ out.status.to_string() ++ ")"]
    } else {
        clean.split("\n")
    }
    let sbuf = world.ensure_special_buffer("*Shell Command Output*", "text", out_lines, read_only = true)
    if clean == "" {
        status_emit("(Shell command succeeded with no output)")#
    } else if not clean.contains("\n") {
        status_emit(clean)#
    } else {
        let _ = world.switch_to_buffer(sbuf.id)
        kernel.emit_hook("buffer-switched", sbuf.id)
        status_emit(
            "Shell command output (" ++ out_lines.len().to_string()
            ++ " lines, exit " ++ out.status.to_string() ++ ")"
        )#
    }
    clean
}

pub fn spawn_async_shell_job(
    kernel: SystemKernel,
    cmd: String,
) -> #[log_event, status_emit] !String i64 {
    let world = require_editor_world(kernel)!
    let mgr = require_tools_manager(kernel)!
    let trimmed_cmd = cmd.trim()
    if trimmed_cmd == "" {
        return error "async shell command cannot be empty"
    }
    mgr.last_shell_cmd = trimmed_cmd
    let init_lines = [
        "-*- mode: compilation; default-directory: \"" ++ world.cwd ++ "\" -*-",
        "$ " ++ trimmed_cmd,
        "[Running async shell command...]",
    ]
    let abuf = world.ensure_special_buffer("*Async Shell Command*", "compilation", init_lines, read_only = true)
    mgr.clear_qf_rows_for_buffer(abuf.id)

    let job_id = host_spawn_job(wrap_cmd_in_cwd(trimmed_cmd, world.cwd), world.cwd, "")
    register_bg_job(
        world,
        mgr,
        job_id,
        "async-shell",
        trimmed_cmd,
        world.cwd,
        "Async Shell: " ++ trimmed_cmd,
        "*Async Shell Command*",
    )
    let _ = world.switch_to_buffer(abuf.id)
    kernel.emit_hook("buffer-switched", abuf.id)
    status_emit("[Running async shell job #" ++ job_id.to_string() ++ "...]")#
    job_id
}

pub fn spawn_compile_job(
    kernel: SystemKernel,
    cmd: String,
) -> #[log_event, status_emit] !String i64 {
    let world = require_editor_world(kernel)!
    let mgr = require_tools_manager(kernel)!
    let trimmed_cmd = cmd.trim()
    if trimmed_cmd == "" {
        return error "compile command cannot be empty"
    }
    mgr.last_compile_cmd = trimmed_cmd
    let init_lines = [
        "-*- mode: compilation; default-directory: \"" ++ world.cwd ++ "\" -*-",
        "Compilation started: " ++ trimmed_cmd,
        "[Running compilation...]",
    ]
    let cbuf = world.ensure_special_buffer("*Compilation*", "compilation", init_lines, read_only = true)
    mgr.clear_qf_rows_for_buffer(cbuf.id)

    let job_id = host_spawn_job(wrap_cmd_in_cwd(trimmed_cmd, world.cwd), world.cwd, "")
    register_bg_job(
