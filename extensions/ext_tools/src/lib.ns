pub fn tools_cancel_active_jobs(
    kernel: SystemKernel,
) -> #[log_event, status_emit] !String i64 {
    let world = require_editor_world(kernel)!
    let mgr = require_tools_manager(kernel)!
    let count = world.active_jobs.len()
    if count == 0 {
        status_emit("No active background jobs")#
        return 0
    }
    for i in 0..count {
        let j = world.active_jobs.get(i.as(usize)).as(ActiveBgJob)
        let _ = host_cancel_job(j.job_id)
        let _ = mgr.jobs.remove(j.job_id)
        let b_opt = world.find_buffer_by_name(j.target_buffer)
        if b_opt != null {
            let b = b_opt.as(Buffer)
            b.read_only = false
            b.push_line("[Interrupt: cancelled job #" ++ j.job_id.to_string() ++ "]")
            b.modified = false
            b.read_only = true
        }
    }
    world.active_jobs = List()
    log_event("info", "ext_tools", "Cancelled " ++ count.to_string() ++ " background job(s)")#
    status_emit("Cancelled " ++ count.to_string() ++ " background job(s)")#
    count
}

private fn parse_arrow_diagnostic_line(line: String) -> ?QuickfixEntry {
    let trimmed = line.trim_start()
    if not trimmed.starts_with("--> ") {
        return null
    }
    let rest = trimmed.drop(4).trim()
    parse_quickfix_line(rest ++ ": diagnostic")
}

private fn parse_job_diagnostic_line(line: String, job_cwd: String) -> ?QuickfixEntry {
    let trimmed = line.trim()
    if trimmed == "" or trimmed.starts_with("-*-") or trimmed.starts_with("[") {
        return null
    }
    let arrow_opt = parse_arrow_diagnostic_line(line)
    let raw_entry? = if arrow_opt != null {
        arrow_opt
    } else {
        parse_quickfix_line(line)
    } else {
        return null
    }
    var fpath = raw_entry.file_path
    if fpath.starts_with("./") {
        fpath = fpath.drop(2)
    }
    if fpath == "" or fpath.contains(" ") {
        return null
    }
    let resolved_path = if path.is_absolute(fpath) {
        path.normalize(fpath)
    } else if job_cwd != "" {
        path.normalize(path.join(job_cwd, fpath))
    } else {
        fpath
    }
    QuickfixEntry {
        file_path: resolved_path,
        row: raw_entry.row,
        col: raw_entry.col,
        text: raw_entry.text,
    }
}

pub fn tools_on_async_job_done(
    kernel: SystemKernel,
    job_id: i64,
    ok: bool,
    exit_code: i64,
    stdout: String,
    stderr: String,
) -> #[log_event, status_emit] !String bool {
    let world = require_editor_world(kernel)!
    let mgr = require_tools_manager(kernel)!

    let meta_any_opt = mgr.jobs.remove(job_id)
    let world_job_opt = remove_active_job_from_world(world, job_id)
    if meta_any_opt == null and world_job_opt == null {
        return false
    }

    let meta = if meta_any_opt != null {
        meta_any_opt.as(BgJobMeta)
    } else {
        let wj = world_job_opt.as(ActiveBgJob)
        let inferred_kind = if wj.target_buffer == "*Grep*" { "grep" } else { "compile" }
        BgJobMeta {
            job_id: job_id,
            kind: inferred_kind,
            command: wj.title,
            cwd: world.cwd,
            title: wj.title,
            target_buffer: wj.target_buffer,
        }
    }

    let mode = if meta.kind == "grep" { "grep" } else { "compilation" }
    let lines = List()
    lines.push("-*- mode: " ++ mode ++ "; default-directory: \"" ++ meta.cwd ++ "\" -*-")
    lines.push("$ " ++ meta.command)
    lines.push("")

    let raw_chunks = List()
    if stdout != "" {
        let norm_out = stdout.replace("\r\n", "\n").replace("\r", "\n").trim_end_matches("\n")
        if norm_out != "" {
            let out_split = norm_out.split("\n")
            for i in 0..out_split.len() {
                raw_chunks.push(out_split.get(i.as(usize)).as(String))
            }
        }
    }
    if stderr != "" {
        let norm_err = stderr.replace("\r\n", "\n").replace("\r", "\n").trim_end_matches("\n")
        if norm_err != "" {
            let err_split = norm_err.split("\n")
            for i in 0..err_split.len() {
                raw_chunks.push(err_split.get(i.as(usize)).as(String))
            }
        }
    }

    let qf_entries = List()
    let qf_rows = List()
    var first_diag_row: i64 = -1
    for i in 0..raw_chunks.len() {
        let ln = raw_chunks.get(i.as(usize)).as(String)
        let buf_row = lines.len()
        lines.push(ln)
        let qf_opt = parse_job_diagnostic_line(ln, meta.cwd)
        if qf_opt != null {
            let qf_idx = qf_entries.len()
            qf_entries.push(qf_opt.as(QuickfixEntry))
            qf_rows.push((buf_row, qf_idx))
            if first_diag_row < 0 {
                first_diag_row = buf_row
            }
        }
    }

    lines.push("")
    if meta.kind == "grep" {
        if qf_entries.is_empty() and (not ok) and exit_code == 1 {
            lines.push("Grep finished with no matches found")
        } else if ok or (not qf_entries.is_empty()) {
            lines.push("Grep finished (" ++ qf_entries.len().to_string() ++ " match(es))")
        } else {
            lines.push("Grep exited abnormally with code " ++ exit_code.to_string())
        }
    } else if ok {
        lines.push("Compilation finished (exit 0, " ++ qf_entries.len().to_string() ++ " diagnostic(s))")
    } else {
        lines.push(
            "Compilation exited abnormally with code " ++ exit_code.to_string()
            ++ " (" ++ qf_entries.len().to_string() ++ " diagnostic(s))"
        )
    }

    let target_buf = world.ensure_special_buffer(meta.target_buffer, mode, lines, read_only = true)
    mgr.clear_qf_rows_for_buffer(target_buf.id)
    for i in 0..qf_rows.len() {
        let (r_idx, q_idx) = qf_rows.get(i.as(usize)).as((i64, i64))
        mgr.bind_qf_row(target_buf.id, r_idx, q_idx)
    }

    if meta.kind == "grep" or meta.kind == "compile" or (not qf_entries.is_empty()) {
        world.quickfix = qf_entries
        world.quickfix_idx = 0
        world.quickfix_title = meta.title
        mgr.qf_visited_current = false
    }

    if first_diag_row >= 0 {
        target_buf.point = target_buf.clamp_pos(Pos.new(first_diag_row, 0), insert_mode = false)
    }

    log_event(
        "info",
        "ext_tools",
        "Async job #" ++ job_id.to_string() ++ " (" ++ meta.kind ++ ") finished: exit=" ++ exit_code.to_string(),
    )#
    if meta.kind == "grep" {
        status_emit("Grep finished: " ++ qf_entries.len().to_string() ++ " match(es)")#
    } else if ok {
        status_emit(meta.title ++ " finished (" ++ qf_entries.len().to_string() ++ " diagnostic(s))")#
    } else {
        status_emit(
            meta.title ++ " failed (exit " ++ exit_code.to_string()
            ++ ", " ++ qf_entries.len().to_string() ++ " diagnostic(s))"
        )#
    }
    kernel.emit_hook("async-job-done", job_id)
    true
}

private fn open_and_jump_to_entry(
    kernel: SystemKernel,
    world: EditorWorld,
    entry: QuickfixEntry,
    idx_display: i64,
    total_display: i64,
) -> #[log_event, status_emit] !String bool {
    let cur_buf = world.active_buffer()
    world.jumps.record(cur_buf.id, cur_buf.file_path, cur_buf.point)

    let dest_buf = if entry.file_path.starts_with("buffer:") {
        let bname = entry.file_path.drop(7)
        let b? = world.find_buffer_by_name(bname) else {
            return error ("target buffer no longer exists: " ++ bname)
        }
        let _ = world.switch_to_buffer(b.id)
        b
    } else {
        world.open_file(entry.file_path)#!
    }

    dest_buf.point = dest_buf.clamp_pos(Pos.new(entry.row, entry.col), insert_mode = false)
    dest_buf.preferred_col = dest_buf.point.col
    world.jumps.record(dest_buf.id, dest_buf.file_path, dest_buf.point)
    kernel.emit_hook("buffer-switched", dest_buf.id)
    status_emit(
        "(" ++ idx_display.to_string() ++ "/" ++ total_display.to_string() ++ ") "
        ++ dest_buf.name ++ ":" ++ (entry.row + 1).to_string() ++ ":" ++ (entry.col + 1).to_string()
        ++ ": " ++ entry.text.trim()
    )#
    true
}

pub fn jump_quickfix_at(
    kernel: SystemKernel,
    idx: i64,
) -> #[log_event, status_emit] !String bool {
    let world = require_editor_world(kernel)!
    let mgr = require_tools_manager(kernel)!
    let total = world.quickfix.len()
    if total == 0 {
        status_emit("No quickfix/error entries")#
        return false
    }
    let clamped = if idx < 0 {
        0
    } else if idx >= total {
        total - 1
    } else {
        idx
    }
    world.quickfix_idx = clamped
    mgr.qf_visited_current = true
    let entry = world.quickfix.get(clamped.as(usize)).as(QuickfixEntry)
    open_and_jump_to_entry(kernel, world, entry, clamped + 1, total)#!
}

pub fn jump_next_error(
    kernel: SystemKernel,
) -> #[log_event, status_emit] !String bool {
    let world = require_editor_world(kernel)!
    let mgr = require_tools_manager(kernel)!
    let total = world.quickfix.len()
    if total == 0 {
        status_emit("No quickfix/error entries")#
        return false
    }
    var target_idx = world.quickfix_idx
    if target_idx < 0 or target_idx >= total {
        target_idx = 0
    } else if mgr.qf_visited_current {
        if target_idx + 1 < total {
            target_idx += 1
        } else {
            status_emit("Moved past last error (" ++ total.to_string() ++ "/" ++ total.to_string() ++ ")")#
            return false
        }
    }
    jump_quickfix_at(kernel, target_idx)#!
}

pub fn jump_previous_error(
    kernel: SystemKernel,
) -> #[log_event, status_emit] !String bool {
    let world = require_editor_world(kernel)!
    let mgr = require_tools_manager(kernel)!
    let total = world.quickfix.len()
    if total == 0 {
        status_emit("No quickfix/error entries")#
        return false
    }
    var target_idx = world.quickfix_idx
    if target_idx < 0 or target_idx >= total {
        target_idx = 0
    } else if mgr.qf_visited_current {
        if target_idx > 0 {
            target_idx -= 1
        } else {
            status_emit("At first error (1/" ++ total.to_string() ++ ")")#
            return false
        }
    }
    jump_quickfix_at(kernel, target_idx)#!
}

private fn jump_from_results_buffer_row(
    kernel: SystemKernel,
    buf: Buffer,
) -> #[log_event, status_emit] !String bool {
    let world = require_editor_world(kernel)!
    let mgr = require_tools_manager(kernel)!
    let row = buf.point.row
    let mapped_opt = mgr.lookup_qf_row(buf.id, row)
    if mapped_opt != null {
        let q_idx = mapped_opt.as(i64)
        if q_idx >= 0 and q_idx < world.quickfix.len() {
            return jump_quickfix_at(kernel, q_idx)#!
        }
    }
    let parsed_opt = parse_job_diagnostic_line(buf.line_at(row), world.cwd)
    if parsed_opt != null {
        let entry = parsed_opt.as(QuickfixEntry)
        return open_and_jump_to_entry(kernel, world, entry, 1, 1)#!
    }
    status_emit("No location on current line")#
    false
}

-- ============================================================================
-- 5. Org-Outline Mode (`org-cycle` <Tab> folding & `org-todo` state cycling)
-- ============================================================================

private fn is_md_mode(mode: String) -> bool {
    let m = mode.to_lower()
    m == "markdown" or m == "md" or m == "gfm"
}

private fn tools_md_fence_open(line: String) -> ?(i64, i64) {
    let blen = line.len()
    var sp: i64 = 0
    while sp < blen and sp < 12 and (line.byte_at(sp) == 32 or line.byte_at(sp) == 9 or line.byte_at(sp) == 62) {
        sp += 1
    }
    if sp + 3 > blen {
        return null
    }
    let fc = line.byte_at(sp)
    if fc != 96 and fc != 126 {
        return null
    }
    var flen: i64 = 0
    while sp + flen < blen and line.byte_at(sp + flen) == fc {
        flen += 1
    }
    if flen < 3 {
        return null
    }
    if fc == 96 and line.drop(sp + flen).contains("`") {
        return null
    }
    (fc, flen)
}

private fn tools_md_fence_close(line: String, fc: i64, min_len: i64) -> bool {
    let blen = line.len()
    var sp: i64 = 0
    while sp < blen and sp < 12 and (line.byte_at(sp) == 32 or line.byte_at(sp) == 9 or line.byte_at(sp) == 62) {
        sp += 1
    }
    var flen: i64 = 0
    while sp + flen < blen and line.byte_at(sp + flen) == fc {
        flen += 1
    }
    if flen < min_len {
        return false
    }
    var k = sp + flen
    while k < blen {
        let b = line.byte_at(k)
        if b != 32 and b != 9 {
            return false
        }
        k += 1
    }
    true
}

private fn is_row_inside_md_fence_or_frontmatter(buf: Buffer, target_row: i64) -> bool {
    if not is_md_mode(buf.major_mode) {
        return false
    }
    let total = buf.line_count()
    if total <= 0 or target_row < 0 or target_row >= total {
        return false
    }
    var start_r: i64 = 0
    if buf.line_at(0).trim_end() == "---" {
        var fm_end: i64 = -1
        for r in 1..total {
            let t = buf.line_at(r).trim_end()
            if t == "---" or t == "..." {
                fm_end = r
                break
            }
        }
        if fm_end > 0 {
            if target_row <= fm_end {
                return true
            }
            start_r = fm_end + 1
        }
    }
    var in_fence = false
    var fc: i64 = 0
    var flen: i64 = 0
    for r in start_r..(target_row + 1) {
        let ln = buf.line_at(r)
        if not in_fence {
            let f_opt = tools_md_fence_open(ln)
            if f_opt != null {
                let (b, l) = f_opt.as((i64, i64))
                in_fence = true
                fc = b
                flen = l
                if r == target_row {
                    return true
                }
            }
        } else {
            if r == target_row {
                return true
            }
            if tools_md_fence_close(ln, fc, flen) {
                in_fence = false
            }
        }
    }
    false
}

private fn count_leading_marker(line: String, marker: String) -> i64 {
    let n = line.char_len()
    var sp: i64 = 0
    if marker == "#" {
        while sp < n and sp < 4 and line.slice(sp, sp + 1) == " " {
            sp += 1
        }
        if sp >= 4 {
            return 0
        }
    }
    var count: i64 = 0
    while sp + count < n and line.slice(sp + count, sp + count + 1) == marker {
        count += 1
    }
    if marker == "#" and count > 6 {
        return 0
    }
    if count > 0 {
        if sp + count == n {
            return count
        }
        let nxt = line.slice(sp + count, sp + count + 1)
        if nxt == " " or nxt == "\t" {
            return count
        }
    }
    0
}

pub fn heading_level(line: String, major_mode: String) -> i64 {
    if is_md_mode(major_mode) {
        return count_leading_marker(line, "#")
    }
    if major_mode == "org" {
        return count_leading_marker(line, "*")
    }
    let stars = count_leading_marker(line, "*")
    if stars > 0 {
        return stars
    }
    count_leading_marker(line, "#")
}

private fn subtree_end_row_for_heading(buf: Buffer, heading_row: i64, level: i64) -> i64 {
    let total = buf.line_count()
    let md = is_md_mode(buf.major_mode)
    var in_fence = false
    var fc: i64 = 0
    var flen: i64 = 0
    var r = heading_row + 1
    while r < total {
        let ln = buf.line_at(r)
        if md {
            if not in_fence {
                let f_opt = tools_md_fence_open(ln)
                if f_opt != null {
                    let (b, l) = f_opt.as((i64, i64))
                    in_fence = true
                    fc = b
                    flen = l
                    r += 1
                    continue
                }
            } else {
                if tools_md_fence_close(ln, fc, flen) {
                    in_fence = false
                }
                r += 1
                continue
            }
        }
        let lvl = heading_level(ln, buf.major_mode)
        if lvl > 0 and lvl <= level {
            return r - 1
        }
        r += 1
    }
    total - 1
}

pub fn org_cycle_at_point(kernel: SystemKernel) -> #status_emit !String bool {
    let world = require_editor_world(kernel)!
    let buf = world.active_buffer()
    let row = buf.point.row
    if is_row_inside_md_fence_or_frontmatter(buf, row) {
        return false
    }
    let level = heading_level(buf.line_at(row), buf.major_mode)
    if level <= 0 {
        return false
    }
    let end_row = subtree_end_row_for_heading(buf, row, level)
    if end_row <= row {
        status_emit("EMPTY SUBTREE")#
        return true
    }
    var any_folded = false
    for r in (row + 1)..(end_row + 1) {
        if buf.folded_rows.contains(r) {
            any_folded = true
            break
        }
    }
    if any_folded {
        for r in (row + 1)..(end_row + 1) {
            let _ = buf.folded_rows.remove(r)
        }
        status_emit("SUBTREE EXPANDED")#
    } else {
        for r in (row + 1)..(end_row + 1) {
            let _ = buf.folded_rows.insert(r)
        }
        status_emit("FOLDED (" ++ (end_row - row).to_string() ++ " lines)")#
    }
    true
}

private fn try_toggle_md_checkbox_line(line: String) -> ?(String, String) {
    let n = line.char_len()
    var i: i64 = 0
    while i < n and (line.slice(i, i + 1) == " " or line.slice(i, i + 1) == "\t" or line.slice(i, i + 1) == ">") {
        i += 1
    }
    if i >= n {
        return null
    }
    let ch = line.slice(i, i + 1)
    if ch == "-" or ch == "*" or ch == "+" {
        i += 1
    } else if ch >= "0" and ch <= "9" {
        while i < n and line.slice(i, i + 1) >= "0" and line.slice(i, i + 1) <= "9" {
            i += 1
        }
        if i >= n or (line.slice(i, i + 1) != "." and line.slice(i, i + 1) != ")") {
            return null
        }
        i += 1
    } else {
        return null
    }
    var sp_cnt: i64 = 0
    while i < n and (line.slice(i, i + 1) == " " or line.slice(i, i + 1) == "\t") {
        i += 1
        sp_cnt += 1
    }
    if sp_cnt == 0 or i + 3 > n {
        return null
    }
    if line.slice(i, i + 1) != "[" or line.slice(i + 2, i + 3) != "]" {
        return null
    }
    let mid = line.slice(i + 1, i + 2)
    if mid == " " or mid == "-" {
        return (line.slice(0, i) ++ "[x]" ++ line.drop(i + 3), "DONE")
    }
    if mid == "x" or mid == "X" {
        return (line.slice(0, i) ++ "[ ]" ++ line.drop(i + 3), "TODO")
    }
    null
}

pub fn org_todo_at_point(kernel: SystemKernel) -> #status_emit !String String {
    let world = require_editor_world(kernel)!
    let buf = world.active_buffer()
    buf.ensure_writable()!

    if is_row_inside_md_fence_or_frontmatter(buf, buf.point.row) {
        status_emit("Inside code block")#
        return ""
    }

    if is_md_mode(buf.major_mode) {
        let cur_line = buf.line_at(buf.point.row)
        let cb_opt = try_toggle_md_checkbox_line(cur_line)
        if cb_opt != null {
            let (new_line, cb_state) = cb_opt.as((String, String))
            buf.set_line_at(buf.point.row, new_line)
            buf.modified = true
            buf.checkpoint(buf.point, "org-todo")
            status_emit("Task checkbox -> " ++ cb_state)#
            return cb_state
        }
    }

    var target_row: i64 = -1
    var level: i64 = 0
    var scan_r = buf.point.row
    while scan_r >= 0 {
        if not is_row_inside_md_fence_or_frontmatter(buf, scan_r) {
            let lvl = heading_level(buf.line_at(scan_r), buf.major_mode)
            if lvl > 0 {
                target_row = scan_r
                level = lvl
                break
            }
        }
        scan_r -= 1
    }
    if target_row < 0 {
        status_emit("Not on or under an outline heading")#
        return ""
    }

    let line = buf.line_at(target_row)
    var sp: i64 = 0
    while sp < line.char_len() and line.slice(sp, sp + 1) == " " {
        sp += 1
    }
    let prefix = line.slice(0, sp + level + 1)
    let rest = line.drop(sp + level + 1)

    var next_state = ""
    var updated_rest = rest
    if rest.starts_with("TODO ") {
        next_state = "DONE"
        updated_rest = "DONE " ++ rest.drop(5)
    } else if rest == "TODO" {
        next_state = "DONE"
        updated_rest = "DONE"
    } else if rest.starts_with("DONE ") {
        next_state = "NONE"
        updated_rest = rest.drop(5)
    } else if rest == "DONE" {
        next_state = "NONE"
        updated_rest = ""
    } else {
        next_state = "TODO"
        updated_rest = if rest == "" { "TODO" } else { "TODO " ++ rest }
    }

    buf.set_line_at(target_row, prefix ++ updated_rest)
    buf.modified = true
    buf.checkpoint(buf.point, "org-todo")
    status_emit("Heading TODO state -> " ++ next_state)#
    next_state
}

-- ============================================================================
-- 6. Live `*scratch*` Single-VM Expression & Kernel Introspection Evaluator
-- ============================================================================

private enum ExprTok {
    pub int_lit(val: i64),
    pub float_lit(val: f64),
    pub str_lit(val: String),
    pub ident(name: String),
    pub op(sym: String),
    pub l_paren,
    pub r_paren,
    pub l_bracket,
    pub r_bracket,
    pub comma,
}

private struct ExprStream {
    pub tokens: List,
    pub pos: i64,
}

private fn strip_comment_outside_quotes(line: String) -> String {
    let n = line.char_len()
    var in_str = false
    var escaped = false
    var i: i64 = 0
    while i < n {
        let ch = line.slice(i, i + 1)
        if in_str {
            if escaped {
                escaped = false
            } else if ch == "\\" {
                escaped = true
            } else if ch == "\"" {
                in_str = false
            }
            i += 1
            continue
        }
        if ch == "\"" {
            in_str = true
            i += 1
            continue
        }
        if ch == "-" and i + 1 < n and line.slice(i + 1, i + 2) == "-" {
            return line.slice(0, i).trim_end()
        }
        i += 1
    }
    line.trim_end()
}

private fn is_ident_start_char(ch: String) -> bool {
    ch == "_" or ch.is_alphabetic()
}

private fn is_ident_continue_char(ch: String) -> bool {
    ch == "_" or ch == "-" or ch == "." or ch.is_alphanumeric()
}

private fn tokenize_expr(src: String) -> !String List {
    let tokens = List()
    let n = src.char_len()
    var i: i64 = 0
    while i < n {
        let ch = src.slice(i, i + 1)
        if ch == " " or ch == "\t" or ch == "\n" or ch == "\r" {
            i += 1
            continue
        }
        if ch == "(" {
            tokens.push(ExprTok.l_paren)
            i += 1
            continue
        }
        if ch == ")" {
            tokens.push(ExprTok.r_paren)
            i += 1
            continue
        }
        if ch == "[" {
            tokens.push(ExprTok.l_bracket)
            i += 1
            continue
        }
        if ch == "]" {
            tokens.push(ExprTok.r_bracket)
            i += 1
            continue
        }
        if ch == "," {
            tokens.push(ExprTok.comma)
            i += 1
            continue
        }
        if ch == "\"" {
            var j = i + 1
            var buf = ""
            var closed = false
            while j < n {
                let c = src.slice(j, j + 1)
                if c == "\\" and j + 1 < n {
                    let esc = src.slice(j + 1, j + 2)
                    if esc == "n" {
                        buf = buf ++ "\n"
                    } else if esc == "t" {
                        buf = buf ++ "\t"
                    } else {
                        buf = buf ++ esc
                    }
                    j += 2
                    continue
                }
                if c == "\"" {
                    closed = true
                    j += 1
                    break
                }
                buf = buf ++ c
                j += 1
            }
            if not closed {
                return error "unterminated string literal"
            }
            tokens.push(ExprTok.str_lit(buf))
            i = j
            continue
        }
        if i + 1 < n {
            let two = src.slice(i, i + 2)
            if two == "++" or two == "==" or two == "!=" or two == "<=" or two == ">=" {
                tokens.push(ExprTok.op(two))
                i += 2
                continue
            }
        }
        if ch == "+" or ch == "-" or ch == "*" or ch == "/" or ch == "%" or ch == "<" or ch == ">" {
            tokens.push(ExprTok.op(ch))
            i += 1
            continue
        }
        if ch.is_ascii_digit() {
            var j = i + 1
            var has_dot = false
            while j < n {
                let c = src.slice(j, j + 1)
                if c.is_ascii_digit() {
                    j += 1
                } else if c == "." and (not has_dot) and j + 1 < n and src.slice(j + 1, j + 2).is_ascii_digit() {
                    has_dot = true
                    j += 1
                } else {
                    break
                }
            }
            let num_txt = src.slice(i, j)
            if has_dot {
                let fv? = num_txt.try_parse(f64) else {
                    return error ("invalid float literal: " ++ num_txt)
                }
                tokens.push(ExprTok.float_lit(fv))
            } else {
                let iv? = num_txt.try_parse(i64) else {
                    return error ("invalid integer literal: " ++ num_txt)
                }
                tokens.push(ExprTok.int_lit(iv))
            }
            i = j
            continue
        }
        if is_ident_start_char(ch) {
            var j = i + 1
            while j < n {
                let c = src.slice(j, j + 1)
                -- Stop before `-` if followed by space or digit when used as subtraction,
                -- allow kebab-case identifiers when followed by alphabetic char.
                if c == "-" {
                    if j + 1 < n and src.slice(j + 1, j + 2).is_alphabetic() {
                        j += 1
                        continue
                    }
                    break
                }
                if is_ident_continue_char(c) {
                    j += 1
                } else {
                    break
                }
            }
            let ident = src.slice(i, j)
            if ident == "and" or ident == "or" or ident == "not" {
                tokens.push(ExprTok.op(ident))
            } else {
                tokens.push(ExprTok.ident(ident))
            }
            i = j
            continue
        }
        return error ("unexpected character in expression: " ++ ch)
    }
    tokens
}

private fn format_eval_value(val: Any) -> String {
    if val == null {
        return "null"
    }
    if val matches _: String {
        return val.as(String)
    }
    if val matches _: bool {
        return if val.as(bool) { "true" } else { "false" }
    }
    if val matches _: i64 {
        return val.as(i64).to_string()
    }
    if val matches _: f64 {
        return val.as(f64).to_string()
    }
    if val matches _: List {
        let lst = val.as(List)
        let parts = List()
        for i in 0..lst.len() {
            let item = lst.get(i.as(usize))
            if item matches _: String {
                parts.push("\"" ++ item.as(String) ++ "\"")
            } else {
                parts.push(format_eval_value(item))
            }
        }
        return "[" ++ parts.join(", ") ++ "]"
    }
    val.to_string()
}

private fn format_options_summary(world: EditorWorld) -> String {
    let o = world.options
    "theme=" ++ o.theme_name
        ++ " tabstop=" ++ o.tabstop.to_string()
        ++ " shiftwidth=" ++ o.shiftwidth.to_string()
        ++ " expandtab=" ++ o.expandtab.to_string()
        ++ " number=" ++ o.number.to_string()
        ++ " relativenumber=" ++ o.relativenumber.to_string()
        ++ " ignorecase=" ++ o.ignorecase.to_string()
        ++ " smartcase=" ++ o.smartcase.to_string()
        ++ " wrap=" ++ o.wrap.to_string()
        ++ " evil_mode=" ++ o.evil_mode.to_string()
}

private fn lookup_option_value(world: EditorWorld, key: String) -> ?Any {
    let o = world.options
    when {
        key == "tabstop" => o.tabstop,
        key == "shiftwidth" => o.shiftwidth,
        key == "expandtab" => o.expandtab,
        key == "number" => o.number,
        key == "relativenumber" => o.relativenumber,
        key == "ignorecase" => o.ignorecase,
        key == "smartcase" => o.smartcase,
        key == "wrap" => o.wrap,
        key == "hlsearch" => o.hlsearch,
        key == "incsearch" => o.incsearch,
        key == "theme" or key == "theme_name" => o.theme_name,
        key == "font_family" => o.font_family,
        key == "font_size_pt" => o.font_size_pt,
        key == "cursor_blink" => o.cursor_blink,
        key == "evil_mode" => o.evil_mode,
        key == "cwd" => world.cwd,
        else => null,
    }
}

private fn parse_bool_val(v: Any) -> !String bool {
    if v matches _: bool {
        return v.as(bool)
    }
    if v matches _: i64 {
        return v.as(i64) != 0
    }
    let s = format_eval_value(v).trim().to_lower()
    if s == "true" or s == "on" or s == "1" or s == "yes" {
        return true
    }
    if s == "false" or s == "off" or s == "0" or s == "no" {
        return false
    }
    error ("expected boolean value, got: " ++ s)
}

private fn parse_int_val(v: Any) -> !String i64 {
    if v matches _: i64 {
        return v.as(i64)
    }
    let s = format_eval_value(v).trim()
    let parsed? = s.try_parse(i64) else {
        return error ("expected integer value, got: " ++ s)
    }
    parsed
}

private fn apply_set_option(kernel: SystemKernel, world: EditorWorld, key: String, val: Any) -> !String String {
    let o = world.options
    when {
        key == "tabstop" => { o.tabstop = parse_int_val(val)! },
        key == "shiftwidth" => { o.shiftwidth = parse_int_val(val)! },
        key == "expandtab" => { o.expandtab = parse_bool_val(val)! },
        key == "number" => { o.number = parse_bool_val(val)! },
        key == "relativenumber" => { o.relativenumber = parse_bool_val(val)! },
        key == "ignorecase" => { o.ignorecase = parse_bool_val(val)! },
        key == "smartcase" => { o.smartcase = parse_bool_val(val)! },
        key == "wrap" => { o.wrap = parse_bool_val(val)! },
        key == "hlsearch" => { o.hlsearch = parse_bool_val(val)! },
        key == "incsearch" => { o.incsearch = parse_bool_val(val)! },
        key == "theme" or key == "theme_name" => { o.theme_name = format_eval_value(val) },
        key == "font_family" => { o.font_family = format_eval_value(val) },
        key == "cursor_blink" => { o.cursor_blink = parse_bool_val(val)! },
        key == "evil_mode" => { o.evil_mode = parse_bool_val(val)! },
        key == "cwd" => { world.cwd = world.resolve_path(format_eval_value(val)) },
        else => { return error ("unknown option: " ++ key) },
    }
    kernel.emit_hook("option-changed", key)
    let updated = lookup_option_value(world, key)
    key ++ " = " ++ format_eval_value(updated)
}

private fn inspect_symbol(kernel: SystemKernel, world: EditorWorld, mgr: ToolsManager, name: String) -> !String Any {
    if name == "true" {
        return true
    }
    if name == "false" {
        return false
    }
    if name == "null" {
        return null
    }
    if name == "commands" {
        let specs = kernel.list_commands()
        let names = List()
        for i in 0..specs.len() {
            names.push(specs.get(i.as(usize)).as(CommandSpec).name)
        }
        return "Commands (" ++ names.len().to_string() ++ "): " ++ names.join(", ")
    }
    if name == "extensions" {
        let parts = List()
        for i in 0..kernel.ext_order.len() {
            let id = kernel.ext_order.get(i.as(usize)).as(ExtId)
            let rec = kernel.extensions.get(id).as(ExtensionRecord)
            let st_label = rec.state match {
                ExtState.registered => "Registered",
                ExtState.active => "Active",
                ExtState.disabled => "Disabled",
                ExtState.failed(reason) => "Failed(" ++ reason ++ ")",
            }
            parts.push(id.raw() ++ "[" ++ st_label ++ "]")
        }
        return "Extensions (" ++ parts.len().to_string() ++ "): " ++ parts.join(", ")
    }
    if name == "services" {
        let keys = kernel.services.keys()
        keys.sort()
        return "Services (" ++ keys.len().to_string() ++ "): " ++ keys.join(", ")
    }
    if name == "buffers" {
        let parts = List()
        for i in 0..world.buffer_order.len() {
            let bid = world.buffer_order.get(i.as(usize)).as(BufferId)
            let b = world.buffers.get(bid).as(Buffer)
            let cur_mark = if bid == world.active_buffer_id { "*" } else { "" }
            parts.push(cur_mark ++ b.name ++ "(" ++ b.major_mode ++ ")")
        }
        return "Buffers (" ++ parts.len().to_string() ++ "): " ++ parts.join(", ")
    }
    if name == "options" {
        return format_options_summary(world)
    }
    if name == "keymaps" {
        let kms = kernel.keymaps.keys()
        kms.sort()
        return "Keymaps (" ++ kms.len().to_string() ++ "): " ++ kms.join(", ")
    }
    if name == "jobs" {
        return "Active jobs (" ++ world.active_jobs.len().to_string() ++ ")"
    }
    if name == "quickfix" {
        return "Quickfix (" ++ world.quickfix.len().to_string() ++ ")"
    }
    if name == "cwd" {
        return world.cwd
    }
    if name == "mode" {
        return world.mode_name ++ ":" ++ world.active_buffer().major_mode
    }
    if name == "point" {
        return world.active_buffer().point.to_string()
    }
    if mgr.scratch_env.contains_key(name) {
        return mgr.scratch_env.get(name)
    }
    let opt_v = lookup_option_value(world, name)
    if opt_v != null {
        return opt_v
    }
    error ("unknown identifier: " ++ name)
}

private fn eval_builtin_call(
    kernel: SystemKernel,
    world: EditorWorld,
    fn_name: String,
    args: List,
) -> !String Any {
    when {
        fn_name == "len" and args.len() == 1 => {
            let v = args.get(0)
            if v matches _: String {
                return v.as(String).char_len()
            }
            if v matches _: List {
                return v.as(List).len()
            }
            error "len() expects String or List"
        },
        fn_name == "upper" and args.len() == 1 => format_eval_value(args.get(0)).to_upper(),
        fn_name == "lower" and args.len() == 1 => format_eval_value(args.get(0)).to_lower(),
        fn_name == "trim" and args.len() == 1 => format_eval_value(args.get(0)).trim(),
        fn_name == "buffer_count" and args.is_empty() => world.buffer_order.len(),
        fn_name == "command_count" and args.is_empty() => kernel.commands.keys().len(),
        fn_name == "extension_count" and args.is_empty() => kernel.ext_order.len(),
        fn_name == "service_count" and args.is_empty() => kernel.services.keys().len(),
        fn_name == "active_buffer" and args.is_empty() => world.active_buffer().name,
        fn_name == "option" and args.len() == 1 => {
            let k = format_eval_value(args.get(0))
            let ov? = lookup_option_value(world, k) else {
                return error ("unknown option: " ++ k)
            }
            ov
        },
        else => error ("unknown function or wrong arity: " ++ fn_name),
    }
}

private fn peek_tok(st: ExprStream) -> ?ExprTok {
    if st.pos >= st.tokens.len() {
        return null
    }
    st.tokens.get(st.pos.as(usize)).as(ExprTok)
}

private fn match_op(st: ExprStream, sym: String) -> bool {
    let t? = peek_tok(st) else {
        return false
    }
    t match {
        ExprTok.op(s) => {
            if s == sym {
                st.pos += 1
                true
            } else {
                false
            }
        },
        _ => false,
    }
}

private fn eval_or_expr(
    st: ExprStream,
    kernel: SystemKernel,
    world: EditorWorld,
    mgr: ToolsManager,
) -> !String Any {
    var lhs = eval_and_expr(st, kernel, world, mgr)!
    while match_op(st, "or") {
        let rhs = eval_and_expr(st, kernel, world, mgr)!
        lhs = parse_bool_val(lhs)! or parse_bool_val(rhs)!
    }
    lhs
}

private fn eval_and_expr(
    st: ExprStream,
    kernel: SystemKernel,
    world: EditorWorld,
    mgr: ToolsManager,
) -> !String Any {
    var lhs = eval_cmp_expr(st, kernel, world, mgr)!
    while match_op(st, "and") {
        let rhs = eval_cmp_expr(st, kernel, world, mgr)!
        lhs = parse_bool_val(lhs)! and parse_bool_val(rhs)!
    }
    lhs
}

private fn as_num_f64(v: Any) -> ?f64 {
    if v matches _: i64 {
        return v.as(i64).as(f64)
    }
    if v matches _: f64 {
        return v.as(f64)
    }
    null
}

private fn eval_cmp_expr(
    st: ExprStream,
    kernel: SystemKernel,
    world: EditorWorld,
    mgr: ToolsManager,
) -> !String Any {
    var lhs = eval_add_expr(st, kernel, world, mgr)!
    while true {
        let t? = peek_tok(st) else {
            break
        }
        let op_sym = t match {
            ExprTok.op(s) => {
                if s == "==" or s == "!=" or s == "<" or s == "<=" or s == ">" or s == ">=" {
                    s
                } else {
                    ""
                }
            },
            _ => "",
        }
        if op_sym == "" {
            break
        }
        st.pos += 1
        let rhs = eval_add_expr(st, kernel, world, mgr)!
        if op_sym == "==" {
            lhs = lhs == rhs
        } else if op_sym == "!=" {
            lhs = lhs != rhs
        } else {
            let ln? = as_num_f64(lhs) else {
                return error ("ordered comparison requires numbers")
            }
            let rn? = as_num_f64(rhs) else {
                return error ("ordered comparison requires numbers")
            }
            lhs = when {
                op_sym == "<" => ln < rn,
                op_sym == "<=" => ln <= rn,
                op_sym == ">" => ln > rn,
                else => ln >= rn,
            }
        }
    }
    lhs
}

private fn eval_add_expr(
    st: ExprStream,
    kernel: SystemKernel,
    world: EditorWorld,
    mgr: ToolsManager,
) -> !String Any {
    var lhs = eval_mul_expr(st, kernel, world, mgr)!
    while true {
        if match_op(st, "++") {
            let rhs = eval_mul_expr(st, kernel, world, mgr)!
            lhs = format_eval_value(lhs) ++ format_eval_value(rhs)
        } else if match_op(st, "+") {
            let rhs = eval_mul_expr(st, kernel, world, mgr)!
            if (lhs matches _: i64) and (rhs matches _: i64) {
                lhs = lhs.as(i64) + rhs.as(i64)
            } else {
                let lf? = as_num_f64(lhs) else {
                    return error "operator '+' requires numeric operands (use '++' for strings)"
                }
                let rf? = as_num_f64(rhs) else {
                    return error "operator '+' requires numeric operands (use '++' for strings)"
                }
                lhs = lf + rf
            }
        } else if match_op(st, "-") {
            let rhs = eval_mul_expr(st, kernel, world, mgr)!
            if (lhs matches _: i64) and (rhs matches _: i64) {
                lhs = lhs.as(i64) - rhs.as(i64)
            } else {
                let lf? = as_num_f64(lhs) else {
                    return error "operator '-' requires numeric operands"
                }
                let rf? = as_num_f64(rhs) else {
                    return error "operator '-' requires numeric operands"
                }
                lhs = lf - rf
            }
        } else {
            break
        }
    }
    lhs
}

private fn eval_mul_expr(
    st: ExprStream,
    kernel: SystemKernel,
    world: EditorWorld,
    mgr: ToolsManager,
) -> !String Any {
    var lhs = eval_unary_expr(st, kernel, world, mgr)!
    while true {
        if match_op(st, "*") {
            let rhs = eval_unary_expr(st, kernel, world, mgr)!
            if (lhs matches _: i64) and (rhs matches _: i64) {
                lhs = lhs.as(i64) * rhs.as(i64)
            } else {
                let lf? = as_num_f64(lhs) else {
                    return error "operator '*' requires numeric operands"
                }
                let rf? = as_num_f64(rhs) else {
                    return error "operator '*' requires numeric operands"
                }
                lhs = lf * rf
            }
        } else if match_op(st, "/") {
            let rhs = eval_unary_expr(st, kernel, world, mgr)!
            if (lhs matches _: i64) and (rhs matches _: i64) {
                let ri = rhs.as(i64)
                if ri == 0 {
                    return error "division by zero"
                }
                lhs = lhs.as(i64) / ri
            } else {
                let lf? = as_num_f64(lhs) else {
                    return error "operator '/' requires numeric operands"
                }
                let rf? = as_num_f64(rhs) else {
                    return error "operator '/' requires numeric operands"
                }
                if rf == 0.0 {
                    return error "division by zero"
                }
                lhs = lf / rf
            }
        } else if match_op(st, "%") {
            let rhs = eval_unary_expr(st, kernel, world, mgr)!
            if (lhs matches _: i64) and (rhs matches _: i64) {
                let ri = rhs.as(i64)
                if ri == 0 {
                    return error "modulo by zero"
                }
                lhs = lhs.as(i64) % ri
            } else {
                return error "operator '%' requires integer operands"
            }
        } else {
            break
        }
    }
    lhs
}

private fn eval_unary_expr(
    st: ExprStream,
    kernel: SystemKernel,
    world: EditorWorld,
    mgr: ToolsManager,
) -> !String Any {
    if match_op(st, "-") {
        let v = eval_unary_expr(st, kernel, world, mgr)!
        if v matches _: i64 {
            return -(v.as(i64))
        }
        let f? = as_num_f64(v) else {
            return error "unary '-' requires numeric operand"
        }
        return -f
    }
    if match_op(st, "not") {
        let v = eval_unary_expr(st, kernel, world, mgr)!
        return not parse_bool_val(v)!
    }
    eval_primary_expr(st, kernel, world, mgr)
}

private fn eval_primary_expr(
    st: ExprStream,
    kernel: SystemKernel,
    world: EditorWorld,
    mgr: ToolsManager,
) -> !String Any {
    let tok? = peek_tok(st) else {
        return error "unexpected end of expression"
    }
    st.pos += 1
    tok match {
        ExprTok.int_lit(n) => n,
        ExprTok.float_lit(f) => f,
        ExprTok.str_lit(s) => s,
        ExprTok.l_paren => {
            let inner = eval_or_expr(st, kernel, world, mgr)!
            let close_opt = peek_tok(st)
            if close_opt == null or (not (close_opt.as(ExprTok) matches ExprTok.r_paren)) {
                return error "expected ')'"
            }
            st.pos += 1
            inner
        },
        ExprTok.l_bracket => {
            let items = List()
            let next_opt = peek_tok(st)
            if next_opt != null and (next_opt.as(ExprTok) matches ExprTok.r_bracket) {
                st.pos += 1
                return items
            }
            while true {
                items.push(eval_or_expr(st, kernel, world, mgr)!)
                let sep_opt = peek_tok(st)
                if sep_opt != null and (sep_opt.as(ExprTok) matches ExprTok.comma) {
                    st.pos += 1
                    continue
                }
                if sep_opt != null and (sep_opt.as(ExprTok) matches ExprTok.r_bracket) {
                    st.pos += 1
                    break
                }
                return error "expected ',' or ']' in list literal"
            }
            items
        },
        ExprTok.ident(name) => {
            let next_opt = peek_tok(st)
            if next_opt != null and (next_opt.as(ExprTok) matches ExprTok.l_paren) {
                st.pos += 1
                let call_args = List()
                let after_lp = peek_tok(st)
                if after_lp != null and (after_lp.as(ExprTok) matches ExprTok.r_paren) {
                    st.pos += 1
                    return eval_builtin_call(kernel, world, name, call_args)!
                }
                while true {
                    call_args.push(eval_or_expr(st, kernel, world, mgr)!)
                    let sep_opt = peek_tok(st)
                    if sep_opt != null and (sep_opt.as(ExprTok) matches ExprTok.comma) {
                        st.pos += 1
                        continue
                    }
                    if sep_opt != null and (sep_opt.as(ExprTok) matches ExprTok.r_paren) {
                        st.pos += 1
                        break
                    }
                    return error ("expected ',' or ')' in call to " ++ name)
                }
                return eval_builtin_call(kernel, world, name, call_args)!
            }
            inspect_symbol(kernel, world, mgr, name)!
        },
        _ => error "unexpected token in expression",
    }
}

private fn split_call_words(src: String) -> List {
    let words = List()
    let n = src.char_len()
    var i: i64 = 0
    while i < n {
        while i < n and (src.slice(i, i + 1) == " " or src.slice(i, i + 1) == "\t") {
            i += 1
        }
        if i >= n {
            break
        }
        if src.slice(i, i + 1) == "\"" {
            var j = i + 1
            var w = ""
            while j < n {
                let c = src.slice(j, j + 1)
                if c == "\\" and j + 1 < n {
                    w = w ++ src.slice(j + 1, j + 2)
                    j += 2
                    continue
                }
                if c == "\"" {
                    j += 1
                    break
                }
                w = w ++ c
                j += 1
            }
            words.push(w)
            i = j
        } else {
            var j = i
            while j < n and src.slice(j, j + 1) != " " and src.slice(j, j + 1) != "\t" {
                j += 1
            }
            words.push(src.slice(i, j))
            i = j
        }
    }
    words
}

private fn eval_parsed_rhs(
    rhs: String,
    kernel: SystemKernel,
    world: EditorWorld,
    mgr: ToolsManager,
) -> !String Any {
    let toks = tokenize_expr(rhs)!
    if toks.is_empty() {
        return error "empty expression"
    }
    let st = ExprStream { tokens: toks, pos: 0 }
    let val = eval_or_expr(st, kernel, world, mgr)!
    if st.pos < st.tokens.len() {
        return error "unexpected trailing tokens in expression"
    }
    val
}

pub fn eval_lava_expression(
    kernel: SystemKernel,
    expr: String,
) -> #[log_event, status_emit, clipboard_get, clipboard_set] !String String {
    let world = require_editor_world(kernel)!
    let mgr = require_tools_manager(kernel)!
    let clean = strip_comment_outside_quotes(expr).trim()
    if clean == "" {
        return ""
    }

    if clean.starts_with("let ") {
        let rest = clean.drop(4).trim()
        let pair? = rest.split_once("=") else {
            return error "syntax error in let binding: expected 'let <name> = <expr>'"
        }
        let (raw_name, raw_rhs) = pair
        let var_name = raw_name.trim()
        if var_name == "" {
            return error "empty variable name in let binding"
        }
        let val = eval_parsed_rhs(raw_rhs.trim(), kernel, world, mgr)!
        mgr.scratch_env.insert(var_name, val)
        return format_eval_value(val)
    }

    if clean.starts_with("set ") {
        let rest = clean.drop(4).trim()
        let eq_opt = rest.split_once("=")
        if eq_opt != null {
            let (k_part, v_part) = eq_opt.as((String, String))
            let val = eval_parsed_rhs(v_part.trim(), kernel, world, mgr)!
            return apply_set_option(kernel, world, k_part.trim(), val)!
        }
        let sp_opt = rest.split_once(" ")
        if sp_opt != null {
            let (k_part, v_part) = sp_opt.as((String, String))
            let val = eval_parsed_rhs(v_part.trim(), kernel, world, mgr)!
            return apply_set_option(kernel, world, k_part.trim(), val)!
        }
        return error "syntax error in set: expected 'set <option> = <value>'"
    }

    if clean.starts_with("call ") {
        let words = split_call_words(clean.drop(5))
        if words.is_empty() {
            return error "syntax error in call: expected 'call <command> [args...]'"
        }
        let cmd_name = words.get(0).as(String)
        let cmd_args = List()
        for i in 1..words.len() {
            cmd_args.push(words.get(i.as(usize)).as(String))
        }
        let turn = tools_dispatch_command(kernel, cmd_name, cmd_args)#!
        return turn match {
            PromptTurn.completed(v) => {
                if v == () or v == null {
                    "ok (" ++ cmd_name ++ ")"
                } else {
                    format_eval_value(v)
                }
            },
            PromptTurn.suspended(req, _) => "suspended (" ++ req.label ++ ")",
        }
    }

    let val = eval_parsed_rhs(clean, kernel, world, mgr)!
    format_eval_value(val)
}

pub fn eval_scratch_at_point(
    kernel: SystemKernel,
) -> #[log_event, status_emit, clipboard_get, clipboard_set] !String String {
    let world = require_editor_world(kernel)!
    let buf = world.active_buffer()
    let row = buf.point.row
    let raw_line = buf.line_at(row)
    let expr_part = strip_comment_outside_quotes(raw_line).trim()
    if expr_part == "" {
        status_emit("(No expression on current line)")#
        return ""
    }
    let result_str = eval_lava_expression(kernel, expr_part)#!
    if not buf.read_only {
        let annotated = expr_part ++ " -- => " ++ result_str
        buf.set_line_at(row, annotated)
        buf.modified = true
        buf.point = buf.clamp_pos(Pos.new(row, annotated.char_len()), insert_mode = true)
        buf.checkpoint(buf.point, "eval-scratch-line")
    } else {
        let scratch_opt = world.buffer(world.scratch_id)
        if scratch_opt != null {
            let sb = scratch_opt.as(Buffer)
            sb.push_line(expr_part ++ " -- => " ++ result_str)
            sb.modified = true
        }
    }
    status_emit("=> " ++ result_str)#
    result_str
}

-- ============================================================================
-- 7. Mode-Specific Special Buffer Key Handler (`tools_handle_key`)
-- ============================================================================

private fn handle_dired_key(
    kernel: SystemKernel,
    world: EditorWorld,
    mgr: ToolsManager,
    buf: Buffer,
    stroke: KeyStroke,
) -> #[log_event, status_emit, clipboard_get, clipboard_set] !String bool {
    if stroke.alt or stroke.super_mod {
        return false
    }
    let state? = mgr.dired_states.get(buf.id) else {
        refresh_dired_buffer(kernel, buf.id, preserve_marks = false)!
        return true
    }
    let dstate = state.as(DiredState)

    if stroke.ctrl {
        if stroke.key == "n" {
            dired_move_row(buf, 1)
            return true
        }
        if stroke.key == "p" {
            dired_move_row(buf, -1)
            return true
        }
        return false
    }

    let k = stroke.key
    if k == "j" or k == "n" or k == "Down" {
        dired_move_row(buf, 1)
        return true
    }
    if k == "k" or k == "p" or k == "Up" {
        dired_move_row(buf, -1)
        return true
    }
    if k == "Return" or k == "o" {
        let ent? = dired_entry_at_row(dstate, buf.point.row) else {
            return true
        }
        if ent.is_dir {
            let focus = if ent.name == ".." {
                let fn_opt = path.file_name(dstate.dir_path)
                if fn_opt != null { fn_opt.as(String) } else { "" }
            } else {
                ""
            }
            let _ = open_dired(kernel, ent.full_path, focus_name = focus)#!
        } else {
            world.jumps.record(buf.id, buf.file_path, buf.point)
            let opened = world.open_file(ent.full_path)#!
            world.jumps.record(opened.id, opened.file_path, opened.point)
            kernel.emit_hook("buffer-switched", opened.id)
        }
        return true
    }
    if k == "^" or k == "-" {
        let parent_opt = path.parent(dstate.dir_path)
        if parent_opt != null {
            let cur_base_opt = path.file_name(dstate.dir_path)
            let cur_base = if cur_base_opt != null { cur_base_opt.as(String) } else { "" }
            let _ = open_dired(kernel, parent_opt.as(String), focus_name = cur_base)#!
        } else {
            status_emit("Already at filesystem root")#
        }
        return true
    }
    if k == "m" {
        let ent_opt = dired_set_row_mark(buf, dstate, buf.point.row, "*")
        dired_move_row(buf, 1)
        if ent_opt != null {
            let ent = ent_opt.as(DiredEntry)
            if ent.name != ".." {
                status_emit("Marked " ++ ent.name)#
            }
        }
        return true
    }
    if k == "d" {
        let ent_opt = dired_set_row_mark(buf, dstate, buf.point.row, "D")
        dired_move_row(buf, 1)
        if ent_opt != null {
            let ent = ent_opt.as(DiredEntry)
            if ent.name != ".." {
                status_emit("Flagged " ++ ent.name ++ " for deletion")#
            }
        }
        return true
    }
    if k == "u" {
        let ent_opt = dired_set_row_mark(buf, dstate, buf.point.row, " ")
        dired_move_row(buf, 1)
        if ent_opt != null {
            status_emit("Unmarked " ++ ent_opt.as(DiredEntry).name)#
        }
        return true
    }
    if k == "U" {
        buf.read_only = false
        for i in 0..dstate.entries.len() {
            let e = dstate.entries.get(i.as(usize)).as(DiredEntry)
            e.mark_flag = " "
            buf.set_line_at(e.line_row, render_dired_entry_line(e))
        }
        buf.modified = false
        buf.read_only = true
        status_emit("Unmarked all items")#
        return true
    }
    if k == "x" {
        let _ = tools_dispatch_command(kernel, "dired-do-flagged-delete", [])#!
        return true
    }
    if k == "+" {
        let _ = tools_dispatch_command(kernel, "dired-create-directory", [])#!
        return true
    }
    if k == "R" {
        let _ = tools_dispatch_command(kernel, "dired-do-rename", [])#!
        return true
    }
    if k == "C" {
        let _ = tools_dispatch_command(kernel, "dired-do-copy", [])#!
        return true
    }
    if k == "g" {
        refresh_dired_buffer(kernel, buf.id, preserve_marks = true)!
        status_emit("Reverted dired " ++ dstate.dir_path)#
        return true
    }
    if k == "q" {
        let next_id = world.cycle_buffer(-1)
        kernel.emit_hook("buffer-switched", next_id)
        status_emit("Buried dired buffer")#
        return true
    }
    false
}

private fn handle_results_key(
    kernel: SystemKernel,
    world: EditorWorld,
    buf: Buffer,
    stroke: KeyStroke,
) -> #[log_event, status_emit] !String bool {
    if stroke.ctrl and (not stroke.alt) and stroke.key == "g" {
        if not world.active_jobs.is_empty() {
            let _ = tools_cancel_active_jobs(kernel)#!
            return true
        }
        return false
    }
    if stroke.alt or stroke.super_mod {
        return false
    }
    if stroke.ctrl {
        if stroke.key == "n" {
            buf.point = buf.clamp_pos(Pos.new(buf.point.row + 1, 0), insert_mode = false)
            return true
        }
        if stroke.key == "p" {
            buf.point = buf.clamp_pos(Pos.new(buf.point.row - 1, 0), insert_mode = false)
            return true
        }
        return false
    }
    let k = stroke.key
    if k == "j" or k == "n" or k == "Down" {
        buf.point = buf.clamp_pos(Pos.new(buf.point.row + 1, 0), insert_mode = false)
        return true
    }
    if k == "k" or k == "p" or k == "Up" {
        buf.point = buf.clamp_pos(Pos.new(buf.point.row - 1, 0), insert_mode = false)
        return true
    }
    if k == "Return" or k == "o" {
        let _ = jump_from_results_buffer_row(kernel, buf)#!
        return true
    }
    if k == "q" {
        let next_id = world.cycle_buffer(-1)
        kernel.emit_hook("buffer-switched", next_id)
        status_emit("Closed " ++ buf.name)#
        return true
    }
    false
}

private fn handle_org_key(
    kernel: SystemKernel,
    world: EditorWorld,
    mgr: ToolsManager,
    buf: Buffer,
    stroke: KeyStroke,
) -> #status_emit !String bool {
    if mgr.pending_prefix == "C-c" {
        mgr.pending_prefix = ""
        world.pending_keys_display = ""
        world.which_key_items = List()
        if (stroke.ctrl and stroke.key == "t") or ((not stroke.ctrl) and stroke.key == "t") {
            let _ = org_todo_at_point(kernel)#!
            return true
        }
        if (stroke.ctrl and stroke.key == "g") or stroke.key == "Escape" {
            status_emit("Quit")#
            return true
        }
        status_emit("<C-c> " ++ stroke.key ++ " is undefined")#
        return true
    }

    if stroke.ctrl and (not stroke.alt) and (not stroke.super_mod) and stroke.key == "c" {
        mgr.pending_prefix = "C-c"
        world.pending_keys_display = "<C-c>"
        world.which_key_items = [
            ("t", "org-todo (cycle TODO / checkbox)"),
            ("<C-t>", "org-todo"),
            ("<Esc>", "cancel"),
        ]
        status_emit("C-c-")#
        return true
    }

    if (not stroke.ctrl) and (not stroke.alt) and (not stroke.super_mod) {
        if stroke.key == "q" and buf.read_only and buf.name.starts_with("*Markdown Preview:") {
            let next_id = world.cycle_buffer(-1)
            kernel.emit_hook("buffer-switched", next_id)
            status_emit("Closed " ++ buf.name)#
            return true
        }
        if stroke.key == "Tab" or stroke.key == "\t" {
            if (not is_row_inside_md_fence_or_frontmatter(buf, buf.point.row))
                and heading_level(buf.line_at(buf.point.row), buf.major_mode) > 0 {
                return org_cycle_at_point(kernel)#!
            }
        }
    }
    false
}

pub fn tools_handle_key(
    kernel: SystemKernel,
    stroke: KeyStroke,
) -> #[log_event, status_emit, clipboard_get, clipboard_set] !String bool {
    if not kernel.is_extension_active(ext_tools_id()) {
        return false
    }
    let world = require_editor_world(kernel)!
    let mgr = require_tools_manager(kernel)!
    let buf = world.active_buffer()
    let mode = buf.major_mode

    if mode == "dired" {
        if mgr.pending_prefix != "" {
            mgr.pending_prefix = ""
            world.pending_keys_display = ""
            world.which_key_items = List()
        }
        return handle_dired_key(kernel, world, mgr, buf, stroke)#!
    }
    if mode == "grep" or mode == "compilation" {
        if mgr.pending_prefix != "" {
            mgr.pending_prefix = ""
            world.pending_keys_display = ""
            world.which_key_items = List()
        }
        return handle_results_key(kernel, world, buf, stroke)#!
    }
    if mode == "org" or is_md_mode(mode) {
        return handle_org_key(kernel, world, mgr, buf, stroke)#!
    }
    if mgr.pending_prefix != "" {
        mgr.pending_prefix = ""
        world.pending_keys_display = ""
        world.which_key_items = List()
    }
    false
}

-- ============================================================================
-- 8. Extension Registration (`lava.org/ext_tools`)
-- ============================================================================

private fn join_string_args(args: List) -> String {
    if args.is_empty() {
        return ""
    }
    let parts = List()
    for i in 0..args.len() {
        parts.push(args.get(i.as(usize)).as(String))
    }
    parts.join(" ")
}

private fn cmd_dired(kern: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let raw = if not args.is_empty() { args.get(0).as(String) } else { "" }
    let b = open_dired(kern, raw)#!
    b.id
}

private fn cmd_dired_up_directory(kern: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let w = require_editor_world(kern)!
    let m = require_tools_manager(kern)!
    let b = w.active_buffer()
    let ds_opt = m.dired_states.get(b.id)
    let cur_dir = if ds_opt != null {
        ds_opt.as(DiredState).dir_path
    } else if b.file_path != "" {
        b.file_path
    } else {
        w.cwd
    }
    let parent_opt = path.parent(cur_dir)
    if parent_opt != null {
        let base_opt = path.file_name(cur_dir)
        let base = if base_opt != null { base_opt.as(String) } else { "" }
        let _ = open_dired(kern, parent_opt.as(String), focus_name = base)#!
    } else {
        status_emit("Already at filesystem root")#
    }
    ()
}

private fn cmd_dired_do_flagged_delete(kern: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let w = require_editor_world(kern)!
    let m = require_tools_manager(kern)!
    let b = w.active_buffer()
    let ds? = m.dired_states.get(b.id) else {
        status_emit("Not in a Dired buffer")#
        return 0
    }
    let dstate = ds.as(DiredState)
    let flagged = List()
    for i in 0..dstate.entries.len() {
        let e = dstate.entries.get(i.as(usize)).as(DiredEntry)
        if e.mark_flag == "D" and e.name != ".." {
            flagged.push(e)
        }
    }
    if flagged.is_empty() {
        status_emit("(No deletions requested)")#
        return 0
    }
    let prompt_label = "Delete " ++ flagged.len().to_string() ++ " flagged item(s)? (y/n)"
    let ans? = ask_prompt(PromptRequest {
        label: prompt_label,
        initial: "",
        kind: PromptKind.confirm,
        candidates: ["y", "n"],
    })# else {
        status_emit("Deletion cancelled")#
        return 0
    }
    let norm = ans.trim().to_lower()
    if norm != "y" and norm != "yes" {
        status_emit("Deletion cancelled")#
        return 0
    }
    var deleted: i64 = 0
    for i in 0..flagged.len() {
        let item = flagged.get(i.as(usize)).as(DiredEntry)
        if item.is_dir {
            let res = fs.remove_dir(item.full_path, recursive = true)
            res match {
                _! => { deleted += 1 },
                error err => {
                    log_event("warn", "ext_tools", "Failed removing dir " ++ item.full_path ++ ": " ++ err.to_string())#
                },
            }
        } else {
            let res = fs.remove_file(item.full_path)
            res match {
                _! => { deleted += 1 },
                error err => {
                    log_event("warn", "ext_tools", "Failed removing file " ++ item.full_path ++ ": " ++ err.to_string())#
                },
            }
        }
    }
    refresh_dired_buffer(kern, b.id, preserve_marks = true)!
    status_emit("Deleted " ++ deleted.to_string() ++ " item(s)")#
    deleted
}

private fn cmd_dired_create_directory(kern: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let w = require_editor_world(kern)!
    let m = require_tools_manager(kern)!
    let b = w.active_buffer()
    let ds? = m.dired_states.get(b.id) else {
        return error "dired-create-directory requires an active Dired buffer"
    }
    let dstate = ds.as(DiredState)
    let raw_name = if (not args.is_empty()) and args.get(0).as(String).trim() != "" {
        args.get(0).as(String)
    } else {
        let ans? = ask_prompt(PromptRequest {
            label: "Create directory: ",
            initial: "",
            kind: PromptKind.file_path,
            candidates: List(),
        })# else {
            status_emit("Quit")#
            return ()
        }
        ans
    }
    if raw_name.trim() == "" {
        status_emit("Empty directory name")#
        return ()
    }
    let target = resolve_in_dir(dstate.dir_path, raw_name)
    let res = fs.create_dir(target, parents = true)
    res match {
        _! => (),
        error err => return error ("create_dir failed: " ++ err.to_string()),
    }
    let fn_opt = path.file_name(target)
    let focus = if fn_opt != null { fn_opt.as(String) } else { "" }
    refresh_dired_buffer(kern, b.id, preserve_marks = true, focus_name = focus)!
    status_emit("Created directory: " ++ target)#
    target
}

private fn cmd_dired_do_rename(kern: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let w = require_editor_world(kern)!
    let m = require_tools_manager(kern)!
    let b = w.active_buffer()
    let ds? = m.dired_states.get(b.id) else {
        return error "dired-do-rename requires an active Dired buffer"
    }
    let dstate = ds.as(DiredState)
    let targets = dired_marked_or_current_entries(dstate, b.point.row)
    if targets.is_empty() {
        status_emit("No file or directory selected to rename")#
        return ()
    }
    let first = targets.get(0).as(DiredEntry)
    let raw_dest = if (not args.is_empty()) and args.get(0).as(String).trim() != "" {
        args.get(0).as(String)
    } else {
        let prompt_lbl = if targets.len() == 1 {
            "Rename " ++ first.name ++ " to: "
        } else {
            "Move " ++ targets.len().to_string() ++ " items into directory: "
        }
        let ans? = ask_prompt(PromptRequest {
            label: prompt_lbl,
            initial: if targets.len() == 1 { first.name } else { "" },
            kind: PromptKind.file_path,
            candidates: List(),
        })# else {
            status_emit("Quit")#
            return ()
        }
        ans
    }
    if raw_dest.trim() == "" {
        status_emit("Rename cancelled")#
        return ()
    }
    let base_dest = resolve_in_dir(dstate.dir_path, raw_dest)
    var last_name = ""
    for i in 0..targets.len() {
        let ent = targets.get(i.as(usize)).as(DiredEntry)
        let final_dest = if targets.len() > 1 or (fs.exists(base_dest) and fs.is_dir(base_dest)) {
            path.join(base_dest, ent.name)
        } else {
            base_dest
        }
        let res = fs.rename(ent.full_path, final_dest)
        res match {
            _! => {
                let open_opt = w.find_buffer_by_path(ent.full_path)
                if open_opt != null {
                    let ob = open_opt.as(Buffer)
                    ob.file_path = final_dest
                    let bn_opt = path.file_name(final_dest)
                    if bn_opt != null {
                        ob.name = bn_opt.as(String)
                    }
                }
                let fn_opt = path.file_name(final_dest)
                if fn_opt != null {
                    last_name = fn_opt.as(String)
                }
            },
            error err => return error ("rename failed: " ++ err.to_string()),
        }
    }
    refresh_dired_buffer(kern, b.id, preserve_marks = false, focus_name = last_name)!
    status_emit("Renamed/moved " ++ targets.len().to_string() ++ " item(s) -> " ++ base_dest)#
    base_dest
}

private fn cmd_dired_do_copy(kern: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let w = require_editor_world(kern)!
    let m = require_tools_manager(kern)!
    let b = w.active_buffer()
    let ds? = m.dired_states.get(b.id) else {
        return error "dired-do-copy requires an active Dired buffer"
    }
    let dstate = ds.as(DiredState)
    let targets = dired_marked_or_current_entries(dstate, b.point.row)
    if targets.is_empty() {
        status_emit("No file selected to copy")#
        return ()
    }
    let first = targets.get(0).as(DiredEntry)
    if first.is_dir {
        status_emit("Directory recursive copy not supported; select a file")#
        return ()
    }
    let raw_dest = if (not args.is_empty()) and args.get(0).as(String).trim() != "" {
        args.get(0).as(String)
    } else {
        let ans? = ask_prompt(PromptRequest {
            label: "Copy " ++ first.name ++ " to: ",
            initial: "",
            kind: PromptKind.file_path,
            candidates: List(),
        })# else {
            status_emit("Quit")#
            return ()
        }
        ans
    }
    if raw_dest.trim() == "" {
        status_emit("Copy cancelled")#
        return ()
    }
    let base_dest = resolve_in_dir(dstate.dir_path, raw_dest)
    var copied_count: i64 = 0
    var last_name = ""
    for i in 0..targets.len() {
        let ent = targets.get(i.as(usize)).as(DiredEntry)
        if ent.is_dir {
            continue
        }
        let final_dest = if targets.len() > 1 or (fs.exists(base_dest) and fs.is_dir(base_dest)) {
            path.join(base_dest, ent.name)
        } else {
            base_dest
        }
        let res = fs.copy(ent.full_path, final_dest)
        res match {
            _! => {
                copied_count += 1
                let fn_opt = path.file_name(final_dest)
                if fn_opt != null {
                    last_name = fn_opt.as(String)
                }
            },
            error err => return error ("copy failed: " ++ err.to_string()),
        }
    }
    refresh_dired_buffer(kern, b.id, preserve_marks = false, focus_name = last_name)!
    status_emit("Copied " ++ copied_count.to_string() ++ " file(s) -> " ++ base_dest)#
    base_dest
}

