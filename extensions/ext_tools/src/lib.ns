private fn md_prev_disp_w(s: String) -> i64 {
    if s.is_ascii() {
        return s.len()
    }
    let n = s.char_len()
    var w: i64 = 0
    for i in 0..n {
        w += if s.slice(i, i + 1).len() >= 3 { 2 } else { 1 }
    }
    w
}

private fn md_prev_pad_cell(text: String, width: i64, align: String) -> String {
    let w = md_prev_disp_w(text)
    if w >= width {
        return text
    }
    let rem = width - w
    if align == "right" {
        return " ".repeat(rem) ++ text
    }
    if align == "center" {
        let lpad = rem / 2
        let rpad = rem - lpad
        return " ".repeat(lpad) ++ text ++ " ".repeat(rpad)
    }
    text ++ " ".repeat(rem)
}

private fn md_prev_split_table_cells(line: String) -> List {
    let t = line.trim()
    let s0 = if t.starts_with("|") { t.drop(1) } else { t }
    let body = if s0.ends_with("|") and (not s0.ends_with("\\|")) {
        s0.slice(0, s0.char_len() - 1)
    } else {
        s0
    }
    let cells = List()
    let n = body.char_len()
    var cur = ""
    var in_bt = false
    var i: i64 = 0
    while i < n {
        let ch = body.slice(i, i + 1)
        if ch == "\\" and i + 1 < n and body.slice(i + 1, i + 2) == "|" {
            cur = cur ++ "|"
            i += 2
            continue
        }
        if ch == "`" {
            in_bt = not in_bt
            cur = cur ++ ch
            i += 1
            continue
        }
        if (not in_bt) and ch == "|" {
            cells.push(cur.trim())
            cur = ""
            i += 1
            continue
        }
        cur = cur ++ ch
        i += 1
    }
    cells.push(cur.trim())
    cells
}

private fn md_prev_is_sep_row(line: String) -> ?List {
    let t = line.trim()
    if (not t.contains("|")) or (not t.contains("-")) {
        return null
    }
    let cells = md_prev_split_table_cells(t)
    if cells.is_empty() {
        return null
    }
    let aligns = List()
    for i in 0..cells.len() {
        let c = cells.get(i.as(usize)).as(String)
        let n = c.char_len()
        if n == 0 {
            return null
        }
        let lc = c.starts_with(":")
        let rc = c.ends_with(":")
        let mid = c.slice(if lc { 1 } else { 0 }, if rc and n > 1 { n - 1 } else { n })
        if mid == "" {
            return null
        }
        for k in 0..mid.char_len() {
            if mid.slice(k, k + 1) != "-" {
                return null
            }
        }
        if lc and rc {
            aligns.push("center")
        } else if rc {
            aligns.push("right")
        } else {
            aligns.push("left")
        }
    }
    aligns
}

private fn render_markdown_preview_lines(src_buf: Buffer) -> List {
    src_buf.sync_external_lines()
    let total = src_buf.line_count()
    let out = List()
    var r: i64 = 0
    var in_fence = false
    var fc: i64 = 0
    var flen: i64 = 0

    if total >= 2 and src_buf.line_at(0).trim_end() == "---" {
        var fm_close: i64 = -1
        let max_fm = if total < 64 { total } else { 64 }
        for k in 1..max_fm {
            let tk = src_buf.line_at(k).trim_end()
            if tk == "---" or tk == "..." {
                fm_close = k
                break
            }
        }
        if fm_close > 0 {
            r = fm_close + 1
        }
    }

    while r < total {
        let ln = src_buf.line_at(r)
        if not in_fence {
            let f_opt = tools_md_fence_open(ln)
            if f_opt != null {
                let (b, l) = f_opt.as((i64, i64))
                in_fence = true
                fc = b
                flen = l
                out.push(ln)
                r += 1
                continue
            }
        } else {
            out.push(ln)
            if tools_md_fence_close(ln, fc, flen) {
                in_fence = false
            }
            r += 1
            continue
        }

        if r + 1 < total and ln.contains("|") {
            let aligns_opt = md_prev_is_sep_row(src_buf.line_at(r + 1))
            if aligns_opt != null {
                let aligns = aligns_opt.as(List)
                let hdr_cells = md_prev_split_table_cells(ln)
                let ncols = if hdr_cells.len() > aligns.len() { hdr_cells.len() } else { aligns.len() }
                let body_rows = List()
                var tr = r + 2
                while tr < total {
                    let tln = src_buf.line_at(tr)
                    if (not tln.contains("|")) or tln.trim() == "" or tools_md_fence_open(tln) != null {
                        break
                    }
                    body_rows.push(md_prev_split_table_cells(tln))
                    tr += 1
                }
                let col_w = List()
                for ci in 0..ncols {
                    let htxt = if ci < hdr_cells.len() { hdr_cells.get(ci.as(usize)).as(String) } else { "" }
                    var mw = md_prev_disp_w(htxt)
                    if mw < 3 {
                        mw = 3
                    }
                    for bi in 0..body_rows.len() {
                        let brow = body_rows.get(bi.as(usize)).as(List)
                        if ci < brow.len() {
                            let cw = md_prev_disp_w(brow.get(ci.as(usize)).as(String))
                            if cw > mw {
                                mw = cw
                            }
                        }
                    }
                    col_w.push(mw)
                }
                let top_parts = List()
                let mid_parts = List()
                let bot_parts = List()
                let hdr_parts = List()
                for ci in 0..ncols {
                    let w = col_w.get(ci.as(usize)).as(i64)
                    let al = if ci < aligns.len() { aligns.get(ci.as(usize)).as(String) } else { "left" }
                    let htxt = if ci < hdr_cells.len() { hdr_cells.get(ci.as(usize)).as(String) } else { "" }
                    top_parts.push("─".repeat(w + 2))
                    mid_parts.push("─".repeat(w + 2))
                    bot_parts.push("─".repeat(w + 2))
                    hdr_parts.push(" " ++ md_prev_pad_cell(htxt, w, al) ++ " ")
                }
                out.push("┌" ++ top_parts.join("┬") ++ "┐")
                out.push("│" ++ hdr_parts.join("│") ++ "│")
                out.push("├" ++ mid_parts.join("┼") ++ "┤")
                for bi in 0..body_rows.len() {
                    let brow = body_rows.get(bi.as(usize)).as(List)
                    let r_parts = List()
                    for ci in 0..ncols {
                        let w = col_w.get(ci.as(usize)).as(i64)
                        let al = if ci < aligns.len() { aligns.get(ci.as(usize)).as(String) } else { "left" }
                        let ctxt = if ci < brow.len() { brow.get(ci.as(usize)).as(String) } else { "" }
                        r_parts.push(" " ++ md_prev_pad_cell(ctxt, w, al) ++ " ")
                    }
                    out.push("│" ++ r_parts.join("│") ++ "│")
                }
                out.push("└" ++ bot_parts.join("┴") ++ "┘")
                r = tr
                continue
            }
        }

        let trimmed = ln.trim_start()
        if trimmed == "---" or trimmed == "***" or trimmed == "___" {
            out.push("────────────────────────────────────────────────────────")
            r += 1
            continue
        }
        if trimmed.starts_with("> [!") {
            let rest = trimmed.drop(2)
            let styled_alert = when {
                rest.starts_with("[!NOTE]") => ">  NOTE: " ++ rest.drop(7).trim(),
                rest.starts_with("[!TIP]") => ">  TIP: " ++ rest.drop(6).trim(),
                rest.starts_with("[!IMPORTANT]") => ">  IMPORTANT: " ++ rest.drop(12).trim(),
                rest.starts_with("[!WARNING]") => ">  WARNING: " ++ rest.drop(10).trim(),
                rest.starts_with("[!CAUTION]") => ">  CAUTION: " ++ rest.drop(10).trim(),
                else => ln,
            }
            out.push(styled_alert)
            r += 1
            continue
        }
        if trimmed.starts_with("- [x] ") or trimmed.starts_with("- [X] ") or trimmed.starts_with("* [x] ") {
            let lead = ln.slice(0, ln.char_len() - trimmed.char_len())
            out.push(lead ++ "- [x] ☑ " ++ trimmed.drop(6))
            r += 1
            continue
        }
        if trimmed.starts_with("- [ ] ") or trimmed.starts_with("* [ ] ") {
            let lead = ln.slice(0, ln.char_len() - trimmed.char_len())
            out.push(lead ++ "- [ ] ☐ " ++ trimmed.drop(6))
            r += 1
            continue
        }
        out.push(ln)
        r += 1
    }
    if out.is_empty() {
        out.push("")
    }
    out
}

private fn cmd_markdown_preview(kern: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kern)!
    let src = world.active_buffer()
    let rendered = render_markdown_preview_lines(src)
    let prev_name = "*Markdown Preview: " ++ src.name ++ "*"
    let existing_opt = world.find_buffer_by_name(prev_name)
    let pbuf = if existing_opt != null {
        let eb = existing_opt.as(Buffer)
        eb.read_only = false
        eb.set_lines(rendered)
        eb.read_only = true
        eb.modified = false
        eb
    } else {
        let nb = world.create_buffer(
            prev_name,
            BufferKind.special,
            major_mode = "markdown",
            initial_lines = rendered,
        )
        nb.read_only = true
        nb.modified = false
        nb
    }
    let _ = world.switch_to_buffer(pbuf.id)
    kern.emit_hook("buffer-switched", pbuf.id)
    status_emit(" Rendered Markdown preview: " ++ prev_name)#
    pbuf.id
}

private fn on_tools_activate(k: SystemKernel) -> !String Unit {
    let ext_id = ext_tools_id()
    let mgr = ToolsManager.new()
    k.publish_service(SERVICE_TOOLS, ext_id, mgr)

    -- Document mode & global Emacs power-tool keybindings (`C-x C-e`, `M-:`, `M-!`, `M-&`)
    let global_km = k.ensure_keymap("emacs-global")
    global_km.bind("<C-x> <C-e>", "eval-scratch-line", ext_id, description = "Evaluate expression on current line")
    global_km.bind("<M-:>", "eval-expression", ext_id, description = "Evaluate live Lava expression")
    global_km.bind("<M-!>", "shell-command", ext_id, description = "Run synchronous shell command")
    global_km.bind("<M-&>", "async-shell-command", ext_id, description = "Run asynchronous shell command")

    let dired_km = k.ensure_keymap("dired")
    dired_km.bind("<Return>", "dired-find-entry", ext_id, description = "Open file or enter directory")
    dired_km.bind("^", "dired-up-directory", ext_id, description = "Go to parent directory")
    dired_km.bind("x", "dired-do-flagged-delete", ext_id, description = "Execute flagged deletions")
    dired_km.bind("+", "dired-create-directory", ext_id, description = "Create directory")
    dired_km.bind("R", "dired-do-rename", ext_id, description = "Rename or move entry")
    dired_km.bind("C", "dired-do-copy", ext_id, description = "Copy file")

    -- 1. Dired commands
    k.register_command(
        "dired",
        ext_id,
        "Open interactive Emacs Dired directory editor (`C-x d`, `:Ex`, `-`).",
        cmd_dired,
    )
    k.register_command(
        "dired-jump",
        ext_id,
        "Jump to Dired buffer for active file's parent directory (`-`).",
        cmd_dired,
    )
    k.register_command(
        "dired-up-directory",
        ext_id,
        "Open parent directory in Dired (`^`).",
        cmd_dired_up_directory,
    )
    k.register_command(
        "dired-do-flagged-delete",
        ext_id,
        "Prompt for confirmation and delete all `D`-flagged entries in Dired (`x`).",
        cmd_dired_do_flagged_delete,
    )
    k.register_command(
        "dired-create-directory",
        ext_id,
        "Create a new directory inside current Dired directory (`+`).",
        cmd_dired_create_directory,
    )
    k.register_command(
        "dired-do-rename",
        ext_id,
        "Rename or move marked/current Dired entry (`R`).",
        cmd_dired_do_rename,
    )
    k.register_command(
        "dired-do-copy",
        ext_id,
        "Copy marked/current file in Dired (`C`).",
        cmd_dired_do_copy,
    )

    -- 2. Occur, Concurrent Project Search, Background Grep & Quickfix
    k.register_command(
        "occur",
        ext_id,
        "List all lines in active buffer matching pattern in `*Occur*` (`M-x occur`).",
        cmd_occur,
    )
    k.register_command(
        "project-search",
        ext_id,
        "Concurrent 4-shard Nessa `async effect` + `Future` workspace search (`M-x project-search`).",
        cmd_project_search,
    )
    k.register_command(
        "grep",
        ext_id,
        "Run non-blocking background `rg`/`grep` and populate `*Grep*` & quickfix (`M-x grep`, `:grep`).",
        cmd_grep,
    )
    k.register_command(
        "next-error",
        ext_id,
        "Jump to next quickfix/grep/compilation diagnostic (`M-x next-error`, `]q`).",
        cmd_next_error,
    )
    k.register_command(
        "cnext",
        ext_id,
        "Jump to next quickfix entry (`:cnext`).",
        cmd_next_error,
    )
    k.register_command(
        "previous-error",
        ext_id,
        "Jump to previous quickfix/grep/compilation diagnostic (`M-x previous-error`, `[q`).",
        cmd_previous_error,
    )
    k.register_command(
        "cprev",
        ext_id,
        "Jump to previous quickfix entry (`:cprev`).",
        cmd_previous_error,
    )

    -- 3. Shell Command, Async Shell & Compile
    k.register_command(
        "shell-command",
        ext_id,
        "Run synchronous shell command and show output in echo area or `*Shell Command Output*` (`M-!`).",
        cmd_shell_command,
    )
    k.register_command(
        "async-shell-command",
        ext_id,
        "Spawn non-blocking background shell command into `*Async Shell Command*` (`M-&`).",
        cmd_async_shell_command,
    )
    k.register_command(
        "compile",
        ext_id,
        "Spawn non-blocking compilation job into `*Compilation*` and populate quickfix (`M-x compile`, `:make`).",
        cmd_compile,
    )
    k.register_command(
        "make",
        ext_id,
        "Run compilation command (`:make`).",
        cmd_compile,
    )
    k.register_command(
        "cancel-bg-jobs",
        ext_id,
        "Cancel running background compilation/grep/shell jobs (`C-g`).",
        cmd_cancel_bg_jobs,
    )
    k.register_command(
        "kill-compilation",
        ext_id,
        "Cancel running compilation job.",
        cmd_cancel_bg_jobs,
    )

    -- 4. Org-Outline, Markdown Preview & Live `*scratch*` Evaluator
    k.register_command(
        "markdown-preview",
        ext_id,
        "Render rich GFM Markdown preview with CJK-aligned box tables and callouts (`:MarkdownPreview`).",
        cmd_markdown_preview,
    )
    k.register_command("ex:MarkdownPreview", ext_id, "Ex `:MarkdownPreview`.", cmd_markdown_preview, interactive = false)
    k.register_command("ex:MdPreview", ext_id, "Ex `:MdPreview`.", cmd_markdown_preview, interactive = false)
    k.register_command(
        "org-cycle",
        ext_id,
        "Toggle subtree visibility (`buf.folded_rows`) on Org/Markdown heading (`<Tab>`).",
        cmd_org_cycle,
    )
    k.register_command(
        "org-todo",
        ext_id,
        "Cycle heading state `* Title` -> `* TODO Title` -> `* DONE Title` -> `* Title` (`C-c C-t`).",
        cmd_org_todo,
    )
    k.register_command(
        "eval-expression",
        ext_id,
        "Evaluate live Lava/SystemKernel expression in the shared VM (`M-x eval-expression`).",
        cmd_eval_expression,
    )
    k.register_command(
        "eval-scratch-line",
        ext_id,
        "Evaluate current `*scratch*` line in live VM and append `-- => <result>` (`C-x C-e`).",
        cmd_eval_scratch_line,
    )
    k.register_command(
        "eval-last-sexp",
        ext_id,
        "Evaluate expression on current line (`C-x C-e`).",
        cmd_eval_scratch_line,
    )
    ()
}

private fn on_tools_deactivate(_k: SystemKernel) -> !String Unit = ()

pub fn register_tools_extension(kernel: SystemKernel) -> !String Unit {
    kernel.register_extension(
        ext_tools_id(),
        "lava.org",
        "ext_tools",
        "0.1.0",
        "Emacs Power Tools: Dired, Occur, async Future-sharded project-search, background grep/compile/shell, Org outline, and live *scratch* evaluator.",
        [ext_document_id()],
        on_tools_activate,
        on_tools_deactivate,
    )
}
