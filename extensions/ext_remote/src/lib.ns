            st_km.bind("<Return>", "remote-status-enter", ext_id, description = "Connect / browse selected SSH host")
            st_km.bind("o", "remote-connect-profile", ext_id, description = "Connect OpenSSH profile")
            st_km.bind("b", "remote-browse", ext_id, description = "Browse remote directory")
