private fn walk_mock_remote_files(
    dir_uri: String,
    q_low: String,
    limit: i64,
    depth: i64,
    out: List,
) {
    if depth > 12 or out.len() >= limit {
        return
    }
    let items = remote_readdir(dir_uri, show_hidden = false) ! { _ => List() }
    for i in 0..items.len() {
        if out.len() >= limit {
            return
        }
        let item = items.get(i.as(usize)).as(RemoteDirItem)
        if item.is_dir {
            if item.name != ".git" and item.name != "target" and item.name != "node_modules" {
                walk_mock_remote_files(item.full_uri, q_low, limit, depth + 1, out)
            }
        } else if q_low == "" or item.full_uri.to_lower().contains(q_low) {
            out.push(item.full_uri)
        }
    }
}

private fn query_remote_files(root_uri: String, query: String, limit: i64) -> !String List {
    if remote_host_available() {
        let rf = remote_search_files_ranked(
            root_uri,
            query,
            include_hidden = false,
            include_dirs = false,
            limit = limit,
        )!
        let out = List()
        for i in 0..rf.items.len() {
            out.push(rf.items.get(i.as(usize)).as(RemoteRankedFile).full_uri)
        }
        return out
    }
    let out = List()
    walk_mock_remote_files(root_uri, query.trim().to_lower(), limit, 0, out)
    out
}

private fn query_remote_grep(root_uri: String, pattern: String, limit: i64) -> !String List {
    if remote_host_available() {
        let (_, hits) = remote_search_grep_ext(root_uri, pattern, limit = limit)!
        return hits
    }
    let files = List()
    walk_mock_remote_files(root_uri, "", 400, 0, files)
    let pat_low = pattern.to_lower()
    let out = List()
    for fi in 0..files.len() {
        let furi = files.get(fi.as(usize)).as(String)
        let rl_res = remote_read_lines(furi)
        rl_res match {
            pair! => {
                let (flines, _) = pair
                for r in 0..flines.len() {
                    let ln = flines.get(r.as(usize)).as(String)
                    let hits = ln.to_lower().find_indices(pat_low)
                    if not hits.is_empty() {
                        out.push(RemoteGrepMatch {
                            full_uri: furi,
                            row: r,
                            col: hits.get(0).as(i64),
                            line_text: ln,
                        })
                        if out.len() >= limit {
                            return out
                        }
                    }
                }
            },
            error _ => (),
        }
    }
    out
}

fn cmd_remote_files(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    let raw_arg = if not args.is_empty() { args.get(0).as(String).trim() } else { "" }
    if raw_arg != "" and is_ssh_uri(raw_arg) {
        let st_res = remote_stat(raw_arg)
        st_res match {
            st! => {
                if st.exists and st.is_file {
                    let fbuf = world.open_file(raw_arg)#!
                    sync_wm(kernel, world)
                    ensure_vim_normal(kernel, world)
                    kernel.emit_hook("buffer-opened", fbuf.id)
                    kernel.emit_hook("buffer-switched", fbuf.id)
                    sync_remote_statusline(world, svc)
                    status_emit("Opened remote file: " ++ fbuf.file_path)#
                    return ()
                }
            },
            error _ => (),
        }
    }
    let dir_arg = if raw_arg != "" and is_ssh_uri(raw_arg) { raw_arg } else { "" }
    let filter_q = if raw_arg != "" and (not is_ssh_uri(raw_arg)) { raw_arg } else { "" }
    let root_uri = resolve_remote_project_root(world, svc, dir_arg)
    if root_uri == "" {
        status_emit("RemoteFiles: no active SSH connection (run :RemoteConnect first)")#
        return ()
    }
    let files = query_remote_files(root_uri, filter_q, 300)!
    if files.is_empty() {
        status_emit("RemoteFiles: no files found under " ++ root_uri)#
        return ()
    }
    if filter_q != "" and files.len() == 1 {
        let only_uri = files.get(0).as(String)
        let fbuf = world.open_file(only_uri)#!
        sync_wm(kernel, world)
        ensure_vim_normal(kernel, world)
        kernel.emit_hook("buffer-opened", fbuf.id)
        kernel.emit_hook("buffer-switched", fbuf.id)
        sync_remote_statusline(world, svc)
        status_emit("Opened remote file: " ++ fbuf.file_path)#
        return ()
    }
    let ans? = ask_prompt(PromptRequest.with_candidates(
        "Remote Files (" ++ root_uri ++ "): ",
        "",
        PromptKind.choice,
        files,
    ))# else {
        return ()
    }
    let chosen = ans.trim()
    if chosen == "" {
        return ()
    }
    let target_uri = if is_ssh_uri(chosen) { chosen } else { join_ssh_uri(root_uri, chosen) }
    let fbuf = world.open_file(target_uri)#!
    sync_wm(kernel, world)
    ensure_vim_normal(kernel, world)
    kernel.emit_hook("buffer-opened", fbuf.id)
    kernel.emit_hook("buffer-switched", fbuf.id)
    sync_remote_statusline(world, svc)
    status_emit("Opened remote file: " ++ fbuf.file_path)#
    ()
}

fn cmd_remote_grep(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    let root_uri = resolve_remote_project_root(world, svc, "")
    if root_uri == "" {
        status_emit("RemoteGrep: no active SSH connection (run :RemoteConnect first)")#
        return ()
    }
    var pattern = if not args.is_empty() { args.join(" ").trim() } else { "" }
    if pattern == "" {
        let ans? = ask_prompt(PromptRequest.text("Remote Grep (" ++ root_uri ++ "): ", ""))# else {
            return ()
        }
        pattern = ans.trim()
    }
    if pattern == "" {
        return ()
    }
    let hits = query_remote_grep(root_uri, pattern, 200)!
    let qf = List()
    let lines = List()
    lines.push("Remote Grep in " ++ root_uri ++ " for `" ++ pattern ++ "` (" ++ hits.len().to_string() ++ " hit(s))  [RET: jump | q: close]")
    lines.push("────────────────────────────────────────────────────────────────────────────────")
    for i in 0..hits.len() {
        let h = hits.get(i.as(usize)).as(RemoteGrepMatch)
        qf.push(QuickfixEntry {
            file_path: h.full_uri,
            row: h.row,
            col: h.col,
            text: h.line_text.trim(),
        })
        lines.push(
            h.full_uri ++ ":" ++ (h.row + 1).to_string() ++ ":" ++ (h.col + 1).to_string()
            ++ ": " ++ h.line_text.trim()
        )
    }
    world.quickfix = qf
    world.quickfix_idx = 0
    world.quickfix_title = "Remote Grep: " ++ pattern
    remember_origin_buffer(world, svc)
    let qbuf = world.ensure_special_buffer(REMOTE_QUICKFIX_BUF_NAME, "qf", lines, read_only = true)
    qbuf.point = Pos.new(if qf.is_empty() { 0 } else { 2 }, 0)
    world.active_buffer_id = qbuf.id
    sync_wm(kernel, world)
    ensure_vim_normal(kernel, world)
    kernel.emit_hook("buffer-switched", qbuf.id)
    status_emit("Remote Grep `" ++ pattern ++ "`: " ++ qf.len().to_string() ++ " match(es)")#
    ()
}

fn cmd_remote_qf_jump(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    let buf = world.active_buffer()
    let idx = buf.point.row - 2
    if idx < 0 or idx >= world.quickfix.len() {
        return ()
    }
    world.quickfix_idx = idx
    let entry = world.quickfix.get(idx.as(usize)).as(QuickfixEntry)
    let fbuf = world.open_file(entry.file_path)#!
    fbuf.point = fbuf.clamp_pos(Pos.new(entry.row, entry.col), insert_mode = false)
    sync_wm(kernel, world)
    ensure_vim_normal(kernel, world)
    kernel.emit_hook("buffer-opened", fbuf.id)
    kernel.emit_hook("buffer-switched", fbuf.id)
    sync_remote_statusline(world, svc)
    status_emit("Quickfix [" ++ (idx + 1).to_string() ++ "/" ++ world.quickfix.len().to_string() ++ "] " ++ fbuf.file_path)#
    ()
}

fn cmd_remote_exec(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    let target_uri = resolve_active_remote_uri(world, svc, "")
    if target_uri == "" {
        status_emit("RemoteExec: no active SSH connection (run :RemoteConnect first)")#
        return ()
    }
    let parsed = parse_ssh_uri(target_uri)!
    var cmd_str = if not args.is_empty() { args.join(" ").trim() } else { "" }
    if cmd_str == "" {
        let ans? = ask_prompt(PromptRequest.text("Remote Exec [" ++ parsed.authority ++ "]: ", svc.last_exec_cmd))# else {
            return ()
        }
        cmd_str = ans.trim()
    }
    if cmd_str == "" {
        return ()
    }
    let (exit_code, out_s, err_s) = remote_exec(target_uri, cmd_str, cwd = parsed.remote_path)!
    var combined = out_s
    if err_s != "" {
        if combined != "" and (not combined.ends_with("\n")) {
            combined = combined ++ "\n"
        }
        combined = combined ++ err_s
    }
    svc.last_exec_cmd = cmd_str
    svc.last_exec_status = exit_code
    svc.last_exec_output = combined

    let lines = List()
    lines.push(
        "[" ++ parsed.authority ++ ":" ++ parsed.remote_path ++ "]$ " ++ cmd_str
        ++ "   (exit=" ++ exit_code.to_string() ++ ")"
    )
    lines.push("────────────────────────────────────────────────────────────────────────────────")
    let clean = combined.replace("\r\n", "\n").trim_end_matches("\n")
    if clean == "" {
        lines.push("(no output)")
    } else {
        let body = clean.split("\n")
        for i in 0..body.len() {
            lines.push(body.get(i.as(usize)).as(String))
        }
    }
    remember_origin_buffer(world, svc)
    let obuf = world.ensure_special_buffer(REMOTE_OUTPUT_BUF_NAME, MODE_REMOTE_OUTPUT, lines, read_only = true)
    obuf.point = Pos.zero()
    world.active_buffer_id = obuf.id
    sync_wm(kernel, world)
    ensure_vim_normal(kernel, world)
    kernel.emit_hook("buffer-switched", obuf.id)
    status_emit("RemoteExec [" ++ parsed.authority ++ "] exit=" ++ exit_code.to_string() ++ ": " ++ cmd_str)#
    ()
}

fn cmd_remote_shell(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    let raw_arg = if not args.is_empty() { args.get(0).as(String).trim() } else { "" }
    let target_uri = resolve_active_remote_uri(world, svc, raw_arg)
    if target_uri == "" {
        status_emit("RemoteShell: no active SSH connection (run :RemoteConnect first)")#
        return ()
    }
    let parsed = parse_ssh_uri(target_uri)!
    let ssh_cmd = build_remote_ssh_shell_command(parsed, parsed.remote_path)
    svc.last_shell_cmd = ssh_cmd

    if pty_available() and remote_host_available() and kernel.get_command("terminal") != null {
        let _ = kernel.dispatch_command("terminal", [ssh_cmd])#!
        status_emit("Opened remote SSH terminal: " ++ parsed.authority)#
        return ()
    }
    -- Headless / mock environment without PTY: run non-interactive remote shell probe
    cmd_remote_exec(kernel, ["pwd"])#!
}

private fn parse_port_forward_spec(raw_spec: String) -> !String (String, i64, String, i64) {
    let cleaned = raw_spec.trim()
    if cleaned == "" {
        return error "empty port-forward specification"
    }
    let raw_toks = cleaned.split(" ")
    let toks = List()
    for i in 0..raw_toks.len() {
        let tk = raw_toks.get(i.as(usize)).as(String).trim()
        if tk != "" {
            toks.push(tk)
        }
    }
    var dir = "L"
    var idx: usize = 0
    if not toks.is_empty() {
        let t0 = toks.get(0).as(String).to_upper()
        if t0 == "L" or t0 == "-L" or t0 == "LOCAL" {
            dir = "L"
            idx = 1
        } else if t0 == "R" or t0 == "-R" or t0 == "REMOTE" {
            dir = "R"
            idx = 1
        }
    }
    let rem_count = toks.len().as(i64) - idx.as(i64)
    if rem_count <= 0 {
        return error "expected `<local_port>:<remote_host>:<remote_port>` or `L <local_port> <remote_host>:<remote_port>`"
    }
    if rem_count == 1 {
        let spec_tok = toks.get(idx).as(String)
        let parts = spec_tok.split(":")
        if parts.len() == 2 {
            let lp? = parts.get(0).as(String).try_parse(i64) else {
                return error ("invalid local port in '" ++ spec_tok ++ "'")
            }
            let rp? = parts.get(1).as(String).try_parse(i64) else {
                return error ("invalid remote port in '" ++ spec_tok ++ "'")
            }
            return (dir, lp, "127.0.0.1", rp)
        }
        if parts.len() == 3 {
            let lp? = parts.get(0).as(String).try_parse(i64) else {
                return error ("invalid local port in '" ++ spec_tok ++ "'")
            }
            let rhost = parts.get(1).as(String).trim()
            let rp? = parts.get(2).as(String).try_parse(i64) else {
                return error ("invalid remote port in '" ++ spec_tok ++ "'")
            }
            return (dir, lp, if rhost == "" { "127.0.0.1" } else { rhost }, rp)
        }
        return error ("invalid port-forward spec: " ++ spec_tok)
    }
    let lp_str = toks.get(idx).as(String)
    let lp? = lp_str.try_parse(i64) else {
        return error ("invalid local port: " ++ lp_str)
    }
    let rhs = toks.get((idx.as(i64) + 1).as(usize)).as(String)
    if rhs.contains(":") {
        let sp = rhs.split_once(":").as((String, String))
        let (rh, rp_s) = sp
        let rp? = rp_s.try_parse(i64) else {
            return error ("invalid remote port: " ++ rp_s)
        }
        return (dir, lp, if rh.trim() == "" { "127.0.0.1" } else { rh.trim() }, rp)
    }
    let rp? = rhs.try_parse(i64) else {
        return error ("invalid remote port: " ++ rhs)
    }
    (dir, lp, "127.0.0.1", rp)
}

fn cmd_remote_port_forward(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    let target_uri = resolve_active_remote_uri(world, svc, "")
    if target_uri == "" {
        status_emit("RemotePortForward: no active SSH connection")#
        return ()
    }
    var spec_str = if not args.is_empty() { args.join(" ").trim() } else { "" }
    if spec_str == "" {
        let ans? = ask_prompt(PromptRequest.text(
            "SSH Port Forward ([L|R] local_port [remote_host:]remote_port): ",
            "8080:127.0.0.1:80",
        ))# else {
            return ()
        }
        spec_str = ans.trim()
    }
    if spec_str == "" {
        return ()
    }
    let (dir, lp, rhost, rp) = parse_port_forward_spec(spec_str)!
    let tid = remote_port_forward_start(target_uri, dir, lp, rhost, rp)!
    refresh_remote_status_if_open(world, svc)
    status_emit(
        "Started SSH port-forward #" ++ tid.to_string() ++ " [" ++ dir ++ "] 127.0.0.1:"
        ++ lp.to_string() ++ " <-> " ++ rhost ++ ":" ++ rp.to_string()
    )#
    ()
}

fn cmd_remote_port_forward_stop(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    var id_str = if not args.is_empty() { args.get(0).as(String).trim() } else { "" }
    if id_str == "" {
        let tunnels = remote_port_forward_list()
        if tunnels.is_empty() {
            status_emit("No active SSH port forwards")#
            return ()
        }
        let cands = List()
        for i in 0..tunnels.len() {
            let t = tunnels.get(i.as(usize)).as(RemoteTunnelInfo)
            cands.push((
                t.id.to_string(),
                "[" ++ t.authority ++ "] 127.0.0.1:" ++ t.local_port.to_string()
                    ++ " -> " ++ t.remote_host ++ ":" ++ t.remote_port.to_string(),
            ))
        }
        let ans? = ask_prompt(PromptRequest.with_candidates("Stop SSH Port Forward ID: ", "", PromptKind.choice, cands))# else {
            return ()
        }
        id_str = ans.trim()
    }
    if id_str.starts_with("#") {
        id_str = id_str.drop(1)
    }
    let tid? = id_str.try_parse(i64) else {
        return error ("invalid tunnel id: " ++ id_str)
    }
    let ok = remote_port_forward_stop(tid)
    refresh_remote_status_if_open(world, svc)
    if ok {
        status_emit("Stopped SSH port-forward #" ++ tid.to_string())#
    } else {
        status_emit("Tunnel #" ++ tid.to_string() ++ " not found")#
    }
    ()
}

private fn locate_local_lava_server_bin(cwd: String, explicit_bin: String) -> String {
    if explicit_bin.trim() != "" and fs.exists(explicit_bin.trim()) {
        return explicit_bin.trim()
    }
    let local_cwd = if is_ssh_uri(cwd) { "." } else { cwd }
    let candidates = [
        path.join(local_cwd, "target/release/lava-server"),
        path.join(local_cwd, "target/debug/lava-server"),
        "/home/fin/app/lava/target/release/lava-server",
        "/home/fin/app/lava/target/debug/lava-server",
        "/home/fin/apps/lava/target/release/lava-server",
        "/home/fin/apps/lava/target/debug/lava-server",
    ]
    for i in 0..candidates.len() {
        let p = candidates.get(i.as(usize)).as(String)
        if fs.exists(p) and (not fs.is_dir(p)) {
            return p
        }
    }
    let path_env = env.get_or("PATH", "")
    let dirs = path_env.split(":")
    for i in 0..dirs.len() {
        let d = dirs.get(i.as(usize)).as(String).trim()
        if d != "" {
            let full = path.join(d, "lava-server")
            if fs.exists(full) and (not fs.is_dir(full)) {
                return full
            }
        }
    }
    ""
}

fn cmd_remote_install_server(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    var raw_target = ""
    var explicit_bin = ""
    if not args.is_empty() {
        let a0 = args.get(0).as(String).trim()
        if a0 != "" {
            if is_ssh_uri(a0) or (not a0.starts_with("/") and not a0.starts_with("./")) {
                raw_target = a0
                if args.len() >= 2 {
                    explicit_bin = args.get(1).as(String).trim()
                }
            } else {
                explicit_bin = a0
            }
        }
    }
    var target_uri = resolve_active_remote_uri(world, svc, raw_target)
    if target_uri == "" and raw_target != "" {
        target_uri = resolve_ssh_profile_to_uri(raw_target)
    }
    if target_uri == "" and is_ssh_uri(world.cwd) {
        target_uri = normalize_ssh_uri(world.cwd)
    }
    if target_uri == "" {
        status_emit("RemoteInstallServer: no active SSH connection (connect via :RemoteConnectProfile or :RemoteConnect first)")#
        return ()
    }
    let bin_path = locate_local_lava_server_bin(world.cwd, explicit_bin)
    status_emit("Installing/updating lava-server to ~/.lava-server on " ++ target_uri ++ " ...")#
    let info = remote_deploy_server(target_uri, bin_path)!
    svc.active_target = info.prefix
    refresh_remote_status_if_open(world, svc)
    sync_remote_statusline(world, svc)
    log_event(
        "info",
        "ext_remote",
        "Installed/updated ~/.lava-server/lava-server on " ++ info.authority ++ " [" ++ info.mode ++ " v" ++ info.server_version ++ "]",
    )#
    status_emit(
        "Installed ~/.lava-server/lava-server on " ++ info.authority
        ++ " [" ++ info.mode ++ " v" ++ info.server_version ++ "]",
    )#
    ()
}

fn cmd_remote_deploy(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    cmd_remote_install_server(kernel, args)#!
}

fn cmd_remote_probe(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    var raw_spec = ""
    if args.len() >= 2 {
        raw_spec = args.get(0).as(String).trim() ++ ":" ++ args.get(1).as(String).trim()
    } else if args.len() == 1 {
        raw_spec = args.get(0).as(String).trim()
    }
    if raw_spec == "" {
        var default_spec = "127.0.0.1:22"
        let active_uri = resolve_active_remote_uri(world, svc, "")
        if active_uri != "" {
            let pt_res = parse_ssh_uri(active_uri)
            pt_res match {
                pt! => {
                    let pnum = if pt.port > 0 { pt.port } else { 22 }
                    default_spec = pt.host ++ ":" ++ pnum.to_string()
                },
                error _ => (),
            }
        }
        let ans? = ask_prompt(PromptRequest.text("Remote TCP Probe (host:port): ", default_spec))# else {
            return ()
        }
        raw_spec = ans.trim()
    }
    if raw_spec == "" {
        return ()
    }
    var host = ""
    var port: i64 = 22
    if is_ssh_uri(raw_spec) {
        let pt = parse_ssh_uri(raw_spec)!
        host = pt.host
        port = if pt.port > 0 { pt.port } else { 22 }
    } else if raw_spec.contains(":") {
        let sp? = raw_spec.rsplit_once(":") else {
            return error ("invalid host:port specification: " ++ raw_spec)
        }
        let (h_part, p_part) = sp
        host = h_part.trim()
        let parsed_p? = p_part.trim().try_parse(i64) else {
            return error ("invalid TCP port in '" ++ raw_spec ++ "'")
        }
        port = parsed_p
    } else {
        host = raw_spec
    }
    if host == "" {
        return error "missing host for RemoteProbe"
    }
    if port <= 0 or port > 65535 {
        return error ("out-of-range TCP port: " ++ port.to_string())
    }
    let ms = remote_probe_tcp(host, port)!
    let port_str = port.to_string()
    status_emit("TCP reachable: " ++ host ++ ":" ++ port_str ++ " (" ++ ms.to_string() ++ " ms)")#
    ms
}

-- ============================================================================
-- 5. Extension Registration (single-line signature contract)
-- ============================================================================

pub fn register_remote_extension(kernel: SystemKernel) -> !String Unit {
    let ext_id = ext_remote_id()
    kernel.register_extension(
        ext_id,
        "lava.org",
        "ext_remote",
        "0.1.0",
        "SSH Remote VFS, *Remote* dashboard, *Remote Dirvish*, remote grep/files/shell, port-forwarding & lava-server deploy.",
        [ext_document_id(), ext_window_id(), ext_vim_id()],
        |k: SystemKernel| -> !String Unit {
            let svc = RemoteService.new()
            k.publish_service(SERVICE_REMOTE, ext_id, svc)

            let on_buf_sync = |kern: SystemKernel, _payload: Any| -> Unit {
                let w_opt = kern.service("lava.document.world")
                if w_opt != null {
                    sync_remote_statusline(w_opt.as(EditorWorld), svc)
                }
            }
            k.add_hook("buffer-switched", ext_id, on_buf_sync, priority = 60)
            k.add_hook("buffer-opened", ext_id, on_buf_sync, priority = 60)

            -- Core interactive commands + Ex aliases
            k.register_command("remote-connect", ext_id, "Connect to an SSH remote host (`:RemoteConnect [ssh://user@host]`).", cmd_remote_connect)
            k.register_command("ex:RemoteConnect", ext_id, ":RemoteConnect [ssh://user@host[:port][/path]]", cmd_remote_connect, interactive = false)

            k.register_command("remote-connect-profile", ext_id, "Select & connect an OpenSSH profile from ~/.ssh/config (`:RemoteConnectProfile`).", cmd_remote_connect_profile)
            k.register_command("ssh-connect-profile", ext_id, "Select & connect an OpenSSH profile from ~/.ssh/config (`:SshConnect`).", cmd_remote_connect_profile)
            k.register_command("ex:RemoteConnectProfile", ext_id, ":RemoteConnectProfile [alias]", cmd_remote_connect_profile, interactive = false)
            k.register_command("ex:SshConnect", ext_id, ":SshConnect [alias] [dir]", cmd_remote_connect_profile, interactive = false)

            k.register_command("remote-disconnect", ext_id, "Disconnect an active SSH remote session (`:RemoteDisconnect`).", cmd_remote_disconnect)
            k.register_command("ex:RemoteDisconnect", ext_id, ":RemoteDisconnect [target]", cmd_remote_disconnect, interactive = false)

            k.register_command("remote-status", ext_id, "Open *Remote* SSH connections & port-forwarding dashboard (`:RemoteStatus`).", cmd_remote_status)
            k.register_command("remote-info", ext_id, "Open *Remote* SSH connections & port-forwarding dashboard (`:RemoteInfo`).", cmd_remote_status)
            k.register_command("ex:RemoteStatus", ext_id, ":RemoteStatus — open *Remote* dashboard.", cmd_remote_status, interactive = false)
            k.register_command("ex:RemoteInfo", ext_id, ":RemoteInfo — open *Remote* dashboard.", cmd_remote_status, interactive = false)

            k.register_command("remote-browse", ext_id, "Open *Remote Dirvish* Ranger browser on SSH host (`:RemoteBrowse`).", cmd_remote_browse)
            k.register_command("ex:RemoteBrowse", ext_id, ":RemoteBrowse [ssh://host/dir]", cmd_remote_browse, interactive = false)

            k.register_command("remote-files", ext_id, "Fuzzy find files on remote SSH workspace (`:RemoteFiles`).", cmd_remote_files)
            k.register_command("ex:RemoteFiles", ext_id, ":RemoteFiles [ssh://host/dir]", cmd_remote_files, interactive = false)

            k.register_command("remote-grep", ext_id, "Search text across remote SSH workspace (`:RemoteGrep`).", cmd_remote_grep)
            k.register_command("ex:RemoteGrep", ext_id, ":RemoteGrep [pattern]", cmd_remote_grep, interactive = false)

            k.register_command("remote-shell", ext_id, "Open interactive SSH shell in remote directory (`:RemoteShell`).", cmd_remote_shell)
            k.register_command("remote-term", ext_id, "Open interactive SSH terminal (`:RemoteTerm`).", cmd_remote_shell)
            k.register_command("ex:RemoteShell", ext_id, ":RemoteShell — open remote SSH terminal.", cmd_remote_shell, interactive = false)
            k.register_command("ex:RemoteTerm", ext_id, ":RemoteTerm — open remote SSH terminal.", cmd_remote_shell, interactive = false)

            k.register_command("remote-exec", ext_id, "Execute command on remote SSH server (`:RemoteExec <cmd>`).", cmd_remote_exec)
            k.register_command("ex:RemoteExec", ext_id, ":RemoteExec <cmd>", cmd_remote_exec, interactive = false)

            k.register_command("remote-port-forward", ext_id, "Start SSH port forward (`:RemotePortForward 8080:127.0.0.1:80`).", cmd_remote_port_forward)
            k.register_command("ex:RemotePortForward", ext_id, ":RemotePortForward [L|R] local_port [remote_host:]remote_port", cmd_remote_port_forward, interactive = false)

            k.register_command("remote-port-forward-stop", ext_id, "Stop active SSH port forward (`:RemotePortForwardStop <id>`).", cmd_remote_port_forward_stop)
            k.register_command("ex:RemotePortForwardStop", ext_id, ":RemotePortForwardStop <id>", cmd_remote_port_forward_stop, interactive = false)

            k.register_command("remote-install-server", ext_id, "Install or update lava-server to remote ~/.lava-server and restart via ~/.lava-server/lava-server (`:RemoteInstallServer`).", cmd_remote_install_server)
            k.register_command("remote-update-server", ext_id, "Update lava-server in remote ~/.lava-server (`:RemoteUpdateServer`).", cmd_remote_install_server)
            k.register_command("ex:RemoteInstallServer", ext_id, ":RemoteInstallServer [target [local_lava_server_bin]]", cmd_remote_install_server, interactive = false)
            k.register_command("ex:RemoteUpdateServer", ext_id, ":RemoteUpdateServer [target [local_lava_server_bin]]", cmd_remote_install_server, interactive = false)
            k.register_command("remote-deploy", ext_id, "Deploy/update lava-server into remote ~/.lava-server (`:RemoteDeploy`).", cmd_remote_deploy)
            k.register_command("ex:RemoteDeploy", ext_id, ":RemoteDeploy [target [local_lava_server_bin]]", cmd_remote_deploy, interactive = false)

            k.register_command("remote-probe", ext_id, "Probe non-blocking TCP reachability of a remote host:port (`:RemoteProbe host:port`).", cmd_remote_probe)
            k.register_command("ex:RemoteProbe", ext_id, ":RemoteProbe [host[:port]]", cmd_remote_probe, interactive = false)

            -- Internal buffer mode action commands
            k.register_command("remote-status-enter", ext_id, "Connect or browse selected item in *Remote*.", cmd_remote_status_enter, interactive = false)
            k.register_command("remote-status-stop", ext_id, "Disconnect or stop tunnel on current *Remote* row.", cmd_remote_status_stop_row, interactive = false)
            k.register_command("remote-dirvish-next", ext_id, "Next entry in *Remote Dirvish*.", cmd_remote_dirvish_next, interactive = false)
            k.register_command("remote-dirvish-prev", ext_id, "Previous entry in *Remote Dirvish*.", cmd_remote_dirvish_prev, interactive = false)
            k.register_command("remote-dirvish-top", ext_id, "First entry in *Remote Dirvish*.", cmd_remote_dirvish_top, interactive = false)
            k.register_command("remote-dirvish-bottom", ext_id, "Last entry in *Remote Dirvish*.", cmd_remote_dirvish_bottom, interactive = false)
            k.register_command("remote-dirvish-enter", ext_id, "Enter directory or open file in *Remote Dirvish*.", cmd_remote_dirvish_enter, interactive = false)
            k.register_command("remote-dirvish-up", ext_id, "Ascend to parent directory in *Remote Dirvish*.", cmd_remote_dirvish_up, interactive = false)
            k.register_command("remote-dirvish-toggle-hidden", ext_id, "Toggle hidden dotfiles in *Remote Dirvish*.", cmd_remote_dirvish_toggle_hidden, interactive = false)
            k.register_command("remote-dirvish-create", ext_id, "Create remote file or directory in *Remote Dirvish*.", cmd_remote_dirvish_create, interactive = false)
            k.register_command("remote-dirvish-rename", ext_id, "Rename remote entry in *Remote Dirvish*.", cmd_remote_dirvish_rename, interactive = false)
            k.register_command("remote-dirvish-delete", ext_id, "Delete remote entry in *Remote Dirvish*.", cmd_remote_dirvish_delete, interactive = false)
            k.register_command("remote-dirvish-yank", ext_id, "Yank remote entry URI in *Remote Dirvish*.", cmd_remote_dirvish_yank, interactive = false)
            k.register_command("remote-dirvish-cut", ext_id, "Cut remote entry URI in *Remote Dirvish*.", cmd_remote_dirvish_cut, interactive = false)
            k.register_command("remote-dirvish-paste", ext_id, "Paste yanked/cut remote entry in *Remote Dirvish*.", cmd_remote_dirvish_paste, interactive = false)
            k.register_command("remote-dirvish-yank-path", ext_id, "Copy canonical ssh:// URI to clipboard.", cmd_remote_dirvish_yank_path, interactive = false)
            k.register_command("remote-dirvish-refresh", ext_id, "Refresh *Remote Dirvish* listing.", cmd_remote_dirvish_refresh, interactive = false)
            k.register_command("remote-quit-panel", ext_id, "Close remote panel buffer and restore previous buffer.", cmd_remote_quit_panel, interactive = false)
            k.register_command("remote-qf-jump", ext_id, "Jump to remote quickfix entry under cursor.", cmd_remote_qf_jump, interactive = false)

            -- Leader keybindings (`<Space> S ...` and `<Space> r ...`)
            let leader_km = k.ensure_keymap(KEYMAP_VIM_LEADER)
            leader_km.bind("<Space> S c", "remote-connect", ext_id, description = "SSH Remote Connect")
            leader_km.bind("<Space> S o", "remote-connect-profile", ext_id, description = "SSH Connect OpenSSH Profile")
            leader_km.bind("<Space> S d", "remote-disconnect", ext_id, description = "SSH Remote Disconnect")
            leader_km.bind("<Space> S i", "remote-status", ext_id, description = "SSH Remote Status Dashboard")
            leader_km.bind("<Space> S b", "remote-browse", ext_id, description = "SSH Remote Dirvish Browse")
            leader_km.bind("<Space> S f", "remote-files", ext_id, description = "SSH Remote Find Files")
            leader_km.bind("<Space> S g", "remote-grep", ext_id, description = "SSH Remote Grep")
            leader_km.bind("<Space> S s", "remote-shell", ext_id, description = "SSH Remote Shell")
            leader_km.bind("<Space> S !", "remote-exec", ext_id, description = "SSH Remote Exec Command")
            leader_km.bind("<Space> S p", "remote-port-forward", ext_id, description = "SSH Remote Port Forward")
            leader_km.bind("<Space> S I", "remote-install-server", ext_id, description = "SSH Install/Update ~/.lava-server")
            leader_km.bind("<Space> S D", "remote-deploy", ext_id, description = "SSH Deploy ~/.lava-server")

            leader_km.bind("<Space> r c", "remote-connect", ext_id, description = "SSH Remote Connect")
            leader_km.bind("<Space> r o", "remote-connect-profile", ext_id, description = "SSH Connect OpenSSH Profile")
            leader_km.bind("<Space> r d", "remote-disconnect", ext_id, description = "SSH Remote Disconnect")
            leader_km.bind("<Space> r i", "remote-status", ext_id, description = "SSH Remote Status Dashboard")
            leader_km.bind("<Space> r b", "remote-browse", ext_id, description = "SSH Remote Dirvish Browse")
            leader_km.bind("<Space> r f", "remote-files", ext_id, description = "SSH Remote Find Files")
            leader_km.bind("<Space> r g", "remote-grep", ext_id, description = "SSH Remote Grep")
            leader_km.bind("<Space> r s", "remote-shell", ext_id, description = "SSH Remote Shell")
            leader_km.bind("<Space> r p", "remote-port-forward", ext_id, description = "SSH Remote Port Forward")
            leader_km.bind("<Space> r I", "remote-install-server", ext_id, description = "SSH Install/Update ~/.lava-server")

            let _ = k.ensure_keymap(KEYMAP_VIM_NORMAL)

            -- `mode:remote-status` interactive bindings
