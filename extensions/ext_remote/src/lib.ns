            st_km.bind("g", "remote-grep", ext_id, description = "Remote workspace grep")
            st_km.bind("p", "remote-port-forward", ext_id, description = "Start SSH port forward")
            st_km.bind("x", "remote-status-stop", ext_id, description = "Disconnect or stop tunnel")
            st_km.bind("d", "remote-status-stop", ext_id, description = "Disconnect or stop tunnel")
            st_km.bind("I", "remote-install-server", ext_id, description = "Install/Update ~/.lava-server")
            st_km.bind("U", "remote-install-server", ext_id, description = "Install/Update ~/.lava-server")
            st_km.bind("D", "remote-deploy", ext_id, description = "Deploy ~/.lava-server")
            st_km.bind("r", "remote-status", ext_id, description = "Refresh *Remote* dashboard")
            st_km.bind("q", "remote-quit-panel", ext_id, description = "Close *Remote* dashboard")

            -- `mode:remote-dirvish` Ranger keybindings
            let dv_km = k.ensure_keymap("mode:" ++ MODE_REMOTE_DIRVISH)
            dv_km.bind("j", "remote-dirvish-next", ext_id, description = "Next remote entry")
            dv_km.bind("<Down>", "remote-dirvish-next", ext_id, description = "Next remote entry")
            dv_km.bind("k", "remote-dirvish-prev", ext_id, description = "Previous remote entry")
            dv_km.bind("<Up>", "remote-dirvish-prev", ext_id, description = "Previous remote entry")
            dv_km.bind("g g", "remote-dirvish-top", ext_id, description = "First remote entry")
            dv_km.bind("G", "remote-dirvish-bottom", ext_id, description = "Last remote entry")
            dv_km.bind("l", "remote-dirvish-enter", ext_id, description = "Enter remote dir or open file")
            dv_km.bind("<Right>", "remote-dirvish-enter", ext_id, description = "Enter remote dir or open file")
            dv_km.bind("<Return>", "remote-dirvish-enter", ext_id, description = "Enter remote dir or open file")
            dv_km.bind("h", "remote-dirvish-up", ext_id, description = "Parent remote directory")
            dv_km.bind("<Left>", "remote-dirvish-up", ext_id, description = "Parent remote directory")
            dv_km.bind("-", "remote-dirvish-up", ext_id, description = "Parent remote directory")
            dv_km.bind("z h", "remote-dirvish-toggle-hidden", ext_id, description = "Toggle hidden dotfiles")
            dv_km.bind(".", "remote-dirvish-toggle-hidden", ext_id, description = "Toggle hidden dotfiles")
            dv_km.bind("a", "remote-dirvish-create", ext_id, description = "Create remote file or directory")
            dv_km.bind("r", "remote-dirvish-rename", ext_id, description = "Rename remote entry")
            dv_km.bind("c w", "remote-dirvish-rename", ext_id, description = "Rename remote entry")
            dv_km.bind("D", "remote-dirvish-delete", ext_id, description = "Delete remote entry")
            dv_km.bind("d D", "remote-dirvish-delete", ext_id, description = "Delete remote entry")
            dv_km.bind("y y", "remote-dirvish-yank", ext_id, description = "Yank remote entry")
            dv_km.bind("d d", "remote-dirvish-cut", ext_id, description = "Cut remote entry")
            dv_km.bind("p p", "remote-dirvish-paste", ext_id, description = "Paste remote entry")
            dv_km.bind("y p", "remote-dirvish-yank-path", ext_id, description = "Copy canonical ssh:// URI")
            dv_km.bind("R", "remote-dirvish-refresh", ext_id, description = "Refresh remote directory")
            dv_km.bind("g r", "remote-dirvish-refresh", ext_id, description = "Refresh remote directory")
            dv_km.bind("s", "remote-shell", ext_id, description = "Open SSH shell in directory")
            dv_km.bind("!", "remote-exec", ext_id, description = "Run remote command in directory")
            dv_km.bind("q", "remote-quit-panel", ext_id, description = "Quit *Remote Dirvish*")

            -- `mode:remote-output` & `mode:qf` convenience bindings
            let out_km = k.ensure_keymap("mode:" ++ MODE_REMOTE_OUTPUT)
            out_km.bind("q", "remote-quit-panel", ext_id, description = "Close *Remote Output*")

            let qf_km = k.ensure_keymap("mode:qf")
            qf_km.bind("<Return>", "remote-qf-jump", ext_id, description = "Jump to quickfix location")
            qf_km.bind("q", "remote-quit-panel", ext_id, description = "Close *Quickfix*")

            ()
        },
        |_k: SystemKernel| -> !String Unit { () },
    )
}
