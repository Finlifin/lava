-- ext_remote: SSH Remote Client Extension for Lava (`lava.org/ext_remote`).
-- Provides `*Remote*` SSH connection & port-forward dashboard (`:RemoteStatus`),
-- `*Remote Dirvish*` Ranger remote directory explorer (`:RemoteBrowse`),
-- remote file finder (`:RemoteFiles`), remote workspace grep (`:RemoteGrep`),
-- remote SSH shell (`:RemoteShell`), remote command runner (`:RemoteExec`),
-- SSH port-forwarding (`:RemotePortForward`), `lava-server` deployment (`:RemoteDeploy`),
-- and live `[SSH: <authority>]` statusline integration.

use std.collections.{HashMap, Set}
use std.env
use std.fs
use std.path
use @lava_sys.rgb
use @lava_core.{
    ExtId, InteractiveEffects, PromptKind, PromptRequest, SystemKernel,
    ask_prompt, clipboard_set, log_event, status_emit
}
use @lava_remote.{
    RemoteConnectionInfo, RemoteDirItem, RemoteGrepMatch, RemoteRankedFile, RemoteTarget,
    RemoteTunnelInfo, SshHostConfigEntry, is_ssh_uri, join_ssh_uri, normalize_ssh_uri,
    parent_ssh_uri, parse_ssh_uri, remote_async_active_count, remote_connect, remote_copy,
    remote_deploy_server, remote_disconnect, remote_discover_ssh_hosts, remote_exec,
    remote_find_root, remote_host_available, remote_list_connections, remote_mkdir,
    remote_port_forward_list, remote_port_forward_start, remote_port_forward_stop,
    remote_probe_tcp, remote_read_lines, remote_readdir, remote_remove, remote_rename,
    remote_search_files_ranked, remote_search_grep_ext, remote_spinner_frame, remote_stat,
    remote_write_lines, ssh_uri_basename
}
use @lava_term.pty_available
use @ext_document.{
    Buffer, BufferId, EditorWorld, Pos, QuickfixEntry, RegisterValue,
    ext_document_id, require_editor_world
}
use @ext_window.{SERVICE_WINDOW_MANAGER, WindowManager, ext_window_id}
use @ext_vim.{
    KEYMAP_VIM_LEADER, KEYMAP_VIM_NORMAL, SERVICE_VIM, VimMode, VimState, ext_vim_id
}

pub const SERVICE_REMOTE: String = "lava.remote.service"
pub const OWNER_REMOTE: String = "ext_remote"
pub const REMOTE_STATUS_BUF_NAME: String = "*Remote*"
pub const REMOTE_DIRVISH_BUF_NAME: String = "*Remote Dirvish*"
pub const REMOTE_OUTPUT_BUF_NAME: String = "*Remote Output*"
pub const REMOTE_QUICKFIX_BUF_NAME: String = "*Quickfix*"
pub const MODE_REMOTE_STATUS: String = "remote-status"
pub const MODE_REMOTE_DIRVISH: String = "remote-dirvish"
pub const MODE_REMOTE_OUTPUT: String = "remote-output"
pub const REMOTE_DIRVISH_HEADER_ROWS: i64 = 3

pub fn ext_remote_id() -> ExtId = ExtId("lava.org/ext_remote")

-- ============================================================================
-- 1. RemoteService State & Helpers
-- ============================================================================

pub struct RemoteService {
    pub active_target: String,
    pub current_uri: String,
    pub show_hidden: bool,
    pub entries: List,
    pub yanked_uri: String,
    pub cut_mode: bool,
    pub last_exec_cmd: String,
    pub last_exec_status: i64,
    pub last_exec_output: String,
    pub last_shell_cmd: String,
    pub origin_buf_id: ?BufferId,
    pub status_row_targets: HashMap,
}

impl RemoteService {
    pub fn new() -> RemoteService {
        let svc = RemoteService {
            active_target: "",
            current_uri: "",
            show_hidden: false,
            entries: List(),
            yanked_uri: "",
            cut_mode: false,
            last_exec_cmd: "",
            last_exec_status: 0,
            last_exec_output: "",
            last_shell_cmd: "",
            origin_buf_id: null,
            status_row_targets: HashMap.new(),
        }
        svc
    }
}

pub fn require_remote_service(kernel: SystemKernel) -> !String RemoteService {
    let raw = kernel.require_service(SERVICE_REMOTE)!
    raw.as(RemoteService)
}

private fn sync_wm(kernel: SystemKernel, world: EditorWorld) {
    let wm_opt = kernel.service(SERVICE_WINDOW_MANAGER)
    if wm_opt != null {
        let wm = wm_opt.as(WindowManager)
        let ap = wm.active_pane()
        ap.buffer_id = world.active_buffer_id
        ap.cursor = world.active_buffer().point
        wm.sync_from_world(world)
    }
}

private fn ensure_vim_normal(kernel: SystemKernel, _world: EditorWorld) {
    let v_opt = kernel.service(SERVICE_VIM)
    if v_opt != null {
        let vs = v_opt.as(VimState)
        vs.mode = VimMode.normal
        vs.clear_transient()
    }
}

private fn sync_remote_statusline(world: EditorWorld, svc: RemoteService) {
    let buf = world.active_buffer()
    let spin_sfx = if remote_async_active_count() > 0 { " " ++ remote_spinner_frame() } else { "" }
    if is_ssh_uri(buf.file_path) {
        let pt_res = parse_ssh_uri(buf.file_path)
        pt_res match {
            pt! => {
                svc.active_target = pt.prefix
                world.statusline_left_extra = "[SSH: " ++ pt.authority ++ spin_sfx ++ "]"
                return
            },
            error _ => (),
        }
    }
    if buf.major_mode == MODE_REMOTE_DIRVISH and is_ssh_uri(svc.current_uri) {
        let pt_res = parse_ssh_uri(svc.current_uri)
        pt_res match {
            pt! => {
                svc.active_target = pt.prefix
                world.statusline_left_extra = "[SSH: " ++ pt.authority ++ spin_sfx ++ "]"
                return
            },
            error _ => (),
        }
    }
    if buf.major_mode == MODE_REMOTE_STATUS and svc.active_target != "" {
        let pt_res = parse_ssh_uri(svc.active_target)
        pt_res match {
            pt! => {
                world.statusline_left_extra = "[SSH: " ++ pt.authority ++ spin_sfx ++ "]"
                return
            },
            error _ => (),
        }
    }
    if world.statusline_left_extra.starts_with("[SSH: ") {
        world.statusline_left_extra = ""
    }
}

private fn format_human_size(bytes: i64, is_dir: bool) -> String {
    if is_dir {
        return "-"
    }
    if bytes <= 0 {
        return "0B"
    }
    if bytes < 1024 {
        return bytes.to_string() ++ "B"
    }
    if bytes < 1048576 {
        let kb = bytes / 1024
        return kb.to_string() ++ "K"
    }
    let mb = bytes / 1048576
    mb.to_string() ++ "M"
}

private fn remember_origin_buffer(world: EditorWorld, svc: RemoteService) {
    let cur = world.active_buffer()
    if cur.name != REMOTE_STATUS_BUF_NAME
        and cur.name != REMOTE_DIRVISH_BUF_NAME
        and cur.name != REMOTE_OUTPUT_BUF_NAME
        and cur.id != world.messages_id {
        svc.origin_buf_id = cur.id
    }
}

private fn restore_previous_buffer(kernel: SystemKernel, world: EditorWorld, svc: RemoteService) -> Buffer {
    var target_id = world.scratch_id
    var found = false
    svc.origin_buf_id match {
        orig? => {
            let ob_opt = world.buffer(orig)
            if ob_opt != null {
                let ob = ob_opt.as(Buffer)
                if ob.name != REMOTE_STATUS_BUF_NAME and ob.name != REMOTE_DIRVISH_BUF_NAME {
                    target_id = orig
                    found = true
                }
            }
        },
        null => (),
    }
    if not found {
        var idx = world.buffer_order.len() - 1
        while idx >= 0 {
            let bid = world.buffer_order.get(idx.as(usize)).as(BufferId)
            let b = world.buffers.get(bid).as(Buffer)
            if b.name != REMOTE_STATUS_BUF_NAME
                and b.name != REMOTE_DIRVISH_BUF_NAME
                and bid != world.messages_id {
                target_id = bid
                break
            }
            idx -= 1
        }
    }
    world.active_buffer_id = target_id
    sync_wm(kernel, world)
    ensure_vim_normal(kernel, world)
    kernel.emit_hook("buffer-switched", target_id)
    sync_remote_statusline(world, svc)
    world.active_buffer()
}

private fn canonical_dir_uri(raw_uri: String) -> !String String {
    let parsed = parse_ssh_uri(raw_uri)!
    if parsed.remote_path.ends_with("/") {
        parsed.prefix ++ parsed.remote_path
    } else {
        parsed.prefix ++ parsed.remote_path ++ "/"
    }
}

private fn resolve_active_remote_uri(world: EditorWorld, svc: RemoteService, explicit_arg: String) -> String {
    if explicit_arg.trim() != "" {
        let t = explicit_arg.trim()
        if is_ssh_uri(t) {
            return normalize_ssh_uri(t)
        }
        let parsed_res = parse_ssh_uri(t)
        parsed_res match {
            pt! => {
                return pt.canonical_uri()
            },
            error _ => {
                return resolve_ssh_profile_to_uri(t)
            },
        }
    }
    let buf = world.active_buffer()
    if buf.major_mode == MODE_REMOTE_STATUS {
        let hit_opt = svc.status_row_targets.get(buf.point.row)
        if hit_opt != null {
            let (kind, val) = hit_opt.as((String, String))
            if kind == "conn" or kind == "host" {
                return val
            }
        }
    }
    if is_ssh_uri(buf.file_path) {
        return parent_ssh_uri(buf.file_path)
    }
    if svc.current_uri != "" and is_ssh_uri(svc.current_uri) {
        return svc.current_uri
    }
    if svc.active_target != "" {
        return normalize_ssh_uri(svc.active_target)
    }
    let conns = remote_list_connections()
    if not conns.is_empty() {
        let c0 = conns.get(0).as(RemoteConnectionInfo)
        return c0.prefix ++ "/"
    }
    ""
}

private fn resolve_remote_project_root(
    world: EditorWorld,
    svc: RemoteService,
    explicit_arg: String,
) -> String {
    let base_uri = resolve_active_remote_uri(world, svc, explicit_arg)
    if base_uri == "" or explicit_arg.trim() != "" {
        return base_uri
    }
    let root_res = remote_find_root(
        base_uri,
        [
            ".git",
            "compile_commands.json",
            "Cargo.toml",
            "package.toml",
            "pyproject.toml",
            "package.json",
            "go.mod",
            "CMakeLists.txt",
            "Makefile",
        ],
    )
    root_res match {
        found! => found,
        error _ => base_uri,
    }
}

private fn collect_ssh_profile_candidates() -> List {
    let out = List()
    let seen = Set.new()
    let hosts = remote_discover_ssh_hosts()
    for i in 0..hosts.len() {
        let h = hosts.get(i.as(usize)).as(SshHostConfigEntry)
        let alias = h.alias_name.trim()
        if alias != "" and not seen.contains(alias) {
            seen.insert(alias)
            let up = if h.user != "" { h.user ++ "@" } else { "" }
            let hp = if h.hostname != "" { h.hostname } else { alias }
            let pp = if h.port > 0 { ":" ++ h.port.to_string() } else { ":22" }
            let jp = if h.proxy_jump != "" { " via " ++ h.proxy_jump } else { "" }
            let kp = if h.identity_file != "" {
                let kbase_opt = path.file_name(h.identity_file)
                let kbase = if kbase_opt != null { kbase_opt.as(String) } else { h.identity_file }
                " [key:" ++ kbase ++ "]"
            } else {
                ""
            }
            out.push((alias, up ++ hp ++ pp ++ jp ++ kp))
        }
    }
    out
}

private fn resolve_ssh_profile_to_uri(choice: String) -> String {
    let trimmed = choice.trim()
    if trimmed == "" {
        return ""
    }
    if is_ssh_uri(trimmed) {
        return normalize_ssh_uri(trimmed)
    }
    let hosts = remote_discover_ssh_hosts()
    for i in 0..hosts.len() {
        let h = hosts.get(i.as(usize)).as(SshHostConfigEntry)
        if h.alias_name == trimmed {
            -- Keep the OpenSSH Host alias as the SSH authority so ssh(1) applies
            -- HostName, User, Port, IdentityFile, and ProxyJump from ~/.ssh/config.
            return "ssh://" ++ h.alias_name ++ "/"
        }
    }
    "ssh://" ++ trimmed ++ "/"
}

private fn collect_host_prompt_candidates() -> List {
    let out = List()
    let seen = Set.new()
    let conns = remote_list_connections()
    for i in 0..conns.len() {
        let c = conns.get(i.as(usize)).as(RemoteConnectionInfo)
        let uri = "ssh://" ++ c.authority ++ "/"
        if not seen.contains(uri) {
            seen.insert(uri)
            let detail = "[" ++ c.mode ++ "] " ++ c.hostname ++ " (" ++ c.os ++ "/" ++ c.arch ++ ")"
            out.push((uri, detail))
        }
    }
    let hosts = remote_discover_ssh_hosts()
    for i in 0..hosts.len() {
        let h = hosts.get(i.as(usize)).as(SshHostConfigEntry)
        if h.alias_name != "" {
            let uri = "ssh://" ++ h.alias_name ++ "/"
            if not seen.contains(uri) {
                seen.insert(uri)
                let up = if h.user != "" { h.user ++ "@" } else { "" }
                let hp = if h.hostname != "" { h.hostname } else { h.alias_name }
                let pp = if h.port > 0 { ":" ++ h.port.to_string() } else { ":22" }
                let jp = if h.proxy_jump != "" { " via " ++ h.proxy_jump } else { "" }
                out.push((uri, "[ssh-config] " ++ up ++ hp ++ pp ++ jp))
            }
        }
    }
    out
}

pub fn build_remote_ssh_shell_command(target: RemoteTarget, remote_dir: String) -> String {
    let clean_dir = if remote_dir.trim() != "" { remote_dir.trim() } else { "/" }
    let safe_dir = clean_dir.replace("'", "'\\''")
    var port_flag = ""
    if target.port > 0 and target.port != 22 {
        port_flag = "-p " ++ target.port.to_string() ++ " "
    }
    "ssh -t " ++ port_flag ++ target.ssh_destination()
        ++ " sh -c \"cd '" ++ safe_dir ++ "' && exec \\\"\\${{SHELL:-/bin/sh}}\\\" -l\""
}

private fn store_to_clipboard_and_registers(world: EditorWorld, text: String) -> #clipboard_set Unit {
    let val = RegisterValue {
        text: text,
        linewise: false,
        blockwise: false,
    }
    world.registers.yank_store(val)#
    world.registers.set_reg("+", val)#
    clipboard_set(text)#
}

-- ============================================================================
-- 2. `*Remote*` Status & Port-Forward Dashboard (`mode:remote-status`)
-- ============================================================================

private fn render_remote_status_buffer(world: EditorWorld, svc: RemoteService, buf: Buffer) {
    svc.status_row_targets = HashMap.new()
    let conns = remote_list_connections()
    let tunnels = remote_port_forward_list()
    let hosts = remote_discover_ssh_hosts()

    let lines = List()
    let section_rows = List()
    let conn_rows = List()
    let tunnel_rows = List()
    let host_rows = List()

    lines.push("================================================================================")
    lines.push(
        " Lava SSH Remote Dashboard (*Remote*)   ["
        ++ conns.len().to_string() ++ " active | "
        ++ tunnels.len().to_string() ++ " tunnel(s) | "
        ++ hosts.len().to_string() ++ " ssh-config host(s)]"
    )
    lines.push(" Keys: [RET] connect/browse  [o] ssh-profile  [b] dirvish  [f] files  [g] grep  [s] shell  [p] port-fwd  [I/D] install ~/.lava-server  [x/d] stop  [r] refresh  [q] close")
    lines.push("================================================================================")
    lines.push("")

    section_rows.push(lines.len())
    lines.push(" Active SSH Connections (" ++ conns.len().to_string() ++ "):")
    lines.push(" ──────────────────────────────────────────────────────────────────────────────")
    if conns.is_empty() {
        lines.push("   (no active SSH sessions — press RET on a host below or run :RemoteConnect ssh://user@host)")
    } else {
        for i in 0..conns.len() {
            let c = conns.get(i.as(usize)).as(RemoteConnectionInfo)
            let st_tag = if c.alive { "ONLINE" } else { "OFFLINE" }
            let ver_tag = if c.server_version != "" { " v" ++ c.server_version } else { "" }
            let row_idx = lines.len()
            let browse_uri = if c.remote_cwd != "" and c.remote_cwd != "/" {
                join_ssh_uri(c.prefix ++ "/", c.remote_cwd)
            } else {
                c.prefix ++ "/"
            }
            lines.push(
                "   • " ++ c.authority ++ "  [" ++ c.mode ++ ver_tag ++ "]  [" ++ st_tag ++ "]  "
                ++ c.hostname ++ " (" ++ c.os ++ "/" ++ c.arch ++ ")  "
                ++ c.latency_us.to_string() ++ "µs  cwd=" ++ c.remote_cwd
            )
            svc.status_row_targets.insert(row_idx, ("conn", browse_uri))
            conn_rows.push((row_idx, c.alive))
        }
    }

    lines.push("")
    section_rows.push(lines.len())
    lines.push(" Active SSH Port Forwards (" ++ tunnels.len().to_string() ++ "):")
    lines.push(" ──────────────────────────────────────────────────────────────────────────────")
    if tunnels.is_empty() {
        lines.push("   (no active port forwards — press `p` or run :RemotePortForward 8080:127.0.0.1:80)")
    } else {
        for i in 0..tunnels.len() {
            let t = tunnels.get(i.as(usize)).as(RemoteTunnelInfo)
            let dir_arrow = if t.direction == "R" {
                "REMOTE " ++ t.remote_host ++ ":" ++ t.remote_port.to_string()
                    ++ " -> LOCAL 127.0.0.1:" ++ t.local_port.to_string()
            } else {
                "LOCAL 127.0.0.1:" ++ t.local_port.to_string()
                    ++ " -> " ++ t.remote_host ++ ":" ++ t.remote_port.to_string()
            }
            let alive_str = if t.alive { "ACTIVE" } else { "STOPPED" }
            let row_idx = lines.len()
            lines.push(
                "   [#" ++ t.id.to_string() ++ "] [" ++ t.authority ++ "]  "
                ++ dir_arrow ++ "  [" ++ alive_str ++ "]"
            )
            svc.status_row_targets.insert(row_idx, ("tunnel", t.id.to_string()))
            tunnel_rows.push((row_idx, t.alive))
        }
    }

    lines.push("")
    section_rows.push(lines.len())
    lines.push(" Discovered ~/.ssh/config Hosts (" ++ hosts.len().to_string() ++ "):")
    lines.push(" ──────────────────────────────────────────────────────────────────────────────")
    if hosts.is_empty() {
        lines.push("   (no Host aliases found in ~/.ssh/config)")
    } else {
        for i in 0..hosts.len() {
            let h = hosts.get(i.as(usize)).as(SshHostConfigEntry)
            var auth = ""
            if h.user != "" {
                auth = h.user ++ "@"
            }
            auth = auth ++ h.alias_name
            if h.port > 0 and h.port != 22 {
                auth = auth ++ ":" ++ h.port.to_string()
            }
            let uri = "ssh://" ++ auth ++ "/"
            let up = if h.user != "" { h.user ++ "@" } else { "" }
            let hp = if h.hostname != "" { h.hostname } else { h.alias_name }
            let pp = if h.port > 0 { ":" ++ h.port.to_string() } else { ":22" }
            let jp = if h.proxy_jump != "" { "  ProxyJump=" ++ h.proxy_jump } else { "" }
            let row_idx = lines.len()
            lines.push("   ◦ " ++ h.alias_name.pad_end(18, " ") ++ " -> " ++ up ++ hp ++ pp ++ jp)
            svc.status_row_targets.insert(row_idx, ("host", uri))
            host_rows.push(row_idx)
        }
    }

    let prev_row = buf.point.row
    buf.read_only = false
    buf.major_mode = MODE_REMOTE_STATUS
    buf.set_lines(lines, record_undo = false)
    buf.modified = false
    buf.read_only = true
    buf.clear_owner_decors(OWNER_REMOTE)

    -- Decorations (strictly zero bold everywhere)
    if buf.line_count() >= 3 {
        buf.add_inline_decor(
            OWNER_REMOTE,
            1,
            0,
            buf.line_char_len(1),
            bg_rgba = 0,
            fg_rgba = rgb(137, 180, 250),
            underline = false,
            replace_label = "",
        )
        buf.add_inline_decor(
            OWNER_REMOTE,
            2,
            0,
            buf.line_char_len(2),
            bg_rgba = 0,
            fg_rgba = rgb(148, 226, 213),
            underline = false,
            replace_label = "",
        )
    }
    for i in 0..section_rows.len() {
        let r = section_rows.get(i.as(usize)).as(i64)
        if r >= 0 and r < buf.line_count() {
            buf.add_inline_decor(
                OWNER_REMOTE,
                r,
                0,
                buf.line_char_len(r),
                bg_rgba = 0,
                fg_rgba = rgb(180, 190, 254),
                underline = false,
                replace_label = "",
            )
        }
    }
    for i in 0..conn_rows.len() {
        let (r, ok_flag) = conn_rows.get(i.as(usize)).as((i64, bool))
        let fg = if ok_flag { rgb(166, 227, 161) } else { rgb(243, 139, 168) }
        buf.add_sign(OWNER_REMOTE, r, "●", fg, priority = 50)
        buf.add_inline_decor(
            OWNER_REMOTE,
            r,
            0,
            buf.line_char_len(r),
            bg_rgba = 0,
            fg_rgba = fg,
            underline = false,
            replace_label = "",
        )
    }
    for i in 0..tunnel_rows.len() {
        let (r, ok_flag) = tunnel_rows.get(i.as(usize)).as((i64, bool))
        let fg = if ok_flag { rgb(148, 226, 213) } else { rgb(147, 153, 178) }
        buf.add_sign(OWNER_REMOTE, r, "⇄", fg, priority = 45)
        buf.add_inline_decor(
            OWNER_REMOTE,
            r,
            0,
            buf.line_char_len(r),
            bg_rgba = 0,
            fg_rgba = fg,
            underline = false,
            replace_label = "",
        )
    }
    for i in 0..host_rows.len() {
        let r = host_rows.get(i.as(usize)).as(i64)
        buf.add_inline_decor(
            OWNER_REMOTE,
            r,
            0,
            buf.line_char_len(r),
            bg_rgba = 0,
            fg_rgba = rgb(205, 214, 244),
            underline = false,
            replace_label = "",
        )
    }

    let default_row = if not conn_rows.is_empty() {
        let (r0, _) = conn_rows.get(0).as((i64, bool))
        r0
    } else if not host_rows.is_empty() {
        host_rows.get(0).as(i64)
    } else {
        0
    }
    let target_r = if prev_row > 0 and prev_row < buf.line_count() { prev_row } else { default_row }
    buf.point = buf.clamp_pos(Pos.new(target_r, 0), insert_mode = false)
    sync_remote_statusline(world, svc)
}

private fn refresh_remote_status_if_open(world: EditorWorld, svc: RemoteService) {
    let b_opt = world.find_buffer_by_name(REMOTE_STATUS_BUF_NAME)
    if b_opt != null {
        render_remote_status_buffer(world, svc, b_opt.as(Buffer))
    }
}

-- ============================================================================
-- 3. `*Remote Dirvish*` Explorer (`mode:remote-dirvish`)
-- ============================================================================

private fn entry_at_dirvish_cursor(svc: RemoteService, buf: Buffer) -> ?RemoteDirItem {
    let idx = buf.point.row - REMOTE_DIRVISH_HEADER_ROWS
    if idx < 0 or idx >= svc.entries.len() {
        return null
    }
    svc.entries.get(idx.as(usize)).as(RemoteDirItem)
}

private fn render_remote_dirvish_buffer(
    kernel: SystemKernel,
    world: EditorWorld,
    svc: RemoteService,
    dir_uri_raw: String,
    .focus_name: String = "",
    .preferred_row: i64 = -1,
) -> !String Buffer {
    let dir_uri = canonical_dir_uri(dir_uri_raw)!
    let parsed = parse_ssh_uri(dir_uri)!
    let items = remote_readdir(dir_uri, show_hidden = svc.show_hidden)!
    svc.current_uri = dir_uri
    svc.active_target = parsed.prefix
    svc.entries = items

    let hidden_tag = if svc.show_hidden { " | dotfiles:ON" } else { "" }
    let ring_tag = if svc.yanked_uri != "" {
        let mode_lbl = if svc.cut_mode { "CUT" } else { "YANK" }
        " | " ++ mode_lbl ++ ":" ++ ssh_uri_basename(svc.yanked_uri)
    } else {
        ""
    }

    let lines = List()
    lines.push(
        " SSH Dirvish: " ++ dir_uri ++ "   ["
        ++ items.len().to_string() ++ " item(s)" ++ hidden_tag ++ ring_tag ++ "]"
    )
    lines.push(" Keys: [j/k] move  [l/RET] open  [h/-] parent  [zh/.] hidden  [a] create  [r/cw] rename  [yy/dd/pp] ring  [D] del  [q] quit")
    lines.push("────────────────────────────────────────────────────────────────────────────────")

    var focus_row: i64 = -1
    if items.is_empty() {
        lines.push("  (empty remote directory)")
    } else {
        for i in 0..items.len() {
            let it = items.get(i.as(usize)).as(RemoteDirItem)
            let mark_ch = if svc.yanked_uri != "" and svc.yanked_uri == it.full_uri {
                if svc.cut_mode { "x" } else { "y" }
            } else {
                " "
            }
            let mode_str = if it.is_dir { "drwxr-xr-x" } else { "-rw-r--r--" }
            let sz_str = format_human_size(it.size, it.is_dir).pad_start(7, " ")
            let disp_name = if it.is_dir { it.name ++ "/" } else { it.name }
            let row_idx = lines.len()
            lines.push(" " ++ mark_ch ++ " " ++ mode_str ++ " " ++ sz_str ++ "  " ++ disp_name)
            if focus_name != "" and it.name == focus_name {
                focus_row = row_idx
            }
        }
    }

    let buf = world.ensure_special_buffer(REMOTE_DIRVISH_BUF_NAME, MODE_REMOTE_DIRVISH, lines, read_only = true)
    buf.clear_owner_decors(OWNER_REMOTE)

    -- Colorize header & entry rows (zero bold styles)
    buf.add_inline_decor(
        OWNER_REMOTE,
        0,
        0,
        buf.line_char_len(0),
        bg_rgba = 0,
        fg_rgba = rgb(137, 180, 250),
        underline = false,
        replace_label = "",
    )
    buf.add_inline_decor(
        OWNER_REMOTE,
        1,
        0,
        buf.line_char_len(1),
        bg_rgba = 0,
        fg_rgba = rgb(147, 153, 178),
        underline = false,
        replace_label = "",
    )
    buf.add_inline_decor(
        OWNER_REMOTE,
        2,
        0,
        buf.line_char_len(2),
        bg_rgba = 0,
        fg_rgba = rgb(88, 91, 112),
        underline = false,
        replace_label = "",
    )

    for i in 0..items.len() {
        let it = items.get(i.as(usize)).as(RemoteDirItem)
        let r = REMOTE_DIRVISH_HEADER_ROWS + i
        let ln_len = buf.line_char_len(r)
        let meta_end = if ln_len < 23 { ln_len } else { 23 }
        if meta_end > 0 {
            buf.add_inline_decor(
                OWNER_REMOTE,
                r,
                0,
                meta_end,
                bg_rgba = 0,
                fg_rgba = rgb(147, 153, 178),
                underline = false,
                replace_label = "",
            )
        }
        if ln_len > meta_end {
            let name_fg = if it.is_dir {
                rgb(137, 180, 250)
            } else if it.name.ends_with(".rs") or it.name.ends_with(".cpp") or it.name.ends_with(".hpp") or it.name.ends_with(".c") or it.name.ends_with(".h") or it.name.ends_with(".ns") {
                rgb(205, 214, 244)
            } else {
                rgb(186, 194, 222)
            }
            buf.add_inline_decor(
                OWNER_REMOTE,
                r,
                meta_end,
                ln_len,
                bg_rgba = 0,
                fg_rgba = name_fg,
                underline = false,
                replace_label = "",
            )
        }
        if svc.yanked_uri != "" and svc.yanked_uri == it.full_uri {
            let ring_fg = if svc.cut_mode { rgb(243, 139, 168) } else { rgb(249, 226, 175) }
            buf.add_sign(OWNER_REMOTE, r, if svc.cut_mode { "✂" } else { "★" }, ring_fg, priority = 55)
        }
    }

    let first_entry_row = if items.is_empty() { 0 } else { REMOTE_DIRVISH_HEADER_ROWS }
    let max_entry_row = if items.is_empty() {
        0
    } else {
        REMOTE_DIRVISH_HEADER_ROWS + items.len() - 1
    }
    var target_row = first_entry_row
    if focus_row >= 0 {
        target_row = focus_row
    } else if preferred_row >= REMOTE_DIRVISH_HEADER_ROWS {
        target_row = if preferred_row > max_entry_row { max_entry_row } else { preferred_row }
    }
    let name_col = if items.is_empty() { 0 } else { 23 }
    buf.point = buf.clamp_pos(Pos.new(target_row, name_col), insert_mode = false)
    world.active_buffer_id = buf.id
    sync_wm(kernel, world)
    ensure_vim_normal(kernel, world)
    kernel.emit_hook("buffer-switched", buf.id)
    sync_remote_statusline(world, svc)
    buf
}

-- ============================================================================
-- 4. Interactive Command Implementations
-- ============================================================================

private fn connect_and_route(
    kernel: SystemKernel,
    world: EditorWorld,
    svc: RemoteService,
    raw_target: String,
) -> #InteractiveEffects !String Any {
    let raw_trimmed = raw_target.trim()
    if raw_trimmed == "" {
        return ()
    }
    let is_bare_profile = (not raw_trimmed.starts_with("ssh://")) and (not raw_trimmed.starts_with("/ssh:"))
    let trimmed = if is_bare_profile {
        resolve_ssh_profile_to_uri(raw_trimmed)
    } else {
        raw_trimmed
    }
    let info = remote_connect(trimmed)!
    svc.active_target = info.prefix
    log_event("info", "ext_remote", "Connected to " ++ info.authority ++ " [" ++ info.mode ++ "]")#

    -- Check if target specifies an existing remote directory or file
    let has_explicit_subpath = if is_bare_profile {
        false
    } else if trimmed.starts_with("ssh://") {
        trimmed.drop(6).contains("/")
    } else if trimmed.starts_with("/ssh:") {
        trimmed.drop(5).contains(":")
    } else {
        false
    }

    if has_explicit_subpath {
        let st_res = remote_stat(trimmed)
        st_res match {
            st! => {
                if st.exists and st.is_dir {
                    remember_origin_buffer(world, svc)
                    let _ = render_remote_dirvish_buffer(kernel, world, svc, trimmed)!
                    status_emit("Connected to " ++ info.authority ++ " — browsing " ++ svc.current_uri)#
                    return ()
                }
                if st.exists and st.is_file {
                    let fbuf = world.open_file(trimmed)#!
                    sync_wm(kernel, world)
                    ensure_vim_normal(kernel, world)
                    kernel.emit_hook("buffer-opened", fbuf.id)
                    kernel.emit_hook("buffer-switched", fbuf.id)
                    sync_remote_statusline(world, svc)
                    status_emit("Opened remote file " ++ fbuf.file_path)#
                    return ()
                }
            },
            error _ => (),
        }
    }

    remember_origin_buffer(world, svc)
    let sbuf = world.ensure_special_buffer(REMOTE_STATUS_BUF_NAME, MODE_REMOTE_STATUS, [""], read_only = true)
    render_remote_status_buffer(world, svc, sbuf)
    world.active_buffer_id = sbuf.id
    sync_wm(kernel, world)
    ensure_vim_normal(kernel, world)
    kernel.emit_hook("buffer-switched", sbuf.id)
    status_emit("Connected to " ++ info.authority ++ " [" ++ info.mode ++ "]")#
    ()
}

fn cmd_remote_connect(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    if not args.is_empty() {
        let a0 = args.get(0).as(String).trim()
        if a0 != "" {
            return connect_and_route(kernel, world, svc, a0)#!
        }
    }
    let cands = collect_host_prompt_candidates()
    let req = if cands.is_empty() {
        PromptRequest.text("Remote SSH Connect (ssh://user@host[:port]/path): ", "ssh://")
    } else {
        PromptRequest.with_candidates("Remote SSH Connect: ", "", PromptKind.choice, cands)
    }
    let ans? = ask_prompt(req)# else {
        return ()
    }
    if ans.trim() == "" {
        return ()
    }
    connect_and_route(kernel, world, svc, ans.trim())#!
}

private fn parse_ssh_connect_args(args: List) -> (String, String) {
    if args.is_empty() {
        return ("", "")
    }
    let parts = List()
    for i in 0..args.len() {
        let s = args.get(i.as(usize)).as(String).trim()
        if s != "" {
            parts.push(s)
        }
    }
    let raw = parts.join(" ").trim()
    if raw == "" {
        return ("", "")
    }
    let sp_opt = raw.split_once(" ")
    if sp_opt != null {
        let (h, p) = sp_opt.as((String, String))
        return (h.trim(), p.trim())
    }
    if not is_ssh_uri(raw) {
        let colon_opt = raw.split_once(":")
        if colon_opt != null {
            let (h, p) = colon_opt.as((String, String))
            if h.trim() != "" and p.trim() != "" {
                return (h.trim(), p.trim())
            }
        }
        let slash_opt = raw.split_once("/")
        if slash_opt != null {
            let (h, p) = slash_opt.as((String, String))
            if h.trim() != "" {
                return (h.trim(), "/" ++ p.trim())
            }
        }
    }
    (raw, "")
}

private fn resolve_ssh_connect_dir_uri(
    prefix: String,
    remote_home: String,
    remote_cwd: String,
    target_spec: String,
    requested_path: String,
) -> String {
    let base_prefix = if prefix.ends_with("/") { prefix } else { prefix ++ "/" }
    let cwd_uri = if remote_cwd != "" and remote_cwd != "/" {
        join_ssh_uri(base_prefix, remote_cwd)
    } else {
        base_prefix
    }
    let home_uri = if remote_home != "" and remote_home != "/" {
        join_ssh_uri(base_prefix, remote_home)
    } else {
        cwd_uri
    }
    let req = requested_path.trim()
    if req != "" {
        if req == "~" {
            return home_uri
        }
        if req.starts_with("~/") {
            let sub = req.drop(2).trim()
            return if sub == "" { home_uri } else { join_ssh_uri(home_uri, sub) }
        }
        if req.starts_with("/") {
            return join_ssh_uri(base_prefix, req)
        }
        return join_ssh_uri(cwd_uri, req)
    }
    if is_ssh_uri(target_spec) {
        let p_res = parse_ssh_uri(target_spec)
        p_res match {
            p! => {
                if p.remote_path != "" and p.remote_path != "/" {
                    return join_ssh_uri(base_prefix, p.remote_path)
                }
            },
            error _ => (),
        }
    }
    cwd_uri
}

fn cmd_remote_connect_profile(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    let (parsed_target, parsed_path) = parse_ssh_connect_args(args)
    var chosen = parsed_target
    var chosen_path = parsed_path
    if chosen == "" {
        let profiles = collect_ssh_profile_candidates()
        if profiles.is_empty() {
            status_emit("No Host profiles found in ~/.ssh/config (or LAVA_SSH_CONFIG)")#
            return ()
        }
        let ans? = ask_prompt(PromptRequest.with_candidates(
            "OpenSSH Profile: ",
            "",
            PromptKind.choice,
            profiles,
        ))# else {
            return ()
        }
        let (p_target, p_path) = parse_ssh_connect_args([ans])
        chosen = p_target
        chosen_path = p_path
    }
    if chosen == "" {
        return ()
    }
    let target_uri = resolve_ssh_profile_to_uri(chosen)
    let info = remote_connect(target_uri)!
    svc.active_target = info.prefix
    let remote_dir_uri = resolve_ssh_connect_dir_uri(
        info.prefix,
        info.remote_home,
        info.remote_cwd,
        chosen,
        chosen_path,
    )
    world.cwd = remote_dir_uri
    svc.current_uri = canonical_dir_uri(remote_dir_uri) ! { _ => remote_dir_uri }
    refresh_remote_status_if_open(world, svc)
    log_event(
        "info",
        "ext_remote",
        "Connected OpenSSH profile `" ++ chosen ++ "` -> " ++ info.authority ++ " [" ++ info.mode ++ "]",
    )#
    if kernel.get_command("dirvish") != null {
        let _ = kernel.dispatch_command("dirvish", [remote_dir_uri])#!
    } else {
        remember_origin_buffer(world, svc)
        let _ = render_remote_dirvish_buffer(kernel, world, svc, remote_dir_uri)!
    }
    sync_remote_statusline(world, svc)
    status_emit(
        "Connected OpenSSH profile `" ++ chosen ++ "` -> " ++ info.authority
        ++ " [" ++ info.mode ++ "] (" ++ remote_dir_uri ++ ")",
    )#
    ()
}

fn cmd_remote_disconnect(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    var target = ""
    if not args.is_empty() {
        target = args.get(0).as(String).trim()
    }
    if target == "" {
        let cur = world.active_buffer()
        if cur.major_mode == MODE_REMOTE_STATUS {
            let hit_opt = svc.status_row_targets.get(cur.point.row)
            if hit_opt != null {
                let (kind, val) = hit_opt.as((String, String))
                if kind == "conn" {
                    target = val
                }
            }
        }
    }
    if target == "" {
        let conns = remote_list_connections()
        if conns.len() == 1 {
            target = conns.get(0).as(RemoteConnectionInfo).prefix
        } else if conns.len() > 1 {
            let cands = List()
            for i in 0..conns.len() {
                let c = conns.get(i.as(usize)).as(RemoteConnectionInfo)
                cands.push((c.prefix, "[" ++ c.mode ++ "] " ++ c.hostname))
            }
            let ans? = ask_prompt(PromptRequest.with_candidates("Disconnect SSH session: ", "", PromptKind.choice, cands))# else {
                return ()
            }
            target = ans.trim()
        } else {
            target = svc.active_target
        }
    }
    if target == "" {
        status_emit("No active SSH connection to disconnect")#
        return ()
    }
    if (not target.starts_with("ssh://")) and (not target.starts_with("/ssh:")) {
        target = resolve_ssh_profile_to_uri(target)
    }
    let ok = remote_disconnect(target)
    if svc.active_target != "" and normalize_ssh_uri(target).starts_with(svc.active_target) {
        svc.active_target = ""
    }
    refresh_remote_status_if_open(world, svc)
    sync_remote_statusline(world, svc)
    if ok {
        status_emit("Disconnected SSH session: " ++ target)#
    } else {
        status_emit("SSH session already closed: " ++ target)#
    }
    ()
}

fn cmd_remote_status(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    remember_origin_buffer(world, svc)
    let sbuf = world.ensure_special_buffer(REMOTE_STATUS_BUF_NAME, MODE_REMOTE_STATUS, [""], read_only = true)
    render_remote_status_buffer(world, svc, sbuf)
    world.active_buffer_id = sbuf.id
    sync_wm(kernel, world)
    ensure_vim_normal(kernel, world)
    kernel.emit_hook("buffer-switched", sbuf.id)
    status_emit("*Remote* SSH dashboard (`RET` browse, `p` port-forward, `q` close)")#
    ()
}

fn cmd_remote_status_enter(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    let buf = world.active_buffer()
    let hit_opt = svc.status_row_targets.get(buf.point.row)
    if hit_opt == null {
        status_emit("Move cursor onto a connection, port-forward, or SSH host row")#
        return ()
    }
    let (kind, val) = hit_opt.as((String, String))
    if kind == "tunnel" {
        status_emit("Port-forward #" ++ val ++ " (press `x` or `d` to stop tunnel)")#
        return ()
    }
    let _ = remote_connect(val)!
    let _ = render_remote_dirvish_buffer(kernel, world, svc, val)!
    status_emit("Browsing " ++ svc.current_uri)#
    ()
}

fn cmd_remote_status_stop_row(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    let buf = world.active_buffer()
    let hit_opt = svc.status_row_targets.get(buf.point.row)
    if hit_opt != null {
        let (kind, val) = hit_opt.as((String, String))
        if kind == "tunnel" {
            let tid_opt = val.try_parse(i64)
            if tid_opt != null {
                let tid = tid_opt.as(i64)
                let _ = remote_port_forward_stop(tid)
                render_remote_status_buffer(world, svc, buf)
                status_emit("Stopped SSH port-forward #" ++ tid.to_string())#
                return ()
            }
        }
        if kind == "conn" {
            let _ = remote_disconnect(val)
            render_remote_status_buffer(world, svc, buf)
            status_emit("Disconnected " ++ val)#
            return ()
        }
    }
    cmd_remote_disconnect(kernel, List())#!
}

fn cmd_remote_browse(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    let raw_arg = if not args.is_empty() { args.get(0).as(String).trim() } else { "" }
    var target_uri = resolve_active_remote_uri(world, svc, raw_arg)
    if target_uri == "" {
        let cands = collect_host_prompt_candidates()
        let req = if cands.is_empty() {
            PromptRequest.text("Remote Browse URI (ssh://user@host/dir): ", "ssh://")
        } else {
            PromptRequest.with_candidates("Remote Browse: ", "", PromptKind.choice, cands)
        }
        let ans? = ask_prompt(req)# else {
            return ()
        }
        target_uri = ans.trim()
    }
    if target_uri == "" {
        return ()
    }
    remember_origin_buffer(world, svc)
    let _ = render_remote_dirvish_buffer(kernel, world, svc, target_uri)!
    status_emit("Remote Dirvish: " ++ svc.current_uri)#
    ()
}

fn cmd_remote_dirvish_next(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    let buf = world.active_buffer()
    if svc.entries.is_empty() {
        return ()
    }
    let min_r = REMOTE_DIRVISH_HEADER_ROWS
    let max_r = REMOTE_DIRVISH_HEADER_ROWS + svc.entries.len() - 1
    let next_r = if buf.point.row < min_r {
        min_r
    } else if buf.point.row < max_r {
        buf.point.row + 1
    } else {
        max_r
    }
    buf.point = buf.clamp_pos(Pos.new(next_r, 23), insert_mode = false)
    sync_wm(kernel, world)
    ()
}

fn cmd_remote_dirvish_prev(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    let buf = world.active_buffer()
    if svc.entries.is_empty() {
        return ()
    }
    let min_r = REMOTE_DIRVISH_HEADER_ROWS
    let max_r = REMOTE_DIRVISH_HEADER_ROWS + svc.entries.len() - 1
    let prev_r = if buf.point.row > max_r {
        max_r
    } else if buf.point.row > min_r {
        buf.point.row - 1
    } else {
        min_r
    }
    buf.point = buf.clamp_pos(Pos.new(prev_r, 23), insert_mode = false)
    sync_wm(kernel, world)
    ()
}

fn cmd_remote_dirvish_top(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    let buf = world.active_buffer()
    if not svc.entries.is_empty() {
        buf.point = buf.clamp_pos(Pos.new(REMOTE_DIRVISH_HEADER_ROWS, 23), insert_mode = false)
        sync_wm(kernel, world)
    }
    ()
}

fn cmd_remote_dirvish_bottom(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    let buf = world.active_buffer()
    if not svc.entries.is_empty() {
        let last_r = REMOTE_DIRVISH_HEADER_ROWS + svc.entries.len() - 1
        buf.point = buf.clamp_pos(Pos.new(last_r, 23), insert_mode = false)
        sync_wm(kernel, world)
    }
    ()
}

fn cmd_remote_dirvish_enter(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    let buf = world.active_buffer()
    let item? = entry_at_dirvish_cursor(svc, buf) else {
        status_emit("No remote entry under cursor")#
        return ()
    }
    if item.is_dir {
        let _ = render_remote_dirvish_buffer(kernel, world, svc, item.full_uri)!
        status_emit("Remote Dirvish: " ++ svc.current_uri)#
        return ()
    }
    let fbuf = world.open_file(item.full_uri)#!
    sync_wm(kernel, world)
    ensure_vim_normal(kernel, world)
    kernel.emit_hook("buffer-opened", fbuf.id)
    kernel.emit_hook("buffer-switched", fbuf.id)
    sync_remote_statusline(world, svc)
    status_emit("Opened " ++ fbuf.file_path)#
    ()
}

fn cmd_remote_dirvish_up(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    if svc.current_uri == "" {
        return ()
    }
    var trimmed = svc.current_uri
    let parsed = parse_ssh_uri(trimmed)!
    if parsed.remote_path == "/" {
        status_emit("Already at remote root " ++ parsed.prefix ++ "/")#
        return ()
    }
    let child_name = ssh_uri_basename(parsed.prefix ++ parsed.remote_path)
    let par_uri = parent_ssh_uri(parsed.prefix ++ parsed.remote_path)
    let _ = render_remote_dirvish_buffer(kernel, world, svc, par_uri, focus_name = child_name)!
    status_emit("Remote Dirvish: " ++ svc.current_uri)#
    ()
}

fn cmd_remote_dirvish_toggle_hidden(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    let buf = world.active_buffer()
    let cur_opt = entry_at_dirvish_cursor(svc, buf)
    let keep = if cur_opt != null { cur_opt.as(RemoteDirItem).name } else { "" }
    svc.show_hidden = not svc.show_hidden
    let _ = render_remote_dirvish_buffer(kernel, world, svc, svc.current_uri, focus_name = keep)!
    status_emit("Remote Dirvish dotfiles: " ++ (if svc.show_hidden { "ON" } else { "OFF" }))#
    ()
}

fn cmd_remote_dirvish_create(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    if svc.current_uri == "" {
        return ()
    }
    var name_in = if not args.is_empty() { args.get(0).as(String).trim() } else { "" }
    if name_in == "" {
        let ans? = ask_prompt(PromptRequest.text("Create in " ++ svc.current_uri ++ " (trailing `/` for dir): ", ""))# else {
            return ()
        }
        name_in = ans.trim()
    }
    if name_in == "" {
        return ()
    }
    let is_dir_req = name_in.ends_with("/")
    let clean_name = if is_dir_req {
        name_in.slice(0, name_in.char_len() - 1).trim()
    } else {
        name_in
    }
    if clean_name == "" {
        return ()
    }
    if clean_name.starts_with(".") {
        svc.show_hidden = true
    }
    let target_uri = join_ssh_uri(svc.current_uri, clean_name)
    if is_dir_req {
        remote_mkdir(target_uri)!
        let _ = render_remote_dirvish_buffer(kernel, world, svc, svc.current_uri, focus_name = clean_name)!
        status_emit("Created remote directory: " ++ target_uri)#
        return ()
    }
    let _ = remote_write_lines(target_uri, [""], false)!
    let _ = render_remote_dirvish_buffer(kernel, world, svc, svc.current_uri, focus_name = clean_name)!
    let fbuf = world.open_file(target_uri)#!
    sync_wm(kernel, world)
    ensure_vim_normal(kernel, world)
    kernel.emit_hook("buffer-opened", fbuf.id)
    kernel.emit_hook("buffer-switched", fbuf.id)
    sync_remote_statusline(world, svc)
    status_emit("Created & opened remote file: " ++ target_uri)#
    ()
}

fn cmd_remote_dirvish_rename(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    let buf = world.active_buffer()
    let item? = entry_at_dirvish_cursor(svc, buf) else {
        status_emit("No remote entry under cursor")#
        return ()
    }
    var new_name = if not args.is_empty() { args.get(0).as(String).trim() } else { "" }
    if new_name == "" {
        let ans? = ask_prompt(PromptRequest.text("Rename `" ++ item.name ++ "` to: ", item.name))# else {
            return ()
        }
        new_name = ans.trim()
    }
    if new_name == "" or new_name == item.name {
        return ()
    }
    let dst_uri = join_ssh_uri(svc.current_uri, new_name)
    remote_rename(item.full_uri, dst_uri)!
    let focus_leaf = ssh_uri_basename(dst_uri)
    let _ = render_remote_dirvish_buffer(kernel, world, svc, svc.current_uri, focus_name = focus_leaf)!
    status_emit("Renamed `" ++ item.name ++ "` -> `" ++ new_name ++ "`")#
    ()
}

fn cmd_remote_dirvish_delete(kernel: SystemKernel, args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    let buf = world.active_buffer()
    let item? = entry_at_dirvish_cursor(svc, buf) else {
        status_emit("No remote entry under cursor")#
        return ()
    }
    let cur_row = buf.point.row
    var confirmed = false
    if not args.is_empty() {
        let a0 = args.get(0).as(String).trim().to_lower()
        confirmed = a0 == "y" or a0 == "yes" or a0 == "--yes"
    }
    if not confirmed {
        let kind_lbl = if item.is_dir { "directory" } else { "file" }
        let ans? = ask_prompt(PromptRequest.with_candidates(
            "Delete remote " ++ kind_lbl ++ " `" ++ item.name ++ "`? (y/n) ",
            "",
            PromptKind.confirm,
            List(),
        ))# else {
            status_emit("Delete cancelled")#
            return ()
        }
        confirmed = ans.trim().to_lower() == "y"
    }
    if not confirmed {
        status_emit("Delete cancelled")#
        return ()
    }
    remote_remove(item.full_uri, recursive = item.is_dir)!
    if svc.yanked_uri == item.full_uri {
        svc.yanked_uri = ""
        svc.cut_mode = false
    }
    let _ = render_remote_dirvish_buffer(kernel, world, svc, svc.current_uri, preferred_row = cur_row)!
    status_emit("Deleted remote entry: " ++ item.name)#
    ()
}

