private fn disambiguate_remote_copy_dest(base_dir_uri: String, orig_name: String) -> String {
    var cand_name = orig_name
    var attempt: i64 = 0
    while attempt < 50 {
        let cand_uri = join_ssh_uri(base_dir_uri, cand_name)
        let st_res = remote_stat(cand_uri)
        var exists_now = false
        st_res match {
            st! => {
                exists_now = st.exists
            },
            error _ => (),
        }
        if not exists_now {
            return cand_uri
        }
        attempt += 1
        let dot_hits = orig_name.find_indices(".")
        let suffix = if attempt == 1 { "_copy" } else { "_copy" ++ attempt.to_string() }
        if (not dot_hits.is_empty()) and dot_hits.get(0).as(i64) > 0 {
            let last_dot = dot_hits.get((dot_hits.len() - 1).as(usize)).as(i64)
            cand_name = orig_name.slice(0, last_dot) ++ suffix ++ orig_name.slice(last_dot, orig_name.char_len())
        } else {
            cand_name = orig_name ++ suffix
        }
    }
    join_ssh_uri(base_dir_uri, orig_name ++ "_copy")
}

fn cmd_remote_dirvish_paste(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
    let world = require_editor_world(kernel)!
    let svc = require_remote_service(kernel)!
    if svc.yanked_uri == "" or svc.current_uri == "" {
        status_emit("Remote copy/cut ring is empty")#
        return ()
    }
    let src_uri = svc.yanked_uri
    let base_name = ssh_uri_basename(src_uri)
    if svc.cut_mode {
        let dst_uri = join_ssh_uri(svc.current_uri, base_name)
        if dst_uri != src_uri {
            remote_rename(src_uri, dst_uri)!
        }
        svc.yanked_uri = ""
        svc.cut_mode = false
        let _ = render_remote_dirvish_buffer(kernel, world, svc, svc.current_uri, focus_name = base_name)!
        status_emit("Moved remote entry -> " ++ dst_uri)#
        return ()
    }
    let dst_uri = disambiguate_remote_copy_dest(svc.current_uri, base_name)
    let pasted_name = ssh_uri_basename(dst_uri)
    remote_copy(src_uri, dst_uri)!
    let _ = render_remote_dirvish_buffer(kernel, world, svc, svc.current_uri, focus_name = pasted_name)!
    status_emit("Copied remote entry -> " ++ dst_uri)#
    ()
}

fn cmd_remote_dirvish_yank_path(kernel: SystemKernel, _args: List) -> #InteractiveEffects !String Any {
