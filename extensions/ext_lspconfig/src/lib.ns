-- ext_lspconfig: Out-of-the-Box 18-Language LSP Preset Registry, `$PATH` Scanner,
-- Auto-Attach Lifecycle & Interactive `*LspConfig*` / `:Mason` Health Dashboard.

use std.collections.{HashMap, Set}
use std.env
use std.fs
use std.path
use @lava_sys.rgb
use @lava_core.{
    ExtId, InteractiveEffects, SystemKernel, clipboard_set, status_emit
}
use @lava_remote.{is_ssh_uri, remote_host_available, remote_which}
use @ext_document.{
    Buffer, BufferId, BufferKind, EditorWorld, Pos, ext_document_id, require_editor_world
}
use @ext_window.{SERVICE_WINDOW_MANAGER, WindowManager, ext_window_id}
use @ext_vim.{KEYMAP_VIM_LEADER, ext_vim_id}
use @ext_lsp.{
    BufferLspAttachment, LspServerSpec, LspService, detect_project_root, ext_lsp_id,
    require_lsp_service
}

pub const SERVICE_LSPCONFIG: String = "lava.lspconfig.registry"
pub const OWNER_LSPCONFIG: String = "ext_lspconfig"
pub const LSPCONFIG_BUF_NAME: String = "*LspConfig*"
pub const MODE_LSPCONFIG: String = "lspconfig"

pub fn ext_lspconfig_id() -> ExtId = ExtId("lava.org/ext_lspconfig")

-- ============================================================================
-- 1. Candidate Binary & 18-Language Preset Data Model
-- ============================================================================

pub struct LspBinaryCandidate {
    pub cmd: String,
    pub args: List,
}

pub struct LspLanguagePreset {
    pub server_id: String,
    pub language_name: String,
    pub candidates: List,
    pub active_cmd: String,
    pub active_args: List,
    pub resolved_path: String,
    pub installed: bool,
    pub filetypes: List,
    pub extensions: List,
    pub root_markers: List,
    pub install_hint: String,
    pub settings_json: String,
    pub description: String,
}

pub struct LspConfigRegistry {
    pub presets: HashMap,
    pub preset_order: List,
    pub auto_attach: bool,
    pub extra_search_dirs: List,
    pub prev_buf_id: BufferId,
    pub row_to_server_id: HashMap,
    pub detected_presets: Set,
    pub all_detected: bool,
}

-- ============================================================================
-- 2. `$PATH` Scanner & 18 Built-in Presets
-- ============================================================================

pub fn scan_executable_in_path(bin: String, extra_dirs: List) -> String {
    let trimmed = bin.trim()
    if trimmed == "" {
        return ""
    }
    if trimmed.contains("/") {
        if fs.exists(trimmed) and (not fs.is_dir(trimmed)) {
            return trimmed
        }
        return ""
    }
    for i in 0..extra_dirs.len() {
        let d = extra_dirs.get(i.as(usize)).as(String).trim()
        if d != "" {
            let full = path.join(d, trimmed)
            if fs.exists(full) and (not fs.is_dir(full)) {
                return full
            }
        }
    }
    let path_env = env.get_or("PATH", "")
    let dirs = path_env.split(":")
    for i in 0..dirs.len() {
        let d = dirs.get(i.as(usize)).as(String).trim()
        if d != "" {
            let full = path.join(d, trimmed)
            if fs.exists(full) and (not fs.is_dir(full)) {
                return full
            }
        }
    }
    ""
}

private fn cand(cmd: String, args: List) -> LspBinaryCandidate {
    LspBinaryCandidate { cmd: cmd, args: args }
}

private fn make_preset(
    server_id: String,
    language_name: String,
    candidates: List,
    filetypes: List,
    extensions: List,
    root_markers: List,
    install_hint: String,
    settings_json: String,
    description: String,
) -> LspLanguagePreset {
    let first = candidates.get(0).as(LspBinaryCandidate)
    LspLanguagePreset {
        server_id: server_id,
        language_name: language_name,
        candidates: candidates,
        active_cmd: first.cmd,
        active_args: first.args,
        resolved_path: "",
        installed: false,
        filetypes: filetypes,
        extensions: extensions,
        root_markers: root_markers,
        install_hint: install_hint,
        settings_json: settings_json,
        description: description,
    }
}

