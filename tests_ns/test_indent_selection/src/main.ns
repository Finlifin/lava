-- Dedicated End-to-End Test Suite for Evil/Vim Completeness & Indentation Selection:
--   1. Visual-mode operators (`VD`, `VjD`, `vllD`, `VC`, `VS`, `VR`, `VY`, `Vp` vs `VP`,
--      `vr*`, `Vr#`, `<C-v>jD`, `<C-v>jC`, `VjI`, `VjA`, `<C-v>O`, and unhandled-key Visual guard)
--   2. Missing Normal & shared commands (`<C-d>`, `<C-u>`, `<C-f>`, `<C-b>`, `<PageDown>`, `<PageUp>`,
--      `<C-e>`, `<C-y>`, `gv`, `gi`, `gf` + `:line`, `gJ`, `==`/`=ap`/`=ii`/`V=`, `&`, `ZZ`, `ZQ`,
--      and instant `:` empty candidates in `evil-ex`)
--   3. Indentation text objects (`vii`, `vai`, `viI`, `vaI`, `dii`, `cii`, `yii`, `=ii`) & `[i` / `]i` motions
--   4. Incremental expand/shrink (`<Space> v` / `<Space> V`, `<M-Up>` / `<M-Down>`, `:IndentExpand` / `:IndentShrink`)

use @lava_sys.mock_enable
use @lava_core.{
    HostClipboardCap, LogCollectorCap, PromptKind, StatusCollectorCap, SystemKernel,
    clipboard_get, clipboard_set, log_event, status_emit
}
use @ext_document.{
    Buffer, BufferKind, EditorWorld, Pos, RegisterValue, Span,
    register_document_extension, require_editor_world
}
use @ext_vim.{
    VimMode, VimState, register_vim_extension, require_vim_state, vim_feed_keys
}

fn fail_test(msg: String) -> NoReturn {
    panic("TEST FAILED: " ++ msg)
}

fn assert_true(cond: bool, msg: String) {
    if not cond {
        fail_test(msg)
    }
}

fn assert_str_eq(actual: String, expected: String, label: String) {
    if actual != expected {
        fail_test(
            label ++ "\n  expected: " ++ expected.escape_debug()
            ++ "\n  actual:   " ++ actual.escape_debug()
        )
    }
}

fn assert_i64_eq(actual: i64, expected: i64, label: String) {
    if actual != expected {
        fail_test(
            label ++ " expected=" ++ expected.to_string() ++ " actual=" ++ actual.to_string()
        )
    }
}

fn assert_pos_eq(actual: Pos, expected_row: i64, expected_col: i64, label: String) {
    if actual.row != expected_row or actual.col != expected_col {
        fail_test(
            label ++ " expected=(" ++ expected_row.to_string() ++ "," ++ expected_col.to_string()
            ++ ") actual=(" ++ actual.row.to_string() ++ "," ++ actual.col.to_string() ++ ")"
        )
    }
}

fn make_test_kernel() -> !String (SystemKernel, EditorWorld, VimState) {
    mock_enable(true)
    let kernel = SystemKernel.new()
    register_document_extension(kernel)!
    register_vim_extension(kernel)!
    kernel.activate_all()!
    let world = require_editor_world(kernel)!
    let vim = require_vim_state(kernel)!
    (kernel, world, vim)
}

fn setup_buffer(world: EditorWorld, lines: List) -> Buffer {
    let buf = world.active_buffer()
    buf.read_only = false
    buf.set_lines(lines, record_undo = false)
    buf.modified = false
    buf.point = Pos.zero()
    buf.preferred_col = 0
    buf
}

fn selected_visual_text(buf: Buffer, vim: VimState) -> String {
    if vim.mode == VimMode.visual_line {
        let r1 = if vim.visual_anchor.row <= buf.point.row { vim.visual_anchor.row } else { buf.point.row }
        let r2 = if vim.visual_anchor.row <= buf.point.row { buf.point.row } else { vim.visual_anchor.row }
        let out = List()
        for r in r1..(r2 + 1) {
            out.push(buf.line_at(r))
        }
        return out.join("\n")
    }
    let lo = if vim.visual_anchor <= buf.point { vim.visual_anchor } else { buf.point }
    let hi = if vim.visual_anchor <= buf.point { buf.point } else { vim.visual_anchor }
    let hlen = buf.line_char_len(hi.row)
    let end_c = if hi.col < hlen { hi.col + 1 } else { hlen }
    buf.extract_span(Span.normalized(lo, Pos.new(hi.row, end_c)))
}

fn unwrap_ok(res: !String Unit, ctx: String) {
    let _! = res else {
        fail_test(ctx ++ " returned unexpected error")
    }
}

-- ============================================================================
-- 1. Visual-Mode Operators (`VD`, `VjD`, `vllD`, `VC`, `VY`, `Vp` vs `VP`, `vr*`, `<C-v>D`/`C`/`O`, `VjI`/`A`)
-- ============================================================================

fn test_visual_operators_completeness() -> #[log_event, status_emit, clipboard_get, clipboard_set] !String Unit {
    let (kernel, world, vim) = make_test_kernel()!

    -- 1a. `VD` deletes the entire selected line cleanly and populates linewise register!
    let b1 = setup_buffer(world, ["first line", "  second line", "third line"])
    vim_feed_keys(kernel, "j$VD")#!
    assert_true(vim.mode == VimMode.normal, "VD exits to Normal")
    assert_str_eq(b1.to_text(), "first line\nthird line", "VD deleted entire second line even from EOL")
    let reg_vd? = world.registers.get_reg("")# else {
        fail_test("VD populated unnamed register")
    }
    assert_true(reg_vd.linewise, "VD register is linewise")
    assert_str_eq(reg_vd.text, "  second line\n", "VD register text")

    -- 1b. `VjD` deletes multiple selected lines, and `vllD` / `vllX` in VisualChar ALSO delete entire line!
    let b2 = setup_buffer(world, ["row0", "row1", "row2", "row3", "row4"])
    vim_feed_keys(kernel, "jVjD")#!
    assert_str_eq(b2.to_text(), "row0\nrow3\nrow4", "VjD deleted row1..row2")
    vim_feed_keys(kernel, "gglvllD")#!
    assert_str_eq(b2.to_text(), "row3\nrow4", "vllD in VisualChar deleted entire row0 linewise")
    vim_feed_keys(kernel, "vlX")#!
    assert_str_eq(b2.to_text(), "row4", "vlX in VisualChar deleted entire row3 linewise")

    -- 1c. `VC` / `VS` / `VR` / `vllC` change entire selected lines linewise -> Insert
    let b3 = setup_buffer(world, ["keep_top", "    old_body_1", "    old_body_2", "keep_bot"])
    vim_feed_keys(kernel, "jVjCnew_body<Escape>")#!
    assert_true(vim.mode == VimMode.normal, "VC + text + Esc returns to Normal")
    assert_str_eq(b3.to_text(), "keep_top\n    new_body\nkeep_bot", "VjC preserved indent and replaced 2 lines")
    vim_feed_keys(kernel, "jvllCreplaced_char_line<Escape>")#!
    assert_str_eq(b3.to_text(), "keep_top\n    new_body\nreplaced_char_line", "vllC changed entire line")

    -- 1d. `VY` and `vllY` yank entire lines linewise
    let b4 = setup_buffer(world, ["alpha", "beta_line", "gamma"])
    vim_feed_keys(kernel, "jvllY")#!
    assert_true(vim.mode == VimMode.normal, "vllY exits to Normal")
    vim_feed_keys(kernel, "Gp")#!
    assert_str_eq(b4.to_text(), "alpha\nbeta_line\ngamma\nbeta_line", "vllY yanked full line linewise")

    -- 1e. Visual `p` vs `P`: `P` preserves unnamed register across repeated pastes; `p` captures replaced text!
    let bp = setup_buffer(world, ["COPY_ME", "target_one", "target_two"])
    vim_feed_keys(kernel, "0yiw")#!
    vim_feed_keys(kernel, "j0viwP")#!
    assert_str_eq(bp.line_at(1), "COPY_ME", "first viwP pasted COPY_ME")
    vim_feed_keys(kernel, "j0viwP")#!
    assert_str_eq(bp.line_at(2), "COPY_ME", "second viwP STILL pasted COPY_ME (unnamed preserved!)")

    let bp2 = setup_buffer(world, ["NEW_VAL", "OLD_VAL", "slot"])
    vim_feed_keys(kernel, "0yiwj0viwp")#!
    assert_str_eq(bp2.line_at(1), "NEW_VAL", "viwp pasted NEW_VAL")
    vim_feed_keys(kernel, "j0viwp")#!
    assert_str_eq(bp2.line_at(2), "OLD_VAL", "viwp put replaced OLD_VAL into unnamed register")

    -- VisualLine `VP` repeated linewise paste
    let bvp = setup_buffer(world, ["TEMPLATE_LINE", "victim_1", "victim_2"])
    vim_feed_keys(kernel, "yyjVPjVP")#!
    assert_str_eq(bvp.to_text(), "TEMPLATE_LINE\nTEMPLATE_LINE\nTEMPLATE_LINE", "VP preserved linewise yank across 2 pastes")

    -- 1f. `r<char>` in VisualChar / VisualLine / VisualBlock (preserving `\n`!) + `<Escape>` cancel
    let br = setup_buffer(world, ["abc", "defg", "hi"])
    vim_feed_keys(kernel, "gg0vjr*")#!
    assert_true(vim.mode == VimMode.normal, "vjr* exits to Normal")
    assert_str_eq(br.to_text(), "***\n*efg\nhi", "vjr* masked chars across newline without eating newline")
    vim_feed_keys(kernel, "u")#!
    assert_str_eq(br.to_text(), "abc\ndefg\nhi", "vjr* is a single undo group")
    vim_feed_keys(kernel, "ggVr<Escape>")#!
    assert_true(vim.mode == VimMode.normal, "Vr<Escape> cancels cleanly to Normal")
    assert_str_eq(br.line_at(0), "abc", "Vr<Escape> left text untouched")

    -- 1g. `VjI` and `VjA` in VisualLine across uneven line lengths
    let bia = setup_buffer(world, ["  short", "    longer_line", "untouched"])
    vim_feed_keys(kernel, "ggVjI//<Space><Escape>")#!
    assert_str_eq(bia.line_at(0), "  // short", "VjI inserted at min first-non-blank col on row 0")
    assert_str_eq(bia.line_at(1), "  //   longer_line", "VjI inserted at min first-non-blank col on row 1")
    vim_feed_keys(kernel, "ggVjA;<Escape>")#!
    assert_str_eq(bia.line_at(0), "  // short;", "VjA appended ';' at EOL of short row 0")
    assert_str_eq(bia.line_at(1), "  //   longer_line;", "VjA appended ';' at EOL of longer row 1")
    assert_str_eq(bia.line_at(2), "untouched", "VjI/VjA did not touch row 2")

    -- 1h. VisualBlock `D`, `C`, and `O` horizontal corner swap
    let bvb = setup_buffer(world, ["abcd_111", "efgh_222", "ijkl_333"])
    vim_feed_keys(kernel, "gg4l<C-v>jD")#!
    assert_str_eq(bvb.to_text(), "abcd\nefgh\nijkl_333", "<C-v>jD deleted from block col to EOL on selected rows")
    vim_feed_keys(kernel, "gg2l<C-v>jC_NEW<Escape>")#!
    assert_str_eq(bvb.to_text(), "ab_NEW\nef_NEW\nijkl_333", "<C-v>jC changed from block col to EOL across rows")

    let bvo = setup_buffer(world, ["012345", "abcdef"])
    vim_feed_keys(kernel, "ggl<C-v>j3lO")#!
    assert_pos_eq(bvo.point, 1, 1, "<C-v>O swapped horizontal col while keeping cursor on row 1")
    assert_pos_eq(vim.visual_anchor, 0, 4, "<C-v>O moved anchor col to 4 on row 0")
    vim_feed_keys(kernel, "<Escape>")#!

    -- 1i. CRITICAL VISUAL GUARD: unhandled keys in Visual mode never leak into Section 9 Normal commands
    let bguard = setup_buffer(world, ["safe_line_1", "safe_line_2"])
    vim_feed_keys(kernel, "ggVQ.&")#!
    assert_true(vim.mode == VimMode.visual_line, "unhandled keys in VisualLine stay in VisualLine")
    assert_str_eq(bguard.to_text(), "safe_line_1\nsafe_line_2", "Visual guard prevented Normal-mode edits")
    vim_feed_keys(kernel, "<Escape>")#!
    ()
}

-- ============================================================================
-- 2. Normal & Shared Commands (`<C-d/u/f/b/e/y>`, `<PageDown/Up>`, `gv`, `gi`, `gf`, `gJ`, `=`, `&`, `ZZ`/`ZQ`)
-- ============================================================================

fn test_normal_and_shared_commands() -> #[log_event, status_emit, clipboard_get, clipboard_set] !String Unit {
    let (kernel, world, vim) = make_test_kernel()!

    -- 2a. `<C-d>`, `<C-u>`, `<C-f>`, `<C-b>`, `<PageDown>`, `<PageUp>`, `<C-e>`, `<C-y>` in Normal & Visual
    let lines30 = List()
    for i in 0..30 {
        lines30.push("line_" ++ i.to_string())
    }
    let sb = setup_buffer(world, lines30)
    world.viewport_rows = 10
    world.viewport_top_row = 0

    vim_feed_keys(kernel, "<C-d>")#!
    assert_i64_eq(sb.point.row, 5, "<C-d> scrolled cursor down half screen (5)")
    assert_i64_eq(world.viewport_top_row, 5, "<C-d> scrolled viewport down 5")

    vim_feed_keys(kernel, "<C-f>")#!
    assert_i64_eq(sb.point.row, 13, "<C-f> scrolled down page (8)")

    vim_feed_keys(kernel, "<PageDown>")#!
    assert_i64_eq(sb.point.row, 21, "<PageDown> scrolled down page (8)")

    vim_feed_keys(kernel, "<PageUp>")#!
    assert_i64_eq(sb.point.row, 13, "<PageUp> scrolled up page (8)")

    vim_feed_keys(kernel, "<C-b>")#!
    assert_i64_eq(sb.point.row, 5, "<C-b> scrolled up page (8)")

    vim_feed_keys(kernel, "<C-u>")#!
    assert_i64_eq(sb.point.row, 0, "<C-u> scrolled up half screen to 0")

    -- `<C-e>` scrolls viewport down; cursor stays until pushed off top!
    vim_feed_keys(kernel, "3j")#!
    assert_i64_eq(sb.point.row, 3, "cursor at row 3")
    vim_feed_keys(kernel, "2<C-e>")#!
    assert_i64_eq(world.viewport_top_row, 2, "2<C-e> moved viewport_top_row to 2")
    assert_i64_eq(sb.point.row, 3, "2<C-e> preserved cursor at row 3 while visible")
    vim_feed_keys(kernel, "4<C-e>")#!
    assert_i64_eq(world.viewport_top_row, 6, "4<C-e> moved viewport_top_row to 6")
    assert_i64_eq(sb.point.row, 6, "<C-e> pushed cursor down to stay in viewport")
    vim_feed_keys(kernel, "3<C-y>")#!
    assert_i64_eq(world.viewport_top_row, 3, "3<C-y> scrolled viewport up to 3")

    -- `<C-d>` in Visual mode extends selection!
    vim_feed_keys(kernel, "ggV<C-d>")#!
    assert_true(vim.mode == VimMode.visual_line, "<C-d> preserved VisualLine mode")
    assert_i64_eq(vim.visual_anchor.row, 0, "VisualLine anchor stayed at 0")
    assert_i64_eq(sb.point.row, 5, "VisualLine point moved to 5 via <C-d>")
    vim_feed_keys(kernel, "<Escape>")#!

    -- 2b. `gv` reselects last Visual mode, anchor, and cursor
    vim_feed_keys(kernel, "gg")#!
    vim_feed_keys(kernel, "gv")#!
    assert_true(vim.mode == VimMode.visual_line, "gv restored VisualLine")
    assert_i64_eq(vim.visual_anchor.row, 0, "gv restored anchor row 0")
    assert_i64_eq(sb.point.row, 5, "gv restored point row 5")
    vim_feed_keys(kernel, "<Escape>")#!

    -- 2c. `gi` jumps to last Insert exit position (`^` mark) and enters Insert
    let gib = setup_buffer(world, ["prefix_end", "other_line"])
    vim_feed_keys(kernel, "06liMID<Escape>G0")#!
    assert_pos_eq(gib.point, 1, 0, "moved away after insert")
    vim_feed_keys(kernel, "gi_MORE<Escape>")#!
    assert_str_eq(gib.line_at(0), "prefixMID_MORE_end", "gi resumed Insert at exact '^' mark")

    -- 2d. `gf` opens file under cursor (with `:line` jump!)
    let gfb = setup_buffer(world, [
        "see /home/fin/apps/lava/packages/lava_core/package.toml:3 for details"
    ])
    vim_feed_keys(kernel, "0wgf")#!
    let opened = world.active_buffer()
    assert_str_eq(opened.file_path, "/home/fin/apps/lava/packages/lava_core/package.toml", "gf opened file under cursor")
    assert_i64_eq(opened.point.row, 2, "gf jumped to 1-based :3 -> row 2")

    -- 2e. `gJ` joins lines WITHOUT inserting whitespace (in Normal and Visual)
    let gjb = setup_buffer(world, ["foo", "  bar", "  baz", "qux"])
    vim_feed_keys(kernel, "gg0gJ")#!
    assert_str_eq(gjb.line_at(0), "foo  bar", "Normal gJ joined without stripping leading spaces or adding separator")
    vim_feed_keys(kernel, "VjgJ")#!
    assert_str_eq(gjb.line_at(0), "foo  bar  baz", "Visual gJ joined without space")

    -- 2f. `=` auto-indent operator (`==`, `=G`, `V=`)
    let eqb = setup_buffer(world, [
        "fn demo() {{",
        "let x = 1",
        "if x > 0 {{",
        "println(x)",
        "}}",
        "}}"
    ])
    world.options.shiftwidth = 4
    world.options.expandtab = true
    vim_feed_keys(kernel, "gg=G")#!
    assert_str_eq(eqb.line_at(0), "fn demo() {{", "=G row 0")
    assert_str_eq(eqb.line_at(1), "    let x = 1", "=G indented row 1 to 4")
    assert_str_eq(eqb.line_at(2), "    if x > 0 {{", "=G indented row 2 to 4")
    assert_str_eq(eqb.line_at(3), "        println(x)", "=G indented row 3 to 8")
    assert_str_eq(eqb.line_at(4), "    }}", "=G dedented inner closing brace to 4")
    assert_str_eq(eqb.line_at(5), "}}", "=G dedented outer closing brace to 0")

    -- 2g. `&` repeats last `:s` substitution on current line
    let sub_b = setup_buffer(world, ["foo and foo", "foo again foo", "foo third"])
    let _ = kernel.dispatch_command("evil-ex", ["1s/foo/BAR/g"])#!
    assert_str_eq(sub_b.line_at(0), "BAR and BAR", ":1s/foo/BAR/g on row 0")
    vim_feed_keys(kernel, "j&")#!
    assert_str_eq(sub_b.line_at(1), "BAR again BAR", "& repeated :s with flags on row 1")

    -- 2h. `:` `evil-ex` passes empty `candidates: List()` for instant minibuffer open
    vim_feed_keys(kernel, ":")#!
    let ex_pending? = kernel.active_prompt else {
        fail_test(": opens PromptKind.ex_command")
    }
    let (ex_req, _) = ex_pending
    assert_true(ex_req.kind == PromptKind.ex_command, "ExCommand prompt kind")
    assert_true(ex_req.candidates.is_empty(), "evil-ex passes empty candidates list")
    let _ = kernel.submit_prompt_answer(null)#!

    -- 2i. `ZZ` and `ZQ`
    let qb = setup_buffer(world, ["dirty content"])
    qb.kind = BufferKind.file
    qb.file_path = "/tmp/lava_test_zz_zq_unsaved.txt"
    qb.modified = true
    world.quit_requested = false
    vim_feed_keys(kernel, "ZQ")#!
    assert_true(world.quit_requested, "ZQ force-quits even with unsaved file buffer")

    world.quit_requested = false
    qb.modified = false
    vim_feed_keys(kernel, "ZZ")#!
    assert_true(world.quit_requested, "ZZ quits cleanly when clean")
    ()
}

-- ============================================================================
-- 3. Indentation Text Objects (`ii`, `ai`, `iI`, `aI`) & Scope Motions (`[i`, `]i`)
-- ============================================================================

fn test_indent_text_objects_and_motions() -> #[log_event, status_emit, clipboard_get, clipboard_set] !String Unit {
    let (kernel, world, vim) = make_test_kernel()!

    let code = [
        "fn compute() {{",
        "    let base = 10",
        "    if base > 0 {{",
        "        let step_a = base + 1",
        "",
        "        let step_b = step_a * 2",
        "    }}",
        "    return base",
        "}}"
    ]

    -- `vii` bridges blank line inside the `if` body (rows 3..5)
    let b = setup_buffer(world, code)
    vim_feed_keys(kernel, "3j^vii")#!
    assert_true(vim.mode == VimMode.visual_line, "vii enters VisualLine")
    assert_i64_eq(vim.visual_anchor.row, 3, "vii start row 3")
    assert_i64_eq(b.point.row, 5, "vii end row 5 (bridged blank row 4)")
    vim_feed_keys(kernel, "<Escape>")#!

    -- `viI` stops at blank lines (strict contiguous non-blank block: row 3..3)
    vim_feed_keys(kernel, "gg3j^viI")#!
    assert_i64_eq(vim.visual_anchor.row, 3, "viI start row 3")
    assert_i64_eq(b.point.row, 3, "viI end row 3 (stopped before blank row 4)")
    vim_feed_keys(kernel, "<Escape>")#!

    -- `vai` includes the header line above (`if base > 0 {` at row 2..5)
    vim_feed_keys(kernel, "gg5j^vai")#!
    assert_i64_eq(vim.visual_anchor.row, 2, "vai includes header row 2")
    assert_i64_eq(b.point.row, 5, "vai ends at row 5")
    vim_feed_keys(kernel, "<Escape>")#!

    -- `vaI` includes BOTH header line above (row 2) AND closing line below (`    }` at row 6)!
    vim_feed_keys(kernel, "gg5j^vaI")#!
    assert_i64_eq(vim.visual_anchor.row, 2, "vaI includes header row 2")
    assert_i64_eq(b.point.row, 6, "vaI includes closer row 6")
    vim_feed_keys(kernel, "<Escape>")#!

    -- Starting on the blank line (row 4) infers effective indent 8 from neighbors!
    vim_feed_keys(kernel, "gg4jvii")#!
    assert_i64_eq(vim.visual_anchor.row, 3, "vii on blank line inferred indent -> row 3")
    assert_i64_eq(b.point.row, 5, "vii on blank line inferred indent -> row 5")
    vim_feed_keys(kernel, "<Escape>")#!

    -- `[i` and `]i` indent boundary jumps
    vim_feed_keys(kernel, "gg5j^[i")#!
    assert_pos_eq(b.point, 3, 8, "[i jumped to top of indent=8 block")
    vim_feed_keys(kernel, "[i")#!
    assert_pos_eq(b.point, 2, 4, "second [i at top boundary stepped out to parent header row 2")
    vim_feed_keys(kernel, "j]i")#!
    assert_pos_eq(b.point, 5, 8, "]i jumped to bottom of indent=8 block")
    vim_feed_keys(kernel, "]i")#!
    assert_pos_eq(b.point, 6, 4, "second ]i at bottom boundary stepped out to closer row 6")

    -- Operator-pending `dii` deletes the inner indented block cleanly!
    vim_feed_keys(kernel, "gg3j^dii")#!
    assert_i64_eq(b.line_count(), 6, "dii deleted 3 lines (rows 3..5)")
    assert_str_eq(b.line_at(2), "    if base > 0 {{", "header preserved by dii")
    assert_str_eq(b.line_at(3), "    }}", "closer preserved by dii")
    ()
}

-- ============================================================================
-- 4. Incremental Selection Expansion & Shrink (`<Space> v` / `<Space> V`, `<M-Up>` / `<M-Down>`, `:IndentExpand`)
-- ============================================================================

fn test_incremental_expand_shrink() -> #[log_event, status_emit, clipboard_get, clipboard_set] !String Unit {
    let (kernel, world, vim) = make_test_kernel()!

    let src = [
        "fn outer() {{",
        "    let pre = 1",
        "    if pre > 0 {{",
        "        let msg = call(\"hello world\")",
        "        println(msg)",
        "    }}",
        "    return pre",
        "}}"
    ]
    let b = setup_buffer(world, src)

    -- Place cursor on 'e' of `hello` at row 3: `        let msg = call("hello world")`
    -- col of `"`: `        let msg = call(` is 23 chars, `"` is 23, `h` is 24, `e` is 25
    b.point = Pos.new(3, 25)
    assert_str_eq(b.line_at(3).slice(24, 29), "hello", "cursor positioned inside 'hello'")

    -- Step 1 (`<Space> v`): word `hello`
    vim_feed_keys(kernel, "<Space>v")#!
    assert_true(vim.mode == VimMode.visual_char, "step 1 VisualChar")
    assert_str_eq(selected_visual_text(b, vim), "hello", "step 1 selected 'hello'")

    -- Step 2 (`<Space> v`): inner quotes `hello world`
    vim_feed_keys(kernel, "<Space>v")#!
    assert_true(vim.mode == VimMode.visual_char, "step 2 VisualChar")
    assert_str_eq(selected_visual_text(b, vim), "hello world", "step 2 selected inner quotes")

    -- Step 3 (`<M-Up>`): around quotes `"hello world"`
    vim_feed_keys(kernel, "<M-Up>")#!
    assert_true(vim.mode == VimMode.visual_char, "step 3 VisualChar")
    assert_str_eq(selected_visual_text(b, vim), "\"hello world\"", "step 3 selected around quotes")

    -- Step 4 (`:IndentExpand`): inner parens == around quotes, so strictly grows to around parens `("hello world")`!
    let _ = kernel.dispatch_command("evil-ex", ["IndentExpand"])#!
    assert_true(vim.mode == VimMode.visual_char, "step 4 VisualChar")
    assert_str_eq(selected_visual_text(b, vim), "(\"hello world\")", "step 4 selected around parens")

    -- Step 5 (`<M-Up>`): current VisualLine `3..3`
    vim_feed_keys(kernel, "<M-Up>")#!
    assert_true(vim.mode == VimMode.visual_line, "step 5 upgraded to VisualLine")
    assert_i64_eq(vim.visual_anchor.row, 3, "step 5 row 3 start")
    assert_i64_eq(b.point.row, 3, "step 5 row 3 end")

    -- Step 6 (`<Space> v`): `ii` inner indent block `3..4`
    vim_feed_keys(kernel, "<Space>v")#!
    assert_i64_eq(vim.visual_anchor.row, 3, "step 6 ii start row 3")
    assert_i64_eq(b.point.row, 4, "step 6 ii end row 4")

    -- Step 7 (`<Space> v`): `ai` indent block + `if` header `2..4`
    vim_feed_keys(kernel, "<Space>v")#!
    assert_i64_eq(vim.visual_anchor.row, 2, "step 7 ai start row 2")
    assert_i64_eq(b.point.row, 4, "step 7 ai end row 4")

    -- Step 8 (`<Space> v`): `aI` indent block + header + `}` closer `2..5`
    vim_feed_keys(kernel, "<Space>v")#!
    assert_i64_eq(vim.visual_anchor.row, 2, "step 8 aI start row 2")
    assert_i64_eq(b.point.row, 5, "step 8 aI end row 5")

    -- Step 9 (`<Space> v`): parent indent=4 inner block `1..6`
    vim_feed_keys(kernel, "<Space>v")#!
    assert_i64_eq(vim.visual_anchor.row, 1, "step 9 parent ii start row 1")
    assert_i64_eq(b.point.row, 6, "step 9 parent ii end row 6")

    -- Step 10 (`<Space> v`): parent `ai` `0..6`
    vim_feed_keys(kernel, "<Space>v")#!
    assert_i64_eq(vim.visual_anchor.row, 0, "step 10 parent ai start row 0")
    assert_i64_eq(b.point.row, 6, "step 10 parent ai end row 6")

    -- Step 11 (`<Space> v`): entire buffer `0..7`
    vim_feed_keys(kernel, "<Space>v")#!
    assert_i64_eq(vim.visual_anchor.row, 0, "step 11 full buffer start row 0")
    assert_i64_eq(b.point.row, 7, "step 11 full buffer end row 7")

    -- Now shrink step-by-step via `:IndentShrink`, `<M-Down>`, and `<Space> V` all the way back to Normal!
    let _ = kernel.dispatch_command("evil-ex", ["IndentShrink"])#!
    assert_i64_eq(b.point.row, 6, "shrink -> step 10 (0..6)")

    vim_feed_keys(kernel, "<M-Down>")#!
    assert_i64_eq(vim.visual_anchor.row, 1, "shrink -> step 9 (1..6)")

    vim_feed_keys(kernel, "<Space>V")#!
    assert_i64_eq(vim.visual_anchor.row, 2, "shrink -> step 8 (2..5)")
    assert_i64_eq(b.point.row, 5, "shrink -> step 8 end")

    vim_feed_keys(kernel, "<Space>V")#!
    assert_i64_eq(b.point.row, 4, "shrink -> step 7 (2..4)")

    vim_feed_keys(kernel, "<Space>V")#!
    assert_i64_eq(vim.visual_anchor.row, 3, "shrink -> step 6 (3..4)")

    vim_feed_keys(kernel, "<M-Down>")#!
    assert_i64_eq(b.point.row, 3, "shrink -> step 5 (3..3)")

    vim_feed_keys(kernel, "<M-Down>")#!
    assert_true(vim.mode == VimMode.visual_char, "shrink -> step 4 VisualChar")
    assert_str_eq(selected_visual_text(b, vim), "(\"hello world\")", "shrink -> step 4 text")

    vim_feed_keys(kernel, "<M-Down>")#!
    assert_str_eq(selected_visual_text(b, vim), "\"hello world\"", "shrink -> step 3 text")

    vim_feed_keys(kernel, "<M-Down>")#!
    assert_str_eq(selected_visual_text(b, vim), "hello world", "shrink -> step 2 text")

    vim_feed_keys(kernel, "<M-Down>")#!
    assert_str_eq(selected_visual_text(b, vim), "hello", "shrink -> step 1 text")

    vim_feed_keys(kernel, "<Space>V")#!
    assert_true(vim.mode == VimMode.normal, "final shrink returned to VimMode.normal")
    assert_pos_eq(b.point, 3, 25, "final shrink restored exact starting cursor (3, 25)")
    ()
}

fn run_all() -> #[log_event, status_emit, clipboard_get, clipboard_set] !String Unit {
    println("[1/4] test_visual_operators_completeness...")
    test_visual_operators_completeness()#!
    println("[2/4] test_normal_and_shared_commands...")
    test_normal_and_shared_commands()#!
    println("[3/4] test_indent_text_objects_and_motions...")
    test_indent_text_objects_and_motions()#!
    println("[4/4] test_incremental_expand_shrink...")
    test_incremental_expand_shrink()#!
    ()
}

fn main() {
    handles(clipboard_get) handles(clipboard_set) let _clip = HostClipboardCap {}
    handles(log_event) let _logs = LogCollectorCap.new()
    handles(status_emit) let _status = StatusCollectorCap.new()

    unwrap_ok(run_all()#, "test_indent_selection")
    println("ALL INDENT SELECTION & VIM COMPLETENESS TESTS PASSED (4/4 suites)")
}
